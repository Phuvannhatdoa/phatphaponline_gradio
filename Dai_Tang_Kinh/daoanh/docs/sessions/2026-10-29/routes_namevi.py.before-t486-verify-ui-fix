# T486 — Tab "Xác minh tác giả" trong namevimap.html: Admin xem/pass từng
# contributor (person_id) có name_vi lệch giữa DB (dila_catalog_contributors
# / people.name_vi) và file nguồn vn_dila_authority_catalog/*.vi.json.
#
# Nguồn số liệu: docs/sessions/2026-10-29/work-metadata/t486_dryrun.csv
# (đã đo sẵn 1.870 dòng contributor lệch, 794 person_id). GET chỉ đọc CSV +
# DB (KHÔNG ghi gì). POST /pass ghi theo ĐÚNG cơ chế đã có ở
# admin_namevi_map_update() (dòng ~515-592 phía trên): UPDATE/INSERT
# name_vi_map theo dila_id, rồi sync people.name_vi — vì name_vi_map.dila_id
# và dila_catalog_contributors.person_id cùng là khóa people.id (đã kiểm:
# person_id='A000457' khớp people.id='A000457'). KHÔNG tạo cột/bảng mới.
#
# Khác với admin_namevi_map_update(): approved_by ghi email thật của admin
# (qua _t427_session_email(token), như routes_places.py đã làm cho tab
# Place/Catalog) — không hard-code 'admin'.
# ════════════════════════════════════════════════════════════════════════

_T486_DRYRUN_CSV = os.path.join(BASE_DIR, 'docs', 'sessions', '2026-10-29', 'work-metadata', 't486_dryrun.csv')
_T486_GROUP_PRIORITY = {'C_review': 3, 'B_untrans': 2, 'A_format': 1}
_t486_csv_cache = {'mtime': None, 'by_person': None}


def _t486_load_csv_rows():
    """Đọc t486_dryrun.csv, chỉ giữ field=='contributor', cache theo mtime file
    (không đọc lại mỗi request nếu file không đổi). Trả về {} nếu file thiếu
    (không raise — GET vẫn phải trả JSON hợp lệ, báo rõ trong 'warning')."""
    try:
        mtime = os.path.getmtime(_T486_DRYRUN_CSV)
    except OSError:
        return {}
    if _t486_csv_cache['mtime'] == mtime and _t486_csv_cache['by_person'] is not None:
        return _t486_csv_cache['by_person']
    by_person = {}
    try:
        with open(_T486_DRYRUN_CSV, encoding='utf-8-sig', newline='') as f:
            for row in _t486_csv.DictReader(f):
                if row.get('field') != 'contributor':
                    continue
                pid = (row.get('person_id') or '').strip()
                if not pid:
                    continue
                by_person.setdefault(pid, []).append(row)
    except OSError:
        return {}
    _t486_csv_cache['mtime'] = mtime
    _t486_csv_cache['by_person'] = by_person
    return by_person


def _t486_aggregate_person(pid, rows):
    """Gộp nhiều dòng CSV (1 dòng/cbeta_id) của 1 person_id thành 1 bản ghi.
    db_value: hầu hết đồng nhất theo người (nguồn là people.name_vi tại thời
    điểm đo) — lấy giá trị xuất hiện nhiều nhất, phòng trường hợp hiếm có
    sai khác. file_value: có thể khác nhau theo từng tác phẩm (vi.json ghi
    tên theo từng contributor-trong-từng-tác-phẩm) — lấy giá trị xuất hiện
    nhiều nhất (mode), các biến thể khác liệt kê trong file_value_variants
    để Admin biết trước khi Pass. group: nhóm "nặng" nhất trong số các dòng
    (C_review > B_untrans > A_format) vì đó là nhóm cần soát kỹ nhất."""
    from collections import Counter
    db_counter = Counter((r.get('db_value') or '').strip() for r in rows)
    file_counter = Counter((r.get('file_value') or '').strip() for r in rows)
    db_value = db_counter.most_common(1)[0][0] if db_counter else ''
    file_value = file_counter.most_common(1)[0][0] if file_counter else ''
    file_variants = sorted(file_counter.keys())
    groups = [r.get('group') for r in rows if r.get('group')]
    group = max(groups, key=lambda g: _T486_GROUP_PRIORITY.get(g, 0)) if groups else ''
    cbeta_ids = sorted({r.get('cbeta_id') for r in rows if r.get('cbeta_id')})
    return {
        'person_id': pid,
        'name_db': db_value,
        'name_file': file_value,
        'name_file_variants': file_variants if len(file_variants) > 1 else [],
        'group': group,
        'csv_cbeta_ids': cbeta_ids,
    }


@app.route('/daoanh/api/admin/work-verify', methods=['GET'])
@app.route('/api/admin/work-verify', methods=['GET'])
def admin_work_verify_list():
    """GET /daoanh/api/admin/work-verify?group=C|B|A|ALL&page=&size=&q=

    CHỈ ĐỌC (mode=ro) — không ghi DB. Gom theo person_id từ
    t486_dryrun.csv (nhóm field='contributor', 1.870 dòng / 794 người),
    rồi bổ sung name_zh, số tác phẩm thật (đếm trực tiếp
    dila_catalog_contributors, không giới hạn vào các dòng có trong CSV)
    và tối đa 5 tác phẩm tiêu biểu từ DB. Sắp theo work_count giảm dần.
    """
    group_filter = (request.args.get('group') or 'ALL').strip().upper()
    group_map = {'A': 'A_format', 'B': 'B_untrans', 'C': 'C_review'}
    group_filter_full = group_map.get(group_filter)  # None nếu 'ALL' hoặc giá trị lạ
    q = (request.args.get('q') or '').strip()
    try:
        page = max(1, int(request.args.get('page', 1)))
    except ValueError:
        page = 1
    try:
        size = max(1, min(200, int(request.args.get('size', 50))))
    except ValueError:
        size = 50

    by_person = _t486_load_csv_rows()
    warning = None
    if not by_person:
        warning = (f'Không đọc được {_T486_DRYRUN_CSV} — kiểm lại đường dẫn CSV dry-run.')

    conn = get_db()
    try:
        agg = [_t486_aggregate_person(pid, rows) for pid, rows in by_person.items()]
        if group_filter_full:
            agg = [a for a in agg if a['group'] == group_filter_full]

        pids = [a['person_id'] for a in agg]
        # Tên Hán + tên Việt hiện tại (sau khi có thể đã Pass) từ people — nguồn
        # chuẩn duy nhất (COALESCE(p.name_vi, c.name_vi) là cách routes_lineage.py
        # hiển thị, nên ở đây cũng ưu tiên people.name_vi khi đã có).
        zh_map, live_vi_map, work_count_map = {}, {}, {}
        if pids:
            qmarks = ','.join('?' * len(pids))
            for r in conn.execute(
                f"SELECT id, name_zh, name_vi FROM people WHERE id IN ({qmarks})", pids
            ).fetchall():
                zh_map[r['id']] = r['name_zh']
                live_vi_map[r['id']] = r['name_vi']
            for r in conn.execute(
                f"SELECT person_id, COUNT(DISTINCT cbeta_id) AS n FROM dila_catalog_contributors "
                f"WHERE person_id IN ({qmarks}) GROUP BY person_id", pids
            ).fetchall():
                work_count_map[r['person_id']] = r['n']

        items = []
        for a in agg:
            pid = a['person_id']
            name_zh = zh_map.get(pid) or ''
            live_vi = live_vi_map.get(pid)
            # name_zh fallback: nếu people chưa có (hiếm), lấy từ dòng contributor đầu tiên trong DB.
            if not name_zh:
                r = conn.execute(
                    "SELECT name_zh FROM dila_catalog_contributors WHERE person_id = ? "
                    "AND name_zh IS NOT NULL AND name_zh != '' LIMIT 1", (pid,)
                ).fetchone()
                name_zh = r['name_zh'] if r else ''
            works = [dict(w) for w in conn.execute(
                "SELECT c.cbeta_id, w.title_zh FROM dila_catalog_contributors c "
                "JOIN dila_catalog_works w ON w.cbeta_id = c.cbeta_id "
                "WHERE c.person_id = ? ORDER BY c.cbeta_id LIMIT 5", (pid,)
            ).fetchall()]
            # "Đã Pass": phát hiện bằng cách so người.name_vi HIỆN TẠI với
            # name_db ĐÃ ĐO trong CSV dry-run — khác đi nghĩa là đã có người
            # ghi đè (qua đúng endpoint /pass bên dưới, vì đây là cơ chế ghi
            # name_vi duy nhất cho người). Không thêm cột/bảng trạng thái mới.
            passed = bool(live_vi) and live_vi.strip() != a['name_db'].strip()
            items.append({
                'person_id': pid,
                'name_zh': name_zh,
                'name_db': live_vi if live_vi is not None else a['name_db'],
                'name_file': a['name_file'],
                'name_file_variants': a['name_file_variants'],
                'group': a['group'],
                'work_count': work_count_map.get(pid, len(a['csv_cbeta_ids'])),
                'works': works,
                'passed': passed,
            })

        if q:
            ql = q.strip().lower()
            items = [it for it in items if ql in it['person_id'].lower()
                     or ql in (it['name_zh'] or '').lower()
                     or ql in (it['name_db'] or '').lower()
                     or ql in (it['name_file'] or '').lower()]

        items.sort(key=lambda it: it['work_count'], reverse=True)
        total = len(items)
        start = (page - 1) * size
        page_items = items[start:start + size]

        resp = {
            'ok': True, 'mode': 'ro', 'total': total, 'page': page, 'size': size,
            'pages': max(1, (total + size - 1) // size), 'items': page_items,
        }
        if warning:
            resp['warning'] = warning
        return jsonify(resp)
    except Exception as e:
        return jsonify({'ok': False, 'error': str(e)}), 500
    finally:
        conn.close()


@app.route('/daoanh/api/admin/work-verify/<person_id>/pass', methods=['POST'])
@app.route('/api/admin/work-verify/<person_id>/pass', methods=['POST'])
def admin_work_verify_pass(person_id):
    """POST /daoanh/api/admin/work-verify/<person_id>/pass — body {name_vi}.

    Ghi tên Việt đã Admin duyệt cho ĐÚNG person_id này, dùng lại cơ chế
    name_vi_map (dila_id) + sync people.name_vi — giống admin_namevi_map_update()
    ở trên (dòng ~515-592), chỉ khác approved_by lấy email thật từ session
    (không hard-code 'admin'). person_id của dila_catalog_contributors và
    dila_id của name_vi_map cùng là khóa people.id (đã kiểm bằng DB:
    person_id='A000457' == people.id='A000457')."""
    token = request.headers.get('X-Session-Token', '')
    if not verify_session(token):
        return jsonify({'ok': False, 'error': 'Unauthorized'}), 403

    data = request.get_json(silent=True) or {}
    name_vi = (data.get('name_vi') or '').strip()
    if not name_vi:
        return jsonify({'ok': False, 'error': 'Tên Việt không được rỗng'}), 400
    if not person_id:
        return jsonify({'ok': False, 'error': 'Missing person_id'}), 400

    editor_email = _t427_session_email(token) or 'admin'
    conn = sqlite3.connect(SQLITE_DB)
    try:
        now = datetime.now().isoformat()
        name_zh_row = conn.execute(
            "SELECT name_zh FROM people WHERE id = ?", (person_id,)
        ).fetchone()
        name_zh = name_zh_row[0] if name_zh_row else None

        row = conn.execute(
            "SELECT id FROM name_vi_map WHERE dila_id = ? ORDER BY confidence DESC, id ASC LIMIT 1",
            (person_id,)
        ).fetchone()
        if row:
            try:
                conn.execute("""
                    UPDATE name_vi_map SET
                        name_vi = ?, name_vi_final = ?,
                        approved_by = ?, approved_at = ?
                    WHERE id = ?
                """, (name_vi, name_vi, editor_email, now, row[0]))
            except sqlite3.IntegrityError:
                conn.execute("""
                    UPDATE name_vi_map SET
                        name_vi_final = ?,
                        approved_by = ?, approved_at = ?
                    WHERE id = ?
                """, (name_vi, editor_email, now, row[0]))
        else:
            try:
                conn.execute("""
                    INSERT INTO name_vi_map (name_vi, name_vi_final, name_zh, dila_id, approved_by, approved_at, confidence, created_at)
                    VALUES (?, ?, ?, ?, ?, ?, 1.0, ?)
                """, (name_vi, name_vi, name_zh, person_id, editor_email, now, now))
            except sqlite3.IntegrityError:
                conn.execute("""
                    INSERT INTO name_vi_map (name_vi, name_vi_final, name_zh, dila_id, approved_by, approved_at, confidence, created_at)
                    VALUES (?, ?, NULL, ?, ?, ?, 1.0, ?)
                """, (name_vi, name_vi, person_id, editor_email, now, now))

        # Sync people.name_vi — CHỈ person_id được truyền trong URL, không
        # đụng người khác. Đây là nơi routes_lineage.py (api_global_search,
        # public_dila_works) và các tab ETL/Catalog/Xác Minh khác đọc tên
        # Việt của người (COALESCE(p.name_vi, c.name_vi) hoặc p.name_vi trực
        # tiếp — xem routes_lineage.py dòng ~2439-2442, ~2452).
        if name_vi != '—':
            conn.execute("UPDATE people SET name_vi = ? WHERE id = ?", (name_vi, person_id))
        conn.commit()
        return jsonify({'ok': True, 'person_id': person_id, 'name_vi': name_vi,
                        'approved_by': editor_email, 'approved_at': now})
    except Exception as e:
        return jsonify({'ok': False, 'error': str(e)}), 500
    finally:
        conn.close()
