    # T166 §7.1 — BẮT BUỘC verify_session.
    # Endpoint này ghi name_vi_map.name_vi_final + approved_by='admin' + people.name_vi
    # ⇒ đây chính là nguồn tạo LOCKED authority (SOURCE_LEVELS['name_vi_map.final+approved']=1.0).
    # Không có auth ⇒ bất kỳ ai cũng "đúc" được nguồn LOCK (SPEC §20.2 #15).
    token = request.headers.get('X-Session-Token', '')
    if not verify_session(token):
        return jsonify({"success": False, "error": "Unauthorized"}), 403

    data = request.get_json()
    dila_id = data.get('dila_id')
    name_vi = data.get('name_vi')
    
    if not dila_id or not name_vi:
        return jsonify({'success': False, 'error': 'Missing dila_id or name_vi'}), 400
    
    conn = sqlite3.connect(SQLITE_DB)
    try:
        now = datetime.now().isoformat()
        # Tìm row canonical (confidence cao nhất) theo dila_id
        row = conn.execute(
            "SELECT id FROM name_vi_map WHERE dila_id = ? ORDER BY confidence DESC, id ASC LIMIT 1",
            (dila_id,)
        ).fetchone()
        if row:
            # Chỉ update name_vi + name_vi_final + approved — KHÔNG đổi name_zh
            # Đổi name_zh gây UNIQUE(name_vi, name_zh) conflict khi có nhiều row cùng dila_id
            try:
                if 'name_zh' in data:
                    conn.execute("""
                        UPDATE name_vi_map SET
                            name_vi = ?, name_vi_final = ?, name_zh = ?,
                            approved_by = 'admin', approved_at = ?
                        WHERE id = ?
                    """, (name_vi, name_vi, data['name_zh'], now, row[0]))
                else:
                    conn.execute("""
                        UPDATE name_vi_map SET
                            name_vi = ?, name_vi_final = ?,
                            approved_by = 'admin', approved_at = ?
                        WHERE id = ?
                    """, (name_vi, name_vi, now, row[0]))
            except sqlite3.IntegrityError:
                # UNIQUE(name_vi, name_zh) conflict — tên Việt này đã có cho tên Hán khác.
                # Fallback: chỉ ghi name_vi_final (không đổi name_vi gốc) để tránh conflict.
                conn.execute("""
                    UPDATE name_vi_map SET
                        name_vi_final = ?,
                        approved_by = 'admin', approved_at = ?
                    WHERE id = ?
                """, (name_vi, now, row[0]))
        else:
            try:
                conn.execute("""
                    INSERT INTO name_vi_map (name_vi, name_vi_final, name_zh, dila_id, approved_by, approved_at, confidence, created_at)
                    VALUES (?, ?, ?, ?, 'admin', ?, 1.0, ?)
                """, (
                    name_vi, name_vi,
                    data.get('name_zh'),
                    dila_id, now, now
                ))
            except sqlite3.IntegrityError:
                # UNIQUE conflict khi INSERT — thử lại với name_zh=NULL
                conn.execute("""
                    INSERT INTO name_vi_map (name_vi, name_vi_final, name_zh, dila_id, approved_by, approved_at, confidence, created_at)
                    VALUES (?, ?, NULL, ?, 'admin', ?, 1.0, ?)
                """, (name_vi, name_vi, dila_id, now, now))
        # Sync people.name_vi — nhưng KHÔNG ghi '—' (sentinel reject) vào people
        if name_vi != '—':
            conn.execute("UPDATE people SET name_vi = ? WHERE id = ?", (name_vi, dila_id))
        conn.commit()
        return jsonify({'success': True, 'dila_id': dila_id, 'name_vi': name_vi, 'name_vi_final': name_vi})
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)}), 500
    finally:
        conn.close()



