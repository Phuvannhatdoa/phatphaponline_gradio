@app.route('/api/admin/namevi/ttl-stats', methods=['GET'])
@app.route('/daoanh/api/admin/namevi/ttl-stats', methods=['GET'])
def admin_namevi_ttl_stats():
    """GET /api/admin/namevi/ttl-stats
    Thống kê DILA IDs trong name_vi_map: đã có TTL trong DB hay chưa.
    Query params:
      - status: 'no_ttl' (chưa có, mặc định) | 'has_ttl' | 'all'
      - page, per_page
      - q: tìm kiếm theo tên / DILA ID
    """
    status   = request.args.get('status', 'no_ttl')
    page     = max(1, int(request.args.get('page', 1)))
    per_page = min(100, int(request.args.get('per_page', 50)))
    q        = request.args.get('q', '').strip()
    offset   = (page - 1) * per_page

    try:
        conn = get_db()

        # ── bảng ttl_master có tồn tại chưa ──
        tbl_exists = conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table' AND name='ttl_master'"
        ).fetchone()

        ttl_ids = set()
        if tbl_exists:
            rows = conn.execute("SELECT dila_id FROM ttl_master WHERE dila_id IS NOT NULL").fetchall()
            ttl_ids = {r[0] for r in rows}
            # thêm từ vn_person_authority.ttl_filename
        try:
            vpa = conn.execute(
                "SELECT dila_id FROM vn_person_authority WHERE ttl_filename IS NOT NULL AND ttl_filename != ''"
            ).fetchall()
            ttl_ids.update(r[0] for r in vpa if r[0])
        except Exception:
            pass

        # ── tổng quan ──
        total_nvm    = conn.execute("SELECT COUNT(*) FROM name_vi_map WHERE dila_id IS NOT NULL").fetchone()[0]
        has_ttl_cnt  = sum(1 for did in ttl_ids if did)  # bao gồm cả VPA
        # đếm chính xác hơn: giao giữa name_vi_map.dila_id và ttl_ids
        nvm_dila_ids = {r[0] for r in conn.execute(
            "SELECT dila_id FROM name_vi_map WHERE dila_id IS NOT NULL"
        ).fetchall()}
        has_ttl_cnt  = len(nvm_dila_ids & ttl_ids)
        no_ttl_cnt   = total_nvm - has_ttl_cnt

        # ── danh sách ──
        q_filter  = " AND (nvm.dila_id LIKE :q OR nvm.name_zh LIKE :q OR nvm.name_vi LIKE :q)" if q else ""
        q_param   = {'q': f'%{q}%'} if q else {}

        if status == 'has_ttl':
            # IDs ĐÃ có TTL
            placeholders = ','.join('?' * len(ttl_ids)) if ttl_ids else "''"
            where_clause = f"WHERE nvm.dila_id IN ({placeholders})"
            bind_list = list(ttl_ids) if ttl_ids else []
            count_sql = f"SELECT COUNT(*) FROM name_vi_map nvm {where_clause}"
            if q:
                where_clause += f" AND (nvm.dila_id LIKE ? OR nvm.name_zh LIKE ? OR nvm.name_vi LIKE ?)"
                bind_list += [f'%{q}%', f'%{q}%', f'%{q}%']
            list_sql = (
                f"SELECT nvm.dila_id, nvm.name_zh, nvm.name_vi, nvm.name_vi_final, "
                f"nvm.name_vi_auto, nvm.birth_year, nvm.death_year "
                f"FROM name_vi_map nvm {where_clause} "
                f"ORDER BY nvm.name_vi_final DESC, nvm.name_zh "
                f"LIMIT {per_page} OFFSET {offset}"
            )
            total_list = conn.execute(count_sql, bind_list).fetchone()[0]
            items_raw  = conn.execute(list_sql, bind_list).fetchall()
        else:
            # IDs CHƯA có TTL — đây là hàng đợi ưu tiên
            if ttl_ids:
                placeholders = ','.join(['?'] * len(ttl_ids))
                excl = f"AND nvm.dila_id NOT IN ({placeholders})"
                bind_excl = list(ttl_ids)
            else:
                excl, bind_excl = "", []
            q_bind = ([f'%{q}%'] * 3) if q else []
            q_where = (
                " AND (nvm.dila_id LIKE ? OR nvm.name_zh LIKE ? OR nvm.name_vi LIKE ?)"
                if q else ""
            )
            base_where = f"WHERE nvm.dila_id IS NOT NULL {excl}{q_where}"
            count_sql  = f"SELECT COUNT(*) FROM name_vi_map nvm {base_where}"
            # ưu tiên: đã duyệt tên Việt > có gợi ý > có năm sinh mất
            list_sql = (
                f"SELECT nvm.dila_id, nvm.name_zh, nvm.name_vi, nvm.name_vi_final, "
                f"nvm.name_vi_auto, nvm.birth_year, nvm.death_year "
                f"FROM name_vi_map nvm {base_where} "
                f"ORDER BY "
                f"  (nvm.name_vi_final IS NOT NULL AND nvm.name_vi_final != '') DESC, "
                f"  (nvm.birth_year IS NOT NULL) DESC, "
                f"  (nvm.name_vi_auto IS NOT NULL AND nvm.name_vi_auto != '') DESC, "
                f"  nvm.name_zh "
                f"LIMIT {per_page} OFFSET {offset}"
            )
            all_binds  = bind_excl + q_bind
            total_list = conn.execute(count_sql, all_binds).fetchone()[0]
            items_raw  = conn.execute(list_sql,  all_binds).fetchall()

        # ── đếm file trên disk ──
        ttl_disk = 0
        if os.path.exists(TTL_MASTER_DIR):
            ttl_disk = len([f for f in os.listdir(TTL_MASTER_DIR) if f.endswith('.ttl')])

        conn.close()

        def priority(row):
            if row[3]:             return 'HIGH'    # name_vi_final
            if row[5] or row[6]:   return 'MEDIUM'  # birth/death year
            if row[4]:             return 'MEDIUM'  # name_vi_auto
            return 'LOW'

        items = [{
            'dila_id':       r[0],
            'name_zh':       r[1],
            'name_vi':       r[3] or r[4] or r[2] or '',
            'name_vi_final': r[3],
            'name_vi_auto':  r[4],
            'birth_year':    r[5],
            'death_year':    r[6],
            'priority':      priority(r),
        } for r in items_raw]

        return jsonify({
            'ok':          True,
            'total_nvm':   total_nvm,
            'has_ttl':     has_ttl_cnt,
            'no_ttl':      no_ttl_cnt,
            'ttl_disk':    ttl_disk,
            'coverage_pct': round(100 * has_ttl_cnt / total_nvm, 1) if total_nvm > 0 else 0,
            'status':      status,
            'total_list':  total_list,
            'items':       items,
        })
    except Exception as e:
        import traceback
        return jsonify({'ok': False, 'error': str(e), 'trace': traceback.format_exc()}), 500




@app.route('/api/admin/namevi/flag-list', methods=['GET'])
@app.route('/daoanh/api/admin/namevi/flag-list', methods=['GET'])
def admin_namevi_flag_list():
    """GET /api/admin/namevi/flag-list
    Trả danh sách các DILA ID có FLAG: vn_person_authority.name_vi != people.name_vi.
    Query params:
      - page, per_page (mặc định 50)
      - q: tìm kiếm theo DILA ID, name_zh, hoặc name_vi
      - hide_done: 'true' (mặc định) — ẩn các ID đã có name_vi_final trong name_vi_map
      - sort_by: 'confidence_cross' (mặc định: p.id)
      - sort_dir: 'desc' | 'asc' (mặc định 'desc' khi sort_by=confidence_cross)
    """
    page        = max(1, int(request.args.get('page', 1)))
    per_page    = min(200, max(1, int(request.args.get('per_page', 50))))
    q           = request.args.get('q', '').strip()
    hide_done   = request.args.get('hide_done', 'true').lower() != 'false'
    sort_by     = request.args.get('sort_by', '').strip()
    sort_dir    = request.args.get('sort_dir', 'desc').strip().lower()
    mode        = request.args.get('mode', '').strip()          # 'xcm' = tab Xác Minh
    filter_param = request.args.get('filter', '').strip()       # 'rejected' = chỉ đã Reject (—)
    offset      = (page - 1) * per_page

    try:
        conn = get_db()

        # Điều kiện cơ bản: TTL có name_vi, DILA có name_vi, hai bên khác nhau
        conds = [
            "va.name_vi IS NOT NULL", "va.name_vi != ''",
            "p.name_vi IS NOT NULL",  "p.name_vi != ''",
            "va.name_vi != p.name_vi",
        ]
        params = []

        if q:
            conds.append("(p.id LIKE ? OR p.name_zh LIKE ? OR p.name_vi LIKE ? OR va.name_vi LIKE ?)")
            like = f"%{q}%"
            params += [like, like, like, like]

        if filter_param == 'rejected':
            # Chỉ trả row đã admin từ chối (—) — bỏ qua hide_done bình thường
            conds.append(
                "EXISTS ("
                "  SELECT 1 FROM name_vi_map"
                "  WHERE dila_id=p.id AND approved_by='admin' AND name_vi_final='—'"
                ")"
            )
        elif hide_done:
            if mode == 'xcm':
                # Tab Xác Minh: ẩn chỉ những row đã Pass thật (approved + tên thật).
                # Vẫn hiện row đã Reject (name_vi_final='—') để admin có thể xem lại.
                conds.append(
                    "NOT EXISTS ("
                    "  SELECT 1 FROM name_vi_map"
                    "  WHERE dila_id=p.id AND approved_by='admin'"
                    "  AND name_vi_final IS NOT NULL AND name_vi_final != '' AND name_vi_final != '—'"
                    ")"
                )
            else:
                # Default (ETL tab): ẩn tất cả đã có name_vi_final (kể cả —)
                conds.append(
                    "(SELECT name_vi_final FROM name_vi_map WHERE dila_id=p.id ORDER BY approved_at DESC LIMIT 1)"
                    " IS NULL OR "
                    "(SELECT name_vi_final FROM name_vi_map WHERE dila_id=p.id ORDER BY approved_at DESC LIMIT 1) = ''"
                )

        where = " AND ".join(conds)

        # BUG-046 fix (2026-10-19): cột Claude phải lấy từ codex_person_name, không phải va.name_vi
        # (va.name_vi = vn_person_authority = cùng nguồn với ttl_name_vi → trùng data)
        has_codex = True
        codex_select = "cx.name_vi AS codex_name_vi"
        codex_join   = "LEFT JOIN codex_person_name cx ON cx.dila_id = p.id"

        # SQL score: Gemini match + TTL match (lex không thể dùng trong SQL, codex thường empty)
        # Mỗi cột khớp = 1 điểm → sort DESC = cao nhất trước
        sql_score = """
            (CASE WHEN p.name_vi != '' AND ai.name_vi_ai IS NOT NULL
                       AND ai.name_vi_ai LIKE '%' || p.name_vi || '%' THEN 1 ELSE 0 END
           + CASE WHEN p.name_vi != '' AND va.name_vi IS NOT NULL
                       AND va.name_vi     LIKE '%' || p.name_vi || '%' THEN 1 ELSE 0 END)
        """
        if sort_by == 'confidence_cross':
            dir_sql = 'DESC' if sort_dir != 'asc' else 'ASC'
            order_clause = f"({sql_score}) {dir_sql}, p.id"
        else:
            order_clause = "p.id"

        sql_data = f"""
            SELECT p.id AS dila_id,
                   p.name_zh,
                   va.name_vi   AS ttl_name_vi,
                   p.name_vi    AS dila_name_vi,
                   (SELECT name_vi_final FROM name_vi_map WHERE dila_id=p.id
                    ORDER BY approved_at DESC LIMIT 1) AS name_vi_final,
                   va.status    AS vnpa_status,
                   ai.name_vi_ai AS ai_name_vi,
                   {codex_select}
            FROM (
                SELECT dila_id, MAX(name_vi) AS name_vi,
                       MAX(status) AS status
                FROM vn_person_authority
                WHERE dila_id IS NOT NULL AND dila_id != ''
                GROUP BY dila_id
            ) va
            JOIN people p ON p.id = va.dila_id
            LEFT JOIN ai_person_name ai ON ai.dila_id = p.id
            {codex_join}
            WHERE {where}
            ORDER BY {order_clause}
            LIMIT ? OFFSET ?
        """
        sql_count = f"""
            SELECT COUNT(DISTINCT p.id)
            FROM (
                SELECT dila_id, MAX(name_vi) AS name_vi
                FROM vn_person_authority
                WHERE dila_id IS NOT NULL AND dila_id != ''
                GROUP BY dila_id
            ) va
            JOIN people p ON p.id = va.dila_id
            WHERE {where}
        """

        rows  = conn.execute(sql_data,  params + [per_page, offset]).fetchall()
        total = conn.execute(sql_count, params).fetchone()[0]

        def _confidence(status, ttl_zh, dila_zh):
            # name_zh exact match = tín hiệu mạnh nhất
            zh_match = bool(ttl_zh and dila_zh and ttl_zh.strip() == dila_zh.strip())
            if status == 'verified':      return 100
            if zh_match:                  return 99
            if status == 'alias_zh_match': return 90
            if status == 'auto_ttl':      return 80
            if status == 'alias_vi_suffix': return 70
            return 50  # pending / unknown

        def _confidence_cross(dila_name_vi, codex_vi, gemini_vi, ttl_vi, lex_src):
            """Tỉ lệ cột chứa dila_name_vi / tổng cột có dữ liệu (×100)."""
            if not dila_name_vi:
                return 0
            name = dila_name_vi.lower()
            col_vals = [codex_vi or '', gemini_vi or '', ttl_vi or '', lex_src or '']
            non_empty = [c.lower() for c in col_vals if c.strip() and c.strip() != '—']
            if not non_empty:
                return 0
            matches = sum(1 for c in non_empty if name in c)
            return round(matches / len(non_empty) * 100)

        items = []
        for r in rows:
            ttl_vi   = r['ttl_name_vi']  or ''
            dila_vi  = r['dila_name_vi'] or ''
            codex_vi = r['codex_name_vi'] or ''
            gemini_vi = r['ai_name_vi'] or ''
            lex_src  = _lex_lookup(ttl_vi) or _lex_lookup(dila_vi)
            conf_cross = _confidence_cross(dila_vi, codex_vi, gemini_vi, ttl_vi, lex_src)
            items.append({
                'dila_id':          r['dila_id'],
                'name_zh':          r['name_zh'] or '',
                'ttl_name_vi':      ttl_vi,
                'dila_name_vi':     dila_vi,
                'name_vi_final':    r['name_vi_final'] or '',
                'ai_name_vi':       gemini_vi,
                'codex_name_vi':    codex_vi,
                'confidence':       _confidence(r['vnpa_status'] or '', ttl_vi, r['name_zh'] or ''),
                'confidence_cross': conf_cross,
                'lexicon_source':   lex_src,
            })

        # Lưu ý: SQL đã ORDER BY score để pagination đúng (không cần sort Python)

        return jsonify({
            'ok':       True,
            'items':    items,
            'total':    total,
            'page':     page,
            'per_page': per_page,
            'pages':    (total + per_page - 1) // per_page,
        })

    except Exception as e:
        return jsonify({'ok': False, 'error': str(e)}), 500




