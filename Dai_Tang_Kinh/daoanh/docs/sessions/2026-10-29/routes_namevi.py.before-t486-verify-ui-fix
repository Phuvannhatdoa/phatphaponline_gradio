@app.route('/api/admin/namevi/bulk-pass', methods=['POST'])
@app.route('/daoanh/api/admin/namevi/bulk-pass', methods=['POST'])
def admin_namevi_bulk_pass():
    """POST /api/admin/namevi/bulk-pass
    Body: {"min_confidence": 99, "dry_run": true}
    Bulk-approve FLAG entries có confidence >= min_confidence và chưa có name_vi_final.
    Approve dùng people.name_vi (DILA canonical) làm name_vi_final.
    dry_run=true: chỉ đếm, không ghi DB.
    Trả: {ok, count, sample (5 entries), dry_run}
    """
    token = request.headers.get('X-Session-Token', '')
    if not verify_session(token):
        return jsonify({'ok': False, 'error': 'Unauthorized'}), 401

    body           = request.get_json(silent=True) or {}
    min_conf       = int(body.get('min_confidence', 99))
    dry_run        = bool(body.get('dry_run', True))

    # Clamp: chỉ cho phép 90–100 để tránh approve sai hàng loạt
    if min_conf < 90:
        return jsonify({'ok': False, 'error': 'min_confidence tối thiểu là 90 để bảo đảm an toàn'}), 400

    try:
        conn = sqlite3.connect(DB_PATH, timeout=30)
        conn.row_factory = sqlite3.Row

        # Lấy tất cả FLAG entries chưa done
        candidates = conn.execute("""
            SELECT p.id AS dila_id,
                   p.name_vi  AS dila_vi,
                   p.name_zh  AS dila_zh,
                   va.name_zh AS ttl_zh,
                   va.status  AS vnpa_status
            FROM (
                SELECT dila_id, MAX(name_vi) AS name_vi,
                       MAX(name_zh) AS name_zh, MAX(status) AS status
                FROM vn_person_authority
                WHERE dila_id IS NOT NULL AND dila_id != ''
                GROUP BY dila_id
            ) va
            JOIN people p ON p.id = va.dila_id
            WHERE va.name_vi != p.name_vi
              AND (SELECT name_vi_final FROM name_vi_map
                   WHERE dila_id = p.id ORDER BY approved_at DESC LIMIT 1)
                  IS NULL
        """).fetchall()

        def _conf(r):
            zh_match = bool(r['ttl_zh'] and r['dila_zh'] and
                            r['ttl_zh'].strip() == r['dila_zh'].strip())
            s = r['vnpa_status'] or ''
            if s == 'verified':          return 100
            if zh_match:                 return 99
            if s == 'alias_zh_match':    return 90
            if s == 'auto_ttl':          return 80
            if s == 'alias_vi_suffix':   return 70
            return 50

        to_pass = [r for r in candidates if _conf(r) >= min_conf]
        sample  = [{'dila_id': r['dila_id'], 'name_vi': r['dila_vi'],
                    'confidence': _conf(r)} for r in to_pass[:5]]

        if dry_run:
            conn.close()
            return jsonify({'ok': True, 'dry_run': True,
                            'count': len(to_pass), 'sample': sample})

        # Ghi DB
        now = datetime.now().isoformat()
        updated = 0
        for r in to_pass:
            dila_id = r['dila_id']
            name_vi = r['dila_vi']
            if not name_vi:
                continue
            existing = conn.execute(
                "SELECT id FROM name_vi_map WHERE dila_id = ?", (dila_id,)
            ).fetchone()
            if existing:
                conn.execute("""
                    UPDATE name_vi_map
                    SET name_vi_final = ?, name_vi = ?,
                        approved_by = 'bulk_pass', approved_at = ?
                    WHERE dila_id = ?
                """, (name_vi, name_vi, now, dila_id))
            else:
                name_zh = r['dila_zh'] or ''
                conn.execute("""
                    INSERT INTO name_vi_map
                        (dila_id, name_vi, name_vi_final, name_zh,
                         approved_by, approved_at, confidence, created_at)
                    VALUES (?, ?, ?, ?, 'bulk_pass', ?, 1.0, ?)
                """, (dila_id, name_vi, name_vi, name_zh, now, now))
            updated += 1

        conn.commit()
        conn.close()
        return jsonify({'ok': True, 'dry_run': False,
                        'count': updated, 'sample': sample})

    except Exception as e:
        return jsonify({'ok': False, 'error': str(e)}), 500




