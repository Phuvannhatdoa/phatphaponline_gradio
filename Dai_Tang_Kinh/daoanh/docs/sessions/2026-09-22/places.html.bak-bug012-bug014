        function loadPersonTimeline(dilaId) {
            const block = document.getElementById('personEventsBlock');
            if (!block) return;
            fetch(baseUrl + '/daoanh/api/persons/' + encodeURIComponent(dilaId))
                .then(r => r.json())
                .then(d => {
                    const list = document.getElementById('personEventsList');
                    const tl = (d && d.timeline) || [];
                    if (!d || !tl.length) { block.classList.add('hidden'); return; }
                    block.classList.remove('hidden');
                    let html = '';
                    tl.forEach(ev => {
                        const yearStr = ev.event_year ? ev.event_year + ' CE' : '—';
                        const conf = ev.confidence ? Math.round(ev.confidence * 100) + '%' : '';
                        const srcMap = {
                            'dila_active_regex': 'DILA (hoạt động)',
                            'dila_person_regex': 'DILA (sinh/tịch)',
                            'legacy_ttl': 'TTL duyệt thủ công'
                        };
                        const src = srcMap[ev.source] || ev.source || '';
                        const ic = ev.event_type === 'birth' ? '🌱' :
                            ev.event_type === 'death' ? '🪔' :
                            ev.event_type === 'active' ? '📅' :
                            ev.event_type === 'floruit' ? '📍' : '✦';
                        html += `<div style="display:flex;align-items:flex-start;gap:8px;padding:7px 10px;background:var(--da-card);border:1px solid var(--da-border);border-radius:6px">
                            <span style="font-size:12px;line-height:1.4">${ic}</span>
                            <div style="flex:1;min-width:0">
                                <div style="font-size:12px;font-weight:600;color:var(--da-text)">${_escHtml(ev.label_vi || ev.event_type)}</div>
                                <div style="font-size:10px;color:var(--da-muted);margin-top:2px">
                                    <span style="color:var(--da-gold-b);font-weight:600">${_escHtml(yearStr)}</span>
                                    ${conf ? ' · ' + _escHtml(conf) + ' tin cậy' : ''}
                                    ${src ? ' · ' + _escHtml(src) : ''}
                                </div>
                            </div>
                        </div>`;
                    });
                    list.innerHTML = html;
                })
                .catch(() => { block.classList.add('hidden'); });
        }

        function _escHtml(s) {
            return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function tamDich(refEnc, pid) {
