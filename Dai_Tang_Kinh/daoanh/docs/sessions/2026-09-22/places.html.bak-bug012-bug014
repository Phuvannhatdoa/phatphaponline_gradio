                if (window._nexusNetwork) _nexusNetwork.fit({ animation: { duration: 250, easingFunction: 'easeInOutQuad' } });
                if (window._lineageNetwork) { _lineageNetwork.fit({animation:false}); var sc=_lineageNetwork.getScale(); _lineageNetwork.moveTo({scale:sc*1.5,animation:false}); }
