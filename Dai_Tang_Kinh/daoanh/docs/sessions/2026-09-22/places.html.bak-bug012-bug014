        // ——— Phase 3: Share link + Bookmark ———
        function _nexusShareLink() {
            if (!_nexusData || !_nexusData.center) return;
            const c = _nexusData.center;
            const etype = _nexusData.entity_type || 'place';
            const url = window.location.origin + window.location.pathname
                + '?nexus_root=' + encodeURIComponent(c.id)
                + '&nexus_type=' + etype;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(() => {
                    const btn = document.getElementById('nmp-btn-share');
                    if (btn) { btn.textContent = '✓ Đã sao chép'; btn.style.color = 'var(--da-green,#4ade80)'; setTimeout(() => { btn.textContent = '🔗 Chia sẻ'; btn.style.color = ''; }, 2000); }
                });
            } else {
                prompt('Sao chép link:', url);
            }
        }
        function _nexusBookmark() {
            if (!_nexusData || !_nexusData.center) return;
            const c = _nexusData.center;
            const etype = _nexusData.entity_type || 'place';
            const bm = JSON.parse(localStorage.getItem('nexus_bookmarks') || '[]');
            const exists = bm.find(b => b.id === c.id && b.type === etype);
            if (exists) {
                const idx = bm.indexOf(exists);
                bm.splice(idx, 1);
                const btn = document.getElementById('nmp-btn-bookmark');
                if (btn) { btn.textContent = '⭐ Lưu'; btn.style.color = ''; }
            } else {
                bm.push({ id: c.id, type: etype, label: c.label || c.label_zh || c.id, label_zh: c.label_zh || '', ts: Date.now() });
                const btn = document.getElementById('nmp-btn-bookmark');
                if (btn) { btn.textContent = '✓ Đã lưu'; btn.style.color = 'var(--da-gold)'; setTimeout(() => { btn.textContent = '⭐ Lưu'; btn.style.color = ''; }, 2000); }
            }
            localStorage.setItem('nexus_bookmarks', JSON.stringify(bm));
        }
        function _nexusUpdateBookmarkBtn() {
            if (!_nexusData || !_nexusData.center) return;
            const bm = JSON.parse(localStorage.getItem('nexus_bookmarks') || '[]');
            const btn = document.getElementById('nmp-btn-bookmark');
            if (!btn) return;
            const saved = bm.find(b => b.id === _nexusData.center.id && b.type === (_nexusData.entity_type || 'place'));
            btn.textContent = saved ? '✓ Đã lưu' : '⭐ Lưu';
            btn.style.color = saved ? 'var(--da-gold)' : '';
        }

        // ——— Phase 3: Export graph (JSON + PNG) ———
        function _nexusExportGraph() {
            if (!_nexusData || !_nexusData.center) return;
            // Export as JSON
            const exportData = {
                version: 'nexus-v1',
                exported_at: new Date().toISOString(),
                center: _nexusData.center,
                entity_type: _nexusData.entity_type,
                nodes: (_nexusData.nodes || []),
                edges: (_nexusData.edges || []),
                stats: { node_count: (_nexusData.nodes || []).length, edge_count: (_nexusData.edges || []).length }
            };
            const jsonStr = JSON.stringify(exportData, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'nexus-' + (_nexusData.entity_type || 'entity') + '-' + (_nexusData.center.id || 'unknown') + '.json';
            a.click();
            URL.revokeObjectURL(a.href);
            // Export as PNG (vis.js canvas)
            const canvas = document.getElementById('nmp-canvas');
            if (canvas) {
                const visCanvas = canvas.querySelector('canvas');
                if (visCanvas) {
                    const pngUrl = visCanvas.toDataURL('image/png');
                    const a2 = document.createElement('a');
                    a2.href = pngUrl;
                    a2.download = 'nexus-' + (_nexusData.entity_type || 'entity') + '-' + (_nexusData.center.id || 'unknown') + '.png';
                    a2.click();
                }
            }
            const btn = document.getElementById('nmp-btn-export');
            if (btn) { btn.textContent = '✓ Đã xuất'; btn.style.color = 'var(--da-green,#4ade80)'; setTimeout(() => { btn.textContent = '📥 Xuất'; btn.style.color = ''; }, 2000); }
        }

        // Nhân Vật tab — 2 nguồn độc lập, đều có trích dẫn thật, KHÔNG regex/fuzzy đoán:
        //   d.persons          — curated place_person_link, đã có DILA person_id -> click được
        //                        thẳng sang tab Truyền Thừa.
        //   d.wikidata_persons — tra sống Wikidata P112 qua geo_cross_ref (T21 bridge). Có thật,
        //                        có nguồn, nhưng CHƯA gắn DILA ID (identity chưa được admin xác
        //                        nhận — xem tasks/T28) nên KHÔNG click được vào Truyền Thừa.
        // Rỗng cả 2 = chưa có dữ liệu qua đường nào, hiện trạng thái + hướng nghiên cứu trung thực.
        function renderPersonsTab(d) {
            const ph = document.getElementById('persons-placeholder');
            const ct = document.getElementById('persons-content');
            if (!d.ok) { ph.style.display = ''; ph.textContent = '⚠ Lỗi tải dữ liệu.'; return; }
            ph.style.display = 'none'; ct.style.display = 'block';

            const persons = d.persons || [];
            const wdPersons = d.wikidata_persons || [];
            const biblPersons = d.bibl_persons || [];
            const bioPersons = d.bio_persons || [];
            const originPersons = d.origin_persons || [];
            if (persons.length === 0 && wdPersons.length === 0 && biblPersons.length === 0 && bioPersons.length === 0 && originPersons.length === 0) {
                let html = '<div class="da-warn" style="margin:4px 0 14px">⚠ Chưa có nhân vật đã xác minh cho địa danh này</div>';
                html += '<p style="font-size:11px;color:var(--da-muted);line-height:1.7;margin-bottom:10px">' + _escHtml(d.message || '') + '</p>';
                if (d.research_directions && d.research_directions.length) {
                    html += '<div class="da-block-label">Hướng nghiên cứu</div><ul style="font-size:10.5px;color:var(--da-dim);line-height:1.8;padding-left:16px;margin-top:4px">';
                    d.research_directions.forEach(rd => html += '<li>' + _escHtml(rd) + '</li>');
                    html += '</ul>';
                }
                ct.innerHTML = html;
                return;
            }
            let html = '';
            if (persons.length) {
                html += '<div class="da-block-label">Đã xác minh (admin curate)</div>';
                persons.forEach(p => {
                    html += '<div class="da-person-row" style="align-items:flex-start;cursor:pointer" data-pid="' + p.id + '" data-pname="' + _escHtml(p.name_vi || p.name_zh) + '" onclick="selectPerson(this.dataset.pid, this.dataset.pname)">';
                    html += '<div class="da-person-avatar">' + _escHtml((p.name_zh || p.id)[0]) + '</div>';
                    html += '<div style="flex:1;min-width:0">';
                    const displayName = p.name_vi || p.name_zh;
                    const altName = (p.marcus_label && p.marcus_label !== p.name_zh) ? p.marcus_label : null;
                    html += '<div class="da-person-name-vi">' + _escHtml(displayName) +
                        (altName ? ' <span style="font-size:10px;color:var(--da-muted)">(' + _escHtml(altName) + ')</span>' : '') +
                        (p.has_lineage ? ' <span class="da-nexus-badge">🌳 TRUYỀN THỪA</span>' : '') + '</div>';
                    html += '<div class="da-person-name-zh">' + _escHtml(p.name_zh || '') + (p.dynasty ? ' · ' + _escHtml(p.dynasty) : '') + '</div>';
                    if (p.relation_type) html += '<div style="font-size:9.5px;color:var(--da-gold-b);margin-top:2px">' + _escHtml(p.relation_type) + '</div>';
