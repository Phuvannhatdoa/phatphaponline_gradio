            p._units = undefined; p._unitsLoaded = true;
            fetch('/daoanh/api/cbeta/passages/' + encodeURIComponent(p.passage_id) + '/units?work_id=' + encodeURIComponent(p.text_id))
                .then(function(r){ return r.json(); })
                .then(function(d){
                    if (!d.ok) throw new Error(d.error || 'Lỗi API');
                    p._units = d.units || [];
                    p._coverage = d.coverage || null;
                    dtRenderPassage(_dtActivePassage);
