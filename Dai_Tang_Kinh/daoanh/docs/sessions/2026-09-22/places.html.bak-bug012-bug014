        const _NON_DYNASTY = new Set(['印度','中亞','天竺','波斯','西域']);
        function _fmtDynasty(raw) {
            if (!raw) return '';
            // Tách multi-value (newline, slash, comma, semicolon)
            const parts = raw.split(/[\n\/,，;；]+/).map(function(s){ return s.trim(); }).filter(Boolean);
            if (parts.length === 0) return '';
            function _fmt1(p) {
                if (_NON_DYNASTY.has(p)) return p;  // quốc gia/vùng, không phải triều đại
