        async function loadInitialPlaces(cate) {
            // Cancel any in-progress load
            if (loadAbortController) loadAbortController.abort();
            loadAbortController = new AbortController();
            const signal = loadAbortController.signal;

            const BATCH = 800;
            let offset = 0;
            let total = 0;
            const nodeCount = document.getElementById('nodeCount');
            const label = CATE_LABELS[cate] || cate;

            // BUG-008: use current map viewport bbox to load nearby places
            const _bounds = map.getBounds();
            const _bboxParam = cate ? `&bbox=${_bounds.getSouth().toFixed(4)},${_bounds.getWest().toFixed(4)},${_bounds.getNorth().toFixed(4)},${_bounds.getEast().toFixed(4)}` : '';

            async function fetchBatch(off) {
                const res = await fetch(
                    `/daoanh/api/places/search?q=&cate=${encodeURIComponent(cate)}&limit=${BATCH}&offset=${off}${_bboxParam}`,
                    { signal }
                );
                return res.json();
            }

            try {
                nodeCount.innerText = `Đang tải ${label} ⏳`;
                const first = await fetchBatch(0);
                if (signal.aborted) return;
                if (!first.ok) { nodeCount.innerText = '0 địa danh'; return; }

                const withGps = first.results.filter(r => r.lat && r.lng);
                withGps.forEach(r => addMarkerFromResult(r, cate || null));
                total += withGps.length;
                nodeCount.innerText = `${total} ${label}`;
                addVietnameseLabels();

                if (first.results.length < BATCH) return;

                offset = BATCH;
                while (true) {
                    if (signal.aborted) return;
                    await new Promise(r => setTimeout(r, 50));
                    if (signal.aborted) return;
                    const data = await fetchBatch(offset);
                    if (signal.aborted) return;
                    if (!data.ok || !data.results || data.results.length === 0) break;
                    const gps = data.results.filter(r => r.lat && r.lng);
                    gps.forEach(r => addMarkerFromResult(r, cate || null));
                    total += gps.length;
                    nodeCount.innerText = `${total} ${label} ⏳`;
                    offset += BATCH;
                    if (data.results.length < BATCH) break;
                }
                nodeCount.innerText = `${total} ${label}`;
            } catch (err) {
                if (err.name !== 'AbortError') nodeCount.innerText = 'Lỗi tải dữ liệu';
            }
        }

