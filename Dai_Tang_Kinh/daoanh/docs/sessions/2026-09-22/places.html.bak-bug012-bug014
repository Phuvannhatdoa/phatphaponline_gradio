        function renderVietnameseLabels(places) {
            labelLayer.clearLayers();
            if (!vnLabelsVisible) return;
            const zoom = map.getZoom();
            let filtered;
            if (zoom < 5) filtered = [];
            else if (zoom < 6) filtered = places.filter(p => p.confidence >= 0.95).slice(0, 10);
            else if (zoom < 8) filtered = places.filter(p => p.confidence >= 0.8 || isMajorPlace(p.name_vi)).slice(0, 50);
            else if (zoom < 10) filtered = places.slice(0, 150);
            else filtered = places;
            filtered = [...filtered].sort((a, b) => (b.confidence || 0) - (a.confidence || 0));
            const placed = [];
            filtered.forEach(p => {
                if (!p.lat || !p.lng || !p.name_vi) return;
                const pt = map.latLngToContainerPoint([p.lat, p.lng]);
                const COLLISION_PX = 50;
                const collides = placed.some(pos => {
                    const dx = pos.x - pt.x;
                    const dy = pos.y - pt.y;
                    return Math.sqrt(dx * dx + dy * dy) < COLLISION_PX;
                });
                if (collides) return;
                placed.push({ x: pt.x, y: pt.y });
                const major = isMajorPlace(p.name_vi) || (p.confidence || 0) >= 0.9;
                const el = document.createElement('div');
                el.className = `place-label ${major ? 'place-label-major' : ''}`;
                el.textContent = p.name_vi;
                const icon = L.divIcon({
                    className: '',
