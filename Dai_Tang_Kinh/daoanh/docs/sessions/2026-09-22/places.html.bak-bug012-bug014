            html += '<div style="flex:1;min-width:110px;background:var(--da-card);border:1px solid var(--da-border);border-radius:8px;padding:8px 12px"><div style="font-size:18px;font-weight:700;color:var(--da-gold)">' + (sum.text_count||0) + '</div><div style="font-size:10px;color:var(--da-muted)">TÁC PHẨM</div></div>';
            html += '<div style="flex:1;min-width:110px;background:var(--da-card);border:1px solid var(--da-border);border-radius:8px;padding:8px 12px"><div style="font-size:18px;font-weight:700;color:' + ((ds.has_translations ? 'var(--da-green,#4ade80)' : 'var(--da-muted)')) + '">' + (sum.translation_count||0) + '</div><div style="font-size:10px;color:var(--da-muted)">BẢN DỊCH VIỆT</div></div>';
