            const elOrig = _g('sourceOrigin'); if (elOrig) elOrig.innerText = '· ĐỊA DANH · DILA';
            const elNVi  = _g('itemNameVi'); if (elNVi)  elNVi.innerText  = n.label_vi || n.label || '⌛ Đang tải...';
            const elNHan = _g('itemNameHan'); if (elNHan) elNHan.innerText = n.label_zh || '';
            const elDila = _g('dilaId');   if (elDila)  elDila.innerText  = '—';
            ['chipDila','chipCbeta','chipWikidata','chip84000','chipKanripo','chipSat','chipVri'].forEach(cid => {
                const el = _g(cid); if (el) { el.className = 'da-chip da-chip-none'; el.textContent = '○ ' + cid.replace('chip',''); }
            });
            ['dilaNoteBlock','dilaCategoryBadge','dilaBiblBlock','wikiBlock','personEventsBlock'].forEach(bid => {
                const el = _g(bid); if (el) el.classList.add('hidden');
            });
            fetch(baseUrl + '/daoanh/api/places/' + encodeURIComponent(plid))
                .then(r => { if (!r.ok) throw Object.assign(new Error('HTTP ' + r.status), { httpStatus: r.status }); return r.json(); })
                .then(d => {
                    if (_nexusProfileReqId !== myReqId) return; // stale — newer node already clicked
                    const nameVi = d.name_vi || d.display_name || n.label_vi || n.label || plid;
                    const nameHan = d.name_zh || n.label_zh || '';
                    if (elNVi)  elNVi.innerText  = nameVi;
                    if (elNHan) elNHan.innerText = nameHan;
                    const dilaId = d.dila_id || (plid.startsWith('PL') ? plid : null);
                    if (elDila) elDila.innerText = dilaId || plid;
                    const cd = _g('chipDila');
                    if (cd && dilaId) { cd.className = 'da-chip da-chip-ok'; cd.textContent = '✓ DILA'; }
                })
                .catch(err => {
                    if (_nexusProfileReqId !== myReqId) return;
                    const code = (err && err.httpStatus === 404) ? 'NOT_INDEXED' : 'LOAD_ERROR';
                    if (elNVi)  elNVi.innerText  = n.label_vi || n.label || plid;
                    if (elDila) elDila.innerText = plid + ' · ' + code;
                });
        }

        // ——— BUG-010: central dispatcher — routes any node to the correct profile loader ———
        // ID priority follows click_routing_rules from BUG-010 spec.
        // Never parses/infers IDs from display labels.
        function openEntityProfileFromNode(node) {
            if (!node) return;
            const group = node.group;
            if (group === 'person') {
                const pid = node.dila_person_id
                    || (node.canonical_id && /^A\d{6}$/.test(String(node.canonical_id)) ? node.canonical_id : null)
                    || node.person_id || node.authority_id
                    || (node.external_ids && node.external_ids.DILA ? node.external_ids.DILA : null)
                    || (/^A\d{6}$/.test(String(node.id || '')) ? node.id : null)
                    || node.source_id || node.id;
                const myReqId = ++_nexusProfileReqId;
                _nexusLoadPersonProfile({ ...node, id: pid, _reqId: myReqId });
            } else if (group === 'place') {
                const plid = node.dila_place_id
                    || (node.canonical_id && /^PL\d+$/.test(String(node.canonical_id)) ? node.canonical_id : null)
                    || node.place_id
                    || (node.external_ids && node.external_ids.DILA ? node.external_ids.DILA : null)
                    || (/^PL\d+$/.test(String(node.id || '')) ? node.id : null)
                    || node.source_id || node.id;
                _nexusLoadPlaceProfile({ ...node, id: plid });
            } else {
                // Unknown/text/time: show metadata, mark no canonical profile
                const _g = id => document.getElementById(id);
                const emptyState = _g('emptyState'), detContent = _g('detailContent');
                if (emptyState) emptyState.classList.add('hidden');
                if (detContent) detContent.classList.remove('hidden');
                const elId = _g('itemId');     if (elId)    elId.innerText    = String(node.id || '');
                const elOrig = _g('sourceOrigin'); if (elOrig) elOrig.innerText = '· ' + (group || 'THỰC THỂ').toUpperCase();
                const elNVi  = _g('itemNameVi'); if (elNVi)  elNVi.innerText  = node.label_vi || node.label || String(node.id || '');
                const elNHan = _g('itemNameHan'); if (elNHan) elNHan.innerText = node.label_zh || '';
                const elDila = _g('dilaId');   if (elDila)  elDila.innerText  = 'Chưa có canonical profile ID';
                ['dilaNoteBlock','dilaCategoryBadge','dilaBiblBlock','wikiBlock','personEventsBlock'].forEach(bid => {
                    const el = _g(bid); if (el) el.classList.add('hidden');
                });
            }
        }

        // ——— Phase 1: Nexus detail panel (click navigable node) ———
        function _nexusShowDetail(n, d) {
