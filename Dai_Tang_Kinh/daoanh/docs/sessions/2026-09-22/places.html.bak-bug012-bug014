        async function reportPlaceTranslation(dilaId, tid) {
            const note = prompt('Mô tả lỗi bản dịch (tùy chọn):') || '';
            try {
                const r = await fetch(`/daoanh/api/place/${dilaId}/translate/report`, {
                    method:'POST', headers:{'Content-Type':'application/json'},
                    body: JSON.stringify({translation_id: parseInt(tid), note})
