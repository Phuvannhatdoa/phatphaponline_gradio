                            +'<div class="dt-seg-text dt-seg-han">'+_escHtml(u.han)+'</div>'
                            +'</article>';
                    }).join('');
                } else {
                    var segs = dtBuildSegments(p);
                    if (segs.length) {
                        hb.innerHTML = segs.map(function(seg) {
                            var n = ('00'+seg.order).slice(-2);
