        // MAP_SEMANTIC_MARKER_ICONS_001: trả về {svgHtml, size, half} theo icon type
        function getPlaceIconSvg(cate, isSelected) {
            const color = CATE_DOT_COLORS[cate] || CATE_DOT_COLORS.unknown;
            const size = isSelected ? 32 : 22;
            let inner = '';
            switch (cate) {
                case 'temple_site':
