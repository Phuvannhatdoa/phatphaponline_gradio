        // T101 BUG-005: expand map + tách multi-value dynasty ('北宋\n五代十國', '印度'…)
        const _DYNASTY_VI = {
            '唐':'Đường','宋':'Tống','北宋':'Bắc Tống','南宋':'Nam Tống',
            '明':'Minh','隋':'Tuỳ','清':'Thanh','民國':'Dân Quốc',
            '五代':'Ngũ Đại','五代十國':'Ngũ Đại Thập Quốc','宋元':'Tống-Nguyên',
