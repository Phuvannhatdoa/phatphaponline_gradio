        // T16/T17 realization — vis-network renderer shared by both graph tabs.
        //   Đồ Thị (place)     -> /daoanh/api/places/<id>/graph  (related texts + nearby places)
        //   Truyền Thừa (person) -> /daoanh/api/monk/<id>/graph  (Marcus SNA teacher/student lineage)
        // Every node/edge traces to a real authority source (DILA listbibl->cbeta_catalog_vn
        // JOIN, or Marcus marcus_networks with a real CBETA citation ref) — no fuzzy/regex guessing.
        function _renderVisGraph(canvas, center, rawNodes, rawEdges, onNodeClick) {
            const groupColor = { place: '#3a9e6e', text: '#0b7a96', person: '#c4891a', event: '#8b5cf6', time: '#d97706' };
            const visNodes = [{
                id: center.id, label: _nexusSafeLabel(center),
                shape: 'ellipse', color: { background: 'var(--da-gold, #ad7c1c)', border: '#8a5c08' },
                font: { color: '#1a1a28', size: 14, face: 'serif' }, borderWidth: 2
            }];
            rawNodes.forEach(n => {
                visNodes.push({
                    id: n.id, label: _nexusSafeLabel(n),
                    shape: n.group === 'text' ? 'box' : 'dot',
                    color: groupColor[n.group] || '#6a5f4d',
                    font: { color: getComputedStyle(document.body).getPropertyValue('--da-text') || '#dce5f4', size: 11 },
                    size: 14
                });
            });
            const rawEdgesFiltered = rawEdges.filter(e => {
                const et = e.evidence_type;
                if (!_nexusResearchMode && (et === 'co_mention' || et === 'unverified')) return false;
                return true;
            });
            const visEdges = rawEdgesFiltered.map((e, i) => {
                // Đồng môn (derived) — suy ra từ Marcus isTeacherOf (cùng thầy), KHÔNG phải
                // dữ liệu gốc. Hiển thị khác màu + tooltip giải thích để không nhầm với thầy/trò.
                const derived = !!e.derived;
                // T101: evidence_type từ backend (với_evidence|partial|co_mention|unverified)
                const et = e.evidence_type || (derived ? 'co_mention' : (e.ref || e.citation ? 'with_evidence' : 'co_mention'));
                // T92-P3: Xác định nguồn evidence (DILA/CBETA/FOSIZHI) từ ref/citation
                const evSrc = _nexusEvidenceSource(e);
                const evLabel = evSrc ? (' [' + evSrc + ']') : '';
                const edgeHasEvidence = (et === 'with_evidence' || et === 'partial');
                const coMention = (et === 'co_mention');
                const isPartial = (et === 'partial');
                const partialBadge = isPartial ? '⚑ ' : '';
                const edgeTitle = derived
                    ? ('⬒ Đồng môn (suy ra từ Marcus isTeacherOf): cùng thầy "' + (e.shared_teacher_label || '') + '". Không phải quan hệ ghi trong nguồn.')
                    : (isPartial ? ('⚑ PARTIAL — ' + (e.partial_reason || 'Thiếu thông tin provenance') + (e.ref ? ('\nNguồn: ' + evLabel + '\n' + e.ref) : ''))
                        : (e.ref ? ('Nguồn: ' + evLabel + '\n' + e.ref + (e.citation ? '\nCBETA: ' + e.citation : ''))
                            : (coMention ? 'Co-mention: đồng xuất hiện trong passage CBETA, chưa có ref trực tiếp (co-mention ≠ relation).' : undefined)));
                const baseLabel = derived ? (e.label || 'đồng môn') + ' (suy ra)' : (e.label || '');
                return {
                    id: i, from: e.from, to: e.to,
                    label: partialBadge + baseLabel,
                    arrows: 'to',
                    font: { size: 9, color: derived ? '#3a7ca6' : (edgeHasEvidence ? '#e0d5b8' : (coMention ? '#6a5f4d' : '#6a5f4d')), strokeWidth: 0 },
                    color: { color: derived ? '#3a7ca655' : (edgeHasEvidence ? '#8a5c08cc' : (coMention ? '#8a5c0833' : '#8a5c0866')), highlight: derived ? '#3a7ca6' : '#ad7c1c' },
                    dashes: (derived ? [6, 4] : (coMention ? [2, 4] : false)),
                    title: edgeTitle
                };
            });
            const network = new vis.Network(canvas, { nodes: visNodes, edges: visEdges }, {
                layout: { improvedLayout: true },
                physics: { stabilization: true, barnesHut: { gravitationalConstant: -4000, springLength: 110 } },
                interaction: { hover: true, tooltipDelay: 150 },
                nodes: { borderWidth: 1 },
                edges: { smooth: { type: 'continuous' } }
            });
            const nodeMap = {};
            rawNodes.forEach(n => nodeMap[n.id] = n);
            network.on('click', params => {
                if (!params.nodes.length) return;
                const nid = params.nodes[0];
                if (nid === center.id) return; // center = current entity, no-op
                const n = nodeMap[nid];
                if (n && n.navigable) onNodeClick(n);
            });
            network.on('doubleClick', params => {
                if (!params.nodes.length) return;
                const nid = params.nodes[0];
                if (nid === center.id) return;
                const n = nodeMap[nid];
                if (n && n.navigable && (n.group === 'person' || n.group === 'place')) _nexusSetRoot(n);
            });
            return network;
        }

        // ── ĐỒ THỊ tab (T-graph rewrite) ─────────────────────────────
        // Deduplication + filter chips + cluster + relationship list.
        // Alias chỉ hiện trong sidebar (graph-altnames), KHÔNG trong overlay.
        let _graphNetwork = null;
        let _graphData   = null;   // dữ liệu API hiện tại
        let _graphDataset = null;  // { nodes: vis.DataSet, edges: vis.DataSet } cho expand-on-click
        let _graphFilters = { text: true, person: true, place: true, alias: false, pending: false };
        let _graphExpanded = {};   // group key → bool (expanded cluster)
        let _graphCoMentionVisible = false; // toggle "Cùng xuất hiện"
        let _positionCache = {};   // stable x,y snapshot saved after initial layout
        const CLUSTER_THRESHOLD = 5; // nhóm > N node thì cluster

        function renderGraphTab(d) {
