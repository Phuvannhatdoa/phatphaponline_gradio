            const cycleEdges = _lineageSccEdges();
            const cycleSet = new Set(cycleEdges.map(e => e.from + '|' + e.to));
            const keep = pid => reachable.has(pid) && (st._netExpand.all ||
                gen[pid] < 0 || gen[pid] <= st._netExpand.below);
            const nT = {}, nS = {};
            (st.edges || []).forEach(e => { nS[e.from] = (nS[e.from] || 0) + 1; nT[e.to] = (nT[e.to] || 0) + 1; });
