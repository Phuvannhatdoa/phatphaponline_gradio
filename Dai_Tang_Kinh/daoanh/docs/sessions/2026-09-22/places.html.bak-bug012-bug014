            // ── Sidebar: Tên Thay Thế với toggle ──
            const rawAliases = d.alt_names || [];
            // Dedup by normalized text
            // FIX 1: alt_names may be [{zh, vi}] objects or plain strings (backward compat)
            const _normalizeAlias = a => typeof a === 'object' ? a : { zh: String(a || ''), vi: null };
            const seenAlias = new Set();
            const aliases = rawAliases.map(_normalizeAlias).filter(a => {
                const k = (a.zh || '').trim().normalize('NFC');
                if (!k || seenAlias.has(k)) return false;
                seenAlias.add(k); return true;
            });
            if (altBox) {
                if (aliases.length) {
                    altBox.style.display = 'block';
                    altBox.innerHTML =
                        '<div class="da-block-label" style="margin-bottom:6px">Tên Thay Thế (' + aliases.length + ')</div>' +
                        '<div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px">' +
                        aliases.map(a => {
                            const label = _fmtName(a.vi, a.zh) || a.zh;
                            return '<span style="font-family:var(--da-font-serif);font-size:12px;background:var(--da-panel);border:1px solid var(--da-border);border-radius:6px;padding:2px 9px;color:var(--da-text)" title="' + _escHtml(a.zh) + '">' + _escHtml(label) + '</span>';
                        }).join('') +
                        '</div>' +
                        '<label style="font-size:11px;color:var(--da-muted);cursor:pointer;user-select:none;display:flex;align-items:center;gap:6px">' +
                        '<input type="checkbox" id="gmp-alias-toggle" ' + (_graphFilters.alias ? 'checked' : '') + ' onchange="_gmpAliasToggle(this.checked)" style="accent-color:var(--da-gold)">' +
                        'Hiển thị trong đồ thị</label>';
                } else {
                    altBox.style.display = 'none';
                }
            }

            // ── Sidebar: stats ──
            const statsEl = document.getElementById('graph-stats');
            if (statsEl) {
                const rawNodes = d.nodes || [];
                const tc = rawNodes.filter(n => n.group === 'text').length;
                const pc = rawNodes.filter(n => n.group === 'place').length;
                const mn = rawNodes.filter(n => n.group === 'person').length;
                const parts = [];
                if (tc) parts.push('<strong>' + tc + '</strong> kinh điển');
                if (mn) parts.push('<strong>' + mn + '</strong> tăng nhân');
                if (pc) parts.push('<strong>' + pc + '</strong> địa danh');
                statsEl.innerHTML = parts.length
                    ? '<span style="color:var(--da-text)">Quan hệ: </span>' + parts.join(' · ')
                    : '<span style="color:var(--da-muted);font-style:italic">Chưa có dữ liệu đồ thị</span>';
            }

            _renderGraphMainPanel(d);
        }

        // ── Helper: normalize + build vis datasets from current data + filters ──
        function _gmpBuildDatasets(d, filters, expanded) {
            const centerId = d.center.id;
            const rawAliases = d.alt_names || [];
            // FIX 1: normalize alias objects {zh, vi} or plain strings
            const _normA = a => typeof a === 'object' ? a : { zh: String(a || ''), vi: null };
            const seenAlias = new Set();
            const aliases = rawAliases.map(_normA).filter(a => {
                const k = (a.zh || '').trim().normalize('NFC');
                if (!k || seenAlias.has(k)) return false; seenAlias.add(k); return true;
            });

            // Dedup raw nodes by id
            const seenIds = new Set([centerId]);
            const rawNodes = (d.nodes || []).filter(n => {
                if (!n.id || seenIds.has(n.id)) return false; seenIds.add(n.id); return true;
            });
            // Dedup edges by source+target+type; optionally filter to evidence-only (FIX 3)
            const seenEdges = new Set();
            const rawEdges = (d.edges || []).filter(e => {
                const k = e.from + '|' + e.to + '|' + (e.label || '');
                if (seenEdges.has(k)) return false; seenEdges.add(k); return true;
            }).filter(e => !_graphEvidenceOnly || e.ref || e.has_ref);

            const _isDark = document.documentElement.getAttribute('data-theme') === 'dark' ||
                (document.documentElement.getAttribute('data-theme') !== 'light' &&
                 window.matchMedia('(prefers-color-scheme: dark)').matches);
            const textCol = _isDark ? '#dce5f4' : '#1a1a28';
            const _biLabel = (vi, zh, fb) => {
                // FIX 1: Việt/Hán-Việt trước, Hán sau — dùng _fmtName
                const label = _fmtName(vi, zh);
                return label || fb || '';
            };

            // Center node label: prefer label_vi (pure Vi) + label_zh for _fmtName bilingual
            const centerLabel = _biLabel(d.center.label_vi, d.center.label_zh, centerId);
            const visNodes = [{ id: centerId, label: centerLabel,
                shape: 'star', size: 20,
                color: { background: '#ad7c1c', border: '#8a5c08' },
                font: { color: _isDark ? '#fef3c7' : '#1a1a28', size: 13, face: 'serif', bold: true },
                borderWidth: 2, level: 0,
                title: 'Thực thể trung tâm: ' + (d.center.label || centerId) }];
            const visEdges = [];
            const nodeIndex = {}; // id → raw node

            // Group nodes by group
            const byGroup = { text: [], person: [], place: [] };
            rawNodes.forEach(n => {
                const g = n.group || 'other';
                if (byGroup[g]) byGroup[g].push(n);
            });

            // Update filter chip counts
            const _setChipCount = (id, count, group) => {
                const el = document.getElementById(id);
                if (!el) return;
                const gmap = { text: 'Kinh điển', person: 'Tăng nhân', place: 'Địa danh', alias: 'Tên thay thế' };
                el.textContent = (gmap[group] || group) + ' (' + count + ')';
            };
            _setChipCount('gf-text',   byGroup.text.length,   'text');
            _setChipCount('gf-person', byGroup.person.length,  'person');
            _setChipCount('gf-place',  byGroup.place.length,   'place');
            _setChipCount('gf-alias',  aliases.length,         'alias');

            const NODE_CFG = {
                text:   { shape: 'box',     color: '#0b7a96', size: 14, level: 1 },
                person: { shape: 'dot',     color: '#c4891a', size: 10, level: 2 },
                place:  { shape: 'diamond', color: '#3a9e6e', size: 12, level: 1 },
                alias:  { shape: 'ellipse', color: '#6a5f8d', size: 8,  level: 1 }
            };

            // Text hub → person column assignment
            const textHubIds = byGroup.text.map(n => n.id);
            const hubLevelMap = {};
            textHubIds.forEach((hid, i) => { hubLevelMap[hid] = 2 + i; });
            const personHubLevel = {};
            rawEdges.forEach(e => { if (hubLevelMap[e.from] !== undefined) personHubLevel[e.to] = hubLevelMap[e.from]; });
            const maxPersonLevel = textHubIds.length > 0 ? 1 + textHubIds.length : 2;

            // Add nodes by group, respecting filters + cluster threshold
            ['text', 'person', 'place'].forEach(g => {
                if (!filters[g]) return;
                const cfg = NODE_CFG[g];
                const members = byGroup[g];
                const expKey = g;
                const isExpanded = !!expanded[expKey];
                if (members.length > CLUSTER_THRESHOLD && !isExpanded) {
                    // Render as a single cluster gateway node
                    const clusterId = '__cluster__' + g;
                    const groupLabel = { text: 'Kinh điển', person: 'Tăng nhân', place: 'Địa danh' }[g] || g;
                    visNodes.push({ id: clusterId,
                        label: '[' + members.length + ' ' + groupLabel + ']',
                        shape: cfg.shape, size: cfg.size + 6,
                        color: { background: cfg.color + '44', border: cfg.color },
                        font: { color: textCol, size: 11, bold: true },
                        borderWidth: 2, level: cfg.level,
                        title: 'Click "Mở rộng" để xem ' + members.length + ' ' + groupLabel,
                        isCluster: true, clusterGroup: g });
                    visEdges.push({ from: centerId, to: clusterId,
                        label: groupLabel, arrows: 'to',
                        font: { size: 9, color: '#6a5f4d', strokeWidth: 0 },
                        color: { color: cfg.color + '66', highlight: cfg.color } });
                } else {
                    members.forEach(n => {
                        const lvl = g === 'text' ? 1 : (g === 'person' ? (personHubLevel[n.id] || maxPersonLevel) : 1);
                        nodeIndex[n.id] = n;
                        visNodes.push({ id: n.id,
                            label: _biLabel(n.label, n.label_zh, n.id),
                            shape: cfg.shape, color: cfg.color,
                            font: { color: textCol, size: 11 },
                            size: cfg.size, level: lvl,
                            title: (n.label || n.label_zh || '') + (n.title ? '\n' + n.title : '') });
                    });
                }
            });

            // Alias nodes (only when filter enabled) — FIX 1: use _fmtName for label
            if (filters.alias && aliases.length) {
                aliases.forEach((a, i) => {
                    const aid = '__alias__' + i;
                    const aliasLabel = _fmtName(a.vi, a.zh) || a.zh;
                    visNodes.push({ id: aid, label: aliasLabel,
                        shape: 'ellipse',
                        color: { background: 'var(--da-panel,#1a1a30)', border: '#6a5f8d' },
                        font: { color: '#9d94b8', size: 10, face: 'serif' },
                        size: 8, level: 1,
                        title: 'Tên thay thế: ' + _fmtName(a.vi, a.zh) + (a.zh ? ' [' + a.zh + ']' : ''),
                        isAlias: true });
                    visEdges.push({ from: centerId, to: aid,
                        label: 'alias_of', dashes: [3, 6],
                        arrows: 'to',
                        font: { size: 8, color: '#6a5f8d', strokeWidth: 0 },
                        color: { color: '#6a5f8d55', highlight: '#9d94b8' } });
                });
            }

            // Real edges (only between visible nodes)
            const visIds = new Set(visNodes.map(n => n.id));
            rawEdges.forEach((e, i) => {
                if (!visIds.has(e.from) && e.from !== centerId) return;
                if (!visIds.has(e.to)) return;
                const fromId = visIds.has(e.from) ? e.from : centerId;
                visEdges.push({ id: 'e' + i, from: fromId, to: e.to,
                    label: e.label || '', arrows: 'to',
                    font: { size: 9, color: '#6a5f4d', strokeWidth: 0 },
                    color: { color: '#8a5c0866', highlight: '#ad7c1c' } });
            });

            return { visNodes, visEdges, nodeIndex, aliases };
        }


        async function _gmpShowNodeDetail(n, center) {
            const panel = document.getElementById('gmp-detail');
            const body  = document.getElementById('gmp-detail-body');
