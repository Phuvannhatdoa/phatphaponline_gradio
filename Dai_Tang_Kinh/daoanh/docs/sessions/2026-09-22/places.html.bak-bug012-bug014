                                +'<span class="dt-seg-num">'+n+'</span>'
                                +'<div class="dt-seg-text dt-seg-han">'+_escHtml(seg.source_text)+'</div>'
                                +'</article>';
                        }).join('');
                    } else {
                        hb.innerHTML = '<div style="padding:20px;color:var(--da-muted)">Không có nội dung Hán văn.</div>';
