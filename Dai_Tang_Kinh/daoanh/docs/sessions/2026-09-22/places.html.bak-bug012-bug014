                    var prov = '<div class="dt-auto-align-note" title="Bản dịch là toàn văn của passage gốc, dịch trọn 1 khối. Số đoạn bên Hán chỉ để đọc, không dùng để đối chiếu câu-câu.">'
                        + '📌 Bản dịch TOÀN PHẦN passage <code>' + _escHtml(cit) + '</code> · passage_id <code>' + _escHtml(String(p.passage_id)) + '</code> — không chia theo số đoạn Hán</div>';
                    if (p.text_id && p.passage_id) prov += '<div class="dt-actions" style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap"><button onclick="openDaiTangReader(' + idx + ')" style="font-size:11px;color:var(--da-muted);background:none;border:1px solid var(--da-border);border-radius:5px;padding:4px 12px;cursor:pointer">📖 Đọc đầy đủ</button>'
                        + (isDraft ? '<button onclick="daiTangRetranslate(' + idx + ')" style="font-size:11px;color:var(--da-muted);background:none;border:1px solid var(--da-border);border-radius:5px;padding:4px 12px;cursor:pointer">🔄 Dịch lại</button>' : '')
                        + '<button onclick="dtReloadUnits(' + idx + ')" style="font-size:11px;color:var(--da-gold);background:none;border:1px solid var(--da-gold);border-radius:5px;padding:4px 12px;cursor:pointer">🤖 Load bản dịch theo đoạn</button></div>';
                    vb.innerHTML = badge + prov + dtFullBlockVi(p);
                } else {
                    vb.innerHTML = '<div class="dt-no-trans">'
                        +'<div class="dt-no-trans-msg">Chưa có bản dịch tiếng Việt.</div>'
                        +'<button id="daitang-dich-btn-'+idx+'" onclick="dtTranslatePassage('+idx+')" class="dt-translate-btn">🤖 Dịch (AI)</button>'
                        +'</div>';
                }
            }
        }

        function badgeLarge(isDraft) {
