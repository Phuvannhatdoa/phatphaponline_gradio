<style>
        :root { --pp-dark-bg: #0a0c10; --pp-card-bg: rgba(22,28,38,0.8); --pp-text: #e2e8f0; --pp-nav-bg: #020617; --pp-nav-border: rgba(255,255,255,0.05); }
        :root[data-theme="light"] { --pp-dark-bg: #f0ebe0; --pp-card-bg: rgba(230,224,213,0.92); --pp-text: #1a1a28; --pp-nav-bg: #f8f5ef; --pp-nav-border: rgba(0,0,0,0.1); }
        body { background-color: var(--pp-dark-bg); color: var(--pp-text); }
        #map { width: 100%; flex: 1; min-height: 0; }
        .pp-sidebar { background: linear-gradient(180deg, #0f172a 0%, #020617 100%); transition: width 0.2s ease; }
        :root[data-theme="light"] .pp-sidebar { background: linear-gradient(180deg, #e6e0d5 0%, #f0ebe0 100%); }
        .pp-sidebar.sidebar-collapsed { width: 0 !important; min-width: 0; overflow: hidden; }
        .pp-card { background: var(--pp-card-bg); border-radius: 20px; }
        /* Nav theme override — Tailwind bg-[#020617] is hardcoded, use CSS var via attribute */
        nav[data-nav] { background: var(--pp-nav-bg) !important; border-bottom-color: var(--pp-nav-border) !important; }
        :root[data-theme="light"] #searchInput { color: #1a1a28 !important; background: rgba(0,0,0,0.07) !important; border-color: rgba(0,0,0,0.18) !important; }
        :root[data-theme="light"] #searchInput::placeholder { color: #64748b !important; }
        /* Theme toggle button */
        #themeBtn { width:36px;height:36px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:none;background:transparent;cursor:pointer;color:rgba(148,163,184,0.8);transition:color .2s,background .2s; }
        #themeBtn:hover { color:#f59e0b;background:rgba(255,255,255,0.08); }
        :root[data-theme="light"] #themeBtn { color:rgba(100,80,40,0.8); }
        :root[data-theme="light"] #themeBtn:hover { color:#8a5c08;background:rgba(0,0,0,0.06); }
        /* MAP_SEMANTIC_MARKER_ICONS_001 */
        .place-marker-icon { display:flex;align-items:center;justify-content:center;line-height:0;cursor:pointer; }
        .place-marker-icon.halo-active { filter: drop-shadow(0 0 6px white) drop-shadow(0 0 2px white); transform: scale(1.35); transition: transform .15s, filter .15s; }
    </style>
<style>
/* ── DT: Đại Tạng 5-tab main panel (spec v2.0) ─────────────── */
.dt-inner-tabs{display:flex;align-items:center;background:var(--da-panel);border-bottom:1px solid var(--da-border);padding:0 16px;height:40px;flex-shrink:0;overflow-x:auto;scrollbar-width:none}
.dt-inner-tabs::-webkit-scrollbar{display:none}
.dt-itab{display:flex;align-items:center;gap:6px;padding:0 13px;height:100%;font-size:11px;font-weight:500;color:var(--da-muted);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;transition:color .15s,border-color .15s;flex-shrink:0}
.dt-itab:hover{color:var(--da-text)}
.dt-itab.active{color:var(--da-gold);border-bottom-color:var(--da-gold);font-weight:600}
.dt-itab .dtc{font-size:9px;background:var(--da-gold-bg);color:var(--da-gold);border-radius:9px;padding:1px 6px;font-family:var(--da-font-mono);font-weight:600}
.dt-tabcontent{flex:1;overflow:hidden;display:none;flex-direction:column}
.dt-tabcontent.active{display:flex}
.dt-filter-bar{display:flex;align-items:center;gap:6px;padding:8px 16px;background:var(--da-panel);border-bottom:1px solid var(--da-border);flex-shrink:0}
.dt-fchip{font-size:10px;font-weight:600;padding:3px 10px;border-radius:12px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;font-family:var(--da-font-ui);letter-spacing:.02em;transition:all .12s}
.dt-fchip:hover{color:var(--da-text);border-color:var(--da-muted)}
.dt-fchip.active{color:var(--da-gold);border-color:var(--da-gold);background:var(--da-gold-bg)}
.dt-ref-list{flex:1;overflow-y:auto;padding:10px 16px;scrollbar-width:thin;scrollbar-color:var(--da-border) transparent}
.dt-ref-list::-webkit-scrollbar{width:4px}
.dt-ref-list::-webkit-scrollbar-thumb{background:var(--da-border)}
.dt-ref-item{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:start;padding:9px 12px;background:var(--da-card);border:1px solid var(--da-border);border-radius:7px;margin-bottom:5px;cursor:default;transition:border-color .12s}
.dt-ref-item:hover{border-color:var(--da-gold)}
.dt-rbadge{font-size:8px;font-weight:700;letter-spacing:.06em;padding:2px 7px;border-radius:4px;white-space:nowrap;margin-top:1px;text-transform:uppercase}
.dt-rb-cbeta{background:rgba(196,137,26,.12);color:var(--da-gold);border:1px solid var(--da-gold-ring)}
.dt-rb-fosizhi{background:rgba(34,211,238,.1);color:var(--da-cyan);border:1px solid rgba(34,211,238,.25)}
.dt-ref-code{font-family:var(--da-font-mono);font-size:10px;font-weight:600;color:var(--da-cyan);letter-spacing:.03em;margin-bottom:3px}
.dt-ref-snip{font-family:var(--da-font-serif);font-size:11px;color:var(--da-muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}
.dt-ref-acts{display:flex;gap:4px;flex-shrink:0;flex-direction:column;align-items:flex-end}
.dt-rbtn{font-size:10px;padding:3px 9px;border-radius:4px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;white-space:nowrap;font-family:var(--da-font-ui);transition:color .12s,border-color .12s;text-decoration:none;display:inline-block}
.dt-rbtn:hover{color:var(--da-gold);border-color:var(--da-gold)}
.dt-rbtn.prim{color:var(--da-gold);border-color:var(--da-gold-ring);background:var(--da-gold-bg)}
.dt-cite-strip{background:var(--da-panel);border-top:1px solid var(--da-border);padding:6px 16px;display:flex;align-items:center;gap:8px;flex-shrink:0}
.dt-cite-btn{font-size:10px;padding:3px 10px;border-radius:4px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;font-family:var(--da-font-ui);transition:color .12s,border-color .12s}
.dt-cite-btn:hover{color:var(--da-cyan);border-color:var(--da-cyan)}
.dt-passage-chips{padding:10px 16px;background:var(--da-panel);border-bottom:1px solid var(--da-border);flex-shrink:0}
.dt-src-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;width:100%}
.dt-pchip{font-size:11px;font-family:var(--da-font-mono);padding:8px 10px;border-radius:8px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;transition:all .12s;min-height:44px;display:flex;align-items:center;justify-content:center;gap:5px;text-align:center;width:100%;line-height:1.3}
.dt-pchip:hover:not(.active){border-color:var(--da-gold);color:var(--da-text,#e2e8f0)}
.dt-pchip:focus-visible{outline:3px solid var(--da-gold);outline-offset:2px}
.dt-pchip.active{background:var(--da-gold-bg);color:var(--da-gold);border-color:var(--da-gold);font-weight:700;box-shadow:0 0 0 2px rgba(173,124,28,.2)}
.dt-pchip__work{font-size:9px;opacity:.65;flex-shrink:0}
.dt-pchip__page{font-size:12px;font-weight:600}
.dt-pchip__sep{opacity:.3;font-size:10px}
.dt-pchip__vi{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--da-gold);flex-shrink:0;margin-left:2px}
.dt-src-groups{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.dt-src-grp-btn{font-size:10px;padding:4px 12px;border-radius:10px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;font-family:var(--da-font-ui);transition:all .12s}
.dt-src-grp-btn.active{color:var(--da-gold);border-color:var(--da-gold);background:var(--da-gold-bg)}
@media(max-width:639px){.dt-src-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.dt-pchip{min-height:48px}}
@media(max-width:359px){.dt-src-grid{grid-template-columns:1fr}}
.dt-split{flex:1;display:flex;overflow:hidden}
.dt-pane{display:flex;flex-direction:column;overflow:hidden;min-width:80px}
.dt-resizer{width:6px;flex-shrink:0;background:var(--da-border);cursor:col-resize;transition:background .15s;position:relative;z-index:1}
.dt-resizer:hover,.dt-resizer.dragging{background:var(--da-gold)}
.dt-resizer::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:2px;height:32px;border-radius:2px;background:rgba(255,255,255,.18)}
.dt-pane-hd{display:flex;align-items:center;justify-content:space-between;padding:7px 14px;background:var(--da-panel);border-bottom:1px solid var(--da-border);flex-shrink:0;gap:8px}
.dt-pane-body{flex:1;overflow-y:auto;padding:14px;scrollbar-width:thin;scrollbar-color:var(--da-border) transparent}
.dt-pane-body::-webkit-scrollbar{width:4px}
.dt-pane-body::-webkit-scrollbar-thumb{background:var(--da-border)}
.dt-lang-zh{font-size:9px;padding:1px 6px;border-radius:3px;font-weight:700;background:rgba(196,137,26,.12);color:var(--da-gold);border:1px solid var(--da-gold-ring)}
.dt-lang-vi{font-size:9px;padding:1px 6px;border-radius:3px;font-weight:700;background:rgba(52,211,153,.1);color:var(--da-green);border:1px solid rgba(52,211,153,.25)}
.dt-graph-wrap{flex:1;display:flex;overflow:hidden}
#dt-graph-canvas{flex:1;display:block}
.dt-graph-legend{width:165px;border-left:1px solid var(--da-border);background:var(--da-panel);padding:14px 12px;overflow-y:auto;flex-shrink:0}
.dt-ai-bar{display:flex;gap:8px;align-items:center;padding:11px 16px;background:var(--da-panel);border-bottom:1px solid var(--da-border);flex-shrink:0}
.dt-ai-input{flex:1;background:var(--da-card);border:1px solid var(--da-border);border-radius:7px;padding:8px 12px;font-size:12px;font-family:var(--da-font-ui);color:var(--da-text);outline:none;transition:border-color .15s}
.dt-ai-input:focus{border-color:var(--da-gold)}
.dt-ai-input::placeholder{color:var(--da-muted)}
.dt-ai-btn{background:var(--da-gold-bg);border:1px solid var(--da-gold-ring);color:var(--da-gold);font-size:11px;font-weight:600;font-family:var(--da-font-ui);padding:8px 16px;border-radius:7px;cursor:pointer;white-space:nowrap}
.dt-ai-btn:hover{background:var(--da-gold-ring)}
.dt-ai-result{flex:1;overflow-y:auto;padding:14px 16px;scrollbar-width:thin;scrollbar-color:var(--da-border) transparent}
.dt-ai-result::-webkit-scrollbar{width:4px}
.dt-ds-item{padding:10px 13px;background:var(--da-card);border:1px solid var(--da-border);border-radius:7px;margin-bottom:6px;cursor:pointer;transition:border-color .12s}
.dt-ds-item:hover{border-color:var(--da-gold)}
.dt-score-bar{flex:1;height:3px;background:var(--da-border);border-radius:2px;overflow:hidden;min-width:60px}
.dt-score-fill{height:100%;background:var(--da-gold);border-radius:2px;transition:width .5s}
.dt-ds-head{padding:10px 16px 2px;background:var(--da-panel)}
.dt-ds-title{font-size:12px;font-weight:700;color:var(--da-text)}
.dt-ds-sub{font-size:11px;line-height:1.6;color:var(--da-muted);margin-top:3px}
.dt-ds-hint{display:flex;align-items:baseline;gap:4px;padding:6px 16px;background:var(--da-panel);font-size:11px;color:var(--da-muted);flex-wrap:wrap}
.dt-ds-sug{background:none;border:none;padding:0;margin:0;color:var(--da-gold);font-size:11px;font-family:var(--da-font-ui);cursor:pointer;text-align:left;text-decoration:underline;text-decoration-color:rgba(217,119,6,.35);text-underline-offset:2px}
.dt-ds-sug:hover{color:var(--da-gold);filter:brightness(1.15)}
.dt-ds-sug:focus-visible{outline:2px solid var(--da-gold);outline-offset:2px;border-radius:3px}
.dt-ds-validation{padding:4px 16px 6px;font-size:11px;color:#f87171;background:var(--da-panel)}
.dt-ds-state{padding:26px 0;text-align:center;color:var(--da-muted)}
.dt-ds-state .dt-ds-state-ico{font-size:26px;margin-bottom:9px}
.dt-ds-state .dt-ds-state-t{font-size:12px;font-weight:600;color:var(--da-text)}
.dt-ds-state .dt-ds-state-s{font-size:11px;margin-top:6px;color:var(--da-muted);line-height:1.6}
.dt-qa-ans{background:var(--da-card);border:1px solid var(--da-border);border-radius:7px;padding:14px 16px;margin-bottom:14px;font-size:13px;line-height:1.8;color:var(--da-text)}
.dt-qa-cite{display:flex;align-items:baseline;gap:8px;padding:7px 12px;background:var(--da-card);border:1px solid var(--da-border);border-radius:4px;margin-bottom:4px;cursor:pointer;transition:border-color .12s}
.dt-qa-cite:hover{border-color:var(--da-gold)}
@keyframes dt-spin{to{transform:rotate(360deg)}}
.dt-spinner{display:inline-block;width:12px;height:12px;border:2px solid var(--da-border);border-top-color:var(--da-gold);border-radius:50%;animation:dt-spin .6s linear infinite;vertical-align:middle;margin-right:5px}
.dt-rel-item{display:grid;grid-template-columns:32px 1fr auto;align-items:center;gap:10px;padding:8px 10px;background:var(--da-card);border:1px solid var(--da-border);border-radius:7px;margin-bottom:6px;transition:border-color .12s}
.dt-rel-item:hover{border-color:var(--da-gold-ring)}
.dt-rel-icon{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.dt-rel-zh{font-family:var(--da-font-serif);font-size:13px;font-weight:600;color:var(--da-text);line-height:1.3}
.dt-rel-vi{font-size:10px;color:var(--da-muted);margin-top:1px}
.dt-rel-rel{font-size:9px;color:var(--da-dim);margin-top:2px;font-style:italic}
.dt-rel-meta{display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0}
.dt-rel-badge{font-size:8px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;text-transform:uppercase;letter-spacing:.04em}
.dt-rel-badge.curated{background:rgba(52,211,153,.1);color:var(--da-green);border:1px solid rgba(52,211,153,.25)}
.dt-rel-badge.canon{background:var(--da-gold-bg);color:var(--da-gold);border:1px solid var(--da-gold-ring)}
.dt-rel-badge.place{background:rgba(196,137,26,.08);color:var(--da-gold)}
.dt-rel-badge.cbeta{background:rgba(34,211,238,.08);color:var(--da-cyan)}
/* ── Bilingual Reader Segments ─────────────────────────── */
.dt-segment{display:flex;gap:10px;padding:10px 0 10px 4px;border-bottom:1px solid var(--da-border);border-left:3px solid transparent;transition:background .15s,border-left-color .15s;cursor:default;outline:none}
.dt-segment:last-child{border-bottom:none}
.dt-segment:focus{box-shadow:inset 0 0 0 2px var(--da-gold);border-radius:4px}
.dt-segment.is-active{background:rgba(173,124,28,.11);border-left-color:var(--da-gold);border-radius:4px}
.dt-segment.is-linked{background:rgba(173,124,28,.05);border-left-color:rgba(173,124,28,.4);border-radius:4px}
.dt-seg-num{font-size:9px;color:var(--da-dim,#4a5568);font-family:var(--da-font-mono);flex-shrink:0;padding-top:4px;min-width:20px;text-align:right;user-select:none;line-height:1.4}
.dt-seg-text{flex:1}
.dt-seg-han{font-family:"Noto Serif TC","Source Han Serif TC","Kaiti SC","FangSong",serif;font-size:15px;line-height:2.1;word-break:break-all;letter-spacing:.02em}
.dt-seg-vi{font-size:13px;line-height:1.85}
.dt-seg-empty{font-size:11px;color:var(--da-muted);font-style:italic;padding:8px 0;flex:1}
.dt-bilingual-badge{display:inline-flex;align-items:center;gap:4px;font-size:9px;font-weight:600;padding:2px 10px;border-radius:12px;background:var(--da-gold-bg,rgba(173,124,28,.1));color:var(--da-gold);border:1px solid var(--da-gold-ring,rgba(173,124,28,.3));margin-bottom:8px}
.dt-bilingual-badge.dt-ref-badge{background:rgba(52,211,153,.1);color:var(--da-green,#4ade80);border:1px solid rgba(52,211,153,.25)}
.dt-auto-align-note{font-size:10px;color:#d97706;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3);border-radius:4px;padding:6px 10px;margin-bottom:10px;cursor:help;line-height:1.5;font-weight:600}
.dt-seg-approx{color:rgba(245,158,11,.55)!important;font-size:13px!important;cursor:help}
.dt-no-trans{padding:20px 0}
.dt-no-trans-msg{font-size:11px;color:var(--da-muted);margin-bottom:12px;font-style:italic}
.dt-translate-btn{font-size:11px;color:#000;background:var(--da-gold);border:none;border-radius:6px;padding:7px 16px;cursor:pointer;font-weight:700}
.dt-actions{margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;padding-top:8px;border-top:1px solid var(--da-border)}
.dt-mobile-tabs{display:none;gap:0;padding:6px 14px;background:var(--da-panel);border-bottom:1px solid var(--da-border);flex-shrink:0}
.dt-mtab{flex:1;font-size:11px;font-weight:600;padding:5px 10px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;font-family:var(--da-font-ui);transition:all .12s}
.dt-mtab:first-child{border-radius:6px 0 0 6px}
.dt-mtab:last-child{border-radius:0 6px 6px 0;border-left:none}
.dt-mtab.active{background:var(--da-gold-bg);color:var(--da-gold);border-color:var(--da-gold)}
@media(max-width:600px){.dt-mobile-tabs{display:flex}.dt-resizer{display:none!important}.dt-split{flex-direction:column}.dt-pane{flex:1!important}#dt-pane-vi{display:none}}
/* ── GMP: Graph Main Panel filter chips ─────────────────────── */
.gmp-chip{font-size:10px;font-weight:600;padding:3px 10px;border-radius:12px;border:1px solid var(--da-border);background:none;color:var(--da-muted);cursor:pointer;font-family:var(--da-font-ui,sans-serif);letter-spacing:.02em;transition:all .12s;white-space:nowrap}
.gmp-chip:hover{color:var(--da-text);border-color:var(--da-muted)}
.gmp-chip-on{color:var(--da-gold);border-color:var(--da-gold);background:var(--da-gold-bg,rgba(196,137,26,.08))}
.gmp-chip-off{color:var(--da-muted);border-color:var(--da-border)}
@media(max-width:680px){#gmp-detail{display:none!important}}
/* ── T98: Inline Full Translation Reader ─────────────────── */
.dt-full-vi-btn{font-size:10px;padding:3px 10px;border-radius:5px;border:1px solid var(--da-gold);background:none;color:var(--da-gold);cursor:pointer;font-weight:600;white-space:nowrap;transition:background .12s,color .12s;font-family:var(--da-font-ui)}
.dt-full-vi-btn:hover,.dt-full-vi-btn:focus-visible{background:rgba(212,175,55,.12)}
.dt-full-vi-btn:focus-visible{outline:2px solid var(--da-gold);outline-offset:2px}
.dt-full-vi-btn[aria-expanded="true"]{background:rgba(212,175,55,.15)}
.dt-full-vi-panel{border-bottom:1px solid var(--da-border);background:var(--da-panel);padding:14px 18px 18px;max-height:60vh;overflow-y:auto;flex-shrink:0;scrollbar-width:thin;scrollbar-color:var(--da-border) transparent}
.dt-full-vi-panel::-webkit-scrollbar{width:4px}
.dt-full-vi-panel::-webkit-scrollbar-thumb{background:var(--da-border)}
.dt-full-vi-ph{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--da-muted);margin-bottom:6px}
.dt-full-vi-meta{font-size:10px;color:var(--da-dim);margin-bottom:12px;border-bottom:1px solid var(--da-border);padding-bottom:8px}
.dt-full-vi-body{font-family:var(--da-font-serif,Georgia,"Times New Roman",serif);font-size:18px;line-height:1.95;color:var(--da-text);word-break:break-word;overflow-wrap:break-word;max-width:72ch}
