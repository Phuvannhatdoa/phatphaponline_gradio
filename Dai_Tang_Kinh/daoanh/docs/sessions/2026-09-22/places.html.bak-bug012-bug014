    <script>
        const map = L.map('map', { zoomControl: false }).setView([16.0, 107.5], 5);
        L.tileLayer('https://mt1.google.com/vt/lyrs=m&hl=vi&x={x}&y={y}&z={z}', {
            attribution: '© Google Maps',
            maxZoom: 20,
            
        }).addTo(map);
        const clusterGroup = L.markerClusterGroup({
            chunkedLoading: true,
            maxClusterRadius: 50,
            iconCreateFunction: function(cluster) {
                const n = cluster.getChildCount();
                const size = n >= 500 ? 44 : n >= 100 ? 36 : n >= 20 ? 30 : 24;
                const color = n >= 500 ? '#e05c00' : n >= 100 ? '#d4900a' : n >= 20 ? '#3a9e6e' : '#5a8fc2';
                return L.divIcon({
                    html: `<div style="width:${size}px;height:${size}px;background:${color};border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:${size < 30 ? 10 : 12}px;font-weight:700;border:2px solid rgba(255,255,255,0.5)">${n}</div>`,
                    className: '', iconSize: [size, size], iconAnchor: [size/2, size/2]
                });
            }
        });
        // T06: zoom to bounds on cluster click
        clusterGroup.on('clusterclick', function(e) {
            e.layer.zoomToBounds({ padding: [30, 30], maxZoom: 14 });
        });
        const markerMap = {};
        const cateMap = {};          // MAP_SEMANTIC_MARKER_ICONS_001: cate per marker id
        let _currentCate = '';       // MAP_SEMANTIC_MARKER_ICONS_001: cate of currently selected place
        let dynamicResults = [];
        const labelLayer = L.layerGroup().addTo(map);
        // BUG-008: persistent layer for selected marker — non-clustered, always in DOM
        const persistentMarkerLayer = L.layerGroup().addTo(map);
        let loadAbortController = null;
        // BUG-008: sync-captured selected coords (set before async _currentGps is ready)
        let _selectedLat = null, _selectedLng = null;
        // BUG-011: click-race guard — increment on each selectItem call; stale fetches bail out
        let _selectToken = 0;
        map.addLayer(clusterGroup);
        function escapeDotId(id) {
            return id.replace(/[^a-zA-Z0-9]/g, '_');
        }
        const CATE_DOT_COLORS = {
            temple_site:    '#ef4444',   // red — Buddhist site
            mountain:       '#22c55e',   // green — mountain/peak
            river_lake:     '#06b6d4',   // cyan — water
            cave:           '#92400e',   // brown — cave/grotto
            pass:           '#f97316',   // orange — pass/gate
            country:        '#dc2626',   // dark red — country/kingdom
            province:       '#7c3aed',   // violet — province
            prefecture:     '#6d28d9',   // purple — prefecture/zhou/fu
            district:       '#4f46e5',   // indigo — district/county
            town:           '#2563eb',   // blue — town/zhen
            city:           '#475569',   // slate — city/capital
            dynasty_region: '#a855f7',   // purple — generic human-geo region
            natural_region: '#16a34a',   // dark green — natural region
            mythological:   '#9333ea',   // vivid purple — non-human realm
            admin_place:    '#f59e0b',   // amber — generic admin
            other:          '#6b7280',   // gray — other
            unknown:        '#9ca3af',   // light gray — unclassified
        };
        const ICON_TYPE_LABELS = {
            temple_site:    'Tự viện / Chùa',
            mountain:       'Núi / Sơn mạch',
            river_lake:     'Sông / Hồ / Biển',
            cave:           'Hang động / Thạch quật',
            pass:           'Quan ải / Đèo',
            country:        'Quốc gia / Vương quốc',
            province:       'Tỉnh / Quận lớn',
            prefecture:     'Châu / Phủ / Đạo',
            district:       'Huyện / Quận',
            town:           'Trấn / Thị trấn',
            city:           'Thành / Đô thị',
            dynasty_region: 'Vùng địa lý nhân văn',
            natural_region: 'Vùng địa lý tự nhiên',
            mythological:   'Cõi giới / Phi nhân giới',
            admin_place:    'Hành chính',
            other:          'Địa danh khác',
            unknown:        'Chưa phân loại',
        };
        // resolvePlaceIconType: primary=icon_type from API → secondary=note_category → fallback=name
        function resolvePlaceIconType(place) {
            if (!place) return 'unknown';
            if (place.icon_type && place.icon_type !== 'unknown') return place.icon_type;
            const nc = place.note_category || '';
            if (nc) {
                if (nc.includes('寺廟') || nc.includes('佛塔') || nc.includes('佛教文化地點')) return 'temple_site';
                if (nc.includes('山峰') || nc.includes('山脈')) return 'mountain';
                if (nc.includes('河流') || nc.includes('湖泊') || nc.includes('水系')) return 'river_lake';
                if (nc.includes('人文地理區域')) {
                    const nz = place.name_zh || '';
                    // Anchor to end of string to avoid false positives in transliterations
                    if (/[國国]$/.test(nz)) return 'country';
                    if (/[省]$/.test(nz)) return 'province';
                    if (/[州府路]$/.test(nz)) return 'prefecture';
                    if (/[縣县郡]$/.test(nz)) return 'district';
                    if (/[鎮镇]$/.test(nz)) return 'town';
                    if (/[城都]$/.test(nz)) return 'city';
                    return 'dynasty_region';
