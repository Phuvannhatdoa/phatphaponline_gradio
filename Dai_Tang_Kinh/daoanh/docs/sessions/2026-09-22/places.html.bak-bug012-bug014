                    inner = '<polygon points="12,1 1,9 23,9" fill="' + color + '"/>' +
                        '<rect x="4" y="9" width="3" height="13" fill="' + color + '"/>' +
                        '<rect x="17" y="9" width="3" height="13" fill="' + color + '"/>' +
                        '<rect x="3" y="11" width="18" height="2" fill="' + color + '"/>';
                    break;
                case 'mountain':
                    // Peak triangle
                    inner = '<polygon points="12,2 2,21 22,21" fill="' + color + '"/>';
                    break;
                case 'river_lake':
                    // Water waves
                    inner = '<path d="M2,11 C6,7 10,15 14,11 S19,7 22,11" fill="none" stroke="' + color + '" stroke-width="2.5"/>' +
                        '<path d="M2,16 C6,12 10,20 14,16 S19,12 22,16" fill="none" stroke="' + color + '" stroke-width="2.5"/>';
                    break;
                case 'cave':
                    // Cave arch with dark opening
                    inner = '<path d="M3,20 Q12,3 21,20" fill="none" stroke="' + color + '" stroke-width="2.5"/>' +
                        '<line x1="3" y1="20" x2="21" y2="20" stroke="' + color + '" stroke-width="2"/>' +
                        '<ellipse cx="12" cy="17" rx="4" ry="3.5" fill="' + color + '" opacity="0.5"/>';
                    break;
                case 'pass':
                    // Mountain with notch/gate
                    inner = '<polygon points="12,2 2,21 22,21" fill="' + color + '"/>' +
                        '<rect x="9" y="13" width="6" height="8" fill="#000" opacity="0.45"/>';
                    break;
                case 'country':
                    // Flag on pole
                    inner = '<line x1="5" y1="2" x2="5" y2="22" stroke="' + color + '" stroke-width="2.5"/>' +
                        '<polygon points="5,3 20,8 5,14" fill="' + color + '"/>';
                    break;
                case 'natural_region':
                    // Leaf/nature
                    inner = '<path d="M12,21 Q3,15 4,8 Q8,3 12,4 Q16,3 20,8 Q21,15 12,21Z" fill="' + color + '" opacity="0.85"/>' +
                        '<line x1="12" y1="21" x2="12" y2="12" stroke="rgba(0,0,0,0.25)" stroke-width="1.5"/>';
                    break;
                case 'mythological':
                    // Cloud/lotus
                    inner = '<circle cx="12" cy="14" r="5" fill="' + color + '" opacity="0.7"/>' +
                        '<circle cx="8" cy="14" r="3.5" fill="' + color + '" opacity="0.7"/>' +
                        '<circle cx="16" cy="14" r="3.5" fill="' + color + '" opacity="0.7"/>' +
                        '<circle cx="12" cy="10" r="4" fill="' + color + '"/>';
                    break;
                case 'province':
                case 'prefecture':
                case 'district':
                case 'town':
                case 'city':
                case 'dynasty_region':
                case 'admin_place':
                    // Administrative building — color distinguishes sub-type
                    inner = '<rect x="3" y="10" width="18" height="12" fill="' + color + '"/>' +
                        '<rect x="10" y="5" width="4" height="5" fill="' + color + '"/>' +
                        '<rect x="6" y="15" width="3" height="7" fill="rgba(0,0,0,0.3)"/>' +
                        '<rect x="15" y="15" width="3" height="7" fill="rgba(0,0,0,0.3)"/>';
                    break;
                default:
                    // Default pin — circle + teardrop
                    inner = '<circle cx="12" cy="9" r="5" fill="' + color + '"/>' +
                        '<polygon points="12,14 9,21 12,18 15,21" fill="' + color + '"/>';
            }
            return {
                svgHtml: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="' + size + '" height="' + size + '" style="display:block">' + inner + '</svg>',
                size: size,
                half: Math.floor(size / 2)
            };
        }
