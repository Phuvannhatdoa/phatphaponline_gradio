        // ── Tab 📜 ĐẠI TẠNG (TASK_TAB_DAI_TANG_PLACE) ────────────────
        // Dữ liệu từ GET /daoanh/api/entity/<id>/canon — 3 lớp:
        //   Layer A  dila_references : dẫn chiếu DILA (listbibl + fosizhi)
        //   Layer B  passages        : đoạn văn CBETA đã index (+ match evidence)
        //   Layer C  texts           : metadata tác phẩm (catalog_mapping ↔ canon_catalog)
        // Không bịa dữ liệu: mọi số liệu lấy thật từ API, không gọi LLM realtime.

        function _daitangChip(label, color) {
            return '<span style="display:inline-block;margin:0 4px 2px 0;padding:1px 7px;border-radius:4px;font-size:10px;font-family:var(--da-font-mono);background:rgba(212,175,55,0.15);color:' + (color || 'var(--da-gold)') + '">' + label + '</span>';
