        function dtSegmentHan(rawText) {
            if (!rawText) return [];
            var clean = rawText.replace(/\n/g, '');
            var parts = [], m, re = /[^。；！？]+[。；！？]/g;
            while ((m = re.exec(clean)) !== null) parts.push(m[0]);
            var rest = clean.slice(re.lastIndex).trim();
            if (rest) parts.push(rest);
            if (!parts.length) return [clean.trim()];
            var segs = [], buf = '';
            for (var i = 0; i < parts.length; i++) {
                buf += parts[i];
                if (buf.length >= 50) { segs.push(buf.trim()); buf = ''; }
            }
            if (buf.trim()) segs.push(buf.trim());
            return segs.length ? segs : [clean.trim()];
        }

        function dtBuildSegments(p) {
            var hanSegs = dtSegmentHan(p.raw_text || '');
            if (!hanSegs.length) return [];
            return hanSegs.map(function(ht, i) {
                return {
                    id: 'seg-' + ('000'+(i+1)).slice(-3),
                    order: i + 1,
                    source_text: ht,
                    target_text_vi: null,
                    alignment_status: 'text_only'
                };
            });
        }

