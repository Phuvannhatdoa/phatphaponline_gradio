                // Remove nodes no longer needed
                const toRemove = [];
                existingIds.forEach(function(id) { if (!newIds.has(id)) toRemove.push(id); });
                if (toRemove.length) _nexusNodesDS.remove(toRemove);

                // New nodes: fan out from clicked parent — NO physics restart (avoids "loăng quăng")
                const toAdd    = visnodes.filter(function(n) { return !existingIds.has(String(n.id)); });
                const toUpdate = visnodes.filter(function(n) { return existingIds.has(String(n.id)); });
                if (toAdd.length) {
