        }

        // Pagination Layer B — page hiện tại lưu global để render lại
        let _daitangPage = 1;
        function renderDaiTangTab(d) {
            const ph = document.getElementById('daitang-placeholder');
            const ct = document.getElementById('daitang-content');
            if (!ct) return;
            if (!d || !d.success) {
                ph.style.display = 'none'; ct.style.display = 'block';
