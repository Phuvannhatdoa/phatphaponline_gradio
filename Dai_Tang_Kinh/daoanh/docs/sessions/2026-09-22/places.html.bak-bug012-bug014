                    h += _daEmptyState({
                        taxonomy: 'Giáo lý liên quan thực thể',
                        scope: 'Chưa có claim liên quan trực tiếp cho thực thể này trong entity_claims.',
                        count: 0
                    });
                }
                box.innerHTML = h;
            } catch (e) {
                box.innerHTML = _daEmptyState({ taxonomy: 'Giáo lý Phật học', scope: 'Lỗi tải — ' + _escHtml(String(e)), count: 0 });
            }
        }
        // T111 — Persona Display Layer: gating nội dung theo trình độ người đọc (L1/L2/L3).
        // state lưu localStorage ('da_persona_level'); L2 là mặc định. 0 phụ thuộc server khi L2/L3.
        const _DA_PERSONA_KEY = 'da_persona_level';
        function _daPersona() {
            let lv = 'L2';
            try { lv = (localStorage.getItem(_DA_PERSONA_KEY) || 'L2').toUpperCase(); } catch (e) {}
            if (lv !== 'L1' && lv !== 'L2' && lv !== 'L3') lv = 'L2';
            return lv;
        }
        function _daPersonaLabel(lv) {
            return lv === 'L1' ? 'L1 · Học viên' : (lv === 'L3' ? 'L3 · Nhà nghiên cứu' : 'L2 · Cao học');
        }
        function _daPersonaTip(lv) {
            return lv === 'L1' ? 'Chỉ hiện claim đã xét duyệt + nhãn nguồn'
                : (lv === 'L3' ? 'Đầy đủ claims + provenance + nội dung đối chiếu/xung đột'
                   : 'Claims + badge mức khẳng định (mặc định)');
        }
        function _daPersonaSet(level) {
            try { localStorage.setItem(_DA_PERSONA_KEY, level); } catch (e) {}
            _daRenderPersonaSwitcher();
            _daZenqDisclaimer();
            // re-render vùng mở hiện tại (drawer + giáo lý)
            if (window._daCurrentSubjectId) _daFilterEvidence(window._daCurrentSubjectId);
