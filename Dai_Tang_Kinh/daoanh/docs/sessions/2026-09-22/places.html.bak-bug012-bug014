        function dtInitBilingualReader() {
            var hb = document.getElementById('dt-han-body');
            var vb = document.getElementById('dt-vi-body');
            if (!hb || !vb) return;
            var hs = hb.closest('.dt-pane-body');
            var vs = vb.closest('.dt-pane-body');
            var _ht = null, _lt = null;
            var _pref = window.matchMedia('(prefers-reduced-motion: reduce)');

            function _activate(segId, srcBody, dstBody, dstScroll) {
                [hb, vb].forEach(function(b){ b.querySelectorAll('.dt-segment').forEach(function(el){el.classList.remove('is-active','is-linked');}); });
                var p = srcBody.querySelector('[data-seg="'+segId+'"]');
                if (p) p.classList.add('is-active');
                var q = dstBody.querySelector('[data-seg="'+segId+'"]');
                if (q) {
                    q.classList.add('is-linked');
                    if (dstScroll) {
                        var cr = dstScroll.getBoundingClientRect(), sr = q.getBoundingClientRect();
                        if (sr.top < cr.top || sr.bottom > cr.bottom)
                            q.scrollIntoView({behavior: _pref.matches ? 'auto' : 'smooth', block:'nearest'});
                    }
                }
            }

            function _clear() {
                [hb, vb].forEach(function(b){ b.querySelectorAll('.dt-segment').forEach(function(el){el.classList.remove('is-active','is-linked');}); });
            }

            function _attach(srcBody, dstBody, dstScroll) {
                srcBody.addEventListener('mouseover', function(e) {
                    var seg = e.target.closest('.dt-segment[data-seg]');
                    if (!seg) return;
                    clearTimeout(_lt); clearTimeout(_ht);
                    _ht = setTimeout(function(){ _activate(seg.dataset.seg, srcBody, dstBody, dstScroll); }, 90);
                });
                srcBody.addEventListener('mouseout', function(e) {
                    var seg = e.target.closest('.dt-segment[data-seg]');
                    if (!seg) return;
                    var rel = e.relatedTarget && e.relatedTarget.closest('.dt-segment[data-seg]');
                    if (rel && srcBody.contains(rel)) return;
                    clearTimeout(_ht);
                    _lt = setTimeout(_clear, 150);
                });
                srcBody.addEventListener('focusin', function(e) {
                    var seg = e.target.closest('.dt-segment[data-seg]');
                    if (!seg) return;
                    clearTimeout(_lt); clearTimeout(_ht);
                    _activate(seg.dataset.seg, srcBody, dstBody, dstScroll);
                });
                srcBody.addEventListener('focusout', function(e) {
                    var seg = e.target.closest('.dt-segment[data-seg]');
                    if (!seg) return;
                    var rel = e.relatedTarget;
                    if (rel && (srcBody.contains(rel) || dstBody.contains(rel))) return;
                    _clear();
                });
            }

            _attach(hb, vb, vs);
            _attach(vb, hb, hs);
        }

        // ── T98: Inline Full Translation Reader ──────────────────────

        // Helper: chia raw vi_text thành mảng paragraph an toàn — không gọi LLM, không sửa nội dung.
        function _dtFormatFullViParagraphs(text) {
            if (!text) return [];
            text = text.trim();
            if (!text) return [];

            // Case A: có double newline → split ngay
            if (/\n\n/.test(text)) {
                return text.split(/\n\n+/).map(function(b){ return b.trim(); }).filter(Boolean);
            }

            // Case B: chỉ có single newline → mỗi dòng là một paragraph
            if (/\n/.test(text)) {
                return text.split(/\n/).map(function(b){ return b.trim(); }).filter(Boolean);
            }

            // Case C: khối liên tục — nhận diện sentence boundary, gom 2–4 câu/paragraph
            // Dấu kết câu: . ! ? … 。 ！ ？ — theo sau bằng khoảng trắng hoặc hết chuỗi
            var sentences = [];
            var re = /[.!?…。！？]+(?=\s|$)/g;
            var lastIndex = 0;
            var m;
            while ((m = re.exec(text)) !== null) {
                var end = m.index + m[0].length;
                var s = text.slice(lastIndex, end).trim();
                if (s) sentences.push(s);
                lastIndex = end;
                // bỏ qua khoảng trắng sau dấu kết câu
                while (lastIndex < text.length && text[lastIndex] === ' ') lastIndex++;
                re.lastIndex = lastIndex;
            }
            if (lastIndex < text.length) {
                var rem = text.slice(lastIndex).trim();
                if (rem) sentences.push(rem);
            }
            if (sentences.length <= 1) return [text]; // không nhận diện được — giữ nguyên khối

            // Gom 2–4 câu, target 180–420 ký tự/paragraph
            var paras = [], cur = [], curLen = 0;
            for (var i = 0; i < sentences.length; i++) {
                cur.push(sentences[i]);
                curLen += sentences[i].length;
                var last = (i === sentences.length - 1);
                if (last || cur.length >= 4 || (cur.length >= 2 && curLen >= 180) || curLen >= 420) {
                    paras.push(cur.join(' '));
                    cur = []; curLen = 0;
                }
            }
            if (cur.length) paras.push(cur.join(' '));
            return paras.filter(Boolean);
        }

        // ── BẢN DỊCH TIẾNG VIỆT — đọc kiểu sách: narrative + lượt hỏi-đáp (Zen Q/A) ──
        // Render-time ONLY: không gọi LLM, không sửa nội dung/DB/API; không thêm Q/A prefix.
        // Chỉ tách block khi marker hỏi-đáp RÕ ràng (boundary + người nói + động từ lời nói + dấu hai chấm)
        // và lượt thoại được quote-aware (say = trọn cụm ngoặc kép mở→đóng).
        // Vai trò lượt thoại suy từ động từ marker (hỏi/thưa/vấn/bạch = câu hỏi; nói/đáp/bảo/phán/dạy = trả lời).
        // Không khớp → trả null để fallback giữ nguyên render cũ (giữ .qa-narrative).
        var _reViQa = /(^|[\n,;.!?…。！？”“"'’])\s*((?:Có vị tăng|Vị tăng|Vị kia|Chúng tăng|[A-ZÀ-Ỹ][a-zà-ỹ]*(?:\s+[A-ZÀ-Ỹ][a-zà-ỹ]*){0,2}))\s+(hỏi|nói|đáp|bảo|thưa|vấn|bạch|phán|dạy)\s*[:：]\s*/g;

        function _dtViSplitDialogue(text) {
            if (!text) return null;
            _reViQa.lastIndex = 0;
            var out = [];
            var last = 0;
            var pending = null; // marker không có ngoặc mở/đóng — gom tới marker kế
            var m;
            while ((m = _reViQa.exec(text)) !== null) {
                var whoStart = m.index + (m[1] || '').length;
                var contentStart = _reViQa.lastIndex;
                var role = /(hỏi|thưa|vấn|bạch)/.test(m[3]) ? 'q' : 'a';
                // đóng lượt đang chờ (marker không quote) tại ranh giới marker kế
                if (pending) {
                    out.push({ t: 'qa', who: pending.who, say: text.slice(pending.sayStart, whoStart), role: pending.role });
                    last = whoStart;
                    pending = null;
                }
                // narrative trước marker — boundary char (., ,, ”, \n...) thuộc về narrative
                if (last < whoStart) out.push({ t: 'narr', text: text.slice(last, whoStart) });
                // who = đoạn marker nguyên vẹn (Sư đáp: / Vua hỏi: / Có vị tăng hỏi: ...)
                var who = text.slice(whoStart, contentStart);
                // say: quote-aware — nếu sau marker là ngoặc mở “ hoặc ", đọc tới ngoặc đóng tương ứng
                var ch = text.charAt(contentStart);
                var open = (ch === '\u201C' || ch === '"') ? ch : '';
                var sayEnd = -1;
                if (open) {
                    var ci = text.indexOf(open === '\u201C' ? '\u201D' : '"', contentStart + 1);
                    if (ci !== -1) sayEnd = ci + 1;
                }
                if (sayEnd !== -1) {
                    out.push({ t: 'qa', who: who, say: text.slice(contentStart, sayEnd), role: role });
                    _reViQa.lastIndex = sayEnd; // bỏ qua marker lồng bên trong lời thoại
                    last = sayEnd;
                } else {
                    pending = { who: who, sayStart: contentStart, role: role };
                    last = contentStart;
                }
            }
            if (pending) {
                out.push({ t: 'qa', who: pending.who, say: text.slice(pending.sayStart), role: pending.role });
            } else if (last < text.length) {
                out.push({ t: 'narr', text: text.slice(last) });
            }
            var hasQa = out.some(function (b) { return b.t === 'qa'; });
            return hasQa ? out : null;
        }

        function _dtViDialogueHtml(text) {
            var blocks = _dtViSplitDialogue(text);
            if (!blocks) return null;
            var html = '';
            for (var i = 0; i < blocks.length; i++) {
                var b = blocks[i];
                if (b.t === 'narr') {
                    html += '<p class="qa-narrative">' + _escHtml(b.text) + '</p>';
                } else {
                    html += '<div class="qa-turn ' + (b.role === 'q' ? 'qa-question' : 'qa-answer') + '"><span class="qa-who">' + _escHtml(b.who) + '</span><span class="qa-say">' + _escHtml(b.say) + '</span></div>';
                }
            }
            return '<div class="qa-text">' + html + '</div>';
        }

