        // ── Helper: map nguồn Hán → tên Việt đầy đủ ──
        function _srcToViet(src) {
            const map = {
                '唐高僧傳': 'Đường Cao Tăng Truyện (唐高僧傳)',
                '宋高僧傳': 'Tống Cao Tăng Truyện (宋高僧傳)',
                '大明高僧傳': 'Minh Cao Tăng Truyện (大明高僧傳)',
                '明高僧傳': 'Minh Cao Tăng Truyện (明高僧傳)',
                '神僧傳': 'Thần Tăng Truyện (神僧傳)',
                '景德傳燈錄': 'Cảnh Đức Truyền Đăng Lục (景德傳燈錄)'
            };
            return map[src] || _fmtName(null, src) || src;
        }
        // ── Helper: short era name for subgroup chip label ──
        function _srcToEra(src) {
            const map = {
                '唐高僧傳': 'Đường', '宋高僧傳': 'Tống',
                '大明高僧傳': 'Minh', '明高僧傳': 'Minh',
                '神僧傳': 'Thần', '景德傳燈錄': 'Cảnh Đức'
            };
            return map[src] || 'Khác';
        }

        // ── Helper: render alias chips HTML overlay bên trên canvas ──
        function _gmpRenderAliasChips(d) {
            const el = document.getElementById('gmp-alias-chips');
            if (!el) return;
            const rawAliases = d.alt_names || [];
            const _normA = a => typeof a === 'object' ? a : { zh: String(a || ''), vi: null };
            const seenAlias = new Set();
            const aliases = rawAliases.map(_normA).filter(a => {
                const k = (a.zh || '').trim().normalize('NFC');
                if (!k || seenAlias.has(k)) return false; seenAlias.add(k); return true;
            });
            if (!aliases.length) { el.style.display = 'none'; return; }
            el.style.display = 'flex';
            el.innerHTML =
                '<span style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--da-muted);flex-shrink:0;margin-right:6px">Tên khác:</span>' +
                '<div style="display:flex;flex-wrap:wrap;gap:4px">' +
                aliases.map(a => {
                    const label = _fmtName(a.vi, a.zh) || a.zh;
                    const badge = (!a.vi) ? ' <span style="font-size:8px;opacity:.55;background:var(--da-card);border-radius:2px;padding:0 3px">chưa dịch</span>' : '';
                    return '<span style="font-size:11px;font-family:var(--da-font-serif);background:var(--da-panel);border:1px solid var(--da-border);border-radius:8px;padding:1px 9px;color:var(--da-text)" title="' + _escHtml(a.zh) + '">' + _escHtml(label) + badge + '</span>';
                }).join('') + '</div>';
        }

        // ── Layout stability helpers ──
        // Restore positions of existing nodes after adding children.
        // excludeIds: nodes just removed from dataset (moveNode would throw).
        function _gmpRestorePositions(savedPos, excludeIds) {
            if (!_graphNetwork) return;
            const ex = new Set(excludeIds || []);
            Object.entries(savedPos).forEach(([id, pos]) => {
                if (!ex.has(id)) {
                    try { _graphNetwork.moveNode(id, pos.x, pos.y); } catch(e) {}
                }
            });
        }
        // Compute y position for a child node centred on parent.
        function _gmpChildY(parentY, idx, total, spacing) {
            return parentY + (idx - (total - 1) / 2) * (spacing || 70);
        }

        // ── Expand: kinh điển (Kinh điển group → text nodes ở level -2 bên trái) ──
        function _gmpExpandWorks(d, dataset) {
            if (!dataset || !_graphNetwork) return;
            const savedPos = _graphNetwork.getPositions();
            const parentPos = savedPos['group-works'] || savedPos['root'] || {x: -220, y: 0};
            dataset.nodes.remove('group-works');
            dataset.edges.remove('edge-root-works');
            const textNodes = (d.nodes || []).filter(n => n.group === 'text');
            const total = textNodes.length;
            textNodes.forEach((t, idx) => {
                dataset.nodes.add({
                    id: 'work-' + t.id,
                    label: _fmtName(t.label, t.label_zh),
                    x: parentPos.x - 200, y: _gmpChildY(parentPos.y, idx, total, 65),
                    shape: 'box',
                    color: { background: '#1a3a5c', border: '#4a7db5' },
                    font: { color: '#dce5f4', size: 11 },
                    title: (t.label_zh || '') + (t.title ? '\n' + t.title : ''),
                    _rawNode: t
                });
                dataset.edges.add({
                    id: 'edge-root-work-' + t.id,
                    from: 'root', to: 'work-' + t.id,
                    label: 'dẫn chiếu', arrows: 'to', dashes: false,
                    color: { color: '#4a7db5cc', highlight: '#4a7db5' },
                    font: { size: 8, color: '#6a8db5', strokeWidth: 0 }
                });
            });
            _gmpRestorePositions(savedPos, ['group-works']);
            setTimeout(() => _graphNetwork && _graphNetwork.fit({ animation: { duration: 300, easingFunction: 'easeInOutQuad' } }), 50);
        }

        // ── Expand: tăng nhân (Persons group → subgroup nodes theo nguồn) ──
        function _gmpExpandPersons(d, dataset) {
            if (!dataset || !_graphNetwork) return;
            const savedPos = _graphNetwork.getPositions();
            const parentPos = savedPos['group-persons'] || savedPos['root'] || {x: 220, y: 0};
            dataset.nodes.remove('group-persons');
            dataset.edges.remove('edge-root-persons');
            const personNodes = (d.nodes || []).filter(n => n.group === 'person');
            // Map personId → source book từ edges
            const personSourceMap = {};
            (d.edges || []).forEach(e => {
                if (e.ref && e.to && ('' + e.to).startsWith('person:')) {
                    personSourceMap[e.to] = e.ref;
                }
            });
            // Group by source
            const personsBySource = {};
            personNodes.forEach(p => {
                const src = personSourceMap[p.id] || 'unknown';
                if (!personsBySource[src]) personsBySource[src] = [];
                personsBySource[src].push(p);
            });
            const entries = Object.entries(personsBySource);
            entries.forEach(([src, persons], idx) => {
                const srcLabel = _srcToViet(src);
                const eraLabel = _srcToEra(src);
                const subId = 'subgroup-src' + idx;
                dataset.nodes.add({
                    id: subId,
                    label: eraLabel + ' (' + persons.length + ')',
                    x: parentPos.x + 200, y: _gmpChildY(parentPos.y, idx, entries.length, 80),
                    shape: 'box',
                    color: { background: '#3d2a5c', border: '#7b4ab5' },
                    font: { color: '#e8d5ff', size: 10 },
                    title: 'Click để xem ' + persons.length + ' nhân vật trong ' + srcLabel,
                    _persons: persons, _src: src
                });
                dataset.edges.add({
                    id: 'edge-root-' + subId,
                    from: 'root', to: subId,
                    arrows: 'to', dashes: false,
                    color: { color: '#7b4ab5aa', highlight: '#9b6ad5' }
                });
            });
            _gmpRestorePositions(savedPos, ['group-persons']);
            setTimeout(() => _graphNetwork && _graphNetwork.fit({ animation: { duration: 300, easingFunction: 'easeInOutQuad' } }), 50);
        }

        // ── Expand subgroup → individual person nodes (level 3) ──
        function _gmpExpandSubgroup(subgroupId, d, dataset) {
            if (!dataset || !_graphNetwork) return;
            const subNode = dataset.nodes.get(subgroupId);
            if (!subNode) return;
            const savedPos = _graphNetwork.getPositions();
            const parentPos = savedPos[subgroupId] || {x: 440, y: 0};
            const persons = subNode._persons || [];
            dataset.nodes.remove(subgroupId);
            dataset.edges.remove('edge-root-' + subgroupId);
            const total = persons.length;
            const spacing = 40;
            // Tính khoảng dọc cần thiết và đẩy sibling subgroup/person nodes ra để tránh đè
            const halfH = total > 1 ? Math.ceil((total - 1) / 2) * spacing + 20 : 0;
            if (halfH > 0) {
                const expandY = parentPos.y;
                Object.keys(savedPos).forEach(id => {
                    if (id === subgroupId) return;
                    if (!('' + id).startsWith('subgroup-') && !('' + id).startsWith('person-')) return;
                    const pos = savedPos[id];
                    if (!pos) return;
                    if (pos.y > expandY + 10)      savedPos[id] = { x: pos.x, y: pos.y + halfH };
                    else if (pos.y < expandY - 10) savedPos[id] = { x: pos.x, y: pos.y - halfH };
                });
            }
            persons.forEach((p, idx) => {
                const hasEvidence = !!(p.has_evidence ||
                    (d.edges || []).find(e => (e.to === p.id) && (e.has_ref || e.ref)));
                const nodeId = 'person-' + p.id;
                if (dataset.nodes.get(nodeId)) return; // dedup
                dataset.nodes.add({
                    id: nodeId,
                    label: _fmtName(p.label, p.label_zh),
                    x: parentPos.x + 180, y: _gmpChildY(parentPos.y, idx, total, spacing),
                    shape: 'dot', size: 10,
                    color: { background: '#8b7355', border: '#c8a96e',
                             highlight: { background: '#c8a96e', border: '#ad7c1c' } },
                    font: { size: 10 },
                    title: (p.title || '') + (p.label_zh ? '\n' + p.label_zh : ''),
                    _rawNode: p
                });
                dataset.edges.add({
                    id: 'edge-person-' + p.id,
                    from: 'root', to: nodeId,
                    arrows: 'to',
                    dashes: !hasEvidence,
                    color: hasEvidence
                        ? { color: '#c8a96e', highlight: '#ad7c1c' }
                        : { color: '#666666', opacity: 0.4 },
                    width: hasEvidence ? 2 : 1,
                    _coMention: !hasEvidence
                });
            });
            _gmpRestorePositions(savedPos, [subgroupId]);
            setTimeout(() => _graphNetwork && _graphNetwork.fit({ animation: { duration: 300, easingFunction: 'easeInOutQuad' } }), 50);
        }

        // ── Mobile fallback: accordion tree khi viewport < 768px ──
        function _gmpMobileFallback(d) {
            const el = document.getElementById('gmp-mobile-fallback');
            if (!el) return;
            const textNodes = (d.nodes || []).filter(n => n.group === 'text');
            const personNodes = (d.nodes || []).filter(n => n.group === 'person');
            const personSourceMap = {};
            (d.edges || []).forEach(e => {
                if (e.ref && e.to && ('' + e.to).startsWith('person:')) personSourceMap[e.to] = e.ref;
            });
            const personsBySource = {};
            personNodes.forEach(p => {
                const src = personSourceMap[p.id] || 'khác';
                if (!personsBySource[src]) personsBySource[src] = [];
                personsBySource[src].push(p);
            });
            let html = '';
            if (textNodes.length) {
                html += '<details open><summary style="font-weight:700;cursor:pointer;padding:4px 0;color:var(--da-text)">Kinh điển (' + textNodes.length + ')</summary>' +
                    '<ul style="margin:4px 0 8px 16px;padding:0">' +
                    textNodes.map(t => '<li style="padding:2px 0">' + _escHtml(_fmtName(t.label, t.label_zh)) + '</li>').join('') +
                    '</ul></details>';
            }
            if (personNodes.length) {
                html += '<details><summary style="font-weight:700;cursor:pointer;padding:4px 0;color:var(--da-text)">Tăng nhân (' + personNodes.length + ')</summary>';
                Object.entries(personsBySource).forEach(([src, persons]) => {
                    html += '<details style="margin-left:12px"><summary style="cursor:pointer;padding:3px 0;color:var(--da-muted)">' +
                        _escHtml(_srcToViet(src)) + ' (' + persons.length + ')</summary>' +
                        '<ul style="margin:3px 0 6px 16px;padding:0">' +
                        persons.map(p => '<li style="padding:2px 0">' + _escHtml(_fmtName(p.label, p.label_zh)) + '</li>').join('') +
                        '</ul></details>';
                });
                html += '</details>';
            }
            if (!html) html = '<div style="color:var(--da-muted);font-style:italic">Chưa có dữ liệu đồ thị.</div>';
            el.innerHTML = html;
            el.style.display = 'block';
        }

        // ── Toggle co-mention edges ──
        function _gmpToggleCoMention() {
            _graphCoMentionVisible = !_graphCoMentionVisible;
            const btn = document.getElementById('gf-comention');
            if (btn) {
                btn.style.background    = _graphCoMentionVisible ? 'var(--da-gold-bg,rgba(196,137,26,.12))' : 'none';
