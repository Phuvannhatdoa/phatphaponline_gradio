        }
        // T100-P2 (Batch 4) — EVIDENCE DRAWER chung (additive): hiển thị claims kèm filter
        // theo assertion_level / verification_status / claim_type. Lưu claims vào
        // window._daDrawerClaims theo subjectId; filter re-render từ cache đó.
        function _daEvidenceDrawer(opts) {
            opts = opts || {};
            const claims = opts.claims || [];
            const subjectId = opts.subjectId || '';
            const max = opts.max || 20;
