        chain.forEach(function (n) {
          var el = document.createElement("div");
          el.className = "t130-node";
          var label = n.id || "(?)";
          var sib = (n.sibling_count && n.sibling_count > 0) ? " (" + n.sibling_count + " đệ tử)" : "";
          el.textContent = (n.dir === "up" ? "⬆ " : "⬇ ") + label + sib;
          box.appendChild(el);
        });
        if (d && d.gate) {
          var g = document.createElement("div");
          g.className = "t130-gate";
          g.textContent = "Gate: READ=" + (d.gate.CONTENT_READ ? "mở" : "chặt") +
                          " EXPORT=" + (d.gate.EXPORT ? "mở" : "chặt");
          box.appendChild(g);
        }
      })
      .catch(function (e) { console.error("[T130] expand fail", e); });
  }
  T130.deepLink = deepLink;
  window.T130 = T130;
})();
document.addEventListener("DOMContentLoaded", function () { window.T130 && window.T130.deepLink(); });
</script>
