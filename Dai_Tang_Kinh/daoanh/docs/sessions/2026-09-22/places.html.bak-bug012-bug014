        function dtTranslatePassage(pIndex) {
            const p = _dtPassages[pIndex];
            if (!p) return;
            const btn = document.getElementById('daitang-dich-btn-' + pIndex);
            if (btn) { btn.textContent='⏳ Đang dịch...'; btn.disabled=true; btn.style.opacity='0.6'; }
            fetch('/daoanh/api/passage/' + encodeURIComponent(p.passage_id) + '/translate', {method:'POST', headers:{'Content-Type':'application/json'}})
                .then(r => r.json().then(d => ({status:r.status, body:d})))
                .then(({status, body}) => {
                    if (body.ok && body.vi_text) {
                        p.has_vi=true; p.vi_text=body.vi_text; p.is_translation_draft=true;
                        window._daitangPassages[pIndex] = p;
                        dtRenderPassage(_dtActivePassage);
                        daiTangRefreshList();
                    } else {
                        if (btn) { btn.textContent='🤖 Dịch (AI)'; btn.disabled=false; btn.style.opacity='1'; }
                        alert(status===429 ? 'Hết quota API. Thử lại sau.' : 'Dịch thất bại: '+(body.error||'lỗi'));
                    }
                }).catch(() => { if (btn) { btn.textContent='🤖 Dịch (AI)'; btn.disabled=false; btn.style.opacity='1'; } alert('Lỗi kết nối.'); });
        }

        // ── DT: Tab Quan Hệ — Relationship Panel ──────────────────────────────
        let _dtRelCache = null, _dtRelEntityId = null;

        function dtDrawGraph() { dtLoadRelated(); } // hook từ dtSwitchTab('graph')

        function dtLoadRelated(forceReload) {
            const body = document.getElementById('dt-rel-body');
            const src  = document.getElementById('dt-rel-src');
            if (!body) return;
            // Lấy entity ID hiện tại
            const eid = window._dtCurrentEntityId;
            if (!eid) { body.innerHTML = '<div style="padding:20px;color:var(--da-muted);text-align:center">Chưa chọn thực thể.</div>'; return; }
            if (!forceReload && _dtRelEntityId === eid && _dtRelCache) { _dtRenderRelated(_dtRelCache); return; }
            body.innerHTML = '<div style="padding:28px 0;text-align:center;color:var(--da-muted)"><span class="dt-spinner"></span> Đang tải quan hệ...</div>';
            fetch('/daoanh/api/entity/' + encodeURIComponent(eid) + '/related')
                .then(r => r.json())
                .then(d => {
                    if (!d.ok) throw new Error(d.error || 'Lỗi API');
                    _dtRelCache = d; _dtRelEntityId = eid;
                    if (src) src.textContent = (d.places.length + d.persons.length) + ' thực thể · ' + d.texts.length + ' tác phẩm';
                    _dtRenderRelated(d);
                })
                .catch(e => { body.innerHTML = '<div style="padding:20px;color:var(--da-muted);text-align:center">⚠ ' + _escHtml(e.message) + '</div>'; });
        }

        // FIX 2 — MẠNG LƯỚI DẪN CHIẾU: 3 sections + summary + amber warning
        function _dtRenderRelated(d) {
            const body = document.getElementById('dt-rel-body');
            if (!body) return;

            // Classify persons: A=curated, B=co-mention canonical, C=to-verify
            const curatedPersons = (d.persons || []).filter(p => p.source === 'curated');
            const canonPersons   = (d.persons || []).filter(p => p.source !== 'curated');

            // Dedup places by canonical_id / entity_id (e.g. Kỳ Châu variants)
            const seenPlace = new Set();
            const dedupPlaces = (d.places || []).filter(p => {
                const key = p.entity_id;
                if (seenPlace.has(key)) return false;
                seenPlace.add(key);
                return true;
            });

            // Summary counts
            const cntCurated = curatedPersons.length;
            const cntCoMention = dedupPlaces.length + canonPersons.length;
            const cntTexts = (d.texts || []).length;
            const src = document.getElementById('dt-rel-src');
            if (src) src.textContent = cntCurated + ' đã biên tập · ' + cntCoMention + ' cùng xuất hiện · ' + cntTexts + ' nguồn ánh xạ';

            let h = '';

            // ── Dynamic summary ───────────────────────────────────────────────
            h += '<div style="font-size:10px;color:var(--da-muted);margin-bottom:6px;padding:2px 0">'
               + '<strong style="color:var(--da-text)">' + cntCurated + '</strong> quan hệ đã biên tập'
               + ' · <strong style="color:var(--da-text)">' + cntCoMention + '</strong> thực thể cùng xuất hiện'
               + ' · <strong style="color:var(--da-text)">' + cntTexts + '</strong> nguồn ánh xạ trực tiếp'
               + '</div>';

            // ── Amber warning ─────────────────────────────────────────────────
            h += '<div style="background:rgba(217,119,6,.10);border:1px solid rgba(217,119,6,.35);border-radius:6px;padding:6px 10px;font-size:10px;color:var(--da-text);margin-bottom:10px;line-height:1.55">'
               + '<strong style="color:#d97706">⚠ Lưu ý:</strong> '
               + '"Cùng xuất hiện trong văn bản" không đồng nghĩa với quan hệ lịch sử, truyền thừa hoặc cư trú.'
               + '</div>';

            // ── SECTION A: Quan hệ đã biên tập ───────────────────────────────
            h += _dtRelSection('✓ Quan Hệ Đã Biên Tập', curatedPersons.length);
            if (!curatedPersons.length) {
                h += _dtRelEmpty('Chưa có quan hệ được biên tập xác minh. Admin thêm qua place_person_link.');
            } else {
                curatedPersons.forEach(p => {
                    const label = _fmtName(p.name_vi, p.name_zh) || p.entity_id;
                    h += '<div class="dt-rel-item" onclick="dtRelClickPerson(' + JSON.stringify(p.entity_id) + ')" style="cursor:pointer">'
                        + '<div class="dt-rel-icon" style="background:rgba(52,211,153,.10);color:var(--da-green)">👤</div>'
                        + '<div class="dt-rel-info">'
                        +   '<div class="dt-rel-zh">' + _escHtml(label) + '</div>'
                        +   '<div class="dt-rel-rel">' + _escHtml(p.relation_type || 'liên quan') + (p.dynasty ? ' · ' + _escHtml(p.dynasty) : '') + '</div>'
                        + '</div>'
                        + '<div class="dt-rel-meta">'
                        +   '<span class="dt-rel-badge curated">✓ CURATED</span>'
                        + '</div></div>';
                });
            }

            // ── SECTION B: Cùng xuất hiện trong văn bản ──────────────────────
            const bCount = dedupPlaces.length + canonPersons.length;
            h += _dtRelSection('CÙNG XUẤT HIỆN TRONG VĂN BẢN', bCount);
            if (!bCount) {
                h += _dtRelEmpty('Không tìm thấy thực thể cùng xuất hiện trong kinh điển CBETA.');
            } else {
                // B1: Địa danh co-mentioned
                if (dedupPlaces.length) {
                    h += '<div style="font-size:9px;font-weight:700;color:var(--da-dim);text-transform:uppercase;letter-spacing:.07em;margin:6px 0 4px">Địa danh (' + dedupPlaces.length + ')</div>';
                    dedupPlaces.forEach(p => {
                        const label = _fmtName(p.name_vi, p.name_zh) || p.entity_id;
                        h += '<div class="dt-rel-item" onclick="dtRelClickPlace(' + JSON.stringify(p.entity_id) + ')" style="cursor:pointer">'
                            + '<div class="dt-rel-icon" style="background:var(--da-gold-bg);color:var(--da-gold)">🏛</div>'
                            + '<div class="dt-rel-info">'
                            +   '<div class="dt-rel-zh">' + _escHtml(label) + '</div>'
                            +   '<div class="dt-rel-rel">cùng xuất hiện · ' + (p.mentions||0) + ' đoạn</div>'
                            + '</div>'
                            + '<div class="dt-rel-meta">'
                            +   (p.mentions ? '<span class="dt-rel-badge canon">×' + p.mentions + '</span>' : '')
                            +   '<span class="dt-rel-badge place">ĐỊA</span>'
                            + '</div></div>';
                    });
                }
                // B2: Nhân vật co-mentioned
                if (canonPersons.length) {
                    h += '<div style="font-size:9px;font-weight:700;color:var(--da-dim);text-transform:uppercase;letter-spacing:.07em;margin:6px 0 4px">Nhân vật (' + canonPersons.length + ')</div>';
                    canonPersons.forEach(p => {
                        const label = _fmtName(p.name_vi, p.name_zh) || p.entity_id;
                        h += '<div class="dt-rel-item" onclick="dtRelClickPerson(' + JSON.stringify(p.entity_id) + ')" style="cursor:pointer">'
                            + '<div class="dt-rel-icon" style="background:rgba(167,139,250,.12);color:#a78bfa">👤</div>'
                            + '<div class="dt-rel-info">'
                            +   '<div class="dt-rel-zh">' + _escHtml(label) + '</div>'
                            +   '<div class="dt-rel-rel">cùng xuất hiện' + (p.mentions ? ' · ' + p.mentions + ' đoạn' : '') + (p.dynasty ? ' · ' + _escHtml(p.dynasty) : '') + '</div>'
                            + '</div>'
                            + '<div class="dt-rel-meta">'
                            +   (p.mentions ? '<span class="dt-rel-badge canon">×' + p.mentions + '</span>' : '')
                            + '</div></div>';
                    });
                }
            }

            // ── SECTION C: Nguồn ánh xạ kinh điển ───────────────────────────
            h += _dtRelSection('📖 Nguồn Ánh Xạ Kinh Điển', (d.texts || []).length);
            if (!(d.texts || []).length) {
                h += _dtRelEmpty('Chưa có tác phẩm được ánh xạ. Xem Tab Dẫn Chiếu để tra CBETA refs.');
            } else {
                d.texts.forEach(t => {
                    const label = _fmtName(t.title_vi, t.title_zh) || String(t.catalog_id || '');
                    h += '<div class="dt-rel-item" onclick="dtJumpToPassage(0)" style="cursor:pointer">'
                        + '<div class="dt-rel-icon" style="background:rgba(34,211,238,.08);color:var(--da-cyan)">📖</div>'
                        + '<div class="dt-rel-info">'
                        +   '<div class="dt-rel-zh">' + _escHtml(label) + '</div>'
                        +   (t.era_vi||t.author_vi ? '<div class="dt-rel-rel">' + _escHtml([t.era_vi,t.author_vi].filter(Boolean).join(' · ')) + '</div>' : '')
                        + '</div>'
                        + '<div class="dt-rel-meta">'
                        +   '<span class="dt-rel-badge cbeta">Sh.' + _escHtml(String(t.catalog_id||'')) + '</span>'
                        +   (t.mapping_status==='approved' ? '<span class="dt-rel-badge curated">✓</span>' : '')
                        + '</div></div>';
                });
            }

            body.innerHTML = h;
        }

        function _dtRelSection(title, count) {
            return '<div style="display:flex;align-items:center;gap:8px;margin:14px 0 8px;padding-bottom:6px;border-bottom:1px solid var(--da-border)">'
                + '<span style="font-size:10px;font-weight:700;color:var(--da-muted);text-transform:uppercase;letter-spacing:.07em">' + _escHtml(title) + '</span>'
                + '<span style="font-size:9px;padding:1px 7px;border-radius:10px;background:var(--da-dim);color:var(--da-muted)">' + count + '</span>'
                + '</div>';
        }

        function _dtRelEmpty(msg) {
            return '<div style="font-size:11px;color:var(--da-dim);font-style:italic;margin-bottom:10px;padding-left:4px">' + _escHtml(msg) + '</div>';
        }

        function dtRelClickPlace(eid) {
            if (typeof selectItem === 'function') selectItem(eid);
        }

        function dtRelClickPerson(eid) {
            if (typeof selectPerson === 'function') { selectPerson(eid); return; }
            // fallback: mở sidebar person nếu có
            const pBtn = document.querySelector('[data-tab="person"]');
            if (pBtn) pBtn.click();
        }

        function _dtDSState(icon, title, sub) {
            return '<div class="dt-ds-state"><div class="dt-ds-state-ico">' + icon + '</div>'
                + '<div class="dt-ds-state-t">' + _escHtml(title) + '</div>'
                + (sub ? '<div class="dt-ds-state-s">' + sub + '</div>' : '')
                + '</div>';
        }

        function dtUseSuggestion() {
            const inp = document.getElementById('dt-ds-input');
            const vld = document.getElementById('dt-ds-validation');
            if (!inp) return;
            inp.value = 'Nhạn Môn Quan có trong tác phẩm nào?';
            if (vld) vld.style.display = 'none';
            inp.focus();
        }

        function dtRunDS() {
            const vld = document.getElementById('dt-ds-validation');
            const inp = (document.getElementById('dt-ds-input')||{});
            const q = (inp.value || '').trim();
            const el = document.getElementById('dt-ds-result');
            if (!q) {
                if (vld) vld.style.display = 'block';
                if (el) el.innerHTML = _dtDSState('🔍', 'Chưa tìm kiếm', 'Hãy nhập một câu hỏi để khám phá văn bản và các thực thể liên quan.');
                if (inp && inp.focus) inp.focus();
                return;
            }
            if (vld) vld.style.display = 'none';
            if (!el) return;
            if (el.dataset.dsState === 'busy') return;
            // DeepSearch real: cùng backend Q&A (retrieval toàn hệ thống), chỉ hiển thị tư liệu.
            el.dataset.dsState = 'busy';
            el.innerHTML = _dtDSState('⏳', 'Đang tìm kiếm…',
                'Truy vấn toàn hệ thống cho: “' + _escHtml(q) + '”.');
            fetch(baseUrl + '/daoanh/api/daitang/qa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question: q })
            })
            .then(r => r.json().then(d => ({ http: r.status, d })))
            .then(({ http, d }) => {
                el.dataset.dsState = 'done';
                if (!d || !d.ok) {
                    el.dataset.dsState = 'nodata';
                    el.innerHTML = _dtDSState('📭', 'Không có kết quả',
                        _escHtml((d && d.message) || (d && d.error) || 'Lỗi không xác định')
                        + '<br><span style="font-size:11px">HTTP ' + http + '</span>');
                    return;
                }
                if (d.mode === 'no_data') {
                    el.dataset.dsState = 'nodata';
                    el.innerHTML = _dtDSState('📭', 'Không tìm thấy tư liệu',
                        _escHtml(d.message || 'Chưa có tư liệu liên quan trong hệ thống.'));
                    return;
                }
                // DeepSearch: chỉ liệt kê tư liệu + thực thể, tách khỏi Q&A answer
                const ev = d.evidence || [];
                const en = d.entities || [];
                const cites = ev.concat(en);
                if (!cites.length) {
                    el.dataset.dsState = 'nodata';
                    el.innerHTML = _dtDSState('📭', 'Không tìm thấy tư liệu', 'Hệ thống chưa có dữ liệu phù hợp.');
                    return;
                }
                let h = '<div style="font-size:10px;color:var(--da-muted);margin-bottom:8px">'
                    + 'DeepSearch · ' + (d.latency_ms != null ? d.latency_ms + 'ms' : '') + '</div>';
                h += '<div style="font-size:11px;color:var(--da-gold);font-weight:700;margin:6px 0">📚 TƯ LIỆU TÌM THẤY (' + cites.length + ')</div>';
                h += cites.map((c, i) => {
                    const snip = (c.snippet || '').trim();
                    return '<div class="dt-qa-cite">'
                        + '<span style="color:var(--da-gold);font-weight:700">' + _dtQAStateIcon(c.type) + '</span>'
                        + '<div style="min-width:0;flex:1">'
                        +   '<div style="font-size:11px;color:var(--da-text);font-weight:600">' + _dtQACiteLabel(c, i + 1) + '</div>'
                        +   (snip ? '<div style="font-size:10px;color:var(--da-muted);margin-top:2px;line-height:1.6">' + _escHtml(snip.length > 180 ? snip.slice(0, 180) + '…' : snip) + '</div>' : '')
                        + '</div>'
                        + '</div>';
                }).join('');
                el.innerHTML = h;
            })
            .catch(() => {
                el.dataset.dsState = 'error';
                el.innerHTML = _dtDSState('⚠️', 'Không thể kết nối máy chủ',
                    'Hãy thử lại sau. Nếu lỗi tiếp tục, kiểm tra máy chủ app.py.');
            });
        }

        function dtRunQA() {
            const vld = document.getElementById('dt-qa-validation');
            const inp = (document.getElementById('dt-qa-input')||{});
            const q = (inp.value || '').trim();
            const el = document.getElementById('dt-qa-result');
            if (!q) {
                if (vld) vld.style.display = 'block';
                if (el) { el.dataset.qaState = 'idle'; el.innerHTML = _dtDSState('💬', 'Chưa đặt câu hỏi', 'Hãy nhập một câu hỏi để khám phá văn bản và các thực thể liên quan.'); }
                if (inp && inp.focus) inp.focus();
                return;
            }
            if (vld) vld.style.display = 'none';
            if (!el) return;
            if (el.dataset.qaState === 'busy') return; // chống submit trùng
            // T2 (real QA): gọi POST /daoanh/api/daitang/qa — retrieval toàn hệ thống + LLM.
            el.dataset.qaState = 'busy';
            el.innerHTML = _dtDSState('⏳', 'Đang tra cứu…',
                'Tổng hợp dữ liệu Đại Tạng Kinh để trả lời câu hỏi: “' + _escHtml(q) + '”.');
            fetch(baseUrl + '/daoanh/api/daitang/qa', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question: q })
            })
            .then(r => r.json().then(d => ({ http: r.status, d })))
            .then(({ http, d }) => {
                el.dataset.qaState = 'done';
                if (!d || !d.ok) {
                    const errMsg = (d && d.message) || (d && d.error) || 'Lỗi không xác định';
                    el.dataset.qaState = 'nodata';
                    el.innerHTML = _dtDSState('📭', 'Không có kết quả',
                        _escHtml(errMsg) + '<br><span style="font-size:11px">HTTP ' + http + '</span>');
                    return;
                }
                if (d.mode === 'no_data') {
                    el.dataset.qaState = 'nodata';
                    el.innerHTML = _dtDSState('📭', 'Không tìm thấy tư liệu',
                        _escHtml(d.message || 'Chưa có tư liệu liên quan trong hệ thống.'));
                    return;
                }
                _dtRenderQAAnswer(d);
            })
            .catch(() => {
                el.dataset.qaState = 'error';
                el.innerHTML = _dtDSState('⚠️', 'Không thể kết nối máy chủ',
                    'Hãy thử lại sau. Nếu lỗi tiếp tục, kiểm tra máy chủ app.py.');
            });
        }

        function _dtQAStateIcon(type) {
            if (type === 'person') return '👤';
            if (type === 'place') return '📍';
            return '📜';
        }

        function _dtQACiteLabel(c, idx) {
            if (c.type === 'person') {
                return '[' + idx + '] ' + (c.name || '')
                    + (c.name_zh ? ' <span style="font-family:var(--da-font-serif)">(' + _escHtml(c.name_zh) + ')</span>' : '')
                    + (c.dynasty ? ' · ' + _escHtml(c.dynasty) : '')
                    + (c.sect ? ' · ' + _escHtml(c.sect) : '');
            }
            if (c.type === 'place') {
                return '[' + idx + '] ' + (c.name || '')
                    + (c.name_zh ? ' <span style="font-family:var(--da-font-serif)">(' + _escHtml(c.name_zh) + ')</span>' : '')
                    + (c.district ? ' · ' + _escHtml(c.district) : '')
                    + (c.country ? ', ' + _escHtml(c.country) : '');
            }
            const loc = (c.sigla || '') + (c.loc_ref && c.loc_ref !== '0--' ? ' · ' + _escHtml(c.loc_ref) : '');
            return '[' + idx + '] ' + (c.title || c.sigla || '')
                + (loc ? ' <span style="font-family:var(--da-font-mono);font-size:10px;color:var(--da-cyan)">' + _escHtml(loc) + '</span>' : '');
        }

        function _dtRenderQAAnswer(d) {
            const el = document.getElementById('dt-qa-result');
            if (!el) return;
            const ev = d.evidence || [];
            const en = d.entities || [];
            let h = '';
            if (d.mode === 'retrieval_only') {
                h += '<div class="dt-qa-ans">'
                    + '<div style="font-size:10px;color:var(--da-gold);font-weight:700;margin-bottom:6px">⚠️ TRẢ LỜI AI ĐANG TẠM ẨN</div>'
                    + 'Máy chủ trí tuệ nhân tạo chưa phản hồi, nhưng hệ thống vẫn tìm được tư liệu liên quan dưới đây.'
                    + '</div>';
            } else if (d.answer) {
                h += '<div class="dt-qa-ans">' + _escHtml(d.answer) + '</div>';
            }
            if (d.model || d.latency_ms != null) {
                h += '<div style="font-size:10px;color:var(--da-muted);margin:-6px 0 10px">'
                    + _escHtml(d.mode === 'retrieval_only' ? 'retrieval' : (d.model || ''))
                    + (d.latency_ms != null ? ' · ' + d.latency_ms + 'ms' : '')
                    + '</div>';
            }
            const cites = ev.concat(en);
            if (cites.length) {
                h += '<div style="font-size:11px;color:var(--da-gold);font-weight:700;margin:12px 0 6px">📚 TƯ LIỆU LIÊN QUAN (' + cites.length + ')</div>';
                h += cites.map((c, i) => {
                    const snip = (c.snippet || '').trim();
                    return '<div class="dt-qa-cite" onclick="dtQACopy(\'' + _escHtml((c.sigla || c.name || '').toString()) + '\')" title="Nhấn để sao chép nguồn">'
                        + '<span style="color:var(--da-gold);font-weight:700">' + _dtQAStateIcon(c.type) + '</span>'
                        + '<div style="min-width:0;flex:1">'
                        +   '<div style="font-size:11px;color:var(--da-text);font-weight:600">' + _dtQACiteLabel(c, i + 1) + '</div>'
                        +   (snip ? '<div style="font-size:10px;color:var(--da-muted);margin-top:2px;line-height:1.6">' + _escHtml(snip.length > 180 ? snip.slice(0, 180) + '…' : snip) + '</div>' : '')
                        + '</div>'
                        + '</div>';
                }).join('');
            }
            el.innerHTML = h;
        }

        function dtQACopy(txt) {
            navigator.clipboard.writeText(txt).catch(() => {});
        }

        function dtCopyCite(format) {
            const codes = _dtRefs.slice(0,3).map(r=>r.ref_code).filter(Boolean);
            let text = codes.join('; ');
            if (format==='bibtex' && codes.length)
                text = codes.map(c=>'@incollection{'+c+',\n  note={CBETA '+c+'}\n}').join('\n');
            else if (format==='chicago' && codes.length)
                text = codes.map(c=>c+'. In Taishō Shinshū Daizōkyō.').join('\n');
            navigator.clipboard.writeText(text).catch(()=>{});
        }

        function daiTangGoPage(page) {
            const ip = document.getElementById('daitang-input');
            if (!ip) return;
            _daitangPage = page;
            const ct = document.getElementById('daitang-content');
            fetch(baseUrl + '/daoanh/api/entity/' + encodeURIComponent(ip.value) + '/canon?page=' + page + '&page_size=20')
                .then(r => r.json()).then(d => {
                    // Chỉ cập nhật lại Layer B (giữ header + Layer A + C đã có)
                    const pg = d.passages || {};
                    const items = pg.items || [];
                    // Ưu tiên passages đã có bản dịch tiếng Việt lên đầu
                    items.sort((a, b) => (b.has_vi ? 1 : 0) - (a.has_vi ? 1 : 0));
                    window._daitangPassages = items;
                    const list = document.getElementById('daitang-list');
                    if (!list) return;
                    let h = '';
                    items.forEach((p, i) => {
                        const cit = (p.source || '') + ' ' + (p.text_id || '') + (p.loc_ref ? ' · ' + p.loc_ref : '');
                        const prev = (p.raw_text || '').slice(0, 240);
                        h += '<div style="margin-bottom:10px;padding:10px 12px;background:var(--da-card);border:1px solid var(--da-border);border-radius:8px">'
                            + '<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;flex-wrap:wrap">'
                            + _daitangChip('CBETA', 'var(--da-cyan)')
                            + '<span style="font-family:var(--da-font-mono);font-size:10px;color:var(--da-cyan);font-weight:700">' + _escHtml(cit) + '</span>'
                            + (p.has_vi && p.is_translation_draft ? _daitangChip('BẢN DỊCH NHÁP', 'var(--da-gold)') : '')
                            + (p.has_vi && !p.is_translation_draft ? _daitangChip('BẢN DỊCH THAM KHẢO', 'var(--da-green,#4ade80)') : '')
                            + '</div>'
                            + '<div style="display:flex;align-items:center;gap:6px;margin-bottom:5px;flex-wrap:wrap"><span style="font-size:9px;color:var(--da-muted)">passage_id ' + _escHtml(String(p.passage_id)) + '</span><span style="font-size:9px;background:rgba(138,92,8,0.15);color:var(--da-gold);border-radius:4px;padding:1px 6px">evidence: DILA listbibl ↔ passage loc_ref (trang/cột)</span></div>'
