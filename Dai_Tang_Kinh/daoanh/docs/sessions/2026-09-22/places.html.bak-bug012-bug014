            const body = document.getElementById('nmp-detail-body');
            const acts = document.getElementById('nmp-detail-actions');
            if (!det || !title || !body) return;
            det.style.display = 'flex';
            // BUG-010: update left panel for any navigable node (person, place, or unknown)
            if (n.navigable || n.id) openEntityProfileFromNode(n);
            title.textContent = _nexusSafeLabel(n);
            // Phase 2: action buttons — set-as-root for navigable person/place.
            let actHtml = '';
            if (n.navigable && (n.group === 'person' || n.group === 'place')) {
                actHtml += '<button type="button" onclick="_nexusSetRoot({id:\'' + _escHtml(String(n.id)) + '\',group:\'' + n.group + '\',label:\'' + _escHtml(String(n.label || n.id)).replace(/'/g, '\\\'') + '\'})" style="background:none;border:1px solid var(--da-gold);border-radius:4px;color:var(--da-gold);cursor:pointer;font-size:11px;padding:1px 10px;margin-right:6px" title="Set node này làm root Nexus mới">✦ Set làm root</button>';
            }
            if (acts) acts.innerHTML = actHtml;
            const rows = [];
            rows.push('<div><span style="color:var(--da-muted)">ID canonical · </span><span style="font-family:var(--da-font-mono);color:var(--da-gold)">' + _escHtml(String(n.id || '')) + '</span></div>');
            const gname = { person: 'Nhân Vật', place: 'Địa Danh', event: 'Sự Kiện', text: 'Văn Bản', time: 'Mốc Thời' }[n.group] || n.group;
            rows.push('<div><span style="color:var(--da-muted)">Grùp · </span>' + _escHtml(gname) + '</div>');
            if (n.label_zh && n.label_zh !== n.label) {
                rows.push('<div><span style="color:var(--da-muted)">Tên Hán · </span><span style="font-family:var(--da-font-serif)">' + _escHtml(n.label_zh) + '</span></div>');
            }
            rows.push('<div><span style="color:var(--da-muted)">Quan hệ với root · </span>' + _escHtml(d.center.label || d.center.id) + '</div>');
            if (!n.navigable) {
                rows.push('<div style="color:var(--da-warn,#c9a34a);font-style:italic">Relationship chưa kết ID DILA (không navigable).</div>');
            } else if (n.group === 'person') {
                rows.push('<div style="margin-top:4px"><a href="javascript:void(0)" onclick="selectPerson(\'' + _escHtml(String(n.id)) + '\',\'' + _escHtml(String(n.label || n.id)).replace(/'/g, '\\\'') + '\');return false" style="color:var(--da-gold);text-decoration:none">→ Vô tab Truyền Thừa (hô sô nhân)</a></div>');
            } else if (n.group === 'place' && d.entity_type === 'person') {
                rows.push('<div style="margin-top:4px"><a href="javascript:void(0)" onclick="selectItem(\'' + _escHtml(String(n.id)) + '\');return false" style="color:var(--da-green,#4ade80);text-decoration:none">→ Vô tab Bàn Đồ (địa danh)</a></div>');
            }
            rows.push(_nexusDeepLink(n, d));
            // T92-P3: data-quality flag (partial/incomplete badges)
            rows.push(_nexusQualityBadge(n, d));
            // Evidence: edges qua to/from node này
            const evs = (d.edges || []).filter(e => (String(e.from) === String(n.id)) || (String(e.to) === String(n.id)));
            if (evs.length) {
                // T92-P3: group edges by evidence source
                const evBySrc = {};
                evs.forEach(e => {
                    const src = _nexusEvidenceSource(e) || 'KHÁC';
                    if (!evBySrc[src]) evBySrc[src] = [];
                    evBySrc[src].push(e);
                });
                const srcColors = { DILA: '#3a9e6e', CBETA: '#0b7a96', FOSIZHI: '#8b5cf6', 'NGUỒN': '#6a5f4d', 'KHÁC': '#6a5f4d' };
                const srcLabels = { DILA: 'DILA', CBETA: 'CBETA', FOSIZHI: 'FoShiZhi', 'NGUỒN': 'Nguồn khác', 'KHÁC': 'Khác' };
                rows.push('<div style="margin-top:6px"><span style="color:var(--da-muted)">Nguồn bằng chứng · </span></div>');
                Object.keys(evBySrc).forEach(src => {
                    const col = srcColors[src] || '#6a5f4d';
                    const lab = srcLabels[src] || src;
                    const srcEdges = evBySrc[src];
                    const refs = new Set();
                    srcEdges.forEach(e => { if (e.ref) refs.add(String(e.ref)); if (e.citation) refs.add(String(e.citation)); });
                    const refArr = Array.from(refs).slice(0, 4);
                    rows.push('<div style="margin-top:3px;padding-left:8px;border-left:2px solid ' + col + '">'
                        + '<span style="display:inline-flex;align-items:center;gap:3px;background:' + col + '22;border:1px solid ' + col + '44;border-radius:8px;padding:0 6px;font-size:10px;color:' + col + ';margin-bottom:2px">'
                        + _escHtml(lab) + ' (' + srcEdges.length + ')</span>'
                        + (refArr.length ? '<div style="font-size:10px;color:var(--da-dim);margin-top:2px;line-height:1.5">' + refArr.map(r => _escHtml(r)).join('<br>') + '</div>' : '')
                        + '</div>');
                });
                if (evs.length > 8) {
                    rows.push('<div style="font-size:10px;color:var(--da-dim);margin-top:3px">… và ' + (evs.length - 8) + ' cạnh nữa</div>');
                }
            }
            body.innerHTML = rows.join('');
            const close = document.getElementById('nmp-detail-close');
            // Use direct assignment to avoid stacking listeners on re-render.
            if (close) close.onclick = () => { det.style.display = 'none'; };
        }
        function _nexusCloseDetail() {
            const det = document.getElementById('nmp-detail');
            if (det) det.style.display = 'none';
            const acts = document.getElementById('nmp-detail-actions');
            if (acts) acts.innerHTML = '';
        }

        // ——— Phase 3: Evidence source detection (DILA / CBETA / FOSIZHI) ———
        function _nexusEvidenceSource(e) {
            const ref = (e.ref || '').toUpperCase();
            const cit = (e.citation || '').toUpperCase();
            if (ref.includes('CBETA') || cit.startsWith('T') || cit.startsWith('X') || cit.startsWith('J') || /\b(T\d+n\d+|X\d+n\d+|J\d+n\d+)/.test(cit)) return 'CBETA';
            if (ref.includes('FOSIZHI') || ref.includes('FZ') || ref.includes('佛寺志')) return 'FOSIZHI';
            if (ref.includes('DILA') || ref.includes('PL') || ref.includes('daoanh')) return 'DILA';
            if (e.ref) return 'NGUỒN'; // other source
            return '';
        }
        // Tally evidence sources from edges for header badge
        function _nexusEvidenceSummary(edges) {
            const counts = {};
            edges.forEach(e => {
                const src = _nexusEvidenceSource(e);
                if (src) counts[src] = (counts[src] || 0) + 1;
            });
            return counts;
        }
        function _nexusRenderEvidenceSummary(edges) {
            const el = document.getElementById('nmp-evidence-summary');
            if (!el) return;
            const counts = _nexusEvidenceSummary(edges);
            const colors = { DILA: '#3a9e6e', CBETA: '#0b7a96', FOSIZHI: '#8b5cf6', 'NGUỒN': '#6a5f4d' };
            const labels = { DILA: 'DILA', CBETA: 'CBETA', FOSIZHI: 'FoShiZhi', 'NGUỒN': 'Nguồn khác' };
            const parts = Object.keys(counts).sort((a,b) => counts[b] - counts[a]).map(k =>
                '<span style="display:inline-flex;align-items:center;gap:3px;background:' + (colors[k] || '#6a5f4d') + '22;border:1px solid ' + (colors[k] || '#6a5f4d') + '44;border-radius:8px;padding:0 6px;font-size:10px;color:' + (colors[k] || '#6a5f4d') + '">'
                + '<span style="width:6px;height:6px;border-radius:50%;background:' + (colors[k] || '#6a5f4d') + '"></span>'
                + _escHtml(labels[k] || k) + ' ' + counts[k] + '</span>'
            );
            if (parts.length) {
                el.style.display = 'inline-flex';
                el.innerHTML = parts.join('');
            } else {
                el.style.display = 'none';
            }
        }

        // ——— Phase 3: Data-quality flag on detail panel ———
        function _nexusQualityBadge(n, d) {
            const badges = [];
            if (!n.navigable && n.group === 'person') {
                badges.push('<span style="display:inline-flex;align-items:center;gap:3px;background:#f59e0b22;border:1px solid #f59e0b44;border-radius:8px;padding:0 6px;font-size:10px;color:#f59e0b">⚠ Chưa gắn ID DILA</span>');
            }
            if (n.id && String(n.id).startsWith('pers-')) {
                badges.push('<span style="display:inline-flex;align-items:center;gap:3px;background:#ef444422;border:1px solid #ef444444;border-radius:8px;padding:0 6px;font-size:10px;color:#ef4444">⛔ Entity_id NULL (synthetic)</span>');
            }
            // Check if node has no edges (isolated)
            const edgeCount = (d.edges || []).filter(e => String(e.from) === String(n.id) || String(e.to) === String(n.id)).length;
            if (edgeCount === 0) {
                badges.push('<span style="display:inline-flex;align-items:center;gap:3px;background:#6b728022;border:1px solid #6b728044;border-radius:8px;padding:0 6px;font-size:10px;color:#9ca3af">◯ Cô lập (0 cạnh)</span>');
            }
            return badges.length ? '<div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:4px">' + badges.join('') + '</div>' : '';
        }

        // ——— Toggle left sidebar — unified for Nexus + Truyền Thừa tabs ———
        function _toggleMainSidebar() {
            var aside = document.querySelector('aside.pp-sidebar');
            if (!aside) return;
            var btn = document.getElementById('sidebar-toggle-btn');
            var collapsed = aside.classList.contains('sidebar-collapsed');
