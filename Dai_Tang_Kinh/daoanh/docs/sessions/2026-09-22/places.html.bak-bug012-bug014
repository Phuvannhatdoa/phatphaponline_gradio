                    + (on ? 'background:var(--da-gold,#fbbf24);color:#0a1628;'
                         : 'background:var(--da-panel-alt,#1a2540);color:var(--da-dim,#5a6580);border:1px solid var(--da-border,#2a3550);') + '">'
