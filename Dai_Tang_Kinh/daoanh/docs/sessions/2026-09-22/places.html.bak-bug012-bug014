            if (refs.mapped_by) html += `<span style="opacity:.6">· liên kết bằng ${_escHtml(refs.mapped_by)}</span>`;
            html += '</div>';

            if (d.wikidata_error) {
                html += `<div class="da-warn" style="margin-top:8px;font-size:10px">⚠ Wikidata tạm thời không phản hồi: ${_escHtml(d.wikidata_error)}</div>`;
            }

            // ── Nhắc Đến Niên Đại (time_mentions từ DILA raw) ──
            if (timeMentions.length > 0) {
                html += _renderTimeMentions(timeMentions);
            }

            ct.innerHTML = html;
        }

        function _renderTimeMentions(mentions) {
            if (!mentions || mentions.length === 0) return '';
            const precLabel = {
                'exact_day': 'Ngày chính xác', 'month': 'Tháng', 'year': 'Năm',
                'exact_year': 'Năm chính xác', 'year_range': 'Khoảng năm',
                'reign_era': 'Niên hiệu', 'dynasty_period': 'Triều đại',
                'relative': 'Tương đối', 'unknown': 'Chưa xác định'
            };
            const precCls = {
                'exact_day': 'da-chip-ok', 'month': 'da-chip-ok', 'year': 'da-chip-ok',
                'exact_year': 'da-chip-ok', 'year_range': 'da-chip-partial',
                'reign_era': 'da-chip-partial', 'dynasty_period': 'da-chip-partial',
                'relative': '', 'unknown': ''
            };
            let h = '<div style="background:var(--da-card);border:1px solid var(--da-border);border-radius:10px;padding:12px 16px;margin-bottom:12px;margin-top:4px">';
            h += '<div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--da-muted);margin-bottom:8px">Nhắc Đến Niên Đại <span style="font-weight:400;opacity:.6">(DILA raw)</span></div>';
            mentions.forEach(function(m) {
                h += '<div style="padding:5px 0;border-bottom:1px solid var(--da-border)">';
                if (m.raw_time_zh) h += `<span style="font-size:13px;font-weight:600;color:var(--da-text)">${_escHtml(m.raw_time_zh)}</span>`;
                const pl = precLabel[m.precision] || m.precision || '';
                const pc = precCls[m.precision] || 'da-chip-partial';
                if (pl) h += ` <span class="da-chip ${pc}" style="font-size:8px">${_escHtml(pl)}</span>`;
                if (m.normalized_start) {
                    const yr = m.normalized_start < 0 ? `${Math.abs(m.normalized_start)} TCN` : `${m.normalized_start} CE`;
                    h += ` <span style="font-size:11px;color:var(--da-muted)">→ ${yr}</span>`;
                }
                if (m.normalized_end && m.normalized_end !== m.normalized_start) {
                    const yr2 = m.normalized_end < 0 ? `${Math.abs(m.normalized_end)} TCN` : `${m.normalized_end} CE`;
                    h += ` <span style="font-size:10px;color:var(--da-muted)">– ${yr2}</span>`;
                }
                const ml = m.extraction_method === 'regex_rule' ? 'regex'
                    : m.extraction_method === 'authority_mapping' ? 'auth.map'
                    : m.extraction_method || '';
                if (ml) h += ` <span style="font-size:9px;color:var(--da-muted);opacity:.7">· ${_escHtml(ml)}</span>`;
                h += '</div>';
            });
            h += '</div>';
            return h;
        }

        function _renderStaticEvents(events) {
            if (!events || events.length === 0) return '';
            let h = '<div style="background:var(--da-card);border:1px solid var(--da-border);border-radius:10px;padding:12px 16px;margin-bottom:12px">';
            h += '<div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--da-muted);margin-bottom:8px">Sự Kiện Lịch Sử</div>';
            events.forEach(ev => {
                h += '<div style="padding:5px 0;border-bottom:1px solid var(--da-border)">';
                const typeMap = {
                    founding:'Thành lập', dissolved:'Chấm dứt',
                    heritage:'Di sản', renovation:'Trùng tu', destroyed:'Bị phá hủy',
                    admin_context:'Hành chính'
                };
                const typeColor = {founding:'var(--da-accent)', dissolved:'var(--da-muted)'};
                const typeLabel = typeMap[ev.event_type] || ev.event_type || '';
                const yearDisplay = ev.year < 0
                    ? `${Math.abs(ev.year)} TCN`
                    : `${ev.year} CE`;
                const yearStr2 = ev.year
                    ? `<span style="font-size:13px;font-weight:700;color:${typeColor[ev.event_type]||'var(--da-text)'}">${yearDisplay}</span>`
                    : '';
                h += `${yearStr2} <span style="font-size:10px;color:var(--da-muted)">${_escHtml(typeLabel)}</span>`;
                if (ev.label_zh) h += ` <span style="font-size:10px;color:var(--da-text)">${_escHtml(ev.label_zh)}</span>`;
                if (ev.label_vi) h += ` <span style="font-size:10px;color:var(--da-muted)">(${_escHtml(ev.label_vi)})</span>`;
                const srcLabel = ev.source === 'wikidata' ? 'Wikidata·CC0'
                    : ev.source === 'bgis' ? 'BGIS'
                    : ev.source === 'marcus' ? 'Marcus'
                    : ev.source === 'dila_note' ? 'DILA·note'
                    : ev.source === 'dila_era_name' ? 'DILA·年號'
                    : ev.source === 'dila_dynasty' ? 'DILA·朝代'
                    : ev.source || '';
                const isApprox = ev.confidence === 'era_name_midpoint'
                    || ev.confidence === 'dynasty_range';
                const chipCls = (ev.source === 'dila_note' || ev.source === 'dila_era_name'
                    || ev.source === 'dila_dynasty')
                    ? 'da-chip-partial'
                    : ev.confidence === 'verified' ? 'da-chip-ok' : 'da-chip-partial';
                const approxSuffix = isApprox ? '~' : '';
                h += ` <span class="da-chip ${chipCls}" style="font-size:8px">${approxSuffix}${_escHtml(srcLabel)}</span>`;
                h += '</div>';
            });
            h += '</div>';
            return h;
        }

        // State E — record có evidence/nhãn nhưng thiếu year để đặt trên trục.
        function _renderUndatedEvents(events) {
