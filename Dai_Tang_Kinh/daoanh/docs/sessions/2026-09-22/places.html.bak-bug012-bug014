                    + '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap"><button id="da-daitang-reader-dich" style="font-size:11px;color:#000;background:var(--da-gold,#ad7c1c);border:none;border-radius:4px;padding:4px 10px;cursor:pointer;font-weight:700">🤖 Dịch (AI)</button><button id="da-daitang-reader-copy" style="font-size:11px;color:var(--da-cyan);background:none;border:1px solid var(--da-cyan);border-radius:4px;padding:4px 10px;cursor:pointer">📋 Sao chép dẫn chiếu</button><button id="da-daitang-reader-report" style="font-size:11px;color:var(--da-muted);background:none;border:1px solid var(--da-border);border-radius:4px;padding:4px 10px;cursor:pointer">⚑ Báo sai đoạn văn</button></div>';
