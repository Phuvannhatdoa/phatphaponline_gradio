                        });
                    }
                    addUniq(d.persons, 'Tổng hợp');
                    addUniq(d.bibl_persons, 'Thư tịch');
                    addUniq((d.bio_persons || []).filter(function(p){ return p.is_direct; }), 'Tiểu sử');
