            ct.innerHTML = html;

            // Async: populate Người Sáng Lập + Liên Quan từ related API
            fetch(baseUrl + '/daoanh/api/entity/' + encodeURIComponent(ent.id) + '/related')
                .then(r => r.json())
                .then(rd => _dtRenderLeftRelated(rd, ent))
                .catch(() => {
                    const el = document.getElementById('dt-left-founders');
                    if (el) el.innerHTML = '<div class="da-block-label">👤 NGƯỜI SÁNG LẬP</div><div class="da-warn">Không tải được dữ liệu quan hệ.</div>';
