        // ── _renderGraphMainPanel: 3-node default view (redesign) ──
        function _renderGraphMainPanel(d, rerender) {
            const ph       = document.getElementById('gmp-placeholder');
            const body     = document.getElementById('gmp-body');
            const nameVi   = document.getElementById('gmp-name-vi');
            const nameZh   = document.getElementById('gmp-name-zh');
            const idEl     = document.getElementById('gmp-id');
            const nearbyEl = document.getElementById('gmp-nearby');
            const canvas   = document.getElementById('gmp-canvas');
            const fallback = document.getElementById('gmp-fallback');
            const mFallback= document.getElementById('gmp-mobile-fallback');
            if (!ph || !body || !canvas) return;
            if (!d || !d.ok || !d.center) {
                ph.style.display = 'flex'; body.style.display = 'none'; return;
            }
            ph.style.display = 'none'; body.style.display = 'flex';

            // ── Header ──
            const lvi = d.center.label || '';
            const lzh = d.center.label_zh || '';
            if (nameVi) nameVi.textContent = lvi;
            if (nameZh) nameZh.textContent = (lzh && lzh !== lvi) ? lzh : '';
            if (idEl)   idEl.textContent   = d.center.id || '';

            // ── Alias chips HTML overlay ──
            _gmpRenderAliasChips(d);

            // ── Nearby places strip ──
            const centerId = d.center.id;
            const seenIds2 = new Set([centerId]);
            const allNodes2 = (d.nodes || []).filter(n => { if (seenIds2.has(n.id)) return false; seenIds2.add(n.id); return true; });
            const nearbyNodes = allNodes2.filter(n => n.group === 'place');
            if (nearbyEl) {
                if (nearbyNodes.length && _graphFilters.place) {
                    nearbyEl.style.display = 'block';
                    nearbyEl.innerHTML =
                        '<span style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--da-muted);margin-right:8px">Địa Danh Lân Cận · ' + nearbyNodes.length + '</span>' +
                        nearbyNodes.map(n =>
                            '<span onclick="selectItem(\'' + _escHtml(n.id) + '\')" style="cursor:pointer;display:inline-block;font-size:11px;background:var(--da-card,#1a1a2e);border:1px solid var(--da-border);border-radius:12px;padding:1px 10px;margin:0 3px;color:var(--da-text)">' +
                            _escHtml(n.label || n.label_zh || n.id) + '</span>'
                        ).join('');
                } else {
                    nearbyEl.style.display = 'none';
                }
            }

            // ── Relationship table (đầy đủ tất cả node) ──
            const fullNodeIndex = {};
            allNodes2.forEach(n => { fullNodeIndex[n.id] = n; });

            // ── Update filter chip counts ──
            const textNodes   = (d.nodes || []).filter(n => n.group === 'text');
            const personNodes = (d.nodes || []).filter(n => n.group === 'person');
            const _setChipCount = (id, count, label) => {
                const el2 = document.getElementById(id);
                if (el2) el2.textContent = label + ' (' + count + ')';
            };
            _setChipCount('gf-text',   textNodes.length,    'Kinh điển');
            _setChipCount('gf-person', personNodes.length,  'Tăng nhân');
            _setChipCount('gf-place',  nearbyNodes.length,  'Địa danh');
            _setChipCount('gf-alias',  (d.alt_names || []).length, 'Tên thay thế');

            // ── Destroy existing network ──
            if (_graphNetwork) { _graphNetwork.destroy(); _graphNetwork = null; }
            _graphDataset = null;

            // ── Mobile fallback ──
            const isMobile = window.innerWidth < 768;
            if (isMobile) {
                canvas.style.display = 'none';
                if (fallback) fallback.style.display = 'none';
                _gmpMobileFallback(d);
                return;
            }
            if (mFallback) mFallback.style.display = 'none';
            canvas.style.display = 'block';

            const worksCount   = textNodes.length;
            const personsCount = personNodes.length;

            // ── Build 3-node default DataSet ──
            const visNodes = new vis.DataSet([{
                id: 'root',
                label: _fmtName(lvi, lzh),
                shape: 'box', level: 0,
                font: { size: 14, bold: true, color: '#1a1a28' },
                color: { background: '#c8a96e', border: '#8b6914' },
                widthConstraint: { minimum: 140, maximum: 200 },
                title: 'Thực thể trung tâm: ' + (lvi || lzh || centerId)
            }]);
            const visEdges = new vis.DataSet([]);

            if (worksCount > 0) {
                visNodes.add({
                    id: 'group-works',
                    label: 'Kinh điển · ' + worksCount,
                    shape: 'box', level: -1,
                    color: { background: '#2d4a6b', border: '#4a7db5' },
                    font: { color: '#ffffff', size: 12 },
                    title: 'Click để xem kinh điển',
                    group: 'works-summary'
                });
                visEdges.add({ id: 'edge-root-works', from: 'root', to: 'group-works',
                    arrows: '', dashes: false, width: 2,
                    color: { color: '#4a7db5', highlight: '#4a7db5' } });
            }

            if (personsCount > 0) {
                visNodes.add({
                    id: 'group-persons',
                    label: 'Tăng nhân · ' + personsCount,
                    shape: 'box', level: 1,
                    color: { background: '#4a2d6b', border: '#7b4ab5' },
                    font: { color: '#ffffff', size: 12 },
                    title: 'Click để xem tăng nhân theo nguồn',
                    group: 'persons-summary'
                });
                visEdges.add({ id: 'edge-root-persons', from: 'root', to: 'group-persons',
                    arrows: '', dashes: false, width: 2,
                    color: { color: '#7b4ab5', highlight: '#9b6ad5' } });
            }

            if (worksCount === 0 && personsCount === 0) {
                if (fallback) fallback.style.display = 'flex'; return;
            }
            if (fallback) fallback.style.display = 'none';

            _graphDataset = { nodes: visNodes, edges: visEdges };

            _graphNetwork = new vis.Network(canvas, { nodes: visNodes, edges: visEdges }, {
                layout: { hierarchical: { enabled: true, direction: 'LR', sortMethod: 'directed',
                    levelSeparation: 220, nodeSpacing: 80, treeSpacing: 60 } },
                physics: { enabled: false },
                interaction: { hover: true, tooltipDelay: 120, zoomView: true, dragView: true },
                nodes: { borderWidth: 1 },
                edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
            });

            // Save positions then disable hierarchical so expand adds nodes without global relayout
            setTimeout(() => {
                if (!_graphNetwork) return;
                _positionCache = _graphNetwork.getPositions();
                _graphNetwork.setOptions({ layout: { hierarchical: { enabled: false } } });
            }, 80);

            _graphNetwork.on('click', function(params) {
                if (!params.nodes.length) {
                    // Edge click — show ref info
                    if (params.edges.length && _graphDataset) {
                        const eid = params.edges[0];
                        const ve  = _graphDataset.edges.get(eid);
                        if (ve && ve.label) {
                            const panel = document.getElementById('gmp-detail');
                            const body2 = document.getElementById('gmp-detail-body');
                            if (panel && body2) {
                                body2.innerHTML = '<div style="font-size:11px;color:var(--da-muted)">Quan hệ: ' + _escHtml(ve.label || '—') + '</div>';
                                panel.style.display = 'block';
                            }
                        }
                    }
                    return;
                }
                const nodeId = params.nodes[0];
                if (nodeId === 'root') { _gmpCloseDetail(); return; }

                if (nodeId === 'group-works') {
                    _gmpExpandWorks(d, _graphDataset);
                } else if (nodeId === 'group-persons') {
                    _gmpExpandPersons(d, _graphDataset);
                } else if (('' + nodeId).startsWith('subgroup-')) {
                    _gmpExpandSubgroup(nodeId, d, _graphDataset);
                } else {
                    // Find raw node for detail panel
                    const rawId = ('' + nodeId).replace(/^(work-|person-)/, '');
                    const dsNode = _graphDataset && _graphDataset.nodes.get(nodeId);
                    const n = (d.nodes || []).find(x => x.id === rawId || x.id === nodeId)
                        || (dsNode && dsNode._rawNode)
                        || (dsNode ? { id: nodeId, label: dsNode.label, group: 'person' } : null);
                    if (n) {
                        // Highlight relation row
                        document.querySelectorAll('.gmp-relrow').forEach(r => r.classList.remove('highlighted'));
                        const row = document.querySelector('.gmp-relrow[data-node-id="' + rawId + '"]');
                        if (row) { row.classList.add('highlighted'); row.scrollIntoView({ block: 'nearest' }); }
                        _gmpShowNodeDetail(n, d.center);
                    }
                }
            });

            setTimeout(() => {
                if (_graphNetwork) { _graphNetwork.redraw(); _graphNetwork.fit({ animation: false }); }
            }, 80);
        }

        // Truyền Thừa tab — person-only graph (Marcus teacher/student lineage).
        // ── Truyền Thừa tab — LINEAGE RESEARCH WORKSPACE (T86) ──────────────────────
        // Data 100% real từ Marcus SNA qua /daoanh/api/monk/<id>/lineage-tree.
        // 3 cột: sidebar (filter/search) · canvas (3 view-modes) · inspector (node/edge)
        // + drawer bằng chứng. Không bịa dữ liệu — thiếu thì ghi rõ "Cần khảo cứu".
        let _lineageState = null;       // {d, up, down, mode, zoom, edges(expanded), nodes}
        let _lineageNetwork = null;     // vis network (mode=network only)
        let _lineagePanel = null;       // current HTML of tree/timeline

        function _esc(v){ return v == null ? '' : String(v); }
        function _t86Years(b, d2){
            if (b && d2) return b + ' – ' + d2;
            if (b) return 'sinh ' + b;
            if (d2) return 'mất ' + d2;
            return 'Niên đại chưa rõ';
        }
        // FIX 1 — Global formatter: Việt/Hán-Việt trước, Hán sau
        // Rule: không render "undefined ()", "null ()", hoặc ngoặc rỗng
        function _fmtName(name_vi, name_zh) {
            const vi = (name_vi || '').trim();
            const zh = (name_zh || '').trim();
            if (!vi && !zh) return '';
            if (vi && zh && vi !== zh) return vi + ' (' + zh + ')';
            if (vi) return vi;
            return zh;
        }
        function _t86NodeLabel(n){
            // Prefer TTL verified formal name when available
            if (n.display_name && n.display_name.is_formal_name && n.display_name.primary)
                return n.display_name.primary;
            return _fmtName(n.name_vi, n.name_zh) || n.id;
        }

        // T140: AbortController chống race click A→B→C (loadLineageTree / centerLineageOn không abort trước đó)
        let _linLoadCtrl = null;
        function _linLoadAbort() { if (_linLoadCtrl) { _linLoadCtrl.abort(); _linLoadCtrl = null; } }

        // T152: Ancestor Spine — chuỗi tổ sư ĐẦY ĐỦ từ focus ngược lên đầu mạch (KHÔNG cắt ở 2/3 đời).
        // fetch /ancestor-spine (server đi bộ teacher-chain tới hết, lọc rejected, safety 80 hops)
        // → merge các node/edge chưa có vào st.nodes/st.edges → renderer vẽ trọn chuỗi.
        // break_reason: 'root' (hết thầy) | 'rejected' (mạch thiếu cạnh xác minh) | 'safety' (giới hạn hops).
        async function _lineageMergeAncestorSpine(pid) {
            const st = _lineageState;
            if (!st || !st.d || !pid) return;
            let sp = null;
            try {
                const r = await fetch('/daoanh/api/monk/' + encodeURIComponent(pid) + '/ancestor-spine?max_hops=80');
                sp = await r.json();
            } catch (e) { sp = null; }
            if (!sp || !sp.ok) { st._spine = { break_reason: 'error', ancestors: [], has_more_up: false }; return; }
            const nm = st.nodes || (st.nodes = {});
            const es = st.edges || (st.edges = []);
            let changed = false;
            (sp.nodes || []).forEach(n => { if (n && n.id && !nm[n.id]) { nm[n.id] = n; changed = true; } });
            (sp.edges || []).forEach(e => {
                if (e && e.from && e.to) {
                    const dup = es.some(x => x.from === e.from && x.to === e.to && x.direction === e.direction);
                    if (!dup) { es.push(e); changed = true; }
                }
            });
            st._spine = { break_reason: sp.break_reason, ancestors: sp.ancestors || [], has_more_up: !!sp.has_more_up, hops: sp.hops || 0, centerId: pid };
            if (changed) {
                st._labelCompact = undefined;
                if (st.mode === 'tree') _renderLineageChain(); else if (st.mode === 'network') _renderLineageNetwork();
            }
        }

        async function loadLineageTree(dilaId) {
            _linLoadAbort();
            const ctrl = new AbortController(); _linLoadCtrl = ctrl;
            const ph = document.getElementById('lineage-placeholder');
            const ct = document.getElementById('lineage-content');
            const emptyBox = document.getElementById('lineage-empty');
            const canvas = document.getElementById('lineage-canvas');
            const inspector = document.getElementById('lineage-inspector');
            // Ẩn picker (đã ở sidebar), hiện filters/search, hiện inspector cho cây
            const pickerPanel = document.getElementById('lineage-picker-panel');
            if (pickerPanel) pickerPanel.style.display = 'none';
            if (inspector) inspector.style.display = 'flex';
            ph.style.display = 'none'; ct.style.display = 'block';
            emptyBox.style.display = 'none'; canvas.style.display = 'block';
            if (_lineageNetwork) { _lineageNetwork.destroy(); _lineageNetwork = null; }
            _lineageState = { d: null, up: 6, down: 6, mode: 'tree', zoom: 1, _labelCompact: undefined,
                              selectedNode: null, selectedEdge: null, nodes: {}, edges: [], _spine: null };
            document.getElementById('lineage-inspector-body').innerHTML = 'Đang tải...';
            const evEl = document.getElementById('lineage-inspector-evidence');
            if (evEl) evEl.innerHTML = '<span style="color:var(--da-muted)">— Chưa có dữ liệu nguồn cho mục hiện tại.</span>';
            document.getElementById('lineage-sidebar-title').innerText = 'Pháp hệ · đang tải';
            document.getElementById('lineage-drawer').style.display = 'none';
            const hdrEl = document.getElementById('lineage-header');
            if (hdrEl) hdrEl.innerHTML = '<span style="color:var(--da-muted)">Pháp hệ</span> <span style="color:var(--da-gold,#e6b422)">›</span> <strong style="color:var(--da-dim)">đang tải…</strong>';
            try {
                const res = await fetch('/daoanh/api/monk/' + encodeURIComponent(dilaId) + '/lineage-tree?up=6&down=6', { signal: ctrl.signal });
                const d = await res.json();
                if (ctrl.signal.aborted) return;
                if (!d.ok || res.status === 404) { ct.style.display='none'; ph.style.display=''; ph.innerHTML = 'Không tìm thấy tăng nhân này.'; _linLoadCtrl = null; return; }
                _lineageState.d = d;
                _lineageState.up = d.up; _lineageState.down = d.down;
                const nm = {}; (d.nodes||[]).forEach(n => nm[n.id] = n);
                _lineageState.nodes = nm;
                _lineageState.edges = (d.edges||[]).slice();
                _lineageState._spine = null;
                _lineageMergeAncestorSpine(dilaId);   // T152: bổ sung chuỗi tổ sư → đầu mạch
                _renderLineageHeader();
                if (!(d.edges||[]).length) {
                    emptyBox.style.display = 'block';
                    canvas.style.display = 'none';
                    _t86EnableModeBtns();
                    document.getElementById('lineage-sidebar-title').innerText = 'Pháp hệ · ' + _t86NodeLabel(d.center);
                    _renderLineageInspector(d.center.id);
                    _linLoadCtrl = null;
                    return;
                }
                _renderLineageSidebar();
                _renderLineageMode('tree');
                _renderLineageInspector(d.center.id);
                _linLoadCtrl = null;
            } catch(e) {
                if (ctrl.signal.aborted) return;
                ct.style.display='none'; ph.style.display=''; ph.innerHTML = '⚠ Lỗi tải pháp hệ: ' + _escHtml(e && e.message ? e.message : e);
                _linLoadCtrl = null;
            }
        }

        // T87 — Truyền Thừa trong ngữ cảnh ĐỊA ĐIỂM (Place → Person → Tree).
        // Khi đang ở tab Truyền Thừa với 1 địa danh, hiện bộ chọn tăng nhân liên kết với
        // địa danh đó (nguồn: place_person_link curate + bibl + origin + bio). Click vào
        // một tăng nhân có truyền thừa → selectPerson() → workspace truyền thừa 3 cột của T86.
        async function loadPlaceLineagePicker(placeId) {
            const ph = document.getElementById('lineage-placeholder');
            const ct = document.getElementById('lineage-content');
            const pickerPanel = document.getElementById('lineage-picker-panel');
            const emptyBox = document.getElementById('lineage-empty');
            const canvas = document.getElementById('lineage-canvas');
            const inspector = document.getElementById('lineage-inspector');
            const inspectorBody = document.getElementById('lineage-inspector-body');
            const drawer = document.getElementById('lineage-drawer');
            const lineageMain = document.getElementById('lineage-main-panel');
            // Ẩn placeholder, ẩn content (filters/search), hiện picker panel
            if (ph) ph.style.display = 'none';
            if (ct) ct.style.display = 'none';
            if (emptyBox) emptyBox.style.display = 'none';
            if (drawer) drawer.style.display = 'none';
            if (pickerPanel) { pickerPanel.style.display = 'block'; pickerPanel.innerHTML = '<div style="padding:16px 14px;font-size:12px;color:var(--da-muted)">Đang tải nhân vật liên quan...</div>'; }
            // Hiện main panel, canvas = prompt, ẩn inspector (chưa cần khi đang chọn)
            if (lineageMain) lineageMain.style.display = 'flex';
            if (inspector) inspector.style.display = 'none';
            canvas.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:12px;color:var(--da-muted);font-size:13px;text-align:center;padding:24px">' +
                '<span style="font-size:40px">🌳</span>' +
                '<div style="font-size:15px;font-weight:700;color:var(--da-text)">Pháp Mạch Truyền Thừa</div>' +
                '<div>Chọn 1 tăng nhân từ danh sách bên trái<br>để vẽ cây phả hệ tại đây.</div>' +
                '<div style="font-size:11px;margin-top:4px">Người có <span style="color:var(--da-gold,#e6b422);font-weight:700">🌳 TRUYỀN THỪA</span> có dữ liệu pháp hệ Marcus.</div>' +
                '</div>';
            if (_lineageNetwork) { _lineageNetwork.destroy(); _lineageNetwork = null; }
            // Vô hiệu hoá tạm các nút chế độ (chỉ dùng sau khi chọn được tăng nhân)
            document.querySelectorAll('#lineage-mode .lineage-mode-btn').forEach(b => {
                b.disabled = true; b.style.opacity = '0.5'; b.style.cursor = 'not-allowed';
            });
            try {
                const res = await fetch('/daoanh/api/places/' + encodeURIComponent(placeId) + '/persons');
                const d = await res.json();
                if (!d.ok) { canvas.innerHTML = '<div class="da-warn" style="margin:16px">⚠ Lỗi tải dữ liệu nhân vật.</div>'; inspectorBody.innerHTML = 'Chưa có dữ liệu.'; return; }
                // Gộp các nguồn có DILA ID (bỏ wikidata — chưa gắn DILA)
                const groups = [
                    { key: 'curated', label: 'Đã xác minh (admin curate)', list: d.persons || [] },
                    { key: 'bibl',     label: 'Nguồn kinh văn (CBETA bibl)', list: d.bibl_persons || [] },
                    { key: 'origin',   label: 'Quê quán / sinh tại', list: d.origin_persons || [] },
                    { key: 'bio',      label: 'DILA Tiểu Sử (tự động)', list: d.bio_persons || [] }
                ].map(g => ({ ...g, list: (g.list || []).filter(p => p && p.id) }));
                const allPersons = groups.reduce((a, g) => a.concat(g.list), []);
                const hasAny = allPersons.length > 0;
                const hasLineageAny = allPersons.some(p => p.has_lineage);
                if (!hasAny) {
                    if (pickerPanel) pickerPanel.innerHTML =
                        '<div style="padding:14px 14px"><div class="da-warn" style="display:block">' +
                        '⚠ Chưa có dữ liệu nhân vật cho địa danh này (Cần khảo cứu)</div>' +
                        '<p style="font-size:11px;color:var(--da-muted);line-height:1.7;margin-top:10px">' +
                        _escHtml(d.message || 'Xem tab 🧑 Nhân Vật để duyệt hướng nghiên cứu hay gắn tăng nhân qua nguồn có dẫn chứng.') + '</p></div>';
                    return;
                }
                let html = '<div style="padding:10px 12px 0">';
                html += '<div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:2px">';
                html += '<div style="font-size:13px;font-weight:800;color:var(--da-text)">Nhân vật tại địa danh</div>';
                html += '<div style="font-size:10px;color:var(--da-muted)">' + allPersons.length + ' người · ' +
                    (hasLineageAny ? '<span style="color:var(--da-gold,#e6b422)">' + allPersons.filter(p=>p.has_lineage).length + ' có truyền thừa</span>'
                                   : 'không ai có truyền thừa') + '</div>';
                html += '</div>';
                html += '<div style="font-size:10px;color:var(--da-dim);line-height:1.5;margin-bottom:8px">' +
                        (hasLineageAny ? 'Người có 🌳 TRUYỀN THỪA mới hiển thị pháp hệ.' :
                        'Không tăng nhân nào có dữ liệu pháp hệ Marcus.') + '</div>';
                groups.forEach(g => {
                    if (!g.list.length) return;
                    html += '<div style="margin:10px 0 4px;font-size:9.5px;font-weight:700;color:var(--da-muted);text-transform:uppercase;letter-spacing:.05em">' + _escHtml(g.label) + ' (' + g.list.length + ')</div>';
                    html += g.list.map(p => _personPickerRow(p)).join('');
                });
                html += '</div>';
                if (pickerPanel) pickerPanel.innerHTML = html;
            } catch (e) {
                if (pickerPanel) pickerPanel.innerHTML = '<div class="da-warn" style="margin:14px">⚠ Lỗi tải: ' + _escHtml(e && e.message ? e.message : e) + '</div>';
            }
        }

        function _personPickerRow(p) {
            const displayName = p.name_vi || p.name_zh || p.id;
            const altName = (p.marcus_label && p.marcus_label !== displayName) ? p.marcus_label : null;
            const flag = p.has_lineage
                ? '<span class="da-nexus-badge" style="margin-left:4px">🌳 TRUYỀN THỪA</span>'
                : '<span style="margin-left:6px;font-size:9px;color:var(--da-muted)">Cần khảo cứu</span>';
            return '<div class="da-person-row" style="align-items:flex-start;cursor:' + (p.has_lineage ? 'pointer' : 'default') +
                ';opacity:' + (p.has_lineage ? '1' : '0.7') + '"' +
                (p.has_lineage ? ' data-pid="' + p.id + '" data-pname="' + _escHtml(displayName) + '" onclick="selectPerson(this.dataset.pid, this.dataset.pname)"' : '') + '>' +
                '<div class="da-person-avatar" style="opacity:' + (p.has_lineage ? '1' : '0.5') + '">' + _escHtml((p.name_zh || '⛔')[0]) + '</div>' +
                '<div style="flex:1;min-width:0">' +
                '<div class="da-person-name-vi">' + _escHtml(displayName) +
                    (altName ? ' <span style="font-size:10px;color:var(--da-muted)">(' + _escHtml(altName) + ')</span>' : '') +
