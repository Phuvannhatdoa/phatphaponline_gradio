function loadTabData(tab, placeId) {
            const key = tab + ':' + placeId;
            _tabLoaded[key] = true;
            // 'lineage' is the only tab meaningful in person mode; 'graph'/'persons'/
            // 'cbeta'/'timeline'/'daitang' are place-only.
            if (_currentEntityType === 'person' && tab !== 'lineage' && tab !== 'nexus') {
                const ph = document.getElementById(tab + '-placeholder');
                if (ph) ph.textContent = 'Không áp dụng cho tăng nhân — xem tab 🌳 Truyền Thừa.';
                return;
            }
            if (_currentEntityType === 'place' && tab === 'lineage') {
                loadPlaceLineagePicker(placeId);
                return;
            }
            if (tab === 'entity' || tab === 'cbeta') {
                fetch(baseUrl + '/daoanh/api/places/' + placeId + '/cbeta')
                    .then(r => r.json()).then(renderCbetaTab).catch(() => {});
            } else if (tab === 'daitang') {
                fetch(baseUrl + '/daoanh/api/entity/' + encodeURIComponent(placeId) + '/canon')
                    .then(r => r.json()).then(renderDaiTangTab).catch(() => {
                        const ct = document.getElementById('daitang-content');
                        const ph = document.getElementById('daitang-placeholder');
                        if (ph) ph.style.display = 'none';
                        if (ct) { ct.style.display = 'block'; ct.innerHTML = '<div class="da-warn">⚠ Lỗi tải dữ liệu Đại Tạng.</div>'; }
                    });
            } else if (tab === 'graph') {
                // Use cached data if same entity (avoid re-fetch on tab switch)
                if (_graphData && _graphData.center && _graphData.center.id === placeId) {
                    renderGraphTab(_graphData);
                } else {
                    fetch(baseUrl + '/daoanh/api/places/' + placeId + '/graph')
                        .then(r => r.json()).then(renderGraphTab)
                        .catch(() => { renderGraphTab({ ok: false }); });
                }
            } else if (tab === 'persons') {
                fetch(baseUrl + '/daoanh/api/places/' + placeId + '/persons')
                    .then(r => r.json()).then(renderPersonsTab).catch(() => {});
            } else if (tab === 'lineage') {
                if (_currentEntityType !== 'person') {
                    const ph = document.getElementById('lineage-placeholder');
                    if (ph) { ph.style.display = ''; ph.textContent = 'Chọn 1 tăng nhân ở tab 🧑 Nhân Vật để xem phả hệ truyền thừa.'; }
                } else {
                    loadLineageTree(placeId);
                }
            } else if (tab === 'nexus') {
                // Nexus hoạt động cho cả địa danh lẫn tăng nhân (event-centric).
                const entType = _currentEntityType || 'place';
                fetch(baseUrl + '/daoanh/api/nexus/' + encodeURIComponent(placeId) + '?type=' + entType)
                    .then(r => r.json()).then(renderNexusTab).catch(() => {});
            } else if (tab === 'timeline') {
                loadTimelineTab(placeId);
            } else if (tab === 'giaoly') {
                renderGiaolyTab({ placeId: placeId });
            } else if (tab === 'thuvien') {
                renderThuvienTab(placeId);
            } else if (tab === 'nghile') {
                renderNghileTab(placeId);
            } else if (tab === 'giaoduc') {
                renderGiaoducTab(placeId);
            } else if (tab === 'sukien') {
                loadSukienTab(placeId);
            } else if (tab === 'bandoo') {
                renderBandooTab(_currentGps);
            } else if (tab === 'dulieu') {
                renderDulieTab(placeId);
            } else if (tab === 'hinhanh') {
                renderHinhanhTab(placeId);
            } else if (tab === 'nghethuat') {
                renderNghethuatTab(placeId);
            } else if (tab === 'entities') {
