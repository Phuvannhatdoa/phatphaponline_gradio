        function _lineageSccEdges() {
            // Tarjan SCC trên st.edges → cạnh thuộc SCC thật (size>1) hoặc self-loop = cạnh chu trình.
            const st = _lineageState, idx = {}, low = {}, on = new Set(), stk = [], scc = {};
            let I = 0, cid = 0;
            const adj = {};
            (st.edges || []).forEach(e => { (adj[e.from] = adj[e.from] || []).push(e.to); });
            // sinh label cho node không có trong st.nodes (edge lạ) — chỉ đếm reachable
            const strong = (u) => {
                idx[u] = low[u] = I++;
                stk.push(u); on.add(u);
                (adj[u] || []).forEach(v => {
                    if (idx[v] === undefined) { strong(v); low[u] = Math.min(low[u], low[v]); }
                    else if (on.has(v)) low[u] = Math.min(low[u], idx[v]);
                });
                if (low[u] === idx[u]) {
                    let sz = 0;
                    for (;;) { const w = stk.pop(); on.delete(w); scc[w] = cid; sz++; if (w === u) break; }
                    if (sz === 1) scc[u + '_solo'] = cid; // đánh dấu; không dùng
                    cid++;
                }
            };
            Object.keys(adj).forEach(u => { if (idx[u] === undefined) strong(u); });
