        function doPersonTranslate(pid, btn) {
            btn.disabled = true;
            btn.textContent = '⏳ Đang dịch…';
            var slot = btn.parentElement;
            function _showBio(txt) {
                slot.innerHTML = '<div style="font-size:9px;color:var(--da-muted);margin-top:3px;line-height:1.4">'
                    + _escHtml(txt.length > 150 ? txt.slice(0,150)+'…' : txt) + '</div>';
            }
            // Gọi dila_translate (dịch toàn bộ DILA card, lưu vào DB để admin xem được)
            fetch('/daoanh/api/person/' + encodeURIComponent(pid) + '/dila_translate', {method: 'POST'})
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d.ok) {
                        var vi = d.vi || {};
                        _showBio(vi.bio_concise_vi || vi.bio_extensive_vi || '');
                        return;
                    }
                    // Fallback: không có DILA XML → dùng bio-only translate
                    return fetch('/daoanh/api/person/' + encodeURIComponent(pid) + '/translate', {method: 'POST'})
                        .then(function(r2) { return r2.json(); })
                        .then(function(d2) {
                            if (!d2.ok) {
                                btn.textContent = '⚠ ' + (d2.error || 'Lỗi');
                                btn.disabled = false;
                                return;
                            }
                            _showBio(d2.bio_vi || '');
                        });
                })
                .catch(function() {
                    btn.textContent = '⚠ Lỗi kết nối';
                    btn.disabled = false;
                });
        }

        function loadTimelineTab(placeId) {
            const ph = document.getElementById('timeline-placeholder');
            const ct = document.getElementById('timeline-content');
            if (ph) { ph.style.display = 'none'; }
            if (ct) { ct.style.display = 'block'; ct.innerHTML = '<div style="font-size:11px;color:var(--da-muted);padding:14px;">Đang tải dữ liệu niên đại…</div>'; }
            const _base = baseUrl + '/daoanh/api/places/' + encodeURIComponent(placeId);
            Promise.all([
                fetch(_base + '/timeline').then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }),
                fetch(_base + '/time-mentions').then(function(r) { return r.ok ? r.json() : { mentions: [] }; }).catch(function() { return { mentions: [] }; })
            ])
            .then(function(results) { renderTimelineTab(results[0], placeId, results[1].mentions || []); })
            .catch(function() { renderTimelineError(placeId); });
        }

        // Short helper: "Đang tải..." hoặc chuỗi rỗng → không phải tên thật.
        function _timelineHeaderName() {
            const nv = document.getElementById('itemNameVi');
            if (!nv) return null;
            const raw = (nv.innerText || '').trim();
            if (!raw || raw === 'Đang tải...' || raw === 'Đang tải dữ liệu...' || raw === '—') return null;
            return raw;
        }

        function renderTimelineError(placeId) {
            const ct = document.getElementById('timeline-content');
            if (!ct) return;
            const name = _timelineHeaderName();
            let idLine = '';
            if (placeId) idLine = `<div style="font-size:10px;color:var(--da-muted);margin-top:2px">${_escHtml(placeId)}</div>`;
            ct.innerHTML =
                '<div style="background:var(--da-card);border:1px solid var(--da-border);border-radius:10px;padding:16px;margin-top:4px">' +
                '<div style="font-size:13px;font-weight:700;color:var(--da-text)">Niên đại lịch sử</div>' +
                (name ? `<div style="font-size:11px;color:var(--da-muted);margin-top:2px">Đang xem: ${_escHtml(name)}</div>` : '') +
                idLine +
                '<div class="da-warn" style="margin-top:12px">Không thể tải dữ liệu niên đại. Hãy thử lại.</div>' +
                '<button class="da-stab" style="margin-top:10px;font-size:12px" onclick="loadTimelineTab(' +
                (placeId ? `'${placeId.replace(/[^A-Za-z0-9]/g, '')}'` : '_currentPlaceId') +
                ')">Thử lại</button>' +
                '</div>';
        }

        function renderTimelineTab(d, placeId, timeMentions) {
            timeMentions = timeMentions || [];
            const ph = document.getElementById('timeline-placeholder');
            const ct = document.getElementById('timeline-content');
            if (ph) ph.style.display = 'none';
            ct.style.display = 'block';

            const ctxId = placeId || _currentPlaceId || null;
            const ctxName = _timelineHeaderName() || null;

            // Header — luôn hiện khi có context place (đã chọn địa danh).
            let html = '';
            if (ctxId) {
                html += '<div style="border-left:3px solid var(--da-accent,#d97706);padding:2px 0 2px 12px;margin:4px 0 14px">';
                html += '<div style="font-size:15px;font-weight:800;color:var(--da-text)">Niên đại lịch sử</div>';
                html += `<div style="font-size:11px;color:var(--da-muted);margin-top:2px">Đang xem: ${_escHtml(ctxName || ctxId)}</div>`;
                html += `<div style="font-size:10px;color:var(--da-muted);opacity:.7;margin-top:1px">${_escHtml(ctxId)}</div>`;
                html += '</div>';
            }

            // Helper: source badge
            function srcBadge(src, ref, url) {
                const cls = src === 'wikidata' ? 'da-chip-ok' : src === 'dila_time_periods' ? 'da-chip-partial' : 'da-chip-ok';
                const label = src === 'wikidata' ? 'Wikidata' : src === 'dila_time_periods' ? 'DILA' : src.toUpperCase();
                const inner = ref ? `${label} · ${ref}` : label;
                if (url) return `<a href="${_escHtml(url)}" target="_blank" rel="noopener" class="da-chip ${cls}" style="font-size:9px;text-decoration:none">${_escHtml(inner)}</a>`;
                return `<span class="da-chip ${cls}" style="font-size:9px">${_escHtml(inner)}</span>`;
            }

            // Tách static_events: có năm (đặt trục) vs không có năm (tư liệu thiếu niên đại).
            const staticEvents = Array.isArray(d.static_events) ? d.static_events : [];
            const datedEvents = staticEvents.filter(function (ev) {
                return ev && ev.year !== null && ev.year !== undefined && ev.year !== '';
            });
            const undatedEvents = staticEvents.filter(function (ev) {
                return !(ev && ev.year !== null && ev.year !== undefined && ev.year !== '');
            });

            // State C: không có bất kỳ dữ liệu niên đại nào (không founding, không heritage,
            // không event có năm) → khối "chưa có mốc đã xác minh" (success state, không lỗi).
            const hasDatedData = !!(
                (d.founding && d.founding.year) ||
                (d.founding && d.founding.heritage && d.founding.heritage.length > 0) ||
                datedEvents.length > 0
            );

            if (!d.ok) {
                ct.innerHTML = html + '<div class="da-warn">Không thể tải dữ liệu niên đại. Hãy thử lại.</div>';
                return;
            }

            // Status: no_mapping → có event có năm? có tư liệu? hay thật sự rỗng?
            if (d.status === 'no_mapping' && !hasDatedData) {
                if (undatedEvents.length > 0) {
                    html += _renderStaticEvents(undatedEvents, true);
                } else if (ctxName) {
                    html += '<div class="da-warn" style="margin:4px 0">Chưa có mốc niên đại đã xác minh cho ' + _escHtml(ctxName) + '.</div>';
                } else {
                    html += '<div class="da-warn" style="margin:4px 0">Chưa có mốc niên đại đã xác minh cho địa danh này.</div>';
                }
                html += '<div style="font-size:10px;color:var(--da-muted);padding:0 4px;margin-top:6px">Địa danh chưa có nguồn niên đại đã xác minh. Dữ liệu sẽ được bổ sung khi có nguồn.</div>';
                ct.innerHTML = html;
                return;
            }

            // Status: ok (có Wikidata QID)
            html = '';
            const refs = d.cross_refs || {};
            const founding = d.founding;
            const dynasty = d.dynasty_context;

            // ── Năm thành lập ──
            if (founding && founding.year) {
                html += '<div style="background:var(--da-card);border:1px solid var(--da-border);border-radius:10px;padding:14px 16px;margin-bottom:12px">';
                html += '<div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--da-muted);margin-bottom:6px">Năm Thành Lập</div>';
                html += `<div style="font-size:26px;font-weight:800;color:var(--da-text);line-height:1">${founding.year} <span style="font-size:13px;font-weight:500;color:var(--da-muted)">CE</span></div>`;
                if (dynasty && dynasty.dynasty_zh) {
                    const dvn = dynasty.dynasty_vi ? ` (${dynasty.dynasty_vi})` : '';
                    html += `<div style="font-size:11px;color:var(--da-muted);margin-top:4px">${_escHtml(dynasty.dynasty_zh)}${_escHtml(dvn)}`;
                    if (dynasty.era_name) html += ` · ${_escHtml(dynasty.era_name)}`;
                    html += '</div>';
                }
                html += '<div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">';
                html += srcBadge('wikidata', founding.source_ref, founding.wikidata_url);
                if (dynasty) html += srcBadge('dila_time_periods', 'time_periods', null);
                html += '</div>';
                html += '</div>';
            } else if (founding && !founding.year) {
                html += '<div style="background:var(--da-card);border:1px solid var(--da-border);border-radius:10px;padding:14px 16px;margin-bottom:12px">';
                html += '<div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--da-muted);margin-bottom:6px">Năm Thành Lập</div>';
                html += '<div style="font-size:12px;color:var(--da-muted)">Wikidata có ID cho địa danh này nhưng chưa có P571 (founding date).</div>';
                html += `<div style="margin-top:6px">${srcBadge('wikidata', refs.wikidata_qid, `https://www.wikidata.org/wiki/${refs.wikidata_qid}`)}</div>`;
                html += '</div>';
            }

            // ── Di sản / Heritage ──
            if (founding && founding.heritage && founding.heritage.length > 0) {
                html += '<div style="background:var(--da-card);border:1px solid var(--da-border);border-radius:10px;padding:12px 16px;margin-bottom:12px">';
                html += '<div style="font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--da-muted);margin-bottom:8px">Di Sản Được Công Nhận</div>';
                founding.heritage.slice(0, 6).forEach(h => {
                    html += `<div style="font-size:11px;color:var(--da-text);padding:3px 0;border-bottom:1px solid var(--da-border)">• ${_escHtml(h)}</div>`;
                });
                html += `<div style="margin-top:6px">${srcBadge('wikidata', 'P1435', `https://www.wikidata.org/wiki/${refs.wikidata_qid}`)}</div>`;
                html += '</div>';
            }

            // ── Static events (BGIS/Marcus pre-seeded) — chỉ event có năm ──
            if (datedEvents.length > 0) {
                html += _renderStaticEvents(datedEvents);
            }

            // ── State E: có tư liệu liên quan nhưng chưa đủ niên đại ──
            if (undatedEvents.length > 0) {
                html += _renderUndatedEvents(undatedEvents);
            } else if (!hasDatedData && !(d.founding && d.founding.year) && !(d.founding && d.founding.heritage && d.founding.heritage.length > 0)) {
                // State C: đã chọn place nhưng không có mốc niên đại đã xác minh.
                html += '<div class="da-warn" style="margin:4px 0">Chưa có mốc niên đại đã xác minh cho ' +
                        _escHtml(ctxName || 'địa danh này') + '.</div>';
            }

            // ── Nguồn xác minh ──
            html += '<div style="font-size:9px;color:var(--da-muted);padding:4px;margin-top:4px">';
            html += `<span style="font-weight:600">Liên kết ID:</span> `;
