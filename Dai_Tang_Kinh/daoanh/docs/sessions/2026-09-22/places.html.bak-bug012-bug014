            // Auto-mở panel Bản Dịch Toàn Phần ngay khi có p.vi_text — để song ngữ hiện luôn
            if (p.has_vi && p.vi_text && !_dtFullViOpen) dtToggleFullVi(idx);
            var src = (p.source||'') + (p.text_id?' · '+p.text_id:'') + (p.loc_ref?' · '+p.loc_ref:'');
            if (meta) meta.textContent = src;

            // Nạp units (text_passages) nếu passage CBETA chưa nạp — auto 1 lần
            if (p.text_id && p.passage_id && p._units === undefined && !p._unitsLoaded) {
                dtLoadUnits(idx);
            }
            var units = (Array.isArray(p._units) && p._units.length) ? p._units : null;

            if (hb) {
                if (units) {
                    hb.innerHTML = units.map(function(u, i) {
                        var n = ('00'+(i+1)).slice(-2);
