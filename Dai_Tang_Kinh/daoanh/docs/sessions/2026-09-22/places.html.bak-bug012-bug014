        }

        function _dtRenderLeftRelated(rd, ent) {
            if (!rd || (!rd.persons && !rd.places)) return;
            const persons = rd.persons || [];
            const places  = rd.places  || [];

            // NGƯỜI SÁNG LẬP — curated persons (từ place_person_link)
            const foundersEl = document.getElementById('dt-left-founders');
            if (foundersEl) {
                const curated = persons.filter(p => p.source === 'curated' || p.badge === 'CURATED');
                let fHtml = '<div class="da-block-label">👤 NGƯỜI SÁNG LẬP</div>';
                if (!curated.length) {
                    fHtml += '<div style="padding:8px 0;font-size:11px;color:var(--da-muted);font-style:italic">Chưa có dữ liệu khảo cứu (curated).</div>';
                } else {
                    curated.forEach(p => {
                        const rel = p.relation_type ? ('<span style="font-size:9px;color:var(--da-gold)"> · ' + _escHtml(p.relation_type) + '</span>') : '';
                        fHtml += '<div style="padding:7px 0;border-bottom:1px solid var(--da-border);display:flex;align-items:center;gap:6px;flex-wrap:wrap">';
                        fHtml += '<button onclick="selectPerson&&selectPerson(\'' + _escHtml(p.entity_id) + '\')" style="font-size:12px;font-family:var(--da-font-serif);color:var(--da-gold);background:none;border:none;cursor:pointer;padding:0;text-align:left">' + _escHtml(p.name_zh || '') + '</button>';
                        if (p.name_vi) fHtml += '<span style="font-size:11px;color:var(--da-text)">' + _escHtml(p.name_vi) + '</span>';
                        if (p.dynasty) fHtml += _daitangChip(p.dynasty, 'var(--da-muted)');
                        fHtml += _daitangChip('CURATED', 'var(--da-green,#4ade80)');
                        fHtml += rel;
                        fHtml += '</div>';
                    });
                }
                foundersEl.innerHTML = fHtml;
            }

            // LIÊN QUAN — canonical persons + places
            const relEl = document.getElementById('dt-left-related');
            if (relEl) {
                const canonical = persons.filter(p => p.source !== 'curated' && p.badge !== 'CURATED');
                let rHtml = '<div class="da-block-label">🔗 LIÊN QUAN</div>';

                if (canonical.length) {
                    rHtml += '<div style="font-size:10px;font-weight:700;color:var(--da-muted);text-transform:uppercase;letter-spacing:.05em;margin:8px 0 4px">Thiền Sư / Nhân Vật</div>';
