                if (hb) hb.innerHTML=emptyMsg; if (vb) vb.innerHTML=emptyMsg;
            }

            // Q&A example chips
            const qaEx = document.getElementById('dt-qa-examples');
            if (qaEx) {
                qaEx.innerHTML = '';
                const vi = ent.name_vi || ent.name_zh || 'nơi này';
                ['Ai sáng lập ' + vi + '?', vi + ' nằm ở đâu?', 'Thiền tông dạy gì tại đây?'].forEach((q, i) => {
                    const b = document.createElement('button');
                    b.textContent = q;
                    b.setAttribute('type', 'button');
                    b.className = 'dt-ds-sug';
                    b.onclick = () => dtUseQASuggestion(i + 1);
                    b.title = q;
                    b.style.marginBottom = '2px';
                    qaEx.appendChild(b);
                });
