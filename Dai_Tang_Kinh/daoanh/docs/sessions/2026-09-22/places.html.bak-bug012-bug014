                ov.querySelector('#da-daitang-reader-copy').addEventListener('click', () => {
                    const ref = ov.querySelector('#da-daitang-reader-title').textContent || '';
                    (navigator.clipboard ? navigator.clipboard.writeText(ref) : Promise.reject()).then(
                        () => { const b = ov.querySelector('#da-daitang-reader-copy'); b.textContent = '✓ Đã chép'; setTimeout(() => { b.textContent = '📋 Sao chép dẫn chiếu'; }, 1500); },
                        () => { prompt('Sao chép dẫn chiếu:', ref); }
                    );
                });
ov.querySelector('#da-daitang-reader-report').addEventListener('click', () => {
    const ref = ov.querySelector('#da-daitang-reader-title').textContent || '';
    daiTangReportPassage(p.passage_id, ref);
    });
            }
            const cit = (p.source || '') + ' ' + (p.text_id || '') + (p.loc_ref ? ' [' + p.loc_ref + ']' : '');
            ov.querySelector('#da-daitang-reader-title').textContent = cit;
            ov.querySelector('#da-daitang-reader-meta').innerHTML = '<b>passage_id:</b> ' + _escHtml(p.passage_id)
                + ' · <b>nguồn:</b> ' + _escHtml(p.source) + '<br>Chuỗi chứng cứ: Kinh điển → bản văn → vị trí (trang/cột)';
            ov.querySelector('#da-daitang-reader-body').textContent = p.raw_text || '(không có nội dung)';
            const dichBtn = ov.querySelector('#da-daitang-reader-dich');
            if (p.has_vi) {
                dichBtn.textContent = p.is_translation_draft ? '✓ Bản dịch nháp' : '✓ Đã có bản dịch';
                dichBtn.style.opacity = '0.5'; dichBtn.style.cursor = 'default';
                dichBtn.onclick = null;
            } else {
                dichBtn.textContent = '🤖 Dịch (AI)'; dichBtn.style.opacity = '1'; dichBtn.style.cursor = 'pointer';
                dichBtn.onclick = () => {
                    dichBtn.textContent = '⏳ Đang dịch...'; dichBtn.disabled = true;
                    fetch('/daoanh/api/passage/' + encodeURIComponent(p.passage_id) + '/translate', {
                        method: 'POST', headers: {'Content-Type': 'application/json'}
                    }).then(r => r.json().then(d => ({s: r.status, d}))).then(({s, d}) => {
