        // ── DT: Đại Tạng 5-tab main panel ─────────────────────────
        let _dtRefs = [], _dtPassages = [], _dtActivePassage = 0, _dtCurrentFilter = 'all';

        function renderDaiTangMain(d) {
            if (!d || !d.success) return;
            const ent = d.entity || {};
            const refs = d.dila_references || [];
            const pg = d.passages || {};
            const items = pg.items || [];
            // Ưu tiên passages đã có bản dịch tiếng Việt lên đầu
            items.sort((a, b) => (b.has_vi ? 1 : 0) - (a.has_vi ? 1 : 0));
            _dtRefs = refs;
            _dtPassages = items;
            window._daitangPassages = items; // backward compat for openDaiTangReader/Translate
            _dtActivePassage = 0;
            window._dtEntityZh = ent.name_zh || '';
            window._dtEntityVi = ent.name_vi || '';
            window._dtCurrentEntityId = ent.id || '';
            _dtRelCache = null; // invalidate khi entity đổi

            // Update tab count badges
            const cR = document.getElementById('dt-cnt-refs');
            const cP = document.getElementById('dt-cnt-pass');
            if (cR) cR.textContent = refs.length;
            if (cP) cP.textContent = pg.total || items.length;

            // Reset to tab 1
            dtSwitchTab('refs');
            dtRenderRefs(_dtCurrentFilter = 'all');
            // reset filter chip
            document.querySelectorAll('.dt-fchip').forEach((c,i) => c.classList.toggle('active', i===0));

            // Tab 2: passages
            dtRenderPChips(0);
            if (items.length) dtRenderPassage(0);
            else {
                const hb=document.getElementById('dt-han-body'), vb=document.getElementById('dt-vi-body');
