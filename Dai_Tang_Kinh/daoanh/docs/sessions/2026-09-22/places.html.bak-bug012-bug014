        function dtJobTranslate(idx, scope) {
            var p = _dtPassages[idx];
            if (!p) return;
            var body = { work_id: p.text_id || 'T50n2060', scope: scope || 'untranslated', run_now: true };
            if (typeof confirm === 'function' && !confirm('Tạo job dịch: ' + body.scope + ' ?')) return;
            fetch('/daoanh/api/translation/jobs', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
                .then(function(r){ return r.json().then(function(d){ return { status: r.status, body: d }; }); })
                .then(function(t){
                    var d = t.body;
                    if (!d.ok) { alert('Lỗi tạo job: ' + (d.error || '')); return; }
                    if (!d.running) { alert('Job tạo xong (không chạy nền): ' + d.job_id); return; }
                    dtPollJobTranslate(d.job_id, idx);
                })
                .catch(function(){ alert('Lỗi kết nối.'); });
        }
        function dtPollJobTranslate(jobId, idx) {
            var tries = 0;
            var iv = setInterval(function(){
                tries++;
                fetch('/daoanh/api/translation/jobs/' + encodeURIComponent(jobId)).then(function(r){ return r.json(); })
                    .then(function(d){
                        if (!d.ok) return;
                        var st = d.job && d.job.status;
                        if (st === 'completed' || st === 'paused' || st === 'partial' || st === 'failed' || tries > 180) {
                            clearInterval(iv);
                            dtLoadUnits(idx, true);
                            if (tries > 180) alert('Hết thời gian chờ job — xem tiến độ ở trang admin.');
                        }
                    }).catch(function(){});
            }, 2000);
        }

        // ── T96: Per-segment realtime translate ──────────────────────
        function dtTranslateSegment(unitId, pIdx) {
            var p = _dtPassages[pIdx];
            if (!p || !p._units) return;
            var unit = p._units.find(function(u){ return u.unit_id === unitId; });
            if (!unit) return;
            unit.badge = 'in_progress';
            dtRenderPassage(pIdx);
            fetch('/daoanh/api/segments/translate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ passage_id: unitId })
            })
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.ok && d.translation_vi) {
                    unit.translation_text = d.translation_vi;
                    unit.translation_id = d.translation_id;
                    unit.badge = 'needs_review';
                } else if (!d.ok && d.error === 'already_queued') {
                    unit.badge = 'in_progress';
                } else {
                    unit.badge = 'failed';
                }
                dtRenderPassage(pIdx);
                dtReloadUnits(pIdx);
            })
            .catch(function(){
                unit.badge = 'failed';
                dtRenderPassage(pIdx);
            });
        }
        var _dtTranslating = false;
        function dtTranslateNextN(n, pIdx) {
            if (_dtTranslating) return;
            var p = _dtPassages[pIdx];
            if (!p || !p._units) return;
            var missing = p._units.filter(function(u){ return u.badge === 'missing' || u.badge === 'failed'; });
            var batch = missing.slice(0, n);
            if (!batch.length) return;
            _dtTranslating = true;
            var bar = document.getElementById('dt-seg-trans-progress');
            if (bar) { bar.textContent = 'Đang dịch 0/' + batch.length + '…'; bar.hidden = false; }
            var done = 0;
            function next() {
                if (done >= batch.length) {
                    _dtTranslating = false;
                    if (bar) bar.hidden = true;
                    dtReloadUnits(pIdx);
                    return;
                }
                var u = batch[done];
                u.badge = 'in_progress';
                dtRenderPassage(pIdx);
                fetch('/daoanh/api/segments/translate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ passage_id: u.unit_id })
                })
                .then(function(r){ return r.json(); })
                .then(function(d){
                    if (d.ok && d.translation_vi) {
                        u.translation_text = d.translation_vi;
                        u.translation_id = d.translation_id;
                        u.badge = 'needs_review';
                    } else { u.badge = 'failed'; }
                    done++;
                    if (bar) bar.textContent = 'Đang dịch ' + done + '/' + batch.length + '…';
                    dtRenderPassage(pIdx);
                    next();
                })
                .catch(function(){ u.badge = 'failed'; done++; next(); });
            }
            next();
        }
        function dtAutoTranslate(pIdx) {
            var p = _dtPassages[pIdx];
            if (!p || !p._units) return;
            var missing = p._units.filter(function(u){ return u.badge === 'missing'; });
            var translated = p._units.filter(function(u){ return u.badge === 'needs_review' || u.badge === 'reviewed'; }).length;
            // Auto-translate đầu nếu toàn bộ chưa có bản dịch (< 3 đoạn đã dịch)
            if (translated < 3 && missing.length > 0) {
                dtTranslateNextN(Math.min(3, missing.length), pIdx);
            }
        }
