        // ===== T57 — Glossary Đa Ngôn Popup =====
        // Gắn popup tra cứu thuật ngữ (Hán-Việt từ lexicon 22 từ điển PG VN, Sanskrit/Tạng từ
        // Yokoyama 1996) cho mọi phần tử có class `da-glossary`. Click → gọi /daoanh/api/glossary.
        // Chỉ hỗ trợ click, không hỗ trợ highlight chủ động (tra cứu chủ động theo yêu cầu).
        function _escHtmlGlossary(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function bindGlossarySpans(container) {
            if (!container) return;
            container.querySelectorAll('.da-glossary').forEach(sp => {
                if (sp._glossBound) return;
                sp._glossBound = true;
                sp.style.cursor = 'pointer';
                sp.style.textDecoration = 'underline dotted';
                sp.style.textUnderlineOffset = '3px';
                sp.addEventListener('click', (ev) => {
                    ev.stopPropagation();
                    openGlossaryPopup(sp.getAttribute('data-term') || sp.textContent.trim());
                });
            });
        }
        async function openGlossaryPopup(term) {
            if (!term) return;
            // Modal overlay
            let ov = document.getElementById('da-glossary-modal');
            if (!ov) {
                ov = document.createElement('div');
                ov.id = 'da-glossary-modal';
                ov.style.cssText = 'position:fixed;inset:0;background:rgba(2,6,23,.6);z-index:9999;display:flex;align-items:flex-start;justify-content:center;padding:10vh 16px;backdrop-filter:blur(2px)';
                ov.innerHTML = '<div style="max-width:560px;width:100%;max-height:70vh;overflow:auto;background:var(--da-panel,#111827);border:1px solid var(--da-border,#2a3550);border-radius:12px;padding:18px 20px;color:var(--da-text,#dce5f4)"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><div style="font-weight:600;font-size:15px" id="da-glossary-title"></div><button id="da-glossary-close" style="background:none;border:none;color:var(--da-muted,#8b93a7);font-size:20px;cursor:pointer;line-height:1">×</button></div><div id="da-glossary-body" style="font-size:13px;line-height:1.6"></div></div>';
                document.body.appendChild(ov);
                ov.addEventListener('click', (e) => { if (e.target === ov) ov.style.display = 'none'; });
                ov.querySelector('#da-glossary-close').addEventListener('click', () => ov.style.display = 'none');
            }
            ov.querySelector('#da-glossary-title').textContent = 'Tra cứu: ' + term;
            const body = ov.querySelector('#da-glossary-body');
            body.innerHTML = '<div style="color:var(--da-muted)">Đang tra cứu…</div>';
            ov.style.display = 'flex';
            try {
                const res = await fetch('/daoanh/api/glossary?term=' + encodeURIComponent(term));
                const j = await res.json();
                if (!j.ok || !j.matches || j.matches.length === 0) {
                    body.innerHTML = '<div class="da-warn" style="margin:4px 0">Không tìm thấy thuật ngữ trong glossary.</div>'
                        + '<div style="color:var(--da-muted);font-size:12px;margin-top:6px">Thử tra theo tên Hán, Phạn (Sanskrit), hoặc Pali.</div>';
                    return;
                }
                body.innerHTML = j.matches.map(m => {
                    const langTag = m.language_name ? '<span style="display:inline-block;margin:0 4px 2px 0;padding:1px 6px;border-radius:4px;background:#ffffff14;font-size:10px;color:var(--da-muted)">' + _escHtmlGlossary(m.language_name) + '</span>' : '';
                    const full = m.full_text && m.full_text.trim() ? '<div style="margin-top:4px;font-size:12px;color:var(--da-muted);font-family:var(--da-font-serif);word-break:break-word">' + _escHtmlGlossary(m.full_text) + '</div>' : '';
                    return '<div style="border:1px solid var(--da-border,#2a3550);border-radius:8px;padding:8px 10px;margin-bottom:8px">'
                        + '<div style="font-family:var(--da-font-serif)">' + _escHtmlGlossary(m.term) + langTag + '</div>'
                        + '<div style="margin-top:2px">' + _escHtmlGlossary(m.definition) + '</div>'
                        + full
                        + '<div style="margin-top:4px;font-size:10px;color:#3a7ca6">◈ ' + _escHtmlGlossary(m.source_label) + '</div>'
                        + '</div>';
                }).join('');
            } catch (err) {
                body.innerHTML = '<div class="da-warn">Lỗi tra cứu glossary.</div>';
            }
        }
        // T100-P2 (Batch 4) — GIÁO LÝ PHÂN ĐÔI: khối "Giáo lý Phật học".
        // Đọc doctrine_concept (whitelist 12 khái niệm core, THEMATIC) + claims liên quan
        // (assertion_level DIRECT/THEMATIC/SCHOLARLY qua badge _daEvidenceBadge) từ
        // GET /daoanh/api/places/<id>/doctrine. Empty-state trung thực qua _daEmptyState.
        async function _daRenderDoctrine(placeId) {
            const box = document.getElementById('giaoly-doctrine');
            if (!box || !placeId) return;
            window._daCurrentPlaceId = placeId;
            box.innerHTML = '<div style="font-size:11px;color:var(--da-muted);padding:8px 0">Đang tải giáo lý…</div>';
            try {
                const level = _daPersona();
                const r = await fetch(baseUrl + '/daoanh/api/places/' + encodeURIComponent(placeId) + '/doctrine?level=' + level);
                const d = await r.json();
                if (!d.ok) { box.innerHTML = ''; return; }
                const concepts = d.concepts || [];
                const related = d.related_claims || [];
                const ds = d.data_status || {};
                const persona = d.persona_level || level;
                let h = '';
                // nhóm 1 — khái niệm giáo lý (whitelist)
                if (concepts.length) {
                    h += '<div style="font-size:12px;font-weight:600;color:var(--da-text);margin-bottom:6px">Khái niệm giáo lý</div>';
                    h += concepts.map(function(c) {
                        const badge = _daEvidenceBadge(String(c.assertion_level || 'thematic').toLowerCase());
                        return '<div style="background:var(--da-panel-alt,#1a2540);border:1px solid var(--da-border,#2a3550);'
                            + 'border-radius:6px;padding:6px 10px;margin-bottom:6px">'
                            + '<div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">'
                            + badge
                            + '<span style="font-size:12px;font-weight:700;color:var(--da-gold,#fbbf24)">' + _escHtml(c.name_vi || '') + '</span>'
                            + (c.name_zh ? '<span style="font-size:11px;color:var(--da-muted)">' + _escHtml(c.name_zh) + '</span>' : '')
                            + (c.pth_uri ? '<code style="font-size:9px;color:var(--da-dim,#5a6580)">' + _escHtml(c.pth_uri) + '</code>' : '')
                            + '</div>'
                            + (c.definition_vi ? '<div style="font-size:11px;line-height:1.6;color:var(--da-text);margin-top:2px">' + _escHtml(c.definition_vi) + '</div>' : '')
                            + (c.related_entities && c.related_entities.length
                                ? '<div style="font-size:10px;color:var(--da-dim,#5a6580);margin-top:2px">Liên quan: '
                                    + c.related_entities.map(_escHtml).join(' · ') + '</div>'
                                : '')
                            + '</div>';
                    }).join('');
                } else if (ds.concepts && ds.concepts.level) {
                    h += _daEmptyState({
                        notIndexed: true,
                        taxonomy: 'Giáo lý Phật học',
                        scope: 'chưa seed whitelist doctrine_concept — chạy scripts/etl_t100_batch4.py.',
                        count: 0,
                        note: ds.concepts.total + ' khái niệm trong bảng.'
                    });
                }
                // nhóm 2 — giáo lý liên quan thực thể (claims + evidence drawer, persona-aware)
                if (related.length) {
                    h += '<div style="font-size:12px;font-weight:600;color:var(--da-text);margin:10px 0 6px">Giáo lý liên quan thực thể</div>';
                    h += '<div style="font-size:10px;color:var(--da-dim,#5a6580);margin-bottom:6px">'
                        + (ds.related_claims && ds.related_claims.note ? _escHtml(ds.related_claims.note) : '')
                        + '</div>';
                    h += _daEvidenceDrawer({ subjectId: placeId, claims: related, max: 40 });
                } else if (persona === 'L1') {
                    h += _daEmptyState({
                        taxonomy: 'Giáo lý liên quan thực thể',
                        scope: 'Trình độ L1 chỉ hiện claim đã xét duyệt (verified) — chưa có claim nào đạt trong entity_claims '
                            + 'cho thực thể này (toàn kho vẫn 100% unverified).',
