                }
            }

            if (vb) {
                var isDraft = !!p.is_translation_draft;
                var fullBlk = p.has_vi && p.vi_text;
                if (units) {
                    var pageScope = (p.text_id && p.loc_ref) ? ('page:' + dtNormLoc(p.loc_ref)) : 'untranslated';
                    var prog = p._coverage ? dtUnitsProgressHtml(p._coverage) : '';
                    var rows = units.map(function(u, i) {
                        var n = ('00'+(i+1)).slice(-2);
                        var badge = dtBadgeHtml(u.badge);
                        var chip = u.manual_verified
                            ? '<span class="dt-verified-chip" title="Bản dịch đoạn Hán này đã được duyệt chuẩn thủ công (manual_verified) — alignment xác nhận bởi admin" style="display:inline-block;margin-left:6px;padding:1px 7px;border-radius:10px;font-size:9px;font-weight:700;color:#4ade80;background:rgba(74,222,128,.12);border:1px solid #4ade8033;vertical-align:middle;white-space:nowrap">✓ Đã kiểm chứng</span>'
                            : '';
                        var body;
                        if (u.badge === 'corrupt') {
                            body = '<div class="dt-seg-text dt-seg-han" style="color:var(--da-muted)">Đoạn Hán nguồn cần được kiểm tra…</div>';
                        } else if (u.translation_text) {
                            var vi = (u.badge === 'needs_review' ? '🪷 ' : '') + u.translation_text;
                            body = '<div class="dt-seg-text dt-seg-vi" style="white-space:pre-wrap">' + _escHtml(vi)
                                + (u.revision_no > 1 ? ' <span style="font-size:9px;color:var(--da-muted)">(rev ' + u.revision_no + ')</span>' : '')
                                + '</div>';
                        } else if (u.badge === 'in_progress') {
                            body = '<div class="dt-seg-text dt-seg-vi" style="color:var(--da-muted)">⏳ Đang dịch…</div>';
                        } else {
                            var uid = _escHtml(JSON.stringify(u.unit_id));
                            body = '<div class="dt-seg-text dt-seg-vi" style="color:var(--da-muted);display:flex;align-items:center;gap:8px">'
                                + '<span>Chưa có bản dịch.</span>'
                                + '<button onclick="dtTranslateSegment('+uid+','+idx+')" style="font-size:10px;color:var(--da-gold);background:none;border:1px solid var(--da-gold);border-radius:4px;padding:2px 8px;cursor:pointer;flex-shrink:0">Dịch</button>'
                                + '</div>';
