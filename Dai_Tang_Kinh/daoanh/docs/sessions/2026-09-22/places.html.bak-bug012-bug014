        function _daRenderPersonaSwitcher() {
            const host = document.getElementById('lineage-persona');
            if (!host) return;
            const lv = _daPersona();
            let s = '<span style="font-size:10px;color:var(--da-dim,#5a6580);margin-right:4px">Trình độ:</span>';
            ['L1', 'L2', 'L3'].forEach(function(k) {
                const on = k === lv;
                s += '<span role="button" tabindex="0" title="' + _daPersonaTip(k) + '" '
