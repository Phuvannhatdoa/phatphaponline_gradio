        function _gmpExpandAll() {
            if (!_graphData || !_graphDataset) return;
            const d = _graphData;
            const dataset = _graphDataset;
            const personCount = (d.nodes || []).filter(n => n.group === 'person').length;
            const textCount   = (d.nodes || []).filter(n => n.group === 'text').length;
            const total = personCount + textCount;
            if (total > 20) {
                if (!confirm('Đồ thị có ' + total + ' node. Tiếp tục mở tất cả?')) return;
            }
            if (dataset.nodes.get('group-works'))   _gmpExpandWorks(d, dataset);
            if (dataset.nodes.get('group-persons')) _gmpExpandPersons(d, dataset);
            // Expand bất kỳ subgroup nào vừa mới được thêm
            const subIds = dataset.nodes.getIds().filter(id => ('' + id).startsWith('subgroup-'));
            subIds.forEach(id => _gmpExpandSubgroup(id, d, dataset));
        }

