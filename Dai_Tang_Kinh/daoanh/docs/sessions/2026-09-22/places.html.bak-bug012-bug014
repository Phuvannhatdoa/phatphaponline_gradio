                    + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:6px"><div style="font-weight:700;font-size:15px" id="da-daitang-reader-title"></div><button id="da-daitang-reader-close" style="background:none;border:none;color:var(--da-muted,#8b93a7);font-size:22px;cursor:pointer;line-height:1">×</button></div>'
