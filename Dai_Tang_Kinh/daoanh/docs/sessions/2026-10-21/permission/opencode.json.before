{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permission": {
    "external_directory": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "config/**": "deny"
    },
    "edit": {
      "*": "allow",
      "data/**": "deny",
      ".env": "deny",
      ".env.*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "npm run *": "allow",
      "pip *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "du *": "allow",
      "Get-*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git restore *": "ask",
      "git read-tree *": "ask",
      "git update-index *": "ask",
      "git push *": "ask",
      "python * --apply*": "ask",
      "python * --revert*": "ask",
      "python * --reset*": "ask",
      "python *ai_batch_transliterate*": "ask",
      "npm run deploy*": "ask",
      "sudo *": "deny",
      "git push --force*": "deny",
      "git clean *": "deny",
      "rm -rf *": "deny",
      "Remove-Item -Recurse*": "deny",
      "sqlite3 * DROP *": "deny",
      "sqlite3 * DELETE *": "deny"
    }
  }
}
