   Cùng cơ chế với Person.
══════════════════════════════════════════ */
let _plFilter = 'all';
let _plPage = 1;
let _plPages = 1;
let _plTotalItems = 0;
const PL_LIMIT = 50;

let _plJobRunning = false;
let _plJobPaused = false;
let _plJobQueue = [];
let _plJobIndex = 0;
let _plJobStats = { done: 0, error: 0, rateLimit: 0 };

async function plInit() {
