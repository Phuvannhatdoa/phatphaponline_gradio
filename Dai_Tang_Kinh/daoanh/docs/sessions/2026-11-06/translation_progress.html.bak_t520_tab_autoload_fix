function psRenderPager() {
  const p = document.getElementById('ps-pager');
  if (_psPages <= 1) { p.innerHTML = ''; return; }
  p.innerHTML = '<button class="btn" ' + (_psPage <= 1 ? 'disabled' : '') + ' onclick="psGoPage(-1)">‹ Trước</button>' +
    '<span>Trang ' + _psPage + ' / ' + _psPages + '</span>' +
    '<button class="btn" ' + (_psPage >= _psPages ? 'disabled' : '') + ' onclick="psGoPage(1)">Sau ›</button>';
}

function psGoPage(dir) {
  _psPage = Math.min(_psPages, Math.max(1, _psPage + dir));
  psLoadList(false);
}

function psSetFilter(btn) {
  document.querySelectorAll('[data-psf]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  _psFilter = btn.dataset.psf;
  psLoadList(true);
}

async function psTranslateOne(personId) {
  const btn = event.target;
  btn.disabled = true;
  btn.textContent = '⏳';
  try {
    const r = await fetch(API + '/daoanh/api/person/' + encodeURIComponent(personId) + '/translate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() }
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'Dịch thất bại');
    btn.textContent = d.from_cache ? '✓ Cache' : '✓ Xong';
    btn.className = 'btn';
    btn.disabled = true;
    await psLoadStats();
    psLoadList(false);
  } catch (e) {
    btn.disabled = false;
    btn.textContent = 'Thử lại';
    alert('Lỗi: ' + e.message);
  }
}

/* ── Job chạy tuần tự (Start / Pause / Resume / Stop) ── */

function psBuildQueue(items) {
  const limit = parseInt(document.getElementById('ps-limit').value || '20', 10);
  const skipDone = document.getElementById('ps-skip-done').checked;
  const onlyZh = document.getElementById('ps-only-zh').checked;
  const queue = [];
  for (const it of items) {
    if (queue.length >= limit) break;
    if (skipDone && (it.bio_vi_saved || it.draft_status)) continue;
    if (onlyZh && !it.has_bio_zh) continue;
    queue.push(it.id);
  }
  return queue;
}

async function psFetchAllForQueue() {
  // Lấy toàn bộ items phù hợp filter hiện tại (không phân trang) để xây queue
  // Dùng limit lớn + offset=0, lặp nếu cần
  const allItems = [];
  let offset = 0;
  const batchSize = 200;
  while (true) {
    const url = API + '/daoanh/api/dila/persons?limit=' + batchSize + '&offset=' + offset + '&status=' + _psFilter;
    const r = await fetch(url, { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok || !d.items.length) break;
    allItems.push(...d.items);
    if (d.items.length < batchSize) break;
    offset += batchSize;
  }
  return allItems;
}

async function psStartTranslation() {
  const btn = event.target;
  if (_psJobRunning) return;
  document.getElementById('ps-err').textContent = '';
  btn.disabled = true;
  btn.textContent = '⏳ Đang nạp danh sách…';
  try {
    const allItems = await psFetchAllForQueue();
    _psJobQueue = psBuildQueue(allItems);
    if (!_psJobQueue.length) {
      document.getElementById('ps-err').textContent = 'Không có ID nào phù hợp để dịch (đã lọc/đã đủ).';
      btn.disabled = false;
      btn.textContent = '▶ Bắt đầu dịch';
      return;
    }
    _psJobIndex = 0;
    _psJobStats = { done: 0, error: 0, rateLimit: 0 };
    _psJobRunning = true;
    _psJobPaused = false;
    document.getElementById('ps-job-panel').classList.add('visible');
    document.getElementById('ps-resume-btn').disabled = true;
    btn.textContent = '▶ Đang chạy…';
    btn.classList.add('t50-s-running');
    await psProcessNext();
  } catch (e) {
    document.getElementById('ps-err').textContent = 'Lỗi: ' + e.message;
    btn.disabled = false;
    btn.textContent = '▶ Bắt đầu dịch';
  }
}

async function psProcessNext() {
  if (!_psJobRunning || _psJobPaused) return;
  if (_psJobIndex >= _psJobQueue.length) {
    psJobComplete();
    return;
  }
  const personId = _psJobQueue[_psJobIndex];
  document.getElementById('ps-job-id').textContent = personId + ' (' + (_psJobIndex + 1) + '/' + _psJobQueue.length + ')';
  document.getElementById('ps-job-done').textContent = _psJobStats.done;
  document.getElementById('ps-job-remain').textContent = _psJobQueue.length - _psJobIndex;
  document.getElementById('ps-job-err').textContent = _psJobStats.error;
  document.getElementById('ps-job-rl').textContent = _psJobStats.rateLimit;
  const logEl = document.getElementById('ps-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] Bắt đầu: ' + personId;
  logEl.scrollTop = logEl.scrollHeight;
  try {
    const r = await fetch(API + '/daoanh/api/person/' + encodeURIComponent(personId) + '/translate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() }
    });
    const d = await r.json();
    if (!d.ok) {
      const errType = d.error_type || 'unknown';
      if (errType === 'rate_limit' || errType === 'quota_exceeded' || (d.error && d.error.includes('rate'))) {
        _psJobStats.rateLimit++;
        logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] Rate limit: ' + personId + ' — tạm dừng 30s';
        logEl.scrollTop = logEl.scrollHeight;
        await new Promise(res => setTimeout(res, 30000));
        // Thử lại lần 2
        const r2 = await fetch(API + '/daoanh/api/person/' + encodeURIComponent(personId) + '/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() }
        });
        const d2 = await r2.json();
        if (!d2.ok) throw new Error(d2.error || 'Dịch thất bại sau rate limit');
      } else {
        throw new Error(d.error || 'Dịch thất bại');
      }
    }
    _psJobStats.done++;
    logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ✓ ' + personId + (d.from_cache ? ' (cache)' : '');
  } catch (e) {
    _psJobStats.error++;
    logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ✗ ' + personId + ': ' + e.message;
  }
  logEl.scrollTop = logEl.scrollHeight;
  _psJobIndex++;
  // Delay nhỏ giữa các request để tránh spam
  await new Promise(res => setTimeout(res, 500));
  if (_psJobRunning && !_psJobPaused) {
    psProcessNext();
  }
}

function psPauseJob() {
  if (!_psJobRunning || _psJobPaused) return;
  _psJobPaused = true;
  document.getElementById('ps-resume-btn').disabled = false;
  const btn = document.querySelector('button[onclick="psStartTranslation()"]');
  if (btn) { btn.textContent = '▶ Tạm dừng'; btn.classList.remove('t50-s-running'); }
  const logEl = document.getElementById('ps-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ⏸ Tạm dừng tại #' + (_psJobIndex + 1);
  logEl.scrollTop = logEl.scrollHeight;
}

function psResumeJob() {
  if (!_psJobRunning || !_psJobPaused) return;
  _psJobPaused = false;
  document.getElementById('ps-resume-btn').disabled = true;
  const btn = document.querySelector('button[onclick="psStartTranslation()"]');
  if (btn) { btn.textContent = '▶ Đang chạy…'; btn.classList.add('t50-s-running'); }
  const logEl = document.getElementById('ps-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ▶ Tiếp tục từ #' + (_psJobIndex + 1);
  logEl.scrollTop = logEl.scrollHeight;
  psProcessNext();
}

function psStopJob() {
  _psJobRunning = false;
  _psJobPaused = false;
  const btn = document.querySelector('button[onclick="psStartTranslation()"]');
  if (btn) { btn.disabled = false; btn.textContent = '▶ Bắt đầu dịch'; btn.classList.remove('t50-s-running'); }
  document.getElementById('ps-resume-btn').disabled = true;
  document.getElementById('ps-job-panel').classList.remove('visible');
  const logEl = document.getElementById('ps-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ■ Dừng bởi Admin. Đã xử lý: ' + _psJobIndex + '/' + _psJobQueue.length;
  logEl.scrollTop = logEl.scrollHeight;
  _psJobQueue = [];
  _psJobIndex = 0;
}

function psJobComplete() {
  _psJobRunning = false;
  _psJobPaused = false;
  const btn = document.querySelector('button[onclick="psStartTranslation()"]');
  if (btn) { btn.disabled = false; btn.textContent = '▶ Bắt đầu dịch'; btn.classList.remove('t50-s-running'); }
  document.getElementById('ps-resume-btn').disabled = true;
  const logEl = document.getElementById('ps-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ✅ HOÀN TẤT: ' + _psJobStats.done + ' thành công, ' + _psJobStats.error + ' lỗi, ' + _psJobStats.rateLimit + ' rate-limit';
  logEl.scrollTop = logEl.scrollHeight;
  psLoadStats();
  psLoadList(false);
}

/* ══════════════════════════════════════════
