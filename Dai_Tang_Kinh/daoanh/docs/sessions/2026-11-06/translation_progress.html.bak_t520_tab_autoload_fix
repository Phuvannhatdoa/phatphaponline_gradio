async function batchImport() {
  const series = document.getElementById('cat-series').value || 'T';
  const limit  = parseInt(document.getElementById('import-limit').value || '10', 10);
  if (isNaN(limit) || limit <= 0) return;
  const btn = document.getElementById('btn-batch-import');
  btn.disabled = true; btn.textContent = '⏳ Đang import…';
  try {
    const r = await fetch(_CAT_BASE + '/daoanh/api/admin/cbeta/batch-import', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ series, limit })
    });
    const j = await r.json();
    if (j.error) throw new Error(j.error);
    const res = document.getElementById('import-result');
    const errList = (j.errors || []).map(e => e.sigla + ': ' + e.error).join('; ');
    const skipSample = (j.skipped || []).slice(0, 3).map(s => s.sigla + '(' + (s.fetch_note || s.reason) + ')').join(', ');
    res.style.display = 'block';
    res.style.background = j.total_imported > 0 ? '#052e16' : '#1c1917';
    res.style.border = '1px solid ' + (j.total_imported > 0 ? '#16a34a' : '#78350f');
    res.style.color = '#f9fafb';
    res.innerHTML = '✅ Import xong: <b>' + j.total_imported + '</b> bộ' +
      ((j.skipped || []).length ? ' | Bỏ qua: <b>' + j.skipped.length + '</b>' + (skipSample ? ' (' + skipSample + ')' : '') : '') +
      ((j.errors || []).length ? ' | Lỗi: <b>' + j.errors.length + '</b>' + (errList ? ': ' + errList : '') : '');
    catLoad();
  } catch (e) {
    const res = document.getElementById('import-result');
    res.style.display = 'block';
    res.style.background = '#1c0000';
    res.style.border = '1px solid #dc2626';
    res.style.color = '#f9fafb';
    res.textContent = '❌ Lỗi: ' + e.message;
  }
  finally { btn.disabled = false; btn.textContent = 'Import XML hàng loạt'; }
}

