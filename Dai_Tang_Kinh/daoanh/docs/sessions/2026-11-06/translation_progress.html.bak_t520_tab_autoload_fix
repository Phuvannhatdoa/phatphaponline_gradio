}

async function plLoadStats() {
  try {
    const r = await fetch(API + '/daoanh/api/dila/stats', { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'API lỗi');
    document.getElementById('pl-total').textContent = fmt(d.total);
    document.getElementById('pl-mapped').textContent = fmt(d.mapped_vi);
    document.getElementById('pagetab-place-cnt').textContent = '(' + fmt(d.total) + ')';
    // Draft count từ translation_cache API
    const r2 = await fetch(API + '/daoanh/api/admin/translation-cache?source_type=place_note&status=auto&limit=1', { headers: { 'X-Session-Token': token() } });
    const d2 = await r2.json();
    const draftCount = d2.ok ? (d2.total || 0) : 0;
    document.getElementById('pl-draft').textContent = fmt(draftCount);
    const withNote = d.total; // places_dila luôn có note (có thể rỗng)
    const pending = Math.max(0, withNote - d.mapped_vi - draftCount);
    document.getElementById('pl-pending').textContent = fmt(pending);
    document.getElementById('pl-nonote').textContent = fmt(0); // placeholder
    const pct = d.total ? (d.mapped_vi * 100 / d.total) : 0;
    document.getElementById('pl-bar').style.width = Math.min(100, pct).toFixed(1) + '%';
  } catch (e) {
    document.getElementById('pl-err').textContent = 'Lỗi tải thống kê: ' + e.message;
  }
}

async function plLoadList(resetPage = true) {
  if (resetPage) _plPage = 1;
  document.getElementById('pl-body').innerHTML = '<tr><td colspan="7" style="color:var(--muted);text-align:center;padding:18px">Đang tải…</td></tr>';
  try {
    let status = '';
    if (_plFilter === 'mapped') status = 'mapped';
    else if (_plFilter === 'draft') status = 'draft';
    else if (_plFilter === 'pending') status = 'pending';
    else if (_plFilter === 'nonote') status = 'nonote';
    const url = API + '/daoanh/api/dila/places?limit=' + PL_LIMIT + '&offset=' + ((_plPage - 1) * PL_LIMIT);
    const r = await fetch(url, { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'API lỗi');
    _plTotalItems = d.total;
    _plPages = Math.ceil(_plTotalItems / PL_LIMIT);
    document.getElementById('pl-count').textContent = fmt(d.total) + ' dòng';
    plRenderRows(d.items);
    plRenderPager();
  } catch (e) {
    document.getElementById('pl-body').innerHTML = '<tr><td colspan="7" style="color:var(--bad);text-align:center;padding:18px">Lỗi: ' + esc(e.message) + '</td></tr>';
    document.getElementById('pl-pager').innerHTML = '';
  }
}

function plRenderRows(items) {
  const body = document.getElementById('pl-body');
  if (!items.length) {
    body.innerHTML = '<tr><td colspan="7" style="color:var(--muted);text-align:center;padding:18px">Không có dữ liệu</td></tr>';
    return;
  }
  body.innerHTML = items.map(it => {
    const nameVi = it.name_vi ? '<span style="color:var(--ok)">' + esc(it.name_vi) + '</span>' : '<span style="color:var(--muted)">—</span>';
    const conf = it.confidence ? '<div class="mono" style="font-size:10px;color:var(--muted)">conf: ' + esc(it.confidence) + '</div>' : '';
    let statusHtml, actionHtml;
    if (it.name_vi) {
      statusHtml = '<span class="badge ok">✓ Mapped</span>';
      actionHtml = '<button class="btn" disabled>✓ Đã có tên VI</button>';
    } else {
      statusHtml = '<span class="badge wait">⏳ Chờ dịch</span>';
      actionHtml = '<button class="btn ok" onclick="plTranslateOne(\'' + esc(it.id) + '\')">Dịch ngay</button>';
    }
    const category = it.note_category ? '<span class="badge">' + esc(it.note_category) + '</span>' : '<span style="color:var(--muted)">—</span>';
    const district = it.district ? '<span style="color:var(--muted)">' + esc(it.district) + '</span>' : '<span style="color:var(--muted)">—</span>';
    return '<tr>' +
      '<td class="mono"><a href="/daoanh/admin/places.html?id=' + esc(it.id) + '" target="_blank" style="color:var(--gold)">' + esc(it.id) + '</a></td>' +
      '<td class="han">' + esc(it.name_zh || '') + '</td>' +
      '<td>' + nameVi + conf + '</td>' +
      '<td>' + category + '</td>' +
      '<td>' + district + '</td>' +
      '<td>' + statusHtml + '</td>' +
      '<td>' + actionHtml + '</td>' +
      '</tr>';
  }).join('');
}

function plRenderPager() {
  const p = document.getElementById('pl-pager');
  if (_plPages <= 1) { p.innerHTML = ''; return; }
  p.innerHTML = '<button class="btn" ' + (_plPage <= 1 ? 'disabled' : '') + ' onclick="plGoPage(-1)">‹ Trước</button>' +
    '<span>Trang ' + _plPage + ' / ' + _plPages + '</span>' +
    '<button class="btn" ' + (_plPage >= _plPages ? 'disabled' : '') + ' onclick="plGoPage(1)">Sau ›</button>';
}

function plGoPage(dir) {
  _plPage = Math.min(_plPages, Math.max(1, _plPage + dir));
  plLoadList(false);
}

function plSetFilter(btn) {
  document.querySelectorAll('[data-plf]').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  _plFilter = btn.dataset.plf;
  plLoadList(true);
}

async function plTranslateOne(dilaId) {
  const btn = event.target;
  btn.disabled = true;
  btn.textContent = '⏳';
  try {
    const r = await fetch(API + '/daoanh/api/place/' + encodeURIComponent(dilaId) + '/translate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() }
    });
    const d = await r.json();
    if (!d.ok) {
      // Check if endpoint is not available (404) or schema issue
      if (r.status === 404) {
        throw new Error('ENDPOINT_NOT_FOUND: /daoanh/api/place/<id>/translate không tồn tại');
      }
      throw new Error(d.error || 'Dịch thất bại');
    }
    btn.textContent = d.from_cache ? '✓ Cache' : '✓ Xong';
    btn.className = 'btn';
    btn.disabled = true;
    await plLoadStats();
    plLoadList(false);
  } catch (e) {
    btn.disabled = false;
    btn.textContent = 'Thử lại';
    if (e.message.includes('ENDPOINT_NOT_FOUND')) {
      document.getElementById('pl-blocked-note').style.display = 'block';
    }
    alert('Lỗi: ' + e.message);
  }
}

/* ── Job chạy tuần tự cho Place ── */

function plBuildQueue(items) {
  const limit = parseInt(document.getElementById('pl-limit').value || '20', 10);
  const skipDone = document.getElementById('pl-skip-done').checked;
  const onlyNote = document.getElementById('pl-only-note').checked;
  const queue = [];
  for (const it of items) {
    if (queue.length >= limit) break;
    if (skipDone && it.name_vi) continue;
    if (onlyNote && (!it.note || !it.note.trim())) continue;
    queue.push(it.id);
  }
  return queue;
}

async function plFetchAllForQueue() {
  const allItems = [];
  let offset = 0;
  const batchSize = 200;
  while (true) {
    const url = API + '/daoanh/api/dila/places?limit=' + batchSize + '&offset=' + offset;
    const r = await fetch(url, { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok || !d.items.length) break;
    allItems.push(...d.items);
    if (d.items.length < batchSize) break;
    offset += batchSize;
  }
  return allItems;
}

async function plStartTranslation() {
  const btn = event.target;
  if (_plJobRunning) return;
  document.getElementById('pl-err').textContent = '';
  document.getElementById('pl-blocked-note').style.display = 'none';
  btn.disabled = true;
  btn.textContent = '⏳ Đang nạp danh sách…';
  try {
    const allItems = await plFetchAllForQueue();
    _plJobQueue = plBuildQueue(allItems);
    if (!_plJobQueue.length) {
      document.getElementById('pl-err').textContent = 'Không có ID nào phù hợp để dịch (đã lọc/đã đủ).';
      btn.disabled = false;
      btn.textContent = '▶ Bắt đầu dịch';
      return;
    }
    _plJobIndex = 0;
    _plJobStats = { done: 0, error: 0, rateLimit: 0 };
    _plJobRunning = true;
    _plJobPaused = false;
    document.getElementById('pl-job-panel').classList.add('visible');
    document.getElementById('pl-resume-btn').disabled = true;
    btn.textContent = '▶ Đang chạy…';
    btn.classList.add('t50-s-running');
    await plProcessNext();
  } catch (e) {
    document.getElementById('pl-err').textContent = 'Lỗi: ' + e.message;
    btn.disabled = false;
    btn.textContent = '▶ Bắt đầu dịch';
  }
}

async function plProcessNext() {
  if (!_plJobRunning || _plJobPaused) return;
  if (_plJobIndex >= _plJobQueue.length) {
    plJobComplete();
    return;
  }
  const dilaId = _plJobQueue[_plJobIndex];
  document.getElementById('pl-job-id').textContent = dilaId + ' (' + (_plJobIndex + 1) + '/' + _plJobQueue.length + ')';
  document.getElementById('pl-job-done').textContent = _plJobStats.done;
  document.getElementById('pl-job-remain').textContent = _plJobQueue.length - _plJobIndex;
  document.getElementById('pl-job-err').textContent = _plJobStats.error;
  document.getElementById('pl-job-rl').textContent = _plJobStats.rateLimit;
  const logEl = document.getElementById('pl-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] Bắt đầu: ' + dilaId;
  logEl.scrollTop = logEl.scrollHeight;
  try {
    const r = await fetch(API + '/daoanh/api/place/' + encodeURIComponent(dilaId) + '/translate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() }
    });
    const d = await r.json();
    if (!d.ok) {
      const errType = d.error_type || 'unknown';
      if (errType === 'rate_limit' || errType === 'quota_exceeded' || (d.error && d.error.includes('rate'))) {
        _plJobStats.rateLimit++;
        logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] Rate limit: ' + dilaId + ' — tạm dừng 30s';
        logEl.scrollTop = logEl.scrollHeight;
        await new Promise(res => setTimeout(res, 30000));
        const r2 = await fetch(API + '/daoanh/api/place/' + encodeURIComponent(dilaId) + '/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() }
        });
        const d2 = await r2.json();
        if (!d2.ok) throw new Error(d2.error || 'Dịch thất bại sau rate limit');
      } else if (r.status === 404) {
        throw new Error('ENDPOINT_NOT_FOUND: /daoanh/api/place/<id>/translate không tồn tại');
      } else {
        throw new Error(d.error || 'Dịch thất bại');
      }
    }
    _plJobStats.done++;
    logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ✓ ' + dilaId + (d.from_cache ? ' (cache)' : '');
  } catch (e) {
    _plJobStats.error++;
    logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ✗ ' + dilaId + ': ' + e.message;
    if (e.message.includes('ENDPOINT_NOT_FOUND')) {
      document.getElementById('pl-blocked-note').style.display = 'block';
      plStopJob();
      return;
    }
  }
  logEl.scrollTop = logEl.scrollHeight;
  _plJobIndex++;
  await new Promise(res => setTimeout(res, 500));
  if (_plJobRunning && !_plJobPaused) {
    plProcessNext();
  }
}

function plPauseJob() {
  if (!_plJobRunning || _plJobPaused) return;
  _plJobPaused = true;
  document.getElementById('pl-resume-btn').disabled = false;
  const btn = document.querySelector('button[onclick="plStartTranslation()"]');
  if (btn) { btn.textContent = '▶ Tạm dừng'; btn.classList.remove('t50-s-running'); }
  const logEl = document.getElementById('pl-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ⏸ Tạm dừng tại #' + (_plJobIndex + 1);
  logEl.scrollTop = logEl.scrollHeight;
}

function plResumeJob() {
  if (!_plJobRunning || !_plJobPaused) return;
  _plJobPaused = false;
  document.getElementById('pl-resume-btn').disabled = true;
  const btn = document.querySelector('button[onclick="plStartTranslation()"]');
  if (btn) { btn.textContent = '▶ Đang chạy…'; btn.classList.add('t50-s-running'); }
  const logEl = document.getElementById('pl-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ▶ Tiếp tục từ #' + (_plJobIndex + 1);
  logEl.scrollTop = logEl.scrollHeight;
  plProcessNext();
}

function plStopJob() {
  _plJobRunning = false;
  _plJobPaused = false;
  const btn = document.querySelector('button[onclick="plStartTranslation()"]');
  if (btn) { btn.disabled = false; btn.textContent = '▶ Bắt đầu dịch'; btn.classList.remove('t50-s-running'); }
  document.getElementById('pl-resume-btn').disabled = true;
  document.getElementById('pl-job-panel').classList.remove('visible');
  const logEl = document.getElementById('pl-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ■ Dừng bởi Admin. Đã xử lý: ' + _plJobIndex + '/' + _plJobQueue.length;
  logEl.scrollTop = logEl.scrollHeight;
  _plJobQueue = [];
  _plJobIndex = 0;
}

function plJobComplete() {
  _plJobRunning = false;
  _plJobPaused = false;
  const btn = document.querySelector('button[onclick="plStartTranslation()"]');
  if (btn) { btn.disabled = false; btn.textContent = '▶ Bắt đầu dịch'; btn.classList.remove('t50-s-running'); }
  document.getElementById('pl-resume-btn').disabled = true;
  const logEl = document.getElementById('pl-job-log');
  logEl.textContent += '\n[' + new Date().toLocaleTimeString('vi-VN') + '] ✅ HOÀN TẤT: ' + _plJobStats.done + ' thành công, ' + _plJobStats.error + ' lỗi, ' + _plJobStats.rateLimit + ' rate-limit';
  logEl.scrollTop = logEl.scrollHeight;
  plLoadStats();
  plLoadList(false);
}
</script>
