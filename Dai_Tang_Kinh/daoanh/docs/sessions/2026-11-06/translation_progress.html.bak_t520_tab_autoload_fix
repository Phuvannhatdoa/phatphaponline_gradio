<script>
const API = (window.location.protocol === 'http:' || window.location.protocol === 'https:') ? '' : 'http://localhost:8080';
let filter = 'all', page = 1, pages = 1;

function token() { try { return localStorage.getItem('admin_session') || ''; } catch (e) { return ''; } }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmt(n) { return (typeof n === 'number') ? n.toLocaleString('vi-VN') : '—'; }
function showErr(msg) { document.getElementById('err').textContent = msg || ''; }

async function load() {
  showErr('');
  try {
    const r = await fetch(API + '/daoanh/api/admin/gemini-progress?page=' + page + '&size=50&filter=' + filter,
      { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'API lỗi');
    const s = d.summary;
    document.getElementById('t-total').textContent = fmt(s.total_places);
    document.getElementById('t-done').textContent = fmt(s.gemini_done);
    document.getElementById('t-approved').textContent = fmt(s.approved);
    document.getElementById('t-pending').textContent = fmt(s.pending_review);
    document.getElementById('t-orphan').textContent = fmt(s.gemini_orphan);
    document.getElementById('t-last').textContent = s.last_dila_id ? (s.last_dila_id + ' · ' + s.last_created_at) : '—';
    const pct = s.total_places ? (s.gemini_done * 100 / s.total_places) : 0;
    document.getElementById('bar-done').style.width = Math.min(100, pct).toFixed(1) + '%';
    document.getElementById('log').textContent = (s.log_tail || []).join('\n') || 'Chưa có nhật ký batch.';
    document.getElementById('count').textContent = fmt(d.total) + ' dòng';
    pages = d.pages || 1;
    renderRows(d.items);
    renderPager();
  } catch (e) {
    showErr('Không tải được tiến độ: ' + e.message);
  }
}

function renderRows(items) {
  const body = document.getElementById('body');
  if (!items.length) { body.innerHTML = '<tr><td colspan="6" style="color:var(--muted);text-align:center;padding:18px">Không có dòng nào</td></tr>'; return; }
  body.innerHTML = items.map(it => {
    const status = it.approved
      ? '<span class="badge ok">Đã chấp thuận</span><div class="mono">' + esc(it.editor) + ' · ' + esc(it.approved_at) + '</div>'
      : '<span class="badge wait">Chờ duyệt</span>';
    const btn = it.approved
      ? '<button class="btn" disabled>✓ Đã lưu</button>'
      : '<button class="btn ok" onclick="approve(this)">Chấp thuận</button>';
    const input = '<input class="name" value="' + esc(it.gemini_vi) + '" data-cur="' + esc(it.gemini_vi) + '">';
    return '<tr data-id="' + esc(it.dila_id) + '">' +
      '<td class="mono">' + esc(it.dila_id) + '</td>' +
      '<td><div class="han">' + esc(it.name_zh) + '</div><div class="note">' + esc(it.source_note) + '</div></td>' +
      '<td>' + input + '<div class="mono">' + esc(it.gemini_model) + ' · ' + esc(it.gemini_at) + '</div></td>' +
      '<td>' + esc(it.approved ? it.approved_name_vi : it.current_vi) + '<div class="mono">' + esc(it.vn_status) + '</div></td>' +
      '<td>' + status + '</td>' +
      '<td>' + btn + '</td>' +
      '</tr>';
  }).join('');
}

async function approve(btn) {
  const tr = btn.closest('tr');
  const id = tr.dataset.id;
  const name = tr.querySelector('input.name').value.trim();
  if (!name) { alert('Tên Việt không được rỗng'); return; }
  btn.disabled = true; btn.textContent = '…';
  try {
    const r = await fetch(API + '/daoanh/api/admin/gemini-progress/approve', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() },
      body: JSON.stringify({ dila_id: id, name_vi: name })
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'Không lưu được');
    btn.textContent = '✓ Đã lưu';
    btn.className = 'btn';
    btn.disabled = true;
    load();
  } catch (e) {
    btn.disabled = false; btn.textContent = 'Chấp thuận';
    alert('Lỗi: ' + e.message);
  }
}

function renderPager() {
  const p = document.getElementById('pager');
  if (pages <= 1) { p.innerHTML = ''; return; }
  p.innerHTML = '<button class="btn" ' + (page <= 1 ? 'disabled' : '') + ' onclick="go(-1)">‹ Trước</button>' +
    '<span>Trang ' + page + ' / ' + pages + '</span>' +
    '<button class="btn" ' + (page >= pages ? 'disabled' : '') + ' onclick="go(1)">Sau ›</button>';
}
function go(d) { page = Math.min(pages, Math.max(1, page + d)); load(); }

document.querySelectorAll('.toolbar .btn[data-f]').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('.toolbar .btn[data-f]').forEach(x => x.classList.remove('active'));
  b.classList.add('active'); filter = b.dataset.f; page = 1; load();
}));

load();

/* ══════════════════════════════════════════
   Page tabs: cấu hình để thêm Tab mới (bộ kinh khác) không cần sửa switchPage().
   Thêm 1 Tab mới = 3 bước: (1) nút trong .page-tabs, (2) <div id="tab-<id>"
   class="tab-pane">, (3) 1 dòng vào TAB_REGISTRY {id: {loaded:false, init: fn}}.
   init() chỉ chạy 1 lần, lúc click Tab lần đầu (lazy-load).
══════════════════════════════════════════ */
let _nxLoaded = false;
const TAB_REGISTRY = {
  progress:    { loaded: true,  init: null },   // đã load() ngay khi mở trang, ở dưới
  nexus:       { loaded: false, init: nxLoad },
  t50:         { loaded: false, init: t50Init },
  catalog:     { loaded: false, init: catLoad },
  'nexus-t514': { loaded: false, init: nxsInit },
  person:      { loaded: false, init: psInit },
  place:       { loaded: false, init: plInit },
};
function switchPage(id, btn) {
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  document.getElementById('tab-' + id).classList.add('active');
  document.querySelectorAll('.page-tabs .btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  const reg = TAB_REGISTRY[id];
  if (reg && !reg.loaded && reg.init) { reg.loaded = true; reg.init(); }
}

/* Deep-link: mở sẵn 1 tab qua #<id> hoặc ?tab=<id> (dùng bởi redirect từ t50-progress.html cũ).
   Chỉ áp dụng cho id hợp lệ trong TAB_REGISTRY, khác 'progress' (đã active sẵn). */
(function openTabFromLocation() {
  let id = (location.hash || '').replace(/^#/, '').trim().toLowerCase();
  if (!id) {
    try { id = (new URLSearchParams(location.search)).get('tab') || ''; } catch (e) { id = ''; }
  }
  if (id && TAB_REGISTRY[id] && id !== 'progress') {
    const btn = document.getElementById('pagetab-' + id);
    if (btn) switchPage(id, btn);
  }
})();

async function nxLoad() {
  _nxLoaded = true;
  const tbody = document.getElementById('nx-tbody');
  try {
    const r = await fetch(API + '/daoanh/api/admin/nexus-translate-status', { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'lỗi không rõ');

    document.getElementById('nx-total').textContent = fmt(d.total_nexus);
    document.getElementById('nx-translated').textContent = fmt(d.total_translated);
    document.getElementById('nx-batches').textContent = fmt(d.total_batches);

    tbody.innerHTML = (d.books || []).map(b => (
      '<tr>' +
        '<td>' + esc(b.book) + '</td>' +
        '<td>' + fmt(b.total_nexus) + '</td>' +
        '<td>' + fmt(b.translated) + '</td>' +
        '<td>' + fmt(b.batches) + '</td>' +
        '<td>' + b.pct + '%</td>' +
        '<td class="note">' + esc(b.note || '') + '</td>' +
      '</tr>'
    )).join('') || '<tr><td colspan="6" style="text-align:center;padding:18px;color:var(--muted)">Chưa có dữ liệu sách nào</td></tr>';
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:18px" class="err">Lỗi tải trạng thái Dịch Nexus: ' + esc(e.message) + '</td></tr>';
  }
}

/* ══════════════════════════════════════════
   Tab Dịch Nexus T514 — so sánh 4 bản dịch (Hán gốc/Gemini/Claude/Codex) + chọn
   bản (chỉ ghi staging JSONL, KHÔNG ghi DB). Nguồn: wt/nexus-translate-tab
   commit 47c0b445, chuyển từ t50-progress.html sang tab riêng ở đây để tách
   khỏi tab "Dịch Nexus" (T458, chỉ hiển thị trạng thái).
   API: /daoanh/api/admin/nexus-translate-search, nexus-translate-select.
══════════════════════════════════════════ */
let _nxsPage = 1;
let _nxsBookOptionsLoaded = false;

async function nxsInit() {
  // Nạp danh sách sách cho dropdown lọc, dùng lại endpoint status (T458) chỉ
  // để lấy tên sách — không gọi search vì search bắt buộc có q hoặc book.
  if (!_nxsBookOptionsLoaded) {
    _nxsBookOptionsLoaded = true;
    try {
      const r = await fetch(API + '/daoanh/api/admin/nexus-translate-status', { headers: { 'X-Session-Token': token() } });
      const d = await r.json();
      if (d.ok) {
        const bookSel = document.getElementById('nxs-book');
        (d.books || []).forEach(b => {
          const opt = document.createElement('option');
          opt.value = b.book; opt.textContent = b.book + ' (' + fmt(b.total_nexus) + ')';
          bookSel.appendChild(opt);
        });
      }
    } catch (e) { /* không chặn tab nếu lỗi — admin vẫn gõ tay tên sách qua ô tìm kiếm */ }
  }
}

function nxsColHtml(nexusId, book, colName, colLabel, col) {
  if (!col) {
    return '<div class="nxs-col"><div class="nxs-col-title">' + esc(colLabel) + '</div>' +
      '<div class="nxs-col-missing">chưa có bản ' + esc(colLabel.toLowerCase()) + '</div></div>';
  }
  const v = col.validation || {};
  const canSelect = !!v.passed;
  const failNotes = (v.checks || []).filter(c => !c.passed).map(c => esc(c.note)).join('; ');
  return '<div class="nxs-col">' +
    '<div class="nxs-col-title">' + esc(colLabel) + '</div>' +
    '<div class="nxs-col-text">' + esc(col.text_vi) + '</div>' +
    (canSelect ? '' : '<div class="nxs-col-rulenote">⚠ chưa qua quy tắc' + (failNotes ? ': ' + failNotes : '') + '</div>') +
    '<button class="nxs-btn-select" ' + (canSelect ? '' : 'disabled') +
    ' onclick="nxsSelect(' + JSON.stringify(nexusId) + ',' + JSON.stringify(book) + ',' + JSON.stringify(colName) + ', this)">' +
    'Chọn bản này</button></div>';
}

function nxsRenderResults(data) {
  const box = document.getElementById('nxs-results');
  if (!data.items.length) {
    box.innerHTML = '<div style="color:var(--muted);text-align:center;padding:30px">Không có kết quả.</div>';
    return;
  }
  box.innerHTML = data.items.map(item =>
    '<div class="nxs-card">' +
      '<div class="nxs-card-hdr"><b>' + esc(item.book) + '</b><span class="nid">' + esc(item.nexus_id) + '</span></div>' +
      '<div class="nxs-grid">' +
        '<div class="nxs-col"><div class="nxs-col-title">Hán văn gốc</div><div class="nxs-col-text zh">' + esc(item.text_zh) + '</div></div>' +
        nxsColHtml(item.nexus_id, item.book, 'gemini', 'Gemini', item.gemini) +
        nxsColHtml(item.nexus_id, item.book, 'claude', 'Claude', item.claude) +
        nxsColHtml(item.nexus_id, item.book, 'codex', 'Codex', item.codex) +
      '</div>' +
    '</div>'
  ).join('');
}

async function nxSearch(page) {
  const q = document.getElementById('nxs-q').value.trim();
  const book = document.getElementById('nxs-book').value;
  if (!q && !book) {
    document.getElementById('nxs-meta').textContent = 'Nhập từ khoá hoặc chọn sách để tìm.';
    return;
  }
  _nxsPage = page || 1;
  const box = document.getElementById('nxs-results');
  box.innerHTML = '<div style="color:var(--muted);text-align:center;padding:30px">Đang tìm…</div>';
  try {
    const params = new URLSearchParams({ q: q, book: book, page: _nxsPage });
    const r = await fetch(API + '/daoanh/api/admin/nexus-translate-search?' + params, { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'lỗi không rõ');
    document.getElementById('nxs-meta').textContent =
      fmt(d.total) + ' kết quả · ' + d.n_rules_active + ' quy tắc đang active · trang ' + d.page;
    nxsRenderResults(d);
    const pager = document.getElementById('nxs-pager');
    pager.style.display = d.total > d.limit ? 'flex' : 'none';
    document.getElementById('nxs-page-info').textContent =
      'Trang ' + d.page + ' / ' + Math.max(1, Math.ceil(d.total / d.limit));
    document.getElementById('nxs-prev').disabled = d.page <= 1;
    document.getElementById('nxs-next').disabled = d.page * d.limit >= d.total;
  } catch (e) {
    box.innerHTML = '<div class="err" style="text-align:center;padding:30px">Lỗi tìm kiếm: ' + esc(e.message) + '</div>';
  }
}

function nxSearchPage(delta) { nxSearch(_nxsPage + delta); }

async function nxsSelect(nexusId, book, source, btnEl) {
  btnEl.disabled = true;
  btnEl.textContent = 'Đang lưu…';
  try {
    const col = btnEl.closest('.nxs-col');
    const text_vi = col.querySelector('.nxs-col-text').textContent;
    const r = await fetch(API + '/daoanh/api/admin/nexus-translate-select', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() },
      body: JSON.stringify({ nexus_id: nexusId, book: book, source: source, text_vi: text_vi }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'lỗi không rõ');
    btnEl.classList.add('picked');
    btnEl.textContent = 'Đã chọn (staging)';
  } catch (e) {
    btnEl.disabled = false;
    btnEl.textContent = 'Chọn bản này';
    alert('Lỗi khi chọn bản dịch: ' + e.message);
  }
}

/* ══════════════════════════════════════════
   Tab T50 — Tiến Độ Dịch Kinh (Dịch / Dừng / job-status / dashboard số liệu)
   Chuyển nguyên logic từ admin/t50-progress.html (Tab 1 "Tiến Độ T50").
   Nguồn: /daoanh/api/admin/t50-progress + /daoanh/api/admin/t50/{run,stop,job-status,enqueue,dequeue}
   KHÔNG mang theo Tab 2 "Đại Tạng Kinh Catalog" / modal đọc kinh của file cũ — ngoài phạm vi yêu cầu
   (Admin chỉ yêu cầu giữ Dịch/Dừng/job-status/dashboard). t50-progress.html cũ giữ nguyên, không đổi.
══════════════════════════════════════════ */
let _t50PollTimer    = null;
let _t50JobRunning   = false;
let _t50CurrentSigla = null;
let _t50Queue        = [];
let _t50ApiAvailable = false;
let _t50ProgressData = null;
const T50_SNAP = API ? '/daoanh/data/t50_progress_snapshot.json' : '../data/t50_progress_snapshot.json';

async function t50Init() { await t50Refresh(); }

async function t50Refresh() {
  let d = null;
  let liveErr = '';
  try {
    const r = await fetch(API + '/daoanh/api/admin/t50-progress', { headers: { 'X-Session-Token': token() } });
    const j = await r.json().catch(() => null);
    if (r.ok && j && j.ok) { d = j; d._src = 'live'; _t50ApiAvailable = true; }
    else { liveErr = (j && j.error) || ('HTTP ' + r.status); }
  } catch (e) { liveErr = e.message; }
  if (!d) {
    try {
      const r = await fetch(T50_SNAP);
      if (r.ok) { d = await r.json(); d._src = 'snapshot'; }
    } catch (_) {}
  }
  if (!d) {
    document.getElementById('t50-main-content').innerHTML =
      '<div style="color:var(--bad);text-align:center;padding:40px">Không tải được dữ liệu T50: ' + esc(liveErr) + '</div>';
    await t50CheckJobStatus();
    return;
  }
  _t50ProgressData = d; t50RenderProgress(d);
  await t50CheckJobStatus();
}

function t50RenderProgress(d) {
  const s = d.summary;
  const srcNote = d._src === 'live' ? '● Live API' : ('📸 Snapshot' + (d.generated_at ? ' · ' + esc(d.generated_at) : ''));

  const cards = '<div class="t50-cards">'
    + '<div class="t50-card t50-c-amber"><div class="lbl">Tổng passage</div><div class="val">' + fmt(s.total_all) + '</div><div class="sub">5 bộ kinh</div></div>'
    + '<div class="t50-card t50-c-green"><div class="lbl">Đã dịch</div><div class="val">' + fmt(s.translated_all) + '</div><div class="sub">' + s.pct_all + '% hoàn thành</div></div>'
    + '<div class="t50-card t50-c-red"><div class="lbl">Còn thiếu</div><div class="val">' + fmt(s.remaining_all) + '</div><div class="sub">vi_text = NULL</div></div>'
    + '<div class="t50-card t50-c-blue"><div class="lbl">Gắn địa danh</div><div class="val">' + fmt(s.place_total) + '</div><div class="sub">' + fmt(s.place_translated) + ' đã dịch (' + s.place_pct + '%)</div></div>'
    + '<div class="t50-card t50-c-purple"><div class="lbl">Bản nháp AI</div><div class="val">' + fmt(s.draft_ai) + '</div><div class="sub">translation_draft=1</div></div>'
    + '<div class="t50-card"><div class="lbl">Cache bản dịch</div><div class="val" style="font-size:20px">' + fmt(s.translation_cache) + '</div><div class="sub">' + s.reported + ' báo sai</div></div>'
    + '</div>';

  const apiNote = !_t50ApiAvailable
    ? '<div class="t50-api-note">Nút Dịch hoạt động sau khi restart server (python app.py). Nguồn: ' + srcNote + '</div>'
    : '<div class="t50-api-note t50-api-ok">Nguồn: ' + srcNote + '</div>';

  const recentRows = (d.recent_translated || []).map(r =>
    '<tr>'
    + '<td style="color:var(--muted)">' + esc(r.text_id || '') + '</td>'
    + '<td style="font-size:10px;color:var(--muted)">' + esc(r.loc_ref || '') + '</td>'
    + '<td style="font-family:\'Noto Serif TC\',serif;color:var(--muted)">' + esc(r.raw_preview || '') + '…</td>'
    + '<td>' + esc(r.vi_preview || '') + '…</td>'
    + '<td>' + (r.translation_draft ? '<span class="t50-badge t50-b-draft">Nháp AI</span>' : '<span class="t50-badge t50-b-human">Tham khảo</span>') + '</td>'
    + '</tr>'
  ).join('');

  document.getElementById('t50-main-content').innerHTML = apiNote + cards
    + '<div class="t50-section" id="t50-sigla-section">'
    +   '<div class="t50-sec-title">Tiến độ theo bộ kinh</div>'
    +   '<div id="t50-sigla-rows"></div>'
    + '</div>'
    + '<div class="t50-section">'
    +   '<div class="t50-sec-title">5 passage mới nhất đã dịch</div>'
    +   '<table class="t50-tbl"><thead><tr><th>Bộ kinh</th><th>Loc</th><th>Hán văn gốc</th><th>Bản dịch Việt</th><th>Loại</th></tr></thead><tbody>' + recentRows + '</tbody></table>'
    + '</div>';

  t50RenderSiglaRows(d.by_sigla || []);
}

function t50RenderSiglaRows(bySigla) {
  const el = document.getElementById('t50-sigla-rows');
  if (!el) return;
  el.innerHTML = bySigla.map(r => {
    const pct = r.pct;
    const fc = pct >= 80 ? '' : pct > 0 ? 'low' : 'zero';
    const isRunning = _t50JobRunning && _t50CurrentSigla === r.sigla;
    const qPos = _t50Queue.indexOf(r.sigla);
    const inQueue = qPos >= 0;

    let btnCls, btnLabel, btnAction;
    if (isRunning) {
      btnCls = 't50-btn-run t50-s-running'; btnLabel = 'Dừng';
      btnAction = 't50StopJob()';
    } else if (inQueue) {
      btnCls = 't50-btn-run t50-s-queued'; btnLabel = '#' + (qPos + 1) + ' chờ';
      btnAction = "t50Dequeue('" + r.sigla + "')";
    } else {
      btnCls = 't50-btn-run';
      btnLabel = _t50JobRunning ? '+ Thêm vào hàng' : 'Dịch';
      btnAction = "t50Enqueue('" + r.sigla + "')";
    }

    return '<div class="t50-sigla-row">'
      + '<div>'
      +   '<div class="t50-sigla-info"><span class="name">' + esc(r.name) + '</span><span class="code">' + esc(r.sigla) + '</span></div>'
      +   '<div class="t50-sigla-stats"><b>' + fmt(r.translated) + '</b> / ' + fmt(r.total) + ' passage &nbsp;·&nbsp; còn '
      +     '<b style="color:' + (r.remaining > 0 ? 'var(--bad)' : 'var(--ok)') + '">' + fmt(r.remaining) + '</b> &nbsp;·&nbsp; nháp AI: ' + fmt(r.draft_ai) + '</div>'
      +   '<div class="t50-prog-bar"><div class="t50-prog-fill ' + fc + '" style="width:' + pct + '%"></div></div>'
      +   '<div class="t50-prog-pct">' + pct + '%</div>'
      + '</div>'
      + '<button class="' + btnCls + '" onclick="' + btnAction + '">' + btnLabel + '</button>'
      + '</div>';
  }).join('');
}

function t50RenderQueuePanel() {
  const panel = document.getElementById('t50-queue-panel');
  const list = document.getElementById('t50-queue-list');
  if (!_t50Queue.length) { panel.classList.remove('visible'); return; }
  panel.classList.add('visible');
  list.innerHTML = _t50Queue.map((s, i) =>
    '<div class="t50-queue-item"><span class="pos">#' + (i + 1) + '</span><span>' + esc(s) + '</span>'
    + '<span class="del" onclick="t50Dequeue(\'' + s + '\')" title="Xóa khỏi hàng đợi">✕</span></div>'
  ).join('');
}

async function t50CheckJobStatus() {
  if (!_t50ApiAvailable) return;
  try {
    const r = await fetch(API + '/daoanh/api/admin/t50/job-status', { headers: { 'X-Session-Token': token() } });
    if (!r.ok) return;
    const j = await r.json();

    const wasRunning = _t50JobRunning;
    _t50JobRunning = j.running;
    _t50CurrentSigla = j.running ? j.sigla : null;
    _t50Queue = j.queue || [];

    if (j.running) {
      document.getElementById('t50-job-sigla').textContent = j.sigla || '—';
      document.getElementById('t50-job-pid').textContent = j.pid || '—';
      document.getElementById('t50-job-started').textContent = j.started_at || '—';
      document.getElementById('t50-job-translated').textContent = fmt(j.translated_total);
      document.getElementById('t50-job-remaining').textContent = fmt(j.remaining_total);
      const logEl = document.getElementById('t50-job-log');
      logEl.textContent = (j.log_tail || []).join('\n') || 'Đang xử lý…';
      logEl.scrollTop = logEl.scrollHeight;
      document.getElementById('t50-job-panel').classList.add('visible');
      t50StartPolling();
    } else {
      document.getElementById('t50-job-panel').classList.remove('visible');
      t50StopPolling();
      if (wasRunning) await t50Refresh();
    }

    t50RenderQueuePanel();
    if (_t50ProgressData) t50RenderSiglaRows(_t50ProgressData.by_sigla || []);
  } catch (_) {}
}

async function t50Enqueue(sigla) {
  if (!_t50ApiAvailable) { alert('Cần restart server (python app.py) để dùng tính năng này.'); return; }
  try {
    const r = await fetch(API + '/daoanh/api/admin/t50/enqueue', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() },
      body: JSON.stringify({ sigla })
    });
    const j = await r.json();
    if (!j.ok) { alert('Lỗi: ' + j.error); return; }
    if (j.action === 'queued') _t50Queue = j.queue || [];
    await t50CheckJobStatus();
  } catch (e) { alert('Không kết nối được server: ' + e.message); }
}

async function t50Dequeue(sigla) {
  if (!_t50ApiAvailable) return;
  try {
    const r = await fetch(API + '/daoanh/api/admin/t50/dequeue', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Session-Token': token() },
      body: JSON.stringify({ sigla })
    });
    const j = await r.json();
    _t50Queue = j.queue || [];
    t50RenderQueuePanel();
    if (_t50ProgressData) t50RenderSiglaRows(_t50ProgressData.by_sigla || []);
  } catch (e) {}
}

async function t50StopJob() {
  if (!_t50ApiAvailable) return;
  try {
    const r = await fetch(API + '/daoanh/api/admin/t50/stop', { method: 'POST', headers: { 'X-Session-Token': token() } });
    const j = await r.json();
    if (!j.ok) alert('Lỗi dừng: ' + j.error);
    await t50CheckJobStatus();
  } catch (e) { alert('Lỗi: ' + e.message); }
}

function t50StartPolling() { if (_t50PollTimer) return; _t50PollTimer = setInterval(t50CheckJobStatus, 3000); }
function t50StopPolling()  { if (_t50PollTimer) { clearInterval(_t50PollTimer); _t50PollTimer = null; } }

/* ══════════════════════════════════════════
   Tab Catalog — Đại Tạng Kinh Catalog
   Chuyển nguyên logic từ admin/t50-progress.html (Tab 2 "Đại Tạng Kinh").
   Nguồn: /daoanh/api/danh-sach-kinh, /daoanh/api/admin/cbeta/batch-import,
          /daoanh/api/kinh/<sigla>/passages
   _CAT_BASE: quirk cũ gọi thẳng port 5002 khi chạy local đã BỊ XÓA (BUG verify
   2026-11-06) — cổng 5002 không chạy, local_gateway 8080 đã có đủ các route
   dùng ở tab này (danh-sach-kinh, cbeta/batch-import, kinh/<sigla>/passages)
   và trả 200 qua cùng origin. Luôn dùng cùng-origin (chuỗi rỗng), khớp với
   cách biến API ở trên (dòng ~396) đã làm cho http/https.
══════════════════════════════════════════ */
const _CAT_BASE = '';

const CAT_LIMIT = 50;
let _catOffset  = 0;
let _catTotal   = 0;
let _catTimer   = null;

function catSearch() {
  clearTimeout(_catTimer);
  _catTimer = setTimeout(() => { _catOffset = 0; catLoad(); }, 350);
}

function catPage(dir) {
  _catOffset = Math.max(0, _catOffset + dir * CAT_LIMIT);
  catLoad();
}

async function catLoad() {
  const q      = document.getElementById('cat-q').value.trim();
  const series = document.getElementById('cat-series').value;
  const status = document.getElementById('cat-status').value;
  const hasVi  = document.getElementById('cat-has-vi').checked;

  let url = _CAT_BASE + '/daoanh/api/danh-sach-kinh?offset=' + _catOffset + '&limit=' + CAT_LIMIT;
  if (q)      url += '&q=' + encodeURIComponent(q);
  if (series) url += '&series=' + encodeURIComponent(series);
  if (status) url += '&status=' + encodeURIComponent(status);
  if (hasVi)  url += '&has_translation=1';

  document.getElementById('cat-tbody').innerHTML =
    '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--muted)">Đang tải…</td></tr>';

  try {
    const r = await fetch(url);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await r.json();
    if (!d.items) throw new Error(d.error || 'API lỗi - không có dữ liệu');

    _catTotal = d.total || 0;

    if (d.stats) {
      document.getElementById('cs-total').textContent = fmt(d.stats.total_catalog);
      document.getElementById('cs-has-vi').textContent = fmt(d.stats.has_translation);
      document.getElementById('pagetab-catalog-cnt').textContent = '(' + fmt(d.stats.total_catalog) + ')';
    }
    document.getElementById('cs-extra').innerHTML = 'Kết quả tìm kiếm: <b>' + fmt(_catTotal) + '</b>';

    renderCatRows(d.items || []);
    renderCatPager();
  } catch (e) {
    document.getElementById('cat-tbody').innerHTML =
      '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--bad)">' + esc(e.message) +
      '<br><small style="color:var(--muted);margin-top:4px;display:block">Kiểm tra server đang chạy tại port 5002</small></td></tr>';
    document.getElementById('cat-pager').style.display = 'none';
  }
}

function renderCatRows(items) {
  if (!items.length) {
    document.getElementById('cat-tbody').innerHTML =
      '<tr><td colspan="7" style="text-align:center;padding:30px;color:var(--muted)">Không tìm thấy kết quả</td></tr>';
    document.getElementById('cat-pager').style.display = 'none';
    return;
  }

  document.getElementById('cat-tbody').innerHTML = items.map(it => {
    const statusHtml = catStatusBadge(it.status);
    const pct = it.p_total > 0 ? Math.round(it.p_translated / it.p_total * 100) : 0;
    const progHtml = it.p_total > 0
      ? '<span class="mini-bar"><span class="mini-fill' + (pct < 30 ? ' low' : '') + '" style="width:' + pct + '%"></span></span>' +
        '<span style="font-size:10px;color:var(--muted);margin-left:5px">' + it.p_translated + '/' + it.p_total + '</span>'
      : '<span style="font-size:10px;color:var(--muted)">—</span>';

    const readBtn = it.p_total > 0
      ? '<button onclick="openModal(\'' + esc(it.sigla) + '\',\'' + esc(it.title_vi || it.sigla) + '\')" ' +
        'style="background:none;border:1px solid var(--line);color:var(--muted);' +
        'padding:3px 9px;border-radius:5px;cursor:pointer;font-size:11px" title="Đọc kinh">📖</button>'
      : '';

    return '<tr>' +
      '<td style="font-weight:700;color:var(--gold);font-size:11px">' + esc(it.sigla) + '</td>' +
      '<td><div style="font-size:12px;font-weight:600;color:var(--text)">' + esc(it.title_vi || '—') + '</div>' +
