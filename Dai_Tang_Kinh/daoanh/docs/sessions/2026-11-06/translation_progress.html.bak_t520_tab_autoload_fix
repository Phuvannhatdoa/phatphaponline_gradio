<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tiến Độ Dịch — Gemini</title>
<style>
  :root { --bg:#020617; --card:#0f172a; --line:#1e293b; --text:#e2e8f0; --muted:#94a3b8; --gold:#d97706; --ok:#22c55e; --warn:#f59e0b; --bad:#ef4444; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:14px/1.5 Inter,system-ui,sans-serif; padding:16px; }
  h1 { font-size:20px; margin:0 0 4px; }
  .sub { color:var(--muted); font-size:12px; margin-bottom:14px; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:10px; margin-bottom:14px; }
  .tile { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:10px 12px; }
  .tile b { display:block; font-size:20px; color:var(--gold); font-variant-numeric:tabular-nums; }
  .tile span { font-size:11px; color:var(--muted); }
  .bar { height:8px; background:var(--line); border-radius:4px; overflow:hidden; margin:6px 0 14px; }
  .bar > div { height:100%; background:var(--gold); }
  .log { background:#020617; border:1px solid var(--line); border-radius:8px; padding:8px 10px; font:11px/1.45 ui-monospace,Consolas,monospace; color:var(--muted); max-height:160px; overflow:auto; white-space:pre-wrap; margin-bottom:14px; }
  .toolbar { display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .btn { background:transparent; color:var(--text); border:1px solid var(--line); border-radius:6px; padding:5px 10px; font-size:12px; cursor:pointer; }
  .btn.active, .btn:hover { border-color:var(--gold); color:var(--gold); }
  .btn.ok { background:var(--ok); color:#052e16; border-color:var(--ok); font-weight:700; }
  .btn[disabled] { opacity:.5; cursor:default; }
  .tbl-wrap { overflow-x:auto; border:1px solid var(--line); border-radius:8px; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.04em; background:var(--card); }
  .han { font-family:"Noto Serif TC",serif; font-size:16px; }
  .note { font-size:11px; color:var(--muted); max-width:340px; white-space:pre-wrap; }
  .mono { font-family:ui-monospace,Consolas,monospace; font-size:11px; color:var(--muted); }
  .badge { font-size:10px; padding:2px 6px; border-radius:4px; border:1px solid var(--line); color:var(--muted); }
  .badge.ok { border-color:var(--ok); color:var(--ok); }
  .badge.wait { border-color:var(--warn); color:var(--warn); }
  input.name { width:100%; min-width:160px; background:#020617; border:1px solid var(--line); color:var(--text); border-radius:5px; padding:5px 7px; font-size:13px; }
  .pager { display:flex; gap:6px; align-items:center; justify-content:center; margin-top:12px; font-size:12px; color:var(--muted); }
  .err { color:var(--bad); font-size:12px; margin:8px 0; }
  .nav { font-size:12px; margin-bottom:10px; }
  .nav a { color:var(--gold); text-decoration:none; }
  .page-tabs { display:flex; gap:6px; margin-bottom:14px; }
  .page-tabs .btn { font-size:13px; padding:6px 14px; }
  .tab-pane { display:none; }
  .tab-pane.active { display:block; }
  .nx-note { background:#451a03; border:1px solid #78350f; color:var(--gold); border-radius:8px; padding:10px 16px; margin-bottom:14px; font-size:13px; }

  /* ─── Tab T50 (nguồn: t50-progress.html, chuyển vào đây T514-b) ─── */
  .t50-api-note { background:#1c1400; border:1px solid #78350f; border-radius:8px; padding:10px 14px; margin-bottom:14px; font-size:12px; color:#fcd34d; }
  .t50-api-note.t50-api-ok { background:#052e16; border-color:#166534; color:var(--ok); }
  .t50-cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(155px,1fr)); gap:12px; margin-bottom:16px; }
  .t50-card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:14px; }
  .t50-card .lbl { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-bottom:5px; }
  .t50-card .val { font-size:24px; font-weight:700; }
  .t50-card .sub { font-size:11px; color:var(--muted); margin-top:3px; }
  .t50-c-green .val { color:var(--ok); } .t50-c-amber .val { color:var(--gold); }
  .t50-c-red .val { color:var(--bad); } .t50-c-blue .val { color:#3b82f6; } .t50-c-purple .val { color:#c084fc; }
  .t50-job-panel { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px 20px; margin-bottom:16px; display:none; }
  .t50-job-panel.visible { display:block; }
  .t50-job-header { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
  .t50-job-title { font-size:13px; font-weight:700; }
  @keyframes t50spin { to { transform:rotate(360deg); } }
  .t50-spin { display:inline-block; animation:t50spin 1s linear infinite; }
  .t50-job-meta { font-size:12px; color:var(--muted); display:flex; gap:16px; flex-wrap:wrap; margin-bottom:10px; }
  .t50-job-meta b { color:var(--text); }
  .t50-log-box { background:#020617; border:1px solid var(--line); border-radius:6px; padding:10px; font-family:ui-monospace,Consolas,monospace; font-size:11px; color:#86efac; max-height:160px; overflow-y:auto; white-space:pre-wrap; }
  .t50-btn-stop { background:#7f1d1d; border:none; color:#fca5a5; padding:6px 14px; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600; margin-top:8px; }
  .t50-btn-stop:hover { background:#991b1b; }
  .t50-queue-panel { background:var(--card); border:1px solid #3730a3; border-radius:10px; padding:14px 18px; margin-bottom:16px; display:none; }
  .t50-queue-panel.visible { display:block; }
  .t50-queue-title { font-size:12px; font-weight:700; color:#a5b4fc; margin-bottom:10px; }
  .t50-queue-list { display:flex; flex-wrap:wrap; gap:8px; }
  .t50-queue-item { display:flex; align-items:center; gap:6px; background:#1e1b4b; border:1px solid #4338ca; border-radius:6px; padding:4px 10px; font-size:12px; color:#c7d2fe; }
  .t50-queue-item .pos { font-weight:700; color:#818cf8; margin-right:2px; }
  .t50-queue-item .del { cursor:pointer; color:#6366f1; margin-left:4px; font-size:10px; }
  .t50-queue-item .del:hover { color:#f87171; }
  .t50-section { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:18px; margin-bottom:18px; }
  .t50-sec-title { font-size:13px; font-weight:700; margin-bottom:14px; }
  .t50-sigla-row { display:grid; grid-template-columns:1fr auto; gap:12px; align-items:center; padding:12px 0; border-bottom:1px solid var(--line); }
  .t50-sigla-row:last-child { border-bottom:none; padding-bottom:0; }
  .t50-sigla-info .name { font-size:13px; font-weight:600; }
  .t50-sigla-info .code { font-size:10px; color:var(--muted); margin-left:6px; }
  .t50-sigla-stats { font-size:11px; color:var(--muted); margin:4px 0 6px; }
  .t50-sigla-stats b { color:var(--text); }
  .t50-prog-bar { height:8px; background:var(--line); border-radius:4px; overflow:hidden; width:100%; }
  .t50-prog-fill { height:100%; border-radius:4px; background:var(--ok); transition:width .4s; }
  .t50-prog-fill.low { background:var(--gold); }
  .t50-prog-fill.zero { background:#374151; }
  .t50-prog-pct { font-size:10px; color:var(--muted); margin-top:2px; }
  .t50-btn-run { border:1px solid #059669; color:#6ee7b7; background:#064e3b; padding:7px 16px; border-radius:6px; cursor:pointer; font-size:12px; font-weight:600; white-space:nowrap; min-width:96px; text-align:center; }
  .t50-btn-run:hover { background:#065f46; }
  .t50-btn-run.t50-s-running { background:#7f1d1d; border-color:#dc2626; color:#fca5a5; }
  .t50-btn-run.t50-s-queued { background:#1e1b4b; border-color:#6366f1; color:#a5b4fc; }
  .t50-tbl { width:100%; border-collapse:collapse; font-size:12px; }
  .t50-tbl th { padding:6px 10px; text-align:left; color:var(--muted); font-weight:600; border-bottom:1px solid var(--line); font-size:10px; text-transform:uppercase; }
  .t50-tbl td { padding:7px 10px; border-bottom:1px solid #0a1122; vertical-align:top; }
  .t50-badge { display:inline-block; font-size:10px; padding:1px 7px; border-radius:10px; }
  .t50-b-draft { background:#451a03; color:var(--gold); }
  .t50-b-human { background:#052e16; color:var(--ok); }
  .t50-loading { text-align:center; padding:60px; color:var(--muted); font-size:14px; }

  /* ─── Tab Catalog (nguồn: t50-progress.html Tab 2, gộp vào đây T50-merge-catalog-tab) ─── */
  .catalog-toolbar { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:16px; }
  .cat-input { background:#0f172a; border:1px solid var(--line); color:var(--text); padding:7px 12px; border-radius:7px; font-size:13px; outline:none; flex:1; min-width:180px; }
  .cat-input:focus { border-color:var(--gold); }
  .cat-select { background:#0f172a; border:1px solid var(--line); color:var(--text); padding:7px 12px; border-radius:7px; font-size:12px; outline:none; cursor:pointer; }
  .cat-select:focus { border-color:var(--gold); }
  .cat-check { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--muted); cursor:pointer; }
  .cat-check input { accent-color:var(--gold); cursor:pointer; }
  .catalog-stats { display:flex; gap:16px; flex-wrap:wrap; margin-bottom:16px; font-size:12px; color:var(--muted); }
  .catalog-stats b { color:var(--text); }
  .catalog-stats .hl { color:var(--gold); }
  .cat-tbl { width:100%; border-collapse:collapse; font-size:12px; }
  .cat-tbl th { padding:7px 10px; text-align:left; color:var(--muted); font-weight:600; border-bottom:1px solid var(--line); font-size:10px; text-transform:uppercase; white-space:nowrap; }
  .cat-tbl td { padding:8px 10px; border-bottom:1px solid #0a1122; vertical-align:middle; }
  .cat-tbl tr:hover td { background:#0a1122; }
  .cat-tbl .zh { font-family:"Noto Serif TC",serif; color:var(--muted); font-size:11px; }
  .bs { display:inline-flex; align-items:center; gap:3px; font-size:10px; padding:2px 8px; border-radius:8px; font-weight:600; }
  .bs-hoan-thanh { background:#052e16; color:#6ee7b7; }
  .bs-dang-dich { background:#451a03; color:var(--warn); }
  .bs-cho-dich { background:#1e3a5f; color:#93c5fd; }
  .bs-chua-co { background:#1e293b; color:var(--muted); }
  .mini-bar { height:6px; background:#1e293b; border-radius:3px; overflow:hidden; width:80px; display:inline-block; vertical-align:middle; }
  .mini-fill { height:100%; border-radius:3px; background:var(--ok); }
  .mini-fill.low { background:var(--gold); }
  .cat-pager { display:flex; align-items:center; gap:8px; justify-content:center; margin-top:14px; flex-wrap:wrap; }
  .pager-btn { background:var(--card); border:1px solid var(--line); color:var(--text); padding:5px 12px; border-radius:6px; cursor:pointer; font-size:12px; }
  .pager-btn:disabled { opacity:.4; cursor:not-allowed; }
  .pager-info { font-size:12px; color:var(--muted); }
  .btn-import { background:#1e1b4b; border:1px solid #6366f1; color:#a5b4fc; padding:7px 16px; border-radius:7px; cursor:pointer; font-size:12px; font-weight:600; }
  .btn-import:hover { background:#2e1065; border-color:#a78bfa; }
  .btn-import:disabled { opacity:.4; cursor:not-allowed; }
  @media(max-width:600px) { .cat-tbl td:nth-child(3), .cat-tbl th:nth-child(3) { display:none; } }

  /* ─── Tab Dịch Nexus T514 (nguồn: wt/nexus-translate-tab, so sánh 4 bản dịch) ─── */
  .nxs-card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:14px; margin-bottom:14px; }
  .nxs-card-hdr { display:flex; align-items:center; gap:10px; margin-bottom:10px; flex-wrap:wrap; }
  .nxs-card-hdr .nid { font-size:11px; color:var(--muted); font-family:ui-monospace,Consolas,monospace; }
  .nxs-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
  .nxs-col { background:#0a1122; border:1px solid var(--line); border-radius:8px; padding:10px; display:flex; flex-direction:column; gap:8px; min-height:90px; }
  .nxs-col-title { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .nxs-col-text { font-size:12px; line-height:1.5; flex:1; white-space:pre-wrap; }
  .nxs-col-text.zh { font-family:"Noto Serif TC",serif; color:var(--text); }
  .nxs-col-missing { font-size:11px; color:var(--muted); font-style:italic; }
  .nxs-col-rulenote { font-size:10px; color:var(--bad); }
  .nxs-btn-select { background:#064e3b; border:1px solid #059669; color:#6ee7b7; padding:5px 10px; border-radius:6px; cursor:pointer; font-size:11px; font-weight:600; }
  .nxs-btn-select:hover { background:#065f46; }
  .nxs-btn-select:disabled { opacity:.35; cursor:not-allowed; background:var(--line); border-color:var(--line); color:var(--muted); }
  .nxs-btn-select.picked { background:#78350f; border-color:var(--gold); color:var(--gold); }
  @media(max-width:900px) { .nxs-grid { grid-template-columns:1fr 1fr; } }
  @media(max-width:600px) { .nxs-grid { grid-template-columns:1fr; } }
</style>
</head>
<body>
<div class="nav"><a href="index.html">← Thống kê admin</a></div>
<h1>Tiến Độ Dịch — Gemini</h1>
<div class="sub">Gemini phiên âm tên địa danh Hán → Việt theo đợt chạy. Chấp thuận một dòng = ghi vào DB để trang HOME hiển thị. Mọi lần chấp thuận được ghi nhật ký để hoàn tác.</div>

<div class="page-tabs">
  <button class="btn active" id="pagetab-progress" onclick="switchPage('progress', this)">Tiến Độ Dịch</button>
  <button class="btn" id="pagetab-nexus" onclick="switchPage('nexus', this)">
    Dịch Nexus <span id="pagetab-nexus-cnt" style="color:var(--muted)">(T458)</span>
  </button>
  <button class="btn" id="pagetab-t50" onclick="switchPage('t50', this)">T50 — Dịch Kinh</button>
  <button class="btn" id="pagetab-catalog" onclick="switchPage('catalog', this)">
    Catalog Đại Tạng Kinh <span id="pagetab-catalog-cnt" style="color:var(--muted)"></span>
  </button>
  <button class="btn" id="pagetab-nexus-t514" onclick="switchPage('nexus-t514', this)">
    Dịch Nexus T514
  </button>
  <button class="btn" id="pagetab-person" onclick="switchPage('person', this)">
    Dịch ID Person <span id="pagetab-person-cnt" style="color:var(--muted)"></span>
  </button>
  <button class="btn" id="pagetab-place" onclick="switchPage('place', this)">
    Dịch ID Place <span id="pagetab-place-cnt" style="color:var(--muted)"></span>
  </button>
</div>

<div id="tab-progress" class="tab-pane active">
<div id="err" class="err"></div>

<div class="tiles">
  <div class="tile"><b id="t-total">—</b><span>Địa danh DILA</span></div>
  <div class="tile"><b id="t-done">—</b><span>Gemini đã dịch</span></div>
  <div class="tile"><b id="t-approved">—</b><span>Admin đã chấp thuận</span></div>
  <div class="tile"><b id="t-pending">—</b><span>Chờ Admin duyệt</span></div>
  <div class="tile"><b id="t-orphan">—</b><span>Gemini dịch nhưng không khớp địa danh DILA</span></div>
  <div class="tile"><b id="t-last" style="font-size:13px">—</b><span>Vị trí gần nhất (ID · thời gian)</span></div>
</div>
<div class="bar"><div id="bar-done" style="width:0%"></div></div>

<div class="log" id="log">Đang tải nhật ký…</div>

<div class="toolbar">
  <button class="btn active" data-f="all">Tất cả</button>
  <button class="btn" data-f="pending">Chờ duyệt</button>
  <button class="btn" data-f="approved">Đã chấp thuận</button>
  <span style="margin-left:auto;font-size:12px;color:var(--muted)" id="count"></span>
</div>

<div class="tbl-wrap">
<table>
  <thead>
    <tr>
      <th>Place ID</th>
      <th>Thông tin gốc (Hán + ghi chú DILA)</th>
      <th>Gemini dịch</th>
      <th>Tên đang dùng (HOME)</th>
      <th>Trạng thái</th>
      <th>Chấp thuận</th>
    </tr>
  </thead>
  <tbody id="body"><tr><td colspan="6" style="color:var(--muted);text-align:center;padding:18px">Đang tải…</td></tr></tbody>
</table>
</div>
<div class="pager" id="pager"></div>

</div><!-- /tab-progress -->

<div id="tab-nexus" class="tab-pane">

  <div class="nx-note">
    <i class="fa-solid fa-circle-info"></i>
    Chờ Admin duyệt pilot + schema (T458). Tab này chỉ hiển thị trạng thái
    staging JSONL, không có nút chạy dịch / nạp DB, không gọi Gemini/Codex.
  </div>

  <div class="tiles">
    <div class="tile"><b id="nx-total">—</b><span>Tổng nexus</span></div>
    <div class="tile"><b id="nx-translated">—</b><span>Đã dịch (staging)</span></div>
    <div class="tile"><b id="nx-batches">—</b><span>Số batch</span></div>
  </div>

  <div class="tbl-wrap">
    <table>
      <thead>
        <tr>
          <th>Sách (book)</th>
          <th style="width:120px">Tổng nexus</th>
          <th style="width:120px">Đã dịch</th>
          <th style="width:90px">Batch</th>
          <th style="width:90px">%</th>
          <th>Ghi chú</th>
        </tr>
      </thead>
      <tbody id="nx-tbody">
        <tr><td colspan="6" style="text-align:center;padding:18px;color:var(--muted)">Đang tải…</td></tr>
      </tbody>
    </table>
  </div>

</div><!-- /tab-nexus -->

<div id="tab-t50" class="tab-pane">

  <div class="t50-queue-panel" id="t50-queue-panel">
    <div class="t50-queue-title">Hàng đợi — sẽ tự chạy lần lượt sau khi bộ hiện tại xong</div>
    <div class="t50-queue-list" id="t50-queue-list"></div>
  </div>

  <div class="t50-job-panel" id="t50-job-panel">
    <div class="t50-job-header">
      <span class="t50-spin">⏳</span>
      <span class="t50-job-title">Đang dịch: <span id="t50-job-sigla">—</span></span>
    </div>
    <div class="t50-job-meta">
      <span>PID: <b id="t50-job-pid">—</b></span>
      <span>Bắt đầu: <b id="t50-job-started">—</b></span>
      <span>Đã dịch tổng: <b id="t50-job-translated">—</b></span>
      <span>Còn lại: <b id="t50-job-remaining">—</b></span>
    </div>
    <div class="t50-log-box" id="t50-job-log">Đang chờ log…</div>
    <button class="t50-btn-stop" onclick="t50StopJob()">Dừng job</button>
  </div>

  <div id="t50-main-content"><div class="t50-loading">Đang tải…</div></div>

</div><!-- /tab-t50 -->

<div id="tab-catalog" class="tab-pane">

  <div class="catalog-stats" id="cat-stats">
    <span>Tổng bộ kinh: <b id="cs-total">—</b></span>
    <span>Có bản dịch: <b class="hl" id="cs-has-vi">—</b></span>
    <span id="cs-extra"></span>
  </div>

  <div class="catalog-toolbar">
    <input class="cat-input" id="cat-q" type="text" placeholder="🔍 Tìm tên kinh, ký hiệu…" oninput="catSearch()">
    <select class="cat-select" id="cat-series" onchange="catSearch()">
      <option value="">Tất cả bộ</option>
      <option value="T">T — Chính tạng</option>
      <option value="X">X — Vạn Tục Tạng</option>
      <option value="J">J — Gia Hưng</option>
      <option value="B">B — Bắc Tạng</option>
      <option value="A">A — Cao Ly</option>
      <option value="K">K — Cao Ly Tân</option>
      <option value="S">S — Tống Tạng</option>
      <option value="C">C — Trung Hoa Đại Tạng</option>
      <option value="L">L — Càn Long</option>
      <option value="F">F — Phương Sách</option>
      <option value="U">U — Lỗi Ma Pháp Hội</option>
      <option value="I">I — I Tsing</option>
    </select>
    <select class="cat-select" id="cat-status" onchange="catSearch()">
      <option value="">Mọi trạng thái</option>
      <option value="hoan_thanh">✅ Hoàn thành</option>
      <option value="dang_dich">🟡 Đang dịch</option>
      <option value="cho_dich">🔵 Chờ dịch</option>
