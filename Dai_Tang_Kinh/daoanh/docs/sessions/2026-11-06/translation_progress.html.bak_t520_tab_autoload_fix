let _psFilter = 'all';
let _psPage = 1;
let _psPages = 1;
let _psTotalItems = 0;
const PS_LIMIT = 50;

let _psJobRunning = false;
let _psJobPaused = false;
let _psJobQueue = [];           // danh sách person_id chờ dịch
let _psJobIndex = 0;            // vị trí hiện tại trong queue
let _psJobStats = { done: 0, error: 0, rateLimit: 0 };
let _psPollTimer = null;

async function psInit() {
  await psLoadStats();
  await psLoadList();
}

async function psLoadStats() {
  try {
    const r = await fetch(API + '/daoanh/api/dila/persons/stats', { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'API lỗi');
    document.getElementById('ps-total').textContent = fmt(d.total);
    document.getElementById('ps-translated').textContent = fmt(d.translated_saved);
    document.getElementById('ps-draft').textContent = fmt(d.translated_draft);
    document.getElementById('pagetab-person-cnt').textContent = '(' + fmt(d.total) + ')';
    const withBio = d.with_bio_zh;
    const pending = withBio - d.translated_saved - d.translated_draft;
    document.getElementById('ps-pending').textContent = fmt(Math.max(0, pending));
    document.getElementById('ps-nozh').textContent = fmt(d.total - withBio);
    const pct = d.total ? (d.translated_saved * 100 / d.total) : 0;
    document.getElementById('ps-bar').style.width = Math.min(100, pct).toFixed(1) + '%';
  } catch (e) {
    document.getElementById('ps-err').textContent = 'Lỗi tải thống kê: ' + e.message;
  }
}

async function psLoadList(resetPage = true) {
  if (resetPage) _psPage = 1;
  document.getElementById('ps-body').innerHTML = '<tr><td colspan="7" style="color:var(--muted);text-align:center;padding:18px">Đang tải…</td></tr>';
  try {
    const url = API + '/daoanh/api/dila/persons?limit=' + PS_LIMIT + '&offset=' + ((_psPage - 1) * PS_LIMIT) + '&status=' + _psFilter;
    const r = await fetch(url, { headers: { 'X-Session-Token': token() } });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error || 'API lỗi');
    _psTotalItems = d.total;
    _psPages = Math.ceil(_psTotalItems / PS_LIMIT);
    document.getElementById('ps-count').textContent = fmt(d.total) + ' dòng';
    psRenderRows(d.items);
    psRenderPager();
  } catch (e) {
    document.getElementById('ps-body').innerHTML = '<tr><td colspan="7" style="color:var(--bad);text-align:center;padding:18px">Lỗi: ' + esc(e.message) + '</td></tr>';
    document.getElementById('ps-pager').innerHTML = '';
  }
}

function psRenderRows(items) {
  const body = document.getElementById('ps-body');
  if (!items.length) {
    body.innerHTML = '<tr><td colspan="7" style="color:var(--muted);text-align:center;padding:18px">Không có dữ liệu</td></tr>';
    return;
  }
  body.innerHTML = items.map(it => {
    let statusHtml, actionHtml;
    if (it.bio_vi_saved) {
      statusHtml = '<span class="badge ok">✓ Đã lưu</span>';
      actionHtml = '<button class="btn" disabled>✓ Đã có bio_vi</button>';
    } else if (it.draft_status) {
      statusHtml = '<span class="badge wait">✎ Nháp AI (' + esc(it.draft_status) + ')</span>';
      actionHtml = '<button class="btn" onclick="psTranslateOne(\'' + esc(it.id) + '\')" style="background:#1e3a5f;border-color:#3b82f6;color:#93c5fd">Dịch lại</button>';
    } else if (it.has_bio_zh) {
      statusHtml = '<span class="badge" style="border-color:var(--gold);color:var(--gold)">⏳ Chờ dịch</span>';
      actionHtml = '<button class="btn ok" onclick="psTranslateOne(\'' + esc(it.id) + '\')">Dịch ngay</button>';
    } else {
      statusHtml = '<span class="badge" style="border-color:var(--muted);color:var(--muted)">— Không Hán văn</span>';
      actionHtml = '<button class="btn" disabled>Không thể dịch</button>';
    }
    const nameVi = it.name_vi ? '<span style="color:var(--ok)">' + esc(it.name_vi) + '</span>' : '<span style="color:var(--muted)">—</span>';
    const sect = it.sect ? '<span class="badge">' + esc(it.sect) + '</span>' : '<span style="color:var(--muted)">—</span>';
    const dynasty = it.dynasty ? '<span style="color:var(--muted)">' + esc(it.dynasty) + '</span>' : '<span style="color:var(--muted)">—</span>';
    return '<tr>' +
      '<td class="mono"><a href="/daoanh/admin/person.html?id=' + esc(it.id) + '" target="_blank" style="color:var(--gold)">' + esc(it.id) + '</a></td>' +
      '<td class="han">' + esc(it.name_zh || '') + '</td>' +
      '<td>' + nameVi + '</td>' +
      '<td>' + sect + '</td>' +
      '<td>' + dynasty + '</td>' +
      '<td>' + statusHtml + '</td>' +
      '<td>' + actionHtml + '</td>' +
