{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md"
  ],
  "permission": {
    "external_directory": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "config/**": "deny"
    },
    "edit": {
      "*": "allow",
      "data/**": "deny",
      ".env": "deny",
      ".env.*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "node --check *": "allow",
      "python -X utf8 *": "allow",
      "python -m py_compile *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "pip *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "du *": "allow",
      "Get-*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git add *": "allow",
      "git read-tree*": "allow",
      "git write-tree*": "allow",
      "git commit-tree*": "allow",
      "git hash-object*": "allow",
      "git commit *": "allow",
      "powershell -ExecutionPolicy Bypass -File *notify_done.ps1*": "allow",
      "git reset*": "ask",
      "git checkout*": "ask",
      "git restore *": "ask",
      "git update-ref*": "ask",
      "git update-index *": "allow",
      "git stash*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "python * --apply*": "ask",
      "python * --revert*": "ask",
      "python * --reset*": "ask",
      "python *ai_batch_transliterate*": "ask",
      "npm run deploy*": "ask",
      "sudo *": "deny",
      "git push*": "deny",
      "git clean*": "deny",
      "git gc*": "deny",
      "git filter*": "deny",
      "git reset --hard*": "deny",
      "rm -rf *": "deny",
      "Remove-Item -Recurse*": "deny",
      "sqlite3 * DROP *": "deny",
      "sqlite3 * DELETE *": "deny"
    },
    "task": "allow"
  }
}