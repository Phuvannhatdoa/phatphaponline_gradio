<ex:monk/minh_hai_phap_bao> rdfs:label "明海法寶"@zh-Hant .

<https://www.phatphaponline.org/resource/source-record/ptda-minh-hai/2026-10-10> a pth:SourceRecord, prov:Entity ;
    pth:sourceCode "LOCAL" ;
    pth:sourceRecordId "PTDA-Admin-Minh-Hai-2026-10-10" ;
    dct:hasVersion "2026-10-10" ;
    dct:creator "Admin Phật Tổ Đạo Ảnh"@vi ;
    dct:date "2026-10-10"^^xsd:date ;
    pth:independenceKey "ptda-admin-minh-hai-2026-10-10" ;
    dct:bibliographicCitation "Xác nhận của Admin PTDA ngày 10-10-2026: dùng TTL local Minh Hải Pháp Bảo làm hồ sơ gốc trong lúc chờ định danh DILA; cùng xuất xứ tu học/pháp mạch Báo Tư với Nguyên Thiều Siêu Bạch (Thọ Tông); khai tổ nhánh Lâm Tế Chúc Thánh Việt Nam; giữ số đời 71 tính từ Ma Ha Ca Diếp."@vi .

# 71 là số đã có trong legacy và được Admin giữ nguyên; không tạo ba nguồn giả.
<https://www.phatphaponline.org/resource/assertion/ptda-minh-hai/generation-2026-10-10>
    a pth:Assertion, rdf:Statement, prov:Entity ;
    rdf:subject <ex:monk/minh_hai_phap_bao> ;
    rdf:predicate bkg:generationOrder ;
    rdf:object 71 ;
    pth:status "source_asserted" ;
    pth:countingScheme "Thiền Tông toàn mạch; gốc Ma Ha Ca Diếp; Ma Ha Ca Diếp = 1; phạm vi số đời tính từ Ma Ha Ca Diếp."@vi ;
    pth:derivationMethod "admin_confirmation_retaining_legacy_value" ;
    pth:rationale "Số đời trước và sau đều là 71. Admin xác nhận quy ước đếm, không tăng đời hay suy số từ tên chữ bối. Chưa xác minh ba gốc sử liệu độc lập cho toàn đường truyền; không tự nâng thành accepted trong hệ v2 hoặc kích hoạt tính số đời toàn corpus."@vi ;
    prov:wasDerivedFrom <https://www.phatphaponline.org/resource/source-record/ptda-minh-hai/2026-10-10> .
