<https://www.phatphaponline.org/resource/assertion/97f97992-e82d-510a-ab0c-fa27b412584d/dila_17> a rdf:Statement,
        prov:Entity,
        pth:Assertion ;
    rdf:object """明州雪竇重顯禪師，智門光祚禪師法嗣，大鑑下第十世。從益州普安院仁詵出家，後參智門祚得法。出居吳門之洞庭，遷四明之雪竇。與瑯邪慧覺，同稱「二甘露門」。寂後仁宗賜號「明覺禪師」。有《洞庭語錄》、《雪竇開堂錄》、《瀑泉集》、《祖英集》、《頌古集》、《拈古集》、《雪竇後錄》七集。法嗣有天衣義懷、報本有蘭等六人。
（T51n2077_p0473c13；佛光：3985；佛名：501）"""@zh-Hant ;
    rdf:predicate bkg:biographicalNote ;
    rdf:subject <https://www.phatphaponline.org/resource/person/97f97992-e82d-510a-ab0c-fa27b412584d> ;
    prov:wasDerivedFrom <https://www.phatphaponline.org/resource/source-record/97f97992-e82d-510a-ab0c-fa27b412584d/dila_record> ;
    pth:derivationMethod "DILA_TEI_record" ;
    pth:status "source_asserted" .

