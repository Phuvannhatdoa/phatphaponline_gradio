db-snapshot:2fe064a8d61a5ee7f003b9262b84fb66fc21465cafaa74171b20c67f8ab5f0c0\"}, {\"citation\": \"DB cbeta_person_mentions; giữ sigla, juan, page, context\", \"code\": \"CBETA\", \"id\": \"db_cbeta\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"c0c531ee21e30e8f6ca3bb61993c27b66f7271a3ef653b1274a3e3bec4b83a9f\", \"snapshot\": [{\"cbeta_text_sigla\": \"X77n1524\", \"context_snippet\": \"卷第一 　序 　　譯經篇第一 宋天息灾法天施護三師　法護惟淨二師 金蘇陀室利附寶公慧洪　元帝師󳱑思八 　金剛上師　佛智三藏 　必蘭納識理　雪磵法禎 明西天國師附桑渴巴辣　具生吉祥大師附底哇答思 卷第二 　　義解篇第二 宋四明知禮法師附尚賢　慈雲懺主遵式  　長水子璿法師　從雅少康二師 　本如子琳二公　思悟慧舟二公 　霅川仁岳　亞休惟巳 　無象元淨　繼忠左伸二師 　從諫希最二師　超果靈炤 　介然能師\", \"dila_person_id\": \"A008431\", \"id\": 58495, \"juan\": \"\", \"page\": \"0365a\", \"person_name_zh\": \"鼓山道升\"}], \"version\": \"db-snapshot:c0c531ee21e30e8f6ca3bb61993c27b66f7271a3ef653b1274a3e3bec4b83a9f\"}, {\"citation\": \"DB Marcus; giữ loại cạnh nguyên bản, không chuyển mạng thành truyền pháp\", \"code\": \"MARCUS\", \"id\": \"db_marcus\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"33e853e20d7689ce66ac44467a90acaa7f8c16c95b043b4c179ab10994b1419c\", \"snapshot\": {\"edges\": [{\"created_at\": \"2026-04-23 04:34:32\", \"id\": 3925, \"ref\": \"（望月‧卷六‧附錄：050）; \", \"relation_type\": \"da:isTeacherOf\", \"source_data\": \"MARCUS\", \"student_id\": \"A008431\", \"student_label\": \"慧升\", \"teacher_id\": \"A007993\", \"teacher_label\": \"端裕\"}], \"mapping\": [{\"created_at\": \"2026-08-18 12:46:41\", \"marcus_node_id\": \"A008431\", \"match_confidence\": 1.0, \"match_method\": \"exact_id\", \"person_id\": \"A008431\"}], \"people\": [{\"birth_year\": null, \"created_at\": \"2026-07-29 08:31:50\", \"death_year\": null, \"label\": \"慧升\", \"label_vi\": \"Huệ Thăng\", \"label_vi_confidence\": 0.5, \"label_vi_source\": \"auto_hanviet_T51f\", \"node_id\": \"A008431\"}]}, \"version\": \"db-snapshot:33e853e20d7689ce66ac44467a90acaa7f8c16c95b043b4c179ab10994b1419c\"}]}"^^rdf:JSON ;
