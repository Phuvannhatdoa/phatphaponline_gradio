"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"鼓山道升\"}, \"predicate\": \"http://www.w3.org/2004/02/skos/core#altLabel\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_7\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"卒於：南宋, 孝宗, 淳熙, 三年，79歲\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#sourceNote\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_8\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"南宋\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#dynasty\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_9\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"建安\\n      PL000000018314\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#placeOfOrigin\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_10\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"臨濟宗 楊岐派\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#sourceNote\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_11\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"是\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#sourceNote\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_12\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"泉州延福寒巖慧升禪師，亦作道升禪師，吳氏子。佛智端裕（1085-1150）禪師法嗣，大鑑下第十七世。母歿，至長樂出家，侍佛智移靈隱，居元座，後還里結菴曰「寒巖」。李敦帥閔，延住支提山，遷承天、黃龍、泐潭。後歸建安，史丞相帥福，請住鼓山。 （T51n2077_p0680c25；X82n1571_p0123c13；X84n1583_p0433a19；佛名：800）\"}, \"predicate\": \"http://www.phatphaponline.org/ontology/buddhist-kg#biographicalNote\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_13\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"增修雲林寺志‧卷3‧寒巖升禪師\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#mentionedIn\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_14\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"+1098-01-01 ~ +1098-12-31\\n    依記錄推算。\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#birthDateExpression\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_15\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"+1176-02-19 ~ +1177-02-07\\n    一說年七十九，一說壽六十九。（疑年錄：266；X84n1583_p0433a19）\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#deathDateExpression\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_16\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"( CBETA X77n1524_p0450b15 ) 補續高僧傳: 道升傳\\n    ( CBETA X82n1571_p0123c13 )\\n    g010p0420(明州阿育王山志) { 慧升 } \\n    g010p0478(明州阿育王山志) { 寒巖慧升 }\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#mentionedIn\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_17\", \"object\": {\"kind\": \"literal\", \"value\": \"Male\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#gender\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_18\", \"object\": {\"kind\": \"iri\", \"value\": \"https://www.phatphaponline.org/ontology/daoanh#Monastic\"}, \"predicate\": \"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\"], \"id\": \"dila_19\", \"object\": {\"kind\": \"iri\", \"value\": \"http://www.cidoc-crm.org/cidoc-crm/E21_Person\"}, \"predicate\": \"http://www.w3.org/1999/02/22-rdf-syntax-ns#type\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"DILA_TEI_record\", \"evidence\": [\"dila_record\", \"relation_1\"], \"id\": \"dila_20\", \"object\": {\"kind\": \"iri\", \"value\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#teacherOf\", \"rationale\": \"（望月‧卷六‧附錄：050）\", \"relation_scope\": \"DILA raw type=teacher; chưa xác nhận là truyền pháp\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/31f79e9a-3ad4-5b42-9a75-19603045f02e\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people\"], \"id\": \"db_21\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"慧升\"}, \"predicate\": \"http://www.w3.org/2000/01/rdf-schema#label\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people\"], \"id\": \"db_22\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"泉州延福寒巖慧升禪師，亦作道升禪師，吳氏子。佛智端裕（1085-1150）禪師法嗣，大鑑下第十七世。母歿，至長樂出家，侍佛智移靈隱，居元座，後還里結菴曰「寒巖」。李敦帥閔，延住支提山，遷承天、黃龍、泐潭。後歸建安，史丞相帥福，請住鼓山。 （T51n2077_p0680c25；X82n1571_p0123c13；X84n1583_p0433a19；佛名：800）\"}, \"predicate\": \"http://www.phatphaponline.org/ontology/buddhist-kg#biographicalNote\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people\"], \"id\": \"db_23\", \"object\": {\"kind\": \"literal\", \"value\": \"南宋\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#dynasty\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people\"], \"id\": \"db_24\", \"object\": {\"kind\": \"literal\", \"value\": \"1085\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#birthYear\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people\"], \"id\": \"db_25\", \"object\": {\"kind\": \"literal\", \"value\": \"1150\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#deathYear\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people\"], \"id\": \"db_26\", \"object\": {\"kind\": \"literal\", \"value\": \"Thiền Tông\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#lineageMembership\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_people_vi\"], \"id\": \"db_27\", \"object\": {\"kind\": \"literal\", \"language\": \"vi\", \"value\": \"Tuệ Thăng\"}, \"predicate\": \"http://www.w3.org/2000/01/rdf-schema#label\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_identity\", \"dila_record\"], \"id\": \"db_28\", \"object\": {\"kind\": \"literal\", \"value\": \"A008431\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#dilaId\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_vpa_e517ad48c13ce005\"], \"id\": \"db_29\", \"object\": {\"kind\": \"literal\", \"language\": \"vi\", \"value\": \"Diên Phúc Tuệ Thăng\"}, \"predicate\": \"http://www.w3.org/2000/01/rdf-schema#label\", \"status\": \"legacy_unverified\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"counting_scheme\": \"\", \"derivation\": \"system_DB_export\", \"evidence\": [\"db_vpa_e517ad48c13ce005\"], \"id\": \"db_30\", \"object\": {\"kind\": \"literal\", \"language\": \"vi\", \"value\": \"Thiền sư Tuệ Thăng ở Diên Phước\\nThiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\\n\\nCó lúc lên giảng đường, Sư hét một tiếng rồi bảo:\\n\\n“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\\n\\nSư lại hét một tiếng và tiếp bảo:\\n\\n– Rất kỵ chuyển hơi xúc phạm húy.\"}, \"predicate\": \"http://www.phatphaponline.org/ontology/buddhist-kg#biographicalNote\", \"status\": \"legacy_unverified\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"counting_scheme\": \"\", \"derivation\": \"system_DB_export\", \"evidence\": [\"db_vpa_e517ad48c13ce005\"], \"id\": \"db_31\", \"object\": {\"kind\": \"literal\", \"language\": \"vi\", \"value\": \"Dòng Lâm Tế Dương Kỳ\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#lineageMembership\", \"status\": \"legacy_unverified\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"counting_scheme\": \"legacy_unspecified\", \"derivation\": \"system_DB_export\", \"evidence\": [\"db_vpa_e517ad48c13ce005\"], \"id\": \"db_32\", \"object\": {\"datatype\": \"http://www.w3.org/2001/XMLSchema#integer\", \"kind\": \"literal\", \"value\": \"50\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#generationNumber\", \"status\": \"legacy_unverified\", \"subject\": \"https://www.phatphap