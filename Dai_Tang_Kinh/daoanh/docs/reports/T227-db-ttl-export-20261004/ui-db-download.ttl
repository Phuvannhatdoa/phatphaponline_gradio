: \"https://www.phatphaponline.org/ontology/daoanh#teacherOf\", \"rationale\": \"\", \"relation_scope\": \"DB da:isTeacherOf; không tự nâng thành truyền pháp\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/31f79e9a-3ad4-5b42-9a75-19603045f02e\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_edges_MARCUS\"], \"id\": \"db_48\", \"object\": {\"kind\": \"iri\", \"value\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, \"original_predicate\": \"da:isTeacherOf\", \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#teacherOf\", \"rationale\": \"（望月‧卷六‧附錄：050）; \", \"relation_scope\": \"DB da:isTeacherOf; không tự nâng thành truyền pháp\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/31f79e9a-3ad4-5b42-9a75-19603045f02e\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_edges_TTL\"], \"id\": \"db_49\", \"object\": {\"kind\": \"iri\", \"value\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, \"original_predicate\": \"hasTeacher\", \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#teacherOf\", \"rationale\": \"TS-Dien-Phuc-Tue-Thang\", \"relation_scope\": \"DB da:isTeacherOf; không tự nâng thành truyền pháp\", \"status\": \"source_asserted\", \"subject\": \"https://www.phatphaponline.org/resource/person/31f79e9a-3ad4-5b42-9a75-19603045f02e\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_cbeta\"], \"id\": \"db_50\", \"object\": {\"kind\": \"literal\", \"language\": \"zh-Hant\", \"value\": \"{\\\"id\\\": 58495, \\\"cbeta_text_sigla\\\": \\\"X77n1524\\\", \\\"dila_person_id\\\": \\\"A008431\\\", \\\"person_name_zh\\\": \\\"鼓山道升\\\", \\\"juan\\\": \\\"\\\", \\\"page\\\": \\\"0365a\\\", \\\"context_snippet\\\": \\\"卷第一 　序 　　譯經篇第一 宋天息灾法天施護三師　法護惟淨二師 金蘇陀室利附寶公慧洪　元帝師󳱑思八 　金剛上師　佛智三藏 　必蘭納識理　雪磵法禎 明西天國師附桑渴巴辣　具生吉祥大師附底哇答思 卷第二 　　義解篇第二 宋四明知禮法師附尚賢　慈雲懺主遵式  　長水子璿法師　從雅少康二師 　本如子琳二公　思悟慧舟二公 　霅川仁岳　亞休惟巳 　無象元淨　繼忠左伸二師 　從諫希最二師　超果靈炤 　介然能師\\\"}\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#mentionedIn\", \"status\": \"draft\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, {\"derivation\": \"system_DB_export\", \"evidence\": [\"db_marcus\"], \"id\": \"db_51\", \"object\": {\"kind\": \"literal\", \"value\": \"MARCUS:A008431\"}, \"predicate\": \"https://www.phatphaponline.org/ontology/daoanh#externalIdentifier\", \"status\": \"draft\", \"subject\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}], \"created_at\": \"2026-10-04T04:08:44.403447+00:00\", \"legacy_turtle\": \"\\t@prefix bkg: <http://www.phatphaponline.org/ontology/buddhist-kg#> .\\r\\n@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .\\r\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\r\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\r\\n\\r\\n<ex:monk/dien_phuc_tue_thang> a <bkg:Monk> ;\\r\\n    rdfs:label \\\"Diên Phúc Tuệ Thăng\\\"@vi ;\\r\\n    crm:P1_is_identified_by <ex:monk/dien_phuc_tue_thang> ;        \\r\\n    bkg:biographicalNote \\\"\\\"\\\" \\r\\n\\tThiền sư Tuệ Thăng ở Diên Phước\\r\\nThiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\\r\\n\\r\\nCó lúc lên giảng đường, Sư hét một tiếng rồi bảo:\\r\\n\\r\\n“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\\r\\n\\r\\nSư lại hét một tiếng và tiếp bảo:\\r\\n\\r\\n– Rất kỵ chuyển hơi xúc phạm húy.\\r\\n\\\"\\\"\\\"@vi ;\\r\\n    bkg:birthEvent <ex:monk/dien_phuc_tue_thang_birthEvent> ;\\r\\n    bkg:deathEvent <ex:monk/dien_phuc_tue_thang_deathEvent> ;\\r\\n    bkg:dharmaLineageName \\\"Dòng Lâm Tế Dương Kỳ\\\"@vi ;\\r\\n    bkg:gender <bkg:Male> ;\\r\\n    bkg:generationOrder 50;    \\t\\r\\n    bkg:hasTeacher <ex:monk/dien_phuc_tue_thang>;  \\r\\n\\tbkg:isLineageFounder false .\\r\\n\\r\\n<ex:monk/dien_phuc_tue_thang> rdfs:label \\\"Dục Vương Đoan Dụ\\\"@vi .   \\r\\n<ex:monk/tinh_tu_su_nhat> rdfs:label \\\"Tịnh Từ Sư Nhất\\\"@vi .   \\r\\n<ex:monk/dao_trang_phap_toan> rdfs:label \\\"Đạo Tràng Pháp Toàn\\\"@vi .   \\r\\n<ex:monk/thanh_luong_than> rdfs:label \\\"Thanh Lương Thản\\\"@vi .   \\r\\n\\r\\n\\r\\n\", \"person\": {\"dila_id\": \"A008431\", \"entity_type\": \"Monastic\", \"key\": \"7d29610f-0cf4-5ed5-aba8-813c9434956b\", \"legacy_slug\": \"\", \"name_vi\": \"Diên Phúc Tuệ Thăng\", \"name_zh\": \"慧升\", \"uri\": \"https://www.phatphaponline.org/resource/person/7d29610f-0cf4-5ed5-aba8-813c9434956b\"}, \"profile_version\": \"2.0.0\", \"sources\": [{\"citation\": \"DILA TEI person xml:id=A008431\", \"code\": \"DILA\", \"dataset_url\": \"https://github.com/DILA-edu/Authority-Databases\", \"id\": \"dila_record\", \"record_id\": \"A008431\", \"record_url\": \"https://authority.dila.edu.tw/person/search.php?aid=A008431\", \"retrieved_at\": \"2026-10-04T04:16:03.551879+00:00\", \"rights_status\": \"pending_registry_review\", \"sha256\": \"7f600cdf48045750ed9572e0484b072a7efcaec9253eebe0b00429e139f122c6\", \"snapshot\": {\"db_source_metadata\": {\"archive_sha256\": \"2f61ffafb98523b119b1fdfb84fd2fc2ab84d1617cb48e2f09bce6fd6f34f103\", \"record_serialization\": \"ElementTree TEI element; original archive retained\"}, \"names\": [{\"language\": \"zho-Hant\", \"text\": \"慧升\", \"type\": \"primary\"}, {\"language\": \"zho-Hant\", \"text\": \"寒巖慧升\", \"type\": \"alternative\"}, {\"language\": \"zho-Hant\", \"text\": \"延福慧升\", \"type\": \"alternative\"}, {\"language\": \"zho-Hant\", \"text\": \"支提道升\", \"type\": \"alternative\"}, {\"language\": \"zho-Hant\", \"text\": \"鼓山道升\", \"type\": \"alternative\"}], \"storage\": \"ttl_v2_source_records\", \"xml\": \"<ns0:person xmlns:ns0=\\\"http://www.tei-c.org/ns/1.0\\\" xml:id=\\\"A008431\\\" ana=\\\"historical\\\">\\n  <ns0:persName xml:lang=\\\"zho-Hant\\\">慧升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">寒巖慧升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">延福慧升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">支提道升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">鼓山道升</ns0:persName>\\n  <ns0:sex value=\\\"1\\\" />\\n  <ns0:birth>\\n    +1098-01-01 ~ +1098-12-31\\n    <ns0:note>依記錄推算。</ns0:note>\\n  </ns0:birth>\\n  <ns0:death>\\n    +1176-02-19 ~ +1177-02-07\\n    <ns0:note>一說年七十九，一說壽六十九。（疑年錄：266；X84n1583_p0433a19）</ns0:note>\\n  </ns0:death>\\n  <ns0:note type=\\\"birthDeathDateQuote\\\">卒於：南宋, 孝宗, 淳熙, 三年，79歲</ns0:note>\\n  <ns0:note type=\\\"dynasty\\\">\\n    南宋\\n  </ns0:note>\\n  <ns0:note type=\\\"placeOfOrigin\\\">\\n    <ns0:placeName>建安\\n      <ns0:ref target=\\\"http://authority.dila.edu.tw/place/\\\">PL000000018314</ns0:ref>\\n    </ns0:placeName>\\n  </ns0:note>\\n  <ns0:note type=\\\"sect\\\">臨濟宗 楊岐派 </ns0:note>\\n  <ns0:note type=\\\"monk\\\">是</ns0:note>\\n  <ns0:note type=\\\"concise\\\">泉州延福寒巖慧升禪師，亦作道升禪師，吳氏子。佛智端裕（1085-1150）禪師法嗣，大鑑下第十七世。母歿，至長樂出家，侍佛智移靈隱，居元座，後還里結菴曰「寒巖」。李敦帥閔，延住支提山，遷承天、黃龍、泐潭。後歸建安，史丞相帥福，請住鼓山。 （T51n2077_p0680c25；X82n1571_p0123c13；X84n1583_p0433a19；佛名：800）</ns0:note>\\n\\n  <ns0:listRelation>\\n    <ns0:relation type=\\\"teacher\\\" active=\\\"A007993\\\" n=\\\"端裕\\\">\\n      <ns0:desc>\\n        <ns0:bibl>（望月‧卷六‧附錄：050）</ns0:bibl>\\n      </ns0:desc>\\n    </ns0:relation>\\n  </ns0:listRelation>\\n  <ns0:listBibl>\\n    <ns0:bibl>( CBETA X77n1524_p0450b15 ) 補續高僧傳: 道升傳</ns0:bibl>\\n    <ns0:bibl>( CBETA X82n1571_p0123c13 )</ns0:bibl>\\n    <ns0:bibl><ns0:ref target=\\\"http://buddhistinformatics.dila.edu.tw/fosizhi/ui.html?book=g010%26cpage=0420%26target=A008431\\\">g010p0420(明州阿育王山志) { 慧升 } </ns0:ref></ns0:bibl>\\n    <ns0:bibl><ns0:ref target=\\\"http://buddhistinformatics.dila.edu.tw/fosizhi/ui.html?book=g010%26cpage=0478%26target=A008431\\\">g010p0478(明州阿育王山志) { 寒巖慧升 } </ns0:ref></ns0:bibl>\\n  </ns0:listBibl>\\n  <ns0:note type=\\\"mentionedIn\\\">\\n    <ns0:ref target=\\\"http://buddhistinformatics.dila.edu.tw/fosizhi/ui.html?book=g022%26cpage=0034\\\">增修雲林寺志‧卷3‧寒巖升禪師</ns0:ref>\\n  </ns0:note>\\n</ns0:person>\\n\"}, \"version\": \"2026-09\"}, {\"citation\": \"（望月‧卷六‧附錄：050）\", \"code\": \"DILA\", \"id\": \"relation_1\", \"record_id\": \"A008431:A007993\", \"rights_status\": \"pending_registry_review\", \"version\": \"2026-09\"}, {\"citation\": \"DB people; normalized import; Vietnamese fields are editorial\", \"code\": \"DILA\", \"id\": \"db_people\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"f8a30ddfdbd11f5a81ba5d63265db609924103f8d6b7621a4e5de4f81a4dc0b1\", \"snapshot\": {\"bio\": \"泉州延福寒巖慧升禪師，亦作道升禪師，吳氏子。佛智端裕（1085-1150）禪師法嗣，大鑑下第十七世。母歿，至長樂出家，侍佛智移靈隱，居元座，後還里結菴曰「寒巖」。李敦帥閔，延住支提山，遷承天、黃龍、泐潭。後歸建安，史丞相帥福，請住鼓山。 （T51n2077_p0680c25；X82n1571_p0123c13；X84n1583_p0433a19；佛名：800）\", \"bio_vi\": null, \"birth_year\": 1085, \"created_at\": \"2026-04-24 09:04:17\", \"death_year\": 1150, \"dynasty\": \"南宋\", \"id\": \"A008431\", \"latin_source\": null, \"name_en\": \"\", \"name_ja\": \"\", \"name_vi\": \"Tuệ Thăng\", \"name_zh\": \"慧升\", \"sect\": \"Thiền Tông\", \"source_id\": 1, \"source_origin\": \"DILA\"}, \"version\": \"db-snapshot:f8a30ddfdbd11f5a81ba5d63265db609924103f8d6b7621a4e5de4f81a4dc0b1\"}, {\"citation\": \"DB people: bản Việt hóa của hệ thống, không phải tên Việt do DILA cấp\", \"code\": \"LOCAL\", \"id\": \"db_people_vi\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"2a2b0d39e01caeedd481cee7d0a7cf61f842d65207a5dee53f873a86bc463a28\", \"snapshot\": {\"bio_vi\": null, \"id\": \"A008431\", \"latin_source\": null, \"name_vi\": \"Tuệ Thăng\", \"source_origin\": \"DILA\"}, \"version\": \"db-snapshot:2a2b0d39e01caeedd481cee7d0a7cf61f842d65207a5dee53f873a86bc463a28\"}, {\"citation\": \"Khóa DILA ID chính xác trong DB\", \"code\": \"DILA\", \"id\": \"db_identity\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"02a38c27ff738d754773159de82b8e55d2b6b9bd87b2ba0ca151ba191874736c\", \"snapshot\": {\"id\": \"A008431\", \"storage\": \"exact DB primary key\"}, \"version\": \"db-snapshot:02a38c27ff738d754773159de82b8e55d2b6b9bd87b2ba0ca151ba191874736c\"}, {\"citation\": \"DB vn_person_authority; giữ status/mapping gốc\", \"code\": \"LEGACY_TTL\", \"id\": \"db_vpa_e517ad48c13ce005\", \"record_id\": \"dien_phuc_tue_thang\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"af933e51f83d2aff9db7260af950add5fcc9ed2ee1b720b404057d47146a3262\", \"snapshot\": {\"appellations\": null, \"biographical_note_vi\": \"Thiền sư Tuệ Thăng ở Diên Phước\\nThiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\\n\\nCó lúc lên giảng đường, Sư hét một tiếng rồi bảo:\\n\\n“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\\n\\nSư lại hét một tiếng và tiếp bảo:\\n\\n– Rất kỵ chuyển hơi xúc phạm húy.\", \"birth_year\": null, \"created_at\": \"2026-10-02 10:45:33\", \"death_year\": null, \"dharma_lineage\": \"Dòng Lâm Tế Dương Kỳ\", \"dharma_title\": null, \"dila_id\": \"A008431\", \"gender\": \"Male\", \"generation_order\": 50, \"id\": \"dien_phuc_tue_thang\", \"is_lineage_founder\": 0, \"name_vi\": \"Diên Phúc Tuệ Thăng\", \"name_zh\": \"延福慧升\", \"status\": \"verified\", \"ttl_filename\": \"TS-Dien-Phuc-Tue-Thang\"}, \"version\": \"db-snapshot:af933e51f83d2aff9db7260af950add5fcc9ed2ee1b720b404057d47146a3262\"}, {\"citation\": \"DB vn_person_relations; dữ liệu nguyên bản theo slug\", \"code\": \"LEGACY_TTL\", \"id\": \"db_vn_person_relations_e517ad48c1\", \"record_id\": \"dien_phuc_tue_thang\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"5e3c2cced718c199586cb2a7cd9ad0cd28692e82abd8e37bb4b7dee47b791226\", \"snapshot\": [{\"id\": 2393, \"person_id\": \"dien_phuc_tue_thang\", \"relation_type\": \"hasTeacher\", \"target_id\": \"duc_vuong_doan_du\", \"target_label_vi\": \"Dục Vương Đoan Dụ\", \"ttl_filename\": \"TS-Dien-Phuc-Tue-Thang\"}], \"version\": \"db-snapshot:5e3c2cced718c199586cb2a7cd9ad0cd28692e82abd8e37bb4b7dee47b791226\"}, {\"citation\": \"TTL nguyên văn đã nhập DB: TS-Dien-Phuc-Tue-Thang.ttl\", \"code\": \"LEGACY_TTL\", \"id\": \"db_ttl_49629\", \"record_id\": \"TS-Dien-Phuc-Tue-Thang.ttl\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"5c8dd88d2422eac1b764c0157fd92271a86e1766e927322cd2e5c63ac61f1e13\", \"snapshot\": {\"filename\": \"TS-Dien-Phuc-Tue-Thang.ttl\", \"metadata\": {\"person\": {\"dila_id\": \"\", \"entity_type\": \"Monastic\", \"key\": \"38350245-d799-5d83-bafe-003c89e7c705\", \"legacy_slug\": \"dien_phuc_tue_thang\", \"name_vi\": \"Diên Phúc Tuệ Thăng\", \"name_zh\": \"\", \"uri\": \"https://www.phatphaponline.org/resource/person/38350245-d799-5d83-bafe-003c89e7c705\"}, \"source_rdf_triples\": 15, \"validation\": {\"conforms\": false, \"errors\": [\"Không được tự làm thầy/trò/đồng môn: legacy_8\"], \"warnings\": [\"Nhận định legacy_1 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_2 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_3 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_4 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_5 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_6 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_7 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_8 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_9 được giữ làm tham chiếu, chưa chiếu thành fact.\"]}}, \"raw_text\": \"\\t@prefix bkg: <http://www.phatphaponline.org/ontology/buddhist-kg#> .\\r\\n@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .\\r\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\r\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\r\\n\\r\\n<ex:monk/dien_phuc_tue_thang> a <bkg:Monk> ;\\r\\n    rdfs:label \\\"Diên Phúc Tuệ Thăng\\\"@vi ;\\r\\n    crm:P1_is_identified_by <ex:monk/dien_phuc_tue_thang> ;        \\r\\n    bkg:biographicalNote \\\"\\\"\\\" \\r\\n\\tThiền sư Tuệ Thăng ở Diên Phước\\r\\nThiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\\r\\n\\r\\nCó lúc lên giảng đường, Sư hét một tiếng rồi bảo:\\r\\n\\r\\n“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\\r\\n\\r\\nSư lại hét một tiếng và tiếp bảo:\\r\\n\\r\\n– Rất kỵ chuyển hơi xúc phạm húy.\\r\\n\\\"\\\"\\\"@vi ;\\r\\n    bkg:birthEvent <ex:monk/dien_phuc_tue_thang_birthEvent> ;\\r\\n    bkg:deathEvent <ex:monk/dien_phuc_tue_thang_deathEvent> ;\\r\\n    bkg:dharmaLineageName \\\"Dòng Lâm Tế Dương Kỳ\\\"@vi ;\\r\\n    bkg:gender <bkg:Male> ;\\r\\n    bkg:generationOrder 50;    \\t\\r\\n    bkg:hasTeacher <ex:monk/dien_phuc_tue_thang>;  \\r\\n\\tbkg:isLineageFounder false .\\r\\n\\r\\n<ex:monk/dien_phuc_tue_thang> rdfs:label \\\"Dục Vương Đoan Dụ\\\"@vi .   \\r\\n<ex:monk/tinh_tu_su_nhat> rdfs:label \\\"Tịnh Từ Sư Nhất\\\"@vi .   \\r\\n<ex:monk/dao_trang_phap_toan> rdfs:label \\\"Đạo Tràng Pháp Toàn\\\"@vi .   \\r\\n<ex:monk/thanh_luong_than> rdfs:label \\\"Thanh Lương Thản\\\"@vi .   \\r\\n\\r\\n\\r\\n\", \"sha256\": \"689166e60508765713b1957f250fea63f991ff918472ec2dabb8ceda103714d1\"}, \"version\": \"db-snapshot:5c8dd88d2422eac1b764c0157fd92271a86e1766e927322cd2e5c63ac61f1e13\"}, {\"citation\": \"DB person_gen_computed; kết quả tính cũ, không phải chứng cứ xác minh\", \"code\": \"LOCAL\", \"id\": \"db_computed_generations\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"f279fdd8a6030f654477b892aaf0eb73905f6b5cd1bde31632bd9edb027faa92\", \"snapshot\": [{\"gen_lamte\": 13, \"gen_sect\": null, \"gen_thientong\": 49, \"lineage_key\": \"dila_global\", \"lineage_name\": \"Thiền Tông (DILA)\", \"person_id\": \"A008431\"}], \"version\": \"db-snapshot:f279fdd8a6030f654477b892aaf0eb73905f6b5cd1bde31632bd9edb027faa92\"}, {\"citation\": \"DB lineage_edge_assertions; giữ nguồn, status, trust, raw_relation_type\", \"code\": \"DILA\", \"id\": \"db_edges_DILA\", \"record_id\": \"A008431\", \"rights_status\": \"pending_artifact_review\", \"sha256\": \"dca807e2b1a4c68eb72cb184431f267ecea08e2fc73bfcf2b345d92865598d79\", \"snapshot\": [{\"citation_tier\": null, \"created_at\": \"2026-09-17T13:57:25\", \"edge_key\": \"D|A007993|A008431\", \"id\": 17953, \"mapping_verified\": 1, \"object_person_id\": \"A008431\", \"raw_relation_type\": \"dila:teacher_of\", \"ref\": null, \"relation_type\": \"da:isTeacherOf\", \"source_code\": \"DILA\", \"status\": \"active\", \"subject_person_id\": \"A007993\", \"trust_level\": \"L2\"}, {\"citation_tier\": null, \"created_at\": \"202