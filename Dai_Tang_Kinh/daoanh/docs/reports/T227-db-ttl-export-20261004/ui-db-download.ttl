<https://www.phatphaponline.org/resource/legacy/7d29610f-0cf4-5ed5-aba8-813c9434956b> a prov:Entity ;
    pth:originalTurtle """	@prefix bkg: <http://www.phatphaponline.org/ontology/buddhist-kg#> .\r
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .\r
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\r
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\r
\r
<ex:monk/dien_phuc_tue_thang> a <bkg:Monk> ;\r
    rdfs:label "Diên Phúc Tuệ Thăng"@vi ;\r
    crm:P1_is_identified_by <ex:monk/dien_phuc_tue_thang> ;        \r
    bkg:biographicalNote \"\"\" \r
	Thiền sư Tuệ Thăng ở Diên Phước\r
Thiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\r
\r
Có lúc lên giảng đường, Sư hét một tiếng rồi bảo:\r
\r
“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\r
\r
Sư lại hét một tiếng và tiếp bảo:\r
\r
– Rất kỵ chuyển hơi xúc phạm húy.\r
\"\"\"@vi ;\r
    bkg:birthEvent <ex:monk/dien_phuc_tue_thang_birthEvent> ;\r
    bkg:deathEvent <ex:monk/dien_phuc_tue_thang_deathEvent> ;\r
    bkg:dharmaLineageName "Dòng Lâm Tế Dương Kỳ"@vi ;\r
    bkg:gender <bkg:Male> ;\r
    bkg:generationOrder 50;    	\r
    bkg:hasTeacher <ex:monk/dien_phuc_tue_thang>;  \r
	bkg:isLineageFounder false .\r
\r
<ex:monk/dien_phuc_tue_thang> rdfs:label "Dục Vương Đoan Dụ"@vi .   \r
<ex:monk/tinh_tu_su_nhat> rdfs:label "Tịnh Từ Sư Nhất"@vi .   \r
<ex:monk/dao_trang_phap_toan> rdfs:label "Đạo Tràng Pháp Toàn"@vi .   \r
<ex:monk/thanh_luong_than> rdfs:label "Thanh Lương Thản"@vi .   \r
\r
\r
""" ;
    pth:sha256 "689166e60508765713b1957f250fea63f991ff918472ec2dabb8ceda103714d1" .

