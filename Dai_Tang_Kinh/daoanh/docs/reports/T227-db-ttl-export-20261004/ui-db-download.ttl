    pth:sha256 "f8a30ddfdbd11f5a81ba5d63265db609924103f8d6b7621a4e5de4f81a4dc0b1" ;
    pth:sourceCode "DILA" ;
    pth:sourceRecordId "A008431" ;
    pth:sourceSnapshot "{\"bio\": \"泉州延福寒巖慧升禪師，亦作道升禪師，吳氏子。佛智端裕（1085-1150）禪師法嗣，大鑑下第十七世。母歿，至長樂出家，侍佛智移靈隱，居元座，後還里結菴曰「寒巖」。李敦帥閔，延住支提山，遷承天、黃龍、泐潭。後歸建安，史丞相帥福，請住鼓山。 （T51n2077_p0680c25；X82n1571_p0123c13；X84n1583_p0433a19；佛名：800）\", \"bio_vi\": null, \"birth_year\": 1085, \"created_at\": \"2026-04-24 09:04:17\", \"death_year\": 1150, \"dynasty\": \"南宋\", \"id\": \"A008431\", \"latin_source\": null, \"name_en\": \"\", \"name_ja\": \"\", \"name_vi\": \"Tuệ Thăng\", \"name_zh\": \"慧升\", \"sect\": \"Thiền Tông\", \"source_id\": 1, \"source_origin\": \"DILA\"}"^^rdf:JSON .

<https://www.phatphaponline.org/resource/source-record/7d29610f-0cf4-5ed5-aba8-813c9434956b/db_vpa_e517ad48c13ce005> a prov:Entity,
        pth:SourceRecord ;
    dcterms:bibliographicCitation "DB vn_person_authority; giữ status/mapping gốc" ;
    dcterms:hasVersion "db-snapshot:af933e51f83d2aff9db7260af950add5fcc9ed2ee1b720b404057d47146a3262" ;
    dcterms:identifier "db_vpa_e517ad48c13ce005" ;
    pth:rightsStatus "pending_artifact_review" ;
    pth:sha256 "af933e51f83d2aff9db7260af950add5fcc9ed2ee1b720b404057d47146a3262" ;
    pth:sourceCode "LEGACY_TTL" ;
    pth:sourceRecordId "dien_phuc_tue_thang" ;
    pth:sourceSnapshot "{\"appellations\": null, \"biographical_note_vi\": \"Thiền sư Tuệ Thăng ở Diên Phước\\nThiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\\n\\nCó lúc lên giảng đường, Sư hét một tiếng rồi bảo:\\n\\n“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\\n\\nSư lại hét một tiếng và tiếp bảo:\\n\\n– Rất kỵ chuyển hơi xúc phạm húy.\", \"birth_year\": null, \"created_at\": \"2026-10-02 10:45:33\", \"death_year\": null, \"dharma_lineage\": \"Dòng Lâm Tế Dương Kỳ\", \"dharma_title\": null, \"dila_id\": \"A008431\", \"gender\": \"Male\", \"generation_order\": 50, \"id\": \"dien_phuc_tue_thang\", \"is_lineage_founder\": 0, \"name_vi\": \"Diên Phúc Tuệ Thăng\", \"name_zh\": \"延福慧升\", \"status\": \"verified\", \"ttl_filename\": \"TS-Dien-Phuc-Tue-Thang\"}"^^rdf:JSON .

<https://www.phatphaponline.org/resource/source-record/7d29610f-0cf4-5ed5-aba8-813c9434956b/db_ttl_49629> a prov:Entity,
        pth:SourceRecord ;
    dcterms:bibliographicCitation "TTL nguyên văn đã nhập DB: TS-Dien-Phuc-Tue-Thang.ttl" ;
    dcterms:hasVersion "db-snapshot:5c8dd88d2422eac1b764c0157fd92271a86e1766e927322cd2e5c63ac61f1e13" ;
    dcterms:identifier "db_ttl_49629" ;
    pth:rightsStatus "pending_artifact_review" ;
    pth:sha256 "5c8dd88d2422eac1b764c0157fd92271a86e1766e927322cd2e5c63ac61f1e13" ;
    pth:sourceCode "LEGACY_TTL" ;
    pth:sourceRecordId "TS-Dien-Phuc-Tue-Thang.ttl" ;
    pth:sourceSnapshot "{\"filename\": \"TS-Dien-Phuc-Tue-Thang.ttl\", \"metadata\": {\"person\": {\"dila_id\": \"\", \"entity_type\": \"Monastic\", \"key\": \"38350245-d799-5d83-bafe-003c89e7c705\", \"legacy_slug\": \"dien_phuc_tue_thang\", \"name_vi\": \"Diên Phúc Tuệ Thăng\", \"name_zh\": \"\", \"uri\": \"https://www.phatphaponline.org/resource/person/38350245-d799-5d83-bafe-003c89e7c705\"}, \"source_rdf_triples\": 15, \"validation\": {\"conforms\": false, \"errors\": [\"Không được tự làm thầy/trò/đồng môn: legacy_8\"], \"warnings\": [\"Nhận định legacy_1 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_2 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_3 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_4 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_5 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_6 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_7 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_8 được giữ làm tham chiếu, chưa chiếu thành fact.\", \"Nhận định legacy_9 được giữ làm tham chiếu, chưa chiếu thành fact.\"]}}, \"raw_text\": \"\\t@prefix bkg: <http://www.phatphaponline.org/ontology/buddhist-kg#> .\\r\\n@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .\\r\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\r\\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\\r\\n\\r\\n<ex:monk/dien_phuc_tue_thang> a <bkg:Monk> ;\\r\\n    rdfs:label \\\"Diên Phúc Tuệ Thăng\\\"@vi ;\\r\\n    crm:P1_is_identified_by <ex:monk/dien_phuc_tue_thang> ;        \\r\\n    bkg:biographicalNote \\\"\\\"\\\" \\r\\n\\tThiền sư Tuệ Thăng ở Diên Phước\\r\\nThiền sư Tuệ Thăng ở Hàng Nham – Diên Phước tại Tuyền Châu, vốn người xứ Kiến Ninh.\\r\\n\\r\\nCó lúc lên giảng đường, Sư hét một tiếng rồi bảo:\\r\\n\\r\\n“Khắp mười phương thế giới hợp mười đời xưa nay thành đô nhà cửa, ở trong đó bức bức bít bít rồi vậy. Nếu buông mở một kim châm bén nhọn, thì biển lớn chảy ngược dòng về phía Tây, núi lớn đổ ngã, các loài cá rồng ngoan đà tôm cua giun dế đều lên đất bằng vọt ra sóng cả bơi lội nhảy múa. Tuy là như vậy, phải đến trên đầu sào trăm thước tiến thêm một bước, thì bước bước đạp chuyển vô tận tạng luân, mới biết nói lỗ mũi treo tại trên môi, lông mày không ở dưới mắt. Lại có cùng ủy thác chăng?”\\r\\n\\r\\nSư lại hét một tiếng và tiếp bảo:\\r\\n\\r\\n– Rất kỵ chuyển hơi xúc phạm húy.\\r\\n\\\"\\\"\\\"@vi ;\\r\\n    bkg:birthEvent <ex:monk/dien_phuc_tue_thang_birthEvent> ;\\r\\n    bkg:deathEvent <ex:monk/dien_phuc_tue_thang_deathEvent> ;\\r\\n    bkg:dharmaLineageName \\\"Dòng Lâm Tế Dương Kỳ\\\"@vi ;\\r\\n    bkg:gender <bkg:Male> ;\\r\\n    bkg:generationOrder 50;    \\t\\r\\n    bkg:hasTeacher <ex:monk/dien_phuc_tue_thang>;  \\r\\n\\tbkg:isLineageFounder false .\\r\\n\\r\\n<ex:monk/dien_phuc_tue_thang> rdfs:label \\\"Dục Vương Đoan Dụ\\\"@vi .   \\r\\n<ex:monk/tinh_tu_su_nhat> rdfs:label \\\"Tịnh Từ Sư Nhất\\\"@vi .   \\r\\n<ex:monk/dao_trang_phap_toan> rdfs:label \\\"Đạo Tràng Pháp Toàn\\\"@vi .   \\r\\n<ex:monk/thanh_luong_than> rdfs:label \\\"Thanh Lương Thản\\\"@vi .   \\r\\n\\r\\n\\r\\n\", \"sha256\": \"689166e60508765713b1957f250fea63f991ff918472ec2dabb8ceda103714d1\"}"^^rdf:JSON .

<https://www.phatphaponline.org/resource/source-record/7d29610f-0cf4-5ed5-aba8-813c9434956b/dila_record> a prov:Entity,
        pth:SourceRecord ;
    dcterms:bibliographicCitation "DILA TEI person xml:id=A008431" ;
    dcterms:hasVersion "2026-09" ;
    dcterms:identifier "dila_record" ;
    foaf:page <https://authority.dila.edu.tw/person/search.php?aid=A008431> ;
    pth:datasetUrl <https://github.com/DILA-edu/Authority-Databases> ;
    pth:retrievedAt "2026-10-04T04:16:03.551879+00:00" ;
    pth:rightsStatus "pending_registry_review" ;
    pth:sha256 "7f600cdf48045750ed9572e0484b072a7efcaec9253eebe0b00429e139f122c6" ;
    pth:sourceCode "DILA" ;
    pth:sourceRecordId "A008431" ;
    pth:sourceSnapshot "{\"db_source_metadata\": {\"archive_sha256\": \"2f61ffafb98523b119b1fdfb84fd2fc2ab84d1617cb48e2f09bce6fd6f34f103\", \"record_serialization\": \"ElementTree TEI element; original archive retained\"}, \"names\": [{\"language\": \"zho-Hant\", \"text\": \"慧升\", \"type\": \"primary\"}, {\"language\": \"zho-Hant\", \"text\": \"寒巖慧升\", \"type\": \"alternative\"}, {\"language\": \"zho-Hant\", \"text\": \"延福慧升\", \"type\": \"alternative\"}, {\"language\": \"zho-Hant\", \"text\": \"支提道升\", \"type\": \"alternative\"}, {\"language\": \"zho-Hant\", \"text\": \"鼓山道升\", \"type\": \"alternative\"}], \"storage\": \"ttl_v2_source_records\", \"xml\": \"<ns0:person xmlns:ns0=\\\"http://www.tei-c.org/ns/1.0\\\" xml:id=\\\"A008431\\\" ana=\\\"historical\\\">\\n  <ns0:persName xml:lang=\\\"zho-Hant\\\">慧升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">寒巖慧升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">延福慧升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">支提道升</ns0:persName>\\n  <ns0:persName type=\\\"alternative\\\" xml:lang=\\\"zho-Hant\\\">鼓山道升</ns0:persName>\\n  <ns0:sex value=\\\"1\\\" />\\n  <ns0:birth>\\n    +1098-01-01 ~ +1098-12-31\\n    <ns0:note>依記錄推算。</ns0:note>\\n  </ns0:birth>\\n  <ns0:death>\\n    +1176-02-19 ~ +1177-02-07\\n    <ns0:note>一說年七十九，一說壽六十九。（疑年錄：266；X84n1583_p0433a19）</ns0:note>\\n  </ns0:death>\\n  <ns0:note type=\\\"birthDeathDateQuote\\\">卒於：南宋, 孝宗, 淳熙, 三年，79歲</ns0:note>\\n  <ns0:note type=\\\"dynasty\\\">\\n    南宋\\n  </ns0:note>\\n  <ns0:note type=\\\"placeOfOrigin\\\">\\n    <ns0:placeName>建安\\n      <ns0:ref target=\\\"http://authority.dila.edu.tw/place/\\\">PL000000018314</ns0:ref>\\n    </ns0:placeName>\\n  </ns0:note>\\n  <ns0:note type=\\\"sect\\\">臨濟宗 楊岐派 </ns0:note>\\n  <ns0:note type=\\\"monk\\\">是</ns0:note>\\n  <ns0:note type=\\\"concise\\\">泉州延福寒巖慧升禪師，亦作道升禪師，吳氏子。佛智端裕（1085-1150）禪師法嗣，大鑑下第十七世。母歿，至長樂出家，侍佛智移靈隱，居元座，後還里結菴曰「寒巖」。李敦帥閔，延住支提山，遷承天、黃龍、泐潭。後歸建安，史丞相帥福，請住鼓山。 （T51n2077_p0680c25；X82n1571_p0123c13；X84n1583_p0433a19；佛名：800）</ns0:note>\\n\\n  <ns0:listRelation>\\n    <ns0:relation type=\\\"teacher\\\" active=\\\"A007993\\\" n=\\\"端裕\\\">\\n      <ns0:desc>\\n        <ns0:bibl>（望月‧卷六‧附錄：050）</ns0:bibl>\\n      </ns0:desc>\\n    </ns0:relation>\\n  </ns0:listRelation>\\n  <ns0:listBibl>\\n    <ns0:bibl>( CBETA X77n1524_p0450b15 ) 補續高僧傳: 道升傳</ns0:bibl>\\n    <ns0:bibl>( CBETA X82n1571_p0123c13 )</ns0:bibl>\\n    <ns0:bibl><ns0:ref target=\\\"http://buddhistinformatics.dila.edu.tw/fosizhi/ui.html?book=g010%26cpage=0420%26target=A008431\\\">g010p0420(明州阿育王山志) { 慧升 } </ns0:ref></ns0:bibl>\\n    <ns0:bibl><ns0:ref target=\\\"http://buddhistinformatics.dila.edu.tw/fosizhi/ui.html?book=g010%26cpage=0478%26target=A008431\\\">g010p0478(明州阿育王山志) { 寒巖慧升 } </ns0:ref></ns0:bibl>\\n  </ns0:listBibl>\\n  <ns0:note type=\\\"mentionedIn\\\">\\n    <ns0:ref target=\\\"http://buddhistinformatics.dila.edu.tw/fosizhi/ui.html?book=g022%26cpage=0034\\\">增修雲林寺志‧卷3‧寒巖升禪師</ns0:ref>\\n  </ns0:note>\\n</ns0:person>\\n\"}"^^rdf:JSON .

