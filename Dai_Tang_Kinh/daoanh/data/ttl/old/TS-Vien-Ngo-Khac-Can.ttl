    bkg:deathEvent <ex:monk/vien_ngo_khac_can_death_event> ;
    bkg:dharmaLineageName "Phái Dương Kì thuộc Lâm Tế Tông Trung Quốc" ;
    bkg:gender "bkg:Male" ;
