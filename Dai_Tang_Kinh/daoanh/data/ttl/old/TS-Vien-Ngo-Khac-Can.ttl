            rdfs:label "Vô Trước"@vi ;
            bkg:hasAppellationType "bkg:SecularName" ],
        [ a crm:E41_Appellation ;
            rdfs:label "Engo Kokugon"@en ;
            bkg:hasAppellationType "bkg:SecularName" ],
        [ a crm:E41_Appellation ;
            rdfs:label "Lạc"@vi ;
            bkg:hasAppellationType "bkg:SecularName" ],
        [ a crm:E41_Appellation ;
            rdfs:label "Thiền sư"@vi ;
            bkg:hasAppellationType "bkg:DharmaTitle" ],
        [ a crm:E41_Appellation ;
            rdfs:label "圜悟克勤"@zh ;
            bkg:hasAppellationType "bkg:DharmaName" ],
        [ a crm:E41_Appellation ;
            rdfs:label "Phật Quả Khắc Cần"@vi ;
            bkg:hasAppellationType "bkg:DharmaName" ] ;
    bkg:associatedPlaces <ex:place/chieu_giac_tu>,
        <ex:place/chon_nhu_vien>,
        <ex:place/dao_lam_tu>,
        <ex:place/kim_son_long_du_tu>,
        <ex:place/luc_to_tu>,
