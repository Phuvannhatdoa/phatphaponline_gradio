        <ex:event/tru_tri_tai_thai_binh_tu>,
        <ex:event/tru_tri_tai_tu_dien_son>,
        <ex:event/xuat_gia> ;
    bkg:hasRelatedFigure <ex:monk/bach_van_thu_doan>,
        <ex:monk/phu_son_phap_vien>,
        <ex:monk/vien_chieu_tong_bon> ;
    bkg:hasTeacher <ex:monk/bach_van_thu_doan> .

