{"term": "Năm Pháp Của Vị Tỳ Kheo Trụ Trì", "definition": "(Āvāsikadhamma) đáng nêu gương.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Khó Thể Nhập", "definition": "(Duppaṭivijjhā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Làm Tăng Tuổi Thọ", "definition": "(Āyussadhamma).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Lạc Trú", "definition": "(Phāsuvihāra).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Thu Thúc", "definition": "(Saṃvara), sự phòng hộ, sự ngăn ngừa.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Thuộc Phần Hạ Liệt", "definition": "(Hānabhāgiyā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Thuộc Phần Thù Thắng", "definition": "(Visesabhāyiyā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tiến Hành Cho Thuần Thục Tâm Giải Thoát", "definition": "(Cetovimutt paripākasaṃvattana dhamma).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tân Tỳ-Kheo", "definition": "(Navakabhikkhudhamma), điều mà vị tỳ-kheo mới tu phải hành theo.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tăng Chúng Lạc Trú", "definition": "(Saṅ-ghaphāsuvihāra).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tăng Thịnh Cao Quí", "definition": "(Ariyavaḍḍhi).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tạo Can Đảm", "definition": "(Vesārajjakaraṇadhamma), pháp làm cho thành người dạn dĩ.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tự Lợi Lợi Tha", "definition": "(Attahitaparahitapaṭipanna).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Tự Tại", "definition": "(Vasī) của vị hành giả đắc thiền.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Đa Tác Dụng", "definition": "(Bahukārā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Pháp Đem Lại Hạnh Phúc Đầy Đủ", "definition": "1. Giới hạnh đầy đủ (tức nếp sống đạo đức đầy đủ).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Phần Hương", "definition": "H. Ngũ phần hương; A. The five kinds of incense. Năm loại hương ứng với năm phần pháp thân (x. năm phần pháp thân). Giới hương, định hương, tuệ hương, giải thoát hương và giải thoát tri kiến hương.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Phần Pháp Thân", "definition": "H. Ngũ phần pháp than. Năm thuộc tánh siêu việc của pháp thân của Phật:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Phật Sự Thường Nhật", "definition": "(Buddhakicca), lịch sinh hoạt hằng ngày của Đức Phật.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Ràng Buộc", "definition": "H. Ngũ kiết sử. Năm điều ràng buộc, khiến người tu hành không giác ngộ và giải thoát được.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Sức Mạnh", "definition": "H. Ngũ lực. Nếu bồi dưỡng tốt năm căn là lòng tin, tính siêng năng tinh tấn, chính niệm, thiền định và trí tuệ (x. năm căn), thì năm căn đó, tức năm cái gốc đó sẽ biến thành năm sức mạnh (lực). Vd, nhờ bồi dưỡng lòng chính tín (tín căn) mà có sức mạnh dứt trừ mọi điều mê tín nhảm nhí, cũng như đoạn trừ mọi mối nghi hoặc. Nhờ bồi dưỡng tính siêng năng (tấn căn), mà có sức mạnh loại trừ mọi biếng nhác, trể nãi trong thân và tâm. Nhờ bồi dưỡng gốc chánh niệm (niệm căn) mà có sức mạnh phá bỏ mọi ý niệm sai lầm, bất chính. Nhờ bồi dưỡng gốc thiền định (định căn) mà có sức mạnh trừ bỏ mọi tư tưởng tán loạn. Nhờ bồi dưỡng gốc trí tuệ (tuệ căn) mà có sức mạnh đoạn trừ mọi điều mê hoặc.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Sự Bố Thí Hợp Thời", "definition": "(Kāladāna).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Sự Lo Sợ", "definition": "(Bhaya).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Sự Suy Sụp", "definition": "1. Suy sụp thân quyến (Ñātibyasana), là không có bà con người thân, hoặc quyến thuộc bị ly tán.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Sự Tăng Trưởng", "definition": "Kinh tạng Pali nói tới năm sự tăng trưởng tốt đẹp:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Sự Tổn Thất", "definition": "Các loài hữu tình có thể bị năm sự tổn thất:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Sự Đoạn Diệt", "definition": "(Nirodha).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Thiên Xứ", "definition": "(Devadūta), năm hiện tượng như sứ giả đến báo tin, năm hiện tượng làm tâm thức tỉnh tu tập.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Thành Tựu", "definition": "1. Thành tựu về bà con thân thuộc (có nhiều bà con, thân thuộc và được họ kính mến).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Thái Bình Hưng Quốc thứ 5 (980), sư đến Biện Kinh, năm thứ 7 (982), sư cùng với các ngài Thí Hộ, Pháp Thiên vào ở trong Viện Dịch Kinh, chuyên phiên dịch kinh điển. Sau, vua lần lượt phong hiệu cho sư là Minh Giáo Đại Sư, ngài Pháp Thiên là Truyền Giáo Đại Sư và ngài Thí Hộ là Hiển Giáo Đại Sư. [X. Đại Trung Tường Phù Pháp Bảo Lục Q.3-8; Phật Tổ Thống Kỉ Q.43].", "definition": "III.Minh Giáo Đại Sư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm Thái Hòa thứ 4 (830) đời Đường sư thị tịch, thọ 80 tuổi.Các trứ tác của sư gồm: Dung Tổ Sư Văn 3 quyển Tự tập; Bảo Chí Thích Đề, Nam Du Phó Đại Sĩ Tự, Vô Sinh Đẳng Nghĩa. [X. Tống Cao Tăng Truyện Q.10; Cảnh Đức Truyền Đăng Lục Q.4; Thích Thị Nghi Niên Lục Q.5]", "definition": "II.Duy Tắc (? - 1354). Vị tăng Tông Lâm Tế đời Nguyên. Người thôn Vĩnh, huyện Cát An, tỉnh Giang Tây, họ Đàm, hiệu Thiên Như.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm Thông", "definition": "Thần túc thông, tha tâm thông, thiên nhĩ thông, túc mạng thông, thiên nhãn thông. Thần túc thông là khả năng đi như bay, khả năng biến hóa. Tha tâm thông là khả năng biết tâm tư người khác. Thiên nhĩ thông là khả năng có thể nghe được tiếng loài người và tiếng loài vật, tiếng xa hay tiếng gần. Túc mạng thông là khả năng có thể biết được các đời trước. Thiên nhãn thông là khả năng có thể thấy xa, gần, vật to, vật nhỏ, thấy ngang qua mọi vật cản, tức là [tr.453] thấy những vật mà con mắt bình thường không thấy được. Thần túc thông nghĩa đen là đi như bay, nhưng còn có nghĩa rộng là thần thông biến hóa một thân biến thành nhiều thân, nhiều thân hóa trở lại một thân, chui xuống đất, bay lên hư không, làm mọi việc phi thường, mà người bình thường không thể làm được. Vì vậy mà có sách, thay vì thần túc thông, dùng từ biến hóa thần thông.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Thú", "definition": "H. Ngũ thú .Địa ngục, bàng sinh, ngạ quỷ, người và Chư thiên. Địa ngục là cảnh giới phải chịu sự khổ đau cùng cực và liên tục. Bàng sinh là thế giới các loài vật và ngạ quỷ là thế giới của loài ma quỷ luôn luôn bị đói khát dằn vặt. Ba cõi này được xem là ác đạo và những ai làm điều ác, sẽ phải sinh vào một trong những cảnh giới này và chịu sự đau khổ. Cõi người tương đối tốt đẹp, có khổ nhưng khổ cũng vừa phải, có lạc nhưng không có lạc quá đáng để phải say mê, nên ở cảnh giới người có thể tu hành được. Cảnh giới Chư Thiên, tương đối tốt đẹp hơn cảnh giới loài người, thường được các kinh mô tả là tuổi thọ dài hơn, dung sắc đẹp hơn và ăn uống tế nhị hơn. Hai cảnh giới loài người và loài Trời được gọi là thiện đạo và những ai làm điều lành được sinh vào một trong hai cảnh giới này.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Thượng Phần Kiết Sử", "definition": "Kiết sử là phiền não ràng buộc chi phối. Thượng phần là hạng trên, cấp trên. Vì năm loại phiền não này vi tế, nhỏ nhiệm khó thấy, cho nên cũng khó đoạn trừ (trái lại, hạ phần kiết sử là loại phiền não thô thiển, dễ thấy). Năm thượng phần kiết sử, hay năm phiền não cấp trên là: tham Sắc (tham cõi Trời Sắc giới), tham Vô Sắc (tham cõi Trời Vô Sắc giới), kiêu mạn, nghi ngờ, vô minh. Tuy cuộc sống ở các cõi Trời Sắc giới và Vô Sắc giới sung sướng hơn nhiều, và tuổi thọ lâu dài hơn nhiều so với cõi người, nhưng nếu tuổi thọ hết, thì vẫn tiếp tục luân hồi sinh tử trong các cõi. Chỉ có siêu thoát khỏi ba giới mới trở thành bất tử.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Thời Tranh Thủ Tu Tập, Thời Để Tinh Cần", "definition": "(Padhānasamayā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Thụ", "definition": "H. Ngũ thụ. Khổ thụ, lạc thù (hai thụ này thuộc về tâm), hỷ thụ, ưu thụ (hai thụ này thuộc về cảm quan). Xả thụ là cảm thụ không vui, không buồn trước mọi ngoại cảnh không thuận cũng không nghịch. Khổ thụ và ưu thụ cũng đều là cảm thụ buồn trước nghịch cảnh, nhưng cảm thụ ưu kéo dài và sâu kín hơn cảm thụ khổ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Thủ Uẩn", "definition": "Năm uẩn là năm nhóm yếu tố vật chất và tinh thần tạo thành con người.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Thứ Hỷ Lạc", "definition": "(Pīti), phỉ lạc, sự no vui do thiền định sanh.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Thứ Ma", "definition": "(Māra), sự phá hoại, sự đem lại bất hạnh, sự xấu xa.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Thứ Mắt", "definition": "(Cakkhu).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Triền Cái", "definition": "H. Ngũ triền cái; P. Nivaranani. Năm pháp bao phủ tâm, làm yếu ớt trí tuệ: dục tham, sân, hôn trầm-thuỵ miên, trạo cử và nghi (Tăng Chi III, 57). Con người không tu tập, nên thường bị năm triền cái này chi phối, không thể tu hành được. Tu thiền là tu tập đoạn trừ năm triền cái này và thay thế bằng năm thiền chi (tầm, tứ, hỷ, lạc và nhất tâm). Nhờ tầm, đối trị được hôn trầm-thuỵ miên; nhờ tứ, đối trị được nghi; nhờ hỷ đối trị được sân; nhờ lạc đối trị được trạo hối và nhờ nhất tâm đối trị được tham dục. Kinh Trường Bộ I, 72 có diễn tả đoạn trừ năm triền cái này như người mắc nợ trả được món nợ, như người tù thoát được tù tội, như người nô lệ thoát khỏi cảnh nô lệ, như người đi trên con đường nguy hiểm, đến được đích an toàn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Trí", "definition": "S: pañcajñāna; Hán Việt: Ngũ trí ( 五 智 ); Năm loại trí được trình bày theo Mật giáo. Năm trí này miêu tả tất cả những khía cạnh của Tuyệt đối, của Chân như (S: tathatā) mà con người có thể thực hiện được khi đã chuyển hoá thân tâm. Thân tâm gọi cụ thể ở đây là năm nhóm, Ngũ uẩn với năm cấu uế, phiền não (S: pañcakleśa) phụ thuộc là tham dục (S: rāga), sân (S: dveṣa), si (S: moha, hoặc vô minh, S: avidyā), mạn (S: māna) và ganh ghét (S: īrṣyā). Năm trí bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Tuần Tự Pháp Thoại", "definition": "(Anupubbī-kathā), pháp thoại thứ lớp từ thấp lên cao.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Tâm Hoang Vu", "definition": "Nghi ngờ bậc Đạo sư, nghi ngờ pháp, nghi ngờ chúng tăng, nghi ngờ học pháp; có bốn lòng phẫn nộ đối với các bạn đồng tu Phạm hạnh, không có hoan hỷ (Trung Bộ I, 101).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Tâm Triền Phược", "definition": "P. Cetaso vinibandha. Tâm tham ái đối với dục vọng, tâm tham ái đối với tự thân (sakkàya), tâm tham ái đối với sắc pháp, ăn cho đến no bụng, thiên về khoái lạc sàng tọa, thích ngủ, nghỉ; sống Phạm hạnh nhưng mong cầu sinethiên giới (Trung Bộ Kinh I, 101A).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Tưởng", "definition": "Kinh nguyên thủy nói tới năm tưởng, mà Tỷ kheo cần tu tập:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Tạng", "definition": "Giáo điển trọn đời Phật dạy được phân làm năm loại, gọi là Năm Tạng; về phân loại, có nhiều thuyết khác nhau:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Năm Tịnh Cư Thiên", "definition": "Chỉ cho năm cõi Trời cao nhất của Sắc giới. Các vị Thánh chứng được quả Bất lai được sinh lên các cõi Trời này, để tiếp tục tu hành chứng quả A la hán:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Tội Lớn", "definition": "Xem Ngũ Vô Gián Nghiệp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năm Tội Nghịch", "definition": "H. Ngũ nghịch. Theo đạo Phật, có năm tội lớn, trái nghịc lớn với đạo đức làm người:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Uy Lực", "definition": "(Teja), quyền năng áp chế được nghịch cảnh.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Uẩn, Ngũ Uẩn", "definition": "(Pañcakkhandha), những tổng hợp tính chất của danh sắc, những thành phần tạo nên chúng sanh.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Uế Nhiễm", "definition": "Uế nhiễm là dơ bẩn. Có năm điều làm nhơ bẩn tâm là:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Vĩnh Minh thứ 11 (493), sư thị tịch. [X. Lương Cao Tăng Truyện Q.13].", "definition": "II.Tăng Biện (568-642).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm Vũ Đức thứ 6 (623) sư tịch.", "definition": "II.Minh Khoáng (? - ?).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm Vị", "definition": "H. Ngũ vị.Năm pháp vị. Một khái niệm của tông Thiên Thai, chia quá trình thuyết pháp của Phật ra làm năm thời giáo:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Vị Tỷ Kheo", "definition": "Năm vị xuất gia đầu tiên theo Phật Thích Ca, sau khi được nghe Phật giảng pháp “Bốn Đế” tại vườn Lộc Uyển gần thành phố Bénarés (Ba la nại). Năm vị này trước kia cùng tu khổ hạnh với Phật Thích Ca, về sau thấy Phật dùng sữa lại, tưởng Phật thối chí, nên bỏ đi. Sau khi Phật thành đạo dưới gốc cây Bồ đề, Phật nghĩ rằng năm người này xứng đáng và có đủ nhân duyên được Phật giác ngộ đầu tiên, Phật đã tìm đến họ và thuyết pháp cho họ nghe. Trong sách chữ Hán, khi nói đến bọn “ông Kiều Trần Như năm người” là nói năm vị Tỷ kheo này. Kiều Trần Như là dịch Hán âm từ chữ Sanskrit “Kondanna”. Kiều Trần Như là người giác ngộ sớm nhất trong số năm người.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm hạng người có khả năng thuyết pháp.", "definition": "I.Ngũ Chủng Thuyết Nhân.Theo luận Đại tri độ quyển 2 thì 5 hạng người có khả năng thuyết pháp là: Phật, đệ tử Phật, tiên nhân, chư thiên và hóa nhân. Quán Kinh Huyền Nghĩa Phần quyển 1 của ngài Thiện Đạo thì liệt kê: Phật Thuyết, Thánh đệ tử thuyết, Thiên tiên thuyết, quỉ thần thuyết, và biến hóa thuyết.Quán Kinh Huyền Nghĩa Phần Truyền Thông Kí quyển 4 thì nêu: Duy Ma Sở Thuyết, Bát Nhã Chuyển Giáo, Pháp Hoa Lãnh Giải... tức do các Thánh đệ tử nói.Còn trong các Kinh ghi Phạm Thiên, Đế Thích... thuyết pháp tức là chư thiên nói.Bà tẩu trong Phương Đẳng tức là do tiên nhân nói.Địa Thần trong Kinh Kim Quang Minh, 10 La Sát trong Kinh Pháp Hoa... tức là do quỉ thần nói.Trong 4 hạng người trên đây, người ẩn nguyên hình của mình đi, biến hóa ra thể khác để nói pháp, tức là do Biến hóa nói, như lúc Đức Phật nhập Niết Bàn, ngài Kiêu Phạm Ba Đề biến hóa làm nước mà nói kệ. Bốn loại người nêu trên khi nói pháp, nếu được Đức Phật ấn khả, thì đều gọi là Phật Thuyết.[X.Luận Phân Biệt Công Đức Q.1; Đại A La Hán Nan Đề Mật Đa La Sở Thuyết Pháp Trụ Kí; Vô Lượng Thọ Kinh Nghĩa Sớ Q.thượng (Tịnh Ảnh)]. II.Ngũ Chủng Thuyết Nhân.Cũng gọi Ngũ loại thuyết.Kinh Hoa Nghiêm chia những người có khả năng thuyết pháp làm 5 loại, tức là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm hạng người trên gọi là Ngũ nhân phi khí. Khi thụ giới, thuyết pháp loại bỏ 5 hạng người này gọi là Giản khí.", "definition": "II.Khí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm loại trái cây trên đây cũng được dùng để cúng dường trong pháp hội Vu Lan Bồn.[X.Vu Lan Bồn Kinh Sớ Q.hạ; Vu Lan Bồn Kinh Tân Sớ]. (xt. Ngũ Chủng Tịnh Thực).", "definition": "IV. Ngũ Quả.Chỉ cho 5 quả hiện tại: Thức, danh sắc, lục nhập, xúc và thụ trong mười hai chi nhân duyên.Khi phối hợp 12 nhân duyên với nhân quả 3 đời, thì 2 chi vô minh và hành là nhân quá khứ; 3 chi ái, thủ, hữu là nhân hiện tại; 2 chi sinh, lão tử là quả vị lai; còn 5 chi thức, danh sắc, lục thập, xúc, thụ là quả thân ngũ ấm hiện tại do nghiệp nhân quá khứ chiêu cảm, cho nên gọi là Ngũ quả.(xt. Hiện Tại Ngũ Quả).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm ngôi tinh xá và 10 tòa tháp, là những Thánh Tích của Phật Giáo ở Ấn Độ.", "definition": "I.Ngũ Tinh Xá.Về 5 ngôi tinh xá có các thuyết sau đây:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm thời tám giáo do ngài Trí Khải Tông Thiên Thai thành lập.Đại Sư Trí Khải căn cứ vào nội dung các Kinh điển do Đức Phật nói để phân loại, giải thích, rồi theo thứ tự thời gian Đức Phật Thuyết pháp mà chia làm 5 thời.Lại căn cứ theo phương pháp Đức Phật dắt dẫn chúng sinh mà chia giáo pháp của Ngài làm 8 giáo, gọi chung là Ngũ Thời Bát Giáo.", "definition": "I.Ngũ Thời.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm thứ biển có đầy đủ mọi công đức.", "definition": "I.Ngũ Hải.Chỉ cho 5 phần pháp nghĩa trong tạng Vô Tận Viên Minh Tính Hải của Đức Như Lai tự chứng. Tức là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm thừa này đều nhờ sức bản nguyện rộng lớn của Đức Phật A Di Đà mà được sinh về Tịnh Độ phương Tây, gọi là Ngũ thừa tề nhập.", "definition": "VII.Ngũ Thừa.Theo Tông Thiên Thai:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm vòng tròn trong 1 vòng tròn lớn của Mạn Đồ La Kim Cương Giới Mật Giáo. Mạn Đồ LaKim Cương Giới là pháp tu sinh tu hiển, người vào luân đàn (đàn hình tròn) này cởi bỏ được sự trói buộc của sinh tử trong 5 đường, thành tựu 5 trí trong sạch tròn sáng, cho nên ví dụ như vầng trăng (Nguyệt Luân) có đầy đủ đức tròn sáng, vì thế gọi là Ngũ Giải Thoát Luân. Về hình vẽ, trong 1 vòng tròn Kim Cương lớn vẽ 5 vòng tròn, chính giữa là đức Đại Nhật Như Lai, phương đông là A Súc Như Lai, phương nam là Bảo Sinh Như Lai, phương tây là A Di Đà Như Lai và phương bắc là Thiên Cổ Lôi Âm Như Lai.Trong Hội Thành Thân thì có vị đại thần nâng đỡ lấy vòng Kim Cương lớn này. Bốn vị đại thần biểu thị 4 Đại: Đất, nước, lửa, gió, còn Ngũ Giải Thoát Luân thì biểu thị cho không Đại của 5 trí. [X.Kinh Kim Cương Đính Q.thượng; Kinh Đại Giáo Vương Q.5]", "definition": "II.Ngũ Giải Thoát Luân.Tên khác của Ngũ Luân Tháp. (xt. Ngũ Luân Tháp).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năm Điều Không Xác Định", "definition": "(Avavaṭṭhāna).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Điều Nên Thường Quán Tưởng", "definition": "(Abhiṇhapaccavekkhaṇa).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Đình Bốn Niệm", "definition": "Năm phép quán đình tâm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Đướng Ác", "definition": "Xem Ngũ Thú.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năm Đại", "definition": "Năm chất lớn cấu thành vũ trụ vật chất:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Đầy Đủ", "definition": "H. Ngũ cụ túc Năm pháp mà một Tỷ kheo cần phấn đấu để có đầy đủ:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Định Luật", "definition": "(Niyāma), Pháp Cố Nhiên, Qui Luật Tự Nhiên", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm Định Luật Thiên Nhiên", "definition": "Pañca-niyama (S), Five natural orders, Dharma-niyama.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năm Đồng Duyên Ý Thức", "definition": "Khái niệm của môn Duy Thức Học. Cũng gọi là ngũ câu ý thức. Khi chúng ta tiếp xúc với ngoại cảnh sắc, thanh v.v… thì ý thức cùng duyên cảnh với năm thức đầu, tức là với nhãn thức, nhĩ thức, tị thức, thiệt thức, thân thức. Thí dụ, mắt nhìn thấy sắc, thì ý thức cũng duyên với sắc, tạo ra một hình ảnh của sắc, không phải của riêng nhãn thức mà cả của ý thức nữa. Nói cách khác, cái hoa mà chúng ta thấy trước mặt không phải chỉ là cái hoa của con mắt thấy mà cả của ý thức nắm bắt nữa. Đối với các thức khác, nhĩ thức v.v… tình hình cũng như vậy.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Năm Đức Tính Pháp Sư", "definition": "(Dhammadesakadhamma), năm pháp trú để thành vị pháp sư chân chánh.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Năm, Phạm Thừa. Phạm tức là tịnh. Các vị Bồ Tát dùng bốn vô lượng tâm từ, bi, hỉ, xả chuyển chở chúng sanh ra khỏi biển sanh, tử. Đó gọi là phạm thừa. (Bốn vô lượng tâm là từ là cho vui; bi là cứu khổ; hỉ là lìa khổ được vui; xả là oán hay thân đều bình đẳng. bốn vô lượng tâm này là vì chúng sanh nhiều vô lượng, nên tâm Bồ Tát cũng vô lượng).", "definition": "五乘 (Vu Lan Bồn Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Năm, Thân Thức. Thân Căn do đối Xúc Trần thì thức của thân sinh ra. Khi thức này sanh ra, chỉ có khả năng biết sự xúc chạm. Đó gọi là Thân Thức.", "definition": "五識 (Khởi Tín Luận Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Năm, Tiểu Thừa. Người tu theo Tiểu Thừa là trời và người. Trời và người lấy năm giới và thập thiện làm xe, chuyên chở ra khỏi bốn đường ác, nên gọi là Tiểu Thừa. (bốn đường ác là Tu La, Ngạ Quỷ, Súc Sanh, Địa Ngục)", "definition": "五乘 (Hoa Nghiêm Nhất Thừa Giáo Nghĩa Phân Tề Chương)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Năm, Xúc Dục. Thân thể nam, nữ mềm mại, trơn lán, khi lạnh thì thân thể ấm, khi nóng thì thân thể mát, cho đến quần áo các loại khi va chạm đến, hay khiến cho chúng sanh đam mê không chán, nên gọi là Xúc Dục.", "definition": "五欲 (Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Năng", "definition": "耐. Dùng như chữ Năng 能 Một âm khác là Nại. Xem Nại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Năng - Sở", "definition": "Một động tác thường có hai phần: phần chủ thể gây nên động tác, và phần đối tượng mà động tác ấy ảnh hưởng đến. Trong thuật ngữ Phật học, chữ “năng” được dùng để chỉ cho phía chủ thể; và chữ “sở” được dùng để chỉ cho phía đối tượng. Hai chữ này được dùng rất thường xuyên, tạo thành những đôi thuật ngữ ngắn gọn, xuất hiện rất nhiều trong kinh luận. Ví dụ: “Tâm biết (tri) vật”, thì TÂM gọi là “năng tri”, VẬT gọi là “sở tri”; “mắt thấy (kiến) sắc”, thì MẮT gọi là “năng kiến”, và SẮC gọi là “sở kiến”; “ý thức phân biệt pháp trần”, thì Ý THỨC gọi là “năng phân biệt”, và PHÁP TRẦN gọi là “sở phân biệt”; v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Năng An Nhẫn", "definition": "Cũng gọi An Nhẫn Thành Tựu, An Nhẫn Cường Nhuyến Tặc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Biến", "definition": "Chỉ cho 8 thức. Tông Duy Thức cho rằng tất cả muôn pháp đều do thức biến hiện, cho nên gọi 8 thức là Năng Biến. Tiểu Thừa chỉ lập có 6 thức, nhưng Đại Thừa Duy Thức thì lập 8 thức và chia làm 3 loại: Sơ Năng Biến (thức thứ 8), Đệ Nhị Năng Biến (thức thứ 7) và Đệ Tam Năng Biến (6 thức trước), gọi là Tam Năng Biến. (xt. Tam Năng Biến, Duy Thức).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Biến Kế", "definition": "Đối lại: Sở Biến Kế. Thức thứ 6 và thức thứ 7 so đo tính toán khắp các pháp rồi vọng chấp có thực ngã, thực pháp, gọi là Năng Biến Kế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Biệt", "definition": "Đối lại: Sở Biệt. Cũng gọi Hậu Trần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Biệt Bất Cực Thành Quá", "definition": "Năng Biệt Bất Cực Thành, Phạm: Aprasiddha-vizewaịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Bị Pháp", "definition": "Đối lại: Sở bị cơ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Duyên", "definition": "Xem Phan duyên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Duyên Phược", "definition": "Đối lại: Sở Duyên Phược.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Duyên Đoạn", "definition": "Đoạn trừ các phiền não của Năng Duyên. Khi các phiền não của Năng Duyên đã bị đoạn trừ thì các phiền não của Sở Duyên cũng tự tiêu diệt. Đây là 1 trong 4 nhân (..) đoạn trừ phiền não.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Dẫn Chi", "definition": "Chỉ cho 2 chi Vô Minh và Hành trong 12 nhân duyên, vì 2 chi này có khả năng dẫn phát 5 thứ quả: Thức, danh sắc, lục nhập, xúc và thụ, cho nên gọi là Năng dẫn chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Già", "definition": "Xem Đà La Ni.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Giải", "definition": "能 解. Bản lĩnh. Tiết Nam Tháp Quang Dũng Thiền Sư trong TLTBT q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Năng Hiển Giải Thoát Đạo Luận", "definition": "Gọi đủ: Thích Lượng Tụng Vô Điên Đảo Hiển Thị Giải Thoát Đạo Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Hiển Trung Biên Tuê Nhật Luận", "definition": "Gọi tắt: Tuệ Nhật Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Huân", "definition": "Đối lại: Sở Huân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Huân Tứ Nghĩa", "definition": "Bốn nghĩa Năng Huân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Hàng Phục", "definition": "Xem Di Già.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Hành", "definition": "Đối lại: Sở hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Hành Giả", "definition": "Chỉ cho Lục Tổ Tuệ Năng, vì khi mới đến Hoàng Mai hầu Ngũ Tổ, Tuệ Năng còn là 1 hành giả (cư sĩ) nên được gọi là Năng Hành Giả. (xt. Tuệ Năng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Hóa", "definition": "Đối lại: Sở Hóa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Hóa Công Tồn", "definition": "(能化功存, Nōke Kōzon, 1720-1796): xem Công Tồn (功存) vị Tăng của Chơn Tông, sống trong khoảng thời đại Giang Hộ, từng đảm nhiệm chức Năng Hóa (能化, Nōke) trong vòng 28 năm (1769-1796) ở Học Lâm của Bổn Nguyện Tự (本願寺, Hongan-ji). Ông xuất gia ở Bình Thừa Tự (平乘寺, Heijō-ji) vùng Việt Tiền (越前, Echizen, thuộc Fukui-ken [福井縣]), nơi ông xuất thân. Vào năm 1762 (Bảo Lịch [寶曆] 12), ông viết cuốn Nguyện Sanh Quy Mạng Biện (願生歸命辨) và sau này Trí Động (智洞), người nhậm chức Năng Hóa đời thứ 8, cũng tiếp tục kế thừa tư tưởng này và phát huy mạnh hơn nữa.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Năng Hải", "definition": "能 海 (1886-1967). Thiền tăng hiện đại, họ Cung, tên Học Quang, tự Tập Hy. Người xứ Miên Trúc, Tứ Xuyên, Trung Quốc. Năm 1924, sư đến chùa Thiên Bảo huyện Bồi Lăng theo ngài Phật Nguyên xuất gia, rồi đến nương Hòa Thượng Quán Nhất thụ giới cụ túc. Năm 1935 nhận chức phương trượng Quảng Tế Mao Phùng ở núi Ngũ Đài. Về sau, sư lập pháp hội ở các nơi: Bắc Kinh, Võ Hán, Thượng Hải, núi Ngũ Đài để giảng kinh hoằng pháp. Năm 1953, sư được chọn làm Phó hội trưởng Hội Phật Giáo Trung Quốc. Về già sư an cư ở cầu Thanh Lương, núi Ngũ Đài, dẫn đầu tăng chúng phát huy truyền thống “Một ngày không làm, một ngày không ăn” của Tổ Bách Trượng. Sư vừa trồng rừng quanh chùa vừa giảng kinh hoằng pháp, giữ gìn nông thiền và chú trọng đến quy củ của Thiền Tông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Năng Kiến Tâm Bất Tương Ứng Nhiễm", "definition": "Do sự khởi động của Vô Minh căn bản mà thành tướng Năng kiến, là 1 trong 6 tâm ô nhiễm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Kiến Tướng", "definition": "Cũng gọi Chuyển tướng, Kiến Tướng. Tướng Năng kiến do nghiệp thức chuyển thành, là 1 trong 3 tế, 1 trong 9 tướng. Tướng này một mặt có động tác, mặt khác, cũng có tướng năng kiến; nhưng cảnh giới của giai vị này rất nhỏ nhiệm, không thể phân biệt được, cho nên gọi là “tế”. [X. Đại Thừa Khởi Tín Luận Nghĩa Sớ Q.thượng, phần hạ].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Lập", "definition": "Xem Thành Tựu Pháp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Lập Bất Khiển Quá", "definition": "Phạm: Sàdhanàvyàvftta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Lập Pháp Bất Thành Quá", "definition": "Năng Lập pháp bất thành, Phạm:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Lập Sở Lập", "definition": "Cũng gọi Năng thành lập sở thành lập. Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Lực", "definition": "能力. Cái sức có thể đem dùng vào việc được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Năng Lực Tâm Linh", "definition": "Spiritual power.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Lực Tâm Vật Lý", "definition": "Psycho-physical energy.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Mãng", "definition": "Xem Thích Ca Mâu Ni.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Môn", "definition": "Môn năng nhập. Trong tín ngưỡng Phật Giáo, lí là pháp sở nhập, còn giáo là môn năng nhập.Pháp Hoa Văn Cú quyển 5 thượng (Đại 34, 64 trung) nói: “Chấp chặt một lí sở nhập thì sẽ nghi ngờ năng môn 3 giáo”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Nhân", "definition": "Phạm: Zàkya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Nhân Tự", "definition": "能 仁 寺. 1. Chùa nằm dưới ngọn Đơn Phương trong hang phía tây cửa núi Nhạn Đãng thuộc tỉnh Chiết Giang, Trung Quốc. Tương truyền Nặc Cự Na là Tổ khai sơn núi này. Niên hiệu Thái Bình Hưng Quốc thứ 1 (976) đời Tống, có vị tăng tên Toàn Liễu vào núi cất am để ở, đề tên là “Phù Dung Am”. Niên hiệu Hàm Bình thứ 2 (999) mới bắt đầu xây cất điện vũ, chư tăng trong chùa dâng tháp Bá Bảo, được vua ban hiệu là “Thừa Thiên Tự”. Niên hiệu Thiệu Hưng thứ 12 (1142), Quận thú là Diêm Khâu Hân vâng lệnh vua đổi tên là “Năng Nhân Thiền Viện” và trở thành đại đạo tràng của núi Nhạn Đãng. 2. Chùa ở đường Dân Đức thành phố Nam Xương tỉnh Giang Tây, Trung Quốc, được xây dựng khoảng niên hiệu Thiên Giám (502-519) nhà Lương thuộc Nam Triều, ban đầu chùa có tên là “Thượng Lam Tự”, sau đổi thành “Đại Phật Tự”… Khoảng niên hiệu Khai Nguyên đời Đường (713-741) được đổi tên là “Khai Nguyên Tự”. Bắt đầu vào niên hiệu Đại Lịch thứ 4 (769), vị thiền sư nổi tiếng là Mã Tổ Đạo Nhất đã ở chùa này tiếp hóa người học, thiền tăng tấp nập kéo đến khiến chùa này trở thành đạo tràng nổi tiếng hoằng dương thiền phong của Mã Tổ Đạo Nhất. Khoảng niên hiệu Đại Trung (847-860), chùa đổi tên là “Thượng Lam Viện”. Niên hiệu Hàm Bình (998-1003) đời Tống, chùa lại đổi tên là “Thừa Thiên Tự”. Khoảng niên hiệu Chính Hòa (1111-1118) lại đổi tên là “Năng Nhân Tự”. Niên hiệu Cảnh Thái (1450-1456) đời Minh, chùa được đổi tên “Hựu Thanh Tự”. Năm 1929, đổi tên là “Hựu Dân Tự”. Kiến trúc hiện còn là do đời Thanh trùng tu. Trong chùa có tượng Phật to bằng đồng, thân cao 5,4m nặng 18 tấn, còn có một Đại đồng chung cao 2,1m nặng độ 5 tấn, được đúc vào niên hiệu Cảnh Đức đời Đường (967), được treo trên lầu 4 của Hoa Nham Thạch Phương, lầu này nằm bên phải chùa. 3. X. Thừa Thiên Viện.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Năng Nhơn", "definition": "Xem Thích Ca Mâu Ni.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Nhẫn", "definition": "Xem Ta Bà.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Phá", "definition": "Tiếng dùng trong Nhân Minh. Phá luận thức của đối phương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Sanh Nhất Thiết Chư Phật Kinh", "definition": "Sarva-buddha-gati Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Sinh Chi", "definition": "Chỉ cho 3 chi Ái, Thủ, Hữu trong 12 nhân duyên, vì 3 chi này hay sinh ra quả sinh, lão tử trong tương lai, nên gọi là Năng sinh chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Suất", "definition": "能率. Mức đạt được trong việc làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Năng Sở", "definition": "Từ gọi chung Năng và Sở. Chủ thể của 1 động tác gọi là Năng; khách thể (đối tượng)của động tác ấy gọi là Sở. Chẳng hạn như “mắt” hay thấy vật, gọi là Năng kiến, còn “vật” do mắt thấy thì gọi là Sở kiến. Cũng thế, người bị nương tựa gọi là Sở y, người nương tựa vào kẻ khác gọi là Năng y. Người tu hành gọi là Năng hành, pháp môn được tu hành gọi là Sở hành. Người qui y gọi là Năng qui, chỗ qui y gọi là Sở qui; người giáo hóa gọi là Năng hóa, người được giáo hóa gọi làSở hóa; chủ thể nhận thức gọi là Năng Duyên, đối tượng bị nhận thức gọi là Sở Duyên. Ngôn ngữ, văn chương, giáo pháp... biểu thị ý nghĩa, gọi là Năng thuyên, ý nghĩa được biểu thị gọi là Sở Thuyên v.v...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Sở Song Tuyệt", "definition": "能 所 雙 絕. Quét sạch cả hai bên chủ động (năng) lẫn thụ động (sở), cũng chính là dẹp trừ tâm đối đãi phân biệt. Chương Thiên Thai sơn Trấn Quốc Đại sư Trừng Quán “đáp Hoàng thái tử vấn tâm yếu” trong CĐTĐL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Năng Thiên Chủ", "definition": "Xem Thích Đề hoàn Nhân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Thuyên", "definition": "Đối lại: Sở Thuyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Thí Thái Tử", "definition": "Cũng gọi Đại Thí thái tử, Phổ Thí thái tử. Tiền thân của Đức Phật, khi tu hạnh Bồ Tát ở nhân vị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Thọ Tất Địa Bồ Tát", "definition": "Xem Kim Cang Ngữ Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Thủ Sở Thủ", "definition": "Phạm: Gràhya-gràhaka.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Trì", "definition": "Xem Đà La Ni.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Tác Nhân", "definition": "Karaṇa-hetu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Tín", "definition": "Đối lại: Sở tín.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Tông", "definition": "能 宗. Chỉ cho Thiền Tông Nam tông của Lục tổ Huệ Năng sáng lập. Thần Tú truyện trong TCTT q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Năng Tĩnh Quan Âm", "definition": "Danh hiệu của 1 trong 33 thân ứng hóa của Bồ Tát Quan Thế Âm. “Năng tĩnh” nghĩa là vị Bồ Tát này có năng lực đem lại sự an ổn cho những người gặp tai nạn hiểm nghèo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Tạo Sở Tạo", "definition": "Từ gọi chung Năng tạo và Sở tạo. Bốn yếu tố lớn: Đất, nước, lửa, gió có đầy đủ 5 nhân (sinh nhân, y nhân, lập nhân, trì nhân, dưỡng nhân), có khả năng tạo các pháp (vật chất), vì thế gọi là Năng Tạo (Tứ Đại Năng Tạo); còn tất cả các sắc pháp do 4 yếu tố lớn ấy tạo ra thì gọi là Sở tạo (Tứ Đại Sở Tạo). Theo Thuyết Nhất Thiết Hữu Bộ thì 4 yếu tố lớn là Năng tạo, còn 11 sắc pháp (5 căn, 5 cảnh và vô biểu sắc) là Sở tạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Tịch", "definition": "Xem Thích Ca Mâu Ni.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Y", "definition": "Đối lại: Sở y.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Năng Điều Bồ Tát", "definition": "Xem Minh Võng Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Năng Đại Sư", "definition": "Tức Đại sư Tuệ Năng, Tổ thứ 6 của Thiền Tông Trung Quốc. (xt. Tuệ Năng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nũng", "definition": "繷. Nhiều. Thịnh. Cũng nói: Phân nũng 繷紛.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nơ", "definition": "Sikhā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi Cư Ngụ", "definition": "Āvasatha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi Hỏa Táng", "definition": "Āḷāhanaṭṭhāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi Nghỉ Ngơi", "definition": "Niḍḍa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi Sản Xuất", "definition": "Ākara (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi Thanh Tịnh", "definition": "Khemabhūmi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi Đây", "definition": "Iddha (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nơi ẩn Trốn", "definition": "Khemaṭṭhāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nư", "definition": "挐. Cầm nắm. Nắm giữ (có người quen đọc Như).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nưu", "definition": "譨. Nói nhiều quá Một âm là Nông. Xem Nông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nương", "definition": "娘. Nàng. Cô nàng. Tiếng gọi người con gái. Td: Cô nương Tiếng gọi mẹ Tiếng gọi người đàn bà quyền quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nương Củ Tra Trùng", "definition": "Cũng gọi Nương Cưu Đa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nương Nhờ", "definition": "Tāṇa (trung), tāṇatā (nữ), tāyati (tā + ya), parittāṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nương Nương", "definition": "娘娘. Tiếng gọi bà hoàng hậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nương Sinh Diện", "definition": "娘 生 面. Còn gọi: Nương Sinh Khóa (cái khố của người mẹ). Khuôn mặt mẹ. Nương sinh có nghĩa là người mẹ. Nương sinh diện cũng như Bản lai diện mục. Thuật ngữ này mượn của Lão giáo dùng để chỉ cho Tự tính. Bài An Định Thời Tiết trong Tuệ Trung Thượng Sĩ Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nương Tử", "definition": "娘子. Tiếng chồng gọi vợ. Tiếng người đàn ông gọi người yêu Chỉ chung đàn bà con gái. Đại Nam Quốc Sử diễn ca có câu: “Chị em nặng một lời nguyền, phất cờ nương tử thay quyền tướng quân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nước", "definition": "Āpo (S), Apas (S), Jala (S), Water.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nước Bùn", "definition": "Kaddamodaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Bọt", "definition": "Kheda (nam), elā (nữ), kheḷa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Chuối Ép", "definition": "Cocapāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Cốt", "definition": "Yūsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Dãi", "definition": "Kheda (nam), elā (nữ), kheḷa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Hoa", "definition": "Gandhatela (trung) gandhodaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Hoa Hỉ", "definition": "Land of Joy", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Nước Lã", "definition": "Sītodaka (trung), udaka (trung), jala (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Lạnh", "definition": "Sītodaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Miếng", "definition": "Kheda (nam), elā (nữ), kheḷa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Mía", "definition": "Ucchurasa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Mũi", "definition": "Siṅghānikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Mắt", "definition": "Assu (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Nhớt Trong Các Khớp Xương", "definition": "Lasikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Phép", "definition": "Xem Cam Lồ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nước Rửa Chân", "definition": "Pādodaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Rửa Mặt", "definition": "Mukhodaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Sôi", "definition": "Nippakka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Sông Hằng", "definition": "Gaṅgājala (S), Water of the Ganges.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nước Súp", "definition": "Yūsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Thánh", "definition": "Nectar.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nước Thơm", "definition": "Gandhajala (S), Fragrant water.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nước Tiểu", "definition": "Mutta (trung), passāva (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Tiểu Bò", "definition": "Gomutta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Trái Cây", "definition": "Phalarasa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Uống", "definition": "Jala (trung), udaka (trung), nīra (trung), aṇṇa (nam), papa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Xoài Ép", "definition": "Ambapāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Ép Từ Loại Chuối Không Hột", "definition": "Mocapāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Đá", "definition": "Hima (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nước Đánh Bóng", "definition": "Nibhā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nướng", "definition": "Bhajjati (bhaj + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nạch", "definition": "搦. Chống tay lên. Tì lên Cầm nắm Ta có người quen đọc Nhược.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạch Quản", "definition": "搦管. Cầm cán bút mà viết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nại", "definition": "佴. Họ người Một âm là Nhị. Xem Nhị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nại Cửu", "definition": "耐久. Chịu đựng lâu dài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nại Hà", "definition": "奈何. Biết làm sao? Làm sao được?.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nại Hà Tân", "definition": "Cũng gọi Tam Đồ Hà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nại Lương Thời", "definition": "Nara period.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nại Lương Đại Phật", "definition": "Cũng gọi Đông Đại Tự Đại Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nại Lạc Ca", "definition": "Xem Địa ngục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nại Thị", "definition": "Phạm:Àmra. Hán âm: Am La. Cũng gọi Am Bà Nữ, Am Thụ Nữ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nại Thị Viên", "definition": "Xem Am Một La.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nại Trọng", "definition": "Hình quỉ được khắc trên những đầu cột hoặc dưới các xà ngang, trong tư thế đứng xoạc chân, gồng người, đầu và 2 bàn tay nâng đỡ lấy mái chùa, gọi là Nại trọng(chịu đựng sức nặng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nại Tâm", "definition": "耐心. Lòng chịu đựng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nại Viên", "definition": "Xem Am Một La.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nạm", "definition": "腩. Thứ nem làm bằng thịt bê, hoặc thịt nghé (trâu hoặc bò con) Thịt mỡ lẫn lộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạn", "definition": "戁. Kính trọng Hổ thẹn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạn Dân", "definition": "戁民. Người trong nước gặp điều tai hại xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạn Nạn", "definition": "Chala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nạn Phá", "definition": "Vấn nạn, Luận phá.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạn Thích Nghi Luận", "definition": "Tác phẩm, 1 quyển, do cư sĩ Chu đạo tổ soạn vào đời Đông Tấn, được thu vào Quảng Hoằng Minh Tập quyển 18 trong Đại Chính Tạng tập 52.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạn Thế", "definition": "Chỉ cho khí thế vấn nạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạn Tĩnh Khang", "definition": "Tĩnh-khang (1126-1127) là niên hiệu của vua Khâm-tông, tức vị vua cuối cùng của vương triều Bắc-Tống (960-1127). Khâm-tông là con của vua Tống Huy-tông (1101-1125). Trong thời gian tại vị, vua Huy-tông, vì nghe lời nịnh thần cấu kết với đạo sĩ, đã hủy diệt Phật giáo đến cùng tận. Năm 1125, quân Kim đánh Tống rất gấp; sang đầu năm sau (1126), Huy-tông truyền ngôi cho Khâm-tông để làm thái thượng hoàng, rồi bỏ xuống Giang-nam trốn giặc. Vua Khâm-tông vẫn ở Biện-kinh (kinh đô nhà Bắc-Tống) để chống cự với giặc Kim. Sang năm 1127 (tức năm thứ hai niên hiệu Tĩnh-khang), thượng hoàng Huy-tông trở về Biện-kinh. Quân Kim liền đánh thẳng vào Biện-kinh, bắt tất cả từ thượng hoàng Huy-tông, vua Khâm-tông, hoàng hậu, đến thái tử, phi tần, hoàng tộc, tất cả là 3.000 người, lại cướp bóc vàng bạc cùng tất cả con gái trong thành Biện-kinh, đem về miền Bắc (nước Kim). Nạn “Tĩnh-khang” chính là nạn này.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Nạn Đói", "definition": "Dubbhikkha (trung), chātaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nạo", "definition": "悼. Sợ hãi Thương tổn Yêu mến Ta quen đọc là Điệu. Td: Truy điệu (xót thương người chết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp", "definition": "内. Vào trong. Đem vào trong. Dùng như chữ Nạp 納 Một âm là Nội. Xem Nội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp A Cát Tắc Nạp", "definition": "Xem Na Tiên Tỳ Kheo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nạp Bá", "definition": "Loại áo vị tăng mặc khi giảng kinh, như áo thụng(áo lễ) của chư tăng ngày nay.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Bại Khuyết", "definition": "納 敗 缺. Bị thua, làm cho khổ. Tiết Hoa Tạng Trí Thâm Thiền Sư trong NĐHN q. 12 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Bị Tập", "definition": "衲被集. Tên một tập thơ chữ Hán của Tùng Thiện Vương, con trai vua Minh Mệnh nhà Nguyễn và cũng là danh sĩ đương thời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Chúng", "definition": "Chỉ cho Đại Chúng mặc áo nạp tham dự pháp hội, hoặc theo nghĩa rộng, Nạp chúng là danh từ gọi chung chúng tăng xuất gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Cát", "definition": "納吉. Một nghi lễ trong hôn lễ thời xưa, tức nghi lễ nhà trai chọn ngày tốt để cưới và báo tin cho nhà gái biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Cốt", "definition": "Cũng gọi Nhập cốt, Nhập tháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Cụ", "definition": "Nhận lãnh giới Cụ Túc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Giao", "definition": "納交. Kết bạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Hối", "definition": "納賄. Nhận tiền của đút lót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Khoản", "definition": "納 款. Hàng phục. Tiết Thị Dục Tạng Chủ trong Duy Tắc Ngữ Lục q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Khuyết", "definition": "納 缺. Gọi đủ: Nạp Bại Khuyết. Bị thua. Tiết Thiên Đồng Hàm Kiệt Thiền Sư trong NĐHN q. 12 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Kinh", "definition": "Cũng gọi Lục Thập Lục Bộ Nạp Kinh, Lục Bộ Nạp Kinh, Hồi Quốc Nạp Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Mạo", "definition": "Chiếc mũ của Tỉ Khưu may bằng các miếng vải vụn xấu chắp nối lại.[X. truyện Cảnh oanh trong Tục Cao Tăng Truyện].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Phùng Tố Ca", "definition": "Phạm: Napuôsaka.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Phạn A Sư", "definition": "納 飯 阿 師. Thầy chùa ăn hại, là lời trách mắng các tăng sĩ giống như cái thùng cơm. Vân Môn Quảng Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Quyển", "definition": "納卷. Nộp bài thi (trong thể lệ khoa cử thời xưa). Hoa Tiên có câu: “Y kì nạp quyển đề danh, trận thu cờ trống luỹ thành một ai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Sở", "definition": "Nơi dành cho việc thu chi tiền bạc, thóc gạo trong tự viện thuộc Thiền Tông, do vị dịch tăng trông coi.Nếu người thế tục đảm nhiệm chức vụ này thì nơi đó được gọi là Tục Nạp Sở. [X. môn Chức Vị trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Thuế", "definition": "納稅. Nộp tiền bạc theo sự ấn định của chính phủ, căn cứ trên việc buôn bán, sinh hoạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Thái", "definition": "納菜. Một nghi lễ quan trọng trong hôn lễ thời xưa. Cũng như Nạp tệ 納菜. Đoạn trường tân thanh có câu: “Đủ điều nạp thái vu quy, đã khi chung chạ lại khi đứng ngồi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Thể", "definition": "Nhận lãnh giới thể. Giới Thể phát ra từ trong tâm của hành giả thụ giới, có công năng ngăn ngừa việc sai quấy. [X. Hoằng Giới Pháp Nghi].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Thụ", "definition": "Có 2 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Tăng (Nạp Tử)", "definition": "納 僧 (納 子). Người xuất gia, Tăng hành cước. Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Tăng Ba Tỵ", "definition": "衲 僧 巴 鼻. Chỉ cho đạo pháp, cơ phong nhà thiền. Tiết Kiền Phong Huệ Viên Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Tăng Hành Cước Sự", "definition": "Đồng nghĩa: Nạp Y Hạ Sự, Nạp Tăng Bản Phận Sự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Tăng Môn Hạ", "definition": "衲 僧 們 下. Chỉ cho môn đình thiền tông, nhà thiền. Tiết Bắc viện Thông Thiền Sư trong NĐHN q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Tăng Nhãn Tình", "definition": "衲 僧 眼 睛. Con mắt trí huệ của thiền tăng có thể thấy rõ tự tâm bản tính. Tiết Định Sơn Duy Tố sơn chủ trong NĐHN q. 10 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Tăng Tị Khổng", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Tăng Tỵ Khổng", "definition": "衲 僧 鼻 孔. Còn gọi: Nạp Tăng Đỉnh Môn, Nạp Tăng Nhãn Tình. Lỗ mũi của nạp tăng. Chỉ cho vật rất quan trọng của người tu hành Phật đạo, tức là cơ phong đạo pháp của nhà Thiền. Tiết Càn Phong Huệ Viên Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Tệ", "definition": "納幣. Nghi lễ nhà trai nộp tiền bạc vật dụng cho nhà gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Tức", "definition": "Phạm: Varga. Pàli: Vagga.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Tử", "definition": "衲子. Tiếng tự xưng của tu sĩ Phật giáo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nạp Y", "definition": "Cũng gọi là Phẩn Tảo Y, Tệ Nạp Y, Ngũ Nạp Y, Bách Nạp Y.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Y Hạ Sự", "definition": "衲 衣 下 事. Chỉ cho việc lớn trong nhà thiền, minh ngộ tâm địa, siêu thoát sinh tử. Phần Dương Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nạp Y Thập Lợi", "definition": "Mười điều lợi của việc mặc nạp y (áo chắp vá).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Đậu", "definition": "Một loại thực phẩm được sử dụng trong các chùa viện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nạp Đắc", "definition": "Nhận lãnh được giới thể. Giới Thể phát sinh từ trong tâm của người thụ giới, có công năng ngăn ngừa việc làm sai quấy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nả", "definition": "娜. Lay động mềm mại. Td: Nả nả (phất phơ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nải", "definition": "Mañjarī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nấc Thang", "definition": "Sopāna (nam), nissenī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nấm", "definition": "蕈. Tên một loài cây, dùng làm thực phẩm, ngon và bổ, tư cũng gọi là cây nấm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nấp Trốn", "definition": "Nilīyati (ni + lī)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nấu", "definition": "(Ăn). Pacati (pac + a), pacana (trung), pāka (nam), pācaka (tính từ), piṅgala (tính từ), randhana (trung), randheti (randh + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nẩy Mầm", "definition": "Virūhati (vi + ruh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nẫm", "definition": "稔. Lúa chín Chỉ một năm Cũng đọc Nhẫm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nật", "definition": "嫟. Sát gần nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nậu", "definition": "槈. Cái bừa dùng để bừa ở ruộng nước nông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nắm Gạo", "definition": "Taṇḍulamuṭṭhi (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nắm Hột Mè", "definition": "Tilamuṭṭhi (in)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nắm Tay", "definition": "(Bàn Tay Nắm Lại). Muṭṭhi (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nắp", "definition": "Pacchāda (nam), pidhāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nắp Bình", "definition": "Sarāva (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nắp Đậy", "definition": "Apidhāna (trung), paccattharaṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nắp Ấm", "definition": "Sarāva (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nằm Dài", "definition": "Pasāreti (pa + sar + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nằm Lên", "definition": "Adhiseti (adhi + si + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nằm Thấp", "definition": "Ninna (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nằm Trên", "definition": "Abhinipajjati (abhi + ni + pad + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nằm Xuống", "definition": "Abhinikkhipati (abhi + ni + khip + a), abhinikkhapana (trung), nipajjati (ni + pad + ya), nipajjana (trung), nisādī (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nẵng", "definition": "Cũng gọi Na, Noa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nặc", "definition": "匿. Ẩn giấu. Giấu kín, không cho người khác biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nặc Cù Đà Thụ", "definition": "Phạm: Nyagrodha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nặc Củ La", "definition": "Phạm: Nakula.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nặc Cự La", "definition": "Nakula (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nặc Danh", "definition": "匿名. Giấu tên. Không cho biết tên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nặc Hộ", "definition": "匿户. Người cư ngụ bất hợp pháp, không được ghi chép trong sổ sách địa phương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nặc Kiên Na", "definition": "Phạm: Mahà-nagna.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nặc Kiện Na", "definition": "Xem Đại Lộ Thần.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nặc Môn Hãn", "definition": "Danh hiệu của vị Đại Lạt Ma trong Lạt Ma Giáo ở Mông Cổ, Tây Tạng. Danh hiệu này nghĩa là Pháp Vương, ngôi vị chỉ đứng sau vị Hô Đồ Khắc Đồ (Phật sống).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nặn", "definition": "Āviñjati (ā + vij + ñ + a), nippīḷana (trung), nippīleti (ni + pīl + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nặng", "definition": "Bhāriya (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nặng Nề", "definition": "Bhārika (tính từ), bhāriya (tính từ), garu (tính từ), garuka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nếm", "definition": "Vidhupeti (vi + dhūp + e), rasa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nếm Thử", "definition": "Sāyati (sā + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nếp Nhăn", "definition": "Vali (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nếu", "definition": "Yadi", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nếu phối hợp Tam Tạng với Tam Học thì Kinh tương đương với Định Học, Luật tương đương với Giới Học, còn Luận thì tương đương với Tuệ Học. Đồng thời, Kinh bao hàm cả giới, định, và tuệ, Luật bao hàm giới và định, còn Luận thì chỉ bao hàm tuệ học mà thôi.Ngoài ra, còn có các phương diện khác nhau về việc thiết lập Tam Tạng. Từ xưa đến nay, Tam Tạng vốn chỉ cho Thánh điển của Phật Giáo Nguyên Thủy và Phật Giáo Bộ Phái, cũng tức là Tam Tạng Giáo (Tạng Giáo) của Tiểu Thừa, về sau, từ ngữ này được Đại Thừa sử dụng, do đó, Tam Tạng có Hạ thừa (Thanh Văn Thừa) và Thượng thừa (Bồ Tát Thừa) khác nhau, hợp chung lại thì thành “Lục tạng”. [X. Kinh Tăng Nhất A Hàm Q.2; Luật Thập Tụng Q.60; Luận Phân Biệt Công Đức Q.1, Luận Đại Thừa A Tì Đạt Ma Tạp Tập Q.11; Nhiếp Đại Thừa Luận Thích Q.1 (bản dịch đời Đường), Đại Thừa Khởi Tín Luận Nghĩa Kí Q.thượng].", "definition": "II.Tam Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nếu được vô vi mới phải nhà”.", "definition": "2. Thiền viện nằm trên sườn ngọn núi Lớn (Tao Phùng Sơn), thuộc phường 6, thành phố Vũng Tàu, tỉnh Bà Rịa Vũng Tàu,Việt Nam. Muốn lên thiền viện du khách từ đường Lê Lợi rẻ lên đường Viba độ 500 m có đường tẻ bên phải đi thêm 700 m đến nơi. Thiền viện mang tên một Thiền Sư Việt Nam sống vào đời Lý (thế kỷ XI) và do Hòa Thượng Thích Thanh Từ tạo lập vào tháng giêng năm 1970, là cái nôi của Thiền Tông Việt Nam vào cuối thế kỷ XX. Tiền thân của nó là Pháp Lạc Thất, được xây cất vào tháng 4 năm 1966, toàn bằng cây lá. Hòa Thượng Thanh Từ đã ẩn tu tại đây cho đến ngày mồng 8 tháng chạp năm 1969 thì ngài ra thất và thành lập thiền viện Chân Không để tiếp độ Tăng Ni… Toàn thể khuôn viên nằm trên diện tích khoảng 2 mẫu, hướng đông giáp miếu bà Sùng Chính nhìn xuống mặt đường Lê Lợi, hướng tây giáp rừng đến đỉnh núi tức sau lưng chùa là vách núi, hướng nam giáp rừng hoang Tỳ Ni Đa Lưu Chi đối mặt chênh chếch hướng nam là ngọn núi Nhỏ hướng bắc giáp vườn cây và đường lên thiền viện. Từ cổng tam quan bước vào, du khách sẽ gặp ngay thiền vịện ni, theo tam cấp của đồi sứ quý vị sẽ đến Nhà khách. Từ Nhà khách theo đường Tiêu Dao để đến đồi Tự Tại, đứng trên đồi có thể nhìn thấy bao quát thành phố Vũng Tàu; xoay ngược tầm mắt vào núi, du khách sẽ thấy ngôi chính điện sừng sững uy nghiêm giữa rừng tràm xanh mát. Qua một khoảng sân hoa kiểng là đến một tòa nhà 2 tầng: Bên dưới là Tổ đường và Trai đường, bên trên là Tăng đường và phòng của Hòa Thượng Viện trưởng. Sau Trai đường là nhà bếp. Từ đây có đường Đại Mai dẫn lên khu thiền thất. Khu vực này được khởi công xây dựng vào năm 1973, đầu tiên là thất Hòa Thượng Viện Chủ (cũ) rồi đến thất của Hòa Thượng Bửu Huệ và 5 ngôi thiền thất của chư tăng khóa I & II. Hiện tại thiền viện Chân Không đang trong giai đoạn trùng tu, khởi công từ mùng 4 tháng 8 năm Đinh Hợi (1995) đến nay sắp hoàn thành.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nền Tảng", "definition": "Mūla (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nền Đất Cao", "definition": "Vedikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nễ", "definition": "伱. Như hai chữ Nễ 伲, 你.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nễ Khán Giả Hạt Hán", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nễ La Nan Xoa Vương", "definition": "Xem Thanh Trượng Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nễ Nễ", "definition": "苨苨. Dáng tươi tốt xum xuê của cây cối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nệ", "definition": "泥. Gò bó. Chấp nhất Các âm khác là Nê, Nễ. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nệ Cổ", "definition": "泥古. Gò bó theo xưa, không chịu đổi mới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nệm Gòn", "definition": "Tūlikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nỉ", "definition": "狔. Xem Ý nỉ 猗狔.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nỉ Nghi", "definition": "(禰宜, Negi): một trong những danh xưng của Thần Chức. Hiện tại, ở các đền thờ Thần Xã, chức này được đặt dưới Cung Ty (宮司), trên Quyền Nỉ Nghi (權禰宜), trở thành chức quan bổ tá cho Cung Ty. Nguyên ngữ của từ “Nỉ Nghi (禰宜)”, có ngữ có nghĩa là “làm cho hòa hợp”, tức là “hòa hợp tâm của Thần và cầu nguyện sự gia hộ”. Vào thời cổ đại, Nỉ Nghi chỉ cho người hành lễ cầu thỉnh lên chư Thần, hay người chuyên trách việc tế tự. Theo quy chế cổ, chức này được đặt dưới Thần Chủ (神主, Kannushi), hay từ tổng xưng của các Thần Chức. Tại Gia Mậu Thần Xã (賀茂神社, Kamo Jinja), Bình Dã Thần Xã (平野神社, Hirano Jinja), Nhật Cát Thần Xã (日吉神社, Hie Jinja), v.v., chức Nỉ Nghi được xem như là lớn nhất trong các Thần Chức. Trong khi đó, tại Lộc Đảo Thần Cung (鹿島神宮, Kashima Jingū), v.v., trên chức này có thêm Đại Nỉ Nghi (大禰宜). Từ cuối thời Minh Trị trở đi, chức Nỉ Nghi được đặt ở Y Thế Thần Cung (伊勢神宮, Ise Jingū) cũng như Quan Quốc Tệ Xã (官國弊社, Kankokuheisha). Sau Đệ Nhị Thế Chiến, toàn bộ các đền thờ Thần Xã đều có chức quan này. Đặc biệt, tại Y Thế Thần Cung, chức này đứng kế vị Thiếu Cung Ty (少宮司), trên Cung Chưởng (宮掌). Vị này nhận mệnh của Cung Ty mà phục vụ cho việc tế tự và quản lý việc của Thần Xã", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Nị Chi Mạo Tử - Cốt Xú Bố Sam", "definition": "膩 脂 帽 子 鶻 臭 布 衫. Cái khăn dính dầu mỡ, cái áo hôi hám, dụ cho tri kiến trần tục, vô minh phiền não. Tiết Thiên Đồng Đàm Hoa Thiền Sư trong NĐHN q. ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nịch", "definition": "惄. Lo buồn nghĩ ngợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nịch Chức", "definition": "溺職. Chìm đắm trong chức vụ, ý nói không làm nổi chức vụ đã được giao phó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nịch Tử", "definition": "溺死. Chết đuối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nịch Ái", "definition": "溺愛. Yêu mến đến độ mê say.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nịnh", "definition": "佞. Tâng bốc, làm vui lòng người khác để thủ lợi cho mình. Thơ Phan Văn Trị có câu: “Người trung mặt đỏ đôi tròng bạc, đứa nịnh râu hoe mấy sợi còi” Giả bộ lương thiện, tốt đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nịnh Hót", "definition": "Cātukamyatā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nịnh Thần", "definition": "佞臣. Người bề tôi luôn tâng bốc vua để thủ lợi. “Nhà giàu yêu kẻ thiệt thà, nhà quan yêu kẻ vào ra nịnh thần” (Ca dao).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nọa", "definition": "惰. Lười biếng. Bài Tụng Tây hồ phú của Nguyễn Huy Lượng có câu: “Nhận giá sắc xét dân phong cần noạ” (Cần noạ nghĩa là chăm chỉ và lười biếng). Cũng đọc Đoạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nọc", "definition": "Saṅku (nam), salla (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nọc Độc", "definition": "(Rắn). Visa (n)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nối Liền", "definition": "Samavāya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nối Lại", "definition": "Sandhi (nữ), saṃpiṇḍeti (saṃ + piṇḍ + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nối Nhau", "definition": "Abhisandahati (abhi + saṃ + dah + a), samāseti (saṃ + ās + e), saṅghāta (nam), samāsa (nam), saṅghāta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nối Tiếp", "definition": "Sandhi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nối Với", "definition": "Yuñjati (yuj + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nồi", "definition": "Mandāmukhī (nữ), cāṭi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nồng", "definition": "Tikkiṇa (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổ", "definition": "Udrīyati (u + dar + i + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi", "definition": "Vuyhati (vah + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi Bật", "definition": "Ukkaṭṭha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi Giận", "definition": "Abhisajjati (abhi + sad + ya), abhisajjana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi Lên", "definition": "Pabotheti (pa + budh + e), pariyuṭṭhāti (pari + u + ṭhā + a), palavati (plav + a), jāyati (jan + ya), ruha (tính từ), rūhati (ruh + a), rūhana (trung), sambhavati (saṃ + bhu + a), uggacchati (u + gam +a) uplavati (u + plav + a), ummujjati (u + mujj + a), opilapeti (ova + plav + e), vuṭṭhahati (u + ṭha + a), samuggama (nam), samudeti (saṃ + u + i + a), uttarati (ud + ḍī), ajjhāruhati (adhi + ā + rah + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi Phồng", "definition": "Samphulla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi Sân", "definition": "Pakuppati (pa + kup + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nổi Tiếng Nhờ Các Bài Hát", "definition": "Gāthaśravas (S), Famous through songs.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nỗ", "definition": "努. Gắng sức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nỗ Lực", "definition": "努力. Đem hết sức mà làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nỗ Mục", "definition": "努目. Trợn mắt tức giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nỗ Nha", "definition": "弩牙. Cái lẫy nỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nỗ Nhị Mi Minh Phi", "definition": "Dombi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nỗ Thủ", "definition": "弩手. Người bắn nỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nỗi", "definition": "腇. Xem Ổi nỗi 腲腇.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộ", "definition": "怒. Giận dữ. Td: Phẫn nộ Mạnh mẽ, dữ dội Người Triệu Ân đời nhà Đường nói rằng: 怒 者常情笑者不測 (Nộ giả thường tình tiếu giả bất khả trắc). Có điều gì không bằng lòng mà giận thì là thường tình, chứ cười thì khó lường được. “Giận dầu ra, dạ thế thường, cười dầu mới thực không lường hiểm sâu” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộ Khí", "definition": "怒氣. Hơi giận bốc lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộ Mục", "definition": "怒目. Trợn mắt tức giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộ Oán", "definition": "怒怨. Giận ghét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộ Sắc", "definition": "怒色. Vẻ mạt giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộ Đào", "definition": "怒濤. Sóng lớn, sóng dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội", "definition": "Abhyātma- (S), Internal.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Bí", "definition": "Ẩn kín ở bên trong. Nghĩa là Bồ Tát giấu kín hạnh tự lợi, lợi tha bên trong, mà bên ngoài thì hiện tướng tự lợi của Thanh Văn. Đó là vì Bồ Tát biết chúng sinh sợ Đại Trí mà thích nghe tiểu pháp, cho nên hiện làm Nhị Thừa Thanh Văn, Duyên Giác, dùng phương tiện giáo hóa chúng sinh, như trường hợp các vị Tỉ Khưu Phú Lâu Na, Xá Lợi Phất... đều thuộc về nội bí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Bộ", "definition": "內部. Phần bên trong Bên trong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Chúng", "definition": "Chỉ cho chúng tăng. Đối lại với ngoại tục nên gọi là nội chúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Chướng", "definition": "Chỉ cho chướng ngại trong nội tâm, tức là các phiền não như tham dục, sân khuể, ngu si...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Chế", "definition": "Niyama (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Chủng", "definition": "Đối lại: Ngoại Chủng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Chứng", "definition": "Pratyātmādhigama (S), Internal realization.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Chứng Trí", "definition": "Chỉ cho trí tuệ của Đức Phật chứng ngộ chân lí trong nội tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Chử", "definition": "Nấu nướng bên trong. Chỉ cho thức ăn mà Tỉ Khưu nấu nướng trong phòng tăng, là 1 trong những thức ăn không thanh tịnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Cung", "definition": "Kacchantara (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nội Các", "definition": "內閣. Cơ quan chủ yếu của triều đình ngày xưa, bao gồm các vị đại quan, trực tiếp cầm việc nước Cơ quan cao nhất trong nước, lo việc quốc gia, tức chính phủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Công", "definition": "Nei-kung (C), Inner exercise.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Cúng Phụng", "definition": "Cũng gọi Nội Cúng, Cúng Phụng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Dung", "definition": "內容. Chứa đựng ở trong Phần chứa đựng ở bên trong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Duyên", "definition": "Đối lại: Ngoại duyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Giám Lãnh Nhiên", "definition": "Cũng gọi: Nội Giám Lãnh Nhiên, Ngoại Thích Thời Nghi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Gián", "definition": "內間. Làm chia rẻ bên trong Kẻ len lỏi vào bên trong để gây cảnh chia rẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Giáo", "definition": "內教. Việc dạy dỗ vợ con trong nhà Việc dạy dỗ những người trong cung vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Giới", "definition": "Đối lại: Ngoại giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Hoá", "definition": "內貨. Hàng sản xuất trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Hoả Tam Muội", "definition": "Tumo (T), Inner Heat Meditation, gTum-mo (T), Caṇda (S), Caṇḍalī (S), gTum-mo (T), Caṇda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Huynh Đệ", "definition": "內兄第. Anh và em trai của vợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Huân", "definition": "Đối lại: Ngoại huân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Hàm", "definition": "內函. Danh từ Luận lí học, chỉ tính chất chứa đựng trong một danh từ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Học Niên San", "definition": "Tập san nghiên cứu Phật Giáo của viện Nội học Chi Na, bắt đầu xuất bản vào năm Dân Quốc 13 (1924), đến năm Dân Quốc 17 (1928) thì đình bản. Những năm gần đây, ở Đài Loan có bản lưu thông, đóng 4 tập thành 1 quyển, lấy tên là Nội học. Những người viết bài cho tập san này đều là các vị Giáo sư của viện Nội học, cũng là những nhà Phật học nổi tiếng như Âu Dương Tiệm, Lữ Trừng, Thang Dụng Đồng, Nhiếp ngẫu canh, Vương Ân Dương, Hùng Thập Lực v.v... cho nên những văn Phẩm của họ rất có chất lượng và được giới học thuật coi trọng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Hộ", "definition": "Đối lại: Ngoại hộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Hộ Ma", "definition": "Hộ Ma, Phạm: Homa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Khoa", "definition": "內科. Ngành chữa những bệnh của các bộ phận bên trong thân thể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Không", "definition": "Adhyātma-śūnyatā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Loạn", "definition": "內亂. Sự rối loạn trong nước, do người trong nước gây ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Lục Nhập", "definition": "Xem Lục Căn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Lực", "definition": "內刀. Con dao, cây đao dùng để chém kẻ có tội trong quân đội Người lính giữ việc chém kẻ có tội trong quân đội. Đoạn trường tân thanh có câu: “Lệnh quân truyền xuống nội đao, thề sao thì lại cứ sao gia hình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Minh", "definition": "Adhyātmatidya (S), Adhyatmavidya (S), Abhyātmavidyā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Môn Chuyển", "definition": "Đối lại: Ngoại Môn Chuyển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngoại Bất Nhị Môn", "definition": "Nội tâm và ngoại cảnh chẳng phải hai.Là 1 trong 10 Bất Nhị Môn do ngài Kinh Khê Trạm Nhiên thuộc Tông Thiên Thai thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngoại Không", "definition": "Abhyātma-bahirdha-śūnyatā (S), Internal-external emptiness.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Ngoại Kiêm Minh", "definition": "Thông hiểu cả Nội Minh và Ngoại minh. Trong Ngũ Minh, 4 minh trước (Thanh minh, Công Xảo Minh, Y Phương Minh, Nhân Minh) là Ngoại minh, minh thứ 5 là Nội Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngoại Mạn Đồ La", "definition": "Nội Tâm Mạn Đồ La và Ngoại Tướng Mạn Đồ La. Nội Tâm Mạn Đồ La cũng gọi là Tâm trung mạn đồ la, Nội đàn, Tâm đàn. Ngoại Tướng Mạn Đồ La cũng gọi là Tâm ngoại mạn đồ la, Ngoại đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngoại Tam Giáo", "definition": "Nội Tam Giáo và Ngoại Tam Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngoại Xả", "definition": "Nội xả và Ngoại xả (bỏ trong, bỏ ngoài). Nội là thân thể, Ngoại chỉ cho tài sản và danh vọng. Cả 2 thứ này đều có thể đem cho người khác, nên gọi là Nội ngoại xả. Tức Nội Ngoại Thí trong Thập thí mà Bồ Tát thực hành. (xt. Thập Thí).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngoại Đạo", "definition": "I.Nội Ngoại Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngã", "definition": "Đối lại: Ngoại ngã.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngũ Cổ Ấn", "definition": "Đối lại: Ngoại Ngũ Cổ Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Ngũ Pháp", "definition": "內五法 (Nan Đề Thích Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Nội Nhiệt", "definition": "Xem Nội Hoả Tam Muội.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Nhân", "definition": "內人. Tiếng chỉ người vợ (luôn ở trong nhà).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Nhân Ngoại Duyên", "definition": "Cũng gọi Thân Nhân Sơ Duyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Phàm", "definition": "Đối lại: Ngoại phàm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Pháp", "definition": "Cũng gọi Nội giáo, Nội đạo, Nội học, Nội Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Phược Quyền", "definition": "Cũng gọi Nhị thủ quyền, Nội chưởng quyền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Phật", "definition": "Cũng gọi Trì Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Phụ", "definition": "內附. Lệ thuộc nước mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Quan", "definition": "內官. Chức quan trong cung vua Hoạn quan Quan ở kinh đô (ở xa là Ngoại quan).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Quyến Thuộc", "definition": "Đối lại: Đại quyến thuộc, Ngoại quyến thuộc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Quán", "definition": "Xem Minh Sát Tuệ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Quán Thiền", "definition": "Xem Minh Sát Tuệ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Thai", "definition": "Chỉ cho viện Trung Đài Bát Diệp ở chính giữa Mạn Đồ La Thai Tạng Giới của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Thuộc", "definition": "內屬. Như Nội phụ 內附.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Thân", "definition": "內親. Họ hàng về đằng cha. Họ nội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Thị", "definition": "內侍. Người hầu hạ trong cung vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Trần", "definition": "Đối lại: Ngoại trần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Trận", "definition": "Cũng gọi Nội trần. Đối lại: Ngoại trận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Trị", "definition": "內治. Việc sắp đặt trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Trợ", "definition": "內助. Người giúp đỡ trong nhà, chỉ người vợ. “Bề nội trợ việc trong xem xét, siêng năng thì trăm việc đều nên” (Gia huấn ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Tâm", "definition": "內心. Trong lòng. Điều có trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Túc Thực", "definition": "Chỉ cho thức ăn để trong phòng của Tỉ Khưu qua 1 đêm, là vật bất tịnh, Tỉ Khưu không được ăn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Tướng", "definition": "內相. Vị tướng lo việc bên trong, chỉ người vợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Tại", "definition": "內在. Ở trong. Nằm ở bên trong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Tạng", "definition": "內臟. Chỉ chung các cơ quan ở bên trong thân thể con người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Tẩm", "definition": "內寢. Phòng ngủ trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Tắc", "definition": "內則. Phép cư xử trong nhà Tên một thiên trong sách Lễ kí, nói về phép tắc mà người đàn bà phải theo để cư xử phải đạo. “Khúc thư châu thổi sạch tiếng hoà, khuôn nội tắc đã gây nên nhân nhượng” (Phan Huy Ích).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Tứ Cúng Dường", "definition": "Cũng gọi: Nội Tứ Cúng, Nội Cúng Dường, Nội Cúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Viện", "definition": "Viện trong, 1 trong 2 viện ở trên cung trời Đâu Suất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Vụ", "definition": "內務. Việc bên trong, tức việc trong nước Tên một bộ trong chính phủ, lo công việc trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Xả", "definition": "Bỏ bên trong, tức xả bỏ nhục thân của mình để bố thí cho người.Là Nội Thí trong Thập thí của Bồ Tát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Y", "definition": "Antaravāsaka (S), Inner garment (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội dung của Mahāsatipaṭṭhāna Sutta được thuyết lại bằng hai phần riêng trong hai kinh Satipaṭṭhāna Sutta (Số 10) và Saccavighaṅga của Trung Bộ.", "definition": "Sự lặp lại \"quán thân trên thân\" - kāye kāyānupasīì - có mục đích xác định cho rõ ràng đối tượng quán là thân thể và chỉ thân thể mà thôi, không lẫn với những khái niệm khác như những cảm giác, ý nghĩ liên hệ đến thân ấy. Lại nữa, chỉ nên quán thân thể như là thân thể chứ không kèm theo các khái niệm như đàn ông, đàn bà, ngã, hay chúng sinh. Với thọ, tâm, pháp cũng thế. Ví dụ \"tê\" hoặc \"ngứa\" khi ngồi thiền là một cảm thọ, dễ kéo theo các cảm thọ khác như bực bội, v.v. hoặc kéo theo \"hành\" như suy nghĩ lung tung; nên cần phải dừng lại trên cảm thọ ấy mà thôi, gọi là \"quán thọ trên thọ\". Theo Ni sư Thích Nữ Trí Hải, 2002].", "source": "Tu-Dien-Danh-Tu-Rieng-Pali-Chon-Quan-Tran-Ngoc-Loi-Dich"}
{"term": "Nội dung quyển thượng là bộ phận được thu chép trong Ngũ gia ngữ lục; quyển hạ là những di lục của Thiền Sư Tào Sơn do ngài Nghi mặc sưu tập từ các sách.", "definition": "III.Tào Sơn Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội dung sách này ghi chép các chùa tháp và những điều mà ngài Đạt Ma Cấp Đa thấy nghe khi ngài đi qua các nước theo Đại Thừa và Tiểu Thừa ở vùng Tây Vực. Toàn sách gồm 10 mục: Phương Vật, Thời Tiết, Cư Xứ, Quốc Chính, Học Giáo, Lễ Nghi, Ẩm Thực, Phục Chương, Bảo Hóa Và Sơn Hà Quốc Ấp Nhân Vật... [X. Đại Đường Nội Điển Lục Q.5, Tục Cao Tăng Truyện Q.2].", "definition": "II.Tây Vực Chí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội dung sách này giải thích văn nghĩa của Kinh Pháp Hoa. Trước hết trình bày đại ý của toàn kinh, kế đến giải thích đề kinh, nêu 3 phân khoa, sau cùng, giải thích 27 Phẩm của kinh. Về cách chia khoa và giải thích ý kinh, sách này chủ yếu lấy bộ Pháp Hoa Nghĩa Kí của ngài Pháp Vân, chùa Quang Trạch đời Lương làm căn cứ.", "definition": "III.Pháp Hoa Nghĩa Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội dung sách này là giải thích về Kinh Quán Vô Lượng Thọ. (xt. Quán Vô Lượng Thọ Phật Kinh Sớ).", "definition": "II.Quán Vô Lượng Thọ Kinh Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội trận: Phần chính giữa tôn trí tượng Phật. Ngoại trận: Khu vực chung quanh nội trận hoặc bên ngoài, nơi dành cho việc lễ bái.Thông thường 2 khu vực này có lan can bao quanh nên cũng gọi là Kết Giới.", "definition": "IV. Phép kết giới của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Đan", "definition": "Nei-tan (C), Inner Alchemy.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nội Điển", "definition": "Chỉ cho tất cả giáo điển của Phật giáo; trái lại, tất cả sách vở ở thế gian, không thuộc Phật giáo, đều được gọi là “ngoại điển”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Nội Điển Lục", "definition": "Gọi đủ: Đại Đường Nội Điển Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Điển Trần Lộ Chương", "definition": "Tác phẩm, 1 quyển, do ngài Ngưng Nhiên, người Nhật Bản soạn, được thu vào Đại Nhật Bản Phật Giáo Toàn Thư quyển 3.Nội dung sách này nói đại khái về giáo nghĩa của 10 tông phái Phật Giáo Nhật Bản (6 tông Nam Đô và 4 Tông Thiên Thai, Chân Ngôn, Tịnh Độ và Thiền). Sách này và Bát Tông Cương Yếu đều là các sách nhập môn quan trọng của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Đình", "definition": "內庭. Tòa nhà lớn trong cung vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội Đạo", "definition": "Đối lại: Ngoại đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Đạo Tràng", "definition": "Cũng gọi Nội tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Đẳng Tịnh", "definition": "Gọi tắt: Nội tịnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nội Địa", "definition": "內地. Đất đai trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nội ứng", "definition": "內應. Ở trong để đáp lại hành động của kẻ ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộn", "definition": "媆. Non nớt, yếu đuối Một âm là Nhuyễn. Xem Nhuyễn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộn Hàn", "definition": "嫩寒. Hơi lành lạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộn Nha", "definition": "嫩芽. Mầm non của cây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộn Nhuỵ", "definition": "嫩蕊. Nhị non của hoa. Xem thí dụ ở Nộn. “Hoa xuân nọ còn phong nộn nhuỵ” (Cung oán).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nộn Nhược", "definition": "嫩弱. Non nớt, yếu đuối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nột", "definition": "吶. Ăn nói chậm chạp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nới Rộng", "definition": "Vikasati (vi + kas + a), vikāsa (nam), vikāseti (vi + kas + e), sithika (tính từ), paggaṇhāti (pa + yah + ṇhā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nở", "definition": "Vidālana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nợ", "definition": "Iṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nụ", "definition": "Makula (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nục", "definition": "傉. Buồn giận (có người quen đọc Nhục).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nục Huyết", "definition": "衄血. Bệnh chảy máu cam ở mũi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nụy", "definition": "矮. Lùn. Thấp Ngắn Cũng đọc Oải, Ải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nứt Nẻ", "definition": "Bhindati (bhid + ṃ + a), bhañjati (bhañj), phālana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nửa Tháng", "definition": "Aḍḍhamāsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nửa Đêm", "definition": "Atirattiṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ", "definition": "女. Chỉ chung đàn bà con gái. Td: Phụ nữ, thiếu nữ. Ca dao Việt Nam có câu: “Quạ kêu nam đáo nữ phòng” Tên một bộ chữ Trung Hoa, tức bộ Nữ Các âm khác là Nự, Nhữ. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Ca Sĩ", "definition": "Gāyikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Chủ", "definition": "女主. Vị vua đàn bà. Ta vẫn đọc trại là Nữ chúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Công", "definition": "女工. Việc làm của đàn bà con gái, chỉ việc may vá bếp nước. Bản dịch Chinh phụ ngâm khúc có câu: “Đâu xiết kể muôn sầu nghìn não, từ nữ công phụ xảo đều nguôi” Người thợ đàn bà. Cũng gọi là Nữ công nhân Nữ công: Sự làm lụng bằng chân tay khéo léo của đàn bà con gái. Nữ công là một trong bốn đức của bọn nữ lưu.”Mũi kim nhỏ nhặt mới là nữ công” (Gia huấn ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Căn Phạm", "definition": "Chỉ cho cơ quan sinh dục của phái nữ, 1 trong 22 căn, 1 trong Ngũ Tác Căn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Cư Sĩ", "definition": "Xem Ưu Bà Di.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Giáo Thọ", "definition": "Ācārinī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Giới", "definition": "女界. Chỉ chung đàn bà con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Hoạ", "definition": "女禍. Tai vạ do đàn bà gây ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Học", "definition": "女學. Việc học của đàn bà con gái Trường học dành cho con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Học Sinh", "definition": "女學生. Học trò con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Hữu Ngũ Chướng", "definition": "女有五障 (Pháp Hoa Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Nữ Lang", "definition": "女郎. Người đàn bà, người con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Linh", "definition": "女伶. Diễn viên đàn bà, tức đào hát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Lưu", "definition": "女流. Như Nữ giới 女界.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Nhi", "definition": "女兒. Người đàn bà, người con gái. “Xóm làng chẳng dám nói chi. Cảm thương hai gã nữ nhi mắc nàn”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Nhân Bái", "definition": "Cách lễ bái của người nữ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Nhân Cấm Chế", "definition": "Điều qui định ngăn cấm người nữ đi vào đạo tràng. Vì đối với sự tu hành của chúng tăng, nữ tính thường hay làm chướng ngại nên cấm người nữ vào đạo tràng. Trong các kinh rất nhiều chỗ ghi người nữ có các chướng ngại bất lợi cho việc tu hành, vì thế qui định chư tăng không được gần gũi nữ giới.Ở Trung Quốc và Nhật Bản đều có qui định cấm phụ nữ không được vào phòng của chúng tăng. [X. Kinh Tăng Nhất A Hàm Q.27; Kinh Siêu Nhật Minh Tam Muội Q.hạ; Kinh Nguyệt Đăng Tam Muội Q.7; Luận Đại Trí Độ Q.14].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Nhân Quyến Thuộc Luận Sư", "definition": "Một trong 20 loại ngoại đạo ở Ấn Độ đời xưa.Ngoại đạo này cho rằng 8 người con gái do trời Ma Hê Thủ La sinh ra là thực tại thường trụ và là những người sáng tạo ra vũ trụ vạn hữu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Nhân Vãng Sinh", "definition": "Cũng gọi Nữ nhân thành Phật.Chỉ cho người nữ Vãng Sinh Tịnh Độ hoặc chuyển thân nam mà thành Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Nhân Vãng Sinh Nguyện", "definition": "Chỉ cho nguyện thứ 35 trong 48 nguyện của Đức Phật A Di Đà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Oa", "definition": "Nu-kua (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Phạm", "definition": "Chỉ cho vị tăng phạm giới với người nữ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Quyền", "definition": "女權. Điều mà giới đàn con gái được có, được làm và được đòi hỏi, tức quyền lợi của nữ giới trong quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Sĩ", "definition": "女士. Người đàn bà có học. Bà Đoàn Thị Điểm có hiệu là Hồng Hà Nữ sĩ Ngày nay hiểu là người đàn bà con gái làm thơ, viết văn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Thiên", "definition": "Xem Thiên Nữ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Thí Chủ", "definition": "Dāyikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Thần", "definition": "Devakanyā (S), Goddess Devi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Thần Bình Minh", "definition": "Usa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Thần Hạnh Phúc", "definition": "Siri (nữ), sirī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Thủy Thần", "definition": "Xem Thủy Thiên Hậu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Trang", "definition": "Bhūsana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Trưởng Lão", "definition": "Therī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Tu", "definition": "女修. Người đàn bà đi tu Dòng tu dành cho đàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Tu Sĩ", "definition": "Samaṇī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Tính", "definition": "女性. Tính chất của đàn bà con gái, và chỉ đàn bà con gái mới có Phái nữ (giống cái).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Tăng", "definition": "女僧. Vị tăng đàn bà, tức sư nữ, bà vãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Tướng", "definition": "女將. Vị tướng đàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Tắc", "definition": "女則. Khuôn phép mà người đàn bà con gái phải theo để ăn ở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Tặc", "definition": "Giặc đàn bà. Người nữ là nguồn gốc của ái chấp, hay cướp pháp tài, chướng ngại tâm người cầu đạo, cho nên dùng giặc để ví dụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Tỏa", "definition": "Tỏa là cái khóa. Nữ tỏa chỉ cho nữ sắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Tử", "definition": "女子. Người đàn bà, người con gái nữ tử văn nhân. Cũng như nói gái sắc trai tài. “Dạy rằng: Nữ tử văn nhân, theo đòi con cũng hoạ vần thử xem”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Tử Lục Dục", "definition": "Chỉ cho 6 thứ dục vọng mà người nữ mong cầu. Đó là: Sắc dục, Hình mạo dục, Uy nghi dục, Tư thái dục, Ngôn ngữ dục và Tế hoạt dục. [X. Luận Đại Trí Độ Q.22; Ma Ha Chỉ QuánQ.6, phần 1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Tử Ngũ Chướng", "definition": "Năm điều chướng ngại của người nữ. Theo Kinh Pháp Hoa quyển 4 thì 5 chướng ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Tử Xuất Định", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữ Tỳ", "definition": "Dāsī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Tỳ Kheo", "definition": "Xem Ni Cô.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Nữ Vu", "definition": "女巫. Người đàn bà làm nghề thầy bói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Vương", "definition": "女王. Vị vua dàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữ Đạo Sĩ", "definition": "Tapassinī (nữ), tāpasī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Nữ Ưu", "definition": "女優. Đào hát. Như Nữ linh 女伶.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữu", "definition": "妞. Đứa trẻ gái sơ sinh. Cũng gọi là Nữu nữu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nữu Giới Già Tỏa", "definition": "Gông, cùm, xiềng, xích. Những đồ dùng để trói buộc phạm nhân trong tù.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữu Mạn", "definition": "Neumann, Karl Eugen, 1865-1915", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Nữu Niết", "definition": "扭 捏. E dè, đảo qua đảo lại, giày vò. Tiết Thủ Khuếch Thị Giả trong NĐHN q. 11 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Nữu Ước", "definition": "紐約. Tên phiên âm của thành phố New York ở đông bộ Hoa Kì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nự", "definition": "女. Gả chồng cho con gái Các âm khác là Nữ, Nhữ. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Nựng Nịu", "definition": "Upalāpeti (upa + lat + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "OBEs", "definition": "(Out of Body Experiences) in which individuals feel that they leave their physical bodies and observe them from somewhere in space. Such experiences happen most frequently in the face of some crisis or in the moments between clinical death and resuscitation (tỉnh lại) in hospital. One thing almost certain, the initiate into the mysteries was in no doubt that the experiences he or she gained were those of death and the afterlife. It is said that such initiates lost all fears of death from having journeyed first through the border country that divides the visible from the invisible world, and then entering into the bliss (nơi hạnh phúc) that lies beyond…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oa", "definition": "哇. Tiếng đàn hát êm tai Tiếng trẻ con khóc. Cũng nói: Oa oa Nôn mửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Chủ", "definition": "窩主. Kẻ chứa chấp kẻ gian Kẻ cất giấu đồ vật bất hợp pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Gia", "definition": "窩家. Như Oa chủ 窩主.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Giác", "definition": "蝸角. Sừng (râu) con sên Cũng chỉ sự nhỏ mọn, không đáng kể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Lô", "definition": "鍋爐. Nồi súp de (Chaudière), tức bộ phận đun nước sôi, để lấy sức mạnh hơi nước mà chạy máy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Lư", "definition": "蝸廬. Cái nhà rất nhỏ (bằng cái vỏ ốc sên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Trữ", "definition": "窩貯. Như Oa tàng 窩藏.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Tàng", "definition": "窩藏. Cất giấu đồ vật phi pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Tôn", "definition": "汙尊. Khoét đất, lấy đất làm chén uống rượu hoặc đúc tượng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Tạng", "definition": "Chỉ cho Đại Tạng Kinh của chùa Khoan Vĩnh tại Đông Kinh, in bằng hoạt tự bản (sắp từng chữ lại với nhau để in) vào thời Giang Hộ, Nhật Bản. Bản Đại Tạng Kinh này do ngài Thiên Hải (giữ chức Tăng chính) phát nguyện hoàn thành, bắt đầu vào năm Khoan Vĩnh 14 (1637) đến niên hiệu Khánh an năm đầu (1648) thì in xong, gồm 665 hòm, 6.323 quyển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oa Tử", "definition": "Cái nồi dùng để nấu thức ăn, vật dụng rất cần thiết trong sinh hoạt hàng ngày. Thiền Lâm thì dùng Oa tử để ví dụ sự vật cực kì quan trọng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oa Xá", "definition": "蝸舍. Như Oa lư 蝸廬 Oa xá: Cái nhà nhỏ, cũng như cái hang cái tổ. “Ba gian oa xá tháng ngày tiêu dao” (Trinh thử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Đào", "definition": "窩逃. Cất giấu kẻ đang lẩn trốn pháp luật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oa Đầu", "definition": "Tên 1 chức vụ trong Thiền Lâm, dưới chức Điển tọa, trông coi về các dụng cụ bếp núc như nồi niêu xoong chảo v.v...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oai", "definition": "歪. Cong vẹo, không thẳng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oai Danh", "definition": "Thế lực, tên tuổi đều nổi tiếng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Oai Linh – Oai Thần", "definition": "Theo đạo Phật, các vị Phật và Bồ Tát nhờ công phu tu hành lâu đời, cho nên có sức mạnh hàng phục và thuyết phục kỳ diệu, không lường, do đó mà có các hợp từ: oai thần, oai linh chỉ uy tín đặc biệt của các vị Phật, Bồ Tát và các bậc chân tu khác. “Oai linh vóc thánh, dáng tiên.” (Nhị Độ Mai) Nghi Tác phong ứng xử đi đứng nằm ngồi của tăng sĩ đều từ tốn, thanh cao, theo đúng uy nghi nhà Phật (x. Uy nghi).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Oai Lực Của Chú", "definition": "Aciṇtya-shakti (P), Devine force in mantra, Aciṇtya-Sakti (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oai Nghi", "definition": "Irya-patha (S), Bodily postures, Caturi-riyāpatha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oai Nghi Quốc Ngữ", "definition": "Đầu đề cuốn sách bằng văn nôm, do sư Như Thị thuộc phái thiền Trúc Lâm, soạn và giải thích các uy nghi của tu sĩ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Oai Nghiêm", "definition": "Āsabhī (nữ), bhadda (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Oai Như Vương", "definition": "Kumbhīraba (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oai Quang Thiên", "definition": "Xem Ma Dị Chi Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oai Thần", "definition": "Satagiri (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oai Âm", "definition": "Danh hiệu vị Phật xuất thế đầu tiên, trước đó chưa có vị Phật nào. “Kể từ hỗn độn bắt đầu, bây giờ có Phật Oai Âm xuất thế…” (Thiền Uyển Tập Anh –Bài tựa)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Oai Âm Na Bạn", "definition": "威 音 那 畔. 1. Trước Phật Oai Âm Vương, chỉ thời đại cách đây rất lâu xa. Như Tịnh Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Oai Âm Vương", "definition": "Awesome Sound King", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Oai Âm Vương Phật", "definition": "Bhisma-gardjita-gochasvaradja Buddha (S), Bhisma-garjitasvara-rāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oai Đức", "definition": "Tedjas (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oan", "definition": "冤. Cong vạy, không thẳng Điều mờ ám, không đúng, gây khổ cho người. Đoạn trường tân thanh có câu: “Cơ trời dâu bể đa đoan, một nhà để chị riêng oan một mình” Giận ghét. Thù giận. Dùng như chữ Oán 怨.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Cừu", "definition": "冤仇. Giận ghét thù hằn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Gia", "definition": "冤家. Người thù. Kẻ thù Gia đình có việc thù hằn lâu đời, nay gặp cảnh khổ, giống như bị trả thù. Đoạn trường tân thanh có câu: “Làm chi tội báo oan gia, thiệt mình mà hại đến ta hay gì”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Hình", "definition": "冤刑. Sự trừng phạt không đúng, quá đáng, tội nhẹ mà phạt nặng, hoặc vô tội mà bị trừng phạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Hồn", "definition": "冤魂. Hồn của người chết không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Khiên", "definition": "冤牽. Mối hận thù dằng dai, lôi kéo nhau. “Bây giờ người phải oan khiên” (Tự Tình khúc).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Khuất", "definition": "冤屈. Phải bóp lòng chịu đựng nỗi đau khổ không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Khí", "definition": "冤氣. Cái phần còn lại của người chết không đúng lí. Đoạn trường tân thanh có câu: “Lạ thay oan khí tương triền, nàng vừa phục xuống, Từ liền ngã ra”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Khúc", "definition": "冤曲. Như Oan khuất 冤屈.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Khốc", "definition": "冤酷. Như Oan khổ 冤苦. Đoạn trường tân thanh có câu: “Búa rìu bao quản thân tàn, nỡ đày đọa trẻ càng oan khốc già”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Khổ", "definition": "冤苦. Nỗi cực nhọc đau đớn không đúng lí. Phải chịu đựng nỗi cực nhọc đau đớn không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Nghiệp", "definition": "冤業. Cái hậu quả đau khổ phải chịu trong cuộc sống, do thù hận chồng chất từ trước. Đoạn trường tân thanh có câu: “Cũng là oan nghiệp chi đây, sa cơ mới đến thế này chẳng dưng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Nghiệt", "definition": "冤孽. Cay độc đau khổ, hậu quả của những việc làm chồng chất từ những kiếp trước. Cũng tương tự như Oan nghiệp 冤業. Đoạn trường tân thanh có câu: “Thương ôi tài sắc bậc này, một dao oan nghiệt dứt dây phong trần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Nạp", "definition": "婠妠. Bụ bẫm, chỉ trẻ con mập mạp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Phẫn", "definition": "冤憤. Giận dữ vì phải chịu nỗi đau khổ không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Phục", "definition": "冤伏. Phải chịu đựng nỗi đau khổ không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Trái", "definition": "冤債. Cái nợ phải trả kiếp này, cho những việc làm không đúng lí của kiếp trước (tiếng nhà Phật). Đoạn trường tân thanh có câu: “Dễ dàng là thói hồng nhan, càng cay nghiệt lắm càng oan trái nhiều” Túc trái tiền oan 夙債前冤: Nghĩa là nợ kiếp trước, oan kiếp trước, kiếp này phải trả. “Đã đành túc trái tiền oan” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Tố", "definition": "冤訴. Nói lên nỗi oan khổ không đúng lí mà mình phải chịu. Kêu oan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Tội", "definition": "冤罪. Việc làm xấu không phải do mình làm ra mà mình phải chịu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Uổng", "definition": "冤枉. Chịu đựng đau khổ không đúng lí mà không nói ra được Cong vạy, không ngay thẳng, không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oan Đăng", "definition": "Khoét thịt trên mình để làm đèn đốt cúng Phật, 1 trong những truyện tích tiền thân của Phật Thích Ca. Trong 1 kiếp ở quá khứ, Đức Thế Tôn là vua Kiền Xà Ni Lê, vì muốn nghe pháp của người Bà La Môn tên Lao độ sai, mà khoét mình làm đèn đốt để bày tỏ lòng chí thành. [X. Kinh Hiền Ngu Q.1; Ma Ha Chỉ Quán Q.7].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oan ức", "definition": "冤抑. Bị đè nén mà phải chịu đựng nỗi đau khổ không đúng lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh", "definition": "吽. Phiên âm tiến Phạn, là tiếng dùng trong lúc phấn khứa phù chú Một âm là Ngâu (Tiếng trâu bò kêu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Ca", "definition": "鶯歌. Tiếng hót của chim oanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Liệt", "definition": "轟烈. Ầm ầm Chỉ tiếng tăm vang động khắp nơi. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “Đã biết rằng anh hùng thì chẳng quản, trăm trận một trường oanh liệt, cái sinh không cái tử cũng là không”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Oanh", "definition": "轟轟. Tiếng ầm ầm của một đoàn xe chạy Tiếng ầm ầm (núi lở, bom nổ…).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Oanh Khải Khải", "definition": "輷 輷 磕 磕. 1. Âm thanh vang rền. Phần Dương Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Oanh Oanh Tùy Tục", "definition": "轟 轟 隨 俗. Đuổi theo trần tục một cách rộn ràng, sôi nổi; chỉ cho người xuất gia tâm địa không thanh tịnh. Tối Thượng Thừa Luận ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Oanh Trầm", "definition": "轟沈. Ném bom hoặc bắn phá tàu giặc cho chìm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Túy", "definition": "轟醉. Say sưa ồn ồn Say nhừ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Tạc", "definition": "轟炸. Làm cho thuốc nổ nổ ầm Chỉ việc ném bom hoặc bắn phá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Yến", "definition": "鶯燕. Chim oanh và chim yến, hai loài chim nhỏ, đẹp, hót hay. Chỉ cảnh vui tươi của mùa xuân. Cũng chỉ người kĩ nữ. Đoạn trường tân thanh có câu: “Muôn nghìn người thấy cũng yêu, xôn xao oanh yến, dập dìu trúc mai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oanh Ẩm", "definition": "轟飲. Tụ họp uống rượu ồn ào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oasis", "definition": "Nơi nghỉ ngơi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obelisk", "definition": "Tháp kỷ niệm kiến trúc như đài kỷ niệm Washington Monument", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obfuscation", "definition": "Làm đen tối, ngu muội, làm hoang mang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obliterated", "definition": "Bị nghẽn, bị tắt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oblivion", "definition": "Sự lãng quên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obnoxious", "definition": "Rất khó chịu, đáng ghét, ghê tởm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obscuration", "definition": "Làm tối, làm mờ đi, làm khó hiểu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obsequies", "definition": "Tang lễ, nghi thức đám ma", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obsessed", "definition": "Bị ám ảnh (Obsession - sự ám ảnh)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obstetric", "definition": "Thuộc sản khoa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obstinate", "definition": "Bướng bỉnh, ngoan cố", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obtrusive", "definition": "Làm phiền, làm khó chịu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obverse", "definition": "Mặt phải, mặt trước, mặt chính", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Obviate", "definition": "Tẩy trừ, xóa bỏ, ngăn ngừa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Occult world", "definition": "Spirit world (occult = hidden = thần bí, huyền bí)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Occultist", "definition": "Nhà huyền bí", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ogress", "definition": "Female God of underworld = Nữ yêu tinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Okāsaloka", "definition": "Ba thế giới không gian, ba cõi sống của chúng sanh", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Oligarchies", "definition": "Một nhóm người nắm hết quyền hành trong chính quyền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Om", "definition": "(pronounced “aum”) is probably the most ancient word for ‘God’ in existence, and is said to be the primal sound from which all creation springs (vạn vật nẩy sinh).", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Om Mani Padme Hum", "definition": "Pronounced by Tibetans as Om Mani Peme", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Omen", "definition": "Điềm, báo hiệu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Omniconscience", "definition": "Toàn ý thức; việc gì cũng biết", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Omnipotence", "definition": "Toàn năng, vạn năng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Omnipresent", "definition": "Present everywhere = có mặt ở khắp nơi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Omniscience", "definition": "Great mind, great wisdom = toàn trí", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Omniscient", "definition": "Infinite awareness – toàn trí, toàn thức", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Onerous", "definition": "Nặng nề, khó nhọc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ong", "definition": "Ali (nam), chappada (nam), madhukara (nam), madhupa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ong Vò Vẽ", "definition": "Bhamara (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Onomatopoeic", "definition": "Chữ tượng thanh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ontological", "definition": "Relate to being existence; ontology = môn học nghiên cứu bản chất cuả vạn vật.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Opaque", "definition": "Mờ đục, không trong suốt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Opiatic", "definition": "Làm tê đi, giảm đau", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oppress", "definition": "Đàn áp, áp bức", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Opprobrium", "definition": "Disgrace, bad reputation = điều sỉ nhục, sự nhục nhã", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Optimum", "definition": "Điều kiện tốt, thuận lợi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Opulent", "definition": "Giàu có, sang trọng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oracle", "definition": "Lời sấm, lời tiên tri; nhà tiên tri", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Orb", "definition": "Concentric spheres in old astronomy surrounding the earth and carrying the celestial bodies in their revolutions (thiên thể).", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ordain", "definition": "Ra lệnh, ban hành, phong chức (tôn giáo)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Orgy", "definition": "Cuộc chè chén trác táng, cuộc truy hoan", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Orifice", "definition": "Lỗ, miệng (đồ vật)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Orthodox Buddhism", "definition": "Phật giáo chính thống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oryx", "definition": "Linh dương sừng dài", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Osiris (pronounced “ozeeriz”)", "definition": "Lord of the afterlife in ancient Egypt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Osmosis", "definition": "Movement of solvent thru semipermeable = thẩm thấu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ostensibly", "definition": "Có vẻ là, bề ngoài là…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ostentatious", "definition": "Phô trương, khoe khoan", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ostracize", "definition": "Đày, phát vãng, khai trừ, tẩy chay", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Other than this, we know very little about Rahula. He does not seem to have been prominent at being either a Dharma teacher or a trainer of other monks. It is likely that Rahula kept himself in the background so that he could not be accused of taking advantage of being the son of the Enlightened One.", "definition": "La-Hầu-La", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ottappa", "definition": "Ghê sợ tội lỗi. Không muốn làm điều ác vì sợ hậu quả tai hại của nó; đây là thái độ của người trí.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Outlandish", "definition": "Xa xôi, hẻo lánh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Overwhelmed", "definition": "Bị tràn ngập, áp đảo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oviparious birth", "definition": "Noãn sinh (sinh từ trứng như chim)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ovum", "definition": "Trứng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Oxít Chì", "definition": "Cīnapiṭṭha (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Oách", "definition": "蠖. Oách khuất 蠖屈: Chỉ sự bất đắc chí, thất vọng, nản lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oách Khuất", "definition": "蠖屈. Chỉ sự bất đắc chí, thất vọng, nản lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oái", "definition": "薈. Cỏ rậm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán", "definition": "怨. Thù ghét. Td: Thù oán Giận hờn. Bản dịch Chinh phụ ngâm khúc có câu: “Bóng cờ tiếng trống xa xa, sâu lên ngọn ải oán ra cửa phòng” Một âm là Uân. Xem Uân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Báng", "definition": "怨謗. Thù ghét mà nói xấu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Cừu", "definition": "怨仇. Thù hận. Văn tế sĩ dân lục tỉnh của Nguyễn Đình Chiểu có câu: “Từ thuở Tây qua cướp đất, xưng tân trào gây nợ oán cừu” Kẻ thù.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Ghét", "definition": "Detest", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Oán Gia", "definition": "Satru (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oán Hiềm", "definition": "Resentment or hatred", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Oán Hận", "definition": "怨恨. Thù hận. “Đem lòng oán hận, sớm ghi vào lòng” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Khí", "definition": "怨氣. Vẻ thù hận, lòng thù hận toát ra ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Khích", "definition": "怨隙. Giận ghét chia rẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Linh", "definition": "Cũng gọi Tử Linh, Ác Linh", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oán Ngôn", "definition": "怨言. Lời nói giận hờn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Ngẫu", "definition": "怨偶. Cặp vợ chồng không hoà thuận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Nữ", "definition": "怨女. Người con gái giận hờn duyên phận không may.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Ta", "definition": "怨嗟. Giận hờn than thở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Thán", "definition": "怨嘆. Giận hờn than thở. Như Oán ta 怨嗟.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Thân Bình Đẳng", "definition": "Cũng gọi Oan Thân Bình Đẳng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oán Thù", "definition": "怨讐. Ghét giận lắm. Thơ Phan Bội Châu có câu: “Bủa tay ôm chặt bồ kinh tế, mở miệng cười tan cuộc oán thù”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Tình", "definition": "怨情. Nỗi niềm thù giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Tắng Hội Khổ", "definition": "Apriyasamparayoyga (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oán Tặc", "definition": "Evil hearted bandits", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Oán Vưu", "definition": "怨尤. Giận trách (Oán thiên vưu nhân: Giận trời trách người, thái độ của kẻ thất bại mà kém hiểu biết). Hát nói của Cao Bá Quát có câu: “Hẳn bền lòng chớ chút oán vưu, thời chí hỹ ngư long biến hoá”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Vọng", "definition": "怨望. Giận hờn vì không vừa ý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oán Độc", "definition": "怨毒. Thù hận tới cùng độ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oánh", "definition": "瀅. Chỗ nước chảy xoáy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oánh Sơn Thanh Qui", "definition": "Cũng gọi Oánh Sơn Hòa Thượng Thanh Qui, Động Cốc Thanh Qui. Thanh Qui, 2 quyển, do vị tăng người Nhật Bản là ngài Oánh Sơn Thiệu Cẩn biên soạn, được thu vào Đại Chính Tạng tập 82.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Oánh Sơn Thiệu Cẩn", "definition": "Keizan Jōkin (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Oát", "definition": "嗗. Tiếng uống nước òng ọc. Nuốt òng ọc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oạt", "definition": "挖. Thò tay vào. Thọc tay sâu vào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oả", "definition": "婐. Dáng mềm mại thướt tha của phụ nữ Người đày tớ gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oản", "definition": "惋. Sợ hãi mà giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Oảng", "definition": "瀇. Nước mênh mông và sâu. Ta quen đọc Quảng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "PADME", "definition": "Bên trong hoa sen", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pabbajita", "definition": "Xuất gia hay từ bỏ. Người từ bỏ đời sống thế tục để diệt trừ phiền não.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Pabbajitābhiṇhapacavekkhana", "definition": "Mười điều phản tỉnh của bậc xuất gia.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pabbajja", "definition": "Going Forth, leaving the society behind. (Gotama’s Going Forth - Ám chỉ Gotama quyết chí ra đi tìm đạo lý…)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pabbata", "definition": "Pabbata (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Paccakkha-nana", "definition": "Tri giác tuệ. Tri giác do kinh nghiệm trực tiếp. Tuệ giác trực tiếp. Đồng nghĩa với chữ Vipassana.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Paccaya", "definition": "Bốn món vật dụng, nhu cầu của đời sống vị xuất gia", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pacceka Buddha", "definition": "Độc Giác Phật. Tự mình giác ngộ, nhưng sau khi giác ngộ không thể giảng dạy cho người khác.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Padhāna", "definition": "Hai sự tinh cần.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Padhānasamayā", "definition": "Năm thời tranh thủ tu tập, thời để tinh cần.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Padmasambhava", "definition": "Born of a lotus, also known as guru Rinpoche. He", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Padme (Tibet)", "definition": "Flowering", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Padumuttara", "definition": "Padumuttara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pagan", "definition": "Kẻ ngoại giáo, không theo tôn giáo nào (Paganism - ngoại giáo)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pahāna", "definition": "Ba sự đoạn trừ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pahātabbadhammo", "definition": "Một pháp cần được đoạn trừ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pahātabbā dhammā", "definition": "Ba pháp cần đoạn trừ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pahātabbā-dhammā", "definition": "Bảy pháp cần đoạn trừ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pahātabbādhammā", "definition": "Hai pháp cần được đoạn trừ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Painstakingly", "definition": "Chịu khó, cần cù", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pajapati Gotami", "definition": "She was the Buddha’s aunt and had become his foster mother after the death of his own mother a week after he was born… (Second wife of King Sudhodana)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Palaeontologist", "definition": "Nhà cổ sinh vật học", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Palatable", "definition": "Làm dễ chịu, khoan khoái", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pali", "definition": "Ngôn ngữ dùng để ghi kinh điển Phật giáo, gần với tiếng Magadhi. Đây là ngôn ngữ mà Đức Phật và các đệ tử của Ngài dùng để giảng dạy và nói chuyện hằng ngày.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Palimpsest", "definition": "Bản viết trên da cừu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Palingenesis", "definition": "Làm sống lại, sự phát sinh, tái diễn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pall", "definition": "Vải phủ ngoài quan tài", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pallium", "definition": "Áo choàng rộng của Hi lạp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Palpable", "definition": "Being touched or felt = có thể sờ mó, cảm thấy được", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Palpatory", "definition": "Sờ nắn chẩn mạch thận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Paltry", "definition": "Không đáng kể, không giá trị", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pamojja, pamujja", "definition": "Khinh hỉ hay thiểu hỉ. Loại hỉ đầu tiên trong năm loại hỉ.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Pamāṇika hay pamāṇa", "definition": "Bốn phương diện lượng xét.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Panacea", "definition": "Thuốc chữa mọi thứ bệnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pancendriya", "definition": "Ngũ căn: Một từ về thiền để chỉ năm tâm sở: Tín, Tấn, Niệm, Định, Huệ.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Panchen Lama", "definition": "Great teacher", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Panga", "definition": "Panga (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Panna", "definition": "Trí tuệ. Trí tuệ trực giác về chân lý tối thượng.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Panoply", "definition": "Bộ áo giáp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Panoramic", "definition": "Tính cách bao quát, toàn cảnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pantheism", "definition": "Thuyết tin rằng Chúa là tất cả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pantheon", "definition": "Đền thờ tất cả các vị thần ở Hy lạp, La mã", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pantile", "definition": "Ngói ống, ngói cong", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Papacy", "definition": "Chức giáo hoàng, chế độ giáo hoàng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Papañcadhamma", "definition": "Ba pháp nghiệt chướng; pháp chướng ngại khiến không thể nhập chân lý, pháp lệch hướng chánh đạo", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Papyrus", "definition": "Giấy làm bằng cói thời Ai Cập", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parable", "definition": "Truyện ngụ ngôn, tục ngữ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Paradigm", "definition": "Typical example, pattern = mô hình, kiểu mẫu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Paradoxical", "definition": "Contrary to receive opinions = nghịch lý, ngược đời", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Paragate", "definition": "Means ‘go beyond’ refers to the attainment of the path of insight, suggesting that when one gains the path of insight which is direct insight into emptiness. At that point one has transcended the state of ordinary existence and becomes what is known as an ‘arya’ or ‘Noble Being’. The metaphor of ‘go beyond’ suggests crossing to shore on the other side, when one’s own ordinary state is understood as this side of the shore. The other side of the shore is Nirvana or the state of liberation. By attaining the path of insight one has already gone beyond the ordinary state of cyclic existence…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Paramartha", "definition": "Xem Chân Đế.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Paramatha sacca", "definition": "Chân lý tuyệt đối. Cùng nghĩa với paramattha dhamma. (phản nghĩa với sammuti sacca).", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Paramattha dhamma", "definition": "Thực tại tuyệt đối. Chân đế: Đối tượng được nhận biết một cách trực tiếp không qua khái niệm. Có ba loại chân đế: hiện tượng vật chất, hiện tượng tâm và Niết bàn.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Paramatthadhamma", "definition": "Bốn pháp siêu lý.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Parami", "definition": "Ba la mật. Hoàn hảo. Sức mạnh thanh tịnh nội tâm được phát triển và tích lũy qua nhiều đời. Có mười ba la mật: dana (bố thí), sila (trì giới), nekkhama (xuất gia hay khước từ), panna (trí tuệ), viriya (tinh tấn), khanti (nhẫn nhục), sacca (chân thật), adhitthana (quyết định), metta (tâm từ) và upekkha (tâm xả).", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Paramita", "definition": "Perfection = reaching the other shore (Ba-la-mật)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parapsychology", "definition": "A field of study concerned with the investigation of evid- ence for paranormal psychological phenomena = khoa nghiên cứu các hiện tượng thần kinh ngoài tâm lý bình thường…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parasamgate", "definition": "Go utter beyond, implies the attainment of the path of meditation. Essentially this is a state when the direct insight one has gained, has further deepened through constant familiarity and culminates (lên đến cực điểm) in the attainment of enlightenment or total transcendence.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parchment", "definition": "Giày da dê, da cừu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parenial", "definition": "Long lasting = trường cữu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parihāniyā", "definition": "Sáu pháp thối quá.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Parinibbana", "definition": "Vô Dư Niết Bàn. Một vị Phật hay A la hán khi còn sống thì gọi là Hữu Dư Niết Bàn, lúc rời bỏ thân thể này thì gọi là Vô Dư Niết Bàn.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Parinirvana", "definition": "Ultimate nirvana, final nirvana = tịch tịnh Niết bàn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parisuddhi sukha", "definition": "Tịnh lạc. Hạnh phúc an lạc không trộn lẫn với phiền não. Niết bàn.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Parisā", "definition": "Bốn hội chúng , đoàn thể tín đồ Phật giáo", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Parivāsita (S), Parivāsa (S), Parivāsita (S, P).", "definition": "Xem Kết tập", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pariyesanā", "definition": "Hai sự tầm cầu.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pariññeyyadhammo", "definition": "Một pháp cần biến tri.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pariññeyyā dammā", "definition": "Chín pháp cần biến tri.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pariññeyyā dhammā", "definition": "Ba pháp cần biến tri.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pariññeyyādhammā", "definition": "Hai pháp cần biến tri.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pariññeyā dhammā", "definition": "Tám pháp cần biến tri.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pariññā", "definition": "Ba đạt tri, sự biến tri, sự liễu tri; sự hiểu biết thấu đáo", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Parlance", "definition": "Way/manner of talking = cách nói, lối nói", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Parody", "definition": "Châm biếm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Paroxysm", "definition": "Bùng nổ bất ngờ, cơn bộc phát", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Partake", "definition": "Tham dự, cùng có phần, cùng hưởng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Passaddhi", "definition": "Thư thái. Chi thứ năm trong thất giác chi.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Passi", "definition": "Passi (P)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Patañjali", "definition": "Âm dịch là Ba Đơn Xà Khế (巴丹闍契), Ba Đơn Xà Lê (巴丹闍梨), soạn giả Du Già Kinh (s: Yogasūtra, 瑜伽經)—tác phẩm chính chứa đựng một số cách ngôn về những khía cạnh triết lý của tâm và thức. Ông còn là tác giả của một luận thư quan trọng (Mahābhāṣya) về Ashtadhyayi của Pāṇini; mặc dầu một vài học giả không cho rằng hai tác phẩm này do tác giả cùng tên viết. Ông viết Du Già Kinh từ tri thức Phệ Đà về Ấn Độ Giáo. Trong mấy thập niên gần đây, kinh này đã trở nên phổ biến trên khắp thế giới về các giới điều liên quan đến việc thực hành Raja Yoga và cơ sở triết học của các động tác Yoga dùng cho sức khỏe cũng như làm cho hài hòa thân tâm. Vì muốn dạy Yoga cho cuộc đời, tương truyền ông từ trên trời rơi (pat-) vào lòng bàn tay (-añjali) của một phụ nữ, cho nên ông có tên như vậy. Ai cũng cho rằng ông là hóa thân của Ādi S'esha—hiện thân ngã thể đầu tiên của thần Vishnu, Sankarshana. Sankarshana là hiện thân của năng lực cũng như tính phong phú ban sơ của thần Vishnu. Như vậy, Patañjali có thể được xem như là một hóa thân của Chúa để bảo vệ ngã tính của yoga. Rõ ràng ông là tư tưởng gia nguyên thủy, chứ không phải là nhà biên soạn trí tuệ yoga. Tuy nhiên, ông đã diễn dịch và làm sáng tỏ những gì người ta luận về yoga để không có sự mâu thuẩn nào. Thiên tài của ông đã đem lại nhiều hướng lý luận về triết lý yoga.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Paternalistic", "definition": "Thuộc chế độ gia trưởng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pathogen", "definition": "Mầm bệnh, nguồn bệnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pathology", "definition": "Study of essential nature of deseases = khoa nghiên cứu bệnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pati", "definition": "Hỉ. Nhờ tâm trong sáng thanh tịnh nên thân và tâm có cảm giác nhẹ nhàng thích thú.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Paticca samuppada", "definition": "Thập nhị nhân duyên.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Patimokkha", "definition": "(Sanskrit). Bond, to bind together; ( Pali: “that which is binding”) Sanskrit Pratimoksa, Buddhist monastic code; a set of 227 rules that govern the daily activities of the monk and nun.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pattanikkujjana", "definition": "Tám nguyên nhân cư sĩ bị úp bát, tám lỗi lầm của cư sĩ mà Tăng chúng có thể từ chối sự cúng dường", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paucity", "definition": "Ít ỏi, lượng nhỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pauper", "definition": "Người nghèo khổ, bần cùng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pavilion", "definition": "Sảnh đường, nhà kiểu gian lớn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pawn", "definition": "Con tốt, người bị sai khiến; cầm đồ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pañcabala", "definition": "Năm lực, năm sức mạnh hỗ trợ tinh thần tu tập", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pañcakalyāna dhamma", "definition": "Năm hảo pháp, năm đức hạnh, năm pháp hỗ trợ cho sự giữ giới tốt đẹp", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pañcakkhandha", "definition": "Năm uẩn, ngũ uẩn, những tổng hợp tính chất của danh sắc, những thành phần tạo nên chúng sanh", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pañcasīla", "definition": "Năm giới của cư sĩ, ngũ giới.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pañhābyākaraṇa", "definition": "Bốn cách trả lời câu hỏi.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paññatti", "definition": "Hai pháp chế định. Sự giả lập, sự định đặt, sự qui ước khái niệm để thông tin, để trình bày cho hiểu", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paññattivādā", "definition": "). Một trong hai phái của trường phái Gokulika; phái kia là Ekavyohārika (1). Giáo pháp chánh gồm các điểm sau: khổ không là một uẩn (skandha), không có căn toàn hảo (perfect āyatana), tất cả các hành (saṃskara) đều liên kết, khổ là xác thực (absolute), tiến trỉnh của tâm không phải là con đường, không sự chết nào là không đúng lúc, không có tác nhân (human agency), và tất cả khổ não đều do nghiệp (karma) (2) .", "source": "Tu-Dien-Danh-Tu-Rieng-Pali-Chon-Quan-Tran-Ngoc-Loi-Dich"}
{"term": "Paññā", "definition": "Ba loại tuệ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paṇḍitani-mitta", "definition": "Ba dấu hiệu người trí.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paṭiccasamuppāda", "definition": "Mười hai pháp y tương sinh, thập nhị nhân duyên.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paṭicchanna", "definition": "Ba sự kiện khuất lấp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paṭipadā", "definition": "Ba hành lộ, con đường đi, đường lối thực hành", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paṭisambhidā", "definition": "Bốn tuệ đạt thông, tuệ phân tích, tuệ vô ngại giải", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Paṭisanthāra", "definition": "Hai sự tiếp đãi.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pectoral", "definition": "Tấm che ngực để trang sức của các thầy tu Ai Cập", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pedagogical", "definition": "Giáo dục, sư phạm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pederasty", "definition": "Loạn dâm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Peek", "definition": "Lén nhìn, nhìn trộm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Peeve", "definition": "Chọc tức, làm phiền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Peg", "definition": "Chốt, cái móc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pejorative", "definition": "Miệt thị", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pelvic", "definition": "Xương chậu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Penal", "definition": "Hình phạt, hình sự", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Penance", "definition": "Sám hối, ăn năn, tự hành xác để hối lỗi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pennant", "definition": "Dây treo cờ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pent", "definition": "Đóng kín, bị nhốt, bị giam", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pentads", "definition": "Groupings of five = nhóm số 5", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Penultimate", "definition": "Áp chót, gần cuối", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perceive", "definition": "Notice = nhận biết", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perception", "definition": "Attain awareness", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Percolating", "definition": "Thấm nước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Peregrination", "definition": "Cuộc du lịch, hành trình", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perennial", "definition": "Present of all season of the year", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Peripatetic", "definition": "Lưu động, đi rong, thuộc thuyết tiêu dao", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Permutation", "definition": "Sắp xếp đội hình, đổi trật tự, đổi vị trí", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perpetrator", "definition": "Thủ phạm, kẻ gây ra", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perpetuating", "definition": "Cause to last indefinitely = kéo dài, bất diệt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perquisite", "definition": "Bổng lộc, tiền thù lao", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Persuasiveness", "definition": "Thuyết phục", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pertain", "definition": "Gắn liền, liên đới nhau", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pertinent", "definition": "Đúng chỗ, thích đáng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perusal", "definition": "Xem xét kỷ, nghiên cứu kỷ (sách)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pervade", "definition": "Through (pervasively: diffused throughout) = tràn ngập, lan toả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Perverse", "definition": "Ngang bướng, ngoan cố", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pessimism", "definition": "Chủ nghiã bi quan, yếm thế (Pessimist = kẻ yếm thế)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pestle", "definition": "Cái chày (pestle and mortar = chày và cối)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Peta", "definition": "Ngạ quỉ. Quỉ đói. Loại quỉ không có hạnh phúc.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Petrify", "definition": "Biến thành đá, làm sửng sờ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Petty", "definition": "Nhỏ mọn, tầm thường", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pewter", "definition": "Hợp kim thiếc, đồ dùng bằng thiếc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pha", "definition": "坡. Chỗ đất nghiêng dốc Sườn đồi núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pha Ly", "definition": "Ngọc pha ly. Lại kêu là Pha lê, giống như thủy tinh, có bốn màu: tía, trắng, hường, biếc. Đó là một món báu trong thất bảo: bảy món báu.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pha Lê", "definition": "Sphatika (S), Phatika (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pha Lẫn", "definition": "Sammissati (?)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Pha Đà", "definition": "陂陀. Nghiêng dốc Gồ ghề, chỗ cao chỗ thấp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pha Đà Kiếp", "definition": "Xem Hiền Kiếp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phai Màu", "definition": "Vevaṇṇiya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phai Mờ", "definition": "Milāyati (milā + ya), nirassāda (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phala", "definition": "Quả. Tâm xảy ra tiếp theo đạo tâm, tiếp tục thấy Niết bàn, và trong khi đó thì phiền não bị loại trừ.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Phalanx", "definition": "Đội hình Pha-lăng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phallus (phallic)", "definition": "Tượng dương vật ở Ấn Độ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phan", "definition": "Xem Phướng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phan Duyên", "definition": "Ālambana (S), Ālambana (P), Ārammaṇa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phan Giác", "definition": "Chỉ cho tâm tán loạn chạy theo cái biết đối với ngoại cảnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phan Luyến", "definition": "攀戀. Níu giữ bịn rịn, không nỡ rời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Lưu", "definition": "攀留. Níu giữ lại, không nỡ rời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Phan", "definition": "幡幡. Bay phần phật, phất phới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Phụ", "definition": "攀附. Vịn vào mà leo lên cao Nhờ vả, chạy theo bợ đỡ người quyền thế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Quế", "definition": "攀桂. Vin cành quế, chỉ sự thi đậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Trần", "definition": "潘陳. Tên một truyện Nôm của Việt Nam, lấy sự tích của đời Tống, mô tả cuộc tình duyên của người trai họ Phan và người con gái họ Trần. Ca dao có câu: “Đàn ông chớ đọc Phan Trần, đàn bà chớ đọc Thuý Vân Thuý Kiều”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Viên", "definition": "攀援. Vịn mà leo. Như Phan phụ 攀附.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phan Đỉnh Khuê", "definition": "(潘鼎珪, ?-?): tự là Tử Đăng (子登), người vùng An Khê (安溪), Phúc Kiến (福建); sống ở Tấn Giang (晉江); tánh thích ngâm vịnh, lại có sở trường về Cổ Thi, thường dạo chơi đất Giao Chỉ (交趾). Trước tác của ông có An Nam Ký (安南紀). Trong khoảng cuối thời vua Khang Hy (康熙, tại vị 1662-1722) và đầu thời vua Ung Chánh (雍正, tại vị 1722-1735) nhà Thanh, ông sang sống tại Đài Loan (臺灣); đến cuối đời thì trở về Tuyền Châu (泉州) và qua đời ở tuổi 80. Ông có để lại hơn 20 tập thơ văn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phang", "definition": "胮. Phang giang 胮肛: Phình lớn lên. To ra. Bành trướng thêm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh", "definition": "亨. Như chữ Phanh 烹 Các âm khác là Hanh, Hưởng. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Bào", "definition": "烹庖. Nấu nướng đồ ăn. Làm bếp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Cát", "definition": "烹割. Mổ cắt rồi nấu nướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Diệt", "definition": "烹滅. Giết đi, trừ đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Nhậm", "definition": "烹飪. Cách nấu nướng đồ ăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Oanh", "definition": "砰訇. Ầm ầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Phật Đoán Tổ", "definition": "Đồng nghĩa: Sát Phật Sát Tổ, Siêu Phật Việt Tổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phanh Phật Đoạn Tổ", "definition": "烹 佛 鍛 祖. Còn gọi: Sát Phật Sát Tổ, Siêu Phật Việt Tổ. Nấu Phật nướng Tổ. Nấu chảy tượng Phật hoặc tượng Tổ sư trong lò lửa. Thiền Tông dùng từ này để chỉ cho cơ pháp được vận dụng một cách linh hoạt của bậc thầy đã kiến tính. Đôi khi cũng có nghĩa là chẳng bị kẹt nơi hình tượng của Phật và Tổ sư mà thể đắc ý nghĩa chân thật. Bài tựa Phổ Chiếu trong Bích Nham Lục (Đại 48, 139 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phanh Tiễn", "definition": "烹煎. Nấu nước pha trà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phanh Điều", "definition": "烹調. Nấu nướng đồ ăn và nêm nếm cho vừa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phao", "definition": "拋. Ném xuống. Liệng đi Bỏ đi. Không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phao Khí", "definition": "拋棄. Bỏ đi, không dùng tới Ruồng bỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phao Khước Hoàng Kim Phủng Lục Chuyên", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phao Ngôn", "definition": "拋言. Liệng lời nói ra, tức nói điều không có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phao Vu", "definition": "拋誣. Đặt điều xấu mà gán cho người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phao Đầu", "definition": "拋頭. Ló đầu ra. Ý nói ra ngoài cho mọi người thấy mặt, không ở lỳ trong nhà nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phap Diên", "definition": "(法演, Hōen, ?-1104): vị tăng của Phái Dương Kì thuộc Lâm Tế Tông Trung Quốc, người vùng Miên Châu (綿州, thuộc Tỉnh Tứ Xuyên ngày nay), họ là Đặng (鄧). Năm 35 tuổi, ông xuất gia thọ Cụ Túc giới, sau lên Thành Đô học về Duy Thức, rồi đi về phương Nam tham yết Viên Chiếu Tông Bổn (圓照宗本), kế đến tham vấn Phù Sơn Pháp Viễn (浮山法遠), cuối cùng theo học với Bạch Vân Thủ Đoan (白雲守端) và kế thừa dòng pháp của vị nầy. Từ đó, ông đến trú tại Tứ Diện Sơn (四面山) vùng An Khánh (安慶, thuộc Tỉnh An Huy ngày nay), sau chuyển đến Thái Bình Tự (太平寺), rồi Bạch Vân Sơn Hải Hội Thiền Viện (白雲山海會禪院) ở Thư Châu (舒州). Đến cuối đời, ông chuyển đến trú tại Ngũ Tổ Sơn (五祖山) ở Kì Châu (蘄州), cử xướng tông phong của Phái Dương Kì một cách mạnh mẽ. Chính ông đã đào tạo khá nhiều bậc long tượng như Viên Ngộ Khắc Cần (圜悟克勤), Thái Bình Huệ Cần (太平慧懃), Phật Nhãn Thanh Viễn (佛眼清遠), Khai Phước Đạo Ninh (開福道寧), Đại Tùy Nguyên Tĩnh (大隨元靜), v.v. Vào tháng 6 năm thứ 3 (1104) niên hiệu Sùng Ninh (崇寧) nhà Tống, ông thị tịch, hưởng thọ 80 tuổi. Trước tác của ông có Ngũ Tổ Pháp Diễn Thiền Sư Ngữ Lục (五祖法演禪師語錄) 4 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phassa", "definition": "Xúc, một tâm sở phát sanh khi tâm tiếp xúc với đối tượng.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Pháp Diễn", "definition": "(法演, Hōen, ?-1104): vị tăng của Phái Dương Kì thuộc Lâm Tế Tông Trung Quốc, người vùng Miên Châu (綿州, thuộc Tỉnh Tứ Xuyên ngày nay), họ là Đặng (鄧). Năm 35 tuổi, ông xuất gia thọ Cụ Túc giới, sau lên Thành Đô học về Duy Thức, rồi đi về phương Nam tham yết Viên Chiếu Tông Bổn (圓照宗本), kế đến tham vấn Phù Sơn Pháp Viễn (浮山法遠), cuối cùng theo học với Bạch Vân Thủ Đoan (白雲守端) và kế thừa dòng pháp của vị nầy. Từ đó, ông đến trú tại Tứ Diện Sơn (四面山) vùng An Khánh (安慶, thuộc Tỉnh An Huy ngày nay), sau chuyển đến Thái Bình Tự (太平寺), rồi Bạch Vân Sơn Hải Hội Thiền Viện (白雲山海會禪院) ở Thư Châu (舒州). Đến cuối đời, ông chuyển đến trú tại Ngũ Tổ Sơn (五祖山) ở Kì Châu (蘄州), cử xướng tông phong của Phái Dương Kì một cách mạnh mẽ. Chính ông đã đào tạo khá nhiều bậc long tượng như Viên Ngộ Khắc Cần (圜悟克勤), Thái Bình Huệ Cần (太平慧懃), Phật Nhãn Thanh Viễn (佛眼清遠), Khai Phước Đạo Ninh (開福道寧), Đại Tùy Nguyên Tĩnh (大隨元靜), v.v. Vào tháng 6 năm thứ 3 (1104) niên hiệu Sùng Ninh (崇寧) nhà Tống, ông thị tịch, hưởng thọ 80 tuổi. Trước tác của ông có Ngũ Tổ Pháp Diễn Thiền Sư Ngữ Lục (五祖法演禪師語錄) 4 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phe", "definition": "Pakkha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phe Đối Lập", "definition": "Paṭilomapakkha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phi", "definition": "Na (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi An Lập", "definition": "Đối lại: An Lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi An Lập Đế", "definition": "Cũng gọi Phi An Lập Chân Như.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Báo", "definition": "飛報. Chạy như báo để nói cho biết việc gấp rút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Bát Thiền Sư", "definition": "飛 鉢 禪 師. Thiền tăng Tri Huyễn đời Minh, đời gọi là Phi Bát Thiền Sư. X. Tri Huyễn", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Bạch Tự", "definition": "飛 白 寺. X. Vân Cư Tự", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Bật Sô", "definition": "Chẳng phải Bật Sô. Chỉ cho Tỉ Khưu phạm 4 tội nặng: Giết hại, trộm cướp, dâm dục và nói dối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Chiến", "definition": "非戰. Không có sự đánh nhau Chống lại việc đánh nhau giữa hai hoặc nhiều nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Châu", "definition": "非洲. Tên một đại lục ở phía nam Âu Châu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Chính", "definition": "非正. Không ngay thẳng. Như: Bất chính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Công", "definition": "飛工. Người lái máy bay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Căn", "definition": "Chẳng phải căn. Năm trần: Sắc, thanh, hương, vị, xúc và một phần pháp giới thuộc về phi căn. (xt. Nhị Thập Nhị Căn, Thập Bát Giới).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Cơ", "definition": "飛機. Máy bay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Cầm", "definition": "Vihaga (nam), vihaṅgama (nam), sakuṇa (nam), sākuṇika, sākuntika (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phi Diệp Y Quan Âm", "definition": "Pālasambari (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Dương", "definition": "飛揚. Bay lên cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Dụ", "definition": "Một loại thí dụ. Như trong kinh nói Đức Phật dùng 4 núi lớn từ 4 phương ập đến muốn làm hại chúng sinh để ví dụ 4cái khổ sinh, già, bệnh, chết làm tổn hại chúng sinh. [X. Kinh Đại Bát Niết Bàn Q.29 (bản Bắc)].(xt. Thí Dụ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hoa Lạc Diệp", "definition": "Hoa bay lá rụng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hoạ", "definition": "飛禍. Tai vạ từ đâu bay tới. Tai bay vạ gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Huỳnh", "definition": "飛螢. Con đom đóm bay. Cung oán ngâm khúc có câu: “ Vắng tanh nào thấy vân mòng, hơi thê lương lạnh ngắt song phi huỳnh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Hành", "definition": "飛行. Đi bằng cách bay trên không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Hành Biến Hóa", "definition": "Bậc Thánh A la hán có đủ sáu phép thần thông, trong đó có thần túc thông, có thể phi hành trên không như chim, biến hóa thân này sang thân khác, hay là một thân biến thành nhiều thân và nhiều thân biến trở lại thành một thân.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phi Hành Dạ Xoa", "definition": "Dạ Xoa, Phạm: Yakwa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hành Gia", "definition": "飛行家. Người lái máy bay Người lo một nhiệm vụ gì trong một chuyến bay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Hành Phi Tọa Tam Muội", "definition": "Cũng gọi Giác Ý Tam Muội, Tùy Tự Ý Tam Muội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hành Tiên", "definition": "Loại tiên bay đi trong hư không, 1 trong 10 loại tiên nói trong Kinh Lăng Nghiêm. Kinh Lăng Nghiêm quyển 8 (Đại 19, 145 hạ) nói: “Kiên quyếtdùng cỏ cây mà không dừng nghỉ, khi luyện thuốc được thành tựu, gọi là Phi hành tiên”. (xt. Thập Hành Tiên).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hành Đoàn", "definition": "飛行團. Chỉ chung những người lo về việc bay của một chiếc phi cơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Hắc Phi Bạch Nghiệp", "definition": "Nghiệp chẳng đen chẳng trắng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hữu", "definition": "Non-existence.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Hữu Phi Không", "definition": "Chẳng có chẳng không. Tất cả các pháp đều có 3 tính: Biến Kế Sở Chấp, Y Tha Khởi và Viên Thành Thực. Trong đó, Biến Kế (vọng chấp) là không chứ chẳng phải có, Y tha (duyên khởi), Viên Thành (chân lí) là có chứ chẳng phải không. Cũng tức là pháp ngoài tâm (Biến Kế) chẳng phải có, pháp trong tâm (Y tha, Viên Thành) chẳng phải không. Chẳng có chẳng không tức là Trung Đạo. Đây là nghĩa Trung Đạo nói trong Luận Duy Thức. (xt. Tam Tính).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hữu Tình Số", "definition": "Phạm: A-sattvàkhyà, hoặc Asattvasaôkhyà. Cũng gọi Vô Tình Số.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hữu Tưởng Phi Vô Tưởng", "definition": "S. Asamjna nasamjna. Từ ngữ dùng trong Đại Trí Độ Luận (Long Thọ soạn), để chỉ loại chúng sinh đã dứt trừ hết phiền não do tâm tưởng thô lậu (thô tưởng) gây ra ở các cấp sống thấp, vì vậy gọi là phi hữu tưởng. Nhưng lại vì không dứt được những phiền não vi tế do tâm tưởng vi tế nhỏ nhiệm (tế tưởng) gây ra cho nên gọi là vô phi tưởng. Luận Câu Xá gọi là phi tưởng phi phi tưởng. Ngoại đạo cho rằng, cõi này chính là Niết Bàn, người tu thiền, đạt tới cấp thiền phi tưởng phi phi tưởng, xem như nhập Niết Bàn. Nhưng Phật nói là chưa phải. Chúng sinh ở cõi phi tưởng phi phi tưởng vẫn ở trong vòng luân hồi sinh tử. Sách Tâm Địa Quán Kinh cho biết, chúng sinh ở cõi này phải qua tám vạn kiếp sẽ phải đọa xuống những cõi sống thấp hơn (Phật Học Đại Từ Điển). Kinh Phạm Võng thuộc Trường Bộ Kinh I nói có thuyết cho rằng, sau khi thân sắc bị hoại, cái ngã phi hữu tưởng, phi vô tưởng vẫn tồn tại. Phật bác thuyết này như là một trong 62 tà thuyết về ngã.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phi Hữu Tưởng Phi Vô Tưởng Luận", "definition": "Cũng gọi Bát Chủng Phi Hữu Tưởng Phi Vô Tưởng Luận, Bát Phi Hữu Tưởng Phi Vô Tưởng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Hữu Tưởng Phi Vô Tưởng Thiên", "definition": "Naiva-saṃjñānā-nāsaṃjñā-āyatana (S), Realm of neither-perception nor non-perception.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Khanh", "definition": "飛卿. Danh sĩ đời Trần, chính tên là Nguyễn Ứng Long, Phi Khanh chỉ là hiệu, quê ở làng Chí Ngại, huyện Chí Linh, tỉnh Hải Dương, nhưng tới cư ngụ tại làng Nhị Khê, phủ Thường tín, tỉnh Hà đông, đậu Thái Học, sinh năm 1374, niên hiệu Long Khanh thứ nhất đời Trần Duệ Tông. Vì ông là con rể của Trần Nguyên Đán, một người trong Hoàng tộc, nên được kể như thuôc Hoàng tộc, nên không được bổ làm quan. Tới đời Hồ, ông mới giữ chức Trung thư Thị Lang, kiêm Quốc Tử Giám tu nghiệp. Sau nhà Hồ thua trận, ông bị quân Minh bắt về Trung Hoa và chết ở nước người. Thơ chữ Hán để lại có Nhị khê tập.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Khí", "definition": "Không phải căn cơ, pháp khí có khả năng gánh vác được Phật Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Khô Phi Vinh", "definition": "Chẳng héo chẳng tươi. Cứ theo Phẩm Ứng Tận Hoàn Nguyên trong Kinh Đại Bát Niết Bàn Hậu Phần quyển thượng và Đại Bát Niết Bàn Kinh Sớ quyển 1, bên bờ sông Hi Liên phía ngoài thành Câu Thi Na Kiệt La, lúc sắp nhập diệt, Đức Thế Tôn nằm trên giường, 4 chung quanh có 8 cây Sa La (Phạm: Zàla), mỗi phía có 2 cây, dưới đất rễ liền nhau, trên cây cành giao nhau, giống như cây liền cành. Một cây trong 2 cây ở 4 bên, buồn thương vì Đức Thế Tôn nhập diệt nên biến thành màu trắng thảm đạm, dần dần khô héo, nên có “Tứ khô” (4 cây khô); 4 cây còn lại thì vẫn tươi, nên có “Tứ vinh” (cây tươi), vì lí do ấy mà gọi là “Phi Khô Phi Vinh” hoặc “Tứ Khô Tứ Vinh”. (xt. Sa La Thụ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Kiếm", "definition": "飛劍. Thanh gươm bay, tức thanh gươm được phóng đi để hại kẻ địch ở xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Kiều", "definition": "飛橋. Cầu treo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Kị Tướng Quân Nhập Lỗ Đình", "definition": "Tiếng dùng trong Thiền Lâm. Tướng cỡi ngựa bị giặc bắt sống.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Lai Phong", "definition": "Cũng gọi Linh Thứu Sơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Lai Tự", "definition": "飛 來 寺. Còn gọi: Hiệp Sơn Cổ Tự. ở sau khe Phi Lai, cách huyện Thanh Viễn, tỉnh Quảng Đông, Trung Quốc 23km về phía bắc. Thời Nam Triều Lương Võ Đế (502-549) do tăng nhân Trinh Tuấn, Thụy Ai xây cất. Ban đầu tên “Chính Đức Tự”, đời Đường gọi “Thiền Cư Tự”, “Quảng Lăng Tự”. Tống Lý Tông ban tên “Quảng Khánh Thiền Tự”, “Hiệp Sơn Phi Lai Quảng Khánh Thiền Tự”. Qua nhiều đời đều có tu sửa, nền chùa nhiều lần bị di dời. Chùa hùng cứ bên bờ bắc Hiệp Sơn, tựa lưng vào núi trước mặt là sông, sơn môn đối diện Hiệp Giang. Vào cửa chùa đi qua thiên giới nhìn lên là Đại hùng bảo điện uy nghi sừng sững. Bên trái là Đế tử trì, Trai đường, Tinh xá; bên phải là Phương trượng thất, Bảo cảnh phòng, Thiền đường; hậu diện là Lục Tổ đường. Tương truyền vào thời Nam Bắc triều có Thiền Sư Lý Phi đến đây cất chùa. Khi chùa cất xong Lý Phi làm kệ rằng: “Ta tên Phi, đến Nam Lai, chùa lạc thành, hiệu Phi Lai. “ Bèn gọi là “Phi Lai Tự”. “Viên thị truyện” trong truyền kỳ đời Đường chính là lấy chùa này làm bối cảnh. Sau chùa có các thắng tích như Phi tuyền đình, Quán Âm các. Từng được “Pháp Uyển Châu Lâm” liệt vào phúc địa thứ 19.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Li", "definition": "披離. Chia lìa, rã rời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Loại", "definition": "非類. Xấu xa, không phải loài người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Luân", "definition": "非倫. Không phải cách đối xử giữa con người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Luận", "definition": "非 論. 1. Vô luận, bất luận. Tiết Đan Hà Hòa Thượng: “Li Long Châu Ngâm” trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Luật Nghi Phi Bất Luật Nghi", "definition": "Cũng gọi Xử Trung.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Luật Tân", "definition": "非律賓. Tên một nước gồm các đảo, ở phía đông Á châu ( Philippines ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Luật Tân Phật Giáo", "definition": "Phật Giáo Phi Luật Tân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Lãm", "definition": "披覽. Mở ra mà đọc, mà coi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Lí", "definition": "非理. Không hợp lẽ phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Lượng", "definition": "Cũng gọi Tự Lượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Lạc Tu", "definition": "Không tu vui, 1 trong 3 pháp tu kém cỏi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Lậu", "definition": "紕漏. Sơ xót, sai lầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Lễ", "definition": "非禮. Trái với cách cư xử tốt đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Lộ", "definition": "披露. Mở ra, bày ra cho người khác thấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Mao Đới Giác, Khiên Lê Phụ Trọng", "definition": "披 毛 戴 角 牽 犁 負 重. Mang lông đội sừng, kéo cày chở nặng, tức là làm trâu làm ngựa, chỉ cho việc bị đọa vào loài súc sinh. Tiết Ngữ Chi Dư, đời thứ 3 dưới Đại Giám trong CTTNL q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Mệnh", "definition": "非命. Không đúng số mạng. Chỉ những cái chết như tai nạn thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Nghiệp", "definition": "Cũng gọi Hoạnh Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Nghĩa", "definition": "非義. Không hợp với đạo phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Nghị", "definition": "非議. Đưa lí lẽ để phản đối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Ngã", "definition": "Anātman (S), Anattā (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Ngư", "definition": "飛魚. Tên loài cá vọt được lên khỏi mặt nước như bay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Ngữ", "definition": "非語. Lời nói không căn cứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Nhân", "definition": "Là chỉ cho các loài chúng sinh không phải loài Người, như 8 bộ chúng (Trời, Rồng, Dạ-xoa, Càn-thát-bà, A-tu-la, ca-lầu-la, Khẩn-na-la, Ma-hầu-la-già) và Ác quỉ; hoặc chỉ chung cho quỉ thần.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phi Nhĩ", "definition": "飛耳. Tai rất thính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Nhị Tụ", "definition": "Chỉ cho loại tụ phi sắc phi tâm pháp, 1 trong 3 tụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Nạn", "definition": "非難. Vặn hỏi điều khó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Phi", "definition": "菲菲. Đẹp đẽ (nói về hoa) Thơm ngát Nhiều. Phức tạp Cao thấp không đều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Phong", "definition": "飛風. Đi rất mau, như bay trong gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Phong Phi Phan.", "definition": "Cũng gọi Lục Tổ Phong Phan Tâm Động, Lục Tổ Tâm Động, Phong Phan Động.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Phàm", "definition": "非凡. Không phải tầm thường. Khác thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Pháp", "definition": "Adharma (S), Misconduct, Adhamma (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Phát", "definition": "飛髮. Đầu tóc rối bời, bay tung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Phù", "definition": "飛符. Đốt bùa thành than, cho bay đi (công việc của ông thầy cúng). Đoạn trường tân thanh có câu: “Gần miền nghe có một thầy, phi phù trĩ quỷ cao tay thông huyền” (Phi phù trĩ quỷ là đốt bùa mà gọi được ma).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Phước Nghiệp", "definition": "Apunn'abhisaṇkhāra (S), Apuṇya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Phạm Hạnh", "definition": "Chữ “phạm” nghĩa là thanh tịnh; dứt bỏ dâm dục thì gọi là “phạm hạnh”. Vậy, “phi phạm hạnh” tức là hạnh bất tịnh, chỉ cho sự dâm dục. Trái lại, “bất phi phạm hạnh” (không phi phạm hạnh) tức là “bất dâm” (không dâm dục). Người tại gia, trong thời gian thọ trì tám giới trai, dù là người phối ngẫu, cũng không được hành dâm, huống chi không phải là người phối ngẫu.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phi Phận", "definition": "非分. Không phải phần việc mình làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Sa", "definition": "飛沙. Cát bay. Td: Phi sa tẩu thạch (Cát bay đá chạy, chỉ trận gió lớn, hoặc việc rối loạn, sáo trộn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Sa Tập", "definition": "飛沙集. Tên một tập thơ của Hàn Thuyên, danh sĩ đời Trần, gồm cả thơ chữ Hán và chữ Nôm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Sanh Phi Diệt", "definition": "Đối với các đức Phật thì không thể nói sanh, hay nói diệt. Nói cách khác, sự tồn tại của các đức Phật là siêu việt mọi ngôn ngữ và tu duy của những người không phải là bậc Thánh, chưa giác ngộ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phi Sinh Phi Diệt", "definition": "Chẳng phải sinh, chẳng phải diệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Sơ Phi Trung Hậu Tiền Trung Hậu Thủ", "definition": "Khi bàn về sự đoạn hoặc không phải ở 3 thời: Sơ, trung, hậu gọi là Phi Sơ Phi Trung Hậu; còn khi nói về 3 thời: Tiền, trung, hậu thì gọi là Tiền Trung Hậu Thủ. Trong Chung Giáo thuộc 5 giáo (Tiểu, Thủy, Chung, Đốn, Viên), ngài Pháp Tạng của Tông Hoa Nghiêm đã sử dụng nhóm từ này để nói rõ cái tướng đoạn hoặc, trong đó “Phi Sơ Phi Trung Hậu” có xuất xứ từ Phẩm Thập Địa Kinh Hoa Nghiêm, còn “Tiền Trung Hậu Thủ” thì xuất xứ từ Thập Địa Kinh Luận quyển 2.Tuy nhiên, ý nghĩa của Phi Sơ Phi Trung Hậu trong Kinh Hoa Nghiêm và ý nghĩa của Tiền Trung Hậu Thủ trong Thập Địa Kinh Luận có vẻ mâu thuẫn nhau. Do đó mới có sự giải thích chung của các nhà để đả thông, như Thập Địa Kinh Luận của ngài Tuệ Viễn thuộc Tông Tam Luận cho rằng chỉ có 1 niệm đầu (sơ), hoặc 1 niệm giữa (trung) hoặc 1 niệm sau (hậu), đều không rốt ráo, mà phải thông suốt cả 3 thời mới là rốt ráo. Ngài Trừng Quán phê bình thuyết của ngài Tuệ Viễn, bảo rằng thuyết này chỉ biết có nghĩa đoạn hoặc, chứ không biết nghĩa đoạn mà chẳng phải đoạn, chẳng phải đoạn mà đoạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Sắc", "definition": "Chẳng phải sắc. Nghĩa là pháp không do 4 đại tạo thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Sắc Phi Tâm", "definition": "Không phải sắc không phải tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Sở Phan Duyên", "definition": "Nirālambana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Sở Đoạn", "definition": "Aheya (S), Aheya-heya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Tam Phi Nhất", "definition": "Chẳng phải ba chẳng phải một.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Thiên", "definition": "Apsara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Thuyết Phá", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Thuyền", "definition": "飛船. Dụng cụ chở người để bay lên không. Như chiếc thuyền bay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Thân", "definition": "飛身. Cất mình bay lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Thư", "definition": "飛書. Lá thơ rơi, không biết từ đâu gửi đến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Thường", "definition": "Xem Vô Thường.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Thạch", "definition": "飛石. Đá bay. Đá được ném đi Cái máy ném đá để hại quân địch, một vũ khí thời cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Thế", "definition": "Cạo tóc, mặc áo tu sĩ, chỉ cho tăng nicủa Phật Giáo mới xuất gia. Theo giới luật qui định, người xuất gia tu đạo phải cạo bỏ râu tóc, mặc áo tu sĩ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Thỉ", "definition": "飛矢. Mũi tên bay. Mũi tên được bắn đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Thời", "definition": "Akaliko (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Thời Dược", "definition": "Cũng gọi Canh Dược.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Thời Thực", "definition": "Phạm, Pàli: Vikàlabhojana.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Thời Tương", "definition": "Loại nước được dùng ngoài giờ qui định, 1 trong 4 thứ phi thời dược.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Thử", "definition": "飛鼠. Con chuột bay, tức con dơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Tiền Hậu Câu Đắc", "definition": "Sự chứng đắc không còn bị lệ thuộc vào thời gian, là 1 trong 4 thứ đắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Trược", "definition": "Phi Trược (?-1063)", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Trạch Diêt Vô Vi", "definition": "Phạm: Apratisaôkhỳa-nirodhà= saôskfta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Trạch Diệt", "definition": "非 擇 滅; S: apratisaṃkhyā-nirodha; Là diệt độ không cần sự cố gắng, vô tình, không phụ thuộc, không dựa trên Bát-nhã (s: prajñā), không phân biệt, phân tích (phi trạch). Ðây là một trong những Pháp (s: dharma) không phụ thuộc (Vô vi) trong học thuyết của Nhất thiết hữu bộ (s: sarvāstivāda) và Duy thức tông (s: yogācāra).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phi Trạch Diệt Vô Vi", "definition": "Apratisaṃkhyā-nirodha (S), Apratisaṃkhyā-nirodhasaṁkṛta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Trực", "definition": "非 直. Không những là. Thần Hội Di Tập q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Tuyền", "definition": "飛泉. Suối nước từ cao đổ xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Tâm", "definition": "Acittā (S), Mindless.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Tâm Phi Phật", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Tâm Trạng", "definition": "Acittata (S), Mindlessness.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Tình", "definition": "Cũng gọi Phi Hữu Tình, Vô Tình. Đối lại: Hữu Tình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Tình Thành Phật", "definition": "Nghĩa là các loài vô tình như cỏ cây, đất đá... đều có tính Phật, đều có khả năng thành Phật. (xt. Thảo Mộc Quốc Độ Tất Giai Thành Phật).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Tích", "definition": "I.Phi Tích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Tư Lương", "definition": "Chỉ cho sự suy nghĩ phân biệt không liên quan gi đến tốt xấu, phải trái, vượt ngoài cảnh giới suy tư của tình thức. Thiền Tông chủ trương suy nghĩ về cái không suy nghĩ, phương pháp ấy gọi là Phi tư lương. Đó là chỗ cùng tột của sự tọa thiền. Chương Dược Sơn Duy Nghiễm trong Cảnh Đức Truyền Đăng Lục quyển 14 (Đại 51, 311 hạ) chép: “Tăng hỏi: Sư đang đau đáu suy nghĩ về cái gì?", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Tương Phi Phi Tưởng Xứ", "definition": "Xem Phi Hữu Tưởng Phi Vô Tưởng Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Tước", "definition": "披 削. Mặc áo nhuộm, cạo tóc, ý chỉ cho việc xuất gia. Tiết Từ Thị Thụy Tiên Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Tưởng Phi Phi Tưởng Xứ Thiên", "definition": "Phi Tưởng Phi Phi Tưởng Xứ,", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Tẩu", "definition": "飛走. Bay và chạy. Chỉ sự chạy trốn. Td: Cao phi viễn tẩu (cao bay xa chạy).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Viên Lãnh", "definition": "飛 猿 嶺. Vách núi cheo leo, hiểm trở. Thiền Tông dùng từ nay để chỉ cho cửa ải Thiền. Tiết Bắc Viện Thông Thiền Sư trong NĐHN q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phi Vân", "definition": "(披雲): vén mây. Thuật ngữ thường được dùng khá phổ biến trong các Ngữ Lục Thiền để diển tả tâm cảnh tự tại vô ngại, giải thoát của Thiền giả. Như trong Thiền Tông Tạp Độc Hải (禪宗雜毒海, 卍 Tục Tạng Kinh Vol. 65, No. 1278) quyển 2, phần Tặng Biệt (贈別), có đoạn của Lý Cao (李翱, ?-?) rằng: “Tuyển đắc u cư khiếp dã tình, chung niên vô tống diệc vô nghênh, hữu thời trực thướng cô phong đảnh, nguyệt hạ phi vân tiếu nhất thanh (選得幽居愜野情、終年無送亦無迎、有時直上孤峰頂、月下披雲笑一聲, chọn chốn thâm u thỏa thích lòng, trọn năm không tiễn cũng chẳng nghinh, có lúc lên thẳng non cao đỉnh, dưới nguyệt vén mây cười vọng vang).” Hay trong Hám Sơn Lão Nhân Mộng Du Tập (憨山老人夢遊集, 卍Tục Tạng Kinh Vol. 73, No. 1456) quyển 37, có bài Ký Sào Pháp Sư (寄巢法師) rằng: “Phi vân đới nguyệt bão phong sương, thanh dạ điều điều hạc mộng trường, độc bãi Lăng Già hương triện tế, tri quân vô vật khả tư lường (披雲帶月飽風霜、清夜迢迢鶴夢長、讀罷楞伽香篆細、知君無物可思量, vén mây đeo nguyệt no gió sương, đêm vắng xa xăm hạc mộng trường, đọc hết Lăng Già còn ngút, biết người chẳng vật thể nghĩ lường).” Hoặc trong Liễu Am Thanh Dục Thiền Sư Ngữ Lục (了菴清欲禪師語錄, 卍Tục Tạng Kinh Vol. 71, No. 1414), bài Chỉ Đường Tặng Vận Thị Giả (止堂贈運侍者), lại có câu: “Hà nhân phi vân phát trường khiếu, nhất thanh bình lạc thiên lâm gian (何人披雲發長嘯、一聲逬落千林間, ai người vén mây cười sang sảng, một tiếng rơi xa ngàn dặm rừng).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phi Y", "definition": "Áo đỏ thắm (màu đào). Cứ theo Tứ Phần Luật San Phồn Bổ Khuyết Hành Sự Sao quyển hạ, phần 1, 5, đỏ thắm thắm, đỏ phớt, đỏ tươi, xanh lục và xanh biếc đều là những màu không đúng pháp, không được dùng để nhuộm áo ca sa. Nhưng theo Kinh Đà La Ni Tập quyển 6 và Đại Tỉ Khưu Tam Thiên Uy Nghi quyển hạ thì được biết ở Ấn Độ đã có trường hợp các Tỉ Khưu mặc áo ca sa màu đỏ thắm mà không bị xem là trái phép.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi nhân gồm: Thiên Long Bát Bộ, Dạ Xoa, các ác quỉ vương.", "definition": "II.Nhân Phi Nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Đao", "definition": "飛刀. Con dao bay. Con dao được phóng đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Điểu", "definition": "飛鳥. Chim đang bay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Điểu Chi Tích", "definition": "Tiếng dùng trong Thiền Lâm. Chim bay không để lại dấu vết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Đoàn", "definition": "飛團. Một toán máy bay đông đảo Một đơn vị không quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Đĩnh", "definition": "飛艇. Chiếc thuyền bay, tức thuỷ phi cơ, thứ máy bay có thể đáp trên mặt nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Đơn", "definition": "Cũng gọi Nhật Đơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Đạo", "definition": "Phi Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Đạo Hành Dâm", "definition": "Chỉ cho việc hành dâm không chính đáng, có 2 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Đản", "definition": "“Phi” là mặc áo ca sa phủ kín cả 2 vai để hiển tướng phúc điền; còn “Đản” là để trần vai bên phải để tiện lúc làm việc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phi Đắc", "definition": "Aprapti (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phi Đội", "definition": "飛隊. Một toán máy bay, gồm ít chiếc Một đơn vị Không quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phi Ưng Tác Phi Bất Ưng Tác Nghiệp", "definition": "Nayogā-vihita-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Philanthropic", "definition": "Nhân từ, bác ái (Philanthropist - người nhân đức)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phinh", "definition": "𢖊. Sai khiến. Cũng đọc Phanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên", "definition": "反. Lật lại. Xét lại Một âm là Phản. Xem Phản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Ba Thức", "definition": "Phương thức khắc tượng gỗ ở Nhật Bảnvào đầu thời đại Bình An.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Chuyển", "definition": "Xem Lưu Chuyển.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiên Cung", "definition": "翻供. Lật ngược lời khai. Như: Phản cung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Cương Sơn", "definition": "(岡山藩, Okayama-han): tên gọi một Phiên lãnh hữu toàn bộ tiểu quốc Bị Tiền (僃前, Bizen) và một phần của Bị Trung (僃中, Bicchū). Cơ sở hành chính của Phiên là Thành Cương Sơn (岡山城, Okayama-jō), phần lớn thời gian đều do dòng họ Trì Điền (池田, Ikeda) quản trị. Người từng phục vụ cho Phong Thần Ngũ Đại Lão (豐臣五大老) là dòng họ Vũ Hỷ Đa (宇喜田, Ukita). Tuy nhiên, vào năm 1600 (Khánh Trường [慶長] 5), trong trận chiến Sekigahara (關ヶ原), Vũ Hỷ Đa Tú Gia (宇喜田秀家, Ukita Hideie), chủ lực của quân phía Tây, lại bị thay đổi người; nên Tiểu Tảo Xuyên Tú Thu (早小川秀秋, Kobayakawa Hideaki) tiến vào, chiếm lãnh 51 vạn thạch ở Bị Tiền và Mỹ Tác (美作, Mimasaka). Thế nhưng, vào năm 1602 (Khánh Trường 7), Tú Thu và chẳng có con nối dõi; nên dòng họ Tiểu Tảo Xuyên (早小川, Kobayakawa) xem như bị tuyệt tự. Năm sau, 1603, người con thứ 2 của Trì Điền Huy Chính (池田輝政, Ikeda Terumasa) là Trì Điền Trung Kế (池田忠繼, Ikeda Tadatsugu) đến lãnh hữu vùng Cương Sơn (岡山, Okayama) với 28 vạn thạch, và tại đây dòng họ Trì Điền bắt đầu trị thế với tư cách là nhà Đại Danh thời kỳ Giang Hộ. Vào năm 1613 (Khánh Trường 18), Phiên nhận thêm khoảng 10 vạn thạch, trở thành 38 vạn thạch. Đến năm 1615 (Nguyên Hòa [元和] nguyên niên), Trung Kế qua đời và cũng chẳng có con nối nghiệp; nên người em Trì Điền Trung Hùng (池田忠雄, Ikeda Tadakatsu) lên thay thế với 31 vạn 5 ngàn thạch. Năm 1632 (Khoan Vĩnh [寛永] 9), Trung Hùng qua đời; thay vào đó, người anh em họ là Trì Điền Quang Chính (池田光政, Ikeda Mitsumasa) lên thay thế với 31 vạn 5 ngàn thạch. Từ đó trở về sau, gia hệ của Quang Chính thay nhau thống trị Phiên Cương Sơn. Quang Chính cùng với Đức Xuyên Quang Quốc (德川光圀, Tokugawa Mitsukuni), Phiên chủ Phiên Thủy Hộ (水戸藩, Mito-han) và Bảo Khoa Chánh Chi (保科正之), phiên chủ Phiên Hội Tân (會津藩, Aizu-han), cả ba được gọi là Tam Danh Quân (三名君) vào đầu thời Giang Hộ. Quang Chính trọng dụng Hùng Trạch Phiên Sơn (熊澤蕃山, Kumazawa Banzan), nhà Dương Minh Học, vào năm 1669 (Khoan Văn [寛文] 9), ông tiên phong mở Cương Sơn Học Hiệu (岡山學校), trường Quốc Học đầu tiên. Năm sau, 1670, ông còn khai giảng Nhàn Cốc Học Hiệu (閑居學校, hiện tại Giảng Đuờng của trường được xếp hạng quốc bảo), trường học cho hàng thứ dân cổ nhất của Nhật Bản. Sau này, vào năm 1700 (Nguyên Lộc [元祿] 3), Trì Điền Cương Chính (池田綱政, Ikeda Tsunamasa), con của Quang Chính, đã dốc sức cho hoàn thành 3 đình viên nổi tiếng nhất của Nhật Bản, gồm: Giai Lạc Viên (偕樂園, Kairakuen, Mito-shi [水戸市]), Kiêm Lục Viên (兼六園, Kenrokuen, Kanazawa-shi [金澤市]) và Hậu Lạc Viên (後樂園, Kōrakuen, Tōkyō-to [東京都]). Lịch đại chư vị Phiên chủ của Phiên này có 12 đời, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phiên Dân", "definition": "番民. Người thiểu số ở các vùng biên giới Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Dịch", "definition": "翻譯. Xoay chuyển tiếng nước này thành tiếng nước khác mà vẫn giữ nguyên ý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Dịch Danh Nghĩa Tập", "definition": "Từ điển Phật học Phạm Hán, 7 quyển, do ngài Pháp Vân biên soạn vào đời Nam Tống, suốt 20 năm mới hoàn thành, được thu vào Đại Chính Tạng tập 54.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Dịch Danh Nghĩa Đại Tập", "definition": "Phạm: Mahàvyutpatti.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Dịch Gia", "definition": "Cũng gọi: Dịch Sư, Dịch Kinh Gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Dịch Tứ Lê", "definition": "Bốn nguyên tắc phiên dịch kinh điển Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Dịch Tứ Lệ", "definition": "翻譯四例 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phiên Hầu", "definition": "藩候. Tiếng chỉ các thân vương, chư hầu giữ đất ở xa, coi như phên chen giậu chống cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Hội Tân", "definition": "(會津藩, Aizu-han): tên của một Phiên thống trị phần Tây bộ Fukushima-ken (福島縣) hiện tại, thuộc Quận Hội Tân (會津郡, Aizu-gun), tiểu quốc Lục Áo (陸奥, Mutsu) ngày xưa. Cơ sở hành chính của Phiên là Thành Nhược Tùng (若松城, Wakamatsu-jō, thuộc Wakamatsu-shi [若松市], Aizu [會津]). Dưới thời đại Chiến Quốc, địa phương Hội Tân vốn do Chiến Quốc Đại Danh lấy vùng Hắc Xuyên (黑川, Kurokawa), sau này là Nhược Tùng (若松, Wakamatsu), Hội Tân, làm bản cứ; là tiểu quốc lãnh hữu của dòng họ Lô Danh (蘆名, Ashina). Vào năm 1589 (Thiên Chánh [天正] 17), Y Đạt Chính Tông (伊達政宗, Date Masamune) tiêu diệt dòng họ này, chiếm cứ Hắc Xuyên. Năm sau, 1590, nhân vị xử lý ở Áo Châu (奥州, Ōshū) của Tướng Quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi), địa phương Hội Tân cũng như các vùng lân cận đều bị Chính Tông thâu tóm, và ban cho Bồ Sanh Thị Hương (蒲生氏郷, Gamō Ujisato) với 42 vạn thạch, sau là 92 vạn. Thị Hương đổi tên Hắc Xuyên thành Nhược Tùng và đã đóng góp công lao lớn trong việc làm cho kinh tế lãnh quốc phát triển. Sau khi Thị Hương qua đời, vào năm 1598 (Khánh Trường [慶長] 3), con trai ông là Bồ Sanh Tú Hành (蒲生秀行, Gamō Hideyuki) bị chuyển về Vũ Đô Cung (宇都宮); thay vào đó là Thượng Sam Cảnh Thắng (上杉景勝, Uesugi Kagekatsu) từ Việt Hậu (越後, Echigo) đến với 120 vạn thạch. Trong trận chiến Sekigahara (關ヶ原), vì Cảnh Thắng đứng về phía của Thạch Điền (石田, Ishida), nên vào năm 1601 (Khánh Trường 6), thì bị chuyển về vùng Mễ Trạch (米澤), còn lại 30 vạn thạch. Người lên thay thế Cảnh Thắng là Bồ Sanh Trung Hương (蒲生忠郷, Gamō Tadasato); nhưng vào năm 1627 (Khoan Vĩnh [寛永] 4), ông mất sớm khi còn trẻ, nhưng lại không có con nối dõi. Cùng năm này, Gia Đằng Gia Minh (加藤嘉明, Katō Yoshiaki) đến kế thế với 40 vạn thạch. Người kế vị đời thứ 2 của dòng họ Gia Đằng là Minh Thành (明成, Akinari). Sau đó, nhân việc Minh Thành bị tước mất chức quyền vào năm 1643 (Khoan Vĩnh 20), Bảo Khoa Chánh Chi (保科正之, Hoshina Masayuki), con của Tướng Quân Đức Xuyên Tú Trung (德川秀忠, Tokugawa Hidetada), đến nắm quyền với 23 vạn thạch. Đến đời thứ 3 chấp quyền của dòng họ Bảo Khoa (保科, Hoshina) là Chánh Dung (正容, Masakata, con của Chánh Chi) thì đổi thành họ Tùng Bình (松平, Matsudaira), và được công nhận tên tuổi với tư cách là danh môn thân tộc của dòng họ Tướng Quân Đức Xuyên. Từ đó về sau, dòng họ Tùng Bình bắt đầu quản lãnh vùng Hội Tân. Vị Phiên chủ cuối cùng là Dung Bảo (容保, Katamori). Cuối cùng, vào năm 1876 (Minh Trị [明治] 9), Phiên này được sát nhập vào Fukushima-ken cho đến ngày nay. Lịch đại chư vị Phiên chủ của Phiên Hội Tân có 16 người, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phiên Kinh Đài", "definition": "Đài dịch kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Kiểm", "definition": "翻臉. Thay đổi vẻ mặt Biến sắc. Giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Li", "definition": "藩籬. Hàng rào quanh nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Lộc Nhi Đảo", "definition": "(鹿兒島藩, Kagoshima-han): tên gọi chính thức của Phiên Tát Ma (薩摩藩, Satsuma-han); là một Phiên lãnh hữu 2 tiểu quốc Tát Ma (薩摩, Satsuma), Đại Ngung (大隅, Ōsumi), cọng thêm đại bộ phận các quận huyện của tiểu quốc Nhật Hướng (日向, Hyūga), các đảo ở Tây Nam. Hiện tại Phiên này thuộc toàn bộ Kagoshima-ken (鹿兒島縣) và tây nam bộ Miyazaki-ken (宮崎縣), cọng thêm đại bộ phận Okinawa-ken (沖繩縣). Trung tâm hành chính của Phiên là Thành Lộc Nhi Đảo (鹿兒島城, tại Kagoshima-shi [鹿兒島市]). Thành chủ là dòng họ Đảo Tân (島津, Shimazu), hình thành nên một Phiên to lớn với số lượng cao nhất 90 vạn thạch. Từ khi dòng họ này được bổ nhiệm làm chức Thủ Hộ 3 tiểu quốc Tát Ma, Đại Ngung và Nhật Hướng, các nhà Thủ Hộ Đại Danh, Chiến Quốc Đại Danh đã lấy địa phương này làm căn cứ địa vững chắc cho họ. Vào năm 1587 (Thiên Chánh [天正] 15), nhân cuộc chinh phục Cửu Châu (九州, Kyūshū) của Tướng Quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi), một bộ phận của 3 tiểu quốc trên mới được chính thức công nhận là sở lãnh của dòng họ Đảo Tân. Năm 1600 (Khánh Trường [慶長] 5), sau trận chiến Sekigahara (關ヶ原), con của Đảo Tân Nghĩa Hoằng (島津義弘, Shimazu Yoshihiro) là Đảo Tân Gia Cửu (島津家久, Shimazu Iehisa) được công nhận là chủ lãnh của Phiên Tát Ma. Vào năm 1609 (Khánh Trường 14), Gia Cửu xuất binh đánh Lưu Cầu (琉球, Ryūkyū) và làm cho vương quốc này phải thần phục; vì vậy, bên cạnh việc hằng năm Lưu Cầu dâng cống nạp, còn là cơ hội lớn để giao lưu mậu dịch với Trung Quốc; từ số lượng 56 lên đến 72 vạn thạch. Mãi cho đến đời Phiên chủ thứ 8 là Đảo Tân Trùng Hào (島津重豪, Shimazu Shigehide) bắt đầu cải cách chính trị của Phiên, cho thiết lập các trường Phiên Hiệu Tạo Sĩ Quán (藩校造士館), Diễn Võ Quán (演武館), Y Học Viện (醫學院), v.v. Ông cho con gái thứ 3 là Mậu Cơ (茂姫) đến làm dâu nhà Tướng Quân Đức Xuyên Gia Tề (德川家齊, Tokugawa Ienari); vì vậy đã tạo ảnh hưởng to lớn cho nền chính trị của Phiên Tát Ma; nhưng ngược lại thì cũng làm gia tăng sự khốn cùng cho Phiên. Năm 1851 (Gia Vĩnh [嘉永] 4), dưới thời của vị Phiên chủ đời thứ 11 là Đảo Tân Tề Bân (島津齊彬, Shimazu Nariakira), ông tiến hành thiết lập các thiết bị quận sự của phương Tây cũng như công trường kinh doanh; hơn nữa, ông còn người con gái nuôi là Đốc Cơ (篤姫) làm vợ kế nhà Tướng Quân đời thứ 13 là Đức Xuyên Gia Định (德川家定, Tokugawa Iesada). Vào năm 1871 (Minh Trị [明治] 4), trừ các đảo Lưu Cầu, lãnh địa của Phiên Tát Ma bị phế bỏ và sát nhập vào Kagoshima-ken. Lịch đại chư vị Phiên chủ của Phiên Tát Ma có 12 người, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phiên Mục", "definition": "藩牧. Chức quan coi giữ các vùng đất xa, như phên che giậu chống cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Phong", "definition": "藩封. Đất vua ban cho thân vương, chư hầu để coi như phên che giậu chống cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Phúc", "definition": "翻覆. Tráo trở, lật lọng. Như: Phản phúc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Phương", "definition": "藩方. Chỉ các vùng đất xa, do các thân vương, chư hầu trấn giữ, làm phên che giậu chống cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Phạm Ngữ", "definition": "Từ điển tiếng Phạm, 10 quyển (không rõ soạn giả), được thu vào Đại Chính Tạng tập 54.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiên Phụ", "definition": "藩附. Vùng đất xa, quy thuộc triều đình, làm phên che giậu chống cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Quốc", "definition": "藩國. Nước chư hầu. Như: Thuộc quốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Sứ", "definition": "藩使. Như Phiên đài 藩臺.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Tam Nhiễm Thành Tam Đức", "definition": "翻三染成三德 (Hoa Nghiêm Kinh Tuỳ Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phiên Thuộc", "definition": "藩屬. Như Phiên phụ 藩附.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Thần", "definition": "藩臣. Như chữ Phiên mục 藩牧. “Mới sai Lục Dận sang thay phiên thần”. (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Thủy Hộ", "definition": "(水戸藩, Mito-han): tên một Phiên thống trị vùng Trung Bộ, Bắc Bộ Ibaraki-ken (茨城縣) hiện tại, thuộc tiểu quốc Thường Lục (常陸, Hitachi) ngày xưa. Cơ sở hành chính của Phiên là Thành Thủy Hộ (水戸城, Mito-jō, thuộc Mito-shi [水戸市]). Phiên chủ là mấy đời của dòng họ Đức Xuyên (德川, Tokugawa); chiếm khoảng 35 vạn thạch (đơn vị biểu hiện vị trí cao thấp và thế lực của hàng Đại Danh, Võ Sĩ, v.v.). Dòng họ Tá Trúc (佐竹, Satake) thuộc Chiến Quốc Đại Danh được Tướng Quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi) công nhận là người quản lãnh tiểu quốc Thường Lục; nhưng trong cuộc chiến Sekigahara (關ヶ原), vì Tá Trúc Nghĩa Tuyên (佐竹義宣), người có 54 vạn thạch, không trợ lực cho dòng họ Đức Xuyên; nên vào năm 1602 (Khánh Trường [慶長] 7), thì bị giảm xuống, chuyển về phiên Cửu Bảo Điền (久保田藩, Kubota-han) với 21 vạn thạch ở Thu Điền (秋田, Akita), Xuất Vũ (出羽, Dewa). Sau thời dòng họ Tá Trúc, ở Thủy Hộ có Võ Điền Tín Cát (武田信吉, Takeda Nobuyoshi, 15 vạn thạch), con trai thứ 5 của Đức Xuyên Gia Khang (德川家康, Tokugawa Ieyasu), lên thay thế. Năm sau, 1603, Tín Cát qua đời đột ngột và Đức Xuyên Lại Tuyên (德川賴宣, Tokugawa Yorinobu, 25 vạn thạch) kế vị. Tiếp theo Lại Tuyên là Đức Xuyên Lại Phòng (德川賴房, Tokugawa Yorifusa), được tăng lên đến 28 vạn thạch. Đến thời đại Nguyên Lộc (元祿), Phiên Thủy Hộ có 35 vạn thạch. Sau này, theo sự tình diễn tiến, Lại Phòng nhường chức lại cho người con thứ ba là Đức Xuyên Quang Quốc (德川光圀, Tokugawa Mitsukuni), rồi giao cho người trưởng nam là Tùng Bình Lại Trùng (松平賴重) làm Phiên chủ của Phiên Cao Tùng (高松藩, Takamatsu-han) có 12 vạn thạch. Bản thân Quang Quốc rất chuộng học vấn, từng biên tập bộ Đại Nhật Bản Sử (大日本史), gieo khí phong Tôn Vương (尊王) đến cho Phiên Thủy Hộ. Vốn ra đời ở Phiên này, Thủy Hộ Học đã đem lại ảnh hưởng mạnh cho cuộc Vận Động Tôn Hoàng Nhương Di (尊皇攘夷運動). Vị Phiên chủ đời thứ 9 là Đức Xuyên Tề Chiêu (德川齊昭, Tokugawa Nariaki), cũng có chí tham gia vào việc cải cách chính trị của Phiên, nhưng vì khuynh hướng Tôn Vương Nhương Di quá mạnh, nên ông phải từ chức và lui về ẩn cư. Đến cuối thời Mạc Phủ, trong Phiên nảy sinh những cuộc kháng tranh giữa Phái Bảo Thủ và Phái Cách Tân, nên mất đi sự thống chế, từ đó kéo theo bao vụ biến loạn như vụ Loạn Đảng Thiên Cẩu (天狗黨の亂), Chiến Tranh Hoằng Đạo Quán (弘道館戰爭), v.v. Lịch đại chư vị Phiên chủ có 13 đời, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phiên Thứ", "definition": "番次. Một phen, một lần. Lần lượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Trấn", "definition": "藩鎮. Như Phiên quốc 藩國 Cũng có nghĩa như Phiên mục 藩牧.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Ty", "definition": "藩司. Cơ quan hành chánh đặt tại các tỉnh xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Tân Hòa Dã", "definition": "(津和野藩, Tsuwano-han): tên của một Phiên cai trị vùng Tân Hòa Dã (津和野, Tsuwano) thuộc tiểu quốc Thạch Kiến (石見, Iwami) dưới thời Giang Hộ. Cơ quan hành chính của Phiên là Thành Tân Hòa Dã (津和野城, Tsuwano-jō). Dưới thời đại Chiến Quốc, dòng họ Cát Kiến (吉見, Yoshimi), nhà hào tộc từng phục vụ cho hai dòng họ Đại Nội (大內, Ōuchi) và Mao Lợi (毛利, Mōri), quản lãnh địa phương này. Cho nên, trước khi xảy ra cuộc chiến ở Sekigahara (關ヶ原), vùng đất này là sở hữu của dòng họ Mao Lợi. Vào ngày 15 tháng 10 năm 1600 (Khánh Trường [慶長] 5), trong trận chiến Sekigahara, Phản Khi Trực Thạnh (坂崎直盛, Sakazaki Naomori), người anh em họ của Hỷ Vũ Đa Tú Gia (喜宇多秀家), lập chiến công lớn và hình thành một Phiên mới với 3 vạn thạch. Sau đó, trong trận chiến ở Đại Phản (大阪, Ōsaka), ông xông trận cứu thoát công chúa Thiên Cơ (千姫), nên được ban cho 1 vạn 3468 thạch vào ngày 20 tháng 7 năm 1617 (Nguyên Hòa [元和] 3). Tuy nhiên, ngày 11 tháng 9 cùng năm, do những dư âm về sự kiện công chúa Thiên Cơ, Trực Thạnh bị gia thần sát hại và dòng họ Phản Khi coi như đoạn diệt. Thay vào đó, ngày 20 tháng 7 năm 1618 (Nguyên Hòa 3), Quy Tỉnh Chính Củ (龜井政矩, Kamei Masanori) của Phiên Nhân Phan Lộc Dã (因幡鹿野藩) đến nhậm chức với 4 vạn 3000 thạch. Kể từ đó cho đến thời Minh Trị, dòng họ Quy Tỉnh (龜井, Kamei) thống lãnh toàn Phiên. Chính Củ được chính quyền Mạc Phủ tín nhiệm sâu sắc, nhưng lại chế đột ngột vào năm 1619 (Nguyên Hòa 5). Quy Tỉnh Tư Chính (龜井茲政, Kamei Koremasa), người kế thế đời thứ hai của dòng họ này, lại quá nhỏ, nên tạo ra những xáo động trong Phiên; nhưng may nhờ trung thần Đa Hồ Chơn Thanh (多胡眞清) chủ đạo, khống chế phân tranh nội bộ và dốc lực xác lập nền chính trị của Phiên được ổn định. Đến thời của Quy Tỉnh Củ Hiền (龜井矩賢, Kamei Norikata), Phiên chủ đời thứ 8, sáng lập ra trường học Dưỡng Lão Quán (養老館) và mãi cho đến nay trường này vẫn còn. Vị Phiên chủ đời cuối cùng là Quy Tỉnh Tư Giám (龜井茲監, Kamei Koremi) thực hành cải cách và trọng dụng nhân tài có năng lực. Hơn nữa, ông còn tin thờ Thần Đạo và dốc toàn lực phát triển quốc học. Vào năm 1867 (Khánh Ứng [慶應] 3), ngay trước khi chuyển qua thời Minh Trị, nhân cuộc đàn áp tín đồ Thiên Chúa Giáo của chính phủ mới, các tín đồ bị lưu đày ở các địa phương. Ngay như 158 người tín đồ của tôn giáo này cũng bị lưu đày và khảo vấn khốc liệt ở Phiên Tân Hòa Dã; cho nên Phiên này chuyển vào thời kỳ u ám nhất. Đến tháng 7 năm 1871 (Minh Trị [明治] 4), Phiên bị phế bỏ và chuyển nhập vào Shimane-ken (島根縣). Lịch đại chư vị Phiên chủ của Phiên Tát Ma có 12 người, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phiên Án", "definition": "翻案. Xét lại kết quả của một vụ đã được xét xử tại tòa án.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Âm", "definition": "翻音. Dùng thứ chữ nước này để ghi cách đọc của chữ nước khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiên Đài", "definition": "藩臺. Tiếng tôn xưng quan Bố chánh thời xưa, vì quan Bố chánh trông giữ tỉnh xa, được coi như phên che giậu chống cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu", "definition": "剽. Tên một thứ nhạc khí thời cổ, giống như cái chuông, dùng để gõ nhịp Các âm khác là Phiếu, Phiểu. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Bạc", "definition": "漂泊. Trôi nổi đây đó, không nhất định chỗ nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Cục", "definition": "鏢局. Cơ quan. Tổ chức nhận hộ tống hàng hoá từ nơi này tới nơi khác để lấy tiền công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Dao", "definition": "漂搖. Lay động nhẹ nhàng. Cũng đọc Phiêu diêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Diêu", "definition": "嫖姚. Nhẹ nhàng lâng lâng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Diểu", "definition": "縹緲. Mơ hồ không rõ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Du", "definition": "漂遊. Rong chơi đó đây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Dương", "definition": "漂揚. Bay bổng lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Dật", "definition": "漂逸. Nhẹ nhàng, nhàn hạ, thoát ra khỏi sự ràng buộc của cuộc đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Hãn", "definition": "慓𢖳. Mau lẹ dũng mãnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Hốt", "definition": "票忽. Nhẹ nhàng mau lẹ, không đoán biết được Cũng chỉ sự coi thường, sơ ý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Khách", "definition": "鏢客. Người có vỏ nghệ, hộ tống hàng hoá để lấy tiền công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Kị", "definition": "驃騎. Danh hiệu đời xưa đặt cho bậc đại tướng. Td: Phiêu kị Tướng quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Linh", "definition": "漂零. Trôi nổi rơi rụng. Như Phiêu lạc 漂落.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Lãng", "definition": "漂浪. Trôi nổi mặc cho sóng nước đưa đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Lưu", "definition": "漂流. Trôi nổi đó đây. Chỉ cuộc sống vất vả. Truyện Trê Cóc có câu: “Ngửa trông lạy đứa quan cao, cứu đàn con nhỏ phiêu lưu kẻo mà”. Ngày nay ta còn hiểu là dấn thân vào cuộc sống đầy nguy hiểm không đoán biết được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Lạc", "definition": "漂落. Trôi nổi rơi rụng, chỉ cuộc sống vất vả không yên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Ngụ", "definition": "漂寓. Từ xa trôi giạt tới mà ở tạm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Phiêu", "definition": "飄飄. Lay động mạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Phiếm", "definition": "漂泛. Trôi nổi lênh đênh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Phong", "definition": "飄風. Gió lốc. Gió trốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Phù", "definition": "漂浮. Như Phiêu phiếm 漂泛.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Sư", "definition": "鏢師. Như Phiêu khách 鏢客.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Tán", "definition": "漂散. Trôi dạt tan tác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Tật", "definition": "漂疾. Nước chảy xiết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Đãng", "definition": "漂蕩. Trôi giạt đó đây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu Động", "definition": "票動. Như Phiêu diêu 票姚.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiêu, Phiếu, Tiêu", "definition": "臕. Như chữ 膘.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm", "definition": "氾. Nước tràn mênh mông Rộng lớn Lay động Nước nhơ bẩn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Bái", "definition": "氾拜. Vái chào chung mọi người, chớ không vái chào riêng từng người. Chào rộng cả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Bạc", "definition": "泛泊. Rộng lớn, mênh mông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Chu Thiền Sư Tháp", "definition": "泛 舟 禪 師 塔. Nằm trên di chỉ chùa Báo Quốc, cách thành phố Vận Thành, tỉnh Sơn Tây, Trung Quốc 5km về phía tây bắc. Chùa đã bị phế hủy từ lâu, chỉ còn cổ tháp. Tháp này do Tiết độ sứ Khúc Hoàn xây cất vào niên hiệu Trường Khánh thứ 2 (822) đời Đường, sau khi Thiền Sư Phiếm Chu viên tịch. Tháp hình hộp tròn theo kiểu đình các, thu nhỏ dần theo chiều cao, phần thắt lưng của tòa Tu Di chính là thân tháp, đây là chỗ đặc biệt của hình trạng tháp này. Trên tòa Tu Di có đài môn khắc gạch và cách nhau bởi hàng cột. Thân tháp rỗng, mặt nam mở cửa, ngưỡng cửa, má cửa, ngạch cửa đều làm bằng đá. Trong tháp là hình lục giác, trên có khung trang trí trần nhà. Thân tháp có khảm tháp minh, ghi chép sự tích của Thiền Sư Phiếm Chu cùng quá trình dựng tháp. Mái tháp từng tầng chồng khít làm thành, đỉnh tháp hình lọng, đỉnh có tháp sát. Phần dưới tháp sát là hai tầng hoa lá núi rừng to lớn, trên đỡ chiếc bát úp hình bán nguyệt, trên cùng là bảo châu. Tạo dáng cổ phác điển nhã, điêu khắc thô tế xen nhau, trong sáng mà có lực, nó vượt hơn cả trong các tháp cổ hình tròn đời Đường, loại tháp này hiện rất ít thấy. Hồi tưởng, nhớ lại. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phiếm Du", "definition": "泛遊. Đi chơi nơi này nơi kia, không nhất định phải đến nơi nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Luận", "definition": "氾論. Bàn bạc dông dài, rộng về nhiều việc. Bàn bạc mà chơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Lãm", "definition": "泛覽. Xem qua, xem rộng một lượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Lạm", "definition": "氾濫. Nước dâng tràn mênh mông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Phiếm", "definition": "氾氾. Trôi nổi vô định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Quan", "definition": "泛觀. Xem qua, xem chung một lượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Thần Giáo", "definition": "Pantheism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiếm Xưng", "definition": "泛稱. Gọi chung, chỉ chung cả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Ái", "definition": "泛愛. Lòng yêu thương rộng lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếm Đĩnh", "definition": "泛艇. Chiếc thuyền nhỏ lênh đênh Thả thuyền lênh đênh Cũng nói: Phiếm chu 泛舟.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến", "definition": "傓. Bừng lên. Cháy bùng Làm bùng lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Chỉ", "definition": "片紙. Tờ giấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Cúng", "definition": "Cúng một nửa. Theo nghi thức Quán Đính của Mật Giáo, những vật cúng được cúng ở đàn nhỏ chia làm 2 phần, 3 vật cúng trước, 3 vật cúng sau. Khi cúng, nếu chỉ dùng phần cúng trước để cúng dường thì gọi là Phiến cúng. Nghi thức này có xuất xứ từ Kinh Kim Cương Đính Du Già Trung Lược Xuất Niệm Tụng quyển 4, Phẩm Cụ Duyên Kinh Đại Nhật quyển 1 và Kinh Bất Không Quyên Sách quyển 15.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiến Diện", "definition": "片面. Chỉ có bề mặt. Nông cạn, hời hợt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Diện Tả Kinh", "definition": "Cũng gọi Phiến diện cổ tả kinh. Phương thức viết kinh trên mặt chiếc quạt lưu hành vào cuối thời kì Đằng Nguyên ở Nhật Bản. Mặt quạt được tô nhiều màu, hoặc quét 1 lớp kim nhũ rồi mới viết văn kinh lên trên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiến Dương", "definition": "扇揚. Làm cho lan rộng ra. Làm lớn chuyện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Dụ", "definition": "扇誘. Xúi giục bạo động.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Hoặc", "definition": "扇惑. Lừa gạt mà xúi giục người khác mà làm loạn, gây bạo động.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Hình", "definition": "扇形. Hình cánh quạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Loạn", "definition": "扇亂. Như chữ Phiến động 扇動.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Mã", "definition": "扇馬. Con ngựa đã bị thiến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Mạt", "definition": "片末. Nhỏ bé. Nhỏ nhoi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Phương", "definition": "片方. Chỉ có một mặt, một phía. Chỉ sự thiên lệch, thiếu sót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Thiện", "definition": "片善. Hơi tốt một chút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Thời", "definition": "片時. Một chốc lát. Khoảnh khắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Trường", "definition": "片長. Cái tài nhỏ bé. Cái sở trường ít ỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Văn", "definition": "片文. Một đoạn văn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiến Đà", "definition": "Phạm: Waịđha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiến Để Ca Đồng Tử", "definition": "Xem Chế Tra Ca Đồng Tử.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiến Động", "definition": "扇動. Làm loạn Xúi giục làm loạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiết", "definition": "撇. Phủi đi. Phẩy đi Lấy tay mà đánh Phân biệt ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu", "definition": "僄. Nhẹ nhàng Mau lẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Bác", "definition": "剽剝. Châm chọc, chỉ trích. Công kích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Chỉ", "definition": "票紙. Giấy bạc, tiền tệ bằng giấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Cứ", "definition": "票㨿. Tấm giấy làm bằng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Hãn", "definition": "剽悍. Mau lẹ dũng mãnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Khinh", "definition": "僄輕. Nhẹ nhàng mau lẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Lỗ", "definition": "剽虜. Cướp đoạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Mai", "definition": "摽梅. Chỉ người con gái tới tuổi lấy chồng (như trái mơ chín có thể hái được). Phiếu hữu mai, kì thực thất hề.. kì thực tam hề 摽有梅其實七兮。。。 其實三兮 Kinh thi: Thơ phiếu mai (mai rụng) Nghĩa là quả mai mười phần còn bảy phần.. còn ba phần, nhưng vẫn hãy còn quả, ví như người đàn bà đã hơi quá tuổi song lấy chồng cũng còn vừa. “Quả mai ba bảy đương vừa, đào non sớm liệu xe tơ kịp thì” (Kiều).”", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Mạo", "definition": "Cũng gọi Phiếu Mạo Tử, Khỏa Đầu. Cái mũ hoặc chiếc khăn bằng lụa bịt kín đầu của người Ấn Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiếu Mẫu", "definition": "𣶐母. Bà già giặt vải. Hàn Tín thời còn hàn vi, một hôm đói quá, được một bà già giặt vải cho bát cơm, sau Hàn Tín làm tướng, đem ngàn vàng mà đền ơn. Ta thường đọc trại thành Xiếu mẫu. Đoạn trường tân thanh có câu: “Nghìn vàng gọi chút lễ thường, mà lòng Phiếu mẫu mấy vàng cho cân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Quỹ", "definition": "票櫃. Thùng để bỏ các phiếu thăm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiếu Tửu", "definition": "縹酒. Tên một thứ rượu ngon, màu hơi xanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền", "definition": "墦. Ngôi mộ. Mồ mả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Diễn", "definition": "繁衍. Nảy nở lan tràn thêm nhiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Hoa", "definition": "繁華. Nơi đông đảo xa xỉ. Cũng đọc Phồn hoa. Đoạn trường tân thanh có câu: “Người mà đến thế thì thôi, đời phồn hoa cũng là đời bỏ đi” Sử kí: Lữ bất vị bảo với bà chị của Hoa Dương phu nhân nói với phu nhân rằng: Lấy sắc đẹp mà thờ vua, khi sắc suy thì tình yêu sẽ suy giảm, mà chẳng nhân lúc cây đang buổi phồn hoa mà chờ lúc nhan sắc suy, tình yêu giảm thì dẫu có muốn nói năng một đôi điều cũng không thể nào được nữa (Tầm nguyên tđ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Hà", "definition": "煩苛. Quá khắt khe, làm người khác khó chịu, Bình Ngô đại cáo của Nguyễn Trãi, bản dịch của Bùi Kỉ, có câu: “ Vừa rồi, vì họ Hồ chính sự phiền hà, để trong nước nhân dân oán bạn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Khí", "definition": "煩氣. Vẻ buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Lao", "definition": "煩勞. Làm rộn và làm người khác mệt nhọc vì mình. Tiếng dùng khi nhờ vả người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Lụy", "definition": "Upaddava (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiền Muộn", "definition": "煩悶. Buồn rầu. Đoạn trường tân thanh có câu: “Những là phiền muộn đêm ngày, xuân thu biết đã đổi thay thế nào”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Mậu", "definition": "繁茂. Rậm rạp tươi tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Nan", "definition": "煩難. Rắc rối khó khăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Nhiểu", "definition": "煩擾. Quấy rối, gây rắc rối cho người khác Rắc rối bực mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Nhục", "definition": "燔肉. Việc nướng thịt cúng tế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Não", "definition": "Là tiếng gọi tổng quát chỉ cho những hiện tượng tâm lí xấu xa, sai lầm, là động lực thúc đẩy con người gây nên mọi điều tội lỗi về cả ba nghiệp thân, miệng và ý; khiến cho thân tâm lúc nào cũng vọng động, lầm lạc, đau khổ, lo buồn, xao xuyến, bất an. Phiền Não có những tên gọi khác là: sử (đeo đuổi, sai khiến, thôi thúc chúng sinh gây nghiệp ác), lậu (làm cho chúng sinh lọt vào vòng sinh tử luân hồi), kết (thắt buộc, kết tụ), hoặc (sai lầm), cấu (dơ bẩn), nhiễm (ô uế), tùy miên (đeo dính khiến chúng sinh lúc nào cũng ở trong trạng thái hôn muội trầm trọng), triền (quấn chặt, trói buộc), cái (che lấp), thủ (giữ chặt), bạo lưu (cuốn trôi), trần cấu (bụi bẩn). Mục đích tối cao của người tu học Phật là giác ngộ giải thoát; vậy, tất cả những gì làm cho chúng sinh bị chướng ngại trên bước đường tiến tới đạo quả giác ngộ giải thoát, đều được coi là phiền não.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phiền Não Băng", "definition": "Phiền não và băng giá.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiền Não Chướng", "definition": "Kleśāvaraṇa (S), Afflictive obstruction, Kilesavaraṇa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiền Não Hoặc", "definition": "Mūlakleśa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiền Não Ngại Trí Ngại", "definition": "Cũng gọi Nhị Ngại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiền Não Thức", "definition": "Klesha consciousness, nyön yid (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiền Não Trược", "definition": "Kleśa-kaṣāyaḥ (S), Living-being turbidity, Affliction turbidity.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiền Não Tập", "definition": "Cũng gọi Dư Tập, Tập Khí, Tàn Khí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiền Não Tặc", "definition": "Giặc phiền não.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiền Não Tức Bồ Đề", "definition": "Les détresses impliquent l'éveil 煩惱即菩提", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phiền Oan", "definition": "煩冤. Buồn rầu uất ức không nói ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Oán", "definition": "煩怨. Buồn giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Pháp", "definition": "煩法. Luật lệ rắc rối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Phí", "definition": "煩費. Tốn kém vô ích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Phược", "definition": "纏縛", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phiền Phức", "definition": "煩複. Rắc rối lẫn lộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Thịnh", "definition": "繁盛. Nhiều và tốt đẹp. Cũng đọc Phồn thịnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Thực", "definition": "繁殖. Nảy nở thêm nhiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Tiên", "definition": "繁鮮. Rậm rạp tươi tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Toái", "definition": "煩碎. Như Phiền tế 煩細.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Toả", "definition": "煩瑣. Như Phiền tế 煩細.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Tưởng", "definition": "繁想. Ý nghĩa phức tạp. Nghĩ ngợi lung tung lộn xộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Tạp", "definition": "繁雜. Nhiều, lộn xôn rắc rối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Tế", "definition": "煩細. Vụn vặt rắc rối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Tức", "definition": "繁息. Sinh sôi nảy nở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Vinh", "definition": "繁榮. Đông nhiều và tốt đẹp. Cũng đọc Phồn vinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Văn", "definition": "煩文. Văn chương rắc rối lôi thôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiền Xương", "definition": "繁昌. Như Phiền thịnh 繁盛, Phiền vinh 繁榮.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiển Não", "definition": "Disturbing emotion kleśa, nyön mong (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phiểu", "definition": "剽. Cái đầu nhọn. Cái đầu, cái mũi, phần ngọn Các âm khác là Phiêu, Phiếu. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiệt", "definition": "丿. Nét phẩy trong chữ Hán Tên một bộ chữ Trung Hoa, tức bộ Phiệt Một âm là Thiên. Xem Thiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiệt Duyệt", "definition": "閥閲. Lệ thời cổ, công thần có công trạng thì được viết công trạng đó dán trước cửa nhà, ở phía trái thì gọi là Phiệt, phía phải gọi là Duyệt, Phiệt duyệt chỉ gia đình công thần. Sau chỉ gia đình quyền thế. “Mở dòng phiệt duyệt, rạng nền tổ tông”. (Yên Đổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phiệt Dụ", "definition": "Ví dụ cái bè qua sông. Giáo pháp của Đức Phật ví như cái bè, một khi đã đến được bờ Niết Bàn bên kia rồi thì chính pháp cũng nên xả bỏ. Cho nên tất cả các pháp do Đức Phật nói được ví dụ như cái bè, không nên cố chấp vào đó mà bị trói buộc. Cũng như qua sông rồi thì phải bỏ bè lại, chứ nếu tiếc nó mà vác lên vai để đi tiếp thì lập tức mất tự do, giải thoát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phiệt Sai Tử", "definition": "S. Vatsiputrya. Người sáng lập ra bộ phái Độc Tử bộ (Vatsiputryeh), xuất hiện trong thời kỳ Phật giáo bộ phái, khoảng 200 năm sau khi Phật vào Niết Bàn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phiệt Thế Hữu", "definition": "S. Vasimutra. Cao tăng Bắc Ấn Độ, ban đầu xuất gia theo Hữu Bộ (Sarvastivada), sau được cử làm Chủ tịch đại hội kiết tập kinh điển Phật giáo lần thứ IV ở Kashmia dưới triều vua Kaniskha.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phiệt Tô Bàn Đầu", "definition": "S. Vasubandhu. Luận sư Ấn Độ nổi tiếng, tác giả nhiều bộ Luận Đại thừa có giá trị (Thế kỷ Vii TL). Thường gọi là Bồ Tát Thế Thân. Ông là em trai của Luận sư Vô Trước (Asanga) và cùng với anh lập ra học phái Duy Thức (Vijnanavada), cũng gọi là học phái Du già (Yogacara).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phobia", "definition": "Sự ám ảnh, nỗi sợ hải", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phoenician", "definition": "Người Phê-ni-xi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phong", "definition": "Vāya (S), Wind.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Ba", "definition": "風波. Sóng gió chỉ những khó khăn trở ngại ở đời. Đoạn trường tân thanh có câu: “Đã gần chi có đường xa, đá vàng cũng quyết, phong ba cũng liều”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Bá", "definition": "風佰. Ông thần gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Bái", "definition": "封拜. Vua ban chức tước cho bề tôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Bì", "definition": "封 皮. Dụ chỉ thân thể. Tiết Đãi chế Phan Lương Quý cư sĩ trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phong Bệ", "definition": "楓陛. Thềm nhà, hai bên trồng cây phong. Chỉ nơi vua ở (cung điện đời Hán xung quanh trồng nhiều cây phong).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Can", "definition": "Bukan (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Chuẩn", "definition": "蜂準. Sống mũi cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Chúc", "definition": "風燭. Cây nến trước gió. Chỉ sự không bền vững, có thể mất đi bất cứ lúc nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Cuồng Tử", "definition": "風 狂 子. Gã điên. Chương Thiên Thai Phong Can Thiền Sư trong CĐTĐL q. 27 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phong Cách", "definition": "風格. Dáng dấp điệu bộ bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Cảng", "definition": "封港. Dùng sức mạnh quân đội để đóng kín một cửa biển, không cho tàu bè vào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Cảnh", "definition": "風景. Chỉ chung những vật tự nhiên bày ra trước mắt, tức cảnh thiên nhiên. Đoạn trường tân thanh có câu: “Bước lần theo ngọn gió tiểu khê, nhìn xem phong cảnh có bề thanh thanh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Cầm", "definition": "風琴. Cây đàn kêu bằng sức ép của gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Cốt", "definition": "風骨. Dáng dấp bên ngoài Cũng chỉ lòng dạ trong sạch, cứng cỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Cổ", "definition": "烽鼔. Lửa đốt trống đánh báo hiệu có giặc. Chỉ tình trạng chiến tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Dao", "definition": "風謠. Bài hát ngắn lưu truyền trong nhân gian, mô tả nếp sống theo thói quen có từ lâu đời của một vùng, một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Doanh", "definition": "豐盈. Nhiều và đầy. Chỉ giàu có dư giả Cũng chỉ sự được mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Dụ", "definition": "豐裕. Giàu có dư giả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Dục Thạch Kinh", "definition": "Những cột đá có khắc kinh để ở phía tây huyện Thái Nguyên, tỉnh Sơn Tây, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Giáo", "definition": "風教. Chỉ cái nếp sống chung sẵn có, làm thay đổi được người ta.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Giới", "definition": "Phạm, Pàli: Vàyu-dhàtu. Cũng gọi Phong Đại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Hiến", "definition": "風憲. Chỉ chung nếp sống sẵn có và luật lệ phép tắc của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Hoá", "definition": "風化. Như Phong giáo 風教.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Hoả", "definition": "烽火. Ngọn lửa đốt ở biên giới để báo nguy. Xem thí dụ ở chữ Phong 烽 Đỗ Phủ: “Phong hoả liên tam nguyệt” (khói lửa luôn ba tháng). “Gặp cơn khói lửa khói bề thoát thân” (Thơ cổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Huyệt Diên Chiểu", "definition": "Fuketsu Enshō (J), Feng-Hsueh Yen-chao (C), Fengxue Yanzhao (C), Fuketsu Ensho (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Huyệt Nhất Trần", "definition": "Cũng gọi Phong Huyệt Gia Quốc Hương Thịnh, Phong Huyệt Nhược Lập Nhất Trần. Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Huyệt Thiết Ngưu Cơ", "definition": "Cũng gọi Phong Huyệt Thiết Ngưu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Huyệt Tự", "definition": "風 穴 寺. Còn gọi: Thiên Phong Tự, Bạch Vân Tự, Hương Tích Tự. Chùa nằm trong núi Phong Huyệt, phía nam chân núi Thiếu Thất, cách huyện Lâm Nhữ, tỉnh Hà Nam, Trung Quốc 9km về hướng đông bắc. Đầu tiên được xây vào thời Bắc Ngụy (385-475), đến các đời Tùy, Đường đều có sửa sang. Vào niên hiệu Trường Hưng thứ 2 (931), triều Hậu Đường thời Ngũ Đại, Thiền Sư Diên Chiểu trụ trì chùa này. Lúc bấy giờ chùa đã hư mục sẵn, ngài Diên Chiểu ở đó 7 năm, hết lòng gầy dựng khiến trở thành 1 ngôi tòng lâm. Kiến trúc chủ yếu hiện còn: Thiên vương điện, Trung Phật điện, Tỳ lô điện, Huyền chung các, Tàng kinh các. Trung Phật điện là kiến trúc đời Kim, vào sâu có ba gian đình. Huyền chung các theo kiểu Yết Sơn, ba mái cao vút nguy nga, bên trong gác treo 1 chuông sắt lớn được đúc vào niên hiệu Tuyên Hòa thứ 7 (1125) đời Tống, hình dạng đơn sơ chất phác, âm thanh hùng hậu. Chung quanh chùa phong cảnh hữu tình, vốn là thắng cảnh du lịch. Các vị: Sầm Tham, Lưu Vũ Tích, Nguyên Kết đều từng đến chùa này làm thơ lưu niệm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phong Huyệt Tự Thất Tổ Tháp", "definition": "風 穴 寺 七 祖 塔. Tháp nằm trong khuôn viên chùa Phong Huyệt cách thành phố huyện Lâm Nhữ, tỉnh Hà Nam Trung Quốc 10km về phía đông bắc. Xây vào niên hiệu Khai Nguyên thứ 26 (738) đời Đường, là bia ghi công đức Thiền Sư Trinh, một cao tăng nổi tiếng, vua Đường Huyền Tông sắc tứ “Thất Tổ Tháp”. Đây là tháp gạch hình vuông chín tầng có vành mái cao khoảng 27 mét. Các bộ phận tỉ lệ cân xứng, tạo dáng ưu mỹ, mái kiểu chồng diêm, dưới mái có đường cong ngược hình cung do bát úp, tướng luân, bảo cái và ngọn lửa làm thành, đây là phong cách tháp có mái kín đời Đường. Tháp này là một ngôi tháp được giữ gìn hoàn hảo nhất trong các tháp thời kỳ đầu đời Đường. Như tòa tháp nhỏ của Tiểu Nhạn Tháp ở Tây An, Pháp Vương Tự Tháp ở Đăng Phong đều hư hủy, cho nên càng thấy được vẻ đẹp hoàn bích của tháp này.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phong Hàng", "definition": "Thuyền vượt biển thuận buồm xuôi gió, ví dụ pháp môn Tịnh Độ dễ tu hành. Vãng Sinh Luận Chú quyển thượng (Đại 40, 826 trung) nói: “Vô Lượng Thọ Kinh ưu bà đề xá này, trên thì diễn bày đến chỗ rốt ráo, như phong hàng (thuyền vượt biển xuôi gió) không bao giờ trở lui”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Hành", "definition": "風行. Lan đi, truyền đi mau lẹ, như gió thổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Hậu Tiên Sinh", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Hỏa Vị Tán", "definition": "Cũng gọi Hỏa Phong Vị Tán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Hồng", "definition": "風虹. Cái quầng xung quanh mặt trăng, báo hiệu sắp có gió lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Hội", "definition": "風會. Lúc thời thế xoay vần. Thơ Tản Đà có câu: “Cho hay phong hội âu là thế, mà cái văn minh nó ở đâu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Khuyển Bệnh", "definition": "瘋犬病. Bệnh chó dại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Khí", "definition": "風氣. Hơi gió Cũng chỉ cái dáng dấp cử chỉ, cái vẻ toát ra bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Khởi", "definition": "蜂起. Nổi lên như ong, ý nói đông đảo mạnh mẽ lắm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lan", "definition": "風蘭. Tên chỉ chung một số cây kí sinh, lá nhỏ dài, hoa trắng thơm, mọc hoang, người ta thường tìm về làm cảnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Luân", "definition": "Vayu-maṇdala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Luân Tam Muội", "definition": "Chỉ cho trí tuệ của người phạm hạnh tu thiền định mà phát được, 1 trong Ngũ Luân Tam Muội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Luân Đàn", "definition": "Cũng gọi Phong Luân Mạn Đồ La, Phong Đàn, Bán Nguyệt Đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Lôi", "definition": "風雷. Gió và sấm Chỉ sự nổi giận dữ dội. Đoạn trường tân thanh có câu: “Phong lôi nổi trận bời bời, nặng lòng e ấp tính bài phân chia”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lưu", "definition": "風流. Chỉ cuộc sống dư giả nhàn hạ, êm đềm như gió thổi như nước chảy. Đoạn trường tân thanh có câu: “Phong lưu rất mực hồng quần, xuân xanh xấp xỉ tới tuần cập kê” Cũng chỉ sự ăn chơi phóng đãng. Thơ Nguyễn Công Trứ có câu: “Mang danh tài sắc cho nên nợ, quan thói phong lưu hoá phải vay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lương", "definition": "風涼. Gió thổi mát mẻ Hóng gió. Hóng gió cho mát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lạp", "definition": "蜂蠟. Sáp ong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lợi", "definition": "鋒利. Nhọn và sắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lực", "definition": "風力. Sức gió thổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Lực Biểu", "definition": "風力表. Dụng cụ thiên văn, để đo sức gió, tốc độ của gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Mang", "definition": "鋒鋩. Mũi nhọn, mũi gươm đao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Mạo", "definition": "風貌. Mặt mũi và dáng dấp bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Mẫu", "definition": "Vāyavi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Mật", "definition": "蜂蜜. Chất nước dính, ngon ngọt và bổ, do loài ong làm ra, tức mật ong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Mộ", "definition": "封墓. Đắp thêm đất lên mồ mả Đắp đất lên cho thành nấm mồ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Mộc", "definition": "風木. Cây bị gió lay. Chỉ cha mẹ già yếu mà con cái không kịp về phụng dưỡng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Mộc Hưng Hoài", "definition": "(風木興懷): gió cây thương tiếc, như trong Nghênh Xuân Dạ Thoại (迎春夜話) của Hứa Vân Tiều (許雲樵) có câu: “Phong mộc hưng hoài thế tự liên, Lục Nga tam phục hận chung thiên (風木興懷涕自漣、蓼莪三復恨終天, cây gió tiếc thương lệ trào tuôn, song thân quá vãng hận triền miên).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phong Nghi", "definition": "風儀. Dáng dấp, cử chỉ và nét mặt bề ngoài. Văn tế Vũ Tính và Ngô Tùng Châu của Đặng Đức Siêu có câu: “Bóng tinh trung thấp thoáng dưới đèn, phong nghi cũ kẻ liêu bàng sát lệ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Nghị", "definition": "蜂蟻. Con ong và con kiến, chỉ lòng trung với vua (như con ong con kiến trung thành với ong chúa, kiến chúa) Loài ong và loài kiến đi đâu thường kéo theo cả bầy, do đó chỉ sự đông đảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Nguyệt", "definition": "風月. Gió và trăng, chỉ cảnh thiên nhiên. Đoạn trường tân thanh có câu: “Sánh vai về chốn thư hiên, góp lời phong nguyệt nặng nguyền non sông” Cũng chỉ sự liên lạc không đúng đắn giữa trai gái. “Đặt bày phong nguyệt, dèm pha cương thường” (Hoa Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Nhuệ", "definition": "鋒鋭. Nhọn và sắc (nói về gươm đao) Chỉ binh đội mạnh mẽ hăng hái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Nhân", "definition": "風人. Người làm thơ. Như: Thi nhân. Kinh Thi có thiên Quốc phong, gồm nhiều bài thơ lẽ cực văn chương, mà ý tưởng lại cao đẹp. Về sau người làm thơ, lời hay ý đẹp, được gọi là Phong nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Nhã", "definition": "Fūga (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Nhập", "definition": "Tiếng dùng của Phật Giáo Nhật Bản. Vào núi.Chỉ cho việc hành giả Tu Nghiệm Đạo Nhật Bản vào núi Đại phong ở Đại Hòa chiêm bái di tích của vị Tổ khai sáng ra phái này là ngài Dịch tiểu giác. Hàng năm, từ khoảng tháng 4 đến tháng 9, những hành giả Tu Nghiệm Đạo phải lên núi 3 lần, thời gian đó phải tinh tiến, giữ trai giới thanh tịnh để hoàn thành sự nghiệp tu đạo và phải do vị Tiên đặt hướng dẫn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Niên", "definition": "豐年. Năm được mùa, no đủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Nẫm", "definition": "豐稔. Được mùa. Như Phong đăng 豐登.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Phan Thoại", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Phan Đường", "definition": "風 幡 堂. Nằm trong chùa Quang Hiếu, thành phố Quảng Châu, tỉnh Quảng Đông, Trung Quốc. Niên hiệu Nghi Phụng thứ 1 (676) đời Đường, Huệ Năng đến chùa Pháp Tính nghe Pháp sư ấn Tông giảng kinh Niết Bàn, đúng lúc gặp gió thổi lá phướn động, thấy hai ông tăng tranh luận, một ông nói gió động, một ông nói phướn động, Huệ Năng bèn nói là tại tâm các ông động. Lời nói làm kinh ngạc tăng chúng, qua những lời hỏi han của Pháp sư ấn Tông mới biết ngài là pháp tự của Tổ Hoằng Nhẫn. Do đây Huệ Năng công khai truyền bá Thiền Nam tông. Người đời sau xây cất Phong Phan Đường để kỷ niệm việc này. Niên hiệu Vạn Lịch thứ 21 (1593) đời Minh bị chiếm làm quán xá, lâu năm bị sụp lở, những vị tăng trụ trì như Thông Húc, Siêu Kỳ, Siêu Trân bỏ của cải ra chuộc lại rồi trùng tu, đem Phong Phan Đường cùng Thùy Phật Lâu họp làm một.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phong Phòng", "definition": "蜂房. Tổ ong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Phú", "definition": "豐富. Nhiều, dồi dào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Phương", "definition": "Tên gọi khác của phương Tây bắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Quang", "definition": "風光. Như Phong cảnh 風景. Bài tụng Tây Hồ phú của Nguyễn Huy Lượng có câu: “Nhận giá sắc xét dân phong cần noạ Ngắm phong quang soi vật tính thanh ô”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Quang Khả Ái", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Quá Thụ", "definition": "風 過 樹. Gió thổi qua cây, tỷ dụ cho sau khi nghe người khác nói gì về mình, mình hoàn toàn chẳng để nơi lòng, chẳng câu nệ ngôn từ văn cú, khái niệm ý nghĩa. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phong Sương", "definition": "風霜. Gió và sương Chỉ những cực khổ gian nan ở đời Cũng chỉ sự chịu đựng gian khổ ở đời, giống như cây tùng cây bách chịu đựng gió sương. Đoạn trường tân thanh có câu: “Phong sương được vẻ thiên nhiên, mặn khen nét bút càng nhìn càng tươi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Sắc", "definition": "豐嗇. Đầy đủ và thiếu thốn. Chỉ sự bù đắp qua lại theo luật bù trừ của tạo hoá, được cái này thì mất cái kia. Đoạn trường tân thanh có câu: “Lạ gì bỉ sắc tư phong, trời xanh quen thói má hồng đánh ghen”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tam Muội", "definition": "Gọi đủ: Phong phấn tấn tam muội.Loại thiền định có năng lực phát khởi gió mạnh, làm phân tán các bộ phận thân thể, vì thế gọi là Phong tam muội (Thiền Định gió).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Tao", "definition": "風騷. Dáng dấp cử chỉ thanh tú đẹp đẽ. Truyện Hoa Tiên có câu: “Tiếc cho cửa tướng nhà dòng, phong tao tài điệu rất cùng ai so”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thanh", "definition": "風聲. Tiếng gió thổi Chỉ tin tức từ xa về, không chắc chắn lắm. “Vả trong cương tỉnh phong thanh” (Trinh Thử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thiên", "definition": "Tên một vị trời. Xem Diệt.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Thiền", "definition": "(峰禪, Hōzen, 854-925): vị tăng của Chơn Ngôn Tông Nhật Bản, sống vào đầu thời Bình An, Tọa Chủ đời thứ 3 của Cao Dã Sơn, húy là Phong Thiền (峰禪). Ông theo Chơn Nhiên (眞然) xuất gia, rồi đến năm 902 thì thọ phép Quán Đảnh với Thánh Bảo (聖寶), sau đó được bổ nhiệm làm Nội Cúng Phụng Thập Thiền Sư (內供奉十禪師), Truyền Đăng Đại Pháp Sư (傳燈大法師) và đến trú tại Đại An Tự (大安寺, Daian-ji) vùng Đại Hòa (大和, Yamato). Đến năm 916, ông được bổ nhiệm làm Tọa Chủ của Cao Dã Sơn, và đến năm 919 thì từ chức", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phong Thái", "definition": "Ākāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phong Tháo", "definition": "風操. Như Phong tiết 風節.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thượng", "definition": "風尚. Nếp sống đang được ưa chuộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thấp", "definition": "風濕. Bệnh đau nhức, do nhiễm gió và khí ẩm tạo thành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thần", "definition": "Vāyava (S), God of Air.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Thần Lôi Thần", "definition": "Phạm: Vàyu Garjita.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Thần Tú Cát", "definition": "(豐臣秀吉, Toyotomi Hideyoshi, 1537-1598, có thuyết cho là 1536-1598): vị võ tướng dưới thời đại Chiến Quốc và An Thổ Đào Sơn, xuất thân vùng Vĩ Trương (尾張, Owari), con của Mộc Hạ Di Hữu Vệ Môn (木下彌右衛門); lúc nhỏ tên là Nhật Cát Hoàn (日吉丸), khi lớn có tên là Đằng Cát Lang (藤原郎). Ông đã từng làm việc cho Chức Điền Tín Trưởng (織田信長, Oda Nobunaga), rồi được đặt cho tên là Vũ Sài Tú Cát (羽柴秀吉). Trong cuộc chính biến ở Bổn Năng Tự (本能寺, Honnō-ji), ông tiêu diệt Minh Trí Quang Tú (明智光秀), bình định các vùng Tây Quốc (西國, Saigoku), Bắc Quốc (北國, Hokkoku), Cửu Châu (九州, Kyūshū), Quan Đông (關東, Kantō) và Áo Vũ (奥羽, Ōu), rồi thống nhất thiên hạ. Trong khoảng thời gian này, ông được ban cho các chức như Quan Bạch vào năm 1585, rồi năm sau thì được tặng cho tên Phong Thần và Thái Chính Đại Thần. Nhưng đến năm 1591, ông nhường chức Quan Bạch lại cho người con nuôi Tú Thứ (秀次) và tự xưng là Thái Các (太閤). Ông có ý định chinh phục nhà Minh, sau đem quân sang đánh Triều Tiên, nhưng bị chết trong trận chiến.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phong Thần Tú Lại", "definition": "(豐臣秀賴, Toyotomi Hideyori, 1593-1615): vị Võ Tướng sống dưới thời đại An Thổ Đào Sơn (安土桃山), con của Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi). Năm lên 5 tuổi, ông đã kế thừa gia tộc, rồi lấy con gái của Tú Trung (秀忠, Hidetada) làm vợ. Trong trận chiến ở Osaka, do bị hãm thành, ông đã tự vẫn cùng với mẹ", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phong Thổ", "definition": "風土. Đất đai và nếp sống của một vùng Cũng chỉ khí hậu của một vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thụ", "definition": "風樹. Như Phong mộc 風木.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Thủy", "definition": "風水. Chỉ việc xem thế đất mà chôn người chết, để quyết định được về tương lai con cháu người chết. “Tin lời phong thuỷ khí tà” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tiên Luận Sư", "definition": "Cũng gọi Phong Luận Sư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Tiết", "definition": "風節. Dáng dấp cứng cỏi và lòng dạ ngay thẳng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Toả", "definition": "封鎖. Đóng kín và khoá chặt, ý nói không cho trong ngoài thông được với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tranh", "definition": "風箏. Cái diều (món đồ chơi thả lên không).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Triều", "definition": "風潮. Cũng đọc Phong trào. Chỉ một loạt những hành động giống nhau của nhiều người, nổi lên trong một thời gian ngắn, giống như cơn gió thổi tới, nước triều dâng lên. “Phong trào gặp buổi canh tân” (Thơ cổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Trần", "definition": "風塵.Gió và bụi.Chỉ những nỗi gian nan vất vả ở đời. Đoạn truờng tân thanh có câu: “Bắt phong trần phải phong trần, cho thanh cao mới được phần thanh cao”. Phong trần 風塵: Gió bụi. Chốn phong trần chỉ về cuộc đời tình cảnh gian khổ nay đây mai đó. “Rày con xuống chốn phong trần” (Lục Vân Tiên). Phong trần: Gió bụi có nhiều nghĩa: 1. Gió cuốn bụi tung trời đất mù mịt. Ví đời có nạn chiến tranh. 2. Ở đời chịu nhiều nỗi gian nan trong bước đường công danh của phường quan lại. Thơ Đỗ Phủ: Bạc hoạn phong trần: Chức mỏng chạy trong gió bụi, tức là quan nhỏ; chịu nhiều nỗi khó khăn. 3. Gái kĩ nữ gọi là truỵ lạc phong trần: Rơi rụng nơi gió bụi. Thơ Trương Tuần khi nghe trống đánh nổi giặc có câu: “Bất tiện phong trần sắc, an tri thiên địa tâm”. Chẳng nhận được vẻ gió bụi, sao biết lòng trời đất. Ý nói hoạ chiến tranh bởi trời đất sinh ra. (Chinh phụ ngâm khúc).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Trữ", "definition": "封貯. Gói kín cất để dành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tà", "definition": "風邪. Chỉ chung gió độc khí độc ở ngoài nhiễm vào người mà sinh bệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tài Bồ Tát", "definition": "Bhogavati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Tâm", "definition": "Tâm gió, tức là tâm tán loạn không ngừng, luôn xao động như gió. Một trong 60 thứ vọng tâm nói trong Kinh Đại Nhật. Phẩm Trụ Tâm Kinh Đại Nhật (Đại 18, 3 thượng) nói: “Tại sao gọi là Phong tâm? Vì tính của tâm này như gió phát khởi ở khắp mọi nơi”. [X. Đại Nhật Kinh Sớ Q.2].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Tình", "definition": "風情. Chuyện yêu thương giữa trai gái được lưu truyền. Đoạn trường tân thanh có câu: “Cảo thơm lần giở trước đèn, phong tình cổ lục còn truyền sử xanh” Ngày nay chỉ mối liên hệ kém đứng đắn giữa trai gái Còn chỉ những bệnh hoa liễu, do sự chung đụng trai gái không đúng đắn mà ra 風情古錄 “Phong tình cổ lục” là bộ sách nói những chuyện phong tình đời xưa. “Phong tình cổ lục còn truyền sử xanh” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tín", "definition": "風信. Tin gió, tin tức do gió đưa lại, tức hướng gió và các tin tức thời tiết căn cứ vào hướng gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tính Thường Trụ", "definition": "Tên công án trong Thiền Tông. Tính gió thường còn. Nội dung công án này nói về cơ duyên vấn đáp giữa Thiền Sư Ma Cốc Bảo Triệt và 1 vị tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Túc", "definition": "豐足. Giàu có đầy đủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tư", "definition": "風姿. Dáng dấp cử chỉ bề ngoài. Đoạn trường tân thanh có câu: “Phong tư tài mạo tót vời, vào trong phong nhã ra ngoài hào hoa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tước", "definition": "封爵. Vua ban cho danh hiệu cao quý, tương xứng với công lao và chức vụ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tặng", "definition": "封贈. Vua ban cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tế", "definition": "Chỉ cho bờ mé dưới cùng của Phong Luân. Phong Luân là tầng dưới chót của thế giới.Một thế giới được hình thành trước hết phải đứng trên hư không, tức Không Luân. Nương vào Không Luân mà sinh ra Phong Luân, Thủy Luân, Kim Luân... dần dần tiến tới sinh ra núi Tu Di và 4 Châu. (xt. Phong Luân).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Tụ", "definition": "蜂聚. Họp lại đông đảo như ong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tục", "definition": "風俗. Chỉ chung các thói quen có từ lâu đời trong nếp sống của một vùng, một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Tử", "definition": "烽子. Người lính canh giữ nơi đốt lửa ở biên giới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vân", "definition": "風雲.Gió và mây, chỉ con đường công danh. Phong vân 風雲: Gió mây. Vân tùng long, phong tùng hổ 雲從龍風從虎 (Kinh Thi", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Văn", "definition": "風聞. Do hơi gió mà nghe được. Được nghe tin.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vũ", "definition": "風雨. Gió và mưa. Mưa gió. Phong vũ thôi thi tứ: 風雨催詩思 (Cổ thi). Cái thi tứ nhanh như gió mưa đun đẩy. “Tay tiên gió táp mưa sa” (Kiều). “Đêm phong vũ lạnh lùng có một”. (Cung oán ngâm khúc).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vũ Biểu", "definition": "風雨表. Vật dụng để biết khí hậu thời tiết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vương", "definition": "封王. Được vua ban tước Vương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vận", "definition": "風運. Gió thổi xoay vần. Chỉ lúc thời thế xoay vần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vật", "definition": "風物. Như Phong cảnh 風景.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Vị", "definition": "風味. Chỉ sự thích thú và cái ý nghĩa cao đẹp của một sự việc, hoặc trong một cuộc sống. Truyện Hoa Tiên có câu: “Nói chi phong vị lâu đài, vả trong khách huống lữ hoài biết sao” Phong: Gió; vị: Mùi, mùi thơm ngào ngạt. Lưu Tuấn Văn: Nam Trung Quất Cam, thái chi phong vị chiếu toạ (Nam trung quýt ngọt, hái xuống hương thơm ngào ngạt cả chỗ ngồi). Phong vị lại có nghĩa người phong lưu học thức rộng. Tống thơ: Bá Ngọc ôn nhã hữu phong vị, hoà nhi năng biện, dự nhân cộng sự giai vi thâm giao. Bá Ngọc người ôn hoà thanh nhã có phong vị, người hoà nhã có tài biện luận, cùng cộng sự với ai đều trở nên thâm giao cả. (Tầm Nguyên tđ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Xa", "definition": "風車. Vòng bánh xe quạt gió của nhà nông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Xan Lộ Túc", "definition": "風餐露宿. Ăn trong gió ngủ trong sương, chỉ nỗi cực nhọc vất vả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Xuất", "definition": "蜂出. Túa ra ồ ạt đông đảo như đàn ong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Yên", "definition": "烽煙. Lửa khói. Chỉ tình trạng chiến tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Yêu", "definition": "蜂腰. Lưng ong, chỉ cái lưng thon nhỏ của đàn bà đẹp, thắt lại như lưng con ong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Đao", "definition": "Cũng gọi Đao Phong.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phong Điên", "definition": "瘋癲. Bệnh rồ dại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Điệu", "definition": "風調. Dáng dấp cử chỉ bề ngoài Cái vẻ riêng của một câu văn, nhận thấy được ngay từ bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Đô", "definition": "(酆都): chỉ cho nơi trú ngụ ở quỷ thần. Như trong Tây Dương Tạp Trở (酉陽雜俎), phần Ngọc Cách (玉格), của Đoàn Thành Thức (段成式, 803?-863) nhà Đường, giải thích rằng: “Hữu La Phong Sơn, tại Bắc phương Quý địa, chu hồi tam vạn lí, cao nhị thiên lục bách lí, động thiên lục cung, chu nhất vạn lí, cao nhị thiên lục bách lí, thị vi Lục Thiên quỷ thần chi cung … tử nhân giai chí kỳ trung (有羅酆山、在北方癸地、周迴三萬里、高二千六百里、洞天六宮、周一萬里、高二千六百里、是爲六天鬼神之宮…人死皆至其中, có La Phong Sơn, tại phương Bắc đất Bắc, chu vi ba vạn dặm, cao hai ngàn sáu trăm dặm, động trời sáu cung, chu vi một vạn dặm, cao hai ngàn sáu trăm dặm, chính là sáu cung quỷ thần, … người chết đều đến các cung này).” Nguyên lai, từ Phong Đô được dùng để chỉ cho La Phong Sơn, nơi ngự trị của quỷ thần; nhưng về sau được dùng để ám chỉ Huyện Phong Đô (豐都縣) ở Tỉnh Tứ Xuyên (四川省). Trong tác phẩm Trà Hương Thất Tùng Sao (茶香室叢鈔), phần Phong Đô Âm Quân (酆都陰君), của Du Việt (兪樾, 1821-1907) nhà Thanh, còn cho biết rằng: “Phong Đô Huyện Bình Đô Sơn vi Đạo thư thấp thập nhị phước địa chi nhất, nghi vi thần tiên quật trạch, nhi thế nãi truyền vi quỷ bá sở cư, thù bất khả giải (酆都縣平都山爲道書七十二福地之一、宜爲神仙窟宅、而世乃傳爲鬼伯所居、殊不可解, Bình Đô Sơn ở Huyện Phong Đô là một trong 72 vùng đất phước của Đạo Giáo, có lẽ là nhà cửa hang động của thần tiên, mà thế gian tương truyền là nơi quỷ thần cư trú, thật lạ không hiểu được).” Trong Địa Tạng Bổn Nguyện Kinh Khoa Chú (地藏本願經科註, 卍 Tục Tạng Kinh Vol. 21, No. 384) quyển 4 có liệt kê tên một số quan viên dưới Địa Ngục như: “Đông Nhạc Phủ Hữu Thái Bảo, Truy Nhiếp Sinh Hồn Ngạc Nguyên Soái, Truy Nhiếp Tử Hồn Mạnh Nguyên Soái, Phong Đô Cửu Khúc Truy Hồn Trảm Quỷ Vi Nguyên Soái (東嶽府有太保、追攝生魂鄂元帥、追攝死魂孟元帥、酆都九曲追魂斬鬼韋元帥).” Hay trong Huyễn Trú Am Thanh Quy (幻住庵清規, 卍Tục Tạng Kinh Vol. 63, No. 1248) có đoạn rằng: “Phong Đô giới nội Minh Phủ Thập Điện Từ Vương, Tam Đồ Lục Thú Bát Nạn Tứ Sanh chư hữu tình chúng, thống Tam Giới nhược u nhược hiển, biến thập phương nãi thánh nãi phàm (酆都界內冥府十殿慈王、三塗六趣八難四生諸有情眾、統三界若幽若顯、遍十方乃聖乃凡, trong cõi Phong Đô Minh Phủ Thập Điện Từ Vương, Ba Đường Sáu Nẻo Tám Nạn Bốn Loài các chúng hữu tình, thống lãnh Ba Cõi hoặc ẩn hoặc hiện, biến khắp mười phương ấy thánh ấy phàm).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phong Đăng", "definition": "豐登. Được mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phong Đại", "definition": "Vāyo-dhātu (S), Vayu-dhātuh (S), Air element, Wind-element.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phong Độ", "definition": "風度. Dáng dấp cử chỉ bề ngoài. “Tuy quyền tước lớn mà phong độ hèn”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu", "definition": "怤. Suy nghĩ. Nhớ tới Vui vẻ trong long.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Công", "definition": "膚功. Công lao to lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Công Dao Đầu", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phu Diễn", "definition": "敷衍. Bày rộng ra Nói rộng ra cho đủ nghĩa Hời hợt bề ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Du", "definition": "怤愉. Vui vẻ, hài lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Dịch", "definition": "夫役. Người làm việc nặng để kiếm tiền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Giáo", "definition": "敷教. Sắp đặt đường lối dạy dỗ dân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Hoá", "definition": "敷化. sắp đặt để thay đổi dân chúng, từ xấu thành tốt. Cũng như Phu giáo 敷教.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Khuân Vác", "definition": "Bhārahārī (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phu Lỗ", "definition": "俘虜. Người lính bị phe địch bắt. Tù binh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Nhân", "definition": "夫人. Vợ nhỏ của vua thiên tử Vợ của vua chư hầu Vợ của quan đại phu được sắc phong của vua Tiếng tôn xưng người đàn bà đã có chồng Cũng là tiếng tôn xưng các bà vợ quan. Đoạn trường tân thanh có câu: “Phu nhân khen chước rất mầu, chiều con mới dạy mặc dầu ra tay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Nhân Của Vua", "definition": "King’s consort", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phu Nhũ", "definition": "孚乳. Ấp trứng (nói về loài chim gà).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Phụ", "definition": "夫婦. Chồng và vợ. Vợ chồng. Truyện Hoa Tiên có câu: “Tình phu phụ nghĩa quân than, Trong tam cương ấy xem phần nào hơn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Quân", "definition": "Ayyaputtaka (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phu Quét Rác", "definition": "Pukkusa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phu Quét Đường", "definition": "Pukkusa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phu Quý Phụ Vinh", "definition": "夫貴婦榮. Chồng có chức tước thì vợ được vẻ vang. Đoạn trường tân thanh có câu: “Ngỡ là phu quý phụ vinh, ai ngờ một phú tan tành thịt xương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Thiết", "definition": "敷設. Bày biện sắp xếp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Thiển", "definition": "膚淺. Nông cạn, hời hợt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Thê", "definition": "夫妻. Chồng và vợ. Vợ chồng. Gia huấn ca của Nguyễn Trãi có câu: “Có âm dương có vợ chồng, Làm người ai thoát khỏi vòng phu thê”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Tiễu", "definition": "㕊峭. Dáng núi đột ngột nhô lên Chỉ chung vật gì đột ngột nhô lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Trần", "definition": "敷陳. Bày ra cho mọi người thấy Bày tỏ rõ ràng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Trị", "definition": "敷治. Sắp xếp việc nước để dân được yên ổn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Tấu", "definition": "敷奏. Tâu bày rõ việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Tế", "definition": "夫壻. Người chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Tử", "definition": "夫子. Tiếng học trò gọi thầy mình. Phu tử: Người đàn ông trưởng thành Chồng (tiếng vợ gọi chồng). Mạnh tử: Vô vi phu tử (Đừng trái lời chồng) “Thế mới phải phép thờ phu tử” (Nguyễn Trãi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phu Xa", "definition": "Sārathī (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phun", "definition": "Sandhūpāyati (saṃ + dhūp + āya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phung Phí", "definition": "Jīna (tính từ), parikkhaya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phurba Ax", "definition": "Is used to vanquish (chế ngự) the ego, which is the source of our greed and anger. This is about getting rid of the ego so that we will be liberated from endless cycle of birth, sickness, old age, and death.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phurba Dagger", "definition": "Is used to vanquish (chế ngự) the ego, which is the source of our greed and anger. This is about getting rid of the ego so that we will be liberated from endless cycle of birth, sickness, old age, and death.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Physical Death", "definition": "At the moment of physical death, the soul withdraws from the physical form and moves into the astral body. Our astral body is the surviving body and the body we inhabit when we leave the physical plane. It looks just like us and is the body we will operate in when we are on the other side. At death, the silver cord snaps, separating the physical and astral bodies. This is a true mark of death and separates from the final exit from this life. Wonderful angelic beings assit in the process. One can feel peace and stillness when they are present. Many times, loved one who have already crossed over lend their help as well. Once you have made your crossing, you stay on the earth plane for approximately a week. The first 72 hours after death are especially critical as there is still a spiritual disengaging from the physical going on. Although the soul is gone, there are many spiritual support systems to the body that need to be disengaged. That is why one should not cremate or bury the body until 72 hours have passed, to make sure all the spiritual connections with the physical body are complete released.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Physical homage", "definition": "Means bowing down to the objects of refuge, by touching the five limbs of the body to the ground: both knees, the palms of both hands, and the forehead. The outstretched palm must touch the ground, not simply the fists. Like- wise, the forehead should touch the ground. This is how to make a half prostration.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Physiological", "definition": "Thuộc sinh lý học", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Phà", "definition": "Tiriyaṃtaraṇa (trung), nāvātitha (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phàm", "definition": "凡. Nói chung, có ý gồm tất cả Tầm thường. Thấp kém. Cung oán ngâm khúc có câu: “Gan chẳng đá khôn đường khá chuyển, mặt phàm kia dễ đến Thiên thai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Cách", "definition": "凡骼. Dáng dấp cử chỉ tầm thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Cận", "definition": "凡近. Tầm thường nông cạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Cốt", "definition": "凡骨. Vóc dáng tầm thường, thô xấu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Dân", "definition": "凡民. Người thường, không có chức tước. Cũng như: Thường dân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Lệ", "definition": "凡例. Bài văn ở đầu cuốn sách, nói về cách biên soạn cuốn sách đó Lề lối thường tình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Nhân", "definition": "Xem Phàm Phu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phàm Nhãn", "definition": "凡眼. Con mắt tầm thường, có cái nhìn hẹp hòi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Phu", "definition": "Chữ Phạn “prthag-jana”, cựu dịch là “phàm phu”, tân dịch là “dị sinh”. Phàm Phu là người bình thường; đối với Phật pháp thì đó là hạng người trí thức còn thiển cận, chưa thấy rõ được đạo lí bốn sự thật. Phàm Phu còn bị vô minh chi phối, tâm ý khởi nhiều tà kiến, sinh nhiều phiền não; còn tạo nghiệp và theo nghiệp mà thọ quả báo, không được tự tại. Do tạo nhiều nghiệp nhân khác nhau mà phải thọ nhiều quả báo khác nhau; từ đó mà sản sinh ra nhiều loài chúng sinh khác biệt nhau, cho nên, các nhà tân dịch đã theo ý nghĩa đó mà dùng từ “dị sinh” để dịch chữ Phạn “prthag-jana”. Dị sinh cũng có nghĩa là sinh vào các loài không phải thánh nhân. Vì vậy, tất cả chúng sinh chưa bước vào bốn địa vị thánh nhân là Thanh-văn (từ quả Dự-lưu trở lên), Duyên-giác, Bồ-tát (từ Sơ-địa trở lên), và Phật, đều là phàm phu; theo đó, phàm phu gồm có sáu loài là trời, người, a-tu-la, súc-sinh, ngạ-quỉ, và địa-ngục; hay nói cách khác, tất cả hữu tình trong ba cõi sáu đường, còn trôi nổi chìm đắm trong sinh tử luân hồi, đều là phàm phu.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phàm Phu Thiền", "definition": "Bonpu zen (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phàm Phu Thập Trùng Vọng", "definition": "Mười lớp mê vọng bất giác trong thức A Lại Da của Phàm Phu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Phu Tánh", "definition": "Xem Dị Sanh Tánh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phàm Thánh", "definition": "Phàm Phu và Thánh Giả. Thánh Giả cũng gọi là Thánh Nhân, tức chỉ cho những người từ giai vị Kiến Đạo trở lên. Tiểu Thừa chỉ cho người từ Dự Lưu Hướng trở lên, Đại Thừa chỉ cho người từ Sơ Địa trở lên; còn người từ Kiến Đạo trở xuống thì gọi là Phàm Phu. Về phương diện bản chất, Phàm Phu và Thánh Giả hoàn toàn bình đẳng, không có gì khác nhau, cho nên nói Phàm Thánh Nhất Như, Phàm Thánh Bất Nhị. Trong 10 cõi mà Phật Giáo Đại Thừa chủ trương, thì cõi: Địa Ngục, Ngã Quỉ, Súc Sinh, A Tu La, Người và Trời, gọi là Lục Phàm; còn Thanh Văn, Duyên Giác, Bồ Tát và Phật, gọi là Tứ Thánh; gọi chung lại là Lục Phàm Tứ Thánh. Lục Phàm là quả báo hữu vi; Tứ Thánh là quả thánh vô vi.(xt. Phàm Phu, Thánh Nhân).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Thánh Bất Nhị", "definition": "Phàm và thánh không khác. Theo Đại thừa giáo, tất cả chúng sinh đều có Phật tính, đều có khả năng thành Phật trong tương lai. Trên ý nghĩa đó, phàm và thánh không có khác gì nhau. Hơn nữa, cũng theo Đại thừa, tất cả phiền não đều là hư huyễn không thật, chúng sinh lầm tưởng mình bị phiền não trói buộc, nhưng thật ra là không phải. Có sách nói “phàm thánh nhất thể”, nghĩa là phàm và thánh cùng một thể.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phàm Thánh Nhất Như.", "definition": "Cũng gọi Phật Phàm Nhất Thể, Phàm Thánh Bất Nhị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Tiểu", "definition": "Có 2 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Tiểu Bát Đảo", "definition": "凡小八倒 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phàm Tài", "definition": "凡才. Cái khả năng tầm thường, không nổi bật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm Tâm", "definition": "Xem Tâm Thế Gian.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phàm Tính", "definition": "Cũng gọi Phàm Phu Tính, Dị Sinh Tính. Chỉ cho tính của Phàm Phu còn vọng kiến mê lầm, chưa thấy lí Tứ Đế. Là 1 trong 24 pháp Bất Tương Ứng Hành của Tông Pháp Tướng. (xt. Dị Sinh Tính).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Túc Vạn Lí", "definition": "(帆足萬里, Hoashi Banri, 1778-1852): Nho gia, và là nhà Lý học sống vào khoảng cuối thời Giang Hộ; thông xưng là Lí Cát (里吉); tự Bằng Khanh (鵬卿); hiệu là Ngu Đình (愚亭); thân phụ là quan Gia Lão (家老) của Phiên Nhật Xuất (日出藩, Hiji-han) thuộc Phong Hậu (豐後, Bungo). Ông theo học với Hiếp Ngu Sơn (脇愚山), môn nhân của Tam Phố Mai Viên (三浦梅園); rồi sau đó làm Giáo Thọ cho trường học của Phiên này. Vào năm 1832 (Thiên Bảo [天保] 3), ông làm chức quan Gia Lão và dốc sức cải cách nền chính trị của Phiên. Ông đã từng giao du với nhóm Trung Tỉnh Trúc Sơn (中井竹山, Nakai Chikuzan), Quy Tỉnh Nam Minh (龜井南冥, Kamei Nammei), Quảng Lại Đạm Song (廣瀨淡窻, Hirose Tansō); và tư tưởng cơ bản của ông là Nho học. Ông từng lấy tư tưởng Lý Học (Vật Lý) của Tam Phố Mai Viên làm cơ sở, có chí muốn truy cho tận cùng áo nghĩa ấy và nghiên cứu các sách vở khoa học của Hòa Lan. Từ khoảng 50 tuổi, ông bắt đầu học về khoa học tự nhiên của phương Tây, và viết các tác phẩm Cùng Lí Thông (窮理通), Y Học Khải Mông (醫學啟蒙), v.v. Các trước tác khác có Đông Tiềm Phu Luận (東潛夫論), Nhập Học Tân Luận (入學新論), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phàm Tăng", "definition": "I.Phàm Tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Tập", "definition": "Chỉ cho những hành động phải trái, thiện ác mà Phàm Phu tập quen.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàm Tục", "definition": "凡俗. Tầm thường thấp kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàm phu hoàn toàn không có giác, hàng Nhị Thừa Thanh Văn, Duyên Giác chỉ có tự giác, Bồ Tát tuy có thể tự giác, giác tha, nhưng giác hạnh chưa tròn đủ, chỉ có Phật là tự giác, giác tha và giác hạnh viên mãn mà thôi.[X. Kinh Đại Bát Niết Bàn Q.18 (bản Bắc)]. (xt. Phật).", "definition": "III.Giác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phàn", "definition": "砏. Tiếng động Tiếng ầm ầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàn Bát", "definition": "砏汃. Tiếng nước róc rách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàn Nàn", "definition": "Ujjhāyati (u + jhe +a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phàn Thạch", "definition": "礬石. Phèn chua. Gọi tắt là Phàn (phèn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàn Thổ", "definition": "礬土. Đất có phèn Đất sét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phàn Trạch Đạt", "definition": "(樊澤達, ?-?): tự là Côn Lai (昆來), người vùng Nghi Tân (宜賓). Năm Ất Sửu (1685) đời vua Khang Hy (康熙, tại vị 1662-1722), ông đỗ Tiến Sĩ, từng làm quan chức Thị Độc (侍讀), chuyên biên tập sử sách. trước tác của ông có Kính Nghiệp Đường Tập (敬業堂集)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phá", "definition": "Chữ “phá” được dùng trong các bộ Luận vốn là một thuật ngữ thuộc Nhân Minh Luận, có nghĩa là đả kích, bài xích, đánh đổ những lập luận sai lầm, không đúng chân lí trong các luận thuyết ngoại đạo; chữ “phá” trong các từ “phá tà”, “phá chấp”, “phá tướng” v.v... là nằm trong ý nghĩa này. Trong Luật, chữ “phá” có nghĩa là không tuân giữ giới luật, không thi hành đúng qui trình đã định, như các từ “phá giới”, “phá trai”, “phá hạ”; cũng có nghĩa là làm cho sứt mẻ, làm mất sự toàn vẹn, như câu “phá hòa hợp tăng”, v.v... Trong Kinh, chữ này được dùng với ý nghĩa phỉ báng, hủy hoại, diệt trừ, hàng phục, như các từ “phá pháp” (phỉ báng chánh pháp), “phá hữu” (chấm dứt sinh tử), “phá tội nghiệp” (dứt trừ tội chướng), “phá ác, phá hoặc, phá vô minh” (tiêu trừ phiền não, vô minh), “phá ma quân” (hàng phục ma quân), “phá địa ngục” (thoát li cảnh giới khổ đau), v.v... Trong Thiền Tông, chữ “phá” còn được dùng với những ý nghĩa đặc biệt, như nói “phá nhan vi tiếu” (đổi sắc mặt nghiêm nghị mà mỉm cười - chỉ cho trường hợp tôn giả Đại Ca Diếp mỉm cười trong pháp hội Linh-sơn khi đức Thế Tôn đưa cành hoa lên trước đại chúng), “phá môn” (chỉ cho người đệ tử bị thầy đuổi ra khỏi chùa), “phá phàm phu” (chỉ cho thiền sinh tâm tánh quá ám độn), v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phá Am Tổ Tiên", "definition": "(破庵祖先, Haan Sosen, 1136-1211): vị tăng của Phái Dương Kì thuộc Lâm Tế Tông Trung Quốc, hiệu là Phá Am (破庵), người Quảng An (廣安, Tỉnh Tứ Xuyên), họ là Vương (王). Ông theo xuất gia với Đức Tường (德祥) ở La Hán Viện (羅漢院), rồi đi tham học các nơi, sau đến tham vấn Mật Am Hàm Kiệt (密庵咸傑) ở Ô Cự Sơn (烏巨山) và kế thừa dòng pháp của vị nầy. Sau ông theo Mật Am chuyển đến Tương Sơn (蔣山), rồi từ giã thầy mà quay về đất Thục. Thể theo lời thỉnh cầu của Thượng Thư Dương Công (楊公), ông đến trú trì Hàm Bình Thiền Viện (咸平禪 院) ở Ngọa Long Sơn (臥龍山) thuộc Quỳ Châu (夔州, Tỉnh Tứ Xuyên). Sau đó, ông còn sống qua một số nơi khác như Tú Phong Thiền Viện (秀 峰 禪 院) ở Phủ Bình Giang (平江府, Tỉnh Giang Tô), Quảng Thọ Huệ Vân Thiền Viện (廣壽慧雲禪院) ở Phủ Lâm An (臨安府, Tỉnh Triết Giang), Phước Trăn Thiền Viện (福臻禪院) ở Phủ Bình Giang, Phụng Sơn Tư Phước Thiền Tự (鳳山資福禪寺) ở Hồ Châu (湖州, Tỉnh Triết Giang). Vào ngày mồng 9 tháng 6 năm thứ 4 niên hiệu Gia Định (嘉定), ông thị tịch, hưởng thọ 76 tuổi đời và 49 hạ lạp. Trước tác để lại của ông có Phá Am Hòa Thượng Ngữ Lục (破菴和尚語錄) 1 quyển, Phá Am Tiên Thiền Sư Ngữ Yếu (破菴 先禪師語要) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phá Am Tổ Tiên Thiền Sư Ngữ Lục", "definition": "破 庵 祖 先 禪 師 語 錄. Còn gọi: Phá Am Hòa Thượng Ngữ Lục. Ngữ Lục, 1 quyển, do Phá AmTổ Tiên soạn vào đời Tống, nhóm các ông Viên Chiếu… biên tập, này được xếp vào Tục Tạng Kinh tập 121. Nội dung gồm những Ngữ Lục của Thiền Sư Tổ Tiên khi trụ các thiền viện:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phá Bản Tham", "definition": "Là cái cửa ải đầu tiên mà các thiền giả phải vượt qua. Theo Thiền Tông, có ba loại cảnh giới tham thiền từ thấp lên cao, mà hành giả Thiền môn phải thấu suốt, thuật ngữ Thiền học gọi là “tam quan” (ba cửa ải).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phá Chính Mệnh", "definition": "Chỉ cho tà mệnh, nghĩa là mưu sinh trái với chính pháp của Phật và với luân lí đạo đức thế gian. [X. Tứ Phần Luật San Phồn Bổ Khuyết Hành Sự Sao Q.thượng, phần 2]. (xt. Tà Mệnh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Chấp", "definition": "Chấp là cố chấp, mê chấp. Không đúng mà chấp là đúng, không thật mà chấp là thật, không mà chấp là sướng, vô ngã nhưng chấp là có cái ta v.v.. Tât cả những cái đó đều là mê chấp. Nghĩa là vì ngu si mê lầm mà mê chấp, rồi lại khăng khăng ngoan cố tự cho mình là đúng, đó là cố chấp. Người có trí, dùng trí tuệ và tài thuyết phục giảng giải cho người mê thấy rõ phải trái, thật giả.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phá Cách", "definition": "破格. Không theo lề lối sẵn có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Diệt", "definition": "破滅. Làm cho tan nát, mất đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Gia", "definition": "破家. Nhà cửa tan nát Làm tan nát cửa nhà. Đoạn trường tân thanh có câu: “Khéo oan gia của phá gia, còn ai dám chứa vào nhà nữa đây”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Giới", "definition": "Duhśīla (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phá Giới Ngũ Quá", "definition": "破戒五過 (Tứ Phần Luật)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phá Hoại", "definition": "破壞. Làm cho hư hỏng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Huỷ", "definition": "破毁. Làm hư, làm mất đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Hòa Hợp Tăng", "definition": "Chúng tăng hòa hợp để tu tập và thực hiện các Phật Sự. Nếu dùng thủ đoạn để li gián, khiến cho họ phải phân tán, rối loạn mà bỏ phế Phật Sự, hoặc cưỡng chiếm chùa miếu, áp bức họ phải hoàn tục, đều là phá sự hòa hợp của tăng đoàn. Vì cắt đứt tuệ mạng của người, dứt tuyệt duyên lành giải thoát của người, cho nên tội rất nặng, và quả báo cũng cực kì thảm khốc.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phá Hạ", "definition": "I.Phá Hạ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Hủy", "definition": "Apacināti (apa + ci + nā ), haññati (han + ya), nāseti (nas + e), nāsana (nam), lujjati (luj + ya), padhaṃseti (pa + dhaṃs + e), upacchindati (upa + chid + m + a), vinassati (vi + nas + ya), vyantībhāva (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phá Hữu", "definition": "Phá vòng luân hồi sinh tử trong 3 cõi.“Hữu” chỉ cho Tam hữu hoặc Nhị thập ngũ hữu. Phá hữu là phá sự sống chết trong Tam hữu hoặc Nhị thập ngũ hữu(tức 3 cõi). Như Lai vì mục đích phá vòng sinh tử trong 3 cõi mà ra đời, nên Ngài cũng được tôn xưng là Phá Hữu Pháp Vương. [X. Phẩm Dược Thảo Dụ trong Kinh Pháp Hoa; Kinh Tâm Địa Quán Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Hữu Pháp Vương", "definition": "Chỉ cho Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Không", "definition": "破空. Làm vỡ khoảng không, ý nói từ trên trời rơi rớt xuống, rơi từ cao xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Kiến", "definition": "Dùng Tà Kiến phá hoại Chính Kiến. Ngoại đạo dùng 62 thứ Tà Kiến để phá hoại Chính Kiến của Đức Phật. Phá kiến cũng tức là hủy báng Phật Pháp. Trong Phật Pháp, Phá Kiến là tội rất nặng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Kính", "definition": "破鏡. Gương vỡ, chỉ sự tan vỡ của vợ chồng. Td: Phá kinh trùng viên (gương vỡ lại tròn, chỉ vợ chồng xum họp nhau sau thời gian chia cách) “Bây giờ gương vỡ lại lành, khuôn thiêng lừa lọc, đã đành có nơi” (Kiều). Sách Thần Dị kí: Xưa có hai vợ chồng lúc biệt li đập vỡ kính, mỗi người giữ một nửa. Sau người vợ ngoại tình, nửa mảnh gương liền hoá con chim khách đến trước mặt người chồng. Nên về sau người ta đúc gương hay khắc hình chim khách ở phía sau (Ngày xưa gương bắng đồng đánh cho láng để soi mặt). Lại có một điển tích trong cổ kim thi thoại: Từ Đức Ngôn đời Trần, kết duyên với Lạc Xương Công Chúa. Nhà Trần suy sụp, Đức Ngôn bàn với vợ: “Nước rồi sẽ mất vào những tay của kẻ cường hào”. Ông liền đập vỡ kính làm đôi, chia cho công chúa giữ một nửa và hẹn ngày sau cứ ngày rằm tháng giêng đem gương ra bán giữa đô thị. Kịp đến lúc nhà Trần mất, Công chúa vào tay Dương Tố. Đức Ngôn đến kinh thấy có tên đầy tớ bán nửa cái gương bèn lấy gương của mình ra hiệp lại làm một và đề bài thi rằng: Kính dự nhân câu khứ, kính quy nhân vị quy, vô phục Thường Nga ảnh, không lưu minh nguyệt huy (Gương và người ùng đi, người về gương không về, ảnh Hằng nga đâu nữa, chỉ còn trăng chiếu thôi). Lạc Xương được thơ khóc lóc thảm thiết bỏ cả ăn uống. Tố biết câu chuyện gọi Đức Ngôn đến để giao vợ lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Liệt", "definition": "破裂. Rách ra, nức ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Lãng", "definition": "破浪. Rẽ sóng, ý nói thuyền đi rất mau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Lạc Tăng", "definition": "Chỉ cho vị tăng phá hoại giới luật bị đọa lạc, vì đã mất hết tự giác, giống như cửa nẻo bị hư hỏng nên mất hết gia sản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Lập", "definition": "Cũng gọi Già Chiếu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Lệ", "definition": "破例. Bỏ lề lối cũ, không theo nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Ma", "definition": "Phạm: Màra (-sainya)-pramardana; Màra-pramathana.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Môn", "definition": "破門. Chỉ tu sĩ hoàn tục, không tu nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Nhan Vi Tiếu", "definition": "Nụ cười mỉm. Trong hội Linh Sơn, đứcPhật cầm cành hoa Kim Ba La đưa cao lên để dạy Đại Chúng, không ai hiểu được ý Phật muốn nói gì, chỉ có Tôn Giả Ma Ha Ca Diếp mỉm cười, vì thế Đức Thế Tôn đem “Chính Pháp Nhãn Tạng, Niết Bàn Diệu Tâm” truyền cho ngài Ma Ha Ca Diếp. (xt. Niêm Hoa Vi Tiếu).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Phàm Phu", "definition": "Chỉ cho kẻ Phàm Phu căn tính ngu độn, kém cỏi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Pháp", "definition": "Đồng nghĩa: Báng Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Pháp Biến", "definition": "Cũng gọi Phá Chư Pháp Biến, Năng Phá Pháp Biến, Phá Biến.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Pháp Luân Tăng", "definition": "Lập ra tà pháp để chia rẽ chúng tăng đang sống với nhau 1 cách hòa hợp, đoàn kết, 1 trong 2 loại Phá hòa hợp tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Qua", "definition": "破瓜. Chữ Qua vỡ ra, thành hai chữ Bát 八, hai chữ Bát cộng lại là 16, chỉ người con gái 16 tuổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Rối", "definition": "Vipallattha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phá Sơn Tổ Sư", "definition": "破 山 祖 師. Thiền tăng Hải Minh đời Thanh ở núi Phá Đầu nên người đời gọi là Phá Sơn Hải Minh, Phá Sơn Tổ sư. X. Hải Minh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phá Sư Thập Đức", "definition": "法師十德 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phá Sản", "definition": "破產. Của cải tan nát. Vỡ nợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Tam Muội Da", "definition": "Tội báng pháp, 1 trong 3 loại tội nặng do Mật Tông chế định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tan", "definition": "Bhijjati (bhid + ya), bhijjana (trung), nāsana (nam), nijjareti (ni + jar + e), nāsana (nam), nijjareti (ni + jar + e), nimmathati (ni + math + a), nirodheti (ni + rudh + e), sañchindati (sam + chid + ṃ + a), samucchiṇdati (saṃ + chid + ṃ + a), uddhaṃseti (u + dhaṃs + e), vināseti (vi + nas + e), virājeti (vi + rāj + e), vidhamati (vi + dhaṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phá Thai", "definition": "Gabbhapātaṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phá Thân", "definition": "破身. Chỉ người con gái giao hợp lần đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Toái", "definition": "破碎. Vỡ vụn ra, thành nhiều mảnh vụn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Trai", "definition": "Phá hủy giới Trai.Trong 8 giới Trai thì giới không ăn quá ngọ là chính, nếu người đã thụ giới này mà vi phạm thì gọi là Phá Trai.Tội phá trai chắc chắn sẽ rơi vào địa ngục, hoặc phải đọa làm loài rồng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Trinh", "definition": "破貞. Làm vỡ sự trong trắng, chỉ sự ăn nằm với một người đang còn là con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Trúc", "definition": "破竹. Tre nứt vỡ ra Chẻ tre, chỉ việc làm dễ dàng Chỉ thế mạnh mẽ, tới đâu thắng đó. “Thứa cơ trúc chẻ ngói tan” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Trận", "definition": "破陣. Làm tan vỡ sự sắp xếp của binh đội giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Tà Hiển Chính", "definition": "Cũng gọi Phá Tà Thân Chính, Tồi Tà Hiển Chính, Phá Hiển, Phá Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tà Luận", "definition": "Tác phẩm, 2 quyển, do ngài Pháp Luân soạn vào đời Đường, được thu vào Đại Chính Tạng tập 52.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tán", "definition": "破散. Vỡ tan Tan tác ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Táo Đọa", "definition": "Po tsao to (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phá Tình", "definition": "Đồng nghĩa: Phá Tà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tích Hiển Bản", "definition": "Phá Thùy Tích ở Già Da để hiển bày bản địa từ lâu xa, 1 trong 10 thứ Hiển Bản. [X. Pháp Hoa Huyền Nghĩa Q.9].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tăng", "definition": "Cg = Phá hòa hiệp tăng. Đối với tăng chúng, một điều rất quan trọng là giữ gìn đoàn kết tương thân tương ái, như vậy mới đảm bảo tinh thần tu học tấn tới. Đó là tinh thần lục hòa (sáu hòa hợp), cụ thể là cùng giải lý lẽ với nhau (kiến hòa đồng giải), không tranh cãi nhau (khẩu hòa vô tranh), cùng nhau gìn giữ giới luật (giới hòa đồng tu), có lợi gì cùng chia với nhau hưởng (lợi hòa đồng quân), cùng ăn ở một nơi với nhau (thân hòa đồng cư) và cuối cùng là tâm ý vui vẻ chan hòa cùng nhau (ý hòa đồng duyệt). Nếu có người nào trong tăng chúng nói lời chia rẽ, làm mất đoàn kết, là phạm tội phá hòa hợp tăng, một tội rất nặng, nếu không chịu ăn năng hối lỗi thì bị đuổi ra khỏi Tăng chúng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phá Tăng Kiền Độ", "definition": "Pàli: Saígha-bheda-khandaka. Cũng gọi Điều Đạt Sự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tướng Tam Muội", "definition": "Cũng gọi Vô Tướng Tam Muội.Tam Muội Quán xét hết thảy các pháp đều vô tướng, đều như mộng huyễn, khôngthể nắm bắt, không thể chấp trước, là 1 trong 108 Tam Muội.[X. Luận Đại Trí Độ Q.47].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Tặc", "definition": "破賊. Đánh tan quân giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Tặc Quán Tự Tại", "definition": "Cũng gọi Kích Sao Quan Âm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Y", "definition": "破衣. Cái áo rách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Yết Ma Tăng", "definition": "Cùng ở chung 1 khu vực kết giới mà tự ý làm pháp yết ma Bố Tát Thuyết Giới riêng biệt, phá hoại sự hòa hợp của chúng tăng. Đây là 1 trong 2 thứ phá hòa hợp tăng và là 1 trong 5 tội nghịch.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Ác Nghiệp Đà La Ni", "definition": "Thần chú phá trừ các nghiệp ác, 1 trong 3 loại Đà La Ni.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Ám Mãn Nguyên Phá", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Ám Mãn Nguyện", "definition": "Năng lực phá tối tăm, đáp ứng đầy đủcác nguyện vọng. Là tính chất của danh hiệu Đức Phật A Di Đà, có năng lực phá tan vô minh và đáp ứng đầy đủ nguyện vọng của chúng sinh. [X. Luận Vãng Sinh Q.hạ].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Án", "definition": "破案. Bãi bỏ việc xét xử về một vụ kiện Tìm ra được sự thật về một vụ phạm pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Điện", "definition": "破綻. Đường rách Đường khâu bị sút chỉ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Đàn Tác Pháp", "definition": "Cũng gọi Phá Đàn Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Đề", "definition": "破題. Mở đầu, giới thiệu điều muốn nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phá Địa Ngục", "definition": "Nhờ vào Phật lực và pháp lực mà thoát khỏi được cái khổ địa ngục, gọi là Phá Địa Ngục. Lời văn xướng tụng phá địa ngục, gọi là Phá Địa Ngục Văn. Người thâm tín Tam Bảo Thì được sinh vào đường thiện; người không những không tin mà còn phỉ báng, phá hoại Phật Pháp thì rơi vào đường ác; thuyết phá địa ngục chính đã xuất phát từ quan niệm ấy. Trong các loại Kinh Bản Sinh và Kinh Thí Dụ thường nói rằng: “Khi bị sa vào thành ngục La Sát hoặc vào địa ngục, nếu dốc lòng xưng niệm “Na mô Phật” thì liền thoát nạn”. [X. Từ Đồng Nữ Duyên trong Kinh Tạp Bảo Tạng Q.1; Phẩm Dạ Ma Thiên Cung trong Kinh Hoa Nghiêm Q.19 (bản dịch mới); Phật Tổ Thống Kỉ Q.33].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Địa Ngục Pháp", "definition": "Pháp môn tu trì nhờ vào công năng bản thệ, ấn khế, Chân Ngôn, Đà La Ni... của Phật và Bồ Tát để cứu giúp người chết thoát khỏi các khổ địa ngục. Theo các kinh và Nghi Quĩ thì các pháp môn ấy gồm có: Quang Minh Chân Ngôn Phá Địa Ngục Pháp, Phật Đính Tôn Thắng Đà La Ni Phá Địa Ngục Pháp, Bảo Khiếp Ấn Đà La Ni Phá Địa Ngục Pháp, Đại Tùy Cầu Đà La Ni Phá Địa Ngục Pháp, Địa Tạng Bồ Tát Phá Địa Ngục Pháp v.v...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Địa Ngục Văn", "definition": "Chỉ cho những bài văn đọc tụng nương vào pháp lực nguyện cầu thoát khỏi khổ nạn địa ngục. Những bài văn này chủ yếu được rút ra từ các kinh như:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Địa Ngục Ấn", "definition": "Cũng gọi Đa La Bồ Tát Phá Địa Ngục Ấn. Chỉ cho ấn khế có năng lực mở toang cửa địa ngục và khiến chúng sinh chịu khổ được giải thoát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phá Đởm", "definition": "破膽. Vỡ mật, ý nói sợ lắm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác", "definition": "圤. Lối viết giản dị của chữ Phác 墣.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Chuyết", "definition": "樸拙. Thật thà vụng về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Dã", "definition": "樸野. Thật thà quê mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Hoạ", "definition": "樸畫. Vẽ sơ lúc đầu cho thành hình, chưa sửa sang tô đểm. Đoạn trường tân thanh có câu: “Sinh rằng phác hoạ vừa rồi, phẩm để xin một vài lời thêm hoa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Họa", "definition": "Abhilakkheti (abhi + lakkh + e), ālikhati (ā + likh +a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phác Học", "definition": "樸學. Sự học hỏi thành thật, không vì lợi danh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Lậu", "definition": "樸陋. Thật thà quê kệch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Mã", "definition": "樸馬. Ngựa chưa được huấn luyện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Ngọc", "definition": "樸玉. Viên ngọc chưa được mài giũa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Thuần", "definition": "樸淳. Thật thà giản dị, không gian dối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Thực", "definition": "樸實. Thành thật, không màu mè giả dối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Trung", "definition": "樸忠. Thành thật hết lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Trọng", "definition": "樸重. Chỉ tính tình thành thật, giữ lẽ phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Trực", "definition": "樸直. Thành trực ngay thẳng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Tố", "definition": "樸素. Thật thà, không trau chuốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Địa", "definition": "撲地. Đầy đất, chỗ nào cũng có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Độn", "definition": "樸鈍. Thật thà chậm chạp, chậm hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phác Ẩn", "definition": "樸 隱. Hiệu của Thiền tăng Nguyên Tịnh đời cuối Nguyên đầu Minh. X. Nguyên Tịnh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phách", "definition": "怕. Bình thản. Điềm tĩnh Một âm khác là Phạ. Xem Phạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Bản", "definition": "拍板. Miếng gỗ dùng để gõ nhịp khi đàn hát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Chưởng", "definition": "拍掌. Vỗ tay. Vỗ hai tay vào nhau, tỏ ý hoan nghênh, hoặc để làm nhịp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Mại", "definition": "拍賣. Bán đấu giá (trong lối bán này, khi có người mua trả giá cao nhất, thì người bán dùng một cái búa gõ xuống mặt bàn cho mọi người biết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Thủ", "definition": "拍手. Như Phách chưởng 拍掌.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Tà", "definition": "闢邪. Bác bỏ, chỉ trích điều sai quấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Tích", "definition": "拍 脊. Đánh thẳng vào sống lưng. Chương Trường Khánh Huệ Lăng Thiền Sư trong CĐTĐL q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phách Án", "definition": "拍案. Vỗ bàn, đập bàn, tỏ ý giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phách Đầu", "definition": "劈頭. Mở đầu. Bắt đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phái", "definition": "𠂢. Như chữ Phái 派.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phái Biệt", "definition": "派別. Dòng nước chảy riêng ra. Nhánh sông Chia làm nhiều dòng, nhiều ngành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phái Diệu Tâm Tự", "definition": "(妙心寺派, Myōshinji-ha): tên gọi của một tông phái trong 14 phái của Lâm Tế Tông vốn lấy Chánh Pháp Sơn Diệu Tâm Tự (正法山妙心寺) làm ngôi chùa trung tâm. Theo sắc nguyện của Hoa Viên Thượng Hoàng (花園上皇), ngôi chùa này được xây dựng trên nền tòa Ly Cung của Thượng Hoàng, và Quan Sơn Huệ Huyền (關山慧玄), pháp hệ của Đại Đăng Quốc Sư (大燈國師), là vị Tổ khai sơn chùa cũng như Tổ của dòng phái này. Thời kỳ khai sáng của chùa này cũng chưa rõ lắm, nhưng được xem như là trước năm 1342. Trong vụ Loạn Ứng Nhân, Diệu Tâm Tự bị cháy tan tành, sau được Tuyết Giang Tông Thâm (雪江宗深) phục hưng lại, và nhờ có sự quy sùng của mấy vị Võ Tướng thời Chiến Quốc mà 4 người đệ tử thuộc pháp từ của ông mới có thể phát triển phái mình về các địa phương. Đến khoảng thời đại An Thổ Đào Sơn, từ phái này xuất hiện Bạch Ẩn Huệ Hạc (白隱慧鶴), và chính vị này đã làm cho Tông phong của mình phát triển cực độ. Từ đó, trong Lâm Tế Tông, hết thảy đều bị dòng pháp hệ của Bạch Ẩn chiếm lãnh cả. Đến năm 1872, trải qua sự hợp nhất của 3 phái trong Lâm Tế Tông, rồi sau đó đến 9 phái phân lập, khi ấy Diệu Tâm Tự độc lập thành một phái riêng, và đến năm 1952 thì được chính thức công nhận là một tông phái rõ ràng. Hiện phái này là phái lớn nhất của Lâm Tế Tông, trên toàn quốc có đến hơn 3400 ngôi chùa con trực thuộc, chia thành 27 giáo khu, và có luôn cả trường Đại Học Hoa Viên (花園大學, Hanazono Daigaku).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phái Huyễn Trú", "definition": "(幻住派, Genjū-ha): tên gọi chung của những người kế thừa pháp hệ của Trung Phong Minh Bổn (中峰明本) thuộc Phái Phá Am của Lâm Tế Tông. Viễn Khê Tổ Hùng (遠溪祖雄), Phục Am Tông Dĩ (復菴宗已), Cổ Tiên Ấn Nguyên (古先印元), Vô Ẩn Nguyên Hối (無隱元晦), Nghiệp Hải Bổn Tịnh (業海本淨), Minh Tẩu Tề Triết (明叟齊哲), Đại Chuyết Tổ Năng (大拙祖能), v.v., là những nhân vật thuộc phái này. Người cháu đời thứ 4 của Cổ Tiên là Nguyệt Chu Thọ Quế (月舟壽桂) ở Kiến Nhân Tự (建仁寺, Kennin-ji). Đặc sắc của phái này là có tính cách ẩn dật của vị khai Tổ Trung Phong, kế thừa tư tưởng Thiền Tịnh Nhất Trí. Ban đầu phái này tách lìa với Phái Ngũ Sơn mà hoạt động giáo hóa ở các địa phương, nhưng đến dòng pháp hệ của Viễn Khê thì có Nhất Hoa Thạc Điền (一華碩田) xuất hiện, làm cho Phái Huyễn Trú có thể tiến về thâm nhập vào năm ngôi chùa lớn ở kinh đô; cho nên, tại các chùa như Tam Thánh (三聖), Kiến Nhân (建仁), Nam Thiền (南禪), Kiến Trường (建長), Viên Giác (圓覺), v.v., đều có chân của phái này, và cho đến thời kỳ Giang Hộ thì phái này đã phát triển rất rực rỡ.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phái Khiển", "definition": "派遣. Sai khiến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phái Không Nhận Không Cho", "definition": "(不受不施派, Fujufuse-ha): tên gọi một giáo phái của Nhật Liên Tông, vị Tổ của phái này là Phật Tánh Viện Nhật Áo (佛性院日奥) ở Diệu Giác Tự (妙覺寺). Không Nhận (不受, bất thọ) ở đây có nghĩa là không thọ nhận sự cúng dường của những người chưa tin vào Pháp Hoa hay báng bổ giáo pháp. Không Cho (不施, bất thí) là không cúng dường cho chư tăng của các tông phái khác vốn khinh báng Nhật Liên Tông. Từ thời Nhật Liên trở về sau, trong giáo đoàn Nhật Liên Tông thời trung đại có chia ra hai lập trường rõ rệt, nghĩa là quán triệt toàn bộ không thọ nhận và thọ nhận với trường hợp riêng đối với sự cúng dường của những nhà có quyền lực thuộc tầng lớp Võ Gia hay Vương Hầu. Với hai lập trường như vậy, ban đầu xảy ra sự đối lập trong giáo đoàn là nhân cuộc lễ tổ chức cúng dường cho ngàn vị tăng do Tướng Quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi) tổ chức tại Phương Quảng Tự (方廣寺) thuộc kinh đô Kyoto. Nhật Áo thì giữ vững lập trường của mình, không đến tham dự và rời khỏi Diệu Giác Tự. Mặt khác, nhóm Nhật Trùng (日重), Nhật Càn (日乾) thì không nhận ngoài trường hợp cúng dường của các nhà công tướng, nên đã đến dự. Vào năm 1599, Tướng Quân Đức Xuyên Gia Khang (德川家康, Tokugawa Ieyasu) cho tổ chức cuộc đối luận giữa hai Phái Thọ Nhận của Nhật Thiệu (日紹) thuộc Diệu Hiển Tự (妙顯寺) và Phái Không Nhận của Nhật Áo tại Thành Đại Phản (大阪城, Ōsaka-jō), và ngay chính tại đây, Nhật Áo bị xử tội cho ngựa kéo phanh thây. Từ tiền lệ này, vào năm 1630, tại Thành Giang Hộ (江戸城, Edo-jō) cũng diễn ra cuộc đối luận giữa hai Phái Thân Diên (身延派) thuộc Phái Thọ Nhận và Phái Trì Thượng (池上派) thuộc Phái Không Thọ Nhận; và nhóm Nhật Thọ (日樹) của phái sau đã bị xử tội đày ải đi xứ xa. Sự phân liệt giữa hai phái này ở các vùng Quan Tây (關西, Kansai) và Quan Đông (關東, Kantō) cũng tượng tợ như sự phân liệt thành hai phe đông và tây của Bổn Nguyện Tự (本願寺, Hongan-ji) bên Tịnh Độ Tông vậy. Vào năm 1655, Chính Quyền Mạc Phủ Giang Hộ giao phó dấu ấn đỏ quy định lãnh vức của chùa; nên càng gây khó khăn nhiều trong việc cúng dường. Vào tháng 4 bốn năm sau, Chính Quyền Mạc Phủ lại ra lệnh cấm Phái Không Nhận Không Cho xây dựng chùa. Chính nhóm Nhật Giảng (日講) và Nhật Thuật (日述) phản đối điều này, nên bị đày ải. Mãi đến năm 1941, hai phái mới hợp nhất lại với nhau, lấy tên là Bổn Hóa Chánh Tông (本化正宗); nhưng 5 năm sau thì lại phân ly, Phái Không Nhận Không Cho thì đổi tên thành Diệu Pháp Hoa Tông (妙法華宗), rồi 6 năm sau thì lấy lại tên cũ", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phái Mũ Đỏ", "definition": "Dugpas (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phái Ngũ Sơn", "definition": "(五山派, Gozan-ha): trong Thiền Tông dưới thời đại Liêm Thương có các tông phái mà do những người đến triều đình Nhật mang vào từ Trung Hoa Đại Lục, và có những tông phái mà do những người đến Nhật truyền thừa vào. Những tông phái được mang vào do nhóm người đến triều đình Nhật gồm các phái của Lâm Tế Tông như Phái Đại Giác (大覺派) do Lan Khê Đạo Long (蘭溪道隆) làm tổ, Phái Phật Quang (佛光派) do Vô Học Tổ Nguyên (無學祖元) làm tổ, Phái Phật Nguyên (佛源派) do Đại Hưu Chánh Niệm (大休正念) làm tổ, Phái Nhất Sơn (一山) do Nhất Sơn Nhất Ninh (一山一寧) làm tổ, Phái Đại Giám (大鑑派) do Thanh Chuyết Chánh Trừng (清拙正澄) làm tổ, và Phái Cổ Lâm (古林派) do Trúc Tiên Phạn Tiên (竺仙梵僊) làm tổ, v.v.; cọng thêm đó còn có Phái Tông Hoằng (宗宏派) của Tào Động Tông do Đông Minh Huệ Nhật (東明慧日) làm tổ. Mặt khác, những tông phái do nhóm người sang đến Nhật truyền vào gồm các phái của Lâm Tế Tông như Phái Hoàng Long (黃龍派) do Minh Am Vinh Tây (明菴榮西) làm tổ, Phái Thánh Nhất (聖一派) của Viên Nhĩ Biện Viên (圓爾辨圓), Phái Pháp Đăng (法燈派) của Vô Bổn Giác Tâm (無本覺心), Phái Đại Ứng (大應派) của Nam Phố Thiệu Minh , v.v.; và phái của Tào Động Tông do Đạo Nguyên (道元) sáng lập. Đến thời đại Thất Đinh, trong số các phái như đã trình bày ở trên, trừ phái của Vĩnh Bình Tự (永平寺, Eihei-ji) thuộc Tào Động Tông và Phái Đại Ứng của Lâm Tế Tông ra, các phái Thiền Tông được sự bảo hộ và thống chế của chính quyền Mạc Phủ Thất Đinh, lấy những ngôi chùa quan làm cứ điểm hành đạo, phát triển rộng khắp toàn quốc, và cuối thời đại Thất Đinh thì trở thành chủ lưu của Thiền mà phồn vinh cực độ. Phái Ngũ Sơn là tiếng gọi tổng xưng của các phái Thiền Tông, hay còn gọi là Ngũ Sơn Tùng Lâm (五山叢林).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phái Trung Quán", "definition": "Dbu ma pa (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phái Tùng Nguyên", "definition": "(松源派, Shōgen-ba): tên một phái kết hợp dòng Thiền của Phái Dương Kì (楊岐派) thuộc Tông Lâm Tế Trung Quốc, trực thuộc pháp hệ của Hổ Kheo Thiệu Long (虎丘紹隆). Tùng Nguyên Sùng Nhạc (松源崇岳), người kế thừa dòng pháp của Mật Am Hàm Kiệt (密庵咸傑), là vị Tổ khai sáng phái này. Môn hạ của Sùng Nhạc có hai vị Tăng kiệt xuất là Vô Minh Huệ Tánh (無明慧性), Vận Am Phổ Nham (運庵普巖); thêm vào đó, còn có Diệt Ông Văn Lễ (滅翁文禮), Tuyết Đậu Trọng Khiêm (雪竇仲謙), Yểm Am Thiện Khai (掩庵善開), v.v. Hơn nữa, sau này môn hạ của Huệ Tánh lại có Lan Khê Đạo Long (蘭溪道隆), rồi môn hạ của Phổ Nham có Hư Đường Trí Ngu (虛堂智愚) xuất hiện. Hư Đường là người dẩn đầu để tạo ra những nhân vật quan trọng của Lâm Tế Tông Nhật Bản như Nam Phố Thiệu Minh (南浦紹明), Tông Phong Diệu Siêu (宗峰妙超), Quan Sơn Huệ Huyền (關山慧玄), v.v. Và những Thiền Tăng nổi tiếng như Đại Hưu Chánh Niệm (大休正念), Vô Tượng Tĩnh Chiếu (無象靜照), Tây Giản Tử Đàm (西礀子曇), Nguyệt Lâm Đạo Kiểu (月林道皎), Thạch Thất Thiện Cửu (石室善玖), Trúc Tiên Phạn Tiên (竺仙梵僊), Minh Cực Sở Tuấn (明極楚俊), Ngu Trung Châu Cập (愚中周及), v.v., đều xuất thân từ phái này cả", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phái Viên", "definition": "派員. Người được sai đi làm việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phái Đại Toàn Thiện", "definition": "Adi Yogā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phán", "definition": "伴. Phán hoán伴奐: Chỉ ý tưởng lớn mà đẹp, hoặc lời văn phóng túng mà có văn chương Một âm là Bạn. Xem Bạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Bản Hạnh Nam", "definition": "Phán Bản Hạnh Nam (1899-1973).Học giả Phật Giáo Nhật Bản, người huyện Cương Sơn, Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phán Bằng Thức", "definition": "Chứng minh thư do nhà nước chứng nhận và cấp phát cho tăng sĩ. Như Độ Điệp là giấy Chứng minh do Chính phủ cấp phát cho vị tăng để chứng nhận vị ấy đã xuất gia được độ. Còn Miễn Đinh Do (cũng gọi Miễn Đinh Sao) là Chứng minh thư do chính quyền địa phương cấp phát cho những người đã nộp tiền miễn đinh và phê chuẩn cho được miễn trừ quân dịch. [X. điều Thánh Tiết trong Sắc Tu Bách Trượng Thanh Qui Q.1; điều Quải Đáp trong Thiền Uyển Thanh Qui Q.1]. (xt. Độ Điệp).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phán Chính", "definition": "判正. Xét định điều phải trái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Duệ", "definition": "判袂. Cắt vạt áo, ý nói chia lìa nhau, chia tay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Hãn", "definition": "泮汗. Mênh mông không bờ bến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Hồn Hương", "definition": "Hương làm cho hồn trở về. Tên của 1 loại hương, mùi thơm của nó có năng lực làm cho người chết sống lại, vì thế gọi là Phản Hồn Hương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phán Hợp", "definition": "牉合. Mỗi bên một nửa mà họp lại thành một, chỉ sự kết hợp vợ chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Lệ", "definition": "判例. Đường lối xét đoán mà toà án đã dùng trong những vụ xét xử trước, nay cứ theo đó mà xét xử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Ngữ", "definition": "判語. Lời xét định của quan toà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Quan", "definition": "(判官): còn gọi Quỷ Phán Quan (鬼判官). Trong Thập Điện Diêm La (十殿閻羅), ở hai bên của vua Diêm La tại mỗi điện đều có một vị Phán Quan phụ tá xử lý phiên tra công việc các vong hồn và chịu trách nhiệm thẩm tra các u hồn được dẫn đến Minh Phủ. Phán Quan có thể phân làm 4 loại: Thưởng Thiện Ty (賞善司), Phạt Ác Ty (罰惡司), Tra Sát Ty (查察司) và Thôi Phán Quan (崔判官). Ba tên đầu là chức danh, chỉ có chức cuối cùng thì thấy xuất hiện nhiều trong các thư tịch. Như trong Tây Du Ký (西遊記) cũng như truyền thuyết của các địa phương thường hay có tên vị này. Tương truyền Thôi Phán Quan tên là Giác (玨), người sống dưới thời Tùy Đường. Vào năm 633 (niên hiệu Trinh Quán [貞觀] thứ 7) nhà Đường, ông ra làm quan Huyện Lịnh Trường Tử (長子), Lộ Châu (潞州). Có thuyết cho rằng ông “ban ngày quản lý việc dương gian, tối xét xử các oan hồn dưới Âm Phủ, sai khiến người và quỷ, có năng lực như thần minh.” Trong dân gian có nhiều truyền thuyết về việc xử án của Thôi Giác (崔玨); trong đó có vụ án làm sáng tỏ con hổ làm thương tổn người được lưu truyền rộng rãi nhất. Truyền thuyết kể rằng nơi giáp giới phía tây nam Huyện Trường Tử và sông Thấm (沁) có một dãy núi lớn, tên là Điêu Hoàng Lãnh (雕黃嶺); xưa kia nơi đó thường có thú dữ xuất hiện. Một hôm, có chàng tiều phu lên núi đốn củi, không may bị con mãnh hổ ăn thịt. Người mẹ góa chồng hay tin đau lòng không muốn sống nữa, bèn lên Huyện đường kêu oan. Thôi Giác tức khắc phát lịnh bài, sai lính dịch Mạnh Hiến (孟憲) cầm điệp phù lên núi bắt cọp. Hiến lấy điệp phù ra đọc tụng trước Miếu Sơn Thần và dâng cúng trước án thần; khi ấy có một con cọp từ sau miếu lủi trốn ra. Hiến bèn dùng linh phù bắt con cọp dẫn về Huyện đường. Thôi Giác tức thì thăng đường, liệt kê tội phạm do con hổ gây ra từ trước đến nay; khi nghe mỗi tội như vậy, con hổ đều cúi đầu nhận chịu. Cuối cùng, ông phán quyết rằng: “Ăn thịt mạng người, tội không thể tha.” Con hổ nghe vậy đập đầu vào bậc cấp mà chết. Sau khi Thôi Giác qua đời, bá tánh đều lập miếu thờ ông ở khắp nơi. Tuy nhiên, cũng có thuyết nêu lên tên 4 vị phán quan có tên gọi hơi khác là: Chưởng Hình Phán Quán (掌刑判官, coi về hình phạt), Chưởng Thiện Bộ Phán Quan (掌善簿判官, coi về hồ sơ việc thiện), Chưởng Ác Bộ Phán Quan (掌惡簿判官, coi về hồ sơ việc ác) và Chưởng Sanh Tử Bộ Phán Quan (掌生死簿判官, coi về hồ sơ sống chết); trong đó vị cuối cùng là thủ lãnh tất cả. Tương truyền vị danh thần nhà Tống là Bao Thanh Thiên (包青天) cũng đã từng làm việc dưới Âm Phủ, có tên là Trương Bảo (張保), chuyên giám sát những người vượt ngục, trông coi hồ sơ sanh tử của con người và tuyên phạt những cực hình. Hình tượng các vị Phán Quan thường được tạc có đội mũ mềm trên đầu, mang cân đai, chân mang đôi hài mũi đen, trừng con mắt sáng quắt, tay trái cầm sổ thiệc ác, tay phải cầm cây bút sanh tử. Như vậy Quỷ Phán Quan là vị Phán Quan cõi Âm Phủ vốn có trong truyền thống văn hóa của Trung Quốc. Vì vậy, thế gian vẫn thường xưng tụng ông rằng: “Quân mạo tranh nanh, quân tâm công chánh, thanh lâm hắc tắc, duy quân sở mạng (君貌猙獰、君心公正、青林黑塞、唯君所命, Tướng người hung tợn, tâm người công chánh, rừng xanh chốn tối, chỉ người quản hạt).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phán Quyết", "definition": "判決. Xét định dứt khoát về việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Sự", "definition": "判事. Xét việc, lo việc Viên chức xem xét các công việc thông thường tại một cơ quan nhà nước. Ta vẫn gọi là Thầy phán, ông phán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Truyền", "definition": "判傳. Nói cho mọi người biết sự dứt khoát của mình về việc gì Ta còn hiểu là sai bảo người dưới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán Đoán", "definition": "判斷. Xem xét để quyết chắc về một điều gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phán..", "definition": "Phân biệt, so sánh giữa cái này với cái kia để làm sáng tỏ nghĩa lí. Bởi thế, trong các sách chú giải kinh Phật mới có các danh từ như Khoa phán, Phán Giáo...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháo", "definition": "奅. To lớn Súng bắn đá để phá thành thời cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Binh", "definition": "炮兵. Lính sử dụng súng lớn bắn xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Bảo", "definition": "炮堡. Bức thành có đặt súng lớn để chống giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Hiệu", "definition": "炮號. Sự thông báo tin tức hoặc ra lệnh bằng cách bắn súng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Hạm", "definition": "炮艦. Như Pháo thuyền 炮船.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Thuyền", "definition": "炮船. Tàu thuyền có gắn súng đại bác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Thủ", "definition": "炮手. Người lính bắn súng lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Đài", "definition": "炮臺. Nơi đặt súng lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháo Đội", "definition": "炮隊. Một toán lính sử dụng súng lớn bắn xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp", "definition": "Dhamma (P), Dharma (S), Dharma (S),  Hassu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp A Dục", "definition": "Dharmāśoka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp An", "definition": "安. Thiền tăng đời Ngũ Đại, người Thái Hòa (Thái Hòa, Giang Tây), Trung Quốc. Tham học với Thiền Sư Thanh Lương Văn Ích đắc pháp, làm truyền nhân tông Pháp Nhãn. Ban đầu ở viện Sùng Thọ, Tào Sơn, thiền lữ các nơi tụ hội chấn động một phương. Sư thượng đường nói: “Nếu hội được chư Phật thường hiện tiền; nếu chưa hội chớ tìmtòi trong Kinh Viên Giác”. Nam Đường Chủ mời sư ở viện Báo Ân, Kim Lăng (Nam Kinh) đặt hiệu “Nhiếp Chúng”. Còn đặt hiệu “Huệ Tế Thiền Sư”. Giữa niên hiệu Khai Bảo (968-975) sư tịch tại viện ấy.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Ba La Mật Bồ Tát", "definition": "Phạm: Dharma-vajrì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Báo Hóa Tam Thân", "definition": "法 報 化 三 身. Chỉ pháp thân, báo thân, hóa thân của Phật. Duy Tắc Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Bình", "definition": "Chỉ cho chiếc bình dùng để đựng nước thơm trong pháp hội Bố Tát. [X. môn Khí Vật trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Bản", "definition": "法 本. Thiền tăng đời Minh, tự Triệt Không, người Đại Hưng (Bắc Kinh), Trung Quốc. Xuất gia từ thuở nhỏ học thiền với Tùng Công chùa Định Quốc. Dần dà ông được ấn chứng. Năm 25 tuổi đăng tòa giảng pháp tại chùa Thiếu Lâm, hiểu rộng biết nhiều, cơ phong sắc bén, mọi người đều thán phục. Về sau lên chức Đô Cương ở Đô Cương Ty. tịch tại chùa Thiếu Lâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Bảo", "definition": "Dharma-ratna (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Bảo Thiền Sư", "definition": "法 寶 禪 師. 1. Hiệu của Thiền tăng Đạo Nhàn, sống vào đời Ngũ Đại. X. Đạo Nhàn. 2. Hiệu của Thiền tăng Khế ổn, sống vào đời Ngũ Đại. X. Khế ổn", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Bảo Tạng", "definition": "Xem Pháp Tạng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Bảo Đàn Kinh", "definition": "Fa-pao-t'an ching (C), Hobodan-gyo (J), Sutra of the High Seat of the Dharma Treasure Fabaotanjing (C), Hobodan-gyo (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Bị", "definition": "Chỉ cho bức màn treo ở phía trước điện Phật. Ngoài ra, tấm vải dùng để phủ bàn ghế trong nhà Thiền Cũng gọi là Pháp Bị. [X. môn Khí Vật trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Chiến", "definition": "Hossen (J), Dharma dueling.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Chiếu", "definition": "Các sử liệu đều không ghi rõ các chi tiết về niên đại cũng như quê quán của ngài; chỉ biết rằng, ở thời đại nhà Đường, dưới triều vua Đại-tông (762-779), ngài thường vân du ở vùng Đông-Ngô, nhân đó mà ngưỡng mộ đạo phong của đại sư Tuệ Viễn (đã viên tịch từ lâu) ở Lô-sơn, bèn vào núi xin theo tu tập pháp môn “niệm Phật tam muội”. Sau đó ngài đến núi Nam-nhạc, xin thờ đại sư Thừa Viễn (712-802, tổ thứ ba của tông Tịnh Độ) làm thầy. Năm 767 ngài đến cư trú tại chùa Vân-phong ở Hành-châu. Một hôm ngài trông thấy trong bát cháo của ngài hiện rõ đám mây năm sắc, trong đám mây ấy lại có hình ảnh ngôi chùa Đại-thánh Trúc-lâm. Một hôm khác, cũng lại ở trong cái bát ấy, ngài trông thấy hình ảnh các chùa ở núi Ngũ-đài cùng các thắng tướng của cảnh giới Tịnh-độ. Mùa hạ năm 769 ngài đến chùa Hồ-đông (cũng ở Hành-châu), mở đạo tràng tu “ngũ hội niệm Phật”, và cảm nhận được sự hiện diện của đức Phật A Di Đà cùng chư vị Bồ Tát Văn Thù, Phổ Hiền. Năm sau ngài đến chùa Phật-quang ở núi Ngũ-đài, bỗng có hai vị đồng tử xuất hiện dẫn đường, ngài mới thấy rõ các cảnh vật đã từng thấy trong bát cháo mấy năm trước; lại được hai đức Bồ Tát Văn Thù, Phổ Hiền trao truyền yếu môn niệm Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Chu", "definition": "Thuyền pháp, tức dùng thuyền bè ví dụ Phật Pháp có công năng đưa chúng sinh qua biển sinh tử, nên gọi là Pháp Chu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Chánh", "definition": "Xem Trúc Pháp Hộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Chân", "definition": "法 眞 (878-963). Thiền tăng đời Đường, họ Vương, người Tử Châu (Tam Thai, Tứ Xuyên), Trung Quốc. Lúc trẻ xuất gia tại chùa Huệ Nghĩa (Viện Trúc Lâm, chùa Hộ Thánh), sau khi thụ giới cụ túc sư đi du phương phía nam, tham học với các ngài: Đạo Ngô Viên Trí, Vân Nham Đàm Thạnh, Động Sơn Lương Giới, sau cùng nơi thiền hội Quy Sơn Linh Hựu Sư khắc khổ tu luyện cho đến ngộ đạo trở thành truyền nhân tông Quy Ngưỡng. Trở về chùa Long Hoài núi San Khẩu, Thiên Bành (Bành huyện, Tứ Xuyên), rồi dời sang am Mộc Thiền, núi Đại Tùy trụ trì hơn 10 năm, bóng hình không ra khỏi núi mà tiếng tăm vang ngoài xa, kẻ học đạo khắp nơi tụ hội. Vua ban hiệu “Thần Chiếu Đại Sư”. Tác phẩm: “Đại Tùy Khai Sơn Thần Chiếu Đại Sư Ngữ Lục” 1 quyển được xếp vào “Cổ Tôn Túc Ngữ Lục”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Chân Thiền Sư", "definition": "法 眞 禪 師. Hiệu của Thiền tăng Thủ Nhất, sống vào đời Tống. X. Thủ Nhất.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Chúc", "definition": "法 燭. Đuốc nến dùng thắp cúng trong tự viện. Đuốc pháp. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Chúng", "definition": "I.Pháp Chúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Chúng Học", "definition": "Sekhiya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Chấp", "definition": "Cũng gọi: Pháp Ngã Chấp, Pháp Ngã Kiến. Gọi tắt: Pháp Ngã, Giả Danh Ngã.Đối lại: Ngã Chấp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Chế", "definition": "法制. Luật lệ và cách tổ chức quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Chủ", "definition": "法主. Ông thầy cúng, trị được tà ma. Ta cũng gọi là thầy pháp, tức ông thầy cúng có phép thuật. Bài Hàn nho phong vị phí của Nguyễn Công Trứ có câu: “Thầy bà mong dối trá kiếm ăn, lại nghĩ chữ dũng như, phép chi được lừng danh pháp chủ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Cách Sùng Bái", "definition": "Phạm: Dharma Ràja Pùjà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Cái", "definition": "Cũng gọi Thiên Cái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Công", "definition": "法 公. Từ để gọi các vị tăng (bao gồm các vị tăng còn nhỏ). Tiết Dược Sơn Hòa Thượng trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Cú", "definition": "Dhamampada (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Pháp Cú Kinh", "definition": "Pàli: Dhamma-pada.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Cú Kinh Chú", "definition": "Dhammapadatthakatha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Cú Thí Dụ Kinh", "definition": "Dharmapadvadana Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Cúng Dường", "definition": "Pháp Cúng Dường. Cũng gọi Pháp Cúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Cảnh", "definition": "法警. Tức cảnh sát tư pháp, nhân viên coi về các vụ vi phạm luật lệ quốc gia, để giữ an ninh trật tự chung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Cấm", "definition": "法禁. Điều mà luật quốc gia không cho làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Cổ", "definition": "I.Pháp Cổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Cụ", "definition": "Cũng gọi Đạo Cụ, Phật Cụ, Tăng Cụ. Chỉ cho những vật dụng cần thiết cho việc tu học Phật đạo, tức như 3 áo, 6 vật của Tỉ Khưu cho đến kiền chùy, thẻ, tích trượng, bình, tràng hạt, phất trần, quạt v.v... Ngoài ra, Pháp cụ cũng chỉ chung cho những vật được dùng trong các pháp tu của Mật Giáo, như lò hương, cây đèn, tràng hạt, tràng hoa, phan, phướn, chuông, khánh v.v... [X. Cổ Sự Loại Uyển Tông Giáo Bộ]. (xt. Pháp Khí).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Của Phật A Di Đà", "definition": "Amitābha-dharma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Cứu", "definition": "Darmatrata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Cứu Luận Sư", "definition": "Dharmatrāta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Cự", "definition": "Pháp Cự (?-?).Cao tăng Trung Quốc, sống vào cuối đời Tây Tấn. Năm Vĩnh Gia thứ 2 (308), khi ngài Trúc Pháp Hộ dịch Kinh Phổ Diệu thì sư làm Bút Thụ để ghi chép. Ngoài ra, sư còn dịch kinh Lâu Thán, Kinh Đại Phương Đẳng Như Lai Tạng và cùng dịch với sư Pháp Lập Kinh Pháp Cú Thí Dụ và Kinh Phúc Điền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Danh", "definition": "法名. Tên hiệu, do nhà chùa đặt cho người tới chùa tới quy y tu hành. Đoạn trường tân thanh có câu: “Áo xanh đổi lấy cà sa, pháp danh lại đổi tên ra Trạc Tuyền”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Dao", "definition": "Pháp Dao (?-?). Cao tăng Trung Quốc, sống vào đời Lưu Tống, người Hà Đông, họ Dương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Diên", "definition": "Chỉ cho nơi ngồi thuyết pháp.Kinh Lăng Nghiêm quyển 1 (Đại 19, 106 trung) nói: “Khi ấy, Đức Như Lai trải tòa ngồi, giảng nói pháp nghĩa sâu xa, Đại Chúng thanh tịnh trong pháp diên được nghe những điều chưa từng nghe”. [X. điều Tôn Túc nhập viện trong Thiền Viện Thanh Qui Q.7].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Diên Long Tượng Chúng - Đương Quán Đệ Nhất Nghĩa", "definition": "法 延 龍 象 眾 當 觀 第 一 義. Những vị kiệt xuất trong pháp hội nên quán nghĩa thứ nhất. Đây là lời nghi thức do Duy Na hoặc vị tăng có địa vị xướng lên sau khi bạch chùy, trước khi vị “Trụ trì mới” nhậm chức thuyết pháp. Pháp Diễn Ngữ Lục, q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Diễn", "definition": "Fa-yen (C)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Diễn Ngũ Tổ", "definition": "Fayen Wutsu (C), Hoyen Goso (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Diễn Thiền Sư Ngữ Lục", "definition": "Cũng gọi Ngũ Tổ Pháp Diễn Thiền Sư Ngữ Lục, Ngũ Tổ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Diễn Tứ Giới", "definition": "Chỉ cho 4 đức mục lớn: Thế, Phúc, Qui Củ và Hảo Ngữ do Thiền Sư Ngũ Tổ Pháp Diễn (?-1104) thuộc Tông Lâm Tế đề xướng. Đó là: Có thế lực không nên ỷ hết, có phúc không nên hưởng hết, có phép tắc không nên thi hành hết và có lời hay không nên nói hết. [X. Thiền Uyển Mông Cầu Q.hạ].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Diệt", "definition": "I.Pháp Diệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Dung", "definition": "(594-657): là vị thiền sư đời Đường, khai tổ của tông Ngưu Đầu, người đời xưng là Ngưu Đầu Pháp Dung. Ngài họ Vi, quê ở Nhuận-châu (huyện Trấn-giang, tỉnh Giang-tô), 19 tuổi đã bác thông kinh sử, tình cờ được xem kinh Bát Nhã, bèn kính tin Phật pháp; liền vào núi Mao xin xuất gia với pháp sư Quế. Trải 20 năm tinh cần tu tập không giải đãi, được thể nhập pháp môn đại diệu. Năm 643 ngài lập riêng thiền thất ở núi Ngưu-đầu, chuyên tu thiền quán, học lữ các nơi qui tụ theo học có đến hơn trăm người. Tổ Đạo Tín nghe tiếng, thân hành đến nơi trao cho pháp môn đốn giáo đã từng được tổ Tăng Xán truyền cho. Từ đó, núi này trở thành trung tâm của một pháp hệ Thiền Tông, gọi là tông Ngưu-đầu, truyền thừa được sáu đời thì suy vi. Ngài thị tịch năm 657, thế thọ 64 tuổi.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Duyên", "definition": "法緣. Mối ràng buộc với giáo lí của Phật, chỉ việc đi tu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Duyệt", "definition": "Đồng nghĩa: Pháp Hỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Dĩnh", "definition": "Pháp Dĩnh (416-482). Danh tăng Trung Quốc, sống vào đời Nam Tề, người Đôn Hoàng, họ Sách. Năm 13 tuổi, sư y vào ngài Pháp Hương xuất gia ở chùa Công phủ tại Lương Châu, gắng sức học luật và các kinh luận. Cuối năm Nguyên Gia, sư đến chùa Tân đình ở Kim Lăng, vua Hiếu Vũ nhà Tống cử sư giữ chức “Đô Ấp Tăng Chính”. Sau, sư từ chức rồi về chùa Đa Bảo. Sau khi lên ngôi, vua Cao Đế nhà Tề lại ban sắc cử sư làm “Tăng chủ”. Năm 482 sư tịch, hưởng thọ 67 tuổi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Dũng", "definition": "Cũng gọi Đàm Vô Kiệt.Cao tăng Trung Quốc, sống vào đời Lưu Tống, người nước Hoàng Long, U Châu (nay là huyện Triêu Dương, tỉnh Nhiệt Hà), họ Lí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Dược", "definition": "Thuốc pháp, vì Phật Pháp có năng lực cứu chữa các bệnh khổ của chúng sinh nên gọi là Pháp Dược.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Dụ", "definition": "法 喩; C: făyú; J: hōyu; Dùng để so sánh sự giống nhau trong giáo lí, đạo lí được truyền dạy (pháp 法 ) và ẩn dụ để diễn tả pháp ấy (dụ 喩 , S: upamā-upameya).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pháp Dụ Kinh", "definition": "Xem Pháp Cú Thí Dụ Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Gia", "definition": "法家. Một học phái cổ Trung Hoa, chuyên nghiên cứu về luật lệ và hình phạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Giá", "definition": "(法駕): tên một loại cỗ xe của thiên tử; tùy theo vị trí cao thấp của thiên tử mà có 3 loại: đại giá (大駕), pháp giá (法駕), tiểu giá (小駕); và cũng khác nhau về nghi thức hộ vệ, v.v. Như trong Sử Ký (史記), chương Lữ Thái Hậu Bổn Kỷ (呂太后本紀) có câu: “Nãi phụng thiên tử pháp giá, nghênh đại vương ư để (乃奉天子法駕、迎代王於邸, bèn vâng xa giá của thiên tử, đón đức vua ở tư gia).” Hay trong Cao Phong Long Tuyền Viện Nhân Sư Tập Hiền Ngữ Lục (高峰龍泉院因師集賢語錄, 卍 Tục Tạng Kinh Vol. 65, No. 1277) quyển 2, phần Phổ Biến Văn (普變文), cũng có câu: “Nghênh thỉnh thiên hiền vạn thánh, quy y Ngũ Nhãn Lục Thông, vọng pháp giá dĩ quang lâm, nhạ hương xa nhi hạ giáng (迎請千賢萬聖、歸依五眼六通、望法駕以光臨、迓香車而下降, đón thỉnh ngàn hiền vạn thánh, quy y Năm Nhãn Sáu Thông, mong xe pháp hãy quang lâm, rước xe hương mà giáng xuống).” Hoặc như trong Thiền Uyển Thanh Quy (禪苑清規, 卍Tục Tạng Kinh Vol. 63, No. 1245) quyển 2, phần Tuần Liêu (巡寮), lại có câu: “Phục mông Hòa Thượng pháp giá phỏng lâm, hạ tình bất nhậm cảm kích chi chí (伏蒙和尚法駕訪臨、下情不任感激之至, cúi mong Hòa Thượng xe pháp đến thăm, chúng hạ tình thật cảm kích vô tận).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Giả", "definition": "Nghĩa là các pháp do nhân duyên hòa hợp mà sinh, chỉ có cái tên giả chứ không có thực thể. (xt. Tam Giả Thi Thiết, Giả).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới An Lập Đồ", "definition": "Tác phẩm, 6 quyển, do ngài Nhân Triều biên chép vào năm Vạn Lịch 12 (1584), đời Minh, được thu vào Vạn Tục Tạng tập 150.Nội dung trình bày về thứ tự kiến lập thế giới, gồm 115 tắc, chia làm 7 chương: Lược Minh Nam Châu, Quảng Bộ Đại Địa, Biến Quán Tam Giới, Đại Thiên Kiếp Lượng, Du Chư Phật Sát, Nghiên Cùng Pháp Giới và Pháp Giới Tổng Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Duy Tâm", "definition": "Tất cả muôn pháp trong pháp giới đều do tâm biến tạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Duyên Khởi", "definition": "Cũng gọi Pháp Giới Vô Tận Duyên Khởi, Thập Thập Vô Tận Duyên Khởi, Thập Huyền Duyên Khởi, Vô Tận Duyên Khởi, Nhất Thừa Duyên Khởi.Duyên Khởi quan của giáo nghĩa Hoa Nghiêm, nội dung của pháp giới Sự Sự Vô Ngại trong 4 pháp giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Gia Trì", "definition": "Chỉ cho thực tướng của chư Phật, của Chân Ngôn và của chúng sinh gia trì lẫn nhau. Đại Nhật Kinh Nghĩa Thích Diễn Mật Sao quyển 2 (Vạn Tục 37, 17 thượng) nói: “Tì phú la nghĩa là rộng lớn, tức là vô cùng sâu rộng, không thể lường được; tự thể các pháp rộng lớn như thế gọi là Tì Phú La Pháp Giới.Chư Phật thực tướng, Chân Ngôn thực tướng và chúng sinh thực tướng đều là Tì Phú La Pháp Giới, vì những thực tướng này lại gia trì lẫn nhau, nên gọi là Pháp Giới gia trì vậy”. [X. Đại Nhật Kinh Sớ Q.9].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Quán", "definition": "Chỉ cho pháp quán nhằm ngộ nhập chân lí của pháp giới do ngài Đỗ Thuận - Sơ Tổ Tông Hoa Nghiêm - lập ra. Pháp quán này có 3 lớp:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Quán Môn", "definition": "Cũng gọi Tu Đại Phương Quảng Phật Hoa Nghiêm Pháp Giới Quán Môn, Hoa Nghiêm Pháp Giới Quán Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Sở Duyên", "definition": "Dhammarammāna (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Giới Tam Quán", "definition": "法界三觀 (Hoa Nghiêm Pháp Giới Quán)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Giới Tam Quán.", "definition": "Cũng gọi Tam Trùng Pháp Giới, Tam Trùng Pháp Giới Quán, Tam Trùng Quán Môn, Tam Trùng Pháp Giới Quán Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Thân", "definition": "Chỉ cho Pháp Thân của Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Thể Tính Tam Muội Quán", "definition": "Cũng gọi Tự Luân Quán, Nhập Pháp Giới Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Thể Tính Trí", "definition": "Phạm: Dharma-dhàtu-svabhàvajĩàna.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Thứ Đê Sơ Môn", "definition": "Gọi tắt: Pháp Giới Thứ Đệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Tán", "definition": "Dharmadhātustava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Giới Tông", "definition": "Chỉ cho Tông Hoa Nghiêm, hoặc chỉ cho 1 trong 5 tông do ngài Tự Quĩ ở chùa Hộ thân thành lập vào đời Bắc Tề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Viên Dung", "definition": "Chỉ cho sự tồn tại của pháp giới chân như tròn đầy và dung hợp thành 1 thể. Đây là pháp quán Sự Sự Vô Ngại Pháp Giới được nói trong Thập Huyền Lục Tướng của Tông Hoa Nghiêm. [X. Quan Âm Huyền Nghĩa Q.thượng; Quan Âm Huyền Nghĩa Kí Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Vô Duyên", "definition": "Chỉ cho chúng sinh trong pháp giới không có duyên với Phật Pháp; hoặc chỉ cho công hạnh của Phật khởi Đại Bi vô duyên rộng khắp pháp giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Vô Sai Biêt Luận Sớ", "definition": "Tác phẩm, 1 quyển, do ngài Pháp Tạng (643-712) soạn vào đời Đường, được thu vàoĐại Chính Tạng tập 44.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Đẳng Lưu", "definition": "Cũng gọi Pháp Giới Truyền Lưu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Giới Định Ấn", "definition": "Cũng gọi Đại Nhật Định Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hiến", "definition": "Pháp Hiến (423-497). Cao tăng Trung Quốc, sống vào đời Nam Triều, người Diên thủy, tỉnh Tây Hải, họ Từ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hiền", "definition": "Dharmabhadrā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hiển", "definition": "(340?-?): là vị cao tăng sống vào thời đại Đông-Tấn (317-419). Ngài họ Cung, quê ở Vũ-dương (Sơn-tây). Có người nói ngài sinh năm 340 (triều vua Tấn Thành đế), nhưng không chắc chắn lắm. Ngài xuất gia từ năm mới lên 3 tuổi. Có chuyện lạ trong gia đình ngài. Song thân ngài đã có ba người con trai, đều bị chết yểu. Ngài là người con thứ tư. Vì sợ ngài bị chết yểu nữa, nên vừa lên 3 tuổi, song thân ngài đã cạo tóc cho ngài làm chú tiểu, hi vọng nhờ Phật gia hộ mà được thoát tai nạn (người Trung-quốc lúc đó, ai cũng tin tưởng như vậy). Tuy cạo tóc làm tiểu, nhưng song thân vẫn giữ chú ở nhà. Và rồi chú lại bị bệnh nặng, suýt chết, song thân đành phải tức tốc đem chú lên cho ở hẳn trong chùa; thế là chú lành bệnh. Từ đó chú phát tâm xuất gia luôn, không muốn trở về nhà nữa. Song thân nài nỉ thế nào chú cũng nhất quyết không trở về nhà. Vì quá thương nhớ con, thân mẫu ngài phải cất một cái chòi lá nhỏ bên cạnh chùa để ở, cho tiện thăm nom. Ngài lên 10 tuổi thì thân phụ qua đời. Ông chú ngài lại viết thư khuyên ngài về nhà sống với mẹ, nhưng ngài vẫn cương quyết từ chối, trả lời rằng: “Không phải vì cha mẹ mà cháu đi tu, mà chỉ vì muốn từ bỏ mọi dục vọng và tránh xa những chuyện thế tục.” Năm 20 tuổi ngài thọ giới cụ túc. Ngài được người đương thời ca tụng là người thông minh, nhanh trí, tính khí can đảm, đầy đủ đức vô úy, một lòng vì đạo. Khi tuổi đã cao, vì thấy kinh luật ở Trung-quốc còn quá thiếu thốn, giới luật trong đời sống tăng đoàn quá kém cỏi, vào năm 399 (thời  vua Tấn An đế, lúc đó ngài khoảng 60 tuổi), ngài đã rủ bốn vị đồng môn là Tuệ Cảnh, Đạo Chỉnh, Tuệ Ứng, Tuệ Ngôi, cùng đi sang Thiên-trúc, trước là chiêm bái đảnh lễ Phật tích, sau là thỉnh kinh luật Phạn văn đem về Trung-quốc. Tâm nguyện của ngài là cố gắng xiển dương Luật Tạng để chấn chỉnh nếp sống qui phạm cho tăng đoàn Trung-quốc lúc bấy giờ. Ngài đã phát xuất từ Trường-an (lúc ấy là kinh đô nước Hậu-Tần), theo đường bộ về hướng Tây, qua Đôn-hoàng, Vu-điền v.v... hơn 30 nước, với biết bao sa mạc hãi hùng, những sơn đạo cheo leo hiểm trở, những đỉnh núi cao tuyết phủ quanh năm... trước khi đến được Ấn-độ. Ở Ấn-độ, ngài đã đi hết khắp nơi để chiêm bái thánh tích của Phật; rồi ở lại thành Ba-liên-phất 3 năm để tu học; và ở lại vùng hạ lưu sông Hằng thêm 2 năm trước khi rời Ấn-độ để đi sang nước Sư-tử (đảo Tích-lan). Ngài ở lại nước Sư-tử 2 năm, rồi theo đường biển sang Nam-dương, rồi từ đó, cũng theo đường biển trở về Trung-quốc (năm 414); tổng cộng thời gian xuất du của ngài là 15 năm. Kinh sách ngài mang về Trung-quốc, chủ yếu là thuộc Luật Tạng (như Luật Ma Ha Tăng Kì của Đại Chúng Bộ, Luật Thập Tụng của Nhất Thiết Hữu Bộ v.v...), ngoài ra còn có một bộ luận quan trọng của Đại Chúng Bộ là Tạp A Tì Đàm Tâm Luận, và các kinh thuộc bộ A Hàm. Sau khi về nước, ngài trú tại chùa Đạo-tràng ở Kiến-khang (tức Nam-kinh, lúc đó là kinh đô của vương triều Đông-Tấn), chuyên việc dịch kinh. Tại đây ngài đã cùng với ngài Phật Đà Bạt Đà La dịch chung các bộ Luật Ma Ha Tăng Kì, Kinh Đại Bát Nê Hoàn, Kinh Tạp Tạng, Luận Tạp A Tì Đàm Tâm. Ngài cũng đã đem tất cả các việc mắt thấy tai nghe trong suốt cuộc hành trình đi Ấn-độ, Tích-lan, ghi chép lại, làm thành tác phẩm Phật Quốc Kí, cũng gọi là Cao Tăng Pháp Hiển Truyện; trong đó, quan trọng nhất là phần ngài trình bày về sinh hoạt của tăng đoàn Phật giáo ở Ấn-độ và Tích-lan vào thế kỉ thứ 5. Ngài ghi nhận rằng, tăng đoàn ở các nơi đó hành trì giới luật Phật chế rất nghiêm cẩn, được cả vua chúa và dân chúng kính ngưỡng cúng dường. Năm viên tịch của ngài không ai biết rõ, chỉ biết là ở trong khoảng những năm từ 418-423. Thế thọ của ngài, có người nói là 82, có người nói là 86 tuổi.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Hiển Thiền Sư", "definition": "Fa-Hien (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hiển Truyên", "definition": "Cũng gọi Cao Tăng Pháp Hiển Truyện, Phật Quốc Kí, Lịch Du Thiên Trúc Kí Truyện, Cao Tăng Truyện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hiệu", "definition": "法號. Như Pháp danh 法名.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Hoa", "definition": "法華. Tên một bộ kinh Phật, tức Pháp hoa kinh Chỉ nước Pháp và nước Trung Hoa. Td: Pháp Hoa tự điển (bộ sách tra chữ Pháp ra chữ Tàu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Hoa Bát Diệp", "definition": "Tám cánh hoa của diệu pháp.Theo Mật Giáo thì hoa sen của diệu pháp tượng trưng cho nhục đoàn tâm (trái tim) của chúng sinh. Bởi vậy, giống như nhục đoàn tâm có 8 múi, hoa sen của diệu pháp cũng có 8 cánh, gọi là Pháp Hoa Bát Diệp. [X. Pháp Hoa Bí Lược Yếu Sao Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Bát Giảng", "definition": "Cũng gọi Ngự Bát Giảng Hội, Ngự Bát Giảng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Huyền Luận", "definition": "Cũng gọi Pháp Hoa Kinh Huyền Luận. Tác phẩm, 10 quyển, do ngài Cát Tạng (549-623) soạn vào đời Tùy, được thu vào Đại Chính Tạng tập 34.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Huyền Nghĩa", "definition": "Gọi đủ: Diệu Pháp Liên Hoa Kinh Huyền Nghĩa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Huyền Nghĩa Thích Tiêm", "definition": "Cũng gọi Thiên Thai Pháp Hoa Huyền Nghĩa Thích Tiêm, Pháp Hoa Thích Tiêm, Huyền Nghĩa Thích Tiêm, Huyền Tiêm, Thích Tiêm, Diệu Pháp Liên Hoa Kinh Huyền Nghĩa Thích Tiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Huyền Nghĩa quyển 7 nói: “Nếu thường tự ngộ thì ắt được minh gia”. [X. Pháp Hoa Đại sớ sao huyền đàm Q.3; Đại Từ Ân Tự Tam Tạng Pháp Sư Truyện Q.10].", "definition": "II.Minh Gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Huyền Tán", "definition": "Cũng gọi Diệu Pháp Liên Hoa Kinh Huyền Tán, Pháp Hoa Kinh Huyền Tán, Huyền Tán. Tác phẩm, 10 quyển, do ngài Từ Ân Khuy Cơ (623-682) soạn vào đời Đường, được thu vào Đại Chính Tạng tập 34.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Kinh", "definition": "Lotus Sūtra (P), Lotus of Wonderful Dharma Sutra, Garland Sūtra, Myoho Renge Kyo (J), Saddharma-puṇḍarīka-Sūtra (S), Hoke-kyō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hoa Kinh An Lạc Hạnh Nghĩa", "definition": "Cũng gọi An Lạc Hạnh Nghĩa, Pháp Hoa An Lạc Hạnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Kinh Nghĩa Kí", "definition": "Cũng gọi Pháp Hoa Nghĩa Kí, Pháp Hoa Nghĩa Sớ, Pháp Hoa Kinh Sớ, Pháp Hoa Sớ, Diệu Pháp Liên Hoa Kinh Nghĩa Kí, Diệu Pháp Liên Hoa Kinh Nghĩa Sớ, Pháp Hoa Kinh Nghĩa Sớ, Pháp Hoa Quang Trạch Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Kinh Sớ", "definition": "I.Pháp Hoa Kinh Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Kinh Thập Thất Danh", "definition": "Mười bảy tên của Kinh Pháp Hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Kinh Tán", "definition": "Saddharma-puṇḍarīka-stava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hoa Linh Nghiêm Truyện", "definition": "Cũng gọi Pháp Hoa Kinh Linh Nghiệm Truyện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Luận Sớ", "definition": "Tác phẩm, 3 quyển (hoặc 2 quyển), do ngài Cát Tạng (549-623) soạn vào đời Tùy, được thu vào Đại Chính Tạng tập 40.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Lục Thụy", "definition": "法華六瑞 (Pháp Hoa Kinh Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Hoa Mạn Trà La Oai Nghi Hình Thức Pháp Kinh", "definition": "Fa-hua man-t'o-lo wei-i hsing-se fa ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hoa Mạn Đồ La", "definition": "Cũng gọi Pháp Hoa Kinh Mạn Đồ La, Pháp Hoa Biến Tướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Nghĩa Sớ", "definition": "Cũng gọi Pháp Hoa Kinh Nghĩa Sớ, Pháp Mạn Đồ La Pháp Hoa Kinh Sớ, Diệu Pháp Liên Hoa Kinh Nghĩa Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Ngũ Bách Vấn Luận", "definition": "Cũng gọi Pháp Hoa Kinh Ngũ Bách Vấn Luận, Ngũ Bách Vấn Luận, Thích Nghi.Tác phẩm, 3 quyển, do ngài Trạm Nhiên (711-782) soạn vào đời Đường, được thu vàoVạn Tục Tạng tập 100.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Ngũ Trùng Huyền Nghĩa", "definition": "法 華 五 重 玄 義 (Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Hoa Nhất Thừa", "definition": "Chỉ cho giáo pháp Nhất Thừa Chân Thực nói trong Kinh Pháp Hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Nhị Diêu", "definition": "Cũng gọi Đãi Tuyệt Nhị Diệu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Nhị Diệu", "definition": "法華二妙 (Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Hoa Niết Bàn Kỳ", "definition": "Saddharma-puṇḍarīkam-nirvāṇa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hoa Niết Bàn Thời", "definition": "Thời Pháp Hoa Niết Bàn. Đây là thời cuối cùng trong năm thời thuyết giáo của đức Thích Tôn (theo sự nhận định của tông Thiên Thai), gồm khoảng 8 năm và một ngày đêm trước giờ phút nhập niết bàn. Trong thời kì này, đức Phật giảng nói hai bộ kinh Pháp Hoa và Niết Bàn, cho nên gọi là thời Pháp Hoa Niết Bàn. Giáo nghĩa của thời kì này là hiển dương tính rốt ráo của Phật Thừa, khiến chúng sinh đều chứng nhập tri kiến Phật; cùng khẳng định tất cả chúng sinh vốn đều có tính giác, cho nên đều sẽ thành Phật – dù có phải đọa địa ngục Vô-gián hàng vô số kiếp, nhưng cuối cùng, chúng sinh ấy vẫn được thành Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Hoa Sám Pháp", "definition": "Chỉ cho nghi thức đọc tụng Kinh Pháp Hoa để sám hối tội chướng, đây là tu pháp quan trọng của Tông Thiên Thai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Sơn", "definition": "Pháp Hoa Sơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tam Bộ Kinh", "definition": "Chỉ cho 3 bộ kinh: Vô Lượng Nghĩa, Diệu Pháp Liên Hoa và Quán Phổ Hiền Bồ Tát Hành Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tam Chu", "definition": "法華三周 (Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Hoa Tam Muội", "definition": "Saddharma-puṇḍarīka-samādhi (S), Fahua sanmei (C), Hokke zammai (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hoa Tam Muội Kinh", "definition": "I.Pháp Hoa Tam Muội Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tam Muội Sám Nghi", "definition": "Cũng gọi Pháp Hoa Tam Muội Hành Pháp, Pháp Hoa Tam Muội Nghi, Pháp Hoa Kinh Tam Muội Nghi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tam Muội Đường", "definition": "Cũng gọi Sám Pháp Đường, Bán Hành Bán Tọa Tam Muội Đường, Pháp Hoa Đường, Tam Muội Đường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tam Đại Bộ Bổ Chú", "definition": "Cũng gọi Thiên Thai Tam Đại Bộ Bổ Chú, Tam Đại Bộ Bổ Chú, Đại Bộ Bổ Chú.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Thất Dụ", "definition": "法華七喻 (Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Hoa Truyên Kí", "definition": "Cũng gọi Đường Pháp Hoa Truyện, Pháp Hoa Kinh Truyện Kí, Pháp Hoa Kinh Truyện. Tác phẩm, 10 quyển, do ngài Tăng Tường soạn vào đời Đường, được thu vào Đại Chính Tạng tập 51.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tôn Giả", "definition": "Pháp Hoa Tôn Giả (?-680).Cao tăng Trung Quốc, sống vào đời Đường, vị Tổ thứ 6 của Tông Thiên Thai, người Tấn Vân, Xử Châu (Chiết Giang), họ Tưởng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Tông", "definition": "Fa-hoa-tsoung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hoa Tú Cú", "definition": "(法華秀句, Hokkeshūku): tác phẩm của Tối Trừng viết vào năm 821, gồm 3 quyển, là tác phẩm lớn cuối cùng của đời ông, xoay quanh những vấn đề luận tranh với Đức Nhất (德一, Tokuitsu) của Pháp Tướng Tông về Tam Thừa, Nhất Thừa Quyền Thật. Bộ này nhằm mục đích nêu cao Pháp Hoa Thập Thắng như là vị trí trên hết của Thiên Thai Pháp Hoa Tông, và nói rõ lý do vì sao tông này lại ưu việt hơn hẳn các tông phái khác như Duy Thức, Tam Luận, Hoa Nghiêm, Chơn Ngôn, v.v. Nó cũng là tác phẩm tiêu biểu nhất của Tối Trừng vào cuối đời ông.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Hoa Tự", "definition": "(法華寺, Hokke-ji): ngôi chùa Ni của Chơn Ngôn Tông Nhật Bản, tọa lạc tại Hokkeji-machi (法華町), Nara-shi (奈良市); còn gọi là Băng Thất Ngự Sở (冰室御所, Himurogosho), tương đương với Pháp Hoa Diệt Tội Chi Tự (法華滅罪之寺) ở tiểu quốc Đại Hòa (大和, Yamato), được xây dựng vào năm 741 theo chiếu chỉ của Thiên triều. Có thuyết cho rằng tượng thờ chính thập nhất diện quan âm vốn được khắc theo dung mạo của Hoàng Hậu Quang Minh (光明, Kōmyō). Cho đến nay vẫn chưa xác định rõ chùa được thành lập như thế nào, nhưng trong bản tuyên chỉ của Xưng Đức Thiên Hoàng (稱德天皇, Shōtoku Tennō, tại vị 764-770) có cho biết rằng nguyên xưa kia chùa là cựu sở của Đằng Nguyên Bất Tỷ Đẳng (藤原不比等, Fujiwara-no-Fuhito, 659-720). Chánh điện hiện tại là kiến trúc cuối thời đại Thất Đinh, được Phong Thần Tú Lại (豐臣秀賴, Toyotomi Hideyori, 1593-1615) trùng tu vào năm 1601", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Hoa Văn Cú", "definition": "Gọi đủ: Diệu Pháp Liên Hoa Kinh Văn Cú. Gọi Tắt: Pháp Hoa Kinh Văn Cú, Văn Cú, Diệu Cú.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Văn Cú Kí", "definition": "I.Pháp Hoa Văn Cú Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoa Đề Cương", "definition": "法 花 題 剛. Biên khảo, 1 quyển, do Thanh Đàm Minh Chính (Thiền Sư Việt Nam) viết tại viện Liêm Khê vào năm 1819. Đây là một tác phẩm biên khảo giá trị, trong văn xuôi có chen lẫn thơ kệ, có thể nói là cẩm nang cho người đọc kinh Pháp Hoa. Thiền Sư Thanh Đàm đã đọc Pháp Hoa với con mắt của nhà Thiền học rồi đề cương lại, giúp cho người đọc nắm được ý chỉ của kinh, giống như có địa bàn trong tay người thủy thủ không còn sợ mất bến mất bờ. Nhận thức của sư về giải thoát được trình bày gọn ghẽ trong lời Bạt nói về năm chữ “Diệu Pháp Liên Hoa Kinh, nhất là 2 chữ Diệu Pháp. Theo sư, Diệu tức là Tâm, là chân tâm sáng suốt tròn đầy. Bài tụng về Diệu của Diệu như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hoàng", "definition": "Cũng gọi Thái Thượng Pháp Hoàng, Thiền Định Pháp Hoàng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hoá", "definition": "法化. Thay đổi nhờ phép Phật Thay đổi lần lần mà giống như người Pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Huynh", "definition": "Cũng gọi Huynh Đệ Tử, Sư Huynh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Huệ Thiền Sư", "definition": "法 慧 禪 師. Hiệu của Thiền tăng Minh Bản do vua Nguyên Nhân Tông ban cho. X. Minh Bản.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hòa", "definition": "Pháp Hòa (?-?).Cao tăng Trung Quốc, sống vào đời TiềnTần, người Huỳnh dương (Hà Nam). Lúc nhỏ, sư cùng học với ngài Đạo An, thờ ngài Phật Đồ Trừng làm thầy. Nhân lánh nạn chiến tranh, sư vào đất Thục, sau sư vào Quan Trung trụ ở chùa Dương bình, tham dự công việc dịch kinh tại Trường An do ngài Đạo An chủ trì. Rồi tại Lạc Dương, sư cùng với ngài Tăng Già Đề Bà nhuận sắc văn dịch các bộ Luận A Tì Đàm Tâm, Tì Bà Sa a tì đàm... Sau, nhận lời thỉnh của Tấn Vương Diệu Tự đời Tiền Tần, sư đến trụ ở Bồ Phản (Sơn Tây) để giảng thuyết. Sư tịch năm 80 tuổi.[X. Lương Cao Tăng Truyện Q.1, 5].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hóa", "definition": "法 化. Dùng Phật pháp để giáo hóa. Chương Phục Đà Nan Đề, tổ thứ 8 trong CĐTĐL. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hùng", "definition": "法 雄. Cao tăng rất kiệt xuất. “Đại Giám Thiền Sư bi tinh tự” của Lưu Vũ Tích trong Toàn Đường Văn q. 610 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hưng", "definition": "法 興 (?-1388). Thiền tăng đời Minh, họ Trần, hiệu Tùng Thạch, người Hoàng Nham (Chiết Giang), Trung Quốc. Năm 15 tuổi xuất gia với Minh Công chùa Thụy Nham ở Đồng ấp, còn làm thị giả cho Bình Thạch ở chùa Thiên Đồng. Lại theo Cổ Đỉnh chùa Kính Sơn được mời làm Tạng ty. Khi ra hoằng pháp, sư trụ trì chùa Thái Bình ở Vĩnh Gia (Ôn Châu, Chiết Giang), dời về chùa Thọ Xương ở Lạc Thanh (Chiết Giang). Niên hiệu Hồng Vũ thứ 20 (1378) sư trụ trì chùa Kính Sơn đạo hạnh lẫy lừng, thiền lữ khắp nơi nghe danh đến tụ hội rất đông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hưng Thiền Tự", "definition": "法 興 禪 寺. 1. Nằm ở thị trấn Triều Châu, huyện Bình Đông, tỉnh Đài Loan, Trung Quốc. Năm 1957 do Pháp sư Hoằng Định sáng lập. Chùa có Thiên kiều, Trai đường, Quán Âm điện, Tam bảo điện, Niệm Phật đường, Phật học đồ thư quán. 2. Nằm trong công viên Thọ Sơn, thành phố Cao Hùng, tỉnh Đài Loan, Trung Quốc. Năm 1966 do Pháp sư Thánh Hùng sáng lập. Chùa dựa thế núi mà cất, Đại hùng bảo điện hình tròn. Ngoài ra còn có Giảng đường, Khách đường, Thiền phòng, Trai đường, Xá Lợi tháp, Tổ sư đường.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hưng Tự", "definition": "(法興寺, Hōkō-ji) hay Nguyên Hưng Tự (元興寺, Gankō-ji): theo Nhật Bản Thư Kỷ (日本書紀, Nihonshoki), vào năm 588 Tô Ngã Mã Tử (蘇我馬子, Soga-no-Umako, ?-626) có phát nguyện tạo dựng một ngôi chùa ở vùng đất Chơn Thần Nguyên (眞神原, Makami-no-Hara) thuộc Phi Điểu (飛鳥, Asuka) và khoảng trong vòng 6 năm cho đến năm 596 thì hoàn thành. Nó được gọi là Phi Điểu Tự (飛鳥寺, Asuka-dera) hay Pháp Hưng Tự (法興寺, Hōkō-ji). Đến cuộc Cải Tân Đại Hóa (大化改新, Taika-no-kaishin) thì chùa này trở thành chùa quan và đến thời Đằng Nguyên Kinh Thời (藤原京時) thì được liệt vào trong bốn ngôi chùa lớn. Vào năm 710, khi kinh đô được dời về Bình An thì chỉ có Thiền Viện của chùa được dời theo và trở thành ngôi Thiền Viện độc lập. Đến năm 718, toàn bộ kiến trúc chùa đều được dời về vị trí hiện tại ở thành phố Nại Lương và được đổi tên thành Nguyên Hưng Tự.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Hạ", "definition": "Cũng gọi Pháp Lạp, Giới Lạp, Pháp Tuế, Hạ Lạp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hạnh", "definition": "Ý nghĩa chung của từ “pháp hạnh” là y theo giáo pháp của Phật mà tu hành; đại khái, bao gồm mười phương diện:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Hải", "definition": "Tên họ và tuổi tác của ngài đều không rõ, chỉ biết ngài là người tỉnh Quảng-đông, lần đầu gặp tổ Tuệ Năng thì hỏi ngay ý nghĩa “tức tâm tức Phật”, Tổ chỉ dạy một lời thì liền liễu ngộ. Từ đó chuyên theo hầu Tổ để ghi chép lại tất cả những lời giảng dạy của Tổ. Kinh Pháp Bảo Đàn là một trong các tác phẩm thuộc loại này, và cũng được coi là tác phẩm cương yếu của Thiền Tông Trung-quốc.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Hệ", "definition": "法系. Cách tổ chức thứ tự và liên lạc với nhau về luật lệ quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Hỉ", "definition": "Là tên Hán dịch của ngài Đàm Ma Nan Đề (Dharmanandi, ?-?). Ngài là người Tây-vức, xuất gia hồi còn nhỏ, thông minh mẫn nhuệ, học thông Ba Tạng, đặc biệt chuyên về Trung A Hàm và Tăng Nhất A Hàm, rất được người đời kính trọng. Năm 384 ngài đến Trường-an (kinh đô nhà Tiền-Tần), cùng với hai ngài Đạo An và Trúc Phật Niệm, đã dịch hai bộ kinh Trung A Hàm và Tăng Nhất A Hàm ra Hán văn. Đó là lần đầu tiên Kinh Đại Bộ được phiên dịch. Hai bộ kinh này về sau được ngài Tăng Già Đề Bà hiệu đính, và lưu truyền đến ngày nay. Ngài được người đời trọng vọng, lại được vua Tiền-Tần là Phù Kiên dùng lễ mà đãi ngộ. Khi Phù Kiên bị Diêu Trành giết để lập nên nhà Hậu-Tần, ngài vẫn tiếp tục ở Trường-an để dịch kinh. Trong thời gian này ngài đã dịch A Dục Vương Tức Hoại Mục Nhân Duyên Kinh, Tam Pháp Độ Luận, và Tăng Già La Sát Tập Kinh. Đó là theo sự ghi chép của sách Lịch Đại Tam Bảo Kỉ; nhưng trong sách Lương Cao Tăng Truyện lại ghi rằng, trong lúc Diêu Trành đang đánh vào lãnh thổ Tiền-Tần thì ngài liền rời Trường-an trở về Tây-vức, rồi không biết về sau ra sao.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Hỉ Thực", "definition": "Food of Dharma joy", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Học", "definition": "法學. Ngành nghiên cứu về luật lệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Hộ", "definition": "(Dharmapala, 963-1058). Ngài là người nước Ca-thấp-di-la ở Bắc Ấn-độ, họ Kiều-thi-ca, nguyên thuộc dòng Bà-la-môn. Thuở nhỏ học thông bốn kinh Phệ Đà cùng các kí luận. Về sau ngài xuống vùng Trung-Ấn xuất gia theo Phật giáo, theo học cả tiểu lẫn đại thừa với nhiều vị cao tăng. Năm 1004 ngài sang đến Biện-kinh, dâng tặng vua Tống Chân-tông xá lợi Phật cùng kinh bản chữ Phạn, được vua ban cho cà sa tía và mời tham gia công tác phiên dịch kinh điển; lại được vua ban hiệu là Truyền Phạn đại sư. Trước sau ngài đã dịch được 35 bộ kinh luận, gồm 270 quyển. Ngài viên tịch năm 1058 (dưới triều vua Tống Nhân-tông (1023-1063), thụy hiệu là Diễn Giáo tam tạng.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Hội", "definition": "法會. Cuộc tổ chức họp mặt, sinh hoạt chung của tăng ni.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Hữu Lậu", "definition": "Lậu là rò rỉ, tên riêng chỉ sự phiền não. Sự vật hàm tàng phiền nảo gọi là hữu lậu. Hết thảy sự thể trong thế gian đều là pháp hữu lậu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hữu Ngã Vô Tông", "definition": "Tông phái chủ trương thuyết “Hết thảy pháp đều có thực trong 3 đời (quá khứ, hiện tại, vị lai), pháp thể hằng có, nhưng hoàn toàn không có cái Ta chủ quan”. Đây là tông thứ 2 trong 10 tông theo sự phán giáo của Tông Hoa Nghiêm. Các bộ phái của Tiểu Thừa Như: Tát Bà Đa Bộ, Tuyết Sơn Bộ, Đa Văn Bộ, Hóa Địa Bộ... đều thuộc tông này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hữu Vi", "definition": "Saṇkhata dhamma (P), Saṁkṛta-dharma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hỷ", "definition": "Fa Hi (S), Dharmanendin (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Hỷ Chí", "definition": "Gọi đủ: Danh Công Pháp Hỷ Chí. Tác phẩm, 4 quyển, do ông Hạ Thụ Phương soạn vào đời Minh, ông Phùng Định kiểm xét lại, được thu vào Vạn Tục Tạng tập 150.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Hỷ Thiền Sư", "definition": "法 喜 禪 師. Thụy hiệu của Thiền tăng Linh Tuân, sống vào đời Ngũ Đại. X. Linh Tuân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Hỷ Thực", "definition": "Phạm: Dharma-prìty-àhàra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Khiên", "definition": "法 騫. Thiền tăng đời Tống, họ Thi, người Tuyền Châu, Trung Quốc. Sư đến Viện Long Thọ, Chương Châu (Chương Phố, Phúc Kiến) học đạo với Thiền Sư Vô Dật được nối pháp và kế thừa pháp tịch. Có vị tăng hỏi: “Thế nào là cảnh Long Thọ?”. Sư đáp: “Không chỗ cho ông để chân”. Lại hỏi: “Thế nào là người trong cảnh?” Sư đáp: “Ông còn chưa biết cảnh!”", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Khoa", "definition": "法科. Ngành nghiên cứu về luật lệ, chính trị và kinh tế. Cũng như: Luật khoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Khâm", "definition": "法 欽 (714-792). Còn gọi: Đạo Khâm. Thiền tăng tông Ngưu Đầu đời Đường, họ Chu, người Côn Sơn, Tô Châu (Giang Tô), Trung Quốc. Năm 28 tuổi mới phát tâm vào đạo, bái Thiền Sư Huyền Tố làm thầy, tu tập pháp thiền Ngưu Đầu nơi chùa Hạc Lâm. Về sau đến Kính Sơn kết am ở một mình, đạo hạnh vang xa nên người học đạo tụ hội rất đông. Niên hiệu Đại Lịch thứ 3 (768) Đại Tông triệu sư vào kinh để hỏi pháp yếu, ban hiệu “Quốc Nhất”. Thôi Hoán, Bùi Độ v. v.. đều thờ sư làm thầy. Sau đó sư trở về Kính Sơn thuyết pháp rồi tịch. Sau khi tịch được ban thụy “Đại Giác Thiền Sư”. Đệ tử là Đạo Lâm, Sùng Huệ, Quảng Phu v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Khí", "definition": "法器. Dụng cụ bày trên bàn thờ Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Không", "definition": "Cũng gọi Pháp Vô Ngã (Phạm: Dharmanairàtmya). Chỉ cho tự tính của các pháp là không, 1 trong Nhị Không, 1 trong Tam Không. Pháp không có 2 nghĩa: Hết thảy pháp đều vô ngã; hết thảy pháp đều do nhân duyên giả hòa hợp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Không Quán", "definition": "Pháp quán xét muôn vật đều do nhân duyên, điều kiện giả hòa hợp, không có thực thể, là 1 trong Nhị Không Quán. Đây là pháp quán của Bồ Tát Đại Thừa. (xt. Không).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Khải", "definition": "法 鎧 (1561-1621). Thiền tăng đời Minh, họ Triệu, tự Nhẫn Chi, hiệu Đạm Cư, người Giang Âm (Giang Tô), Trung Quốc. Niên hiệu Vạn Lịch thứ 21 (1593) được Thiền Sư Chân Khả truyền giới cụ túc. Sư vào đài Phân Kinh núi Thiên Mục ẩn cư ba năm chuyên tâm tham cứu. Sư thường để lộ cánh tay, mỗi khi có vọng tâm thì lấy nhang đốt vào cánh tay. Niên hiệu Vạn Lịch thứ 29 (1601) nghe tin Chân Khả có nạn, liền đến xin được ấn chứng. Niên hiệu Vạn Lịch thứ 36 (1608) sư nhận lời mời của Ngô Quán Ngã trụ trì chùa HoaNghiêm núi Phù Sơn. Về sau sư trở về Song Kính mà tịch.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Khản", "definition": "Pháp Khản (551-623). Cao tăng Trung Quốc, sống vào đời Tùy, người Huỳnh dương (thuộc tỉnh Hà Nam), họ Trịnh.Ban đầu, sư tu hành ở chùa Linh Nham, núi Thái sơn, sau sư theo Pháp Sư Uyên học tập các bộ Luận Thập Địa, Địa trì... Về sau, sư đến Kiến Khang, theo cư sĩ Tào Tì– đệ tử tại gia của ngài Chân Đế– nghiên cứu Luận Nhiếp Đại Thừa. Năm Nhân Thọ thứ 2 (602), đời Tùy, sư vâng sắc chỉ của vua Văn Đế đưa xá lợi đến Tuyên Châu (huyện Tuyên thành, tỉnh An Huy) và Lê Châu (thuộc tỉnh Hà Nam), cảm được điềm lạ. Vua Dạng Đế từng xây cất chùa Nhật Nghiêm ở Trường An, thỉnh các bậc cao tăng trong nước về luận đạo, sư cũng vâng sắc về tuyên giảng Duy Thức. Đến đầu đời Đường, sư được lập làm 1 trong “Mười vị Đại Đức” lãnh đạo giới Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Khởi Bồ Tát", "definition": "Dharmodgata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Kinh", "definition": "Dhammdasa (P), Dharma Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Kiếm", "definition": "Thanh kiếm pháp. Phật Pháp được ví dụ như thanh kiếm. Kiếm vốn là thứ vũ khí chế ngự kẻ địch; cũng thế, Phật Pháp có năng lực dẹp tan ma quân phiền não của chúng sinh, cho nên gọi là Pháp kiếm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Kiều", "definition": "I.Pháp Kiều.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Kính", "definition": "Xem Gương Chánh Pháp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Kệ", "definition": "法 偈. Thơ kệ nói về đạo pháp hoặc truyền trao đạo pháp. Chương Tăng Già Nan Đề Tổ thứ 17 trong CĐTĐL q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Lan", "definition": "Dharma-aranya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Loa", "definition": "Dharmśaṅkha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Long Tự", "definition": "Horyuji (J)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Luân", "definition": "Dhammacakka (P), Dhammacakkaṃ (P), Dharmacakra (S), Dhamma wheel.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Luân Bất Thối", "definition": "Unregressing wheel of the law", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Luân Thanh Tịnh", "definition": "Pure wheel of the law", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Luân Tăng", "definition": "Phạm: Dharmacakra-saôgha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Luận Mục Lục", "definition": "Tên đầy đủ: Tống Minh Đế Sắc Trung Pháp Luân Thư Thị Lang Lục Trừng Soạn Pháp Luận Mục Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Luật", "definition": "Dhamma-vinaya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Ly Văn Tự", "definition": "法 離 文 字. Thiền pháp siêu việt văn tự tri giải. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Lâm", "definition": "Pháp Lâm (572-640). Cao tăng Trung Quốc, sống vào đời Đường, người Dĩnh Xuyên (nay là huyện Hứa Xương, tỉnh Hà Nam), họ Trần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lãng", "definition": "Fa-lang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Lê", "definition": "Pháp Lê (569-635). Cao tăng Trung Quốc, sống vào đờiĐường, Tổ của Tướng Bộ Tông, người Triệu Châu (huyện Triệu, tỉnh Hà Bắc), họ Lí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lí", "definition": "法理. Cái lẽ phải về mặt luật lệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Lôi", "definition": "Sấm pháp, ví dụ Phật Pháp có năng lực phá trừ sự mê vọng của chúng sinh làm cho họ mở tỏ, giống như tiếng sấm khiến người ngủ say bừng tỉnh. Cũng ví dụ pháp âm của Đức Phật mạnh mẽ vang rền như tiếng sấm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lĩnh", "definition": "Pháp Lĩnh (?-?). Cao tăng Trung Quốc, sống vào đời Ngụy Tấn, là đệ tử của ngài Tuệ Viễn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lưu", "definition": "Cũng gọi Pháp Thủy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lượng", "definition": "Chỉ cho chiều cao của các pho tượng Phật, Bồ Tát được đo lường, phổ thông có tượng cao 1 trượng 6, có tượng cao nửa trượng 6... gọi chung là Pháp lượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lạc", "definition": "Niềm vui pháp. Nghe nhận Phật Pháp để nuôi lớn tuệ mệnh của Pháp Thân mà sinh vui mừng, nên gọi là Pháp lạc. Ngoài ra, làm các việc thiện để chứa góp phúc đức, tự lấy đó làm niềm vui, cũng gọi Pháp lạc. Luận Duy Thức quyển 10 (Đại 31, 57 hạ) nói: “Tự thụ dụng (...) suốt khoảng vị lai, hằng tự thụ dụng pháp lạc rộng lớn”. [X. Phẩm Bồ Tát Kinh Duy Ma; Nhiếp Đại Thừa Luận Thích Q.13 (bản dịch đời Lương].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lại", "definition": "法吏. Viên chức hạng dưới, coi sóc tù nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Lạp", "definition": "Cũng gọi Pháp Tuế, Hạ Lạp, Pháp Hạ, Giới Lạp, Tăng Lạp, Tọa Lạp, Tọa Hạ Pháp Lạp. Chỉ cho số tuổi hạ của chúng tăng từ sau khi thụ giới Cụ Túc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lập", "definition": "Pháp Lập (?-?). Cao tăng Trung Quốc, sống vào đời Tấn. Khoảng thời gian vua Huệ Đế và Hoài đế trị vì (290-311), sư và sư Pháp Cự cùng dịch Kinh Pháp Cú Dụ và Kinh Phúc Điền. Riêng sư có dịch các kinh nhỏ hơn trăm loại, nhưng phần lớn đã bị thất lạc trong loạn Vĩnh Gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Lệ", "definition": "法例. Lề lối cách thức Lề lối áp dụng luật pháp quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Lệnh", "definition": "法令. Cái lệnh do luật lệ quốc gia mà có, mọi người trong nước phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Lệnh Biệt Hành", "definition": "法 令 别 行. Dùng cách thức riêng để truyền trao đạo pháp, chỉ cho thiền pháp “Bất lập văn tự, giáo ngoại biệt truyền”. Đoạn Tế Tâm Yếu ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Lợi", "definition": "Benefits of the law", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Lực", "definition": "法力. Sức mạnh giáo lí nhà Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Minh", "definition": "Dharmaprabhāsa (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Minh Như Lai", "definition": "Xem Pháp Minh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Mãn", "definition": "法 滿. Thiền tăng đời Ngũ Đại, đến núi Ba Tiêu học đạo với Thiền Sư Huệ Thanh, nối pháp làm truyền nhân tông Quy Ngưỡng. Sư ở núi U Cốc, Hồng Châu (Nam Xương, Giang Tây). Có vị tăng hỏi: “Thế nào là đạo?” Sư đáp:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Mênh", "definition": "I.Pháp Mệnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Môn", "definition": "Dharmaparyāya (S), Amṛta-dvara (S), Hōmon (J), Dharma Gate.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Môn Bí Sự", "definition": "(秘事法門, Hijihōmon): tên gọi của tập đoàn tín ngưỡng giả thác vào giáo nghĩa của Tịnh Độ Chơn Tông. Đó là Pháp Môn Che Giấu (御藏法門, Ngự Tàng Pháp Môn), Pháp Môn Che Giấu Trong Đất (土藏法門, Thổ Tàng Pháp Môn), Pháp Môn Trong Nhà Kho (庫裏法門, Khố Lí Pháp Môn), Pháp Môn Trong Đêm (夜中法門, Dạ Trung Pháp Môn), Pháp Môn Nội Pháp (內法法門, Nội Pháp Pháp Môn), Nội Chứng Giảng (內証講), Iwazu Giảng (いわず講), Pháp Môn Giờ Sửu (丑の時法門), v.v., vẫn tồn tại từ thời Trung Đại cho đến ngày nay. Khuynh hướng toàn thể có thể nói là tính bí mật, tính cưỡng ép, vốn có ảnh hưởng của Dòng Lập Xuyên (立川流) vốn cường điệu hóa cho rằng nam nữ hợp thể là Tức Thân Thành Phật (卽身成佛, thành Phật ngay chính nơi thân này), được thực hành từ khoảng đầu thời Liêm Thương (鎌倉, Kamakura, 1185-1333). Người được xem như là Tổ của Pháp Môn Bí Sự có liên quan đến Chơn Tông là Thiện Loan (善鸞, Zenran), con của Thân Loan (親鸞, Shinran), đã bị phụ thân tuyệt tình vì chủ thuyết dị đoan. Tính chất bí mật trong tư tưởng của Thiện Loan như thế nào thì cũng không rõ lắm. Sau đó, trong điều thứ 18 của cuốn Cải Tà Sao (改邪鈔) do Giác Như (覺如, Kakunyo), Tổ đời thứ 13 của Bổn Nguyện Tự (本願寺, Hongan-ji) trước tác dưới thời Nam Bắc Triều, có ghi rằng tà nghĩa vào thời ấy có Pháp Môn Trong Đêm (夜中法門, Dạ Trung Pháp Môn), cũng có người của Thánh Đạo Môn vốn phản đối Chơn Tông, mà tuyên thuyết giống như “Di Đà tự thân, duy tâm Tịnh Độ”. Lại nữa, trong bản Phản Cố Lí Thư (反故裏書) do Hiển Thệ (顯誓), cháu của Liên Như (蓮如, Rennyo), viết vào năm 1568 (Vĩnh Lộc [永祿] 11), cũng có đề cập rằng Như Đạo (如道[導], Nyodō), môn hạ của Giác Như, ở Đại Đinh (大町, Ōmachi), Việt Tiền (越前, Echizen) chủ trương Pháp Môn Bí Sự nên bị đuổi đi; rồi Đạo Tánh (道性) ở Hoành Việt (橫越, Yokogoshi), Như Giác (如覺, Nyokaku, Thành Chiếu Tự [誠照寺, Jōshō-ji]) ở Chinh Ốc (鯖屋, Sabaya), Trung Dã Phường Chủ (中野坊主, tức Tịnh Nhất [淨一], Chuyên Chiếu Tự [專照寺, Senshō-ji]) cũng cổ xúy pháp môn này, được gọi là “Chúng Tam Môn Đồ không lễ bái (三門徒拝まずの眾)” và vẫn còn duy trì cho đến ngày nay. Dưới thời Trung Đại, thực tế Pháp Môn Bí Sự này được tiến hành như thế nào thì không rõ lắm. Đến thời Cận Đại, phần lớn pháp môn này bị chính quyền Mạc Phủ xử phạt, cấm đoán. Những vụ xét xử trứ danh nhất diễn ra ở kinh đô Kyoto, Nhiếp Tân (攝津, Settsu), Hà Nội (河內, Kawachi) vào năm 1757 (Bảo Lịch [寶曆] 7); ở Giang Hộ (江戸, Edo), Quan Đông (關東, Kantō), Áo Vũ (奥羽, Ōu) vào năm 1767 (Minh Hòa [明和] 4); ở Đại Phản (大阪, Ōsaka) vào năm 1788 (Thiên Minh [天明] 8); ở kinh đô Kyoto vào năm 1797 (Khoan Chính [寛政] 9), v.v. Mãi cho đến hiện tại, vẫn có những báo cáo về sự hiện hữu của Pháp Môn Bí Sự này; như trường hợp Nội Pháp Giáo Đoàn (內法敎團) ở địa phương Thủy Trạch Thị (水澤市, Mizusawa-shi) cũng như Đảm Trạch Quận (胆澤郡, Isawa-gun, thuộc Iwate-ken [岩手縣]); hay ở Mễ Nguyên Đinh (米原町, Maihara-chō, thuộc Shiga-ken [滋賀縣]), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Môn Sừ Quĩ", "definition": "Tác phẩm, 1 quyển, do ngài Bạch Nham Tịnh Phù thuộc Tông Tào Động soạn vào đời Thanh, được thu vào Vạn Tục Tạng tập 147.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Môn Sừ Quỹ", "definition": "法 門 鋤 軌. Sách, 1 quyển, do Bạch Nham Tịnh Phù (Thiền tăng tông Tào Động) soạn vào đời Thanh, được xếp vào Tục Tạng Kinh tập 147, trang 683. Tác giả trình bày về lịch sử tông Vân Môn và tông Pháp Nhãn cùng vấn đề pháp hệ của Thiền Sư Thiên Hoàng Đạo Ngộ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Môn Thanh Thức Nhị Thập Tứ Điều", "definition": "Chỉ cho bộ Tăng chế do ngài Thích Đạo an soạn. Nội dung gồm 3 phần:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Môn Tự", "definition": "Chùa ở trấn Sùng Chính, huyện Phù Phong, tỉnh Thiểm Tây, do bảo tồn xá lợi của Đức Phật mà nổi tiếng, nhưng không rõ được sáng lập năm nào.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Môn Vô Lượng", "definition": "Số pháp môn nhiều vô cùng không thể kể xiết. Chính vì vậy mà người Phật tử không nên cố chấp, chỉ đề cao pháp môn tu học của mình, còn thì mạt sát, dèm pha pháp môn tu học của những người khác. Phật tử tu hạnh Bồ Tát, phát ra bốn lời thề nguyện lớn như sau:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pháp Môn Đại Nghĩa", "definition": "Cũng gọi Đại Thừa Đại Nghĩa Chương, Cưu Ma La Thập Pháp Sư Đại Nghĩa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Mạn Đa La", "definition": "Dharmamaṇdala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Mạn Đồ La", "definition": "Phạm: Dharma-maịđala.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Mẫn", "definition": "Pháp Mẫn (579-645).Cao tăng Trung Quốc, sống vào đời Đường, người Đơn Dương, họ Tôn. Sư xuất gia năm 8 tuổi, lúc đầu theo học Thiền Sư Anh, sau, vào núi Mao sơn nghe Pháp Sư Minh giảng Tam Luận. Năm 23 tuổi, sư nghe ngài Thực công, người Cao Li, thuyết giảng. Sau khi ngài Thực Công thị tịch, gặp lúc loạn lạc ở cuối đời Tùy, nên sư ẩn tu. Ba năm sau, sư đến Chiết Giang, trụ ở chùa Lương an, giảng Kinh Pháp Hoa và Tam Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Mật Bộ", "definition": "Xem Đàm Vô Đức.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Một Thời Thất Uế Hành", "definition": "法沒時七穢行 (Xuất Hiện Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Một Tướng Một Vị", "definition": "Law of one and the same essence", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Nghiêm", "definition": "Pháp, gọi đủ là Bí Pháp, Diệu Pháp, Kì Đảo Pháp. Khi tu các pháp này đều có hiệu nghiệm thì gọi là Pháp Nghiệm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Ngoạn", "definition": "(法玩, Hōgan, 715-790): vị tăng của Bắc Tông Thiền, người đất Ngụy, họ Trương (張). Năm lên 18 tuổi, ông theo hầu Phổ Tịch (普寂) và đến năm 20 tuổi thọ Cụ Túc giới. Ông chuyên hóa đạo ở Lạc Dương (洛陽), Tung Sơn (嵩山). Môn nhân của ông có nhiều người, và đến ngày 13 tháng 8 năm thứ 6 niên hiệu Trinh Hòa (貞和), ông thị tịch tại Kính Ái Tự (敬愛寺), hưởng thọ 76 tuổi đời và 57 hạ lạp. Năm sau, tháp của ông được xây dựng tại Thiếu Lâm Tự (少林寺); Lý Sung (李充) soạn ra Đại Đường Đông Đô Kính Ái Tự Cố Khai Pháp Lâm Đàn Đại Đức Pháp Ngoạn Thiền Sư Tháp Minh (大唐東都敬愛寺故開法臨壇大德法玩禪師塔銘).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Nguyệt", "definition": "Pháp Nguyệt (653-743).Phạm: Dharmacandra.Hán âm: Đạt Ma Chiến Niết La.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Ngã", "definition": "Cũng gọi Pháp Ngã Chấp, Pháp Ngã Kiến, Pháp Chấp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Ngã Câu Hữu Tông", "definition": "Cũng gọi Ngã Pháp Câu Hữu Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Ngã Kiến", "definition": "Một trong hai loại ngã kiến. Pháp ngã kiến là thấy pháp tức sự vật là có ngã, có thực thể. Còn nhân ngã kiến, là thấy trong con người (thân năm uẩn), có ngã, có cái ta thực, như linh hồn v.v…", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pháp Ngôn", "definition": "法言. Lời nói hợp với phép tắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Ngữ", "definition": "Hōgo (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhiên", "definition": "Honen Shonin (J), Pháp Nhiên Thượng Nhân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhân", "definition": "法人. Danh từ luật pháp, chỉ một tổ chức, đoàn thể, có đầy đủ nghĩa vụ và quyền lợi trước pháp luật như một cá nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Nhân Đại Sư", "definition": "法 因 大 師. Hiệu của Thiền tăng Đạo Khuông, đời Ngũ Đại. X. Đạo Khuông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Nhãn", "definition": "Dhammacakkhu (P), Eye of Dhamma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhãn Thiền Sư Tông Môn Thập Quy Luận", "definition": "(法眼禪師宗門十規論, Hōgenzenjishūmonjukkiron): xem Tông Môn Thập Quy Luận (宗門十規論, Shūmonjukkiron) (宗門十規論, Shūmonjukkiron): 1 quyển, do Pháp Nhãn Văn Ích (法眼文益) nhà Đường trước tác, san hành năm thứ 6 (1756) niên hiệu Bảo Lịch (寳曆), nói cho đủ là Pháp Nhãn Thiền Sư Tông Môn Thập Quy Luận (法眼禪師宗門十規論, Hōgenzenjishūmonjukkiron), Tịnh Từ Pháp Nhãn Thiền Sư Tông Môn Thập Quy Luận (淨慈法眼禪師宗門十規論, Jōjihōgenzenjishūmonjukkiron) và gọi tắt là Thập Quy Luận (十規論, Jukkiron). Tác giả vốn là vị tổ khai sáng Pháp Nhãn Tông (法眼宗), đã từng cử xướng tông phong của mình rất mạnh từ cuối thời nhà Đường cho đến Ngũ Đại. Đây là tác phẩm nêu rõ 10 quy luật của tông môn để khuyên răn môn đồ tu tập, rất nổi tiếng như là tác phẩm đầu tiên nêu tên các tông phái của Ngũ Gia. Có bản năm thứ 6 (1346) niên hiệu Chí Chánh (至正) Trung Quốc, bản năm đầu (1648) niên hiệu Khánh An (慶安) Nhật Bản, v.v. Truyền bản hiện tồn có 2 loại: bản do Đại Viên Bảo Giám (大圓寳鑑) của Mậu Lâm Tự (茂林寺) vùng Thượng Dã (上野, Ueno, thuộc Gunma-ken) san hành vào thứ 6 (1756) niên hiệu Bảo Lịch, và bản do Chỉ Nguyệt Huệ Ấn (指月慧印) san hành vào năm thứ 11 (1761) cùng niên hiệu trên. Ngoài ra còn có bản tăng bổ chú thích của Năng Nhân Nghĩa Đạo (能仁義道).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Nhãn Tông", "definition": "Tông Pháp Nhãn : là một trong “năm nhà bảy tông” của Thiền Tông Trung-quốc, do thiền sư Văn Ích (885-958) làm tổ khai sáng, thuộc pháp hệ của ngài Thanh Nguyên Hành Tư. Ngài Văn Ích, sau khi đắc pháp với ngài Quế Trác (867-928) ở Chương-châu (tỉnh Phúc-kiến), đã cực lực xiển dương thiền học, trú tích tại đạo tràng Thanh-lương (núi Thạch-đầu, gần Nam-kinh), khai sáng thiền phái, thiền phong chấn thạnh, ảnh hưởng lớn khắp các vùng từ Triết-giang đến Phúc-kiến. Tông này cực thịnh vào đầu đời Tống, sau đó thì suy vi dần, rồi tuyệt tích tại Trung-quốc; trước sau hành hoạt trong khoảng trăm năm. Trong khi đó, thiền phong tông Pháp Nhãn lại được quảng bá ở Triều-tiên, đến nay vẫn còn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Nhãn Tạng", "definition": "法 眼 藏. Gọi đủ: Chính Pháp Nhãn Tạng. Chỉ cho đạo pháp giáo ngoại biệt truyền của Thiền gia. Chương Hạc Lặc Na Tổ thứ 23 trong CĐTĐL, q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Nhãn Tịnh", "definition": "Dharmacakṣuvyudha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhãn Tứ Cơ", "definition": "Chỉ cho 4 cơ pháp của Tông Pháp Nhãn được dùng để chỉ dẫn người học.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Nhãn Viên Thông", "definition": "Fa yun Yuan t'ung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhãn Văn Ích", "definition": "Fa-yen Wen-i (C), Dosen Bin'eki (J), Fayan Wenyi (C),Hōgen-Bun'eki (J), Fa-yen Wen-i (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhãn Văn Ích Thiền Sư Ngữ Lục", "definition": "Gọi đủ: Kim Lăng Thanh Lương Viện Văn Ích Thiền Sư Ngữ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Nhĩ", "definition": "Là một thuật ngữ Phật học. Chữ “nhĩ” (爾) ở đây có nghĩa là tự nhiên như vậy, không do ai tự ý đặt ra. “Pháp Nhĩ” nghĩa là các pháp tự nhiên như vậy, tự chúng là như thế, không do ai tạo tác cả. Về phương diện tồn tại thì các pháp đều do nhân duyên hòa hợp mà thành, dù nước có sâu tới đâu, dù lửa có cao tới đâu, vẫn là việc tự nhiên như thế. Về tính chất, đất đá thì rắn chắc, nước thì lưu nhuận, lửa thì nóng, gió thì giao động, các pháp tự nhiên như vậy. Về bản thể chân như, thể tánh các pháp vốn thường hằng bình đẳng như vậy.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Nhũ", "definition": "Sữa pháp. Ví dụ hương vị của chính pháp nuôi lớn Pháp Thân của người tu hành Phật đạo, cũng như sữa mẹ nuôi lớn con trẻ, nên gọi là Pháp nhũ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Như", "definition": "Pháp Như (638-689). Thiền Sư Trung Quốc, sống vào đời Đường, người Thượng Đảng (huyện Trường Trị, tỉnh Sơn Tây), họ Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Nhất", "definition": "法 一 (1858-1931). Tăng nhân cận đại, họ Ôn, tên Cực Như, người Tùy Châu, Hồ Bắc, Trung Quốc. Niên hiệu Quang Tự thứ 13 đời Thanh (1887), sư xuất gia ở chùa Bảo An nơi quê nhà. Năm sau sư thụ giới cụ túc nơi chùa Bồ Đề, gặp Thiền Sư Hà Sơn mới biết tham thiền. Lại đến chùa Kim Sơn ở Trấn Giang tham kiến Hoà thượng Đại Định. Sau đó nơi chùa Hải Huệ ở Hồ Bắc, sư tọa thiền nhiều năm, sớm tối tụng kinh Lăng Nghiêm hơn ngàn bộ, nhờ vậy mà thấu suốt nguồn pháp, không còn nghi trệ. Năm 1914 nhậm chức Thủ tọa chùa Cao Mân. Năm 1919, sư đến núi Sư Tử ở Giang Phố giảng kinh, tọa hương tham thiền, cũng như thế tại chùa Cao Mân, chùa Kim Sơn. Tác phẩm: Tham Thiền Giản Lục, Tham Thiền Đề Yếu, Kim Cang Kinh Giảng Lục, Pháp Ngữ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Nhẫn", "definition": "Nhẫn là chỉ cho sự chịu đựng những cảnh trái ngược mà trong lòng không sinh khởi sân hận. Còn Pháp Nhẫn là đối với các pháp nghĩa sâu xa, mầu nhiệm được nói trong các kinh, chẳng những không sợ hãi mà còn siêng năng học tập, đọc tụng. Là 1 trong Nhị Nhẫn, 1 trong Tam Nhẫn, 1 trong Lục Nhẫn, 1 trong Thập Nhẫn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Nhập", "definition": "Dharma-ayatna (S), Dharma receptor.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nhị Chủng Thuyết", "definition": "二種說法 (Bảo Tánh Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Ninh", "definition": "法 寧 (1081-1156). Thiền tăng đời Tống, họ Lý, người Cử huyện, Mật Châu (Sơn Đông), Trung Quốc. Do ở núi Ô Kỳ, Nghi Châu nên pháp hiệu của sư là “Ô Kỳ”. Ban đầu sư theo Hòa Thượng Diệu Không Minh chùa Thiên Ninh đắc độ, tham học khá lâu trọn được tông chỉ Vân Môn. Về sau trụ chùa Tịnh Cư, hoằng dương đạo của Tuyết Đậu. Niên hiệu NguyênPhú (1098-1100) sư trụ tinh xá Linh Phong núi Xà Sơn ở Hoa Đình (Tùng Giang, Thượng Hải). Sau đó tinh xá đổi thành thiền viện Chiêu Khánh, Hữu thừa tướng Chu Ngạc thỉnh sư làm Tổ khai sơn, đồ chúng đông đảo, thạnh nhất đông nam.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Niệm Xứ", "definition": "Dhammanupassana (P), Contemplation of mind, Dharma-smṛty-upasṭhāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Nạn", "definition": "Cũng gọi Báng Phật, Báng Pháp, PháPhật, Vương Nạn, Hủy Pháp, Phế Thích, Phế Phật, Diệt Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Nạn Hội Xương", "definition": "(會昌法難, Kaishō-no-hōnan, Eshō-no-hōnan): vụ pháp nạn do Võ Tông (武宗, tại vị 840-846) nhà Đường tiến hành đàn áp Phật Giáo từ năm thứ 3 (843) đến năm thứ 4 (844) niên hiệu Hội Xương (會昌). Ông ban hiệu lịnh đi khắp thiên hạ, phá hủy các tự viện và phế bỏ tăng ni buộc phải hoàn tục. Trong lịch sử Phật Giáo Trung Quốc, có các pháp nạn Tam Võ Nhất Tông (三武一宗), như Võ Đế của Bắc Ngụy, Võ Đế của Bắc Chu, Thế Tông của Hậu Chu; pháp nạn này được xem là có quy mô và triệt để nhất. Đây là lần tổng quyết toán hạn chế, đình chỉ toàn bộ tăng ni các tự viện; đối với Phật Giáo, vụ pháp nạn này đã giáng một đòn khốc liệt, bi thảm chưa từng có. Nguyên nhân là vì vấn đề kinh tế của quốc gia, sự hủ bại trụy lạc của tăng ni trong giáo đoàn, và sự hoành hành của chúng tăng ngụy lạm tự xuất gia cũng như thọ giới; cho nên triều đình đã tiến hành một cách triệt để đối với Phật Giáo, trừ Đạo Giáo ra. Sự kiện này được ghi rõ trong Cựu Đường Thư (舊唐書), cũng như điều khoản năm thứ 4 niên hiệu Hội Xương của Võ Đế Bổn Ký (武宗本記) 18; qua đó chúng ta có thể biết được rằng Võ Đế có tín ngưỡng đối với Đạo Giáo hơn. Ngoài ra, trong quyển 4 của bộ Nhập Đường Cầu Pháp Tuần Lễ Hành Ký (入唐求法巡禮行記) của Từ Giác Đại Sư Viên Nhân (慈覺大師圓仁) cũng ký thuật chi tiết về vụ pháp nạn này.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Phong Sa Môn", "definition": "Xem Pháp Hộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Pháp Tánh Phân Biệt Luận", "definition": "Dharmadarmata-vibhaṅga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Pháp Tính Phân Biệt Luận", "definition": "Phạm: Dharmadharmatà-vibhaíga, hoặc Dharmadharmatà-vibhàga.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Phảng", "definition": "Pháp Phảng (1904-1951). Danh tăng Trung Quốc thời hiện đại, người huyện Hình, tỉnh Hà Bắc, họ Vương. Năm 18 tuổi (1921), sư theo Trưởng Lão Thị Ngạn ở núi Nam Nhạc xuất gia, sau đến chùa Pháp Nguyên y vào Pháp Sư Đạo Giai thụ giới Cụ Túc. Năm 1922, sư đến học tại viện Phật học Vũ Xương, được gần gũi Đại Sư Thái Hư. Sau khi tốt nghiệp, sư lần lượt làm giáo sư ở viện Phật học Vũ Xương, Viện Giáo Lí Bách Lâm, viện giáo lí Hán Tạng, 3 lần làm chủ biên tạp chí Hải Triều Âm, chủ trì thư viện Phật Học Uyển Thế Giới, trợ giúp Đại Sư Thái Hư 1 cách đắc lực trong việc thiết lập bộ Nghiên Cứu Của Viện Phật Học Thế Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Phục", "definition": "法服. Quần áo do luật lệ quy định Áo của các vị tăng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Quan", "definition": "法官. Viên chức xét xử mọi việc theo luật lệ quốc gia, tức quan tòa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Quang", "definition": "法 光 (809-869). Thiền tăng đời Đường, họ Lương, người Trường Ninh (nay là Tân Phong, Quảng Đông) Trung Quốc. Sư nối pháp thiền sư Thiện Đạo, thuộc hệ Thanh Nguyên đời thứ 4, trụ viện Đan Thạch.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Quy", "definition": "法規. Luật lệ phép tắc phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Quyến", "definition": "Cũng gọi Đồng Môn, Đồng Tham, Pháp Thuộc, Pháp Thân, Pháp Duyên, Đạo Hữu, Đạo Cựu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Quán Tưởng Mặt Trời", "definition": "Method of concentration on visualizing the sun.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Quả", "definition": "Pháp Quả (?-?). Cao tăng Trung Quốc, sống vào thời Bắc Ngụy, người Triệu quận (huyện Triệu, tỉnh Hà Bắc).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Quảng", "definition": "法 廣 (1300-1364) (156 TKTNVC). Thiền tăng đời Nguyên, họ Ngũ, tự Dật Sơ, người xứ Trinh Dương, Lĩnh Nam (Anh Đức, Quảng Đông) Trung Quốc. Nối pháp Thiền Sư Giáp Sơn, Liễu Mai, đời thứ 23 hệ Thanh Nguyên. Trụ trì chùa Kim Sơn (Trấn Giang, Giang Tô). Tác phẩm: Hội Yếu Tập.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Quốc", "definition": "法國. Nước Pháp (France).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Sai Biêt Tương Vi Quá", "definition": "Cũng gọi Pháp Sai Biệt Tương Vi Nhân (Phạm: Dharma-vizewa-viruddha-hetu). Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Siêu", "definition": "Pháp Siêu (456-526). Cao tăng Trung Quốc, sống vào thời Nam Triều, người Vô tích, Tấn lăng (thuộc tỉnh Giang Tô), họ Mạnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Sư", "definition": "Dharmabhanaka (S), Master of Discourse.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Sư Bồ Tát", "definition": "Dharmika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Sư Thập Đức", "definition": "Mười đức của vị Pháp Sư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Số", "definition": "Cũng gọi Danh Số, Sự Số.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Số Danh Tập Kinh Dị Bản", "definition": "Dharmasaṃgraha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Sự", "definition": "法事. Việc tu hành của tăng ni Việc cúng bái của thầy cúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Sự Tán", "definition": "Cũng gọi Tịnh Độ Pháp Sự Tán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Than", "definition": "Dharma body", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Thao", "definition": "法 瑫. Thiền tăng đời Ngũ Đại, học đạo với Thiền Sư Trường Khánh Huệ Lăng đắc pháp. Sư ở chùa Khuynh Tâm, Hàng Châu, về sau dời sang chùa Long Sách rồi tịch. Ngô Việt Vương ban hiệu “Tông Nhất Thiền Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Thi Thiền Sư", "definition": "法 施 禪師. Hiệu của Thiền tăng Sách Chân, sống vào đời Ngũ Đại. X. Sách Chân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Thiên", "definition": "(Dharmadeva, ?-1001). Ngài người Trung Ấn-độ, xuất thân từ chùa Na-lan-đà ở nước Ma-kiệt-đà. Năm 973 (dưới triều vua Tống Thái-tổ) ngài đến Trung-quốc. Mới đầu ngài trú tại Lộc-châu (nay là huyện Thủy-tế, tỉnh Sơn-tây), dịch được bộ Thánh Vô Lượng Thọ Kinh và Thất Phật Tán. Đến năm 980, ngài được các quan viên địa phương dâng sớ tiến cử lên vua Tống Thái-tông. Vua mừng lắm, cho mời ngài về kinh đô. Nhân đó, nhà vua cho xây Dịch-kinh viện tại chùa Thái-bình-hưng-quốc. Năm 982, viện Dịch-kinh xây xong, nhà vua ban sắc mời ngài, cùng với hai ngài Thi Hộ và Thiên Tức Tai, đều vào cư trú tại Dịch-kinh viện để chuyên việc dịch kinh. Ngài đã dịch được bộ Đại Thừa Thánh Cát Tường Trì Thế Đà La Ni Kinh, được vua ban hiệu là Truyền Giáo đại sư. Năm 1001 (dưới triều vua Tống Chân-tông, 998-1022) ngài viên tịch, thụy hiệu là Huyền Giác đại sư. Từ năm 980 đến năm 1000, ngài đã dịch cả thảy 46 bộ kinh, gồm 71 quyển.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Thiện", "definition": "Dharmapriya (S), Fa chan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thiệt", "definition": "Xem Đàm Đế.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thoại", "definition": "Dharma talk.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thuyền", "definition": "I.Pháp Thuyền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thuận", "definition": "Fashun (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thuật", "definition": "法術. Cách trị nước Tài bói toán hoặc trừ tà ma của thầy bói, thầy cúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Thuộc", "definition": "法 屬. Còn gọi: Pháp Quyến. Tăng nhân có quan hệ thân thuộc trong sự truyền thừa Phật pháp. Tiết Long Tường Sĩ Khuê Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Thuỷ", "definition": "法水. Nước phép, của các tôn giáo hoặc thầy cúng, có công dụng ban phúc lành hoặc chữa bệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Thành", "definition": "Chính Pháp có thể chặn đứng tà pháp, giống như thành trì có năng lực ngăn ngừa giặc ngoại xâm, cho nên gọi là Pháp thành. Do đó, tất cả kinh pháp cũng gọi là Pháp thành, vì kinh pháp có khả năng giữ gìn chính pháp. Lại nữa, diệu quả Niết Bàn là nơi yên thân, nên cũng gọi là Pháp thành. Kinh Vô Lượng Thọ quyển thượng (Đại 12, 366 thượng) nói: “Giữ vững pháp thành, mở rộng pháp môn, rửa sạch ô uế, trong sáng thanh tịnh, Phật Pháp rực rỡ, lưu bố chính pháp, hóa độ chúng sinh”. [X. Phẩm Phật Quốc Kinh Duy Ma; Vô Lượng Thọ Kinh Nghĩa Sớ (Tuệ Viễn)].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thái", "definition": "Pháp Thái (?-?). Cao tăng Trung Quốc, sống vào đời Lương, Trần thuộc Nam Triều, trụ ở chùa Định Lâm tại Kiến Khang (nay là Nam Kinh, Giang Tô), nổi tiếng ở đời Lương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân", "definition": "Là một trong ba thân của Phật. Đó là cái thân chân thật của Phật, lấy chánh pháp làm thể, cho nên gọi là “pháp thân”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Thân Bồ Tát", "definition": "Cũng gọi Pháp Thân Đại Sĩ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Của Pháp Tánh", "definition": "Dharmatā-dharmakāya (S), Dharma-body of Dharma-nature, Hossho hosshin (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thân Kê", "definition": "Cũng gọi Pháp Xá Lợi, Pháp Tụng Xá Lợi, Pháp Thân Xá Lợi Kệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Kí", "definition": "Đối lại: Ứng Thân Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Như Lai", "definition": "Chỉ cho tự tính chân thân của Phật. Pháp Thân tuy không đi lại, nhưng ẩn chứa trong Như Lai Tạng mà hiển hiện làm Pháp Thân, cho nên gọi là Pháp Thân Như Lai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Pháp", "definition": "Tháp thờ Pháp Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Quán", "definition": "Pháp quán xét Pháp Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Thuyết Pháp", "definition": "Đối lại: Gia Trì Thân Thuyết Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thân Đại Sĩ", "definition": "Tức là Bồ-tát Pháp-thân. (Xem mục “Bồ Tát Pháp Thân”.)", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Thí", "definition": "Dharma Dāna (S), Giving Dharma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thông Thiện Hỷ", "definition": "法 通 善 喜. Thiền tăng đời Nguyễn, thuộc phái thiền Tào Động thế hệ thứ 36, là tổ khai sơn chùa Long ẩn. Chùa này được xây dựng trên núi Long ẩn thuộc thôn Tân Lại, huyện Phúc Long, dinh Trấn Biên, miền Nam Việt Nam (nay là xã Tân Bửu, thành phố Biên Hòa), nằm bên mặt đường liên tỉnh từ Biên Hòa lên thác Trị An (cách Biên Hòa 4km). Sau khi Tổ Pháp Thông Thiện Hỷ thị tịch, đồ chúng lập tháp ở phía trước sân chùa, nằm về phía bên phải. Tháp xây theo hình khối lục giác, tầng cuối cùng mỗi cạnh 2m. Tháp cao 4 tầng với đỉnh là một hồ lô, tính chung cao khoảng 6m. Phía trong tháp có một bia đá lớn (có thể kể về sự tích của Tổ Pháp Thông), phía ngoài có cửa vào (Nhưng năm 1972, Giáo thọ Thiện Hỷ đã xây kín cửa vào bên trong tháp nên hiện chưa rõ được nội dung của tấm bia này). Theo: LSPGĐT của Nguyễn Hiền Đức.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Thú Đại Luận", "definition": "Patthana-mahāpakarana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thường", "definition": "法 常 (752-839). Thiền tăng đời Đường, họ Trịnh, hiệu Đại Mai, người Tương Dương (Tương Phàn, Hồ Bắc), Trung Quốc. Sư xuất gia từ thuở nhỏ ở chùa Ngọc Tuyền, Kinh Châu (Giang Lăng, Hồ Bắc). Năm 20 tuổi thụ giới cụ túc tại chùa Long Hưng. Sư để tâm vào thiền nên đến tham kiến Mã Tổ Đạo Nhất, hỏi: “Thế nào là Phật?” Tổ đáp: “Tức tâm tức Phật”. Sư liền đại ngộ, kế thừa pháp Mã Tổ. Về sau sư ẩn cư tĩnh tu nơi núi Đại Mai, huyện Ngân (Chiết Giang). Có vị tăng theo lệnh Mã Tổ đến núi Đại Mai nói với sư: “Gần đây Mã Tổ lại nói phi tâm phi Phật”. Pháp Thường nói: “Ta chỉ biết tức tâm tức Phật”. Mã Tổ nghe được bèn nói: “Trái mai đã chín!” Từ đó tiếng tăm của sư lẫy lừng, học giả khắp nơi tụ hội.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Thường (567-645)", "definition": "I.Pháp Thường (752-839).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thượng", "definition": "Dharmottara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thượng Bộ", "definition": "(Dharmottariyah) - Hiền Trụ Bộ (Bhadrayanika) - Chánh Lượng Bộ (Sammatiya) - Mật Lâm Sơn Bộ (Sandagari-ka). “Pháp Thượng” nghĩa là pháp đáng được tôn kính, cũng có nghĩa, đối với chúng nhân trong thế gian, pháp là tối thượng; đó là tên của vị tổ sáng lập ra Pháp Thượng Bộ. “Hiền Trụ” nghĩa là hàng hậu duệ của A-la-hán Hiền. “Chánh Lượng” nghĩa là thẩm định phải quấy, chân ngụy một cách chính xác, không sai lầm. Có thuyết nói Chánh Lượng Bộ là các đệ tử của A-la-hán Đại Chánh Lượng, nên cũng có tên là Chánh Lượng Đệ Tử Bộ; hoặc cũng có thuyết nói, vị tổ của bộ phái này tên là Sammata, nên bộ phái này được đặt tên là Sammatiya, tức Chánh Lượng Bộ. “Mật Lâm Sơn” nghĩa là núi có rừng cây rậm rạp; đó là nơi cư trú của vị sáng tổ, nên bộ phái được đặt tên như vậy.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Thạnh Thiền Sư", "definition": "Fa-chen (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thần", "definition": "Đồng nghĩa: Pháp Tướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thắng", "definition": "Dharmaśrī (S), Dharma-Sreathin (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thể", "definition": "Svabhāva (S), Self-nature, Sabbāva (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thể Hằng Hữu", "definition": "Pháp thể thường có. Nghĩa là thực thể của tất cả các pháp thường hằng tồn tại trong 3 thời quá khứ, hiện tại và vị lai.Thuyết Nhất Thiết Hữu Bộ chủ trương “ba đời thực có, pháp thể hằng có”, nghĩa là những yếu tố cấu tạo thành sự tồntại của các hiện tượng và mối quan hệ giữa chúng có thể được khảo sát qua 3 phương diện như sau:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thịnh", "definition": "Pháp Thịnh (?-?). Cao tăng Trung Quốc, sống vào thời Bắc triều, người Lũng Tây (tỉnh Cam Túc).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thời", "definition": "(Tức Đàm Ma Ca La, Dharmakala, ?-?). Ngài là người Trung Ấn-độ, thiên tư mẫn tuệ từ thuở nhỏ, thông hiểu Tứ Phệ Đà, tự cho văn lí trong thiên hạ đều chứa hết trong bụng mình. Về sau, một hôm đọc được bộ A Tì Đàm Tâm Luận, thì lòng dạ ngơ ngác, chẳng hiểu gì cả, bèn thỉnh một vị tì kheo nhờ giảng giải cho. Nghe xong bỗng nhiên tỏ ngộ, thấy rõ diệu lí nhân quả suốt cả ba đời. Từ đó ngài bỏ hết lạc thú thế tục, xuất gia theo Phật giáo, tinh tấn tu học, chẳng bao lâu thông suốt kinh điển đại tiểu thừa, lại vững vàng cả giới luật. Năm 222 đời vua Ngụy Văn đế (220-226), ngài đến Trung-quốc, ở tại kinh đô Lạc-dương của nước Tào-Ngụy. Ngài quan sát, thấy tăng chúng Trung-quốc chỉ cạo đầu và đắp y trơn (y của sa di), chứ không có luật pháp gì để hành trì, bèn phát nguyện hoằng truyền giới luật. Năm 250 (đời vua Ngụy Tề vương, tức Tào Phi) ngài dịch xong bộ Tăng Kì Luật Giới Bản, bèn thỉnh 10 vị Phạn tăng tác pháp yết ma, truyền trao giới luật. Tương truyền, vị tăng Trung-quốc đầu tiên được thọ giới là Chu Sĩ Hành (204-282 – Xem mục “Chu Sĩ Hành”). Pháp chế truyền giới ở Trung-quốc bắt đầu từ lúc đó. Hành trạng của ngài từ sau đó, không thấy tài liệu nào ghi chép.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Thủy", "definition": "(法水): nước pháp, có hai nghĩa chính.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Thức", "definition": "法式. Đường lối do luật lệ ấn định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Thực", "definition": "Thức ăn pháp. Có 3 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Thực Nhị Đồng Xá", "definition": "Xem Chùa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Thực Thường Bão", "definition": "法 食 常 飽. Dụ cho lãnh ngộ Phật pháp nên tinh thần no đủ. Bài thơ Đại Thừa Tán trong CĐTĐL, q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Thực Đồng Xá", "definition": "Xem Chùa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tiến", "definition": "Pháp Tiến (709-778). Cao tăng Trung Quốc, sống vào đời Đường, người Tín dương, Thân Châu (nay thuộc tỉnh Hà Nam), họ Vương, có thuyết cho là người Minh Châu (huyện Ngân, tỉnh Chiết Giang) là vị Tổ thứ 2 của Luật Tông Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tiểu Thừa", "definition": "Lesser Doctrines", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Toà", "definition": "Throne.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Toàn", "definition": "Pháp Toàn (?-?). Cao tăng Trung Quốc, sống vào đời Đường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Trung", "definition": "法 忠. 1. Thiền tăng đời Tống (1084-1149), họ Diêu, hiệu Mục Am, người Tứ Minh, Chiết Giang, Trung Quốc. Năm 19 tuổi xuất gia, siêng năng tu tập Thiên Thai giáo chỉ, ngộ được lý Nhất tâm tam quán. Tự biết mình chưa tỏ ngộ triệt để nên đi tham học các bậc danh đức tìm kiếm pháp thiền. Đến Long Môn thấy nước xoáy liền đại ngộ làm bài kệ trình lên Thiền Sư Phật Nhãn Thanh Viễn, được ấn khả làm truyền nhân tông Lâm Tế. Sau sư đến Lô Sơn ở tại Đồng An trong cây khô nhịn ăn tĩnh tọa, mọi người đều kinh ngạc. Niên hiệu Tuyên Hòa (1119-1125) dời sang ở Nam Nhạc, theo truyền thuyết sư thường cưỡi cọp đi chơi, mọi người hướng theo lễ bái, bốn chúng gọi sư là “Phục Hổ”. Về già, sư trụ núi Hoàng Long, Long Hưng (Nam Xương, Giang Tây). 2. Thiền tăng đời Minh (1541-1620), họ Tào, hiệu Kính Đương, người Thiệp huyện (An Huy), Trung Quốc. Năm 19 tuổi đi đến chùa Linh ẩn ở Hàng Châu xuất gia với Hòa Thượng Vân Thủy Đại Cơ. Đến 21 tuổi đăng đàn thụ giới cụ túc, hành cước đến Thiếu Lâm tham kiến Thiền Sư Đại Thiên Nhuận. Lại đến Trường An yết kiến hai đại lão Biến Dung và Nguyệt Tâm chỉ bày tâm yếu có chút khai ngộ. Chẳng bao lâu, sư trở về lễ Thiền Sư Diệu Phong tại Ngũ Đài, vừa gặp là tâm ấn tương khế. Sau đến Thiên Bình ở Lô Sơn, do thích thắng cảnh này nên ẩn cư tại đây. Vài năm sau thiền lữ tụ hội dần dần thành tùng lâm. Pháp Trung là người thẳng thắn, không bày vẽ, quản lý chúng không cần quy củ, cam khổ đồng chịu, ngoài một chiếc áo nạp không có gì nữa.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Truyền Thống", "definition": "Dhammanvaya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tràng", "definition": "Dharmavaja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tràng Phật", "definition": "Dharma Curtain Buddha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Trân", "definition": "Pháp Trân (?-?). Vị Tỉ Khưu Ni Trung Quốc, sống vào đời Nguyên, người đất Thục, họ Thôi, tên Pháp Trân, pháp danh Hoằng Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Trì", "definition": "Dharmadhāra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Trình", "definition": "法程. Đường lối khuôn mẫu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Trí", "definition": "Dharma-jñāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Trường", "definition": "法場. Nơi thi hành luật lệ quốc gia, tức nơi giết kẻ tử tội. Đoạn trường tân thanh có câu: “Ba quân đông mặt pháp trường, thanh thiên bạch nhật rõ ràng cho coi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Trần", "definition": "Pháp cảnh: là cảnh sở duyên của ý căn. Ý căn đối với các cảnh sở duyên của năm căn trước, phân biệt tốt xấu mà khởi lên các pháp thiện ác, gọi là pháp trần (hay pháp cảnh); những động tác thường ngày của chúng ta, tuy đã trở thành quá khứ, nhưng những ảnh tượng của trần cảnh vẫn được ghi nhớ, đó cũng tức là pháp trần; những hình ảnh hoàn toàn do tưởng tượng, không có trong thực tế (như lông rùa, sừng thỏ), chỉ có trong ý thức, cũng là pháp trần; cho đến những tư tưởng không có ảnh tượng gì cả, cũng đều là pháp trần.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Trị", "definition": "法治. Dựa trên luật lệ mà làm việc nước, đem lại sự yên ổn chung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Trụ", "definition": "I.Pháp Trụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Trụ Kí", "definition": "Phạm: Nandimitràvadàna.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Trụ Ký", "definition": "Nandimitravadāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Trụ Trí", "definition": "I.Pháp Trụ Trí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Trụ Tự", "definition": "Cũng gọi Tục Li Tự, Tiểu Kim Cương. Chùa ở núi Tục Li, quận Báo Ân, tỉnh Trung thanh bắc, Hàn Quốc, do Hòa Thượng Nghĩa Tín sáng lập vào năm 553, sau khi ngài từ Thiên Trúc cầu pháp trở về. Đây là 1 trong 31 bản sơn của Phật Giáo Hàn Quốc và là 1 trong 5 ngôi chùa lớn nhất nước.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tuớng Bồ Tát", "definition": "Dharmaketu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tài", "definition": "Đối lại: Thế tài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tài Vương Tử", "definition": "Chỉ cho vị Vương Tử vì gặp nhân duyên xấu ác mà lui mất Chính Tâm Trụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tánh", "definition": "Tức thể tánh hay bản tánh chân thật của các pháp. Bản tánh này không sinh không diệt, không biến đổi, thường hằng. Do đó, “pháp tánh” là một tên gọi khác của “chân như”; nó không phải là “hành”. Nó không thể nhận biết bằng ý thức phân biệt của phàm phu, mà chỉ thể nhập bằng tuệ giác vô phân biệt của các bậc thánh giả.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Tánh Tông", "definition": "Bhūtatatayāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tánh Tự", "definition": "(法性寺, Hosshō-ji): ngôi chùa hiện tọa lạc tại số 16 Chome (丁目), Hon-machi (本町), Higashiyama-ku (東山區), Kyōto-shi (京都市). Vào năm 925 (niên hiệu Diên Trường [延長] thứ 3), vị Tả Đại Thần Đằng Nguyên Trung Bình (藤原忠平, Fujiwara-no-Tadahira, 880-949) kiến lập nên chùa này, lấy tượng Lô Xá Na Phật (s: Vairocana, 盧舍那佛) làm tượng thờ chính. Đây là ngôi chùa của dòng họ Đằng Nguyên vốn có thế lực đương thời. Họ cung thỉnh vị Thiên Thai Tọa Chủ Pháp Tánh Phòng Tôn Ý (尊意, Soni, 966-940) làm tổ khai sơn của chùa. Từ đó về sau, nhờ sự trợ lực không ngừng của dòng họ này, chùa tiến hành xây dựng và tạc tượng Phật. Trong đó, công trình trứ danh đáng kể nhất là Ngũ Đại Đường (五大堂) được kiến lập vào năm 1006 (niên hiệu Khoan Hoằng [寛弘] thứ 3), nhân lễ Khánh Hạ 40 tuổi của Đằng Nguyên Đạo Trưởng (藤原道長, Fujiwara-no-Michinaga, 966-1027). Tượng thờ chính của ngôi viện này là tượng ngồi Bất Động Minh Vương (不動明王), hiện được an trí tại Đồng Tụ Viện (同聚院) của Đông Phước Tự (東福寺, Tōfuku-ji). Vào năm 1239 (niên hiệu Diên Ứng [延應] thứ 1), Cửu Điều Đạo Gia (九條道家, Kujō Michiie, 1193-1252) cho xây dựng Đông Phước Tự ở vùng đất này, nên Pháp Tánh Tự bị phế bỏ, rồi lấy tượng đứng Thiên Thủ Quan Âm (千手觀音, tiền bán thế kỷ thứ 10) làm tượng thờ chính. Tương truyền tượng này là tượng Phật thường trì niệm của Tôn Ý, cho nên tên gọi Pháp Tánh Tự vẫn còn lưu truyền cho đến ngày nay.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Tín", "definition": "法 信. Bằng cớ của sự truyền pháp. Tiết Huệ Khả Thiền Sư trong TĐT q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Tính", "definition": "Hosshō (J), Dharma nature, Dharmatā (S), Suchness, chö nyi (T), Bhuta-tathata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tính Dung Thông", "definition": "Đối lại: Duyên Khởi Tương Do.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Không", "definition": "Nghĩa là bản tính của các pháp vốn vắng lặng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Luận", "definition": "Tác phẩm, do ngài Tuệ Viễn ở Lô Sơn soạn vào đời Đông Tấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Sinh Thân", "definition": "Thân hóa sinh ngoài 3 cõi của Phật và các bậc Đại Bồ Tát, là 1 trong 5 loại Pháp Thân của Như Lai, 1 trong 2 thứ thân của Bồ Tát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Tam Muội", "definition": "Chỉ cho Tam Muội thể nhập lí Pháp Tính, tức là những việc làm hằng ngày hoàn toàn phù hợp với lí Pháp Tính tuyệt đối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Thiền Sư", "definition": "法 性 禪 師. Thụy hiệu của Thiền tăng Vô Ân, sống vào đời Ngũ Đại. X. Vô Ân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Tính Tông", "definition": "Cũng gọi Tính Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Tự", "definition": "Cũng gọi Chế Chỉ Tự, Chế Chỉ Đạo Tràng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tính Vô Sinh", "definition": "Bản tính của các pháp tức là thật tướng chân như, vốn không sinh diệt, cho nên nói là “pháp tính vô sinh”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Tính Độ", "definition": "Cũng gọi Pháp Thân Độ, Pháp Tính Tịnh Độ, Pháp Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tòa", "definition": "法座. Chỗ vua ngồi bàn việc nước Nơi xử án. Như Pháp đình 法庭.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Tông", "definition": "法 宗 (1001-1069). Thiền tăng đời Tống, họ Trần, người Khúc Giang, Quảng Đông, Trung Quốc. Sư nối pháp thiền sư Thường Bảo, thuộc tông Vân Môn đời thứ 4. Trụ viện La Hán.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Tú", "definition": "Fa Siou (C), Dharmamitra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tăng", "definition": "Dharmavivardhana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tương Ưng Bộ", "definition": "Dhamma-Yuttikanikāya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tương Ứng Bộ", "definition": "Pàli: Dhamma-yuttikanikàya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tướng", "definition": "Tức tướng trạng cùng ý nghĩa nội dung của các pháp. Tướng trạng của các pháp thì do nhân duyên sinh diệt, muôn vàn sai khác, biến chuyển trôi chảy không ngừng; ý nghĩa nội dung của các pháp tùy căn cơ, trình độ hiểu biết, thiên kiến v.v... của mỗi chúng sinh, cho nên không đồng nhất. Có thể nói, “pháp tánh” và “pháp tướng” là hai mặt không thể tách rời của vạn pháp; về mặt bản thể của vạn pháp thì gọi là “pháp tánh”, về mặt hiện tượng của vạn pháp thì gọi là “pháp tướng”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Tướng Kinh", "definition": "Mayini Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tướng Pháp", "definition": "Đối lại: Thắng Nghĩa Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tướng Tông", "definition": "Dharmalakṣaṇa School, Fa-sieng-tsong (C), Fa-hsiang tsung (C), Faxiang-zong (C), Hossō-shū (J), Dharmala-kṣaṇayāna (S), Hosso school.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tướng Từ Điển", "definition": "Bộ Từ điển gồm những danh từ liên quan đến Luận A Tì Đạt Ma của Tiểu Thừa do ông Chu bái hoàng người Trung Quốc biên tập từ năm 1934 đến năm 1937.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tượng", "definition": "Chỉ cho các bậc danh đức, thạc học, có khả năng tác thành cho đệ tử về giới học, định học và tuệ học, cũng như người thợ (tượng) giỏi, có tài nghệ làm nên những đồ dùng tốt đẹp, vì thế gọi là Pháp tượng. Thích Thị Yếu Lãm quyển hạ (Đại 54, 295 hạ) nói: “Cao tăng nước Tề giảng kinh luận rất hay, được gọi là Pháp tượng”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tạng", "definition": "Tức là ngài Hiền Thủ, là vị tổ thứ ba của tông Hoa Nghiêm (xem mục “Hiền Thử”).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Tạng Bộ", "definition": "Dharmaguptaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tạng Toái Kim Lục", "definition": "Tác phẩm, 10 quyển, do ông Triều Quýnh (951-1032) soạn vào năm Thiên Thánh thứ 5 (1027) đời Tống.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tấn", "definition": "(法進, Hōshin, 709-778): vị tăng của Luật Tông Trung Quốc, sang Nhật Bản dưới thời đại Nại Lương, húy là Pháp Tấn (法進), xuất thân La Sơn (羅山), Thân Châu (申州), họ Vương (王). Ông thọ Cụ Túc giới với Giám Chơn (鑑眞, Ganjin) ở Đại Minh Tự (大明寺), Dương Châu (揚州), đến trú tại Bạch Tháp Tự (白塔寺) và tinh thông về giới luật cũng như Thiên Thai Học. Năm 753, ông theo Giám Chơn sang Nhật, tận lực giúp thầy sáng lập Giới Đàn Viện ở Đông Đại Tự (東大寺, Tōdai-ji). Khi Giám Chơn chuyển sang Đường Chiêu Đề Tự (唐招提寺, Tōshōdai-ji), ông quản chưởng Giới Đàn Viện cũng như Đường Thiền Viện của chùa này. Vào năm 756, ông làm Luật Sư và đến năm 774 thì được thăng chức Tăng Đô. Ông nỗ lực thuyết giảng giới luật và khai sáng Phật Quốc Tự (佛國寺, Bukkoku-ji). Trước tác của ông có Đông Đại Tự Thọ Giới Pháp Quỹ (東大寺授戒法軌), Sa Di Thập Giới Tinh Uy Nghi Kinh Sớ (沙彌十戒并威儀經疏) 5 quyển, Chú Phạm Võng Kinh (註梵綱經) 6 quyển, v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Tập Luận", "definition": "Dhammasaṇgani (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tắc", "definition": "法則. Đường lối nhất định phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Tế Đại Sư", "definition": "法 濟 大 師. Hiệu của Thiền tăng Hồng Nhân, sống vào đời Đường. X. Hồng Nhân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Tề", "definition": "法 齊 (912-1000). Thiền tăng đời Tống, họ Đinh, người Vụ Châu (Kim Hoa, Chiết Giang), Trung Quốc. Ban đầu sư giảng hai luận Minh môn, Nhân minh, sau đó du phương đến viện Trường Thọ ở Tô Châu tham kiến Thiền Sư Bằng Ngạn, nhận được tâm ấn, nối pháp làm truyền nhân tông Pháp Nhãn. Bằng Ngạn tịch, sư kế tục pháp tịch. Niên hiệu Thái Bình Hưng Quốc thứ 3 (978) sư lui về ẩn tu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Tỉ Lượng", "definition": "Phạm: Anumànaô dharmatas.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tịch", "definition": "法籍. Sách chép luật lệ quốc gia Quốc tịch nước Pháp, được coi là công dân nước Pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Tọa", "definition": "Dhammāsana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Pháp Tổng Trì", "definition": "Dharanis", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Tụ", "definition": "Xem Pháp Tự.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tụ Luận Chú", "definition": "Aṭṭhasalini (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tứ Y", "definition": "法四依 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Pháp Tử", "definition": "I.Pháp Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tự", "definition": "(法嗣): là người thừa kế tông chỉ của thầy tổ, môn phái. Sự truyền pháp của thầy tổ cho đệ tử kế thừa, gọi là “tự pháp”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Tự Thư", "definition": "法 嗣 書. Bức thư do thiền sư viết gởi cho Thầy của mình, khi sư đã nhận chức Trụ trì. Pháp Diễn Ngữ Lục q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Tự Tướng Tương Vi Quá", "definition": "Cũng gọi pháp tự tướng tương vi nhân (Phạm: Dharma-svarùpa-viruddhahetu). Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Tự Tại Bồ Tát", "definition": "Dharmavikurvana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Tự Tại Vương Bồ Tát", "definition": "Dharmesvara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Uyển Can Thành", "definition": "法 苑 干 城. Người không mang hình thức xuất gia nhưng dùng quyền thế địa vị để bảo hộ Phật pháp, nhà chùa khen họ là “Pháp uyển can thành”. Can thành: Lá chắn và tường thành, đây có nghĩa là hộ vệ. Truyện Bác Sơn Hòa Thượng trong Nguyên Lai Quảng Lục q. 35 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Uyển Châu Lâm", "definition": "Cũng gọi Pháp Uyển Châu Lâm truyện, Pháp Uyển Châu Lâm Tập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Uyển Nghĩa Lâm Chương", "definition": "Cũng gọi Duy Thức Nghĩa Chương, Đại Thừa Pháp Uyển Nghĩa Lâm Chương, Nghĩa Lâm Chương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Uẩn", "definition": "Dharma-skandha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Uẩn Túc Luận", "definition": "Dharmaskandhapada (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Viễn", "definition": "Pháp Viễn (991-1067). Thiền Sư Trung Quốc, thuộc Tông Lâm Tế, sống vào đời Tống, người Trịnh Châu, tỉnh Hà Nam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Viện", "definition": "法院. Tòa án, như Pháp đình 法庭.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Việt", "definition": "法越. Nước Pháp và nước Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Vân", "definition": "I.Pháp Vân (467-529).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vân Cảo", "definition": "(法雲杲, Hōunkō, ?-?): vị tăng của Phái Hoàng Long thuộc Lâm Tế Tông Trung Quốc, thông xưng là Phật Chiếu Thiền Sư (佛照禪師). Ông đến tham học với Viên Thông Viên Ki (圓通圓璣), được cử làm Thủ Tòa. Sau ông đến tham yết Chơn Tịnh Khắc Văn (眞淨克文) và vào ngày 21 tháng 11 năm thứ 3 (1096), ông kế thừa dòng pháp của vị này. Từ đó, ông bắt đầu thuyết giáo tại Lô Sơn Quy Tông Tự (蘆山歸宗寺). Thể theo chiếu chỉ của hoàng triều, ông chuyển đến trú trì Tịnh Nhân Thiền Viện (淨因禪院) và Pháp Vân Tự (法雲寺) ở Đông Kinh (東京, Tỉnh Hà Nam).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp Vân Địa", "definition": "Dharmamegha-bhūmi (S), Cloud of Dharma stage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Vô Khứ Lai Tông", "definition": "Tông thứ 3 trong 10 tông do Tông Hoa Nghiêm phán thích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vô Ngã", "definition": "Hợp từ có nghĩa tương đương là Pháp không. Các pháp đều là nhân duyên sinh, không có thực thể. Tất cả các pháp do nhân duyên hòa hợp mà sinh ra đều là vô ngã, nghĩa là không có thực thể, đều là không. Ở đây, phải hiểu không nghĩa là không có thực thể, chứ không phải là không có gì hết. Sự vật vẫn là có, vẫn tồn tại nhưng trên ý nghĩa chúng là do nhiều nhân duyên tạm thời hòa hợp mà thành, phút chốc nhân duyên li tán rồi lại diệt. Người nào chứng được cái lí pháp vô ngã, thì sẽ không bị các pháp ràng buộc lôi cuốn nữa, tức là chứng được cái mà sách Phật gọi là pháp vô ngã trí.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pháp Vô Vi", "definition": "Xem Vô Vi Pháp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Vô Vi Và Pháp Hữu Vi", "definition": "Luận Câu Xá chia vạn pháp làm hai loại tổng quát: hữu vi và vô vi.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Võng", "definition": "法網. Chỉ luật lệ quốc gia chi phối mọi người, giống như cái lưới. Không để ai lọt ra ngoài. Lưới pháp luật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Văn", "definition": "法文. Chỉ chung sách vở văn chương nước Pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Vũ", "definition": "法雨. Chỉ giáo lí nhà Phật, vì giáo lí nhà Phật ban cho khắp chúng sinh, giống như mưa rơi, nhuần thấm muôn loài cây cỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Vũ Lão Nhân", "definition": "法 雨 老 人. Hiệu của Thiền tăng Phật Thạch, sống vào đời Minh. X. Phật Thạch.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Vũ Thiền Tự", "definition": "Cũng gọi Hậu Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vũ Tự", "definition": "法 雨 寺. 1. Còn gọi: Chùa Đậu, chùa Thành Đạo. Chùa ở làng Đậu, nay thuộc thôn Gia Phúc, xã Nguyễn Trãi, huyện Thường Tín, tỉnh Hà Sơn Bình, Việt Nam. Tòa chính điện kiểu chữ công (I), ngói trên mái rất to và dầy. Vách điện cũng làm theo kỹ thuật ván nong, đổ dầy dặn và trang hoàng rất hoa mỹ. Chính giữa vách trổ những ô cửa chạm rồng, phụng, tứ linh, rất giống ở thượng điện chùa Thầy cùng những hình đồng tử hai tay dâng từng chữ “Thánh thọ vô cương”. Ngoài ra cột có chạm những ổ rồng theo chiều cao và trên những trương cửa có chạm hình tiên. Hình chạm rất linh hoạt, tinh xảo, vì vậy trước đây chùa Đậu được xem là nơi có những tác phẩm điêu khắc trên mặt gỗ đẹp và khéo vào bậc nhất Việt Nam.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Vương", "definition": "Dhammassami (P), King of Dharma,Dharma-rāja (S), Dharma king.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Vương Chi ấn", "definition": "法 王 之 印. Chiếc ấn của Pháp vương. Chỉ cho chân đế Phật pháp, thiền nghĩa vi diệu. Lục Tổ Năng Thiền Sư Bi Minh của Vương Duy trong Toàn Đường Văn q. 327 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Vương Gia", "definition": "Nhà bậc vua Pháp. Chỉ cho cõi nước của chư Phật. Pháp Vương là tiếng tôn xưng Đức Phật, cho nên cõi nước của Phật trụ được gọi là Pháp Vương Gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vương Kinh", "definition": "Kinh, 1 quyển, không có tên người dịch hoặc người soạn, được thu vào Đại Chính Tạng tập 85.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vương Tử", "definition": "Kumārabhuta (S), Dharma Prince, Kumāra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Vương Tự", "definition": "Chùa ở chân núi phía nam ngọn Thái Thất thuộc Tung Sơn, huyện Đăng Phong, tỉnh Hà Nam, Trung Quốc, tương truyền được sáng lập vào năm Vĩnh Bình thứ 10 (71) đời vua Minh Đế nhà Hán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vương Vô Thượng Trân Bảo", "definition": "法 王 無 上 珍 寶. Chỉ cho Phật pháp chân đế, thiền nghĩa nhiệm mầu. Tiết Đạo Nhất đời thứ 2 dưới Đại Giám trong CTTNL, q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Vận Chí Lược", "definition": "Fa-yiin chih-lueh (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Vật", "definition": "Những vật thuộc về Pháp. Chỉ cho các loại kinh sách, hòm, tráp và các phẩm vật cúng dường Pháp Bảo, là 1 trong Tam Bảo Vật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Vị", "definition": "法味. Cái hay của giáo lí nhà Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Xung", "definition": "Pháp Xung (587 ?-665). Cao tăng Trung Quốc, sống vào đời Đường, người Thành kỉ, Lũng Tây, (thuộc tỉnh Cam Túc), họ Lí, tự Hiếu Đôn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Xã", "definition": "Đoàn thể tín ngưỡng do tín đồ tại gia của Phật Giáo tổ chức thành, tính chất của nó giống như Nghĩa Ấp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Xã Kinh", "definition": "Kinh, 1 quyển, tương truyền do ngài Trúc Pháp Hộ dịch vào đời Tây Tấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Xưng", "definition": "Dharmayaśas (S), Dharmakīrti (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Xứ", "definition": "Dharmayatana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Xứ Sở Nhiếp Sắc", "definition": "Tông Pháp Tướng chia vạn pháp trong vũ trụ thành năm nhóm tổng quát – thuật ngữ Duy Thức học gọi là “ngũ vị”, trong đó có nhóm Sắc Pháp (là các pháp thuộc về vật chất, có hình sắc, có tính chất ngại, biến hoại). Nhóm Sắc Pháp bao gồm 11 pháp, tức là 5 căn (nhãn, nhĩ, tị, thiệt, thân), 5 cảnh (sắc, thanh, hương, vị, xúc), và pháp xứ sở nhiếp sắc. Chữ “xứ” ở đây có nghĩa là trưởng dưỡng (tức sinh trưởng và dưỡng dục); có ý chỉ cho những gì có thể trưởng dưỡng tâm và tâm sở của chúng ta, lại cũng là nơi để cho tâm và tâm sở phan duyên, nương tựa. Những gì được gọi là “xứ” đó, có cả thảy 12 thứ mà thuật ngữ Duy Thức học gọi là “mười hai xứ”, gồm có 6 căn và 6 cảnh: nhãn căn, nhĩ căn, tị căn, thiệt căn, thân căn, ý căn, sắc cảnh, thanh cảnh, hương cảnh, vị cảnh, xúc cảnh, và pháp cảnh. (Nếu thay những chữ “căn” và “cảnh” bằng chữ “xứ”, chúng ta sẽ có 12 xứ là: nhãn xứ, nhĩ xứ, tị xứ, thiệt xứ, thân xứ, ý xứ, sắc xứ, thanh xứ, hương xứ, vị xứ, xúc, và pháp xứ.) Vậy, PHÁP XỨ tức là PHÁP CẢNH. Nhưng chỗ khác nhau là, khi dùng từ “pháp cảnh” là có ý nhấn mạnh rằng, đó chính là đối tượng khách quan của tác dụng nhận thức phát khởi từ chủ thể ý căn; còn khi dùng từ “pháp xứ” là có ý nói rõ rằng, chính nó và 11 xứ kia là những gì có thể trưởng dưỡng tâm và tâm sở, lại cũng là nơi để cho tâm và tâm sở nương tựa, phan duyên. Tất cả những gì nằm trong phạm vi sắc pháp, hễ thống thuộc vào pháp xứ, thì gọi là “pháp xứ sở nhiếp sắc”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Xứng", "definition": "Xem Pháp Xưng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Y", "definition": "Hō'e (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Yếu", "definition": "I.Pháp Yếu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp chỉ cho lí thể, Tuệ chỉ cho trí dụng. Lí thể ví dụ cho thân thể; Trí Dụng ví dụ cho thọ mệnh, cho nên gọi là Pháp Thân Tuệ Mệnh, gọi tắt là Pháp mệnh.", "definition": "II.Pháp Mệnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp giới", "definition": "“Pháp” tức các pháp, “giới” tức ranh giới; các pháp đều có tự thể và ranh giới khác nhau, gọi là “pháp giới”. Vì vậy, mỗi một pháp gọi là pháp giới, mà gọi tổng quát vạn hữu cũng là pháp giới.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp lữ", "definition": "(法侶): bạn pháp, còn chỉ cho tăng lữ, tu sĩ; đồng nghĩa với đạo hữu (道友, bạn đạo). Như trong bài Kim Cang Bát Nhã Sám Văn (金剛般若懺文) của vua Lương Võ Đế (梁武帝, tại vị 502-549) thời Nam Triều có câu: “Hằng sa chúng sanh, giai vi pháp lữ (恆沙眾生、皆爲法侶, hằng sa chúng sanh, đều là bạn pháp).” Hay trong Truy Môn Cảnh Huấn (緇門警訓, Taishō Vol. 48, No. 2023), phần Quy Sơn Đại Viên Thiền Sư Cảnh Sách (潙山大圓禪師警策), lại có câu: “Nguyện bách kiếp thiên sanh đồng vi pháp lữ (願百劫千生處處同爲法侶, nguyện trăm kiếp ngàn đời cùng là bạn pháp).” Hoặc trong Hoàng Thái Tử Thanh Thành Sơn Tu Trai Từ (皇太子青城山修齋詞) của Đỗ Quang Đình (杜光庭, 850-933) nhà Tiền Thục cũng có câu: “Chiêu thập châu chi pháp lữ, ước tam động chi huyền khoa (召十洲之法侶、約三洞之玄科, mời mười châu bao bạn pháp, hẹn ba động ấy khoa nghi).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp nghi", "definition": "(法儀): lễ nghi theo đúng quy phạm, pháp tắc. Như trong Mặc Tử (墨子), phần Pháp Nghi (法儀), giải thích rõ rằng: “Thiên hạ tùng sự giả, bất khả dĩ vô pháp nghi; vô pháp nghi nhi kỳ sự năng thành giả, vô hữu (天下從事者、不可以無法儀、無法儀而其事能成者、無有, người làm việc trong thiên hạ, không thể nào không có pháp nghi được, không có pháp nghi mà việc ấy có thể thành thì không bao giờ có).” Hay trong Tục Phật Tổ Thống Kỷ (續佛祖統紀, 卍Tục Tạng Kinh Vol. 75, No. 1515) quyển 2, phần Tuyệt Tông Kế Pháp Sư Pháp Từ (絕宗繼法師法嗣), Pháp Sư Như Kỷ (法師如玘), có đoạn: “Chiêu thiên hạ cao tăng tất tập Chung Sơn, thiết quảng tiến hội, pháp nghi thậm thạnh, đại giá thân lâm (召天下高僧畢集鐘山、設廣薦會、法儀甚盛、大駕親臨, mời chư vị cao tăng trong thiên hạ tập trung hết tại Chung Sơn, thiết bày hội cúng tiến lớn, pháp nghi rất đầy đủ, nhà vua cũng thân lâm đến dự).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pháp ngồi thiền tuyệt đối buông bỏ tất cả, để đạt đến cảnh giới vô vi, vượt ra ngoài vòng đối đãi.", "definition": "II.Khô Thiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp trần cũng tương đương với Pháp Xứ trong 12 xứ, với Pháp Giới trong 18 giới; hoặc chỉ cho hiện tượng khiến người ta khởi tâm chấp trước. (xt. Lục Trần).", "definition": "II.Pháp Trần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Ái", "definition": "Chữ “pháp” ở đây là nói về pháp lành. Người mới chứng ngộ thường sinh tâm yêu thích thiện pháp; theo tông Thiên Thai, như thế vẫn chưa gọi được là chứng ngộ chân thật – vì tâm “ái” vẫn còn, dù là ái thiện pháp! Phải hoàn toàn diệt trừ cái tâm “pháp ái” ấy thì mới thực sự chứng ngộ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Pháp Âm", "definition": "法 音. 1. Âm thanh thuyết pháp. Chương Tôn giả Long Thọ, tổ thứ 14 trong CĐTĐL q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Ân", "definition": "Nhờ nghe, học và tu theo Phật pháp mà được giác ngộ, bỏ dữ theo lành, sống đời sống có ích cho xã hội, nhân loại, bản thân mình cũng được an lạc hạnh phúc, đó là công của Phật pháp.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pháp Ích", "definition": "Dharma-vardhan (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Ý", "definition": "Dharma-mati (S), Dharma idea.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Điều", "definition": "法條. Phần nhỏ của một đạo luật, nói riêng về một vấn đề gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Điển", "definition": "法典. Bộ sách ghi chép đầy đủ luật lệ của quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Điện", "definition": "I.Pháp Điện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Đoan", "definition": "法 端. 1. Thiền tăng đời Ngũ Đại, tham yết Quốc sư Thiên Thai Đức Thiều được tỏ ngộ, nối pháp làm truyền nhân tông Pháp Nhãn. Sư ở chùa Báo Ân Quang Giáo tại Hàng Châu, được ban hiệu “Huệ Nguyệt Thiền Sư”. 2. Thiền tăng đời Đường, tham học với Quy Sơn Linh Hựu được nối pháp làm truyền nhân tông Quy Ngưỡng. Sư ở chùa Diên Khánh, Tương Châu (Tương Phàn, Hồ Bắc).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Đà La Ni", "definition": "Cũng gọi Văn Trì Đà La Ni, Pháp Tổng Trì. Nghe giáo pháp của Đức Phật và nhớ giữ không quên, 1 trong các Đà La Ni.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Đà La Ni Môn", "definition": "Dhāraṇī-Door.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Đàn", "definition": "法壇. Chỗ thầy tu đứng giảng đạo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Đình", "definition": "法庭. Tòa nhà lớn, nơi xét xử mọi việc theo luật lệ quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Đăng", "definition": "Hoto (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Đăng Thiền Sư", "definition": "法 燈 禪 師. Hiệu của Thiền tăng Thái Khâm, sống vào đời Ngũ Đại. X. Thái Khâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Đăng Vị Liễu", "definition": "Tên công án trong Thiền Tông.Nội dung công án này là cơ duyên vấn đáp giữa Thiền Sư Thanh Lương Thái Khâm (Pháp Đăng) với 1 vị tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Đường", "definition": "Chỉ cho Giảng đường trong Thiền Lâm, tọa lạc ở phía sau điện Phật và phía trước nhà Phương trượng, 1 trong 7 tòa nhà trong toàn già lam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Pháp Đạo", "definition": "法道. Một tên chỉ đạo Phật Noi giữ đường lối thánh hiền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Đạt", "definition": "法 達 (668-740). Thiền tăng đời Đường, họ Lý, người Phong Thành, Hồng Châu (Giang Tây), Trung Quốc. Năm 7 tuổi xuất gia, tụng kinh Pháp Hoa. Sau khi thụ giới cụ túc yết kiến Huệ Năng cầu pháp. Huệ Năng vì sư giảng yếu chỉ “Pháp Hoa” giúp cho sư khải phát, Pháp Đạt đốn ngộ lý mầu liền nói kệ tán thán: “Tụng Kinh ba ngàn bộ, một lời Tào Khê tiêu”. Huệ Năng nói: “Từ nay về sau mới đúng là “ông tăng niệm kinh”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Đệ", "definition": "法 弟. Sư đệ. Tiết Giác A Thượng Nhân trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Pháp Đệ Nhất", "definition": "Formost law", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Pháp Định", "definition": "法定. Được quyết chắc bởi luật lệ quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Đồ", "definition": "法徒. Thầy tu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp Đồng Xá", "definition": "Xem Chùa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pháp Độ", "definition": "法度. Các mức thi hành luật lệ quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pháp ẤN;", "definition": "S. Mudra Cg. Ấn quyết", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Pháp Ấn", "definition": "Chữ “pháp” ở đây là chỉ cho Phật pháp; chữ “ấn” ở đây nghĩa là cái ấn, con dấu, phù hợp, tiêu chuẩn, chân thật, không thay đổi. Con dấu dùng để ấn chứng một sự việc là thật, chắc chắn, đáng tin tưởng. “Pháp ấn” là một thuật ngữ Phật học, có nghĩa là chân lí, là điều chân thật được chứng ngộ và nói ra bởi Bậc Giác Ngộ (tức là đức Phật). Tất cả kinh luận, giáo lí nào phát biểu đúng với nội dung của những pháp ấn này, tức đều là Phật pháp. Tất cả mọi nhận thức, phát biểu nào không phù hợp với những pháp ấn này, tức đều là ngụy ngữ, tà pháp.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phát", "definition": "發. Bắn ra Khởi lên. Dựng lên Mở ra Tìm ra Sáng sủa Một âm là Bát. Xem Bát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Binh", "definition": "發兵. Đem quân lính ra đánh. Như: Khởi binh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Biểu", "definition": "發表. Làm rộ ra bên ngoài. Bày tỏ ý kiến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Bệnh", "definition": "發病. bắt đầu đau ốm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Bố", "definition": "發布. Nói rõ ra cho mọi người biết. Như: Tuyên bố.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Bồ Đề Tâm", "definition": "發菩提心 Bodhi-citta", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phát Bồ Đề Tâm Luận", "definition": "I.Phát Bồ Đề Tâm Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Cho", "definition": "Muñcati (muc + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Chân", "definition": "Tức phát khởi chân tính sẵn có của mình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Chân Quy Nguyên", "definition": "發 眞 歸 元. Phát hiện, nhận thức chân tính sẵn có của chính mình; trở về cội nguồn thanh tịnh tâm. Nói khác đi, đây là đạt đến cảnh giới Niết Bàn, sạch hết phiền não, siêu thoát sinh tử. Pháp Diễn Ngữ Lục, q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phát Chẩn", "definition": "發賑. Đem ra mà cho không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Chỉ", "definition": "髮指. Tóc dựng ngược lên, ý nói giận lắm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Cuồng", "definition": "發狂. Nổi điên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Cơ", "definition": "發 機. Mở bày thiền cơ. Tiết Động Sơn Ngộ Bản Thiền Sư trong NGCTT q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phát Cấp", "definition": "發給. Lấy ra mà đưa cho. Cũng nói: Cấp phát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Dương", "definition": "發揚. Làm cho rõ hơn, lớn hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Dẫn", "definition": "發引. Đem người chết đi chôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Dục", "definition": "發育. Lớn lên. Tăng trưởng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Giác", "definition": "發覺. Đem chuyện kín đáo của một người nói cho mọi người cùng biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Giáo", "definition": "發酵. Lên men (ta có người đọc Phát điếu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hiệu", "definition": "發號. Ra dấu cho người khác bắt đầu hành động.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hoàn", "definition": "發還. Đem trả lại. Đoạn trường tân thanh có câu: “Ngỏ lời nói với băng nhân, tiền trăm lại cứ nguyên ngân phát hoàn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hoả", "definition": "發火. Bốc cháy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Huy", "definition": "發揮. Làm cho rộng lớn ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hành", "definition": "發行. Đem đi các nơi, bán ra tại các nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hãn", "definition": "發汗. Đổ mồ hôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hôn", "definition": "發昏. Mê man đi, không biết gì nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Hơi", "definition": "Vāti (vā + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Hạ Phẩm Thập Thiên Tâm", "definition": "Chỉ cho người phát tâm làm các việc thiện rồi lại hối hận, là 1 trong 10 loại phát tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Hồi", "definition": "發囘. Đem trở về chỗ cũ. Cho về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Khiếp", "definition": "發怯. Nảy sinh lòng sợ hãi tức khắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Khiển Chiêu Hoán", "definition": "Gọi tắt: Khiển Hoán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Khách", "definition": "發客. Đem ra cho người, tức bán ra cho khách hàng mua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Khởi", "definition": "發起. Tạo dựng nên. Mở đầu ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Khởi Chúng", "definition": "Chỉ cho hàng thính chúng có khả năng biết rõ thời cơ, tạo ra nhân duyên phát khởi pháp hội, là 1 trong 4 chúng nghe Đức Phật nói pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Khởi Tự", "definition": "Đối lại: Chứng Tín Tự. Cũng gọi Biệt Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Khứ", "definition": "發 去. Bỏ đi. Tiết Dược Sơn Hòa Thượng trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phát Kiến", "definition": "發見. Tìm thấy, tìm ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Lãnh", "definition": "發冷. Nổi cơn lạnh (nói về người bệnh).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Lưu", "definition": "發流. Đưa đi đày ở nơi xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Lồ", "definition": "Tức là thú thật trước đại chúng những tội lỗi mình đã phạm.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phát Lộ", "definition": "Xem Ba La Đề Đề Xá Ni.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phát Minh", "definition": "發明. Tìm ra được cái mới, hiểu rõ được điều thật mới lạ. “Phát minh lẽ thẳng ngõ hầu cùng nghe”. (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Mùi", "definition": "Vāyati (vā + ya), vāyana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Mại", "definition": "發賣. Đem bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Nghiêp Nhuận Sinh", "definition": "Chỉ cho phiền não tưới tẩm (nhuận) nghiệp mà sinh ra quả ở vị lai.“Phát nghiệp” là chỉ cho tác dụng của Hoặc, lấy phiền não phân biệt khởi làm chính, trong đó lại lấy nghiệp do vô minh phân biệt phát ra, tương ứng với thức thứ 6 làm chủ yếu, rồi chung với phiền não Câu Sinh Khởi mà phát ra nghiệp. Tác dụng hoặc lấy phiền não Phân Biệt Khởi làm chính, là nói theo hành tướng tăng thắng. Còn tác dụng hoặc lấy vô minh phân biệt làm chủ yếu thì là tác dụng thù thắng hơn so với các hoặc khác. “Nhuận sinh” chỉ cho tác dụng của hoặc nhuận sinh, tức là hoặc Câu Sinh Khởi lấy phiền não Tham, tương ứng với thức thứ 6 làm chính, chẳng hạn như lúc hấp hối có hoặc tham ái thì quyến luyến tự thể và cảnh giới, nhờ đó mà tưới tẩm sự sống của “Trung Hữu” (tức thân chưa đi đầu thai), đó là tác dụng tăng thượng. Tác dụng này tương đương với 2 chi Ái và Thủ trong 12 nhân duyên, có năng lực tưới tẩm (nhuận) hạt giống của 5 quả, làm phát sinh hiện hành, vì vậy gọi là Nhuận Sinh. Trong đó, có Chính Nhuận Sinh và Trợ Nhuận Sinh khác nhau. Chính Nhuận Sinh là hoặc Câu Sinh Khởi, khi đến giai vị Tu Đạo thì đoạn trừ hết; còn Trợ Nhuận Sinh thì chung cho cả hoặc Phân Biệt Khởi, khi đến giai vị Kiến Đạo thì đoạn trừ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Nghiệp", "definition": "發 業. Phiền não, nổi nóng. Tiết Vong Danh Cổ Túc trong NĐHN q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phát Nghị", "definition": "發議. Đưa ra để bàn bạc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Nguyên", "definition": "發源. Bắt nguồn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Nguyện", "definition": "發願. Đem ra thề thốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Ngã Quỉ Tâm", "definition": "Phát tâm quỉ đói, 1 trong 10 loại phát tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Ngôn", "definition": "發言. Đem ra mà nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Nha", "definition": "發芽. Nảy mầm. Mọc mầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Nhân Nghiệp", "definition": "發 人 業. Khiến người phiền não. Tiết Trường Sinh Giảo Nhiên Thiền Sư trong NĐHN q. 7 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phát Nạn", "definition": "發難. Bắt đầu, mở đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Nộ", "definition": "發怒. Nổi giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Phu", "definition": "(髪膚): tóc và da, tức chỉ toàn thân con người. Trong chương Khai Tông Minh Nghĩa (開宗明義) thứ nhất của Hiếu Kinh (孝經) có đoạn rằng: “Thân thể phát phu, thọ chi phụ mẫu, bất cảm hủy thương, hiếu chi thỉ dã (身體髪膚、受之父母、不敢毀傷、孝之始也, toàn bộ thân thể, thọ của cha mẹ, không dám thương tổn, đó là việc làm đầu tiên của hiếu).” Câu “cảm hà phát phu chi báo (感荷髪膚之報)” có nghĩa là cảm thấy nặng trĩu không biết làm sao báo đáp ơn sâu của cha mẹ đã ban cho tấm thân này.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phát Phóng", "definition": "發放. Đem thả ra. Trả tự do.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Phẫn", "definition": "發憤. Uất ức Nổi giận với chính mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Phối", "definition": "發配. Như Phát lưu 發流.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Quang", "definition": "發光. Chiếu ra ánh sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Quang Địa", "definition": "Prabhākari-bhūmi (S), Radiant stage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phát Quật", "definition": "發掘. Đào lên Moi móc mà tìm ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Ra", "definition": "Muñcati (muc + ṃ + a), vissajjeti (vi + sajj + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Sai", "definition": "發差. Ra lệnh, bắt người khác làm đúng. Truyện Trê Cóc có câu: “Trát thảo cho dấu chữ y, truyền cho lệ dịch tức thì phát sai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát San", "definition": "發刊. Đem in ra nhiều bản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Sanh", "definition": "Sañcaneti (saṃ + jan + e), samuṭṭhahati (saṃ + u + thā + a), samuṭṭhāna (trung), nibbattati (ni + vat + a), janeti (jan + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Sanh Do Nghiệp", "definition": "Kammasamuṭṭhā (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Sanh Phật Đảnh", "definition": "Xem Cao Phật Đảnh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phát Sinh", "definition": "發生. Làm ra. Nảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Sân", "definition": "Kujjhati (kudh + ya),kujjhana (trung),kujjhanā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Sầu", "definition": "發愁. Nảy sinh lòng buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tang", "definition": "發喪. Đem tin có người chết trong nhà mà báo cho người ngoài biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Thanh", "definition": "Vipphāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Thê", "definition": "髮妻. Người vợ chính thức đầu tiên (tức Kết phát chi thê, người vợ se tơ kết tóc với mình).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Thú", "definition": "Kasina (P), Kṛṣṇapura (S), Kṛstnā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phát Thú Luận", "definition": "Patthama (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phát Thệ", "definition": "發誓. Nói lên lời thề thốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Thụ", "definition": "發售. Đem bán. Bán ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Thủy", "definition": "發始. Bắt đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tiết", "definition": "發泄. Lọt ra ngoài, bày lộ ra ngoài. Đoạn trường tân thanh có câu: “Anh hoa phát tiết ra ngoài, nghìn thu bạc mệnh một đời tài hoa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Triển", "definition": "發展. Mở mang rộng lớn ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Trí Luận", "definition": "Jñānaprasṭhāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phát Trích", "definition": "發摘. Moi móc được tội ác kín đáo của người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tài", "definition": "發財. Thêm được nhiều tiền của.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tán", "definition": "發散. Lọt ra ngoài mà tan biến đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tâm Bồ Đề", "definition": "Conceive the desire for Bodhi", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phát Tình", "definition": "發情. Bắt đầu cảm thấy có sự ham muốn về xác thịt, chỉ lúc dậy thì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tích", "definition": "發迹. Lập được sự nghiệp, để lại cho đời. “Nhà Lê phát tích từ đâu nhỉ” (Thơ cổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Túc", "definition": "發 足. Bắt đầu khởi hành, cất bước ra đi. Tiết Thị Chân Ngộ Thiền nhân trong HSLNMDT ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phát Tư Ba", "definition": "(1239-1280): cũng gọi là Bát Tư Ba, dịch âm của Tạng ngữ “Chos-rgyal-hphags-pa”, là một vị lạt-ma Tây-tạng. Ngài là vị tổ thứ 5 của phái Sakyapa, một trong 4 phái Mật-tông thuộc Hồng-mạo phái ở Tây-tạng. Năm 15 tuổi ngài đã làm thầy truyền giới, đồng thời làm cố vấn cho vua Mông-cổ Hốt Tất Liệt. Năm 19 tuổi, ngài đã dùng quan điểm Phật giáo để phê phán sách Lão Tử Hóa Hồ Kinh và đả kích đạo sĩ Lão giáo. Năm 1260, Hốt Tất Liệt (bấy giờ đã thống trị hơn một nửa nước Trung-hoa) đem ngài sang kinh đô Kara-korum của Mông-cổ, tôn làm đế sư (quốc sư), thống lãnh Phật giáo toàn đế quốc (trong đó có phần lãnh thổ của Trung-quốc). Uy quyền của ngài thật là lẫm liệt, mỗi khi tới chốn cung đình, ngài được trên từ hoàng đế, xuống đến công khanh, bách quan, tất cả đều ra tận cửa điện để nghênh tiếp. Năm 1269, vâng mệnh vua, ngài đã lấy văn tự Tây-tạng làm cơ sở, sáng chế ra văn tự Mông-cổ để sử dụng riêng cho dân Mông-cổ, gọi là “Bát-tư-ba văn” (tức văn tự Mông-cổ). Bởi thế, ngài càng được vua trọng đãi, và được ban hiệu là Đại Bảo pháp vương; lại được ban cho ngọc ấn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phát Tường", "definition": "發祥. Có điềm lành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Tấu", "definition": "(發奏): văn thư của bề tôi bên dưới khải tấu, tâu trình sự việc lên đức vua hay đấng tôn kính; còn gọi là tấu văn (奏聞). Như trong Hậu Hán Thư (後漢書), phần An Đế Kỷ (安帝紀), có đoạn: “Tam Ty chi chức, nội ngoại thị giám, ký bất tấu văn, hựu vô cử chánh (三司之職、內外是監、旣不奏聞、又無舉正, chức của Ba Ty, trong ngoài giám sát, đã không tâu trình, lại chẳng sửa đúng).” Hay trong Tập Di Ký (集异記), phần Diệp Pháp Thiện (葉法善), của Tiết Dụng Nhược (薛用弱, ?-?) nhà Đường, lại có đoạn: “Huyền Tông thừa tộ kế thống, sư ư thượng kinh, tá hựu thánh chúa, phàm cát hung động tĩnh, tất dự tấu văn (玄宗承祚繼統、師於上京、佐佑聖主、凡吉凶動靜、必預奏聞, vua Huyền Tông kế thừa ngôi báu trị vì, sư lên kinh đô, phò tá thánh chúa, phàm lành dữ động tĩnh, đều phải tâu trình trước).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phát Tế", "definition": "Chỉ cho chỗ chân tóc ở trên trán. Nói về tướng lưỡi rộng dài trong 32 tướng hảo của Đức Phật. Tức đầu lưỡi của Phật khi thè ra thì che cả mặt, cho đến chỗ chân tóc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Tức", "definition": "發息. Chia lời cho những người góp vốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Uy", "definition": "發威. Ra oai cho người khác nể sợ Làm ra mặt giận dữ cho người khác sợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Vấn", "definition": "發問. Đặt câu hỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Xuất", "definition": "Samuṭṭhāpeti (saṃ + u + thā + āpe)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát tâm", "definition": "Là một thuật ngữ Phật học, có nghĩa là phát tâm nguyện cầu đạo bồ đề vô thượng, tức là phát khởi nguyện vọng giải thoát sinh tử, nguyện cầu thành Phật để cứu độ chúng sinh. Đối với tông Tịnh Độ, phát khởi tâm nguyện cầu vãng sinh về thế giới Cực-lạc, cũng gọi là “phát tâm”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phát Âm", "definition": "發音. Bật ra tiếng, tức cách đọc một tiếng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Ý Bền Vững", "definition": "Firm in intent", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phát Đi", "definition": "Pahiṇāti (pra + hi)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phát Điện", "definition": "發電. Tạo ra sức điện để dùng. Td: Phát điện cơ (máy phát điện).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Đoan", "definition": "發端. Mở đầu mối, bắt đầu, mở đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Đạt", "definition": "發達. Mở mang tới mức lớn hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Đầu", "definition": "Chỉ cho chức vụ trông coi việc cạo tóc cho chúng tăng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phát Động", "definition": "發動. Mở đầu một công việc, một hành động.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phát Ố", "definition": "發 惡. Còn gọi: ố phát. Nổi nóng, phát cáu. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phân", "definition": "吩. Phân phó 吩咐: Dặn dò.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Biện", "definition": "分辨. Xếp riêng ra mà xét cho rõ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Biện Minh Bồ Tát", "definition": "Xem Thanh Biện Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt", "definition": "Vibhājya (S, P), Vikappa (P), Vikalpa (S), Fumbetsu (J), Prativikalpa (S), Paṭivikappa (P), Vibhāga (S), Discrimation Vibhaṅga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Biến", "definition": "Đối lại: Nhân Duyên Biến.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Bảo Tánh Chi Đại Thừa Tối Thắng Yếu Nghĩa Luận", "definition": "Ratnagotra-vibhago-mahāyanottara-tantra śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Công Đức", "definition": "Distinctions in benefits", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phân Biệt Công Đức Luận", "definition": "Puṇya-vibhaṅga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Du Già Luận", "definition": "Vibhaga-yogā śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Duyên", "definition": "Vikalpapratyaya (S), Conditions of discrimination.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Giả", "definition": "Vibhājyavadin (P), Follower of Vibhājyavāda.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Khởi", "definition": "Parikalpa samutthita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Luận", "definition": "Pàli: Vibhaíga-ppakaraịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Luận Giả", "definition": "Phạm: Vibhajya-vàdin. Pàli: Vibhajja-vàdin.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Ngã Chấp", "definition": "分別我執 añjanā -ahaṃkāra-mana kāratā", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phân Biệt Rõ", "definition": "Paṭisañcikkhati (paṭi + saṃ + cikkh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Biệt Sự Thức", "definition": "Gọi tắt: Sự Thức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Sự Thức Huân Tập", "definition": "Đối lại: Ý Huân Tập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Thuyết", "definition": "Vaibhāṣika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Thuyết Bộ", "definition": "Vibhājyavāda (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Thánh Đế Kinh", "definition": "Xem Kinh Phân Biệt Về Sự Thật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Thức", "definition": "Manovijñā (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Trí", "definition": "Pratisamvid (S), Analytical knowledge.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Biệt Trí Tương Ứng Nhiễm", "definition": "Một trong 6 nhiễm tâm được nói trong Luận Đại Thừa Khởi Tín, tương đương với Trí Tướng trong Lục thô.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Trí Đà La Ni", "definition": "Cũng gọi Phân Biệt Tri Đà La Ni, Phân Biệt Đà La Ni.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Biệt Tương Tự Quá Loại", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Bò", "definition": "Gomaya (trung), miḷna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Bố", "definition": "分布. Chia ra mà bày ra khắp nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Bổ", "definition": "分補. Chia ra cho mọi người phải chịu một phần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Chia", "definition": "Chedana (trung), paṭivibhajati (paṭi + vi + bhaj + a), saṃvibhājati (saṃ + vi + bhaj + a), saṃvibhājana (trung), vibhaṅga (nam), vibhajati (vi + bhaj + a), vibhāga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Chư Thừa", "definition": "Đối lại: Dung Bản Mạt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Chức", "definition": "分職. Chia công việc mà trao cho từng người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Chứng", "definition": "Các vị Bồ Tát từ sơ địa trở lên, tuy đã xếp vào hàng Thánh, nhưng chỉ mới đoạn hết một phần phiền não, và chứng được một phần chân lý. Chỉ tới địa vị Phật, mới hoàn toàn chứng ngộ. Đại thừa khởi tín gọi các bậc Thánh đó là tùy phân giác. Thiên Thai tông gọi họ là phân chứng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phân Cách", "definition": "分隔. Rời xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Cát", "definition": "分割. Chia cắt đất đai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Công", "definition": "分工. Chia việc cho mọi người làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Cư", "definition": "分居. Ở riêng ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Cương", "definition": "分疆. Chia biên giới, định ranh giới. “Mặt ngoài hai nước Phân cương” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Cấp", "definition": "分給. Chia ra mà đưa cho nhiều người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Cục", "definition": "分局. Một chi nhánh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Duệ", "definition": "分袂. Rời vạt áo, ý nói chia tay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Gia", "definition": "分家. Chia nhau của cải trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Giải", "definition": "分解. Nói rõ từng phần của vấn đề.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Giới", "definition": "分界. Chia ranh đất Chỗ đất làm đường ranh cho hai vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Hoa", "definition": "紛華. Nhiều và đẹp, chỉ nơi đông người, cuộc sống đẹp đẽ. Như: Phồn hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Hạng", "definition": "Vibhāga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Khai", "definition": "分開. Chia ra, rời ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Khoa", "definition": "分科. Ngành học được chia riêng ra (như Luật khoa, Văn khoa, y khoa).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Khâm", "definition": "分襟. Như Phân duệ 分袂.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Kì", "definition": "分岐. Chia đường, mỗi người rẽ về một ngả, chỉ sự chia tay, xa cách. Hoa Tiên có câu “Rằng nay nam bắc phân kì, Đã đành trời nọ trăng kia mới lòng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Li", "definition": "分離. Chìa lìa. Rời xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Liệt", "definition": "分裂. Chia xé làm nhiều mảnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Loại", "definition": "分類. Chia ra theo từng loài, từng thứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Lưu", "definition": "分流. Chia ra làm nhiều dòng, nhánh Nhánh sông, sông lớn chia ra. Như: Chi lưu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Lượng", "definition": "分量. Sự nhiều ít.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Lập", "definition": "分立. Đứng riêng ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Lợi", "definition": "分利. Chia lời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Minh", "definition": "分明. Thật sáng sủa rõ ràng, không có gì lầm lẫn. Đoạn trường tân thanh có câu: “Nỗi nàng hỏi hết phân minh, chồng con đâu tá tính danh là gì”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Miễn", "definition": "分娩. Sanh đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Mẫu", "definition": "分母. Danh từ Toán học, chỉ mẫu số trong phân số.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Nghĩa", "definition": "Jalpa (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Người", "definition": "Vacca (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Ngạch", "definition": "分額. Cái số chia ra cho từng người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Nhiễu", "definition": "紛擾. Rối loạn, lộn xộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Nhiệm", "definition": "分任. Chia ra mà gánh nhận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Nã", "definition": "分 拿. Còn gọi: Phân Sơ. Phân biệt, giải bày. Phần Dương Ngữ Lục, q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phân Nửa", "definition": "Aḍḍha (nam), upaḍḍhāna (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Phi", "definition": "芬菲. Tươi tốt thơm tho “nói về hoa cỏ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phiên", "definition": "分番. Chia lượt, theo thứ tự lần lượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phong", "definition": "分封. Chia mà ban cho, nói về việc vua chia đất, ban cho các chư hầu. “Nước ta Nam Việt phân phong” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phu", "definition": "紛敷. Rối loạn, tơi bời. Bài Chiến Tụng Tây hồ phú của Phạm Thái có câu: “Xem hồ thuỷ thẹn cùng sắc nước, đến cỏ hoa đều ê ủ phân phu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phái", "definition": "分派. Chia làm nhiều nhánh, nhiều ngành Sai mỗi người một việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Pháp", "definition": "分法. Phép chia, phép làm tính chia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phát", "definition": "分發. Chia ra mà đưa cho nhiều người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phân", "definition": "紛紛. Nhiều, chỗ nào cũng có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phó", "definition": "分付. Chia việc mà giao cho Trong bạch thoại còn có nghĩa là dặn dò.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phương", "definition": "芬芳. Hương thơm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phị", "definition": "紛披. Nhiều, rối loạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Phối", "definition": "分配. Chia ra mà dùng cho hợp lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Quyền", "definition": "分權. Chia quyền quốc gia mà trao cho các cơ quan khác nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Ranh", "definition": "Paricchindana (trung), pariccheda (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Sơ", "definition": "分 疏. Phân biện, biện giải. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phân Sản", "definition": "分產. Chia của cải trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Số", "definition": "分數. Con số không nguyên vẹn, không đúng một đơn vị, vì có những phần bị chia ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Thân", "definition": "分身. Chia thân mình ra, hoá ra thành hai người khác nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Thân Nhiếp Hóa", "definition": "Cũng gọi Phân Thân Khiển Hóa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Thân Xá Lợi", "definition": "Cũng gọi Toái Thân Xá Lợi.Đối lại: Tòan Thân Xá Lợi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Thư", "definition": "分書. tời giấy quy định việc chia của cải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Thủ", "definition": "分手. Chia tay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Thủ Bản", "definition": "Cũng gọi Lập Tăng Bản, Phần Châu Bản. Chỉ cho chiếc giường kê ở phía tây nam trong Thiền đường. Đây là giường của chức vụ Phân Thủ (người chịu trách nhiệm phân chia công việc cho chúng tăng trong Thiền Lâm) thuộc Hậu Đường Thủ Tọa, vì thế nên gọi là Phân Thủ Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Tiết", "definition": "分泄. Chảy ra ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Trương", "definition": "分 張. Phân biệt. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phân Trần", "definition": "分陳. Đem từng phần của sự việc mà bày tỏ ra “Đem lời phải chẳng phân trần tâu qua” (Hạnh thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Tuế", "definition": "Cũng gọi Tuế Dạ.Chỉ cho đêm trừ tịch, tức giờ giao thừa đánh dấu năm cũ đã qua, bước sang năm mới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Tách", "definition": "Paricchindana (trung), vavattheti (vi + ava + thā + e), viyoga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Tán", "definition": "分散. Rời rạc tan tác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Tâm", "definition": "分心. Lòng dạ bị chia ra, không để lòng riêng vào việc gì được Chia xẻ tâm trạng mà tìm hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Tích", "definition": "分析. Chia một vật thành nhiều phần nhỏ, cấu tạo nên vật đó Mổ xẻ tìm hiểu kĩ càng một sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Tích Thân Phần", "definition": "Dhātu-vavatthāna (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phân Tòa", "definition": "Chia nửa tòa ngồi.Ý nói chia nửa tòa của mình để mời người khác cùng ngồi, biểu thị nghĩa người được mời có địa vị ngang hàng với mình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Tề", "definition": "Chỉ cho giới hạn, sự sai khác. Cũng chỉ cho nội dung, phạm vi, trình độ có chỗ sai khác, hoặc chỉ địa vị, thân phận có trình độ sai khác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Tử", "definition": "分子. Con số bên trên của một phân số, tức Tử số Phần rất nhỏ cấu tạo nên một vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Voi", "definition": "Hatthīlaṇḍa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phân Vân", "definition": "紛紜. Rối loạn, lộn xộn, không biết phải quyết định ra sao Chia nát ra rối loạn cả lên. Lục Vân Tiên có câu: “Ghét đời Ngũ bá phân vân. Loạn thần đa tiếm nhân dân nhọc nhằn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Xử", "definition": "分處. Dàn xếp để mọi người đều bằng lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Âm", "definition": "分陰. Thời gian một phút, chỉ thời gian rất ngắn, khoảnh khắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Đoạn Sinh Tử", "definition": "Fragmentary am āra 分段生死", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phân Đà Lợi Hoa", "definition": "Phạm, Pàli: Puịđarìka.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phân Đương", "definition": "分 當. Nên, cần, phải. Tiết Tục Nghệ Ngôn trong NHQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phân Đạo", "definition": "分道. Chia đường mà đi, mỗi người đi một đường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Đảm", "definition": "分擔. Chia ra cho mọi người cùng gánh vác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Định", "definition": "分定. Quyết rõ riêng về từng việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Đồ", "definition": "分途. Chia đường mà đi, mỗi người một ngả, chỉ sự chia tay. Hoa Tiên có câu “Từ khoa Tân Mão phân đồ, kẻ mừng gặp bước người lo trở nghề”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phân Ưu", "definition": "分憂. Chia buồn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phép Tam Ma Địa", "definition": "Xem Đại Định.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phép thiền mầu nhiệm, độc long nép mình.", "definition": "Thu dạ độc tọa 秋 夜 獨 坐 – Ðêm thu ngồi một mình (Lê Nguyễn Lưu dịch):", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phê", "definition": "批. Lấy tay mà đánh Chống lại Bày tỏ cho người khác biết. Td: Bút phê 筆批 (viết ra ý kiến của mình ) Ta còn hiểu là viết sự quyết định của mình ra Phê nghịch lân 批逆麟: Nghĩa là vuốt ngược vảy rồng. Hàn phi truyện: “Rồng là vật có thể vuốt ve cho quen mà cỡi được, nhưng dưới cổ họng có cái vảy ngược nếu động chạm phải sẽ chết với nó. Ông vua cũng có vảy ngược như thế, mấy người đã dám vuốt. Nên ai can vua thì gọi là vuốt ngược vảy rồng”. “Miệng hùm chớ sợ, vảy rồng chớ ghê”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Bài", "definition": "批 排. Còn gọi: Bài Phê. Sắp xếp, chuẩn bị. Tiết Đạo Ngô Hòa Thượng trong TĐT q. 5 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phê Bình", "definition": "批評. Bày tỏ sự khen chê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Bằng Thức", "definition": "Một loại văn thư xin chính quyền gia hạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Chuẩn", "definition": "批準. Bày tỏ sự bằng lòng. Viết ra để bày tỏ sự ưng thuận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Phán", "definition": "批判. Xét đoán và bày tỏ ý kiến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Phát", "definition": "批發. Bán sỉ hàng hoá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Phó", "definition": "批付. Viết ý kiến của mình vào lá đơn rồi trao cho người đứng đơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Xá Khư", "definition": "Phạm: Vaizàkha. Pàli: Vesàkha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Xá Li", "definition": "Phạm: Vaizàli.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Điểm", "definition": "批點. Đọc bài làm cho học trò rồi bày tỏ ý kiến của mình bằng cách cho điểm số.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phê Đà", "definition": "Phạm, Pàli: Veda.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Đà Giáo", "definition": "Một trong những tông giáo cổ đại diễn biến từ tín ngưỡng của bộ lạc du mục Aryan ở vùng Tây bắc Ấn Độ vào khoảng 2000 năm trước Tây lịch mà thành, thuộc về Đa Thần Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Đà Thánh Điển Cương Yếu", "definition": "Phạm: Vedartha-saôgraha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Đàn Đa Học Phái", "definition": "Phệ Đàn Đa, Phạm: Vedànta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Đàn Đa Tinh Yếu", "definition": "Phạm: Vedànta-sàra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phê Đáp", "definition": "批答. Viết ra để trả lời cho kẻ dưới biết ý kiến của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì", "definition": "淝. Tên sông, tức là Phì thuỷ, thuộc hai tỉnh An Huy và Hà Nam. Bản dịch Chinh phụ ngâm khúc có câu: “Non Kì quạnh quẽ trăng treo, bến phì gió thổi đìu hiu mấy gò”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Cam", "definition": "肥甘. Ngọt béo, chỉ đồ ăn ngon bổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Giả Da", "definition": "Phạm: Vijayà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phì Liệu", "definition": "肥料. Phân bón ruộng đất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Mã", "definition": "肥馬. Con ngựa kéo, ngựa của nhà quyền quý. Td: Phì mã khinh cừu (ngựa béo và áo cừu nhẹ, đồ dùng của người quyền quý, chỉ cuộc sống cao sang).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Mĩ", "definition": "肥美. Béo tốt đẹp đẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Nhiêu", "definition": "肥饒. Tốt đẹp, màu mỡ (nói về ruộng đất).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Nùng", "definition": "肥醲. Thịt béo, rượu nồng. Chỉ bữa ăn ngon. Cũng chỉ cuộc sống cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Nị", "definition": "I.Phì Nị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phì Tiên", "definition": "肥鮮. Béo tốt tươi tắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Tráng", "definition": "肥壯. Béo tốt khoẻ mạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Tạo", "definition": "肥皂. Một tên chỉ xa bông ( savon).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Điền", "definition": "肥田. Ruộng tốt, mầu mỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Địa", "definition": "肥地. Đất tốt, mầu mỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phì Ốc", "definition": "肥沃. Như Phì nhiêu 肥饒.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí", "definition": "怫. Trong lòng không yên Các âm khác là Bội, Phất. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Công", "definition": "Nipphala (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phí Dụng", "definition": "費用. Tiêu dùng Tiền bạc tiêu dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Lực", "definition": "費力. Tốn sức, uổng sức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Nhật", "definition": "費日. Bỏ uổng thời giờ Hao tốn ngày giờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Phạm", "definition": "費犯. Dùng uổng, không biết dè dặt (chỉ người Việt Nam dùng từ ngữ này).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Thần", "definition": "費神. Để tâm trí vào việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Thỉ Địa Ngục", "definition": "Địa ngục phân sôi, tức chỉ cho địa ngục dùng nước phân sôi để trừng trị tội nhân. Tỉ Khưu, Tỉ Khưu Ni... làm ô nhiễm giới hạnh, làm bẩn thức ăn uống của cha mẹ mình, làm dơ dáy thức ăn uống của chúng tăng, hoặc những chúng sinh phá 8 trai giới, 4 bộ đệ tử đem thân ô uế ngồi lên giường của chư tăng thanh tịnh, phạm tội Thâu lan giá đã lâu mà không chịu sám hối, mặc bừa ca sa tham dự pháp hội, tiêu hao vật thực của tăng... đều phải đọa vào địa ngục Phí Thỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phí Thủy", "definition": "沸水. Nước sôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Trường Phòng", "definition": "Danh tăng Trung Quốc sống vào đời Tùy, người Thành Đô. Sư học rộng, giỏi văn chương, thông hiểu cả Nho, Phật, Bách Gia...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phí Tâm", "definition": "費心. Để hết lòng dạ vào Ta còn hiểu là uổng công để lòng dạ vào việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Tổn", "definition": "費損. Tiêu dùng tiền bạc vào việc gì. Truyện Trê Cóc có câu: “Vợ chồng Trê những ngậm ngùi, ra vào phí tổn hết bao cũng đành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phí Đi", "definition": "Hāyati (hā + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phí Ẩn Thiền Sư Ngữ Lục", "definition": "Ngữ Lục, 14 quyển (hoặc 16 quyển), do ngài Phí Ẩn Thông Dung (1593-1661) thuộc Tông Lâm Tế soạn vào đời Minh, các vị Ẩn Nguyên Long Kì... biên tập, được ấn hành vào năm Sùng Trinh 16 (1643).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phí Ẩn Thông Dung", "definition": "(費 隱 通 容, Hiin Tsūyō, 1593-1661): vị tăng của Lâm Tế Tông Trung Quốc, hiệu là Phí Ẩn (費隱), sinh ngày mồng 8 tháng 12 năm thứ 21 niên hiệu Vạn Lịch (萬曆), xuất thân Huyện Phúc Thanh (福清縣), Mân (閩, Tỉnh Phúc Kiến), họ Hà (何). Năm lên 7 tuổi, ông đã chịu tang cha, đến năm 12 tuổi thì để tang mẹ. Năm 14 tuổi, ông xuất gia tu học với Huệ Sơn (慧山) ở Tam Bảo Tự (三寳寺), sau đó đến tham yết một số cao tăng như Trạm Nhiên Viên Trừng (湛然圓澄), Vô Minh Huệ Kinh (無明慧經) và Vô Dị Nguyên Lai (無異元來). Vào năm thứ 2 (1622) niên hiệu Thiên Khải (天啓), trên đường dự định đi từ Giang Tây (江西) đến Thiên Thai (天台), giữa đường dừng chân tại Hống Sơn (吼山), tham yết Mật Vân Viên Ngộ (密 雲圓悟), cơ duyên khế ngộ và cuối cùng kế thừa dòng pháp của vị nầy. Đến năm thứ 5 (1632) niên hiệu Sùng Trinh (崇禎), ông vào Dục Vương Sơn (育王山), và sau đó chuyển đến sống một số nơi như Hoàng Bá Sơn Vạn Phước Thiền Tự (黄檗山萬福 禪寺) ở Huyện Phúc Thanh, Liên Phong Viện (蓮峰院) ở Phủ Kiến Ninh (建寧府, Tỉnh Phúc Kiến), Thiên Ninh Tự (天 寧 寺) ở Hải Diêm (海 塩, Tỉnh Triết Giang), Siêu Quả Tự (超果寺) ở Phủ Tùng Giang (松江府, Tỉnh Giang Tô), Phước Nghiêm Thiền Tự (福 嚴 禪 寺) ở Huyện Sùng Đức (崇 德 縣, Tỉnh Triết Giang), Kính Sơn Hưng Thánh Vạn Thọ Thiền Tự (徑山興聖萬壽寺) ở Phủ Hàng Châu (杭州府, Tỉnh Triết Giang), Duy Ma Tự (維摩寺), và Nghiêu Phong Sơn Hưng Phước Viện (堯峰 山興福院), v.v. Vào ngày 29 tháng 3 năm thứ 18 niên hiệu Thuận Trị (順治), ông thị tịch, hưởng thọ 69 tuổi đời và 56 hạ lạp. Ông soạn các bộ Ngũ Đăng Nghiêm Thống (吾燈嚴統) 25 quyển, Ngũ Đăng Nghiêm Thống Giải Hoặc Biên (吾燈嚴統解惑編) 1 quyển, Tổ Đình Kiềm Chùy Lục (祖庭鉗鎚錄) 2 quyển, Bát Nhã Tâm Kinh Trác Luân Giải (般 若 心 經 斲 輪 解), Ngư Tiều Tập (漁 樵 集). Môn nhân Hoàng Bá Ẩn Nguyên (黄 檗 隱 元) biên tập bộ Phí Ẩn Thiền Sư Ngữ Lục (費 隱 禪 師 語 錄) 14 quyển, Cư Sĩ Vương Cốc (王谷) soạn bản Phước Nghiêm Phí Ẩn Dung Thiền Sư Kỷ Niên Lục (福嚴費隱容禪師紀年錄), Thủy Giám Huệ Hải (水鑑慧海) soạn cuốn Phí Ẩn Dung Hòa Thượng Hành Trạng (費隱容和尚行狀).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phía", "definition": "Pakkha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Bên Kia", "definition": "Pāra (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Dưới", "definition": "Heṭṭhā (trạng từ), heṭṭhima (tính từ), oram (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Hông", "definition": "Passa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Ngoài", "definition": "Bāhira (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Sau", "definition": "Piṭṭha (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Trái", "definition": "Vāma (tính từ), vāmapassa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Trước", "definition": "Uddhaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phía Đông", "definition": "Pubba (tính từ), pubbā (nữ), puratthā (in)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phích", "definition": "澼. Trôi nổi bập bềnh trên mặt nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng", "definition": "坊. Con đê. Bờ đất cao để ngăn nước Ngăn cản Một âm là Phường. Xem Phường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Bệnh", "definition": "防病. Ngăn ngừa sự đau ốm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Bị", "definition": "防備. Sắp đặt đầy đủ từ trước, sẵn sàng đối phó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Chỉ", "definition": "防止. Ngăn ngừa. Ngăn chặn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Chủ", "definition": "房主. Người cho thuê nhà. Chủ nhà cho thuê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Cơ", "definition": "防飢. Ngăn ngừa nạn đói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Cất Y Phục", "definition": "Dussakoṭṭhāgāra (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Dung", "definition": "(?-?).Danh sĩ Trung Quốc, sống vào đời Đường, người Lạc Dương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phòng Dịch", "definition": "防疫. Ngăn ngừa bệnh truyền nhiễm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Giải Khát", "definition": "Āpāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Hỏa", "definition": "防火. Ngăn ngừa nạn cháy nhà Sắp đặt sẵn để chống nạn cháy nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Hộ Căn Môn", "definition": "防護根門 indriya-saṃvara", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phòng Hộ Luật Nghi", "definition": "Phòng vệ, giữ gìn các luật nghi.Tức sau khi thụ giới, thuậntheo giới thể mà thụ trì giới tướng. Về sau, nhờ vào sức tăng thượng của 5 căn(tín, tiến, niệm, định, tuệ), xa lìa tâm sởTư ác và chủng tử cùng hiện hành nên không tạo tội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phòng Khách", "definition": "Paṭikkamana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Khẩu", "definition": "防口. Giữ miệng. Nói năng thận trọng Cũng chỉ sự đàn áp dư luận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng La", "definition": "Cũng gọi Phỏng la.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phòng Lớn", "definition": "Sālā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Nghỉ Tạm", "definition": "Paṭikkamanasālā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Ngủ", "definition": "Ovaraka (nam), sayananighara (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Ngự", "definition": "防禦. Ngăn ngừa chống giữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Nhàn", "definition": "防閑. Ngừa trước và chuẩn bị đối phó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Sơn", "definition": "Cũng gọi Thạch Kinh Sơn. Núi ở huyện Phòng Sơn, tỉnh Hà Bắc, cách Bắc Bình khoảng 40 cây số về mạn tây nam. Đây là nơi có Thạch kinh qui mô lớn nhất hiện còn ở Trung Quốc. Vì sợ kinh Phật bị hủy diệt, thất truyền, nên sa môn Tĩnh uyển (có thuyết nói là Trí uyển) đời Tùy đã thệ nguyện khắc những quyển kinh trên những tấm bia đá, hoặc trên vách các hang động trong núi để bảo tồn lâu dài.Cho nên, vào niên hiệu Đại Nghiệp năm đầu (605) đời Tùy, ngài Tĩnh uyển bắt đầu mở đục các hang động ở chân núi Phòng Sơn, rồi khắc văn kinh trên 4 vách của các hang động. Bấy giờ, ngài Tĩnh uyển tạo lập 7 động: Hoa Nghiêm, Niết Bàn, Bát Nhã, Bảo Tích... Ngoài ra, còn 1 bộ phận Thạch kinh (bằng những tấm bia đá) được chôn ở dưới tháp Áp kinh tại chùa Vân Cư dưới núi.Về sau, trải qua các triều đại Đường, Ngũ Đại, Liêu... Thạch kinh vẫn tiếp tục được khắc tạo, mãi đến năm Đại An thứ 10 (1094) đời Liêu là 480 năm, sự nghiệp khắc kinh đá mới hoàn thành. Hiện nay còn 9 động. Theo thống kê, bây giờ ở núi Phòng Sơn còn tất cả hơn 4.000 bản kinh đá, khắc tới vài nghìn quyển kinh Phật, mỗi bản dài khoảng 2m và rộng 18cm. Còn số kinh ở dưới tháp Áp kinh thì có 7, 8 nghìn bản, nhưng kích thước đều nhỏ hơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phòng Sự", "definition": "房事. Việc xảy ra trong buồng, tức việc vợ chồng, tức việc trai gái ăn nằm với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Thành", "definition": "防城. Ngăn chận quân giặc đánh thành Giữ gìn sự yên ổn trong thành phố.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Thủ", "definition": "防守. Giữ cho khỏi mất, ngăn chống mọi sự đánh chiếm cướp đoạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Tiền", "definition": "房錢. Tiền trả về việc thuê nhà. Tiền nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Tra Tấn", "definition": "Khuragga (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Trong", "definition": "Ovaraka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Trong Đá", "definition": "Leṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Trung Thuật", "definition": "房中術. Tài khéo trong buồng, chỉ sự khéo léo trong việc ăn nằmvới nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Trượng", "definition": "房 丈. Phòng của vị Trụ trì tự viện ở, tức phương trượng. Tiết Đạo Ngô Hòa Thượng trong TĐT q. 5 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phòng Tắm", "definition": "Nahānakoṭṭhaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Tắm Hơi", "definition": "Jantāghara (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Vệ", "definition": "防衞. Che chở an ninh, ngăn ngừa bất trắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Vệ Sinh", "definition": "Vaccakuṭi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Xá Kiền Độ", "definition": "Pàli: Senàsana-khandaka. Cũng gọi Ngọa Cụ Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phòng Ăn", "definition": "Āpānabhūmi (nữ), bhojanasālā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phòng Địch", "definition": "防敵. Sắp đặt sẵn việc chống cự Ngăn ngừa sự tấn công của đối phương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phòng Ốc", "definition": "房屋. Chỉ chung nhà cửa để ở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó", "definition": "仆. Cúi sát xuống đất Mất đi. Chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Bản", "definition": "副本. Tờ giấy phụ, chép nguyên từ tờ chính ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Bảng", "definition": "副榜. Tấm bảng phụ, ghi tên người đậu Tiến sĩ hạng dưới, hạng thứ. Chỉ người đậu Tiến sĩ hạng dưới Danh vị khoa cử thời xưa, dưới bậc Tiến sĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Chi Lưu Thuỷ", "definition": "付之流水. Trao cho dòng nước chảy, ý nói mặc cho số phận đẩy đưa. Cũng chỉ việc nhảy xuống nước tự tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Chiến", "definition": "赴戰. Đi ra để đánh nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Chúc", "definition": "Cũng gọi Phụ Chúc, Chúc Lụy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Chúc Nhất Niệm", "definition": "Nhất niệm, chỉ cho 1 niệm tu hành, tức là 1 tiếng xưng danh niệm Phật. Phó chúc nhất niệm nghĩa là dặn dò phó thác pháp môn xưng danh niệm Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Cơ", "definition": "Đồng nghĩa: Ứng Bệnh Dữ Dược (tùy theo chứngbệnh mà cho thuốc).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Cử", "definition": "赴舉. Đi thi. Truyện Hoa Tiên có câu: “Nghe lời như giẹp cơn nồng, nhân kì phó cử quyết lòng tầm phương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Diệt", "definition": "仆滅. Mất đi. Lặn đi Chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Hấp", "definition": "Phó Hấp (497-569). Cũng gọi Thiện Tuệ Đại Sĩ, Ngư Hành Đại Sĩ, Phó Đại Sĩ, Song Lâm Đại Sĩ, Đông Dương Đại Sĩ, Ô Thương Cư Sĩ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Hỏa Ngoại Đạo", "definition": "Ngoại đạo nhảy vào lửa, 1 trong các ngoại đạo khổ hạnh ở Ấn Độ đời xưa. Phái ngoại đạo này thường ngồi hơ lửa và xông khói vào mũi, nhẫn chịu sự nóng rát khổ não, hoặc nhảy vào lửa mà chết. Họ chấp mê rằng sự hành hạ thân thể như vậy là cái nhân để được quả báo sinh lên thiên đường! (xt. Khổ Hạnh Ngoại Đạo).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Hội", "definition": "赴會. Tới dự cuộc họp mặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Hội Trưởng", "definition": "副會長. Chức vụ hàng nhì trong một đoàn thể, sau vị Hội trưởng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Kinh", "definition": "赴京. Tới kinh đô. Truyện Hoa Tiên có câu: “Mon men thăm hỏi gần xa, mới tường môn mạch, nay đà phó kinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Lí Trưởng", "definition": "副里長. Chức vụ hàng nhì trong làng, sau vị Lí trưởng. Thường gọi tắt là Phó Lí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Lĩnh Binh", "definition": "副領兵. Chức quan võ địa phương, ở hàng Tòng Tam phẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Mẫu", "definition": "傅母. Người mẹ nuôi. Người vú nuôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Nghiệp", "definition": "副業. Nghề phụ, công việc phụ để kiếm tiền, ngoài nghề chính thức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Nghị", "definition": "(?-90 s. TL): Tự là Vũ Trọng, quê ở Phù-phong (thuộc địa phận tỉnh Thiểm-tây ngày nay), thời đại Đông-Hán. Ông làm quan thái sử (chép sử, coi thiên văn, làm lịch) triều vua Minh đế (58-75). Dưới triều vua Chương đế (76-88), ông làm Lan-đài lệnh-sử (như thư viện trưởng ngày nay), cùng với Ban Cố trông coi thư khố ở nội phủ. Năm đầu vua Hòa đế (89-105), ông được Xa-kị tướng quân Bảo Hiến mời làm Kí-thất lệnh-sử (như chánh văn phòng ngày nay); năm sau Bảo Hiến được thăng làm đại tướng quân thì ông cũng được thăng làm tư mã (chức quan võ, thời Hán là thuộc cấp của đại tướng quân). Theo sách sử Phật giáo Trung-quốc, do ông đoán mộng cho vua Hán Minh Đế mà nhà vua đã cử một phái đoàn gồm 18 quan viên triều đình đi sang Tây-vực tìm cầu Phật pháp đem về Trung-quốc. – Có sách viết tên ông là “Truyền Nghị”; có lẽ vì tự dạng chữ Hán của hai chữ “phó” (傅) và “truyền” (傳) trông giống nhau, nên vị này đã đọc nhầm.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phó Ngự Y", "definition": "副御醫. Chức quan văn thời xưa, ở hàng Tòng Ngũ phẩm, dưới chức Ngự y, lo chữa bệnh cho vua và hoàng gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Nhiệm", "definition": "赴任. Đến để nhận lĩnh chức vụ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Nạn", "definition": "赴難. Lăn mình vào chốn nguy hiểm khó khăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Pháp", "definition": "Cũng gọi Phụ Pháp, Phó Y, Truyền Y, Truyền Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Pháp Bát Tổ", "definition": "Đối lại: Truyền Trì Bát Tổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Pháp Tạng", "definition": "Chỉ cho sự phó chúc, truyền trao tạng chính pháp của Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Pháp Tạng Nhân Duyên Truyện", "definition": "Cũng gọi Phó Pháp Tạng Nhân Duyên Kinh, Phó Pháp Tạng Truyện, Phó Pháp Tạng Kinh, Phó Pháp Truyện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Phất", "definition": "付 拂. Giao cho cây phất tử, ý nói thiền sư truyền pháp cho đệ tử, đệ tử từ đây có thể vì chúng thuyết pháp. Tiết Tục Nghệ Ngôn trong NHQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phó Quan", "definition": "赴官. Đến để nhận chức quan. Như Phó nhiệm 赴任. Đoạn trường tân thanh có câu: “Sắm sanh xe ngựa vội vàng, hai nhà cũng thuận một đường phó quan”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Quản Cơ", "definition": "副管奇. Chức quan võ ở địa phương, hàng Tòng Tứ phẩm, dưới chức Quản cơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Sản Phẩm", "definition": "副產品. Chỉ chung những phẩm vật phụ không quan trọng do địa phương sản xuất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Sứ", "definition": "副使. Chức quan ngoại giao, thay mặt triều đình nói chuyện với nước ngoài. Thời xưa là chức vụ đặc biệt do một vị quan kiêm nhiệm, sẽ chấm dứt khi xong việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Thang Đạo Hoả", "definition": "赴湯蹈火. Nhảy vào nước sôi, bước lên lửa nóng, ý nói không sợ nguy hiểm. “Phép hay đạo hoả phó thang, ngồi gươm đứng giáo mở đường thiên hoang” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Thác", "definition": "付託. Trao gởi. Nhờ cậy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Thỉnh", "definition": "Cũng gọi Thụ Thỉnh, Thụ Trai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Thủ", "definition": "副手. Người giúp việc. Người phụ tá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Thự", "definition": "副署. Kí tên thêm vào. Nói về viên chức cấp dưới kí tên thêm vào một văn kiện, sau khi viên chức cấp trên đã kí tên rồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Tài", "definition": "Giao phó tài sản cho. Nghĩa là trên hội Bát Nhã, Đức Phật gia bị cho ngài Tu bồ đề - vốn là Thanh Văn Tiểu Thừa - nói Kinh Bát Nhã cho hàng Bồ Tát Đại Thừa nghe, cũng như đem pháp tài Đại Thừa giao phó cho Thanh Văn Tiểu Thừa, vì thế gọi là Phó Tài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Tướng", "definition": "副將. Chức quan võ, đứng hàng nhì trong một đoàn quân, sau vị Tướng quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Tượng", "definition": "副象. Cái hiện tượng theo một hiện tượng khác mà sinh ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Tịch", "definition": "赴席. Tới dự tiệc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Tổng Thống", "definition": "副總統. Chức vụ dân cử, đứng hàng thứ nhì trong quốc gia dân chủ, sau vị Tổng thống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Từ", "definition": "副詞. Tiếng phụ, giúp rõ nghĩa tiếng chính, còn gọi là Trạng từ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Tự", "definition": "Fūsu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phó Văn", "definition": "訃聞. Báo tin trong gia đình có người chết, và cho biết đầy đủ các chi tiết như chết ngày nào giờ nào, tại đâu, đám tang sẽ bắt đầu từ giờ nào ngày nào, tại đâu, người chết được chôn ở đâu v.v.,.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Vương", "definition": "Uparajja (trung), uparāja (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phó Y Hòa Thượng", "definition": "Vị Hòa Thượng Giới Sư trao áo pháp Ca Sa cho người nhận giới.Nếu vị Giới Sư trao tọa cụ thì gọi là Phó cụ hòa thượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Đô Ngự Sử", "definition": "副都御史. Chức quan văn thời xưa, ở hàng Tòng Nhị phẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Đô Đốc", "definition": "副都督. Cức quan võ thời xưa, ở hàng Chánh Nhị phẩm Cấp bậc sĩ quan Hải quân ngày nay, tương đương với Trung Tướng Lục quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Đại Sĩ", "definition": "Fudaishi (J), Fu ta shih (C), Fudaishi (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phó Đại Sĩ Giảng Kinh", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Đại Sĩ Lục", "definition": "Cũng gọi Thiện Tuệ Đại Sĩ Ngữ Lục, Thiện Tuệ Đại Sĩ Lục, Đại Sĩ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phó Đề Đốc", "definition": "副提督. Chức quan võ thời xưa, ở hàng Tòng Nhị phẩm Cấp bậc sĩ quan Hải quân ngày nay, tương đương với cấp Chuẩn Tướng Lục quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Địch", "definition": "赴敵. Ra chống giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Ấn", "definition": "付印. Đưa bản thảo cho nhà in để đem in.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phó Ứng Tự", "definition": "Chỉ cho những ngôi chùa chuyên về việc cử hành các nghi thức đàn tràng theo Du Già hiển mật để đáp ứng nhu cầu của thế tục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phóng", "definition": "倣. Bắt chước Cũng đọc Phỏng. Xem Phỏng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Ca", "definition": "放歌. Lớn tiếng mà hát Hát nghêu ngao, không theo bài bản âm điệu gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Chư Thư", "definition": "放 藞 苴. Thô lỗ và chẳng giữ quy củ. Bài thơ “Tự tán” Xiển Đề Chiếu Thiền Sư trong GTPĐL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Chẩn", "definition": "放賑. Đem tiền của ra phát không cho kẻ nghèo khổ hoạn nạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Diệm Khẩu", "definition": "放 焰 口; C: fàngyànkǒu; nghĩa là “Phóng thả những miệng đang cháy”; Một nghi lễ dành cho người đã chết. Diệm khẩu là một loại Ngạ quỉ. Buổi lễ này – vốn bắt nguồn từ hệ thống Tan-tra của Mật tông – được thực hành với mục đích giải thoát những con quỉ đói ra khỏi những cảnh khổ đau của địa ngục và tạo điều kiện cho chúng tái sinh trở thành người hoặc bước vào những Tịnh độ. Lễ này rất được ưa chuộng và phổ biến, được các thân quyến của những người chết tổ chức thực hiện và cũng có khi được thực hiện chung với lễ Vu-lan-bồn (s: ullambana). Ngày nay, buổi lễ này không thuộc vào một trường phái nhất định nào của Phật giáo. Lễ Phóng diệm khẩu kéo dài khoảng 5 tiếng và được thực hiện vào buổi tối bởi vì trong thời gian này, quỉ đói dễ di chuyển kiếm ăn hơn. Các vị tăng thực hiện nghi lễ này đều mang mũ đỏ hoặc vàng dưới dạng một vương miện, sử dụng những khí cụ thuộc Mật giáo như chuông, Kim cương chử (s: vajra) và kêu gọi Tam bảo hỗ trợ. Sau đó, các vị mở cửa địa ngục bằng những thủ ấn, khế Ấn, mở những “miệng đang cháy” và rót nước dịu ngọt vào, một loại nước trước đó được ban phép lành bằng những Man-tra. Ngay sau đó thì những Diệm khẩu này Qui y tam bảo, Thụ giới Bồ Tát. Nếu buổi lễ này được thực hiện nghiêm chỉnh với kết quả tốt thì những quỉ đói có thể lập tức tái sinh vào cõi người hoặc một tịnh độ. Lễ này còn được thực hiện đến ngày nay tại các nước Ðông, Ðông nam á, đặc biệt là tại Ðài Loan (taiwan) và Hương Cảng (hongkong). Theo truyền thuyết thì lễ này bắt nguồn từ Tôn giả A-nan-đà. Sau khi nằm chiêm bao thấy những Diệm khẩu, Tôn giả sợ hãi. Ðể ngăn ngừa khả năng tái sinh thành loài quỉ đói này, Tôn giả bèn tham vấn đức Phật và Ngài liền đọc chú Ðà-la-ni (s: dhāraṇī) để cứu giúp chúng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phóng Dương", "definition": "放洋. Ra khơi, hướng thuyền ra biển xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Dạ", "definition": "放夜. Buông thả cho đi lại suốt đêm ngoài đường, không cấm đoán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Dật", "definition": "Pramada (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Dật Thập Tam Quả Báo", "definition": "Phóng dật thập tam quả báo là người phóng dật, sống buông lung sẽ bị 13 quả báo, bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phóng Hoài", "definition": "放懷. Buông thả lòng dạ, muốn gì là làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Hoả", "definition": "放火. Nổi lửa đốt cho cháy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Hào Quang", "definition": "Emit bright light, to.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Há", "definition": "I.Phóng Há.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phóng Há Đồ Đao Lập Địa Thành Phật", "definition": "Buông con dao đồ tể xuống, đứng ngay đó mà thành Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phóng Hám", "definition": "放 憨. Làm bộ ngu dốt. Tiết Cổ Sơn An Vĩnh Thiền Sư trong NĐHN q. 27 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Hạ", "definition": "放下. Ném xuống phía dưới Thả xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Hạ Đồ Đao", "definition": "Ném cái dao hàng thịt xuống. Nguyên trong câu chữ Hán: “Phóng hạ đồ đao, lập địa thành Phật”, ném cái đao hàng thịt xuống, thành Phật ngay lập tức. Phút trước còn mê lầm, phạm sai lầm, như là làm nghề hàng ngày sát sinh, thế nhưng nếu phút sau, biết tận tình ăn năn hối lõi, giác ngộ, thì chỉ ném cái dao xuống đất là có thể chứng đạo. Như, cái nhà bị bóng tối bao phủ hàng trăm năm, hàng nghìn năm, nhưng nếu rọi đèn vào thì phút chốc trở nên sáng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phóng Học", "definition": "放學. Hết giờ học. Tan học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Khoáng", "definition": "放曠. Chỉ tính tình rộng rãi, không chịu gò bó trong khuôn khổ nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Khí", "definition": "放棄. Liệng bỏ đi. Ruồng bỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Lãng", "definition": "放浪. Như Phóng đãng 放蕩.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Lãnh Tiền", "definition": "放冷箭. Buông mũi tên ngầm, chỉ sự ngầm làm hại người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Mệnh", "definition": "放命. Buông trôi lệnh trên. Trái lệnh trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Ngoan", "definition": "放 頑. Vờ ngớ ngẩn, giả bộ đần độn. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Ngôn", "definition": "放言. Lời nói buông thả, không suy nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Nhiệm", "definition": "放任. Mặc kệ, người ra sao thì ra, không dính dáng đến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Nhân", "definition": "放人. Người có cuộc sống buông thả, không theo phong tục tập quán, lễ nghi thông thường Cũng chỉ người ở ẩn, không ràng buộc trong khuôn khổ nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Nhất Tuyến Đạo", "definition": "放 一 線 道. Mở ra một con đường, chỉ cho pháp môn phương tiện của thiền sư lập bày khi tiếp dẫn người học. Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Pháo", "definition": "放砲. Bắn súng Bỏ bom.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Quang", "definition": "Theo Phật giáo Đại thừa thì trước khi thuyết một bộ Kinh quan trọng, đức Phật cũng thường phóng ra hào quang rực rỡ, chiếu khắp mười phương thế giới. Phóng quang được xem như là điềm lành. Do đó mà có hợp từ phóng quang thùy. Thùy là điềm tốt.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phóng Quang Bát Nhã Ba La Mật Kinh", "definition": "Xem Phóng Quang Bát Nhã Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Quang Bát Nhã Kinh", "definition": "Xem Phóng Quang Bát Nhã Ba La Mật Đa Kinh.Xem Đại Phẩm Bát Nhã.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Quang Kinh", "definition": "Xem Phóng Quang Bát Nhã Ba La Mật Đa Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Quang Phật Đảnh", "definition": "Xem Quang Tụ Phật Đảnh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Quang Tam Muội", "definition": "Raśmi-pramukta-samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phóng Quang Tự", "definition": "放 光 寺. ở núi Kê Túc thuộc Đại Lý, tỉnh Vân Nam, Trung Quốc. Cuối niên hiệu Vạn Lịch (1573-1619) đời Minh, Mộc Công vì Thiền Sư Bản Vô mà cất chùa. Điện vũ nguy nga, kết cấu đặc biệt, là chùa mà hàng tín đồ Phật tử phải viếng. Trong thời kỳ kháng chiến Đại sư Thái Hư từng trụ tích nơi này.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Quá Nhất Trước", "definition": "放 過 一 著. Ý nói nhường người một bước, cởi mở một phen, chỉ cho thiền sư lúc tiếp dẫn người học căn khí trung hạ chọn dùng pháp môn phương tiện. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Ra", "definition": "Niccharati (ni + car + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phóng Sanh", "definition": "(放生): Phóng Sanh là một hành vi có tâm thương yêu, nhân từ, biết thông cảm cho nỗi khổ bị giam cầm, bắt bớ của các loài động vật; có nghĩa là nhìn thấy các loại chúng sinh có mạng sống đang bị bắt nhốt, giam cầm, sắp sửa bị giết hại, kinh hoàng lúng túng, mạng sống trong phút giây nguy ngập, liền phát lòng từ bi tìm cách cứu chuộc. Như vậy tức là hành vi giải thoát, phóng thích, cứu lấy mạng sống của sinh vật khác. Nguyên lai, Trung Quốc đã có quan niệm truyền thống cho rằng Trời có đức háo sinh (muốn sống, ham sống). Lập cước trên tinh thần từ bi, cứu nhân độ thế, Phật Giáo lại càng nêu cao và tôn trọng tinh thần Phóng Sanh. Trong Đại Trí Độ Luận (大智度論, Taishō Vol. 25, No. 1509) quyển 13 có nhấn mạnh rằng: “Chư dư tội trung, sát tội tối trọng; chư công đức trung, bất sát đệ nhất (諸餘罪中、殺罪最重、諸功德中、不殺第一, trong các tội lỗi, tội giết là nặng nhất; trong các công đức, không giết là số một).” Cho nên, không sát sanh cũng như Phóng Sanh là phương pháp hữu hiệu để nuôi dưỡng và làm tăng trưởng tâm từ bi. Phạm Võng Kinh (梵網經, Taishō Vol. 24, No. 1484) quyển 2 nhấn mạnh rằng: “Nhược Phật tử, dĩ từ tâm cố hành phóng sanh nghiệp, nhất thiết nam tử thị ngã phụ, nhất thiết nữ nhân thị ngã mẫu; ngã sanh sanh vô bất tùng chi thọ sanh; cố Lục Đạo chúng sanh giai thị ngã ngã phụ mẫu, nhi sát nhi thực giả, tức sát ngã phụ mẫu diệc sát ngã cố thân; nhất thiết địa thủy thị ngã tiên thân, nhất thiết hỏa phong thị ngã bản thể; cố thường hành phóng sanh, sanh sanh thọ sanh thường trú chi pháp, giáo nhân phóng sanh; nhược kiến thế nhân sát súc sanh thời, ưng phương tiện cứu hộ giải kỳ khổ nạn (若佛子、以慈心故行放生業、一切男子是我父、一切女人是我母、我生生無不從之受生、故六道眾生皆是我父母、而殺而食者、卽殺我父母亦殺我故身、一切地水是我先身、一切火風是我本體、故常行放生、生生受生常住之法、敎人放生、若見世人殺畜生時、應方便救護解其苦難, nếu Phật tử, vì lấy từ tâm mà thực hành nghiệp phóng sanh, hết thảy người nam là cha ta, hết thảy người nữ là mẹ ta; ta đời đời không theo đó mà thọ sanh; cho nên sáu đường chúng sanh đều là cha mẹ của ta; nếu giết nếu ăn thịt họ, tức là giết cha mẹ ta cũng như giết thân trước kia của ta; hết thảy đất nước là thân trước kia của ta, hết thảy gió lửa là bản thể của ta; cho nên thường thực hành phóng sanh, đời đời thọ sanh pháp thường trú, chỉ cho người phóng sanh; nếu khi thấy người đời giết sinh vật nuôi, nên phương tiện cứu giúp để giải mở khổ nạn của con vật ấy).” Đại Thừa Đại Tập Đia Tạng Thập Luân Kinh (大乘大集地藏十輪經, Taishō Vol. 13, No. 411) có nêu một số công đức của việc Phóng Sanh như:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phóng Si Hám", "definition": "放 痴 憨. Làm ra vẻ vừa ngu si vừa ngớ ngẩn. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Sinh", "definition": "Các loài vật như chim cá v.v... bị người ta bắt để ăn thịt, chúng ta xin hoặc mua lại, chim thì đem thả vào rừng, cá thì thả xuống sông, hồ, trả lại mạng sống cho chúng, gọi là “phóng sinh”. Những loài vật dù nhỏ hay lớn đang bị mắc nạn mà mình cứu chúng nó khỏi chết, cũng tức là “phóng sinh”. Như vậy, hạnh tu phóng sinh của người Phật tử đã xuất phát từ lời Phật dạy cấm giết hại chúng sinh để ăn thịt được ghi trong kinh luật, và tiến thêm một bước tích cực hơn là cứu hộ, bảo vệ mạng sống của muôn loài. Hồi còn tại thế, đức Phật đã từng dạy chư tăng luôn luôn phải lọc nước trước khi uống. Khi lọc nước, nếu có các sinh vật nhỏ bé thì hãy bỏ chúng vào một cái “bình phóng sinh” (phóng sinh khí), rồi đem thả ở sông, hồ. Có thể xem đó là khởi thỉ của hạnh tu phóng sinh trong Phật giáo. Trong kinh Phạm Võng có dạy: Tất cả chúng sinh trong sáu đường đều có thể là cha mẹ mình, cho nên người Phật tử phải dùng lòng từ bi mà tu hạnh phóng sinh, nếu thấy người đời giết các loài súc sinh thì nên tìm mọi cách để cứu hộ chúng. Có rất nhiều cách để thực hiện hạnh phóng sinh, như Kinh Kim Quang Minh chép: Trưởng Giả Lưu Thủy, đi đường thấy một đàn cá rất đông, ở chỗ nước gần cạn hết, sắp chết. Ông bèn dùng túi đựng nước đổ xuống, nhờ đó mà cá thoát chết. Ông lại nói pháp cho chúng nghe. Sau khi mạng sống đã hết, cả đàn cá ấy đều được sinh lên cõi trời Đao-lợi. (Xem thêm các mục: “Bầy Lươn Báo Mộng”, “Cắt Thịt Cho Chim Ưng Ăn”, “Chim Xây Mộ Cho Người Phóng Sinh”, “Chồn Cứu Mạng Ân Nhân”, “Con Chết, Mẹ Đứt Ruột”, “Cứu Chim Sẻ, Bốn Đời Quí Hiển”, “Cứu Rắn Trở Thành Danh Y”, “Cứu Sống Ba Ba, Được Chữa Lành Bệnh”, “Cứu Sống Bầy Kiến Mà Thọ Mạng Kéo Dài”, “Cứu Sống Bầy Kiến Mà Trở Thành Thủ Khoa”, “Cứu Sống Cá Chép Được Tăng Tuổi Thọ”, “Cứu Sống Ruồi Nhặng, Được Minh Oan”, “Di Ái”, Đại Sư Liên Trì Cứu Rết, “Đức Nhân Của Vua Thành Thang”, “Phóng Sinh Được Phong Hầu”, “Phóng Sinh, Được Sinh Lên Thiên Giới”, “Quan Huyện Cấm Sát Sinh”, “Rùa Cứu Mạng”, “Tào Khê Giữ Lưới Thợ Săn”, “Thả Cá Phóng Sinh, Bệnh Mụt Nhọt Được Chữa Lành”, “Thí  Thân Cho Cọp Đói”, “Thúc Ngao Đập Rắn”, “Tùy Hầu Cứu Rắn, Được Đền Ơn Trọng Hậu”, “Vì Cứu Sinh Vật Mà Cầu Mưa”.)", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phóng Sinh Hội", "definition": "Pháp Hội thả các loài sinh vật theo lời dạy trong kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phóng Sinh Khí", "definition": "Đồ dùng chứa các vi sinh vật để mang thả xuống ao, hồ...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phóng Sinh Được Phong Hầu", "definition": "(Truyền thuyết Trung-quốc). Khổng Du vốn là một quan chức nhỏ, cũng đã từng phóng sinh một con rùa. Rùa nổi lên mặt nước, ngoảnh đầu lại nhìn Du mấy lần rồi mới lặn xuống nước. Sau, vì có công mà ông được phong hầu. Khi đúc ấn, cái quai ấn khắc hình con rùa, và tự nhiên, đầu con rùa quay lại ngó ra sau. Người thợ bỏ đi, đúc lại mấy lần, đầu rùa nơi cái khuôn vẫn hướng thẳng phía trước, nhưng đầu rùa trên chiếc ấn cứ quay ngó ra sau. Viên quan trông coi việc đúc ấn kinh dị vô cùng, liền đi báo cho ông biết. Ông bỗng nhớ lại lúc thả con rùa, nó ngoái đầu ngó lại ông mấy lần. Thì ra, việc ông được phong hầu chính là quả báo của hành động phóng sinh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phóng Sinh Được Sinh Lên Thiên Giới", "definition": "(Truyền thuyết Trung-quốc). Đời Tống, có viên quan đề hình họ Trương, thường đến các lò sát sinh, mua những súc vật còn sống thả đi, khỏi bị giết. Về sau, lúc lâm chung, ông nói với người nhà: “Ta nhờ phóng sinh mà có nhiều phước đức. Nay thiên chúng đến đón ta lên trời.” Nói xong, an nhiên nhắm mắt.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phóng Sự", "definition": "訪事. Hỏi về việc xảy ra Ngày nay ta còn hiểu là bài báo thuật lại sự việc xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Thí", "definition": "放屁. Đánh rắm (đánh địt). Sau này ta còn gọi là Trung tiện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Thích", "definition": "放釋. Buông thả ra, không cầm giữ nữa Trả tự do cho tù nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Thủ", "definition": "放手. Buông thả cho tay mình, ý nói làm gì thì làm, không biết kiêng nể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Trái", "definition": "放債. Cho vay lấy lời Bỏ vốn ra cho người khác làm ăn, rồi chia lời với mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Trục", "definition": "放逐. Đuổi đi. Đuổi ra khỏi vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Tài Hoá", "definition": "放財貨. Bỏ tiền của ra để đổi lấy lợi ích cho mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Tác", "definition": "倣作. Bắt chước theo mà làm Chỉ sự việc một nhà văn dựa theo cốt truyện của một người khác trong một cuốn truyện khác, để viết thành truyện của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Tâm", "definition": "放心. Như Phóng hoài 放懷 Cũng chỉ sự không lo nghĩ, để ý gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Túng", "definition": "放縱. Buông thả, không bị gò bó gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Tứ", "definition": "放恣. Chỉ tính tình buông thả, hành động theo ý mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Viên", "definition": "訪員. Người làm việc cho toà báo, hoặc đài truyền thanh, truyền hình, có nhiệm vụ đi tìm kiếm hỏi han sự thật về một vấn đề, hoặc một việc xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Vô Đoan", "definition": "放 無 端. Giả bộ ngu dốt cốt không cho người khác cậy dựa. Bài thơ khen Hòa Thượng Đại Huệ trong MANL ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Vấn", "definition": "訪問. Hỏi han tìm kiếm sự thật. Cũng đọc: Phỏng vấn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Xạ", "definition": "放射. Bắn tia sáng ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Ý", "definition": "放 意. Tự tại tùy thích. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phóng Đãng", "definition": "放蕩. Tính tình buông thả, không theo khuôn phép gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Đăng", "definition": "放燈. Cho thắp đèn và đi lại trong ban đêm, không cấm đoán. Cũng như Phóng dạ 放夜", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Đại", "definition": "放大. Làm cho lớn lên, cho to hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Đạt", "definition": "放達. Chỉ tính tình rộng rãi, không chịu gò bó trong khuôn khổ nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Đảm", "definition": "放膽. Lớn mật, không biết sợ gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Đản", "definition": "放誕. Tính tình buông thả, ăn nói bậy bạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phóng Đảo", "definition": "放 倒. Lười biếng. Như Tịnh Ngữ Lục q. hạ:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phô", "definition": "抪. Giữ chặt. Đè chặt Rải rác ra Lấy tay mà đánh Cũng đọc Bá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phô Bài", "definition": "鋪排. Sắp đặt ra ngoài cho người khác thấy. Ta thường nói trại thành Phô bày.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phô Trương", "definition": "鋪張. Bày ra bên ngoài để khoe khoang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phô Trần", "definition": "鋪陳. Bày ra cho người khác thấy Nói rõ ra. Kể hết ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phôi", "definition": "𠂾. Như chữ Phôi 坯.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phôi Bàn", "definition": "肧盤. Cái mầm trong lòng đỏ trứng. Khi trứng được ấp mầm này sẽ nở thành gà, chim con.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phôi Châu", "definition": "肧珠. Hạt nhỏ, coi như mầm hoa, sẽ kết thành trái cây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phôi Dựng", "definition": "肧孕. Có thai Cái thai còn nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phôi Thai", "definition": "肧胎. Cái thai còn nhỏ Chỉ tình trạng non nớt, mới thành hình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Hóa", "definition": "(普化, Fuke, ?-?): vị Thiền tăng sống vào thời nhà Đường, người kế thừa dòng pháp của Bàn Sơn Bảo Tích (盤山寶積), thường sống ở Trấn Châu (鎭州, thuộc Tỉnh Hà Đông). Ông theo hầu Bàn Sơn, thọ nhận yếu chỉ, rồi sống cuộc đời như vị cuồng tăng. Sau khi thầy qua đời, ông đi ngao du địa phương phía Bắc. Tương truyền ông thường cầm trên tay cái chuông lắc, mỗi khi gặp người ta thì ông lại lắc lên. Nếu có ai quan tâm đến, ông liền bảo rằng: “Xin cho tôi một quan tiền.” Ông thường kết giao với Lâm Tế Nghĩa Huyền (臨濟義玄), và cũng đã từng phụ giúp vị nầy giáo hóa đồ chúng. Theo phần Kham Biện (勘辨) của Lâm Tế Lục (臨濟錄) cho biết rằng ông đã từng muốn chính Lâm Tế tặng cho ông một cỗ quan tài, và sau đó ông thị tịch trong quan tài ấy tại cửa bắc Trấn Châu. Cuối đời ông đến sống ở Lâm Tế Viện, hằng ngày ăn rau cỏ sống, bị Lâm Tế phát hiện được mới bảo ông là giống con lừa. Tương truyền khi nghe nói như vậy Phổ Hóa liền thét lên tiếng lừa.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù", "definition": "咐. Nôn khan, oẹ khan Thổi mạnh Một âm là Phó. Xem Phó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Biểu", "definition": "浮泡. Vật dụng thả vào chất lỏng, xem mức nổi của nó để biết chất nó loãng hay đặc thế nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Bào", "definition": "浮泡. Bọt nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Bình", "definition": "浮萍. Cây bèo Bèo nổi. Chỉ cuộc sống trôi nổi vất vả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù BôI", "definition": "(浮杯):", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Bạc", "definition": "浮薄. Chỉ lòng dạ nông nổi, ăn ở không tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Châu", "definition": "鳧舟. Chiếc thuyền nhỏ, bơi nhanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Chú", "definition": "符咒. Lá bùa và lời khấn, có thể đổi được tà ma Phù chú 符咒: Lá bùa của câu chú: Bí quyết của đạo gia dùng để đuổi ma quỷ. “Lại thêm phù chú xưa nay ai bì”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Cừ", "definition": "芙蕖. Một tên chỉ cây sen, hoa sen.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Danh", "definition": "浮名. Cái tiếng tăm hão huyền Trịnh văn tẩu thi: Phù danh phù lợi nồng ư tửu. Tuý đắc nhân tâm tử bất tinh (Hư danh, hư lợi nồng hơn rượu. Đến chết lòng người chẳng tỉnh say). “khéo khéo đậu ai để phù danh”. (Hoài cổ ngâm).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Du", "definition": "浮游. Trôi nổi, nay đây mai đó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Dung", "definition": "芙蓉. Tên một thứ cây lá to, hoa nhiều màu, nở về mùa hè. Bản dịch Chinh phụ ngâm khúc có câu: “Nay đào đã quyến gió đông, Phù dung lại đã bên sông bơ phờ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Dung Đạo Giai", "definition": "(芙 蓉 道 楷, Fuyō Dōkai, 1043-1118): vị tăng của Tào Động Tông Trung Quốc, xuất thân Phí Huyện (費縣), Nghi Châu (沂州, Tỉnh Sơn Đông), họ là Thôi (崔). Lúc nhỏ ông học thần tiên đạt được các bí thuật rồi đến ẩn cư tại Y Dương Sơn (伊陽山) thuộc Tỉnh Hà Nam (河南省). Lâu sau ông lên kinh sư dạo chơi, rồi xuất gia ở Thuật Thánh Viện (述聖院, tức Thuật Đài Tự [ 術台寺]), tôn Đức Xiêm (德 暹) làm thầy. Vào năm 23 tuổi ông thọ cụ túc giới. Sau đó, ông đi du phương tham học, gặp được Nghĩa Thanh (義清) ở Đầu Tử Sơn (投子山) vùng Thư Châu (舒 州, Tỉnh An Huy), nhân nghe lời dạy của vị nầy mà đại ngộ và được kế thừa dòng pháp của vị nầy. Sau ông từ giã thầy đến Thiều Sơn (韶山), hằng ngày thường sống với cọp beo. Vào năm thứ 5 (1082) niên hiệu Nguyên Phong (元豐), ông khai mở đạo tràng bố giáo tại Tiên Động Sơn (仙洞山), Nghi Châu. Ông đã từng sống qua các nơi như Càn Nguyên Chiêu Đề (乾元招提) vùng Tây Kinh (西京, Tỉnh Hà Nam) cũng như Đại Dương Sơn (大 陽 山) ở Dĩnh Châu (郢 州, Tỉnh Hồ Bắc). Vào năm thứ 2 (1103) niên hiệu Sùng Ninh (崇 寧), ông đến làm trú trì đời thứ hai của Sùng Ninh Bảo Thọ Thiền Viện (保壽禪院) ở Đại Hồng Sơn (大洪山), Tùy Châu (隨州, Tỉnh Hồ Bắc). Năm sau, thể theo chiếu chỉ nhà vua, ông đến trú trì Thập Phương Tịnh Nhân Thiền Viện (十方淨人禪院) ở Đông Kinh (東京, Tỉnh Hà Nam), rồi vào năm đầu (1107) niên hiệu Đại Quán (大 觀), ông chuyển đến Thiên Ninh Tự (天 寧 寺). Vào mùa xuân năm sau, ông được ban cho Tử Y và hiệu là Định Chiếu Thiền Sư (定 照禪師), nhưng ông cố từ không nhận. Cũng do vì việc nầy mà vào mùa đông năm nầy, ông bị lưu đày đến Chuy Châu (淄州, Tỉnh Sơn Đông). Đến năm đầu (1111) niên hiệu Chính Hòa (政和), ông được tha tội, bèn lên Thiên Thai (天台), Nhạn Đãng (雁 蕩) ngao du và khi trở về cố hương mình thì cha đã già yếu, nên ông dừng chân tại đây. Vị quan Xu Mật Lưu Công (劉公) dựng am thất ở Phù Dung Hồ Điền (芙蓉湖 田, Tỉnh Sơn Đông), thỉnh ông đến ở và ông đã thành lập nơi đây khu tùng lâm. Vào ngày 14 tháng 5 năm thứ 8 niên hiệu Chính Hòa, ông thị tịch, hưởng thọ 76 tuổi đời và 42 hạ lạp. Đệ tử ông có 93 người, trong đó ra đời thành công là 29 người, đặc biệt có Đơn Hà Tử Thuần (丹霞子淳) là nhân vật kiệt xuất nhất. Hiện vẫn còn lưu hành bộ Phù Dung Giai Thiền Sư Ngữ Yếu (芙蓉楷禪師語要) 2 quyển của ông.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Dung Đạo Khải", "definition": "Fuyo Dokai (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phù Dân", "definition": "浮民. Kẻ vô nghề nghiệp, lang thang trôi nổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Dĩ", "definition": "芣苢. Tên một loại cây dùng làm vị thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Dưỡng", "definition": "扶養. Giúp đỡ nuôi nấng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Dự", "definition": "浮譽. Tiếng tăm trống rỗng. Như Phù danh 浮名.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Dực", "definition": "扶翼. Giúp đỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Hiêu", "definition": "浮囂. Tính tình nông nổi, hợm minh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Hiệu", "definition": "符號. Cái dấu để nhận biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Hoa", "definition": "浮華. Đẹp đẽ hời hợt bề ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Hoặc Nhuận Sinh", "definition": "Nhờ phiền não giúp đỡ mà sinh trong 3 cõi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Huề", "definition": "扶携. Giúp đỡ dẫn dắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Hợp", "definition": "符合. Vừa với nhau, ăn khớp với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Khởi", "definition": "Đối lại: Thôi Đảo (xô ngã), Phóng Đảo. Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Khởi Môn", "definition": "浮 起 門. Còn gọi: Kiến lập môn. Phương pháp kiến lập nâng đỡ, khẳng định tất cả pháp nghĩa phân biệt như: mê ngộ, chúng sinh Phật, thiện ác, dài ngắn… Đây thuộc về cơ pháp “phóng hành” (buông thả) của bậc thầy đã kiến tính dùng để tiếp hóa người học.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phù Kiên", "definition": "(338-385).Vua nhà Tiền Tần đời Đông Tấn, tự Vĩnh Cố hoặc Văn Ngọc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Kiều", "definition": "浮橋. Cầu nổi, do nhiều chiếc thuyền kết lại.”Đội quân nọ bắt cầu phù kiều”. (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Kê", "definition": "扶乩. Một lối cầu hồn, hai người đỡ lấy cái que, đầu que đưa trên mâm gạo, khấn vái để tay mình đưa cái que, vạch thành chữ trên mâm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Li Mạc Bích", "definition": "Đỡ bờ dậu, sờ bức vách. Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Luật", "definition": "(扶律): tức Phù Luật Thuyết Thường (扶律說常) hay Phù Luật Đàm Thường (扶律談常), dụng ngữ dùng để nói về hạng người chuyên miệt thị giới pháp, thấy Như Lai nhập diệt rồi sinh ngộ giải cho rằng chính Phật cũng vô thường. Từ này chủ ý muốn nhấn mạnh vấn đề giữ gìn giới luật và Phật tánh là thường trụ. Đối với Thiên Thai Tông thì từ này dùng để nói về giáo thuyết của Đại Bát Niết Bàn Kinh (大般涅槃經).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Luật Đàm Thường", "definition": "Cũng gọi Phù Luật Thuyết Thường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Lãng", "definition": "浮浪. Trôi dạt lông bông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Lưu", "definition": "扶留. Cây trầu không, lá để ăn trầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Lạm", "definition": "浮濫. Quá độ. Vượt quá mức thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Lợi", "definition": "浮利. Cái lợi không chắc chắn vững bền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Lục", "definition": "符籙. Lá bùa của đạo sĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Mộc", "definition": "Bộng cây nổi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Nam Quốc", "definition": "Cũng gọi Bạt Nam, Ấp Tâm, Các Mậu. Nước Phù Nam (Funan), tên xưa của Kampuchia, nằm về phía nam của bán đảo Trung Nam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Nan", "definition": "Một vương quốc cổ ở Nam Á, thành lập vào khoảng thế kỷ I TL, được cũng cố khá hùng mạnh vào thế kỷ thứ 5. Lãnh thổ bao quát phía nam bán đảo Đông Dương, vùng hạ lưu sông Cửu Long. Vương quốc Phù Nan bị diệt vào thế kỷ thứ 6, thay vào là vương quốc Tchen La. Có những dấu hiệu cho thấy một phái đoàn truyền giáo (đạo Phật) của vua Asoka (300 năm TCN) đã đến Phù Nan, sau đó có thể đã đi ngược lên Bắc Việt Nam.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phù Nang", "definition": "浮囊. Cái phao, để đeo vào người khi xuống nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Nghĩa", "definition": "扶義. Giúp vào việc phải. Trọng việc phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Nghị", "definition": "浮議. Lời bàn bạc xa xự thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Nguy", "definition": "扶危. Giúp đỡ người khác trong lúc hiểm nghèo. “Mấy tài dẹp loạn phù nguy”. (Phan Trần).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Ngôn", "definition": "浮言. Lời nói hời hợt, không có giá trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Nhân", "definition": "烰人. Người làm bếp. Đầu bếp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Phiếm", "definition": "浮泛. Trôi nổi lông bông Chỉ sự thiếu chắc chắn, không đáng tin.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Pháp", "definition": "符法. Phép dùng bùa để trừ tà ma.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Phí", "definition": "浮費. Môn chi tiêu quá đáng, quá mức thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Quyết", "definition": "符訣. Như Phù pháp, ngay như trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Sa", "definition": "浮沙. Bãi cát nổi giữa lòng sông Cát nổi, tức cát được nước sông mang đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Sinh", "definition": "浮生. Cuộc sống tạm bợ, không bền vững. Cung oán ngâm khúc có câu: “Tuồng ảo hoá đã bày ra đấu, Kiếp phù sinh trông thấy mà đau”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Sơn Cửu Đới", "definition": "Gọi đủ: Phật Thiền Tông Giáo Nghĩa Cửu Đới Tập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Sơn Pháp Viễn", "definition": "(浮山法遠, Fusan Hōon, 991-1067): vị tăng của Lâm Tế Tông Trung Quốc, người vùng Trịnh Châu (鄭州, Tỉnh Hà Nam). Ông theo xuất gia với Tam Giao Trí Tung (三交智嵩), sau đó kế thừa dòng pháp của Quy Tỉnh (歸省) ở Diệp Huyện Quảng Giáo Viện (葉縣廣敎院) vùng Nhữ Châu (汝州, Tỉnh Hà Nam). Chính Âu Dương Tu (歐陽修) đã từng đến làm môn đệ và tham học với ông. Sau ông đến trú tại Phù Sơn (浮山), Thư Châu (舒州, Tỉnh An Huy), cử xướng tông phong của mình. Ngoài ra, ông còn được Đại Dương Cảnh Huyền (大陽警玄) bí mật phó chúc cho và giao y hậu giày dép cho Đầu Tử Nghĩa Thanh (投子義青).Vào ngày mồng 6 tháng 2 năm thứ 4 niên hiệu Trị Bình (治平), ông thị tịch, hưởng thọ 77 tuổi, và được ban cho thụy hiệu là Viên Giám Thiền Sư (圓鑑禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Sơn Thập Lục Đề", "definition": "Mười sáu phạm trù biện biệt tông chỉ do Thiền Sư Phù Sơn Pháp Viễn đời Tống đặt ra. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Sứ", "definition": "(符使): tức Phù Quan (符官). Đối với Đạo Giáo, đây là vị thần quan thủ hộ các bùa chú, phù lục. Như trong Tỉnh Thế Hằng Ngôn (醒世恆言), phần Lữ Đồng Tân Phi Kiếm Trảm Hoàng Long (呂洞賓飛劍斬黃龍), có đoạn: “Đồng Tân ư kinh khuông lam nội thủ nhất cá tiên quả, dữ Phù Sứ ngật liễu, bái tạ thượng mã nhi khứ (洞賓於荆筐籃內取一個仙果、與符使吃了、拜謝上馬而去, Đồng Tân lấy một trái tiên từ trong giỏ tre, cùng quan Phù Sứ ăn xong, bái tạ rồi lên ngựa mà đi).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Tang", "definition": "扶喪. Lo việc ma chay. Đoạn trường tân thanh có câu: “Từ ngày muôn dặm phù tang. Nửa năm ở đất Liêu dương lại nhà”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Tang Lược Ký", "definition": "(扶桑略記, Fusōryakki): sử thư được thành lập vào cuối thời Bình An, là biên niên sử bằng Hán văn trong khoảng thời gian từ thời Thần Võ Thiên Hoàng (神武天皇, Jimmu Tennō) cho đến Quật Hà Thiên Hoàng (堀河天皇, Horikawa Tennō), trước tác của Hoàng Viên (皇圓, Kōen) thuộc Tỷ Duệ Sơn (比叡山, Hieizan). Nguyên gốc bộ này có 30 quyển, nhưng bản hiện tồn là bản tàn khuyết, chỉ còn 16 quyển và sao bản mà thôi. Nó căn cứ vào điển tịch của Lục Quốc Sử (六國史) cũng như các truyện xưa có liên quan đến tự viện, và trong các điều khoản có nêu lên xuất xứ điển tịch.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Tang Thiền Lâm Tăng Bảo Truyện", "definition": "Tác phẩm, 10 quyển, do ngài Tính Đôn soạn vào cuối đời Minh đầu đời Thanh, được thu vào Đại Nhật Bản Phật Giáo Toàn Thư tập 109.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Thánh Linh Nhân Hoàng Thái Hậu", "definition": "Vợ vua Lý Thánh Tông, mẹ Lý Nhân Tông. Bà nguyên người làng Thổ Lỗi, sau đổi tên là làng Siêu Loại. Vua Lý Thánh Tông nhận vào cung năm 1063, đặt tên là Ỷ Lan Phu nhân. Năm 1066, sinh Lý Nhân Tông và được tôn là Thần phi. Sau khi Lý Nhân Tông lên ngôi, bà được tôn làm Linh Nhân Hoàng Thái Hậu. Cuốn “Thiền Uyển Tập Anh” ghi lại cuộc đàm thoại giữa Thái hậu và sư Thông Biện về lịch sử Phật giáo du nhập vào Việt Nam, nhờ đó chúng ta có được một sử liệu quý giá về sự kiện này.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phù Thạch", "definition": "浮石. Đá bọt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Thế", "definition": "浮世. Cuộc đời thay đổi, không vững bền. Hát nói củaTản Đà có câu: “Khách phù thế chửa dứt câu là phù thế, Người phong lưu càng đượm vẻ phong lưu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Thế Hội", "definition": "(浮世會, Ukyoe): một loại hình thức tranh thế tục vốn phát triển rất phổ cập dưới thời đại Giang Hộ (江戸, Edo, 1600-1867); đặc biệt nó tạo ra cái đẹp độc đáo trong những bức tranh trên bảng gỗ. Nó thoát thai từ thể loại tranh phong tục, người đẹp vốn rất thịnh hành từ thời đại Đào Sơn đến Giang Hộ; và đến hậu bán thế kỷ 17 thì được Lăng Xuyên Sư Tuyên (菱川師宣) tạo nền tảng vững chắc cho thể loại tranh áp vào bảng gỗ, rồi đến năm 1765 thì Linh Mộc Xuân Tín (鈴木春信) đã khai sáng ra loại tranh ấn loát trên bảng với nhiều màu sắc phong phú; cuối cùng nó đạt đến đỉnh cao rực rỡ hoàng kim. Chủ đề của thể loại tranh này là lấy những cảnh tương tợ như dạo chơi thôn xóm, tình cảnh đóng kịch, người đẹp, võ sĩ, v.v., làm trung tâm. Ngoài những nhân vật vừa nêu trên, còn có những tác giả nổi tiếng khác như Điểu Cư Thanh Tín (鳥居清信), Tây Xuyên Hựu Tín (西川祐信), Điểu Cư Thanh Trường (鳥居清長), Hỷ Đa Xuyên Ca Lữ (喜多川歌麿), Đông Châu Trai Tả Lạc (東洲齋寫樂), Cát Sức Bắc Trai (葛飾北齋), Ca Xuyên Quảng Trọng (歌川廣重), v.v. Từ thế kỷ thứ 19 trở đi, thể loại tranh này cũng có ảnh hưởng đến mỹ thuật Châu Âu", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phù Thủy", "definition": "Bhūtavejja (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phù Thực", "definition": "扶植. Giúp đỡ vun trồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Tiêu", "definition": "浮標. Cái phao nổi thả trên mặt nước, ở những vùng sông biển đáy nông hoặc có đá ngầm, để tàu bè biết mà tránh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Trì", "definition": "扶持. Nuôi nấng giữ gìn. Bản dịch Chinh phụ ngâm khúc có câu: “Mẹ già phơ phất mái sương, Con thơ măng sữa vả đương phù trì”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Trầm", "definition": "浮沈. Nổi và chìm, chỉ sự thay đổi luôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Trần", "definition": "Bụi nổi trong hư không, ví dụ tất cả các pháp hữu vi, hư giả không thực, như bụi nổi, làm nhơ nhớp chân tính. [X. Kinh Lăng Nghiêm Q.2].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Trần Căn", "definition": "浮塵根. Chữ “phù” (浮) nghĩa là nổi, lộ ra bên ngoài. Trong năm căn (nhãn, nhĩ, tị, thiệt, thân), mỗi căn đều gồm có hai phần: phần vi tế nằm sâu kín ở bên trong, mắt thường không thể thấy được (như thần kinh mắt), gọi là “tịnh sắc căn”; và phần thô phù nổi lộ ra bên ngoài, mắt nhìn thấy được (như con mắt, cái mũi, v.v...), gọi là “phù trần căn”. Chữ  浮 cũng được viết bằng chữ 扶 (cũng đọc là phù), có nghĩa là phụ giúp; và trong trường hợp này, “phù trần căn” (扶塵根) có nghĩa là căn phụ giúp. Sở dĩ gọi là “phù trần căn” – hay gọi tắt là “phù căn” – vì phần này không thể phát sinh tác dụng nhận thức, mà chỉ làm điều kiện phụ giúp cho “chánh căn” (căn chính yếu) nhận thức ngoại cảnh. Chánh căn được gọi là “thắng nghĩa căn”, là tên gọi khác của “tịnh sắc căn”, là phần chính yếu của các căn, nằm sâu kín ở bên trong, có khả năng phát sinh tác dụng nhận thức, biết cảm giác đối với ngoại cảnh. Tóm lại, phù căn chỉ có nhiệm vụ làm chỗ y cứ cho chánh căn, không có tác dụng nhận thức. (Xem mục “Tịnh Sắc Căn”.)", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phù Trợ", "definition": "扶助. Giúp đỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Tá", "definition": "扶佐. Giúp đỡ. Ta vẫn nói trại thành Phò tá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Táo", "definition": "浮躁. Chỉ tính tình nông nổi, nóng nảy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Tập Nhuận Sinh", "definition": "Cũng gọi Thệ Phù Tập Sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Từ", "definition": "浮辭. Lời nói hàm hồ, không chắc chắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Tửu", "definition": "扶酒. Trầu và rượu. Chỉ việc giao thiệp và ăn uống. Cũng chỉ việc mai mối hôn nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Vinh", "definition": "浮榮. Sự vẻ vang trống rỗng, cái tiếng tăm không giá trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Vân", "definition": "浮雲. Đám mây nổi. Chỉ sự không bền vững Luận ngữ: Bất nghĩa nhi phú thả quyù ư ngã như phù vân (Bất nghĩa mà giàu và sang, đối ta như đám mây nổi).”Còn như phú quyù phù vân kể gì”. (Hoa Điểu tranh năng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Văn", "definition": "浮文. Văn chương trống rỗng, không thiết thực.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù Âu", "definition": "浮 漚. Bong bóng nước, bọt nước. Nhà Phật thường dùng để chỉ cho đời người vô thường huyễn hóa. Pháp Diễn Ngữ Lục q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phù Đà Bạt Ma", "definition": "Phạm: Buddhavarman. Cũng gọi Phật Đà Bạt Ma. Hán dịch: Giác Khải.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Đồ", "definition": "Buddha-stūpa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phù Đồ Từ", "definition": "Nhà thờ phụng Đức Phật, tức là chùa thờ Phật ở Trung Quốc vào thời kì Phật Giáo mới được truyền nhập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phù Động", "definition": "浮動. Trôi nổi, không vững bền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phù ứng", "definition": "符應. Như Phù hợp 符合.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phùng", "definition": "渢. Nổi trên nước. Td: Phùng phùng (bồng bềnh).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phùng Công", "definition": "縫工. Thợ may quần áo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phùng Công Thi Tập", "definition": "馮公詩集. Tên một tập thơ chữ Hán của Phùng Khắc Khoan, danh sĩ thời Lê mạt, trong có nhiều bài làm nhân dịp ông đi sứ Trung Hoa, tựa của tác giả, viết năm 1586.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phùng Dịch", "definition": "逢掖. Rộng nách. Cái áo nách rộng, áo thụng mà nhà nho ngày xưa thường mặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phùng Mộng Trinh", "definition": "(1548-1595).Cư Sĩ Phật Giáo Trung Quốc, sống vào đời Minh, người Tú Thủy (Gia Hưng, Chiết Giang), tự là Khai Chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phùng Nghênh", "definition": "逢迎. Đón rước, tiếp đãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phùng Phật Sát Phật", "definition": "逢 佛 剎 佛. Gặp Phật giết Phật. Thiền Sư dùng từ này để phá trừ kiến giải chấp thật của đương cơ, chẳng cho họ trụ vào khái niệm, hình tướng của Phật. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phùng Tiếp", "definition": "(?-1153).Cư Sĩ Phật Giáo Trung Quốc, sống vào đời Tống, người Toại ninh, tỉnh Tứ Xuyên, tự Tế xuyên. Ông từng làm quan, giữ các chức Cấp sự, Tri Sự. Lúc tuổi tráng niên, ông tham học ngài Phật Nhãn Thanh Viễn và nối pháp của ngài.Sau, ông lại tham yết ngài Đại Tuệ Tông Cảo và được tâm ấn. Về già, ông siêng tu Tịnh Độ, nguyện Vãng Sinh Tây Phương, xuất tiền tu bổ Đại Tạng Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phùng Trường Tác Hí", "definition": "逢 場 作 戲. Gặp sân khấu liền đóng trò. CĐTĐL q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phùng Y", "definition": "逢衣. Áo thụng, áo rộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú", "definition": "Mṛaksa (S), Makkha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Bẩm", "definition": "賦禀. Được trời cho sẵn Tài năng có sẵn, trời cho, không tập luyện mà có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Bật", "definition": "富 弻 (1004-1083). Cư sĩ đời Tống, tự là Nham Quốc, người Lạc Dương (nay thuộc Hà Nam) Trung Quốc. Niên hiệu Thiên Thánh thứ 8 (1030) đỗ khoa Mậu tài loại đặc biệt được cất nhấc làm Tri giám viện. Niên hiệu Khánh Lịch thứ 3 (1043) giữ chức Khu mật Phó sứ, cùng Phạm Trọng Yêm phát triển “Khánh Lịch Tâm Chính”. Niên hiệu Chí Hòa thứ 2 (1055) nhậm chức Đồng trung thư hạ Bình chương sự chủ trương không gây chiến chỉ lo giữ thành, thời ấy gọi là Hiền tướng. Khi vua Anh Tông tức vị, ông giữ chức Khu mật sứ, phong Trịnh Quốc Công. Sau vì bất đồng chính kiến với Vương An Thạch xin lui về làm Phán quan ở Hào Châu. Nghe Thiền Sư Tụ Ngung giáo hóa ở núi Đầu Tử liền đến tham kiến, dưới lời nói ông liền tỉnh ngộ. Ông còn thỉnh Thiền Sư Tụ Ngung đến phủ để ngày đêm tham vấn. Lúc tuổi già, ông ăn chay lễ Phật tụng kinh Lăng Nghiêm mỗi ngày. Tác phẩm: Phú Trịnh Công Thi Tập.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phú Cường", "definition": "富强. Giàu và mạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Cống", "definition": "賦貢. Chỉ việc nước nhỏ hàng năm phải nạp tiền của cho nước lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Cốt", "definition": "富骨. Cái dáng dấp, cái tướng mạo của người giàu có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Dịch", "definition": "賦役. Tiền thuế phải nộp và việc nặng phải làm cho triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Hào", "definition": "富豪. Người giàu có và nhiều thế lực trong vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Hậu", "definition": "富厚. giàu có và đức độ. Đoạn trường tân thanh có câu: “Nền phú hậu bậc tài danh, Văn chương nết đất thông minh ting trời”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Hộ", "definition": "富戸. Nhà giàu Người giàu có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Hữu", "definition": "富有. Giàu có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Khả Sĩ", "definition": "Foucaux, Philippe Edouard (1811-1894) Học giả Ấn Độ học người Pháp, là học trò của ông E. Burnouf.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phú La Ca Diếp", "definition": "Một nhân vật Pḥrana Kassapa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Lan Na", "definition": "Phạm: Puràịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phú Lan Na Ca", "definition": "Pūrṇajit (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Lan Na Ca Diếp", "definition": "Phạm: Pùraịa-kàzyapa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phú Lâu Na", "definition": "Purna: đó chỉ là tên gọi vắn tắt, tên đầy đủ phải là Phú Lâu Na Di Đa La Ni Tử (Purnamaitraya-niputra), là vị giảng sư tài giỏi nhất trong tăng đoàn, được liệt vào hàng “mười vị đệ tử lớn” (thập đại đệ tử) của đức Phật. Tôn giả sinh trong một gia đình giàu có thuộc giai cấp phú thương nghiệp chủ, ở vương quốc Kiều-tát-la (Kausala). Vì sớm chán đời sống thế tục, muốn cầu giải thoát, nên tôn giả đã rủ ba mươi bạn hữu cùng vào núi tu tập, do chuyên cần tinh tấn, chứng được Tứ-thiền. Khi biết tin đức Thích Ca đã thành đạo và đang thuyết pháp tại vườn Nai, tôn giả liền về đó, xin Phật cho xuất gia, và chẳng bao lâu thì chứng quả A-la-hán.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phú Lâu Na Di Đa La Ni Tử", "definition": "Pūrṇa-maitrayaniputtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Lệ", "definition": "富麗. Giàu có và mặt mày đẹp đẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Mị", "definition": "娬媚. Đẹp đẽ duyên dáng, thu hút người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Mộc Thường Nhẫn", "definition": "(富木常忍, 1216-1299): tức Phú Mộc Nhật Thường (富木日常, Tōki Nichijō), người ngoại hộ đắc lực cho Nhật Liên, vị tăng của Nhật Liên Tông Nhật Bản, sống vào khoảng giữa và cuối thời Liêm Thương, húy là Thường Nhẫn (常忍), Nhật Thường (日常); hiệu là Thường Tu Viện (常修院). Vốn là quan có thế lực của dòng họ Thiên Diệp (千葉, Chiba) ở vùng Hạ Tổng (下總, Shimōsa), trong khoảng thời gian niên hiệu Kiến Trường (建長, 1249-1256), ông quy y theo Nhật Liên ở vùng Liêm Thương; từ đó về sau, ông trở thành tín đồ dắc lực cho Nhật Liên trong việc ủng hộ Tông môn và truyền bá giáo nghĩa. Sau khi Nhật Liên qua đời, ông xuất gia và biến nhà ông thành chùa, lấy tên là Pháp Hoa Tự (法華寺, tức Pháp Hoa Kinh Tự [法華經寺, Hokkekyō-ji] ở Trung Sơn [中山, Nakayama]), rồi lập nên cơ sở cho Môn Phái Trung Sơn. hơn nữa, ông có công rất lớn trong việc bảo tồn các di thư của Nhật Liên. Trước tác của ông có Thường Tu Viện Bổn Tôn Thánh Giáo Sự (常修院本尊聖敎事)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phú Na", "definition": "Xem Phú Lan Na Ca.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Na Dạ Xa", "definition": "Puṇyayaśa (S), Punyayasha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Na Dạ Xa Tổ Sư", "definition": "Puṇyagasa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Nguyên", "definition": "富源. Nguồn lợi tức đưa tới sự giàu có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Phận", "definition": "賦分. Cái phần trời cho. Tài năng trời cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Quý", "definition": "富貴. Giàu sang, tức có nhiều tiền của và có địa vị chức tước. Đoạn trường tân thanh có câu: “phong lưu phú qu‎ý ai bì, Vườn xuân một cửa để bia muôn đời”. Công danh phú quý 功名富貴: Có công nghiệp, có danh dự, được giàu được sang. “Công danh phú quý màng chi, cho bằng thong thả mặc khi vui lòng” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Quốc", "definition": "富國. Tên một hòn đảo ở phía tây Nam phần Việt Nam trong vịnh Thái lan, nổi tiếng về ngàng sản xuất nước mắm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Qu‎Ý Hoa", "definition": "富貴花. Loài hoa giàu sang, một tên chỉ hoa mẫu đơn, vì thường được trồng ở nhà giàu sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Thiện", "definition": "福善. May mắn tốt lành. Truyện Hoa Tiên có câu: “Mênh mang bể khổ sống trôi, biết rằng phúc thiện có trời nữa không”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Thuế", "definition": "賦稅. Chỉ chung các thứ tiền phải nộp cho công quỹ để dung vào việc chung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Thương", "definition": "富商. Người nhà buôn giàu có.”Xe lừa, dù có chen vai, Kìa người đại cổ, nọ người phú thương”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Thọ", "definition": "富壽. Giàu có và sống lâu Tên một tỉnh ở Bắc phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Thứ", "definition": "富庶. Giàu có và đông dân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Tuế", "definition": "富歲. Năm được mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Tái", "definition": "覆載. Che và chở, nói về trời che đất chở Chỉ công ơn lớn lao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Tính", "definition": "賦性. Nết trời sinh, không do tiêm nhiễm hoặc học tập mà có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Túc", "definition": "富足. Giàu có đầy đủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Vĩnh Trọng Cơ", "definition": "(富永仲基, Tominaga Nakamoto, 1715-1746): học giả và là tư tưởng gia sống vào khoảng giữa thời Giang Hộ; tên là Tử Trọng (子仲); thông xưng là Tam Lang Binh Vệ (三郎兵衛); hiệu Khiêm Trai (謙齋); xuất thân vùng Đại Phản (大阪, Ōsaka). Ông sinh ra trong một gia đình chuyên kinh doanh tương dấm. Phụ thân ông, Cát Tả Binh Vệ (吉左兵衛), là một trong những người sáng lập Hoài Đức Đường (懷德堂). Ban đầu, ông theo học với Tam Trạch Thạch Am (三宅石庵) của Hoài Đức Đường và cuối cùng học về Cổ Văn Từ Học cũng như Phật Giáo. Sau ông mở trường dạy ở nhà và viết các tác phẩm Xuất Định Hậu Ngữ (出定後語), Ông Văn (翁文) để phê phán những việc làm của người đời sau trong ba tôn giáo Nho, Phật, Thần. Ông chủ trương đạo chân thành, phổ biến, không câu nệ vào tôn giáo nào cả; và đã tảo ảnh hưởng to lớn đới với nhóm Bổn Cư Tuyên Trường (本居宣長), Bình Điền Đốc Dận (平田篤胤).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phú Xuân", "definition": "富春. Một tên chỉ kinh đô Huế trước thời Gia Long thống nhất đất nước. Bài Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “Rồi lại từ Đồ bàn Nam Ngãi lấy xuân Phú Xuân mà thẳng tới Thăng Long…”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Yên", "definition": "富安. Tên một tỉnh thuộc trung phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phú Đan Na", "definition": "Putanas", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phú Đơn Na", "definition": "Xem Xú Ngạ Quỉ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phú Đơn Na Quỉ", "definition": "Phú Đơn Na, Phạm: Pùtana.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc", "definition": "Xem Phước.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc An", "definition": "Thiền sư Việt Nam, tạo dựng chùa Hưng Long ở làng An Điềm, tỉnh Gia Định, năm 1794. Năm 1803, chùa được trùng tu do công đức của sự Chánh Niệm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phúc Báo", "definition": "福 報. Thiền tăng sống vào cuối đời Nguyên đầu đời Minh, họ Phương, tự Hạ Nguyên, người xứ Lâm Hải (nay thuộc Chiết Giang) Trung Quốc. Sư vâng lời cha mẹ đến chùa Lương Trữ Sùng Phúc ở Hàng Châu xuất gia. Khi ấy Thạch Hồ Mỹ Công trụ trì chùa Tịnh Từ ở Hàng Châu vừa gặp sư liền biết là pháp khí và cạo tóc cho sư. Sau đó, sư tham Nguyên Tẩu Thụy Công, được sắp ở liêu Thị giả rồi coi sóc Tạng Kinh. Trải một thời gian lâu sư mới được ấn chứng. Sư từng trụ các chùa: Lô Sơn ở Từ Khê (nay thuộc Chiết Giang), Đông Sơn ở Việt Châu (nay là huyện Thiệu Hưng, tỉnh Chiết Giang), Trí Môn ở Tứ Minh. Đầu niên hiệu HồngVõ (1368), nhiều lần sư được triệu vào cung, đối trước vua tuyên dương thiền chỉ, được vua lưu lại kinh đô 3 năm mới cho trở về chùa Trí Môn. Sau đó sư dời đến trụ Kính Sơn. Sư mất vào năm 84 tuổi.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Bát", "definition": "Chỉ cho hình dáng cái bát úp, 1 kiểu kiến trúc tháp Phật ở Ấn Độ. Tức phần trên của thân tháp Phật có hình dáng tròn như cái bát úp, thường được gọi là Đẩu hình(hình cái đấu). Trong các kiểu tháp Phật thì hình bát úp là xưa nhất và được cấu thành bởi các bộ phận: Lan can, nền tháp, thân tháp, bát úp, đầu bằng, luân can (cột đỡ bánh xe), tướng luân (những bánh xe), bảo bình (bình báu)...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Bạc", "definition": "福薄. Phúc mỏng, ít được hưởng điều may mắn. Cũng nói Bạc phúc. “Trách vì phúc bạc, xừng đâu má đào”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Bất Trùng Lai", "definition": "福不重來. Điều may mắn thì không đến cùng một lúc, có một điều may là đã may lắm rồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Châu Huyền Sa Tông Nhất Đại Sư Quảng Lục", "definition": "(福州玄沙宗一大師廣錄, Fukushūgenshashūitsudaishikōroku): xem Huyền Sa Quảng Lục (玄沙廣錄, Genshakōroku).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phúc Châu Khai Nguyên Tự", "definition": "福 州 開 元 寺. ở ngõ Kinh Viện, cửa Tỉnh Lâu, thành phố Phúc Châu, tỉnh Phúc Kiến, Trung Quốc. Được xây dựng vào niên hiệu Thái Thanh thứ 2 (548) đời Lương Nam Triều, nguyên tên “Linh Sơn Tự”, từng đổi tên “Đại Vân Tự”, “Long Hưng Tự”, niên hiệu Khai Nguyên thứ 23 (735) đời Đường đổi tên là “Khai Nguyên Thiền Tự”. Vào khoảng niên hiệu Chính Hòa (1111-1117) đời Tống từng đổi làm Đạo quán, sau đó trở lại thành chùa Phật. Hiện chỉ còn Thiết Phật tháp, Linh Sơn đường, Phật hóa xã. Trong chùa có một tượng Phật A Di Đà đúc bằng sắt, nên tục gọi “Thiết Phật Tự”. Thiết Phật cao 5,3m, nặng chừng 15 tấn được đúc vào niên hiệu Nguyên Phong thứ 6 (1083) đời Bắc Tống. Con người chỉ đứng tới vai, tay không thể sờ tới đỉnh. Ngồi chắp tay xếp bằng trên tòa sen, bên ngoài phủ bùn thếp vàng, pháp tướng đoan trang nghiêm túc. Phía trước Phật có cặp đối liễn do Tằng Dị soạn: “Cổ Phật do lai giai thiết hán, phàm phu đản thuyết thị kim thân” (Cổ Phật xưa nay đều người thép, phàm phu chỉ nói là thân vàng). Ngoài ra còn có một tảng đá lớn trên khắc bài minh 62 chữ được tạo dựng vào niên hiệu Đại Quan thứ 2 (1108) đời Bắc Tống. Chùa ở tại ngõ Kinh Viện chính là nền cũ của tự viện khắc in kinh, từng khắc in Phạm bản “Tỳ Lô Đại Tạng” hơn 6000 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Châu Đông Thiền Tự", "definition": "福 州 東 禪 寺. ở núi Bạch Mã, thành phố Phúc Châu, tỉnh Phúc Kiến, Trung Quốc. Niên hiệu Đại Đồng thứ 5 (539) đời Lương sáng lập. Từ niên hiệu Nguyên Phong thứ 3 đến niên hiệu Chính Hòa thứ 2 (1080-1112) vua Thần Tông ra lệnh khắc in Đại tạng kinh tại chùa này, đây là mở đầu cho sự in lậu Đại tạng kinh. Trong thời gian đó, năm vị Xung Chân, Liễu Vô, Trí Hiền, Phổ Minh, Đạt Cảo lần lượt trụ trì chùa này.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Cái", "definition": "Lọng phúc, tức phúc đức che thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Cái Chính Hành Sở Tập Kinh", "definition": "Kinh, 12 quyển, do ngài Long Thụ tập, ngài Nhật Xứng dịch vào đời Tống, được thu vào Đại Chính Tạng tập 32.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Cân", "definition": "腹筋. Bắp thịt bụng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Cảo", "definition": "腹稿. Bài văn viết sẵn trong bụng, ý nói đã nghĩ xong xuôi, chỉ còn viết ra mà thôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Dụ", "definition": "福 裕 (1203-1275). Thiền tăng đời Nguyên, họ Trương, tự Hiếu Vấn, hiệu Tuyết Đình, người xứ Văn Thủy (nay thuộc tỉnh Sơn Tây) Trung Quốc. Lúc lên năm sư đã giải ngộ, mỗi ngày đọc thuộc ngàn chữ. Khi được 9 tuổi, sư nhập học đọc sách rất nhanh, người trong làng gọi sư là “Thánh Tiểu Nhi” (Thần đồng). Năm 12 tuổi, gặp lúc hoàn cảnh gia đình tan tác, sư đến tham vấn ngài Tiên Nham Hưu Lâm, chính thức cạo tóc thụ giới cụ túc, hầu hạ ngài 7 năm. Sư còn đến chùa Báo Ân ở Yên Kinh tham vấn ngài Vạn Tùng Hành Tú, được ấn khả, nối pháp ngài, thuộc tông Tào Động. Trong 10 năm tu tập theo nơi ngài Hành Tú, nhờ học đức sâu dầy nên sư rất nổi tiếng, số người đến học với sư càng lúc càng tăng, sư sách tấn kẻ hậu học, hiển dương tông phong. Sau đó sư nhận lời mời hoằng pháp ở chùa Thiếu Lâm tại Tây Kinh, và vâng theo lời của Hoàng thái tử (tức Nguyên Thế Tổ sau này) quản lý hội Đại Tư Giới. Vào niên hiệu Định Tông thứ 3 (1248), sư vâng chiếu trụ trì thêm chùa Hòa Lâm Hưng Quốc, rất được nhà Vua tín nhiệm. Khi ấy, Đạo giáo phát triển rất nhanh ở phương Bắc, Phật giáo bị đè bẹp. Vào năm Hiến Tông nguyên niên (1251), Lý Chí Thường cho in các sách như: “Lão Tử Hóa Hồ Kinh”. Từ năm 1255 đến 1257, nhiều lần sư đã biện luận với Lý Chí Thường, Chí Thường bị thua và các ngụy kinh trong Đạo Tạng bị thiêu hủy, 237 ngôi Đạo quán được trao trả cho Phật giáo. Sư được vua ban cho hiệu “Quang Tông Chính Biện”. Sư trở về quê cũ, vâng lệnh xây dựng chùa Báo Ân, rồi liên tiếp xây cất các ngôi chùa: Hòa Lâm, Yên Kinh, Trường An, Thái Nguyên, Lạc Dương để truyền bá chính pháp. Về già, sư trở về ẩn nơi chùa Tung Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Giảng", "definition": "Cũng gọi Phúc Thuật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Hoạ", "definition": "福禍. Điều may mắn được hưởng và điều tai vạ xảy tới. Đoạn trường tân thanh có câu: “Sư rằng phúc hoạ đạo trời, cỗi nguồn cũng bởi lòng người mà ra”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Huệ", "definition": "福 慧 (1869-1945). Danh tăng cận đại, tên Nguyễn Tấn Giao, người làng Phú Thành, phủ An Nhân (nay là ấp Phú Thành, xã Nhân Thành, huyện An Nhân, tỉnh Bình Định), miền Trung Việt Nam. Năm 12 tuổi, sư được cha mẹ cho phép xuất gia tại chùa Thập Tháp, thụ giới với Hòa Thượng Chí Tịnh (Minh Lý), được ban pháp hiệu là Phúc Huệ. Ít lâu sau, sư theo học với Hòa Thượng Từ Mẫn. Năm 19 tuổi trở về giữ chức Thủ khố của chùa Thập Tháp. Năm 20 tuổi sư theo học với Hòa Thượng Luật Truyền ở Phú Yên. Sư thọ đại giới năm 1889 và đắc pháp năm 1892 với Hòa Thượng Luật Truyền. Khi bản sư viên tịch, sư trở về Tổ đình Thập Tháp thọ tang rồi ở lại học với sư huynh là Tăng cang Vạn Thành vừa mới được suy cử làm tân trụ trì Tổ đình này. Sau 10 năm chuyên tâm tu học, phát huy đạo tâm và trí huệ sẵn có, sư đã bác thông kinh điển, Bách gia chư tử và có khả năng giáo hóa nhuần nhuyễn, đạo vị vào bậc nhất thời bấy giờ, nên người đời trân tặng mỹ hiệu “Phật pháp thiên lý câu” (Con ngựa tinh thông Phật pháp chạy được ngàn dặm). Năm 1894, sư trụ trì chùa Phổ Quang ở huyện Tuy Phúc (nay ở xã Phướng Thuận). Năm 1901, sư được triều đình ban cho giới đao và độ điệp làm Tăng cang chùa Thập Tháp. Năm 1908, sư được mời ra Hoàng cung thuyết pháp, đồng thời cũng để khai giảng một khóa giảng kinh tại chùa Trúc Lâm. Các vua Thành Thái, Duy Tân và Khải Định đều mời sư vào cung thuyết pháp nên được triều đình, sơn môn đồ chúng tôn xưng Quốc sư. Năm 1920, Quốc sư mở các lớp nội điển tại chùa Thập Tháp và Long Khánh. Năm 1929 làm chủ giảng tại chùa Trúc Lâm ở Huế. Năm 1932, Quốc sư cùng các bậc Tôn túc ở đất Thần kinh thành lập hội An Nam Phật Học và xuất bản tờ báo Viên Âm, cổ xúy phong trào chấn hưng Phật giáo. Nhiều Phật học đường từ Tiểu học đến Đại học được mở ở các chùa Trúc Lâm, Tây Thiên, Kim Sơn, Báo Quốc, Diệu Đức v. v… Năm 1937, Quốc sư kế tục trụ trì chùa Thập Tháp. Từ đó, Quốc sư ở hẳn tại Bình Định làm Đốc giáo cho lớp Trung đẳng mở tại chùa Long Khánh. Quốc sư là cây đại thụ của nền Phật giáo không chỉ ở Trung kỳ, mà còn tỏa bóng xuống phần đất Nam kỳ nữa. Sau khi Quốc sư thị tịch, Hòa Thượng Trí Hải trụ trì chùa Bích Liên Bình Định đề 4 câu thơ tại tháp của Quốc sư như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Hạch", "definition": "覆核. Xét lại một lần nữa cho kĩ càng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Hậu", "definition": "福厚. Ăn ở tốt đẹp và được hưởng nhiều may mắn tốt lành. Truyện Hoa Tiên có câu: “Phồn hoa bõ lúc truân chiên. Đã dày phúc hậu lai bền hiển vinh” Ta còn chỉ khuôn mặt đầy đặn hiền lành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Hồi", "definition": "覆囘. Trả lời lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Hộ", "definition": "覆 護. Che chở. Pháp Diễn Ngữ Lục q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Khí", "definition": "Đồ dùng úp xuống. Tức chỉ cho cái miệng của dụng cụ đặt úp xuống đất. Theo Luận Đại Trí Độ quyển 15 thì Đức Phật đã dùng phúc khí làm thí dụ để dạy bảo ngài La Hầu La. Nghĩa là một khi cái miệng của đồ dùng đã đặt úp xuống thì dù có rót nước, nước cũng không vào; vídụ như người không biết hổ thẹn thì tâm họ đã bị che lấp, tuy dùng đạo pháp để cứu cũng khó vào được. [X. Thích Môn Qui Kính Nghi Q.thượng].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Khảo", "definition": "覆考. Như Phúc hạch 覆核 Vị giám khảo chấm bài lại lần thứ nhì trong bài thi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Kiến Tử", "definition": "(?-?).Thiền Sư Trung Quốc, thuộc Tông Lâm Tế, sống vào đời Tống, người tỉnh Phúc Kiến (đất Mân), tên Trí bằng, hiệu Giới Thạch. Sư bẩm tính cao khiết, chân thật, đắc pháp nơi ngài Triết ông Như diễm. Năm Thiệu Định thứ 2 (1229), đầu tiên sư hoằng pháp ở chùA La Hán tại Nhạn sơn thuộc Ôn Châu, về sau, sư lần lượt trụ ở Phật nhật tịnh tuệ thiền tự, núi Lâm bình, phủ Lâm An; Bảo Phúc thiền tự, núi Đại Mai, phủ Khánh Nguyên; Hiếu từ chân ứng thiền tự ở Hương Sơn; Năng Nhân thiền tự ở Thừa Thiên, phủ Giang bình; Tịnh Từ báo ân quang hiếu thiền tự, phủ Lâm An...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Lạc", "definition": "Xem A Nan Đà.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Lạc Vô Biên", "definition": "Vāsanānanda (S), Imperishable impression of bliss.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Lộc", "definition": "福祿. Điều may mắn tốt lành và tiền của trong nhà Hai trong Tam đa. Phúc chỉ sự đông con cháu. Lộc chỉ sự làm quan cao có nhiều tiền của (còn Thọ là sống lâu). Đoạn trường tân thanh có câu: “Một nhà phúc lộc gồm hai, nghìn năm dằng dặc quan giai lần lần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Lợi", "definition": "福利. Chỉ chung những điều may mắn vui sướng và những điều giúp ích vào cuộc sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Lực Thái Tử", "definition": "Vị Thái tử con vua Nhãn Lực và Hoàng hậu Quảng Chiếu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Mạc", "definition": "腹膜. Cái màng bọc các cơ quan trong bụng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Mệnh", "definition": "覆命. Trình báo lại sau khi đã thi hành lệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Mộ", "definition": "Thăm lại phần mộ. Vào ngày thứ 3 sau khi chôn cất thi hài người chết, trở lại viếng thăm và quét tước phần mộ, gọi là Phúc mộ. Thích Thị Yếu Lãm quyển hạ (Đại 54, 309 hạ) ghi: “Ba ngày sau khi an táng, đến thăm lại phần mộ, gọi là Phúc mộ. Đỗ thị nói: Điều này không thấy trong kinh Lễ ghi, chỉ do con hiếu sau khi chôn cất thương tiếc người thân, vả lại, lo rằng phần mộ chưa được hoàn toàn nên đến xem xét lại.Nay, Thích tử đến thăm mộ cũng không có lỗi, vì chăm sóc mà đến”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Nghiêm Tự", "definition": "福 嚴 寺. Nằm dưới đỉnh Trịch Bát, núi Hành Sơn, tỉnh Hồ Nam, Trung Quốc. Vào niên hiệu Quang Đại thứ 1 (567) đời Trần Nam Triều, Huệ Tư sáng lập chùa này, ban đầu gọi là “Bát Nhã Tự”, còn gọi “Bát Nhã Đài”. Niên hiệu Khai Nguyên thứ 1 (713) đời Đường, Nam Nhạc Hoài Nhượng mở rộng chùa thành đạo tràng, tuyên dương học thuyết đốn ngộ của Lục Tổ Huệ Năng, nên còn gọi là “Thiên Hạ Pháp Viện”. Khoảng niên hiệu Thái Bình Hưng Quốc (976-983) đời Tống đổi tên là “Phúc Nghiêm Tự”, sau đó bị phá hủy. Niên hiệu Đồng Trị thứ 9 (1870) đời Thanh xây cất lại, đứng đầu trong sáu Đại tùng lâm ở Nam Nhạc. Tấm biển ở sơn môn là “Thiên Hạ Pháp Viện”, hai bên có cặp đối liễn: “Lục triều cổ sát, thất Tổ đạo tràng” (chùa cổ của sáu Triều, đạo tràng của bảy Tổ).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Nghiệp", "definition": "Phạm: Puịya-karma.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Nghị", "definition": "福 毅 (1710-1795). Thiền tăng đời Thanh, họ Lý,tự Mẫn Tu, người xứ Vũ Xương, Hồ Bắc, Trung Quốc. Nối pháp Thiền Sư Thạc Am Hạnh Tải, đời thứ 39 hệ Thanh Nguyên. Trụ trì chùa Tiêu Sơn. Có Ngữ Lục truyền lại đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Ngộ", "definition": "福 遇 (1245-1313). Còn gọi: Phất Ngộ. Thiền tăng đời Nguyên, họ Vương, tự Hoàn Nguyên, người đời gọi là Hoàn Nguyên Phúc Ngộ Thiền Sư, người xứ Linh Thạch, Hoắc Châu (nay thuộc Sơn Tây) Trung Quốc. Sư cạo tóc ở chùa Đâu Suất tại ấp nhà, rồi dạo khắp các pháp hội, hùng biện như thác đổ. Sau đó sư đến Thiếu Thất tham vấn Thiền Sư Văn Thái, được ấn khả, nối pháp ngài thuộc tông Tào Động. Đầu tiên sư hoằng pháp ở chùa Thiên Khánh. Niên hiệu Chí Nguyên thứ 26 (1289) sư dời đến chùa Bảo ứng ở Tây Kinh. Niên hiệu Nguyên Trinh thứ 1 (1295), sư kế vị trụ trì Thiếu Thất. Niên hiệu Chí Đại thứ 4 (1311) sư lui về ở ẩn tại chùa Bạch Mã, Lạc Dương.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Nhân", "definition": "福人. Người được hưởng nhiều may mắn tốt lành trong cuộc sống. Người có phúc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Phần", "definition": "Đối lại: Đạo Phần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Phận", "definition": "福分. Cái phần may mắn tốt lành đã được trời chia sẵn cho. Chỉ cuộc đời may mắn sung sướng do trời định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Sinh Thiên", "definition": "Phạm: Puịya-prasava.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Thành", "definition": "Cũng gọi Giác Thành, Phúc Sinh thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Thái", "definition": "福泰. May mắn tốt lành. Văn tế Nghĩa sĩ Trương Công Định của Nguyễn Đình Chiểu có câu: “Nay thác theo thần, xin dựng hộ một câu phúc thái”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Thần", "definition": "福神. Ông thần đem lại may mắn tốt lành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Thẩm", "definition": "覆審. Xét lại một lần nữa (nói về toà án).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Thắng Tháp", "definition": "福 勝 塔. Nằm trong khuôn viên Phúc Thắng thiền viện thuộc Nguyên Khai Bảo Tự, thành phố Khai Phong, tỉnh Hà Nam, Trung Quốc. Là tháp gỗ hình bát giác 13 tầng cao 360 thước Tàu, quy mô cao lớn, được gọi là “Từ khi Phật pháp truyền vào Trung Quốc chưa hề có”. Tương truyền đỉnh tháp phóng quang, nên niên hiệu Đại Trung Tường Phù thứ 6 (1013) đổi tên là “Linh Cảm Tháp”. Niên hiệu Khánh Lịch thứ 4 (1044) tháp bị hủy bởi sấm sét. Niên hiệu Hoàng Hựu thứ 1 (1049) xây dựng lại tức là tháp sắt ngày nay.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phúc Thọ", "definition": "福夀. Đông con và sống lâu. Hai trong Tam đa. Xem thêm Phúc lộc 福祿.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Thọ Cao", "definition": "福夀膏. Một tên chỉ thuốc phiện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Thống", "definition": "腹痛. Đau bụng. Bệnh đau bụng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Thủ Hướng Hạ Hợp Chưởng", "definition": "Một kiểu chắp tay với hình thức 2 bàn tay úp(phúc) xuống, 2 ngón cáiđểsong song, đầu của 2 ngón giữa chạm vào nhau. Là kiểu thứ 11 trong 12 kiểu chắp tay của Mật Giáo. Mười hai kiểu chắp tay này tức là 12thứhình tướng của ấn khế, cùng với 6 thứ Quyền ấn(ấn nắm tay) đều là nền tảng của các ấn khế trong Mật Giáo, vì thế được gọi là Ấn mẫu(mẹ của các ấn). [X. Đại Nhật Kinh Sớ Q.13; Đại Nhật Kinh Nghĩa Thích Q.8]. (xt. Thập Nhị Hợp Chưởng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Tinh", "definition": "Fuxing (C), Fu-hsing (C), Lucky Star Fuxing (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Trí", "definition": "Từ ngữ gọi chung phúc đức và trí tuệ. Cứ theo Luận Thành Duy Thức quyển 9 thì trong các hạnh thù thắng mà Bồ Tát tu hành, hạnh lấy tuệ làm tính gọi là Trí, các hạnh còn lại gọi là Phúc. Bồ Tát muốn thành tựu quả Phật thì phải thực hành đầy đủ 2 hạnh thù thắng là thượng cầu bồ đề (trí nghiệp) và hạ hóa chúng sinh (phúc nghiệp).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Trí Nhị Nghiệp", "definition": "Từ ngữ gọi chung Phúc Nghiệp và Trí Nghiệp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Trí Tạng", "definition": "Kho phúc trí. Tức chỉ cho Đại Hạnh hoằng nguyện niệm Phật nói trong Kinh Đại Vô Lượng Thọ, cũng tức là danh hiệu “Nam mô A Di Đà Phật”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Trướng", "definition": "腹脹. Bệnh báng, bụng cứ lớn lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Trạch", "definition": "福澤. Ơn trời đất ban cho nhiều điều may mắn tốt lành Như phúc ấm 福廕. “Cứ xem phúc trạch nhà ta”. (Quan âm thị kính).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Trạch Dụ Kiết", "definition": "Fukuzawa yukichi (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Tuệ", "definition": "I.Cũng gọi Phúc Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Tuệ Song Tu", "definition": "Bỏ ác làm lành, ngay cả dứt trừ trọn vẹn mười nghiệp ác và tu tập đầy đủ mười nghiệp lành, thì cũng chỉ đủ tạo phúc đức để được hưởng quả báo sung sướng cùng tột ở các cõi trời mà thôi. Đó vẫn là thứ phước báo hữu lậu, không đủ khả năng giúp cho người tu hành phá vỡ vô minh, thoát li ba cõi, dứt tuyệt sinh tử luân hồi. Muốn giải thoát sinh tử để chứng nhập niết bàn, hành giả, ngoài việc tu tạo phúc đức, còn phải nỗ lực phát huy trí tuệ, bằng cách tu tập thiền định, suy nghiệm chân lí, cho đến khi tuệ giác bừng sáng, vô minh phiền não hoàn toàn tiêu diệt. Con đường tu tập như vậy, trong Phật giáo gọi là “phúc tuệ đồng tu” (phúc tuệ song tu). Đức Thích Ca Mâu Ni, đã từng trải bao đời kiếp tu tạo công đức lành, nhưng phải đợi đến kiếp cuối cùng, do công phu tu tập thiền định một cách triệt để trong bốn mươi chín ngày dưới cội cây bồ đề, mới đạt được quả vị giác ngộ viên mãn, thành bậc Tối Chánh Giác. Bởi vậy, lời chúc “Phúc Tuệ Viên Thành” được coi là lời chúc đầy đủ ý nghĩa nhất mà người tu hành thường dùng để chúc nhau.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phúc Túc", "definition": "Đối lại: Trí túc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Tăng", "definition": "I.Phúc Tăng. Phạm: Zrì-vaddhi.Pàli: Sirì-vaddhi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Tư Bảo Nhĩ", "definition": "Fausbôll, Michael Viggo (1821-1908). Học giả Ấn Độ học người Đan Mạch, người đầu tiên sáng lập môn ngôn ngữ học Pàli.Ông là học trò của Rask, Rasmus Kristion và Westergard, Niels Lusdwig. Năm 1878, ông làm Giáo sư trường Đại Học Copenhagen, nghiên cứu học thuật cổ đại của Ấn Độ, đặc biệt chú trọng kinh Phật Nam Truyền bằng tiếng Pàli.Năm 1855, ông hiệu đính và xuất bản nguyên điển Kinh Pháp Cú Pàli (Dhammapadam, Ex tribus codicibus Havniensibus Palice edidit, Latine vertit, excerptis ex Commentario Palico nostique illustravit V. Fausbôll Havniae, 1855). Đây là bộ kinh nguyên văn tiếng Pàli đầu tiên có giá trị học thuật được xuất bản. Kế tiếp, ông lại cho ấn hành nguyên điển các loại Kinh Bản Sinh và bản dịch tiếng Anh. Năm 1897, ông xuất bản Kinh Bản Sinh Đại tập 7 quyển (TheJàtaka, together with its Commentary, Being Tales of the Anterior Births of Gotama Buddha, London, 1875- 1897), mất hơn 20 năm mới hoàn thành. Ngoài ra, ông còn xuất bản bản dịch tiếng Anh của Kinh tập tiếng Pàli (The Suttanipàta, SBE. X, pt. II, 1881), cùng với nguyên điển và ngữ vựng (2 vols. I, Text; II, Glossary, 1884-1893).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Tướng", "definition": "福相. Diện mạo dáng dấp bề ngoài, cho biết cuộc đời được hưởng nhiều may mắn sung sướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Tướng Pháp Thân", "definition": "Đối lại: Trí Tướng Pháp Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Tế Tự", "definition": "Fukusai-ji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Tụ Hải Vô Lượng", "definition": "Phúc đức tích tụ rộng lớn vô lượng vô biên như biển cả. Là lời tán thán phúc đức của Bồ Tát Quan Thế Âm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Viên", "definition": "幅員. Chỉ ranh giới của đất nước. Ta thường quen đọc Bức viên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Xá", "definition": "Phạm: Puịya zàlà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Âm", "definition": "福音. Tin tức tốt lành Tên chỉ kinh Tân ước của Cơ đốc giáo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Điền", "definition": "Field of merit, Fukuda gyōkai (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Điền Tịnh Đức", "definition": "Người xuất gia phải có giới đức thanh tịnh mới xứng đáng làm phúc điền cho thế gian. Vì người đời nếu cúng dường chúng tăng thanh tịnh thì được phúc đức lớn, nên gọi chúng tăng giới đức thanh tịnh là Phúc điền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Điền Viên", "definition": "Nơi chuyên thu nhận nuôi dưỡng những người già yếu, trẻ em, tàn tật không nơi nương tựa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Điền Vô Thượng Tâm", "definition": "Một trong 6 thứ tịnh tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Điền Y", "definition": "Áo ruộng phúc, tên khác của áo ca sa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Đà Mật Đa", "definition": "Xem Tổ Phật Đà Mật Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Đáp", "definition": "覆答. Trả lời lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Đường", "definition": "Nhà phúc. Pháp hiệu của thiền sư Tiêu Dao đời Trần, là thầy dạy của Tuệ Trung Thượng Sĩ. Thừa Phúc có dư, để lại cho con cháu. Chữ Hán “dư khương” nói lên một quan niệm trái với đạo Phật. Theo đạo Phật, tự mình làm, tự mình hưởng phúc hay là [tr.550] chịu quả báo, không có chuyện để phúc lại cho con cháu. Cha mẹ có ảnh hưởng tới, chứ không phải vì ở đời, che mẹ hiền thường đẻ ra con thảo, cha mẹ học giỏi, ham học thường đẻ ra con thông minh, cha mẹ ác đẻ ra con vô lại v.v… Theo quan điểm của đạo Phật, thì đó chính là do những người con ấy, trong những kiếp sống trước đã làm nhiều phúc, hoặc gây nhiều tội, nên tái sinh vào gia đình tốt hay xấu. Vì vậy câu sau đây trong truyện “Phan Trần” không đúng với tinh thần đạo Phật.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phúc Đẳng Hà Sa", "definition": "福等河沙. Điều may mắn được hưởng thì nhiều bằng với số cát ở sông, ‎ý nói nhiều may mắn lắm. “Từ đây phúc đẳng hà sa vô cùng”. (Quan âm).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Đẳng Tam Nghiệp", "definition": "Từ ngữ gọi chung Phúc Nghiệp, Phi Phúc Nghiệp Và Bất Động Nghiệp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Địa", "definition": "福地. Vùng đất tốt lành yên vui.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúc Độ", "definition": "(1637-?).Thiền Sư Trung Quốc, thuộc Tông Lâm Tế, sống vào cuối đời Minh đầu đời Thanh, người Vĩnh xuyên, Tây Thục (tỉnh Tứ Xuyên), họ trương, hiệu Mai Khê.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Đức", "definition": "Puñña (P), Merit Puṇya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúc Đức Môn", "definition": "Đối lại: Trí Tuệ Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Đức Tư Lương", "definition": "Cũng gọi Phúc Đức Trang Nghiêm. Đối lại: Trí Tuệ Tư Lương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc Đức Tạng", "definition": "Chỉ cho các hạnh định thiện, tán thiện được nói đến trong Kinh Quán Vô Lượng Thọ. Vì các loại thiện hạnh này có công năng đem lại nhiều phúc lợi, giống như cái kho (tạng) có sức chứa đựng các phúc đức, cho nên gọi là Phúc đức tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phúc ấm", "definition": "福廕. Điều may mắn tốt lành con cháu được hưởng, do công ơn ông cha để lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún", "definition": "噴. Thổi mạnh ra Phun ra Vọt lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Bạc", "definition": "噴薄. Vọt lên. Tia lên (nói về nước).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Hỏa", "definition": "噴火. Phun lửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Hỏa Sơn", "definition": "噴火山. Núi phun lửa. Núi lửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Hỏa Thương", "definition": "噴火搶. Súng phun lửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Khẩu", "definition": "噴口. Miệng núi lửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Môn", "definition": "噴門. Chỗ cửa dạ dày tiếp với thực quản (Cardia).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Phún", "definition": "噴噴. Nói nhanh lắm, liến thoắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Phạn", "definition": "噴飯. Phun cơm, đang ăn cơm mà cười phun cả cơm ra. Ý nói buồn cười lắm, không nhịn được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Ra", "definition": "Niccharaṇa (trung), niddhamana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phún Thạch", "definition": "噴石. Đá do núi lửa phun ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Tuyền", "definition": "噴泉. Suối nước phun lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Vụ Khí", "definition": "噴霧器. Đồ phun nước ra thành hạt nhỏ li ti (chẳng hạn đồ xịt nước hoa, đồ bơm thuốc muỗi.).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Xuất", "definition": "噴出. Phun ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phún Xuất Thạch", "definition": "噴岀石. Như Phún thạch 噴石.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúng", "definition": "縫. Đường khâu Khe hở Một âm là Phùng. Xem Phùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúng Gián", "definition": "諷諫. Dùng lời bóng gió để cản ngăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúng Khuyến", "definition": "諷勸. Dùng lời bóng gió khuyên răn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúng Kinh", "definition": "(諷經): tụng kinh, đọc kinh văn theo âm điệu trầm bổng, lên xuống. Nguyên lai là pháp của Bà La Môn giáo, sau đó đức Phật hứa khả cho các Tỳ Kheo được sử dụng pháp này, tức là Phạn Bối (梵唄). Người có khả năng về khoa này được gọi là kinh sư (經師). Trong bài Lễ Tụng Dược Sư Cáo Văn (禮誦藥師告文) của Lý Chí (李贄, 1527-1602) nhà Minh có câu: “Sấn thử nhất bách nhị thập nhật kỳ hội, phúng kinh bái sám đạo tràng (趁此一百二十日期會、諷經拜懺道塲, nhân dịp 120 ngày này, tụng kinh lạy sám hối đạo tràng).” Hay trong tác phẩm Tô Châu Phong Tục (蘇州風俗), chương Hôn Tang Lễ Tục (婚喪禮俗), của Chu Chấn Hạc (周振鶴) có đoạn: “Tử hậu mỗi thất nhật, tất diên tăng lữ hoặc vũ y lễ sám phúng kinh (死後每七日、必延僧侶或羽士禮懺諷經, sau khi chết vào mỗi tuần bảy ngày, phải mời tăng sĩ hay đạo sĩ đến lạy sám hối, tụng kinh).” Trong Phật Thuyết Di Nhật Ma Ni Bảo Kinh (佛說遺日摩尼寶經, Taishō Vol. 12, No. 350) có nêu lên tầm quan trọng của việc tụng kinh, trì giới như sau: “Tuy đa phúng kinh nhi bất trì giới, thí như nhân bệnh đắc vương gia dược, bất tự hộ tọa tử, tuy đa phúng kinh nhi bất trì giới như thị, thí như Ma Ni bảo châu đọa ư thỉ trung (雖多諷經而不持戒、譬如人病得王家藥、不自護坐死、雖多諷經而不持戒如是、譬如摩尼珠墮於屎中, tuy tụng kinh nhiều mà không giữ giới, giống như người bị bệnh có được thuốc nhà vua, nhưng không thoát khỏi chết ngồi, tuy kinh nhiều mà không giữ giới như vậy, giống như ngọc báu Ma Ni rơi trong đống phân).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phúng Thích", "definition": "諷刺. Dùng lời bóng gió xa xôi để chỉ trích một người, đả kích một sự việc, để châm chọc điều chướng tai gai mắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúng Tụng", "definition": "Peyyavajja (P), Gāthā (S, P), Verse.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phúng Vịnh", "definition": "諷詠. Làm văn thơ rồi đọc lên để nói về cảnh vật, sự việc. Như: Ngâm vịnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phúng Điếu", "definition": "賵弔. Đem lễ vật tới để tặng và thăm hỏi nhà có người chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phút Chốc", "definition": "Muhuṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phāsuvihāra", "definition": "Năm pháp lạc trú.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Phơi Khô", "definition": "Ussussati (u + sus + ya), visoseti (vi + sus + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phơi Nắng", "definition": "Otāpeti (ova + tap + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phương", "definition": "Caturasra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Biện", "definition": "方 辯. Thiền tăng đời Đường, họ Phương tên Biện, pháp hiệu Thất Tra, người Tây Thục (Tứ Xuyên) Trung Quốc. Sư là đệ tử của Lục Tổ Huệ Năng khi Tổ về già, thuộc Thiền Tông Nam tông đời thứ 2. Sau khi Lục Tổ thị tịch, sư trở về Tứ Xuyên hoằng pháp.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Chi", "definition": "芳芝. Cành hoa thơm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Chiếu", "definition": "芳詔. Tờ giấy ghi lệnh vua và có mùi thơm. Chỉ lệnh vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Châm", "definition": "方針. Kim chỉ hướng Điều tốt, hướng dẫn ta trong cuộc sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Cách", "definition": "方格. Đường lối phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Danh", "definition": "芳名. Tiếng thơm. Tiếng tốt. Bài Tài tử đa cùng phú của Cao Bá Quát có câu: “Khét mùi thế vị chẳng thà không Thơm nức phương danh nên mới hổ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Diện", "definition": "方面. Bề mặt hình vuông Cái hướng nhìn, cái khía cạnh của sự việc. “Nghĩ mình phương diện quốc gia” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Dung", "definition": "方 融. Hiệu của Thiền tăng Như Tỉ, đời Thanh. X. Như Tỉ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Dược", "definition": "方藥. Vị thuốc. Thứ thuốc trị bệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Hình", "definition": "方形. Hình vuông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Hướng", "definition": "方向. Cái phía mà ta nhìn về đó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Hại", "definition": "妨害. Làm thiệt thòi, tổn thương tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Hội", "definition": "Fang-hui (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Khẩu Thực", "definition": "Phương khẩu.Pàli: Disàmukha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Kế", "definition": "Payoga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phương Liệt", "definition": "芳烈. Thơm tho mạnh mẽ, chỉ tiếng tốt lan truyền xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Luận Sư", "definition": "Luận sư ngoại đạo chủ trương phương vị là nhân sinh ra muôn vật, 1 trong 20 thứ ngoại đạo ở Ấn Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Lí", "definition": "方里. Dặm vuông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Lược", "definition": "方略. Đường lối để làm việc lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Mệnh", "definition": "方命. Trái lệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Mộc Đậu Viên Khổng", "definition": "方 木 逗 圓 孔. Dùng cây vuông tra vào lỗ tròn, dụ cho phương pháp sai lầm, không cách nào đạt đến mục đích. Phật Quả Ngữ Lục q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Nghệ", "definition": "Phương là nơi chốn; Nghệ là đến. Phương nghệ là chỗ qui về, tức là ý thú, yếu chỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Ngoại", "definition": "方外. Ở ngoài xã hội, ngoài cuộc đời. Nói về người ở ẩn, hoặc đi tu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Ngoại Hữu", "definition": "Người bạn ngoài thế tục. Tức là từ ngữ mà giới trí thức thế gian dùng để gọi những bạn xuất gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Ngôn", "definition": "方言. Tiếng nói của một vùng. Thổ âm Lời nói hay, lưu truyền lâu đời tại một vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Nham", "definition": "方 喦. Hiệu của Thiền tăng Vân Tụ, đời Nguyên. X. Vân Tụ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Niệm", "definition": "方 念 (1510-1594). Thiền tăng đời Minh, họ Dương, tự Từ Chu, hiệu Thanh Lương, người Đường huyện (Hà Bắc), Trung Quốc. Năm 10 tuổi xuất gia, sư ban đầu nghiên cứu tông chỉ tính tướng, thường bị bệnh bức bách nên hâm mộ thiền pháp, liền đến Thiếu Thất tham kiến Thiền Sư Thường Nhuận. Thường Nhuận thấy sư nói năng hòa nhã nên cho làm Duy Na. Ngày nọ đi đến chỗ Sơ Tổ ngồi nhìn vào vách, bỗng nhiên khế ngộ, bèn được Thường Nhuận ấn chứng, làm truyền nhân tông Tào Động. Lúc 28 tuổi sư vào Ngũ Đài bế quan khổ tâm tham cứu. Ngày ăn một bữa, đêm chỉ tọa thiền.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Phi", "definition": "芳菲. Thơm tho đẹp đẽ. Nói về hoa cỏ cây cối Ta còn hiểu là thân hình đẫy đà mặt mày béo tốt Lăng uyển lúc thu tàn hoa chửa rũ, thêu hồng kết gấm ví Phương phi cùng xuân ấy không thua. (Chiến Tụng Tây Hồ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Phu", "definition": "芳敷. Thơm tho và phô bày vẻ đẹp. Nói về cảnh vật hoa cỏ. Bài Tụng Tây hồ phú của Nguyễn Huy Lượng có câu: “Đèn bắc trạch xây kề Ngưu chử, cảnh Tây hồ trăm thức lại phương phu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Pháp", "definition": "方法. Phép tắc, cách thức phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Phần", "definition": "Chủ trương cho cực vi có các phương vị trên, dưới, phải, trái và có thể tích chiếm dụng khoảng không gian, gọi là", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Phục", "definition": "Cũng gọi Phương Bào.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Quảng", "definition": "Feng-kan (C), Vaipulya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Quảng Kinh", "definition": "Xem Đại Thừa Phương Đẳng Kinh.Xem Đại Thừa Phương Đẳng Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Quảng Thập Luân Kinh", "definition": "Xem Đại Phương Quảng Thập Luân Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Quảng Tự", "definition": "方 廣 寺. Dưới ngọn Liên Hoa, Hành Sơn, tỉnh Hồ Nam, Trung Quốc. Xây dựng vào niên hiệu Thiên Giám thứ 2 (503) đời Lương Nam Triều, đời Đường gọi là “Phương Quảng Thánh Thọ Tự”, đầu đời Tống gọi là “Phương Quảng Sùng Thiền Tự”. Huệ Hải là một trong 18 cao tăng Nam Nhạc từng lấy nơi đây làm đạo tràng. Từ đây về sau nhiều lần hư phế nhiều lần tu sửa. Vào đời Minh, Hòa Thượng Khiết Không trùng tu, cất nhà ván lợp ngói sắt. Hơn 100 năm sau đến niên hiệu Sùng Trinh thứ 1 (1628) đời Minh, Vương Phù Chi lại bỏ tiền ra tu sửa. Kiến trúc chủ yếu hiện còn trong chùa là Chính điện, Tổ sư đường. Sự thâm u của Phương Quảng Tự là một trong “Nam Nhạc tứ tuyệt”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Quảng Đại Trang Nghiêm Kinh", "definition": "Fang-kuang ta-chuang-yen ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Quảng Đạo Nhân", "definition": "Chỉ cho những người ngoại đạo sống nhờ vào Phật Pháp Đại Thừa. Phương quảng là vuông vức, rộng lớn,chỉ cho Đại Thừa; Đạo nhân là người học đạo. Như vậy, nói theo ngữ nghĩa thì “Phương quảng đạo nhân” là những người tu học Phật Pháp Đại Thừa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Quế", "definition": "芳桂. Cây quế thơm. Chỉ người con hiếu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Sách", "definition": "方策. Như Phương lược 方略.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Sách Nhân Duyên", "definition": "方 册 因 緣. Cơ duyên ngữ cú trên sách vở. Tiết Đạo Trường Minh Biện Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Sĩ", "definition": "Fang-shih (C), Black magician.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Sắc Dụ Ngũ Đạo", "definition": "方色喻五道 (Viên Giác Kinh Lược Sớ Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phương Sở", "definition": "Phương hướng và nơi chốn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Thuật", "definition": "方術. Phép lạ của các đạo sĩ. Phép tiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Thảo", "definition": "芳草. Cỏ thơm. Bài tựa truyện Kiều, Đoàn Tư Thuật dịch từ Hán văn của Chu Mạnh Trinh, có câu: “Lại muốn mượn chùm phương thảo hú vía thuyền quyên” Còn chỉ cái đức tốt của người quân tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Thốn", "definition": "方寸. Tấc vuông Tam quốc chí: Từ Thứ hỏi rằng: Kim thất lão mẫu, phương thốn loạn kỉ (nay mất mẹ già, phương thốn rối loạn mất rồi). “Gặp khi phương thốn muôn ngàn xót xa” (Thơ cổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Thốn Thiền", "definition": "Thiền mới một tấc. Nghĩa là người tham thiền mới chỉ lãnh ngộ được chút ít. Chương Pháp Vân cảo trong Ngũ Đăng Hội Nguyên quyển 17 (Vạn Tục 138, 339 thượng) ghi: “Sư thường nói với mọi người: Vào ngày 21 tháng 11 năm Thiệu Thánh thứ 3, ta ngộ được Phương thốn thiền”. Thiền ở đây tuy nói là “phương thốn” nhưng cực kì sâu xa, mầu nhiệm, cũng như “Nhất Chỉ Thiền” (Thiền 1 ngón tay) của Hòa Thượng Câu Chi vậy. (xt. Nhất Chỉ Thiền).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Thức", "definition": "方式. Như Phương cách 方格.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Thức Tham Thiền", "definition": "Bhāvanāvidhāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phương Tiên Nhị Chủng Tướng", "definition": "Hai thứ phương tiện khéo léo mà Bồ Tát thị hiện ra để cứu độ chúng sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện", "definition": "Là một thuật ngữ Phật học, chỉ cho những hành động, cử chỉ và ngôn ngữ khéo léo mà người tu tập hạnh Bồ-tát sử dụng trong công việc giáo hóa chúng sinh. Chân lí là pháp chân thật, chỉ có thể chứng nghiệm, thể nhập, chứ không thể suy nghĩ hay nói năng. Bởi vậy, muốn cho chúng sinh thể nhập pháp chân thật, chư Phật và Bồ-tát phải quán sát căn cơ của chúng sinh, tùy mỗi hạng mà bày ra những phương pháp (pháp môn) khác nhau để chỉ bày, hướng dẫn, hóa độ. Tất cả mọi pháp môn đó (thường nói là tám vạn bốn ngàn pháp môn) đều được gọi là “phương tiện”. Cũng vậy, tuệ giác của chư Phật là trí tuệ bát nhã, chân thật, bình đẳng, không phân biệt; nhưng trong công việc hóa độ chúng sinh, chư Phật và Bồ-tát phải dùng thứ trí tuệ quyền tạm để quán chiếu những hiện tượng sai khác của đời sống chúng sinh, để tùy cơ giáo hóa. Thứ trí tuệ quyền tạm ấy được gọi là “trí phương tiện”. Tóm lại, tất cả mọi pháp môn tu hành để đạt tới tuệ giác siêu việt, đều là “phương tiện”. – Ngay như việc phân chia có hai thứ trí tuệ chân thật và quyền tạm, cũng vẫn là “phương tiện”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phương Tiện Ba La Mật", "definition": "Upāyapāramitā (S), Ārya-upāya-pāramitā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Tiện Ba La Mật Bồ Tát", "definition": "Phạm:Àrya-upàya-pàramità.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Bát Nhã", "definition": "I.Phương Tiện Bát Nhã.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Giả Môn", "definition": "Giáo môn phương tiện tạm lập ra để đưa chúng sinh vào Đạo Chân thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Hiện Niết Bàn", "definition": "Cũng gọi Ứng Hóa Niết Bàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Hóa Thân", "definition": "Chỉ cho hóa thân của Đức Phật A Di Đà thị hiện trụ ở cõi Giải Mạn được hóa hiện tại biên địa Tịnh Độ để thích ứng với các phương tiện nguyện (nguyện thứ 19 tu các công đức; nguyện thứ 20 niệm Phật tất định vãng sinh)..., trong 48 nguyện của Ngài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Hóa Độ", "definition": "Tịnh Độ do Đức Phật A Di Đà phương tiện thị hiện để tiếp dẫn các hành giả tự lực tu các thiện hạnh và niệm Phật cầu vãng sinh, 1 trong 2 độ do Chân Tông của Nhật Bản Thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Hữu Dư Độ", "definition": "Tịnh Độ trong đó các vị A La Hán, Bích Chi Phật và các Bồ Tát dưới Thập Địa cư trụ, 1 trong 4 độ do Tông Thiên Thai thiết lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Khéo", "definition": "Skilful means, Upaya (S), Thab (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Tiện Môn", "definition": "Cửa phương tiện. Đạo Phật đặt ra rất nhiều cửa phương tiện để đưa tất cả chúng sinh vào đạo. Trí Cg, quyền trí. Trí tuệ về các phương tiện thiện xảo, khéo léo trong việc độ sinh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phương Tiện Nhị Chủng Tướng", "definition": "方便二種相 (Địa Tạng Thập Luận Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phương Tiện Pháp Thân", "definition": "Upāya-dharmakāya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Tiện Phẩm", "definition": "1.Phương Tiện Phẩm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Sinh Sống", "definition": "Jīvana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phương Tiện Sát Sinh", "definition": "Chỉ cho việc giết hại mà bậc Đại Bồ Tát thực hiện để cứu độ chúng sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Thanh", "definition": "Chỉ cho âm thanh chữ (a) trong 5 cách biến hóa về âm vận của chữ (a) trong Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Trí", "definition": "Upāyajñāṇa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Tiện Tâm", "definition": "I.Phương Tiện Tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Tâm Luận", "definition": "Upāyahṛdaya-śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Tiện Tùy Duyên Chỉ", "definition": "Cũng gọi Hệ Duyên Thủ Cảnh Chỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tiện Định", "definition": "Xem Cận Phần Định.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Trình", "definition": "方程. Bày tỏ về sự biến đổi giữa các lượng trong hoá học, hoặc sự biến chuyển giữa các lượng trong toán học (Équation).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Trưởng", "definition": "芳長. Thơm tho lớn mạnh. Nói về cây cỏ Chỉ sự lớn lên, nói về người. Có nghĩa như Trưởng thành. Đoạn trường tân thanh có câu: “Hai em phương trưởng hòa hai, nọ chàng Kim đó là người ngày xưa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Trượng", "definition": "Hōjō (J), Fang-chang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Trượng Nội Hạ", "definition": "Lễ chúc mừng vị Trụ Trì trong phương trượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Trạch", "definition": "方 澤. Thiền tăng đời Minh, họ Nhậm, tự Vân Vọng, hiệu Đông Khê, Vô Tham, người Gia Thiện (Chiết Giang), Trung Quốc. Vào chùa Tinh Nghiêm ở Tú Thủy (Gia Hưng, Chiết Giang) sư cạo tóc làm tăng, thông nội điển, có giới hạnh. Yết kiến Đạo Tế chùa Thiên Ninh. Một hôm nhân xem công án Thiên Vương, đọc đến câu “chỗ nào chẳng chỉ bày tâm yếu” sư liền hoát nhiên tỉnh ngộ, được Đạo Tế ấn khả. Khi ra hoằng pháp pháp sư trụ trì chùa Tích Nghiêm, về già lui về ở tinh xá Tú Thủy. Bẩm tính thông minh, ngày có thể tụng hơn vạn lời kệ, hạ bút là văn tự tuôn chảy. Tác phẩm: Hoa Nghiêm Yếu Lược 2 quyển, Đông Khê Nội Ngoại Tập 8 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phương Trấn", "definition": "方鎮. Đóng giữ một vùng Chức quan coi giữ một vùng đất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Tòa", "definition": "Tòa hình vuông, không có trang sức, một loại tòa ngồi đơn giản nhất của các pho tượng Phật và Bồ Tát. (xt. Đài Tòa).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tú", "definition": "芳秀. Thơm tho đẹp đẽ. Nói về hoa cỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Tướng", "definition": "Giới Tràng hình vuông trong Đại Giới, 1 trong 5 cách kết giới tướng. (xt. Ngũ Chủng Kết Giới Tướng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Tễ", "definition": "方劑. Thuốc chữa bệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Tục", "definition": "方俗. Thói quen lâu đời trong một vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Vinh Thăng", "definition": "Người sáng lập ra Viên Giáo (Đại Đồng Giáo, 1 tông giáo dân gian) sống vào đời Minh, người huyện Sào, tỉnh An Huy, Trung Quốc. Ông từng học giáo pháp nơi Kim Tông Hữu, đồ tôn của Vương Bỉnh Hành, Giáo Chủ Thanh Trà Môn Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Võng Tam Muội", "definition": "Tam Muội của Bồ Tát, vì Tam Muội này rộng lớn vô biên, giống như mạng lưới (võng) bao trùm khắp 8 phương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Vật", "definition": "方物. Những món do một vùng sản xuất ra. Tức sản vật địa phương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Vị", "definition": "方位. Chỗ ngồi và đường hướng làm việc. Chỉ cơ sở và chức vụ của một công chức, quân nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Xích", "definition": "方尺. Thước vuông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Điển", "definition": "Gọi đủ: Phương Đẳng Kinh Điển. Tức gọi chung các kinh Đại Thừa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đàn", "definition": "Cũng gọi Địa Luân Đàn, Kim Cương Luân Đàn, Kim Luân Đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đình", "definition": "方亭. Hiệu của Nguyễn Văn Siêu, danh sĩ thời Nguyễn. Xem tiểu truyện ông ở vần Siêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Đình Thi Tập", "definition": "方亭詩集. Tên một tập thơ chữ Hán của Nguyễn Văn Siêu, danh sĩ đời Nguyễn. Xem tiểu truyện tác giả ở vần Siêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Đình Văn Tập", "definition": "方亭文集. Tên một tác phẩm bằng Hán văn của Nguyễn Văn Siêu, danh sĩ đời Nguyễn. Xem tiểu truyện tác giả ở vần Siêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Đình Địa Chí Loại", "definition": "方亭地志類. Tên một cuốn sách về địa dư nước ta của Nguyễn Văn Siêu, danh sĩ đời Nguyễn, bài tựa viết năm 1862, niên hiệu Tự Đức 15. Xem tiểu truyện tác giả ở vần Siêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phương Đông Mĩ", "definition": "(1899-1977).Học giả Trung Quốc, người Đồng Thành, tỉnh An Huy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng", "definition": "“Phương” là ngay thẳng, cũng có nghĩa là rộng; “đẳng” là bình đẳng, cũng tức là lí trung đạo; có nghĩa là, đã ngay thẳng, lại sinh tính bình đẳng của Phật. Tất cả kinh giáo đại thừa đều nói lên cái lí trung đạo, cho nên đều được gọi chung là giáo lí “phương đẳng”. Trong thời thuyết giáo thứ ba, đức Phật đã nói bốn loại pháp môn tạng, thông, biệt, viên một cách rộng rãi, đem lại lợi ích đồng đều cho cả mọi căn cơ cao thấp, cho nên gọi đó là thời “Phương Đẳng”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phương Đẳng Bản Khởi Kinh", "definition": "Xem Phổ Diệu Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phương Đẳng Bộ", "definition": "Từ ngữ chỉ chung cho các kinh Đại Thừa ngoài 4 bộ: Hoa Nghiêm, Bát Nhã, Pháp Hoa, Niết Bàn. Là 1 trong 5 đại bộ của kinh Đại Thừa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng Giới Đàn", "definition": "Giới Đàn được thiết lập theo ý nghĩa Đại Thừa Phương Đẳng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng Kinh", "definition": "I.Phương Đẳng Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng Sám Hối", "definition": "Cũng gọi Phương Đẳng sám.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng Tam Muội", "definition": "Thiên Thai đại sư đã y cứ vào Kinh Đại Phương Đẳng Đà La Ni mà chế lập phép hành trì Phương Đẳng Tam Muội, cùng với Pháp Hoa tam muội, đều thuộc loại bán hành bán tọa tam muội trong bốn thứ tam muội (xem mục “Pháp Hoa Tam Muội”). Trong Luận Chỉ Quán và sách Phương Đẳng Tam Muội Hành Pháp, có ghi rõ về nghi thức tác pháp. Hành trì phép tam muội này, lấy 7 ngày làm một hạn kì, hành giả ở trong đạo tràng, tụng trì Đà-la-ni chú; vừa đi nhiễu vừa tụng. Đi nhiễu được 120 vòng thì ngồi xuống tư duy quán chiếu về lí thật tướng. Hết ngồi quán tưởng thì lại đứng dậy đi nhiễu... Cứ tiếp tục hành trì như thế cho đến 7 ngày là dứt một hạn kì.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phương Đẳng Tam Muội Hành Pháp", "definition": "Cũng gọi Đại Phương Đẳng Hành Pháp.Tác phẩm, 1 quyển, do ngài Trí Khải giảng, đệ tử Quán Đính ghi chép, được thu vào Đại Chính Tạng tập 46.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng Thời", "definition": "Chỉ cho thời kì Đức Phật tuyên nói các Kinh Phương Đẳng, là thời thứ 3 trong 5 thời phán giáo của Tông Thiên Thai.Tức là thời kì bắt đầu từ năm thứ 12 sau khi Đức Phật Thành Đạo, Ngài nói các Kinh Phương Đẳng như Kinh Duy Ma, Kinh Kim Quang Minh... trong khoảng 8 năm. (xt. Ngũ Thời Bát Giáo).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phương Đẳng Đại Vân Kinh", "definition": "Xem Phương Đẳng Đại Vân Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phước", "definition": "Puṇyatva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phước Báu", "definition": "Ānisaṃsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phước Mỏng", "definition": "Meager in virtue, with shallow virtue", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phước Nghiệp", "definition": "Puṇya-karma (S), Good karma, Puññakamma (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phước Sanh Thiên", "definition": "Puṇyaprasava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phước Thiện", "definition": "Puñña (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phước Xá", "definition": "Dānasālā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phước Xương Tự", "definition": "(福昌寺, Fukushō-ji): ngôi chùa của Tào Động Tông, hiệu là Sĩ Phong Sơn (士峰山); hiện tọa lạc tại Kamisato-mura (上里村), Kodama-gun (兒玉郡), Saitama-ken (埼玉縣). Chùa này nguyên sơ nằm gần bên ngôi mộ của Đới Đao Nghĩa Hiền (帶刀義賢), tên là Đới Đao Sơn Sĩ Phong Viện (帶刀山士峰院); nhưng vào năm 1782 (Thiên Chánh [天正] 10) thì bị binh hỏa, nên được tái kiến lại và lấy tên là Phước Xương Tự cho đến ngày nay. Vị Tổ thời Trung Hưng của chùa là Xuyên Điền Chuẩn Nhân (川田隼人).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phước Điền", "definition": "Ruộng phước : nghĩa là ruộng sinh ra phước đức. Người Phật tử kính thờ, cúng dường Phật Pháp Tăng; kính trọng, hiếu thuận và phụng dưỡng cha mẹ; giúp đỡ, săn sóc những người bệnh tật nghèo khổ, đều có được phước đức; cho nên Tam Bảo, cha mẹ, người nghèo khổ bệnh tật, đều là Phước Điền của Phật tử.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phước Điền Bồ Tát", "definition": "Puṇyakṣetra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phước Điền Y", "definition": "Áo ruộng phước. Tức áo cà sa. Áo cà sa có nhiều miếng đâu lại, mới trông qua như những khoảng đất trong một khu ruộng, nên kêu là phước điền y. Vả lại, bực tu xuất gia mặc cà sa là bực đáng cúng dường, ai cúng dường cho nhà sư vận cà sa thì được nhiều phước đức, cho nên gọi áo ấy là phước điền y.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phước Đức", "definition": "Puṇya (S), Merit Puñña (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phước Đức Và Công Đức", "definition": "Merit and virtue.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phướn", "definition": "Paṭākā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phướng", "definition": "Pātākā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phường", "definition": "坊. Khu đất quy tụ những gia đình cùng làm một nghề. Chẳng hạn tác phẩm Nôm của Nguyễn Du có Thác lời trai phường nón (Phường nón là nơi quy tụ các gia đình sống bằng nghề làm nón) Chỉ một bọn, một loại người giống nhau. Đoạn trường tân thanh có câu: “Tình cờ chẳng hẹn mà nên, mạt cưa mướp đắng đôi bên một phường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phường Chủ", "definition": "Bōzu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phường Phố", "definition": "坊鋪. Nơi đông đúc, có nhiều cửa tiệm buôn bán. Thơ Tản Đà có câu: “Giấy người mực người thuê người in, mướn cửa hàng người bán phường phố” Cũng nói Phố phường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phường Thị", "definition": "坊市. Như Phường phố 坊鋪.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phưởng", "definition": "旊. Người thợ đồ gốm. Cũng gọi là Phưởng nhân 旊人.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phưởng Sa", "definition": "紡紗. Kéo sợi, kéo tơ Thứ lụa mỏng dệt bằng tơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phưởng Trù", "definition": "紡綢. Thứ vải dệt bằng sợi bông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phưởng Ty", "definition": "紡絲. Kéo tơ tằm, từ kén tằm trong nồi nước nóng ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phưởng Tích Cơ", "definition": "紡績機. Máy kéo bông sợi, cuốn sợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phưởng Xa", "definition": "紡車. Cái guồng quay tơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phược", "definition": "Xem Hệ Phược.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phược Mã Đáp", "definition": "Cũng gọi Thuận Hoàn Đáp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phược Nhật La Kiện Đà", "definition": "Xem Kim Cang Đồ Hương Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phược Thoát", "definition": "Trói buộc và giải thoát, hoặc giải thoát khỏi sự trói buộc của phiền não.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phượng", "definition": "鳳. Tên một loài chim đẹp, tức chim Phượng. Cũng đọc Phụng. Đoạn trường tân thanh có câu: “Nào người phượng chạ loan chung, nào người tích lục tham hồng là ai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Chiếu", "definition": "鳳詔. Tờ giấy vẽ hình chim phượng, chép lệnh của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Cầu", "definition": "鳳求. Do chữ Phượng cầu Hoàng, con chim Phượng tìm con chim Hoàng, tên một khúc đàn của Tư Mã Tương Như, danh cầm đời Hán. Chỉ sự kén vợ Tư Mã Tương Như đời Hán, gảy khúc đàn “Phượng cầu kì hoàng” để ve nàng Trác Văn Quân. Trác Văn Quân nghe tiếng đàn hay mà mê, rồi hai bên lấy nhau. “Khúc đâu Tư mã Phượng cầu” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Cử", "definition": "鳳舉. Chim phượng cất mình bay cao. Chỉ người bề tôi vâng mệnh vua đi sứ nơi xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Giá", "definition": "鳳駕. Xe vua đi, thường vẽ hình chim phượng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Hoàng", "definition": "鳳凰. Tên một loài chim quý, con trống là Phượng con mái là Hoàng. Ca dao có câu: “Cho hay tiên lại tìm tiên, phượng hoàng đâu chịu đứng bên đàn gà”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Kiều", "definition": "鳳翹. Vật cài đầu của đàn bà con gái thời xưa Như Phượng đầu hài 鳳頭鞋.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Kì", "definition": "鳳旗. Cờ thêu hình chim phượng. Cờ của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Liễn", "definition": "鳳輦. Kiệu, hoặc xe có hình chim phượng, của vua và hoàng gia. Đoạn trường tân thanh có câu: “Sẵn sàng phượng liễn loan nghi, hoa quan dấp dới hà y rõ ràng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Mao", "definition": "鳳毛. Lông chim phượng, là vật hiếm có, chỉ người tài giỏi. Cũng nói Phượng mao lân giác (lông chim phượng và sừng kì lân) Tống Hiếu võ Đế khen tài con của Tạ Phụng là Siêu Tông rằng: “Thật là lông của con phụng (phượng)”. “Rõ ràng lông phụng (phượng) gót lân” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Sát", "definition": "Chỉ cho chùa Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phượng Sồ", "definition": "鳳雛. Động minh kí: Đông Phương sóc tâu “Chúng tôi đi ngang qua rừng bắt được con phượng con 5 sắc” Con chim phượng còn non. Chỉ người trẻ tuổi tài cao Tên một nhân vật đời Tam Quốc, quân sư của Lưu Bị có tài nhưng chết sớm. “Phụng Sồ danh giá biết bao” (Hoa Điều Tranh năng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Thành", "definition": "鳳城. Thành có chim phượng đậu, chỉ kinh đô, nơi vua ở. Truyện Hoa Tiên có câu: “Cảnh kia thêm bận lòng này, phượng thành sáng mở nào hay đã gần” Công Chúa Lộng Ngọc ngồi trên thành thổi ống địch, Phụng liền bay xuống nên đặt tên là Phụng hoàng thành. Đỗ Phủ: Ngân hán diêu ưng tiếp Phụng thành (Sông ngân xa tiếp Phụng thành). “Phụng thành cảnh sắc xinh sao” (Thơ cổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Tiên", "definition": "鳳仙. Tên một loài cây, nở hoa về mùa hè, màu đỏ và trắng đẹp mắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Vĩ", "definition": "鳳尾. Tên một thứ cỏ, lá mọc thành chùm, cong xoè như đuôi chim phượng Ta lại hiểu là tên thứ cây lớn, nở hoa đỏ vào mùa hè.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Đàm", "definition": "(1654-1738). Cũng gọi Phương Đàm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phượng Đàn", "definition": "鳳壇. Chỗ chim phượng đậu. Chỉ nơi triều đình, chỗ các quan đứng. Bài Tụng Tây Hồ Phú của Nguyễn Huy Lượng có câu: “Trước phượng đàn đứng sánh hàng loan, trông hồ cảnh tiến một chương li ngữ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Đầu Hài", "definition": "鳳頭鞋. Giầy đàn bà đi thời xưa, mũi giầy cong lên, thêu hình chim phượng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phượng Đức", "definition": "鳳徳. Nết tốt, cao đẹp, vì chim phượng được coi là loài linh điểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạ", "definition": "怕. Sợ hãi Một âm là Phách. Xem Phách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạ Ca", "definition": "Phạm: Vàkya. Cũng gọi Bạc ca.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Dã Phệ", "definition": "Phạm: Vàyave.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Nhật La", "definition": "Phạm: Vajra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Nhật La Mẫu Già Tam Muội Da Tát Đát Phạ", "definition": "Xem Đại An Lạc Bất Không Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạ Sai Ni Mã Lạp Cách", "definition": "Phạ Sai Ni Mã Lạp Cách (?-?).Tạng: Pa-tshabĩi-ma-grags.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Sô Hà", "definition": "Phạm: Vakwu hoặc Vaíkwu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Tháp Kháp Lí Á", "definition": "Vidhushekhara Bhatacharya (1878-1959). Học giả Phật Giáo Ấn Độ, người huyện Mã Nhĩ Đạt Hách thuộc bang Bengal.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Tát Đát La", "definition": "Phạm: Vastra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Tư Tiên", "definition": "Phạ tư, Phạm: Vasiwỉha. Pàli: Vaseỉỉha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạ Để", "definition": "Phạm: Patnì. Cũng gọi Ba Đế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm", "definition": "犯. Lấn vào. Đụng chạm vào. Làm tổn hại tới. Td: Xâm phạm, phạm thượng… Kẻ gây tội. Td: Tội phạm, Thủ phạm, ….", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Bái", "definition": "Bhāṣā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Bản", "definition": "Cũng gọi Phạm Giáp, Phạm Kinh, Phạm Điển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Bổn", "definition": "Kinh sách Phật chép bằng chữ Phạn (Sanskrit), khác với các Kinh Phật chép bằng chữ Pali (Kinh Pali) hay Kinh tạng Pali, được lưu hành ở các nước thuộc Phật giáo Nam tông. Còn Kinh Sanskrit thì trong một thời gian, lưu hành ở Bắc và Đông Ấn Độ, sau đó được dịch ra chữ Hán và chữ Tây Tạng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phạm Ca Da Thiên", "definition": "Brahma-kayika-deva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Ca Di Thiên", "definition": "Phạm: Brahma-kàyika-deva.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Chung", "definition": "Cũng gọi Đại Chung, Điếu Chung, Chàng Chung, Hồng Chung, Kình Chung.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Chí", "definition": "Người bà-la-môn Ấn-độ có chí cầu pháp Phạm Thiên, gọi là “phạm chí”. Phạm thiên nghĩa là tịnh, lấy tịnh hạnh lập chí, cho nên gọi là “phạm chí”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phạm Chí A Bạt Kinh", "definition": "Cũng gọi Phật Khai Giải Phạm Chí A Bạt Kinh, A Bạt Ma Nạp Kinh, A Bạt Kinh. Phật Văn Phạm Chí A Bạt Kinh, Giải Phạm Chí A Bạt Kinh, Phật Khai Giải A Bạt Phạm Chí Kinh. Kinh, 1 quyển, do cư sĩ Chi Khiêm dịch vào khoảng năm Hoàng Vũ thứ 2 đến năm Kiến Hưng thứ 2 (223-253) đời Ngô, thời Tam Quốc, được thu vào Đại Chính Tạng tập 1.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Chí Át Ba La Diên Vấn Chủng Tôn Kinh", "definition": "Cũng gọi Phạm Chí Át La Diên Vấn Chủng Tôn Kinh, Phạm Chí Vấn Chủng Tôn Kinh. Kinh, 1 quyển, do ngài Trúc Đàm Vô Lan dịch vào khoảng Năm Thái Nguyên thứ 6 đến Năm Thái Nguyên 20 (381-395) đời Đông Tấn, được thu vào Đại Chính Tạng tập 1.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Chúng", "definition": "Đồ chúng tu trì Phạm hạnh, Tịnh hạnh. Tức là hàng Tăng lữ vậy. Tiếng gọi chung một số nhiều vị sư đạo Bà La Môn hoặc đạo Phật cùng ở chung trong một tu viện mà thọ trì Tịnh hạnh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phạm Chúng Thiên", "definition": "Brahma-parisadya-deva (S), Brahmaparisajjadeva (P), Brahmapa-risadya (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Cung", "definition": "Vốn chỉ cho cung điện của Phạm Thiên, sau được dùng làm tên gọi chung các chùa viện Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Cấm", "definition": "犯禁. Lấn vào lệnh ngăn cản, có lệnh cấm mà vẫn cứ làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Cổ Nông", "definition": "(1881-1952): hiệu là Kí Đông, biệt hiệu là Huyễn Am, bút hiệu là Hải Thi đạo nhân, quê huyện Gia-hưng, tỉnh Triết-giang, Trung-quốc. Thuở nhỏ ông từng du học ở Nhật, sau khi về nước, đem hết tâm lực hoằng dương Phật pháp. Năm 1931, ông được cử làm tổng biên tập cho Phật Học Thư Cục ở Thượng-hải, viết Hải Triều Âm Văn Khố, Phật Học Bách Khoa Tòng Thư, cùng phát hành Kinh Tạng bản đời Tống, chỉnh lí nền văn hiến Phật giáo. Năm 1935, ông làm chủ bút Nhật Báo Phật Giáo. Năm 1951, ông làm hội trưởng hội Cư Sĩ Lâm của Phật giáo thế giới. Trước tác của ông có Huyễn Am Văn Tập, Cổ Nông Phật Học Vấn Đáp, và Phát Thú Luận (dịch).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phạm Diễn Na Quốc", "definition": "Tên 1 vương quốc xưa trong dãy núi Hindu Kush, nay thuộc lãnh thổ nước Afghanistan. Phạm Diễn Na, tên tiếng Phạm là Bàmiyan, cũng gọi Phạm Dương, Vọng Diễn, Phàm Diễn, hiện nay thường gọi là Ba Mễ An (Bamian), Ba Mễ Ương, Ba Mễ Dương. Nước này chính là con đường giao thông từ nước Kiện Đà La đến các nước Đổ Hóa La, Du Na..., Đại đô thành nước này nằm dựa vào sườn núi, sản xuất lúa mì, chăn nuôi gia súc, khí hậu rất lạnh, phong tục cứng cỏi.Vào thời các vua Tùy Dượng Đế và Đường Thái Tông, nước này từng đến triều cống Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Dạ", "definition": "犯夜. Không tuân lệnh cấm di chuyển ban đêm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Giáp", "definition": "Cũng gọi Kinh Pháp.Chỉ cho bản kinh viết bằng tiếng Phạm trên lá bối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Giới", "definition": "Xem Phạm Thiên Giới. Xem Phá Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Giới Ngũ Suy", "definition": "犯戒五衰 (Thích Thị Yếu Lãm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phạm Giới Năm Điều Suy", "definition": "Người phạm giới gặp năm điều suy:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phạm Hoàng", "definition": "Từ tôn xưng Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Huý", "definition": "犯諱. Không tránh tên của người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Hạnh", "definition": "Là một trong năm hạnh của hàng Bồ-tát. “Phạm” là trong sạch. Các vị Bồ-tát không vướng mắc vào hai cực đoan có và không, gọi là trong sạch; đem sự trong sạch ấy mà vận dụng tâm từ bi để cho vui và vớt khổ cho chúng sinh, gọi là “phạm hạnh”. Là hạnh trong sạch. Vì Phạm Thiên đoạn trừ dâm dục, cho nên sự xa lìa dâm dục được gọi là “phạm hạnh”. Cuộc đời một người Bà-la-môn được chia làm bốn thời kì, thời kì đầu tiên gọi là “thời kì phạm hạnh”; đó là thời kì mà trong sinh hoạt hằng ngày phải giữ giới bất dâm và chuyên học các kinh điển Phệ Đà và lễ nghi tế tự. Trong Phật giáo, các hành giả tu tập phải giữ không những giới bất dâm mà còn bao nhiêu giới luật khác nữa, cho nên gọi là “phạm hạnh”. – Hàng cư sĩ tại gia không giữ giới bất dâm (mà chỉ là bất tà dâm) thì không được gọi là phạm hạnh; nhưng nếu họ cũng hành trì hạnh không dâm dục như tăng sĩ thì vẫn được gọi là phạm hạnh. – Nói rộng ra, các hành giả tu thiền, đạt được đầy đủ tám bước giải thoát (bát giải thoát); tu tập thuần thục tám sự hành trì chân chánh (bát chánh đạo); tu tập trọn vẹn bốn tấm lòng rộng lớn (tứ vô lượng tâm); biết rõ bảy pháp lành (thất thiện pháp); v.v..., đều gọi là “phạm hạnh”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phạm Hạnh Kỳ", "definition": "Xem Phạm Chí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Học Tân Lương", "definition": "Tác phẩm, khoảng 1.000 quyển, do Tôn Giả Ẩm Quang Từ Vân người Nhật Bản biên soạn và theo sự suy đoán của các học giả cận đại thì sách được hoàn thành vào năm Minh Hòa thứ 3 (1766).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Khiếp Ấn", "definition": "Chỉ cho ấn thứ 8 trong “Tùy cầu bát ấn” của Bồ Tát Đại tùy cầu thuộc Mật Giáo, tức là Nhất Thiết Như Lai Tùy Tâm Chân Ngôn Ấn. Ấn tướng là: Năm ngón của 2 tay mở ra, tay trái ngửa lên, đặt ở trước ngực; tay phải úp lên tay trái, 2 tay hợp 1, bàn tay hơi co.Ngoài ra, Bồ Tát Bát Nhã và Bồ Tát Văn Thù cũng kết thủ ấn này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Kinh", "definition": "Phạm: Brahma-sùtra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Kì", "definition": "Phạm Kì (1296-1370).Thiền Sư Trung Quốc sống vào đời Nguyên, người Tượng Sơn, Minh Châu (Chiết Giang), họ Chu, tự Sở Thạch, tiểu tự Đàm Diệu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Kỳ", "definition": "梵 琦 (1296-1370). Thiền tăng đời Nguyên, họ Chu, tự Sở Thạch, về già hiệu là Tây Trai lão nhân, người xứ Tượng Sơn, Chiết Giang, Trung Quốc. Nối pháp Thiền Sư Hạnh Đoan, đời thứ 24 hệ Nam Nhạc. Trụ trì các chùa Phúc Trăng ở Hải Diêm, Thiên Ninh ở Dương Châu, Báo Quốc ở Bắc Kinh, Bản Giác ở Kiết An. Tác phẩm: Sở Thạch Phạm Kỳ Thiền Sư Ngữ Lục, Tây Trai Tịnh Độ Thi.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phạm Luân", "definition": "Brahmacakra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Luật", "definition": "Padussana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phạm Lịch", "definition": "Lịch pháp của Ấn Độ. Phạm vốn không có nghĩa là Ấn Độ, nhưng các nhà Phật học Trung Quốc cho rằng Tất Đàm là văn tự Ấn Độ, do Phạm Thiên tạo ra, cho nên gọi là Phạm Tự, vì thế “Phạm” trở thành Đại danh tự chỉ cho Ấn Độ. Còn từ Phạm lịch là chỉ chung cho lịch pháp của Ấn Độ, đã được sử dụng từ bao giờ thì không rõ. [X. Phật Giáo Đại Học học báo 27]. (xt.Phật Quốc Lịch Tượng Biên, Phật Giáo Lịch Pháp).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Lỗi", "definition": "Apakaroti (apa + kass + a), dussati (duss + ya), dussana (trung), padussati (pa + dus + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phạm Ma", "definition": "Từ gọi chung cho Phạm và Ma. Phạm là Phạm Vương, đứng đầu cõi trời Sơ Thiền, Đại Biểu cho các vị trời ở cõi Sắc. Còn Ma là Tha Hóa Tự Tại Thiên, đứng đầu tầng trời thứ 6 của cõi Dục, Đại Biểu cho các vị trời ở cõi Dục. [X. Phẩm Tựa Kinh Pháp Hoa]. (xt. Đại Phạm Thiên, Tha Hóa Tự Tại Thiên).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ma Du Kinh", "definition": "Cũng gọi Phạm Ma Dụ Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ma Nan Quốc Vương Kinh", "definition": "Cũng gọi Phạm Ma Nan Vương Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ma Ni", "definition": "Phạm: Brahma-maị", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ma Tam Bát La", "definition": "Một trong 28 bộ chúng. Mặt của vị này như thiên nữ, đầu đội mũ trời, tay trái úp vào cạnh rốn, tay phải cầm phất trần trắng để ở ngang ngực, đeo chuỗi anh lạc như người trời.(xt. Nhị Thập Bát Bộ Chúng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ma Việt", "definition": "Tsang Denma (T), Brahmavati (S), Youthful-looking One Tsang Denma (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Ngã Nhất Như", "definition": "Phạm: Brahma-àtma-aikyam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ngư Tự", "definition": "Chùa nằm ở đặc khu Đông Lai, núi Phũ Sơn, thuộc tỉnh Khánh Thượng Nam tại Hàn Quốc, do ngài Nghĩa Tương, Sơ Tổ Hoa Nghiêm giáo ở Hải Đông, sáng lập vào năm Vũ Liệt thứ 2 (655) đời vua Thái Tông nước Tân La, là 1 trong 31 bản sơn của Phật Giáo Hàn Quốc, sơn hiệu là Kim Tỉnh Sơn.Niên hiệu Văn Lộc năm đầu (1592) chùa bị thiêu hủy trong chiến tranh xâm lược của quân Nhật. Năm Quang hải quân thứ 5 (1613), chùa được xây dựng lại.Trong chùa hiện có tòa Đại Hùng Bảo Điện rất nguy nga hoành tráng và khá nhiều lầu gác, là 1 trong những ngôi chùa nổi tiếng hiện nay của Hàn Quốc. Chùa này có 33 chùa phụ thuộc. [X. Triều Tiên Phật Giáo Thông Sử; Triều Tiên tự sát tam thập nhất bản sơn tả chân thiếp].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ngữ", "definition": "Sanskrit.Cũng gọi Thiên Trúc Ngữ.Văn tự tiêu chuẩn của Ấn Độ cổ đại, thuộc ngữ hệ Ấn Âu. Các sách như: Phệ Đà, Phạm Thư, Sâm Lâm Thư, Áo Nghĩa Thư và kinh điển của Phật Giáo Bắc Truyền đều được viết bằng ngữ văn này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ngữ Thiên Tự Văn", "definition": "Cũng gọi Đường Tự Thiên Man Thánh Ngữ, Phạm Đường Thiên Tự Văn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Ngữ Tạp Danh", "definition": "Cũng gọi Tất Đàm Tự Dẫn. Tác phẩm, 1 quyển, do ngài Lễ Ngôn soạn vào đời Đường, được thu vào Đại Chính Tạng tập 54.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Nhân", "definition": "犯人. Người làm tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Nhân Miêu Giá", "definition": "犯 人 苗 稼. Người chăn trâu nếu buông lơi dây vàm, liền biết ấy là xâm phạm hoa màu của người khác; ý nói người tu hành nếu lười biếng và dao động liền biết ấy là mình phát sinh vọng niệm tục tình. Tiết Trung Phong Hòa Thượng hành lục trong TPQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phạm Nạn", "definition": "Chướng nạn của người tu hạnh thanh tịnh, là 1 trong 2 thứ nạn của Tỉ Khưu. Khi Tỉ Khưu tu phạm hạnh, bị tình cảm của vợ con người thế tục quấy nhiễu, hoặc bị dâm nữ cám dỗ... đều là chướng nạn của hạnh thanh tịnh cho nên gọi là Phạm nạn. [X. Tứ Phần Luật San Phồn Bổ Khuyết Hành Sự Sao Q.thượng, phần 4].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Pháp", "definition": "犯法. Không tuân theo luật lệ quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Phúc", "definition": "Phạm: Bràhma-puịyatva.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Phước", "definition": "Brahma-puṇyatva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Phạt", "definition": "I.Phạm Phạt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Phụ Thiên", "definition": "Brahmaparohita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Phục", "definition": "Áo mặc của Phạm Thiên, hoặc áo mặc của người phạm hạnh (tức ca sa). Các vị trời cõi Sắc đều mặc áo này. [X. Pháp Uyển Châu Lâm Q.35]. (xt. CaSa).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Quốc", "definition": "Brahmakṣetra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Sát", "definition": "Brahma-ksha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Sư Bồ Tát", "definition": "Xem Tối Thánh Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thiên", "definition": "Brahmadeva (S), Brahmā (S), Creator of the world, Sahampati (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thiên Cõi", "definition": "World of Brahma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thiên Giới", "definition": "Brahmaloka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thiên Hậu", "definition": "Brahmi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thiên Hỏa La Cửu Diêu", "definition": "Phạm: Brahma-horanavagraha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thiên Ngoại Đạo", "definition": "Ngoại đạo tôn thờ Phạm Thiên vương như là chủ tể, sáng tạo ra muôn loài, muôn vật. Còn đạo Phật chỉ xem Phạm thiên vương như một loài Trời cao cấp mà thôi. Phạm thiên vương cũng ở trong vòng sinh tử luân hồi, có sinh và già chết. Tuy nhiên, đạo Phật thừa nhận Phạm thiên vương cũng như các chúng sinh ở các cõi Trời Phạm thiên có thọ mạng hết sức lâu dài.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phạm Thiên Nữ", "definition": "Phạm: Brahmì. Hán âm: Một La Ca Nhị, Mạt La Hi Nhị, Mạt La Nhị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thiên Pháp", "definition": "Phương pháp trị phạt được thi hành bởi Phạm Thiên. Tức lập 1 cái đàn riêng để giữ kẻ phạm pháp, các Phạm chúng khác không được tiếp xúc, giao du với phạm nhân. [X. Duy Ma Kinh Lược Sớ Q.1]. (xt. Phạm Đàn).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thiên Trạch Địa Pháp", "definition": "Cũng gọi Phạm Thiên Trạch Địa Kinh. Tác phẩm, 1 quyển, không rõ tác giả, được thu vào Đại Chính Tạng tập 18.Sách này y cứ vào nội dung của Kinh Đại Phạm Thiên Vương Nội Bí Mật mà trình bày sơ lược về việc Đức Như Lai từng là 1 vị tiên nhân trì chú trong năm trăm vạn năm ở đời quá khứ, Ngài thường đi đến các ngọn núi, ở ẩn trong tịnh thất. Khi du hành, Ngài thấy 42 địa tướng có lợi cho việc thành tựu các pháp và cách chọn đất theo 42 địa tướng ấy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thiên Tự", "definition": "梵 天 寺. Dưới ngọn Chủ Phong, núi Đại Luân, phía đông bắc huyện Đồng An, tỉnh Phúc Kiến, Trung Quốc. Xây vào đời Tùy, ban đầu gọi “Hưng Quốc Tự”, là thập phương tùng lâm có 72 am sở. Nhiều đời có cao tăng thay nhau trụ trì như Thiền Sư Chân Như Triết v. v… Hoàng Bá Hy Vận cũng từng ngộ đạo nơi này.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phạm Thiên Vương", "definition": "Brahma-king.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thân", "definition": "Brahmakāya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thân Thiên", "definition": "Xem Phạm Thân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thích", "definition": "S. Brahma Indra. Phạm Thiên vương, vua cõi Trời Phạm thiên và Đế Thích (Indra) vua cõi Trời Đao Lợi.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phạm Thích Tứ Vương", "definition": "Cũng gọi Phạm Thích Tứ Thiên.Từ ngữ gọi chung Phạm Thiên, Đế Thích Thiên và Tứ Thiên Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thư", "definition": "Brāhmaṇa veda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thư được viết theo hình thức văn xuôi, trong sách sử dụng rất nhiều thần thoại và truyền thuyết. Về niên đại thành lập Phạm Thư thì ước chừng vào khoảng1.000 đến 600 năm trước Tây lịch, tức là khoảng thời gian mà trung tâm văn hóa của người Aryans từ lưu vực sông Ấn Độ dời về phía đông đến đồng bằng sông Hằng. Đây là sản Phẩm của thời kì mà hệ thống nghi thức cúng tế phức tạp của Phệ Đà được chỉnh lí hoàn bị. Phạm Thư có thể là sách về thần học, nhưng đồng thời cũng là tư liệu quí giá để tìm hiểu các vấn đề của xã hội Ấn Độ đương thời như: Chế độ Chủng Tính, chủ nghĩa Bà La Môn chí thượng, sự biến đổi thần thoại, tập đại thành tư tưởng Triết học, Nhất nguyên manh nha trong Áo Nghĩa Thư... Nhưng rất tiếc là những vấn đề ấy chỉ được ghi chép 1 cách vụn vặtcó giới hạn mà thôi.Hiện nay còn 50 bộ, trong đó, chủ yếu là Ái Đạt La Thị Phạm Thư (41 chương) phụ thuộc Lê Câu Phệ Đà và Bách Đạo Phạm Thư (100 chương) phụ thuộc Dạ Nhu Phệ Đà. (xt. Phệ Đà).", "definition": "II.Phạm Thư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thượng", "definition": "犯上. Đụng chạm với người trên, không kính nể người trên..", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Thất", "definition": "Phòng ốc trong chùa viện, là nhà ở của những người tu Phạm Hạnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Thế", "definition": "Xem Phạm Thiên Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thế Giới", "definition": "Brahma-loka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thụ Thiên", "definition": "Brahmapurohitadeva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thụ Vương", "definition": "Brahma-datta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Thừa", "definition": "Thừa thanh tịnh. Chỉ cho Bồ Tát thừa, vì Bồ Tát lấy sự thanh tịnh làm căn bản và tu hạnh từ, bi, hỉ, xả nên gọi là Phạm thừa, là 1 trong 5 thừa (Thiên Thừa, Phạm thừa, Thanh Văn Thừa, Duyên Giác Thừa, Chư Phật Như Lai Thừa) theo Kinh Lăng Già A Bạt Đa La Bảo quyển 2; là 1 trong 3 thừa (Thiên Thừa, Phạm Thừa, Thánh Thừa) theo Kinh Đại Bảo Tích quyển 94.(xt. Thừa).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Tiên", "definition": "Phạm Tiên (1292-1348).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Trù", "definition": "Hara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Trú", "definition": "Brahmavihāra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Trăn", "definition": "Phạm Trăn (?-?).Cao tăng Trung Quốc sống vào đời Tống, người Tiền Đường, vốn tên là Hữu Trăn, hiệu Nam Bình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Trọng", "definition": "Phạm trọng tội.Tức là vi phạm 4 tội nặng của giới Tiểu Thừa, hoặc 10 tội nặng của giới Đại Thừa. Bốn tội nặng là: Dâm dục, trộm cướp, giết hại và nói dối.Mười tội nặng là: Giết hại, trộm cướp, dâm dục, nói dối, bán rượu, nói lỗi của 4 chúng, khen mình chê người, bỏn sẻn hủy nhục, lòng tức giận không chịu ăn năn, hủy báng Tam Bảo. (xt. Thập Trọng Cấm Giới, Tứ Ba La Di).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Trọng Tội", "definition": "Kibbisakārī (3)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phạm Trọng Yêm", "definition": "Phạm Trọng Yêm (989-1052).Cư Sĩ Phật Giáo Trung Quốc sống vào đời Tống, người đất Ngô, tự là Hi Văn. Năm lên 2 tuổi, ông mồ côi cha, nhà nghèo, mẹ tái giá. Khi vừa lớn khôn, ông cảm thấy khổ tâm, khóc lóc từ giã mẹ, đến ở nhờ nhà tăng trong làng, gắng sức học hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Trụ Thiên", "definition": "Heaven of Pure Abode.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Tán", "definition": "Phạm: Stotra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Tâm", "definition": "Chỉ cho tâm tu phạm hạnh. Phạm Hạnh nghĩa là hành vi thanh tịnh, tức người xuất gia hay tại gia tu tập 4 phạm hạnh hoặc tu thiền định, xả bỏ dâm dục, giữ thân tâm trong sạch, được sinh về cõi Sắc và cõi Vô Sắc. [X. Kinh Quán Sát Chư Pháp Hành Q.1; Ma Ha Chỉ Quán Q.1]. (xt. Phạm Hạnh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Tông", "definition": "笵 宗. Thiền tăng cuối đời Nam Tống, hiệu Suất Am, nối pháp Thiền Sư Phật Chiếu Quang ở núi Linh ẩn. Sư làm thơ hay, viết văn giỏi nên rất nổi tiếng. Vào niên hiệu Hàm Thuần thứ 10 (1274), sư nhậm chức trụ trì Thiền viện Chân Như trên núi Vân Cư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phạm Tăng", "definition": "Từ “Phạm Tăng” được dùng để chỉ chung cho chư tăng từ Ấn-độ và các nước vùng Tây-vực (Trung-Á) từng tới Trung-quốc truyền giáo.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phạm Tướng", "definition": "Brahma Appearance", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phạm Tẩu", "definition": "Chỉ cho vợ của 1 vị tăng. Đây là từ ngữ có tính cách châm biếm, mỉa mai.Bởi vì người xuất gia tu đạo là phải giữ gìn giới hạnh thanh tịnh, không được lấy vợ, không được dâm dục, gọi là Phạm Tăng (tăng trong sạch). Nếu tăng lấy vợ là tăng đã phá giới cấm của Phật, nên vợ của vị tăng ấy được gọi 1 cách châm biếm là Phạm Tẩu, còn chính vị tăng có vợ thì được gọi là “Hỏa Trạch Tăng” (tăng ở trong nhà lửa), có ý vị châm biếm và mỉa mai hơn cả từ “Phạm tẩu”!", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Tịch", "definition": "(梵席): chỗ ngồi trong các tự viện, đặc biệt thường dùng để chỉ chỗ ngồi để thuyết giảng, tụng kinh, làm các Phật sự; đôi khi đồng nghĩa với pháp tịch (法席). Như trong Pháp Hoa Linh Nghiệm Truyện (法華靈驗傳) quyển hạ có câu: “Kim hạnh kiệt thành Trương Hoàng phạm tịch, dục vấn nhất nhị đại chỉ, nhiên thủ hộ thần tương ha cấm bất nhập, bằng hoàng môn ngoại sổ nhật hỉ (今幸竭誠張皇梵席、欲問一二大旨、然守護神將呵禁不入、彷徨門外數日矣, nay đã kiệt sức, may gặp pháp hội của Trương Hoàng, muốn hỏi một hai yếu chỉ quan trọng, nhưng thần thủ hộ khiển trách, cấm không cho vào, tôi bàng hoàng ở ngoài cửa mấy ngày vậy).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phạm Tội", "definition": "犯罪. Làm điều lầm lỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Tự", "definition": "Văn tự do Phạm Thiên chế ra, thông dụng ở Ấn Độ cổ đại, cũng tức là văn tự Tất Đàm được phát triển từ tự mẫu Phạm Thư (Bràhmì) mà thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Vi", "definition": "範圍. Giới hạn không thể vượt ra, giống như cái khuôn vây quanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm Võng Bồ Tát", "definition": "Brahmajala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Võng Giới", "definition": "Tức giới luật của hàng Bồ-tát, được ghi chép trong kinh Phạm Võng, gồm có 10 giới trọng và 48 giới khinh, cả hai chúng xuất gia và tại gia đều có thể thọ trì.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phạm Võng Giới Bổn", "definition": "Phần nói về giới luật là đoạn sau cùng của cuốn Kinh Phạm Võng. Cg, Bồ Tát giới Kinh. Kinh tạng Pali cũng có Kinh Phạm Võng (Trường Bộ Kinh I), nhưng không nói về giới luật mà nói về hơn 60 tà kiến chấp ngã của ngoại đạo.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phạm Võng Giới Phẩm", "definition": "Gọi đủ: Phạm Võng Kinh Lô Xá Na Phật Thuyết Bồ Tát Tâm Địa Giới Phẩm Đệ Thập. Tên gọi khác của Kinh Phạm Võng. Kinh Phạm Võng hiện nay chỉ là 1 tác phẩm nói về giai vị, giới luật của Bồ Tát trong Kinh Phạm Võng (quảng bản), vì thế gọi là Phạm Võng giới Phẩm. (xt. Phạm Võng Kinh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Hội", "definition": "Tiếng dùng của Phật Giáo Nhật Bản. Pháp Hội chuyên giảng diễn và đọc tụng Kinh Phạm Võng để cầu siêu cho vong linh người chết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Kinh", "definition": "Brahmajāla Sūtra (S), Brahma Net Sutra.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Võng Kinh Bồ Tát Giới Bản Sớ", "definition": "Cũng gọi Phạm Võng Giới Bản Sớ, Phạm Võng Giới Sớ, Phạm Võng Pháp Tạng Sớ. Kinh sớ, 6 quyển, hoặc 3 quyển, do ngài Hiền Thủ Pháp Tạng soạn vào đời Đường, được thu vào Đại Chính Tạng tập 40.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Kinh Cổ Tích Kí", "definition": "Cũng gọi Phạm Võng Cổ Tích Kí, Phạm Võng Kinh Cổ Tích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Kinh Hợp Chú", "definition": "Cũng gọi Phạm Võng Kinh Tâm Địa Phẩm Hợp Chú, Phạm Võng Hợp Chú.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Kinh Lư Xá Na Phật Thuyết Bồ Tát Tâm Địa Giới Phẩm Đệ Thập", "definition": "Xem Kinh Phạm Võng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Võng Lục Thập Nhị Kiến Kinh", "definition": "Cũng gọi Phạm Võng Kinh, Lục Thập Nhị Kiến Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Sám Pháp", "definition": "Cũng gọi Phạm Võng Kinh Sám Hối Hành Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Võng Tam Trùng Bản Mạt", "definition": "Cũng gọi Tam Trùng Bản Mạt, Tam Trùng Bản Mạt Thành Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Văn Lan", "definition": "笵 文 瀾 (1893-1969). Học giả Phật giáo hiện đại, nhà sử học Trung Quốc. Tuổi trẻ khi học ở Đại học Bắc Kinh, ông đã nghiên cứu Phật học. Sau khi tốt nghiệp, lần lượt dạy học ở Đại học Nam Khai, Đại học Bắc Kinh, Đại học Sư phạm Bắc Kinh, Đại học Trung Quốc, Đại học Hà Nam. Và nhậm chức Khoa trưởng phân khoa(Nữ) Lý Luận Văn Học thuộc Đại học Bắc Bình. Tháng 2 năm 1940 đến Diên An, ông lần lượt giữ chức Phó Viện trưởng Trung Anh Nghiên cứu Viện kiêm Chủ nhiệm Phòng nghiên cứu lịch sử, Hiệu trưởng trường Đại học Bắc Phương, Hiệu phó trường Đại học Hoa Bắc. Sau giải phóng (1-10-1949), ông giữ chức Giám đốc Sở nghiên cứu lịch sử cận đại thuộc Viện Khoa học Trung Quốc. Tác phẩm: Trung Quốc Thông Sử Giản Biên, Thiền Tông Quát Hiệp Trung Quốc Sĩ Đại Phu Khẩu Vị Đích Phật Giáo, được xếp vào Đường Đại Phật Giáo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phạm Vũ", "definition": "(梵宇): hay Phạm cung (梵宮), Phạm sát (梵刹), nghĩa là chùa, tự viện Phật Giáo. Phạm hay Phạn (s: brahman, 梵) nghĩa là tịch tĩnh, thanh tịnh, ly dục; cho nên nơi tịch tĩnh dành cho các vị xuất gia tu hành thanh tịnh, ly dục, được gọi là Phạm vũ, Phạm cung hay Phạm sát. Tống Chi Vấn (宋之問, khoảng 656-712) nhà Đường có làm bài Đăng Thiền Định Tự Các (登禪定寺閣, có tên khác là Đăng Tổng Trì Tự Các [登總持寺閣]) rằng: “Phạm vũ xuất tam thiên, đăng lâm vọng bát xuyên, khai khâm tọa tiêu hán, huy thủ phất vân yên, hàm cốc thanh sơn ngoại, hỗn trì lạc nhật biên, đông kinh dương liễu mạch, thiếu biệt dĩ kinh niên (梵宇出三天、登臨望八川、開襟坐霄漢、揮手拂雲煙、函谷青山外、昆池落日邊、東京楊柳陌、少別已經年, chùa cổ vút trời xanh, lên lầu ngắm núi sông, vén áo ngồi trời rộng, khua tay vẫy mây vờn, khe thẳm núi xanh vắng, hồ trăng trời lặn buông, kinh đô dương liễu rũ, xa cách đã mấy năm).” Hay như trong Pháp Bảo Đàn Kinh (法寳壇經), Phẩm Cơ Duyên (機緣品) có đoạn: “Thời Bảo Lâm Cổ Tự, tự tùy mạt binh hỏa, dĩ phế, toại ư cố cơ trùng kiến Phạm vũ (時寶林古寺、自隋末兵火、已廢、遂於故基重建梵宇, ngôi chùa cổ Bảo Lâm đương thời, bị nạn binh hỏa cháy rụi từ cuối thời nhà Tùy, nay đã hoang phế, bèn trùng kiến ngôi chùa mới trên nền cũ).” Trong bài Vịnh Hà Trung Tự Thi (詠河中寺詩) của cuốn Hải Ngoại Kỷ Sự (海外紀事) do Tổ Thạch Liêm (石濂, 1633-1702, tức Thích Đại Sán [釋大汕]) sáng tác lại có đoạn: “Lục liễu thùy thùy ẩn Phạm cung, chung thanh điều đệ mãn hà phong (綠柳垂垂隱梵宮、鐘聲迢遞滿河風, nép bóng chùa xưa liễu xanh non, tiếng chuông xa vẳng theo gió sông)”; hay tả cảnh Chùa Linh Mụ (靈姥寺) ở cố đô Huế như “Phạm vương cung khuyết Nguyễn vương khai, ngọc điện châu môn sanh lục đài (梵王宮闕阮王開、玉殿朱門生綠苔, chùa xưa cung gác chúa Nguyễn khai, điện ngọc lầu son phủ rêu dài)”. Ngay tại cổng sơn môn của Đài Đồng Tự (壹同寺), Phố Tân Trúc (新竹市), Đài Loan (臺灣) có hai câu đối như sau: “Sơn khai giác lộ liên hoa xán, môn ánh kinh lâu Phạm vũ tân (山開覺路蓮花燦、門映經樓梵宇新, núi khai nẻo giác hoa sen rực, cửa rạng lầu kinh mới cảnh chùa).” Trong Tây Sương Ký (西廂記) cũng có câu rằng: “Sinh rằng quán khách lạ lùng, trộm nghe đây lối Phạm cung cảnh mầu.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phạm Vương", "definition": "Brahma Sahampati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm có nghĩa là thanh tịnh, làm những việc thanh tịnh, đặc biệt là việc dứt tâm dâm dục, gọi là Phạm Hạnh; người hành dâm dục gọi là Phi Phạm Hạnh. Mười giới thanh tịnh, gọi là Phạm Tịnh Thập Giới.Âm thanh mầu nhiệm của Phật, Bồ Tát, gọi là Phạm Âm Thanh, Phạm Thanh, Phạm Âm; tiếng vang của Phạm Âm gọi là Phạm Hưởng. Tướng Phạm Âm là 1 trong 32 tướng của Đức Phật. Pháp Thân Thanh Tịnh của Phật gọi là Phạm Thân. Phật đường già lam gọi là Phạm Sát, Phạm Vũ, Phạm Các; quả chuông treo của chùa viện gọi là Phạm Chung. Phật học cũng gọi Phạm Học, Ấn Độ cũng gọi là Phạm Độ. Phạm Hạnh Tiên Sinh là danh xưng khác của vị tăng; Phạm Nghi chỉ cho uy nghi của chư tăng.", "definition": "III.Phạm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Âm", "definition": "Brahmaghoṣa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Âm Phật", "definition": "Brahmaghoṣa-Buddha (S), Pure Sound Buddha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Âm Tướng", "definition": "Brahma-svara (S), Brahmassara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Điển", "definition": "Từ ngữ chỉ chung cho các kinh điển của Phật Giáo. Bởi vì những kinh điển của Phật Giáo truyền đến Trung Quốc từ Phạm Độ (Ấn Độ), cho nên gọi là Phạm Điển. Ngoài ra, những sách vở được viết bằng tiếng Phạm cũng gọi là Phạm Điển. (xt. Phạm Bản).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Đàn", "definition": "Brahmadaṇḍa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạm Đàn Chỉ Đa Na Lâm", "definition": "Chỉ cho khu rừng trong đó có các vị tiên và Phạm Chí ở ẩn. Khu rừng này thường phát ra mùi thơm ngào ngạt. [X. Luận Thích Ma Ha Diễn Q.5].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Đường", "definition": "(梵堂): nhà thờ Phật, tên gọi khác của tự viện Phật Giáo. Như trong bài Phụng Hòa Cửu Nguyệt Cửu Nhật Đăng Từ Ân Tự Phù Đồ Ứng Chế (奉和九月九日登慈恩寺浮屠應制) của Sầm Hi (岑羲, ?-713) nhà Đường có câu: “Phạm đường dao tập nhạn, đế nhạc cận tường loan (梵堂遙集雁、帝樂近翔鸞, chùa Phật xa nhạn đến, nhạc vua gần chim bay).” Hay trong Ấu Học Quỳnh Lâm (幼學瓊林), phần Khí Dụng (器用) có câu: “Thọ quang thị trang đài vô trần chi kính, trường minh thị Phạm đường bất diệt chi đăng (壽光是妝檯無塵之鏡、長明是梵堂不滅之燈, sống lâu là kính trang điểm không gợn bụi, sáng tỏ là đèn bất diệt của Thiền môn).” Trong Trường A Hàm Kinh (長阿含經, Taishō Vol. 1, No. 1) quyển 8 còn cho biết thêm rằng: “Nhập đệ tứ Thiền, phục hữu tứ pháp, vị tứ Phạm đường, nhất từ, nhị bi, tam hỷ, tứ xả (入第四禪、復有四法、謂四梵堂、一慈、二悲、三喜、四捨, vào cõi Thiền thứ tư, lại có bốn pháp, gọi là bốn Phạm đường: một là từ, hai là bi, ba là hỷ, bốn là xả).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phạm Đạo", "definition": "Chỉ cho sự tu hành thiền tịnh để đoạn trừ dâm dục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Đạo Sinh", "definition": "Phạm Đạo Sinh(?-?). Nhà điêu khắc tượng Phật Trung Quốc sống vào cuối đời Minh đầu đời Thanh. Lúc khởi công xây cất chùa Vạn Phúc (1661), bản sơn của tông Hoàng Bá của Nhật Bản, Thiền Sư Ẩn Nguyên đặc biệt mời Phạm Đạo Sinh từ Trung Quốc sang Nhật Bản để tạc tượng Phật theo kiểu tượng Hoàng Bá. Phương pháp tạc tượng của ông rất đặc thù nên đã có ảnh hưởng rất sâu đậm đối với giới điêu khắc Nhật Bản thời Giang Hộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm Đồ", "definition": "犯徒. Kẻ làm tội. “Lại đem các tích phạm đồ hậu tra” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạm, Pàli: Mahàmàna.", "definition": "I.Ma Ha Nam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Adhipati-pratyaya.", "definition": "I.Tăng Thượng Duyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Agni.", "definition": "I.A Kì Ni. Hỏa thần trong Bà La Môn Giáo của Ấn Độ. Còn gọi là A Nga Na, Ác Kì Ni. Dịch ý là lửa. Cứ theo Lê Câu Phệ Đà chép, thì nguồn gốc hoặc hình thức tồn tại của thần lửa có ba loại, tức trong ba cõi, ở cõi trời là thái dương, ở cõi không là ánh chớp, ở cõi đất là lửa tế lễ. Đây là mầm mống của tư tưởng về ba thần trong Ấn Độ Giáo là Phạm Thiên, Tì Thấp Nô và Thấp Bà. Trong Lê Câu Phệ Đà, đặc biệt các bài ca tán tụng thần lửa đã chiếm một phần trong toàn bộ năm phần của các bài ca tán, chỉ đứng sau Nhân Đà La. Khi tế tự, thần lửa có khả năng đưa các phẩm vật cúng tế đi phân phát cho các thần, vì thế, thần lửa được coi là sứ giả giữa các thần và người. Trừ loài người và cầm thú ra, thần lửa cũng tồn tại khắp trong các thực vật và trong nước; ngoài sự tế lễ theo phép tắc nhất định, thần lửa còn được cúng tế vào những dịp sinh nhật, sang nhà mới và kết hôn. Toàn thân màu hồng, phát ra ánh sáng như mặt trời, sắc mặt mầu sữa, không đầu không chân, hoặc ba đầu bảy lưỡi, có mặt khắp mười phương, mắt vàng, nghìn mắt v.v... Trong các thần, mối quan hệ giữa loài người và Thần lửa A Kì Ni, thần lửa gần gũi nhất, có khả năng phá trừ bóng tối, đốt hết những vật nhơ bẩn, hàng ma trừ quái, cũng được coi là “người tiêu diệt loài La Sát (ác ma)”. Ngoài ra, có thể ban ân cho những người sùng bái và giải cứu nguy nan. II.A Kì Ni. Tức là nước A Kì Ni, một nước xưa ở vùng Tây Vực. Cũng gọi là Ô Kì Quốc, Yên Kì Quốc. Phía đông giáp Cao Xương, phía tây giáp Cưu Tư. Nay tức là vùng đất Khách Lạt Sa Nhĩ (Karashahr), về phía đông bắc con đường ở nam núi Thiên Sơn thuộc Tân Cương. (xt. A Kì Ni Quốc).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Ahiôsà.", "definition": "I.Bất Hại.Không giết hại, làm thương tổn tất cả sinh vật. Là tư tưởng cơ bản của tôn giáo, luân lí và đạo đức Ấn Độ. Tư tưởng này bắt đầu từ thời đại Cổ Áo Nghĩa Thư (Khương đa quí Áo Nghĩa Thư III, 17 v.v...) và là đặc sắc mà các giáo thuyết ở Ấn Độ đều có. Trong Phật Giáo, “Chính Nghiệp” trong tám Chính Đạo là giáo nghĩa căn bản của Phật Giáo Nguyên Thủy đã nói rõ về Bất Hại, giới đầu trong năm giới là giới không được giết hại.Tám trai giới, mười giới của Sa Di và Sa Di Ni, ba la đề mộc xoa (Phạm: pràtimokwa, Pàli: pàỉimokkha) của Tỉ Khưu và Tỉ Khưu Ni đều có qui định nghiêm khắc. Trong các Pháp sắc (sắc lệnh dùng Phật Pháp để răn dạy) của vua A Dục cũng đề cao Bất Hại; trong các kinh luận của Phật Giáo Đại Thừa, như Kinh Phạm Võng, Luận Đại Trí Độ v.v... ghi chép rất nhiều, không thể kể hết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Arbuda, Pàli: Abbuda. Cũng gọi A Bộ Đàm, A Phù Đà, Át Phù Đà. Hán dịch: pháo, thũng vật.", "definition": "I. Át Bộ Đàm. Là một trong năm giai đoạn ở trong bào thai. Sau khi đầu thai đến tuần lễ thứ hai, dáng thai nhi đông lại như cái nốt phỏng trên da cho nên gọi là pháo hoặc là thủy bào (bọt nước). [X. Kinh Tạp A Hàm Q.49; Kinh Tăng Nhất A Hàm Q.30; Kinh Đại Ban Niết Bàn (bản Bắc) Q.38; Hữu Bộ Tì Nại Da Tạp Sự Q.11; Luận Câu Xá Q.9; Huyền Ứng Âm Nghĩa Q.22; Phiên Dịch Danh Nghĩa Tập Q.17; Tuệ Lâm Âm Nghĩa Q.14, Q.26]. II. Át Bộ Đàm. Là một trong tám địa ngục lạnh. Vì chúng sinh rơi vào địa ngục này thân hình phỏng phồng lên giống như bọt nước, nên mới có tên là Át Bộ Đàm. Nếu người bị đọa vào địa ngục lạnh này thì thân hình co giúm lại, những mụt phổng lên, gió độc thổi đến làm cho da nứt lông rụng, gân thịt rã rời, xương vỡ tủy chảy ra. Chịu nỗi khổ ấy xong, xương lại lành trở lại và lại chịu khổ như trước, không một chút ngừng nghỉ. Những chúng sinh gây các tội như sau: Khinh rẻ chư Phật hoặc những đệ tử Phật không giữ giới; hoặc làm rồng dữ nổi giận căm phẫn, làm mưa đá to lạnh buốt hại người, hoặc trộm cướp củi lửa của người đang bị lạnh cóng v.v..sau khi chết sẽ rơi vào địa ngục này để chịu khổ báo. [X. Kinh Đại Lâu Thán Q.2; Kinh Khởi Thế Nhân Bản Q.4; Luận Câu Xá Q.11; Luận Đại Trí Độ Q.16; Phiên Phạm Ngữ Q.8; Phiên Dịch Danh Nghĩa Tập Q.7; Vãng Sinh Yếu Tập Q.thượng]. (xt. Bát Hàn Địa Ngục).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Aruịa. Còn gọi là A Lưu Na, A Lâu Na. Dịch ý: ngày, gần sáng, mờ mờ sáng.", "definition": "I.A Lô Na. Là hình dung từ tả màu đỏ lợt. Vì khi mặt trời mọc thì phía đông hừng đỏ, nên gọi là màu đỏ lợt, như hoa sen đỏ lợt gọi là hoa A Lô Na, hương đỏ lợt gọi là hương A Lâu Na. [ X. Tứ Phần Luật Khai Tông Kí Q.3, phần cuối; Tuệ Lâm Âm Nghĩa Q.thượng]. II.A Lô Na. Tên thực vật. Tại Ấn Độ, có bốn loại thực vật cùng có tên là A Lô Na:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Avikwipta-citta.", "definition": "I.Nhất Tâm Bất Loạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Bharadvàja", "definition": "I - Bà La Đọa Bạt Xà. Chi cõi trời Bà La Đọa Bạt Xà. Một trong tám mươi cõi trời. Dịch ý là Trùng Ngữ Thiên. Là một trong tám mươi cõi trời tướng đẹp mà Bồ Tát, vì hóa độ chúng sinh, tu hành. Cứ theo Kinh Đại Ban Niết Bàn (bản Bắc) quyển 24 chép, thì Bồ Tát Ma Ha Tát tu trì vô lượng phúc đức, sau khi thành tựu đầy đủ ba mươi hai tướng, lại tu tám mươi thứ vẻ đẹp. Đó là vì ở thế gian có những người phụng thờ tám mươi thứ thần, tức là mười hai vị Nhật thần, mười hai vị Đại Thiên, Bà La Đọa Bạt Xà thiên, Công Đức Thiên v.v..., vì độ những loại chúng sinh ấy mà Bồ Tát tu tướng đẹp của tám mươi trời để trang nghiêm thân mình. Bồ Tát Ma Ha Tát, nhờ sự tu thân thanh tịnh ấy mà khiến chúng sinh đã tin, đã thấy lại càng tăng thêm kính tín, mà phát tâm A Nậu Đa La Tam Miệu Tam Bồ Đề. II - Bà La Đọa Bạt Xà. Chi Bà La Đọa, một vị tăng Bà La Môn. Cứ theo Kinh Trường A Hàm quyển 6 chép, thì khi Đức Phật trú tại giảng đường Lộc mẫu, trong vườn Thanh Tín Lâm ở nước Xá Vệ, có hai người Bà La Môn, vì lòng tin vững chắc, đến nơi Phật cầu xin xuất gia tu đạo. Hai người Bà La Môn ấy tức là Bà Tất Tra và Bà La Đọa vậy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Bhava-cakra.", "definition": "I.Sinh Tử Luân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Bràhmaịa.", "definition": "I.Phạm Chí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Buddha-màtri.Pàli: Buddha-màtar.", "definition": "I.Phật Mẫu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Buddha-putra. Pàli: Buddha-putta.", "definition": "I.Phật Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Buddha-vacana.", "definition": "I.Phật Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Dharma-ràja.", "definition": "I.Pháp Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Eka-rùpa.", "definition": "I.Nhất Sắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Gayà kàzyapa.", "definition": "I.Già Da Ca Diếp:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Hetu.", "definition": "I.Nhân.Nguyên nhân dẫn sinh ra kết quả.Nói theo nghĩa hẹp thì nguyên nhân bên trong trực tiếp dẫn sinh ra kết quả, gọi là Nhân (nội nhân = nhân bên trong), còn nguyên nhân bên ngoài gián tiếp giúp đỡ thì gọi là Duyên (ngoại duyên=duyên bên ngoài). Nhưng, nói theo nghĩa rộng, tất cả", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Indra-jàla.", "definition": "I.Nhân Đà La Võng.Cũng gọi Thiên Đế Võng, Đế Võng. Tấm lưới báu trang hoàng ở cung điện của trời Đế Thích.Mỗi mắt lưới đều có kết bảo Châu, nhiều vô lượng, mỗi viên bảo Châu đều ánh hiện hình ảnh của tất cả các viên bảo Châu khác, vô lượng viên bảo Châu như thế giao thoa phản chiếu, ánh hiện trùng trùng, vô cùng vô tận.Kinh Hoa Nghiêm dùng Nhân Đà La võng để ví dụ cho nghĩa 1 và nhiều tương tức tương nhập (tức là nhau hòa nhập vào nhau), trùng trùng vô tận của các pháp. Nếu đứng về phương diện cảnh mà nói, thì gọi là Nhân Đà La Võng cảnh; đứng về phương diện định mà nói thì gọi là Nhân Đà La võng định; còn đứng về mặt độ (cõi) mà nói thì gọi là Nhân Đà La võng độ, đây đều là hiển bày pháp môn “Sự sự viên dung vô ngại”.[X.Hoa Nghiêm Kinh Thám Huyền Kí Q.1; Hoa Nghiêm Ngũ Giáo Chương Q.1; Tuệ Uyển Âm Nghĩa Q.hạ]. II.Nhân Đà La Võng.Loại vũ khí do thần A Thuận Na (Phạm: Arjuna) ở Ấn Độ sử dụng.Lúc chiến đấu, thần A Thuận Na dùng thứ vũ khí này để chế ngự quân địch, làm cho địch lâm vào tình cảnh nguy khốn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Jina. Hán dịch: Thắng giả.", "definition": "I. Kỳ Na. Danh từ tôn xưng đức Phật. Kinh Phật bản hạnh tập quyển 1 (Đại 3, 655 thượng), nói: Như Lai trụ nơi hạnh Phật; không còn phiền não, nên gọi Kỳ Na. Ngài đạt được Nhất Thiết Trí, trụ nơi thiên hạnh, trụ nơi phạm hạnh, trụ nơi Thánh Hạnh, tâm được tự tại. II. Kỳ Na. Vị giáo tổ của Kỳ Na Giáo sống vào thời đại đức Phật. [X. Huyền Ứng Âm Nghĩa Q.19]. (xt. Kỳ Na Giáo)", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Jàta, JàtI.Pàli: Jàti.", "definition": "I.Sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Karman.", "definition": "I.Tác Nghiệp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Kađga.", "definition": "I.Khát Già.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Kunti.", "definition": "I.Quân Đề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Mahà-yàna.", "definition": "I.Ma Ha Diễn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Mahàsattva. Pàli: Mahàsatta.", "definition": "I.Ma Ha Tát Đóa. Gọi tắt: Ma Ha Tát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Màtratà. Âm Hán: Ma đát lạt đa.", "definition": "I.Duy. Chữ này gồm có ba nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Nandi.Hán dịch: Hỉ.", "definition": "I.Nan Đề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Nàga.", "definition": "I.Na Già.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Parigraha.", "definition": "I.Nhiếp Thủ. Cũng gọi Nhiếp Thủ Bất Xả.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca jĩànàni.", "definition": "I.Ngũ Trí.Năm trí thể của đức Đại Nhật Như Lai do Mật Giáo thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca kàmà. Pàli: Paĩca Kàmà.", "definition": "I.Ngũ Dục.Cũng gọi Ngũ Diệu Dục, Diệu Ngũ Dục, Ngũ Diệu Sắc.Chỉ cho 5 thứ tình tham muốn do say đắm 5 trần cảnh: Sắc, thanh, hương, vị, xúc mà nổi lên. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca phalàni.Cũng gọi Ngũ Quả.", "definition": "I.Ngũ Chủng Quả.Năm thứ quả hữu vi, vô vi do 6 nhân sinh ra và đạo lực chứng được:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca rasà.", "definition": "I.Ngũ Vị.Chỉ cho 5 vị: Nhũ (Phạm: Kwìra, sữa), lạc (Phạm: Dadhi, váng sữa), sinh tô (Phạm: Navanìta, sữa đặc), thục tô (Phạm: Ghfta, bơ), đề hồ (Phạm: Sarpirmaịđa, phó mát). Năm vị này đều được chế biến từ sữa.Các Kinh luận thường dùng 5 vị này để ví dụ sự sai khác về căn cơ hoặc giáo pháp. Như Kinh Niết Bàn quyển 10 (bản Bắc) nói: Thanh Văn như sữa, Duyên Giác như lạc, Bồ Tát như sinh tô, thục tô, chư Phật Thế Tôn như đề hồ. Đây là ví dụ về căn cơ (người), còn ví dụ về giáo pháp (pháp) thì như Kinh Niết Bàn quyển 14 (bản Bắc), Phẩm Thánh Hạnh (Đại 12, 449 thượng) nói: “Ví như từ bò vắt ra nhũ (sữa), từ nhũ có lạc (váng sữa), từ lạc có sinh tô (sữa đặc), từ sinh tô có thục tô (bơ), từ thục tô có đề hồ (phó mát). Đề Hồ là thức ăn ngon nhất, có nhiều dược chất, có thể chữa khỏi các bệnh. Này các thiện nam tử! Phật cũng như thế, từ Phật có 12 thể tài Kinh, từ 12 thể tài Kinh có Tu Đa La, từ Tu Đa La có Kinh Phương Đẳng, từ Kinh Phương Đẳng có Bát Nhã Ba La Mật, từ Bát Nhã Ba La Mật có Đại Niết Bàn; cũng như đề hồ, nói đề hồ là ví dụ Phật Tính, Phật Tính tức là Như Lai”.Đoạn văn Kinh trên đây từ ngài Tuệ Quán đời Lưu Tống và cư sĩ Lưu Cầu đời Tiêu Tề đến nay đều được dùng để ví dụ thứ tự thuyết giáo của 1 đời Đức Phật, nhưng sự giải thích của các nhà thì có nhiều điểm dị đồng.Đại Phẩm Kinh Du Ý của ngài Cát Tạng (Đại 33, 66 hạ) nói: “Bàn về vị tương sinh của 5 nhà, nhà thứ 1 nói rằng, 12 thể tài phối hợp với A Hàm, Tu Đa La phối với Thiền Kinh. Tại sao? Vì định hay phát sinh trí nên Tu Đa La được phối với Thiền Kinh. Phương Đẳng phối với Bát Nhã, Tư ích..., Bát Nhã phối với Pháp Hoa, Đề Hồ phối với Niết Bàn”.Ngài Thiên Thai Trí Khải thì dựa theo thứ tự thời gian thuyết giáo của 1 đời Đức Phật mà lập thành 5 thời, rồi dùng 5 vị phối hợp với 5 thời, ví dụ cho sự phát sinh dần dần của 5 thời giáo, gọi là “Ước giáo tương sinh”, lại dùng tính đậm, lạt của 5 vị ví dụ cho sự lợi, độn của căn cơ, gọi là “Ước cơ nùng đạm”. Năm vị:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca vedanà. Pàli: Paĩca vedanà.", "definition": "I.Ngũ Thụ.Năm thứ cảm nhận tùy theo xúc giác. Theo Luận Câu Xá thì 5 thụ gồm có:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca zìlàni.Chỉ cho 5 loại giới do Đức Phật chế định.", "definition": "I.Ngũ Giới.Cũng gọi Ưu Bà Tắc ngũ giới, Ưu Bà Tắc Giới.Năm thứ chế giới của nam nữ Phật tử tại gia thụ trì. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩca àvaraịàni.Pàli: Paĩca nìvaraịàni.Cũng gọi Ngũ ngại.", "definition": "I.Ngũ Chướng.Người đàn bà bị chướng ngại không thể thành 5 bậc: Phạm Thiên Vương, Đế Thích, Ma Vương, Chuyển Luân Thánh Vương và Phật. Trong Kinh Đại Bảo Tích quyển 38 chỉ nói 4 chướng mà thiếu mất chướng Ma Vương. [X.Phẩm Đề Bà Đạt Đa trong Kinh Pháp Hoa; Kinh Siêu nhật minh tam muội Q.hạ; Pháp Hoa Kinh Huyền Tán Q.9, phần đầu]. (xt. Nữ Tử Ngũ Chướng). II.Ngũ Chướng.Cũng gọi Ngũ Cái chướng.Chỉ cho 5 thứ chướng ngại trên con đường tu hành Phật đạo.Cứ theo Đại Nhật Kinh Sớ quyển 1 thì 5 chướng ngại ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Paĩcendriyàịi.Năm căn.", "definition": "I.Ngũ Căn.Cũng gọi Ngũ sắc căn.Chỉ cho 5 sắc căn, chỗ nương của 5 thức. Tức:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Prajĩàruc", "definition": "I.Dịch ý là Trí Hi (Trí hiếm có). Cũng gọi Cù Đàm Bát Nhã Lưu Chi, Cù Đàm Lưu Chi.Người thành Ba La Nại ở nam Ấn Độ, họ Cù Đàm, giòng Bà La Môn. Sư đến Trung Quốc vào niên hiệu Hi Bình năm đầu (516) đời Hiếu Minh Đế nhà Bắc Ngụy, ở thủ đô nhà Ngụy tại đất Nghiệp. Khoảng năm 538 đến năm 543, cùng với các sư Đàm Diệu, Bồ Đề Lưu Chi dịch chung Kinh Chính Pháp Niệm Xứ, Luận Thuận Trung v.v... Gồm 14 bộ 85 quyển. Từ đó về sau như thế nào, không được biết. [X. Khai Nguyên Thích Giáo Lục Q.6; Lịch Đại Tam Bảo Kỉ Q.9; Tục Cao Tăng Truyện; Bồ Đề Lưu Chi Truyện].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Sahà.", "definition": "I.Sa Ha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Sarvatraga", "definition": "I.Biến Hành. Là một trong sáu loại (vị) tâm sở do Tông Duy Thức lập ra. Đối lại với “Biệt Cảnh”. Chỉ cho hoạt động tâm lý khi phát sinh tác dụng nhận thức, vì nó có tính phổ biến, nên gọi là Biến Hành, gồm xúc, tác ý, thụ, tưởng, tư,..., gọi là năm Biến Hành. (xt. Ngũ Biến Hành). II.Biến Hành. Đối lại với “Phi biến hành”. Trong 98 phiền não căn bản, có thể chia làm hai loại lớn là Biến Hành và Phi biến hành. Những phiền não này (Biến Hành, Phi biến hành) ở trong các pháp của năm bộ (bốn đế, tu đạo) tự giới, tự địa, chúng trải qua biến duyên, biến tùy tăng, biến tùy nhân mà sinh ra pháp nhơ nhớp (phiền não) của khắp năm bộ gọi là Biến Hành hoặc (phiền não đi khắp). Biến Hành hoặc gồm có 33 thứ phiền não, chia nhau thuộc ba cõi: cõi Dục, cõi Sắc, cõi Vô Sắc mỗi cõi đều có 11 thứ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Tisra kwàntaya. Cũng gọi Tam Nhẫn.", "definition": "I.Tam Pháp Nhẫn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Tisro-dukhatà.", "definition": "I.Tam Khổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Trayo-dhàtava. Pàli: Tisso dhàtuyo.", "definition": "I.Tam Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Tri-vidya. Pàli: Ti-vijjà.", "definition": "I.Tam Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Trìịi yànàni. Chỉ cho 3 loại xe, ví dụ 3 pháp môn vận chuyển chúng sinh vượt qua sinh tử đến bờ Niết Bàn.", "definition": "I.Tam Thừa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Trìịi-karmàịi.", "definition": "I.Tam Nghiệp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Trìịy-àvaranàni.Ba thứ chướng ngại.", "definition": "I.Tam Chướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Vasiwỉha.", "definition": "I. Bà Tư Tra. Còn gọi là Bà Tử Sắt Đà, Phọc Tư Tiên, Bà Tư Tiên, Bà Tẩu Tiên Nhân. Gọi tắt là Bà Tư, Bà Tra. Là một trong bảy đại tiên, một trong mười đại tiên, một trong hai mươi tám bộ chúng. Là người tiên vào thời đại Phệ Đà ở Ấn Độ. Bà Tư Tra ở thời đại Lê Câu Phệ Đà, là người tiên đại biểu cho giòng dõi Bà La Môn, cũng tức là tác giả những bài ca tán trong Lê Câu Phệ Đà quyển 7.Cứ theo Luận Đại Trí Độ quyển 3 chép, thì xưa kia vua Bà Tẩu nước Ma Yết Đà vì chán đời mà xuất gia làm tiên nhân. Khi ấy có các Bà La Môn tại gia cùng bàn luận với các người tiên xuất gia là, khi tế trời, nên hay không nên sát sinh, ăn thịt. Câu hỏi này được đặt ra cho tiên Bà Tẩu, Bà Tẩu trả lời là nên, những người tiên xuất gia trách cứ và bảo phải nói thực, Bà Tẩu bèn dẫn chứng trong bốn Phệ Đà bảo khi tế trời phải sát sinh, ăn thịt và không thay đổi ý kiến của mình. Bà Tẩu vì thế mà bị tội lớn và toàn thân mất vào trong đất. Lại Kinh Đại Phương Đẳng Đà La Ni quyển 1 bảo, người tiên ấy từ địa ngục ra, được liệt vào chúng hội nghe Đức Phật nói pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Vasumitra. Còn gọi là Phạt Tô Mật Đát La, Bà Tu Mật, Bà Tu Mật Đa La, Hòa Tu Mật Đa. Dịch ý là Thế Hữu, Thiên Hữu.", "definition": "I - Bà Tu Mật Đa. Một trong năm mươi lăm thiện tri thức trong Kinh Hoa Nghiêm. Là vị thiện tri thức thứ 25 mà Đồng Tử Thiện Tài đến tham hỏi. Cứ theo Kinh Hoa Nghiêm (bản dịch cũ) quyển 50 chép, thì Bà Tu Mật Đa ở trong thành Bảo Trang Nghiêm nước Hiểm Nạn, dung mạo đoan chính, từ nơi thân phát ra ánh sáng lớn, đã thành tựu pháp môn thanh tịnh li dục thực tế, liền vì chúng sinh nói pháp môn li dục để được thanh tịnh. Ma Ha Chỉ Quán quyển 2 phần dưới (Đại 46, 17 hạ), nói: “Ngay trong cái xấu ác mà tu quán tuệ; (...) Hòa Tu Mật đa dâm mà Phạm Hạnh thanh tịnh, Đề Bà Đạt Đa Tà Kiến mà ngay thẳng”. [X. Kinh Hoa Nghiêm (bản 80 quyển) Q.68]. (xt. Ngũ Thập Tam Tham). II - Bà Tu Mật Đa. Vị đại Luận Sư sau thời Đức Phật nhập diệt bốn trăm năm. Một trong bốn nhà nghị luận của hội Bà Sa. Là bậc Thượng thủ đứng đầu năm trăm vị Hiền Thánh trong lần kết tập ba tạng của bộ Tát Bà Đa tại nước Ca Thấp Di La, dưới triều vua Ca Nhị Sắc Ca. (xt. Thế Hữu).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Vàlapatha.", "definition": "I.Mao Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Yazodharà, Pàli: Yasodharà. Cũng gọi Da Du Đà La, Da Duy Dàn. Hán dịch: Trì dự, Trì xưng, Hoa sắc. Cũng gọi La Hầu La Mẫu (Phạm: Ràhula - màtf: mẹ của La Hầu La).", "definition": "I.Da Du Đà La. Con gái của ông Chấp Trượng (Phạm: Daịđapàịi), dòng họ Thích, ở thành Ca Tì La, trung Ấn Độ, là chính phi của Thái Tử Tất Đạt Đa, mẹ ruột của La Hầu La. Lại có thuyết nói Da Du Đà La là con gái của đại thần Ma Ha Na Ma (Phạm: Mahànàma) dòng họ Thích thuộc chủng tộc Bà Tư Tra (Phạm: Vaziwỉhà). Cũng có thuyết bảo Da Du Đà La là con gái của vua Thiện Giác (Phạm: Suprabuddha) và là em gái của Đề Bà Đạt Đa ở thành Thiên Tí (Phạm: Devadaha). Bà có thân hình đoan trang xinh đẹp vào bậc nhất, đầy đủ mọi đức. Đức Thích tôn thành đạo được năm năm thì Da Du Đà La và di mẫu của Đức Thích Tôn là bà Ma Ha Ba Xà Ba Đề (Phạm: Mahà-prajapati) cùng với 500 người phụ nữ dòng Thích Ca cũng xin xuất gia thụ giới Cụ Túc làm Tỉ Khưu II.Da Du Đà La. Là vị Bồ Tát trong Mật Giáo được thờ trong Viện Quan Âm của Hiện Đồ Thai Tạng Giới Mạn Đồ La. Mật hiệu là Thị Hiện Kim Cương. Tượng vẽ của vị tôn này là thiên nữ, đầu đội mũ kim tuyến, tay phải co lại, lòng bàn tay ngửa lên, các đầu ngón tay duỗi xuống, riêng ngón cái hơi co, bàn tay trái dựng thẳng, ngón trỏ, ngón giữa kẹp một cành cây. Ấn Khế là ấn Mã Đầu Minh Vương. Chân Ngôn là: Na Ma Tam Mạn Đa Bột Đà Nẫm Diêm. [X. Đại Nhật Kinh Sớ Q.5; Thai Tạng Giới Niệm Tụng Thứ Đệ Yếu Tập Q.7].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: Zama-eka-ayana-màrga.", "definition": "I.Nhất Hướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: asapakwa. Tiếng dùng trong Nhân Minh.", "definition": "I.Dị Phẩm. Đối lại với Đồng Phẩm. Phẩm loại không cùng một tính chất gọi là Dị Phẩm, như Vô Thường và Thường trụ. II.Dị Phẩm. Sự vật được chứng minh không đồng thời tồn tại, như Vô Thường và Hư Không. [X. Luận Nhân Minh Nhập Chính Lí]. III.Dị Phẩm. Phẩm loại không cùng tính chất với khách từ (hậu trần) của Tông (mệnh đề).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: bhagavat.", "definition": "I - Bà Già Bà. Một trong các hiệu chung của chư Phật. Cũng gọi là Bạc Già Phạm, Bà Già Phạm, Bà Già Bạn, Bạc A Phạm, Bà Nga Phạ Đế, Bà Nga Phạ Để, Bạc Già Bạt Đế. Dịch ý là có đức, có công đức lớn, có thanh danh, giúp mọi người, khéo phân biệt, hay phá, Thế Tôn. Tức hàm ý là bậc có đầy đủ mọi đức, được người đời tôn trọng cung kính. Cũng tức là tôn xưng Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: bhùta. Đối lại với Vị sinh.", "definition": "I.Dĩ sinh. Chỉ cho sinh tướng vị (tức sát na sau cùng của thời vị lai) của pháp thể từ vị lai lưu chuyển đến sát na của vị hiện tại.[X. Luận Câu Xá Q.5]. II.Dĩ sinh. Chỉ cho bản hữu. Tức là thân trung ấm đã thụ sinh vào đời sau. Còn thân trung ấm đang tìm cầu chỗ thụ sinh thì gọi là Cầu Sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: bodhisattva-caryà.", "definition": "I.Bồ Tát Đạo. Sự tu hành của Bồ Tát. Tức là con đường tu hành sáu độ muôn hạnh, lợi mình lợi người để thành tựu quả Phật. Bởi thế, đạo Bồ Tát là nhân chính yếu để thành Phật, và thành Phật là kết quả của đạo Bồ Tát. Người muốn thành Phật, trước hết phải tu đạo Bồ Tát. [X. Kinh Pháp Hoa Q.1]. II.Bồ Tát Đạo. Chỉ cho Phật Giáo Đại Thừa. Tức là giáo pháp trên cầu Phật đạo, dưới hóa độ chúng sinh. [X. Kinh Quán Đính Q.12].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: pratyaya, Pàli: paccaya.", "definition": "I.Duyên. Nói theo nghĩa hẹp, duyên là nguyên nhân gián tiếp đưa đến kết quả; nói theo nghĩa rộng, duyên là tên gọi cả hai nhân và duyên hợp lại.Duyên được chia làm bốn loại:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm: pudgala", "definition": "I.Bổ Đặc Già La. Cũng gọi Phú Đặc Già La, Phất Già La, Phúc Già La. Dịch là người, chúng sinh, sổ thủ thú, chúng số giả. Chỉ cho chủ thể của sự luân hồi tái sinh. Sổ thủ thú., hàm ý là nhiều lần đi lại vòng quanh trong năm đường. Một trong 16 tri kiến của ngoại đạo. Tức là tên khác của “ngã”, hoặc chỉ riêng cho người.Phật Giáo chủ trương thuyết Vô Ngã nên không thừa nhận Bổ Đặc Già La chân thực (Bổ Đặc Già La Thắng Nghĩa) là chủ thể của sự sống chết, nhưng vì phương tiện giải nói nên tạm gọi người là Bổ Đặc Già La (Bổ Đặc Già La Thế Tục). Tuy nhiên, trong các bộ phái Phật Giáo, thì Độc Tử Bộ, Chính Lượng Bộ và Kinh Lượng Bộ lại thừa nhận Bổ Đặc Già La là có thực. Lại có phái cho Bổ Đặc Già La đồng nghĩa với người, như Luận Pháp Uẩn Túc quyển 2 gọi quả vị tu hành Tứ Song Bát Bối (bốn đôi tám bậc) là Tứ Song Bát Chích Bổ Đặc Già La. [X. Kinh Đại Bát Nhã Q.409; Kinh Đại Nhật Q.1 Phẩm Trụ Tâm; Luận Đại Trí Độ Q.35; Luận Đại Thừa A Tì Đạt Ma Tạp Tập Q.13; Luận Du Già Sư Địa Q.83; Huyền Ứng Âm Nghĩa Q.23]. II.Bổ Đặc Già La. Kì Na Giáo giải nghĩa Bổ Đặc Già La là vật chất, gồm đủ sắc, hương, vị, xúc, nhưng không có ý thức. Vật chất này được chia làm hai loại: một loại là các nguyên tử đất, nước, lửa, gió vĩnh viễn không thể phân chia; loại kia là thể phức tạp do các nguyên tử cấu thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm:Vajrapàịibalin. Hán âm: Bà Xà Ba La Ni Bà Lí Ti.", "definition": "I. Kim Cương Lực Sĩ. Vương tử Pháp ý con vua Dũng Quận ở đời quá khứ. Cứ theo Hội Kim Cương Lực Sĩ trong kinh Bảo tích quyển 9, thủa xưa, Chuyển Luân Thánh Vương tên là Dũng Quận có 1.000 người con và 2 vương tử là Pháp ý và Pháp niệm; Pháp ý nguyện rằng khi nào 1.000 vị Thái tử thành Phật, thì mình sẽ là Kim Cương Lực Sĩ, ở gần bên Phật, nghe những pháp bí yếu của chư Phật. Vua Dũng quận lúc bấy giờ chính là đức Định Quang Như Lai trong quá khứ, 1.000 vị Thái tử tức là 1.000 đức Phật trong kiếp Hiền, còn vương tử Pháp ý chính là Kim Cương Lực Sĩ, tên là Mật tích, cho nên cũng gọi là lực sĩ Kim Cương Mật Tích. Lực Sĩ Mật Tích, hoặc gọi là Na La Diên,vì ngài có sức rất mạnh. II. Kim Cương Lực Sĩ. Chỉ cho Kim cương và Lực Sĩ. Cứ theo phẩm Chân ngôn tạng trong Kinh Đại Nhật, thì Kim cương là chỉ cho thần thủ hộ Bất khả việt, còn gọi là Nan thắng kim cương; Lực sĩ là chỉ cho thần thủ hộ Tương Hướng, cũng gọi là Đối diện kim cương. Hai vị thần thủ hộ này thường được gọi là Nhị Vương Tôn, là những thần Kim Cương Thờ ở 2 bên cửa chùa. Cũng có nơi lập Hữu Bật Kim Cương và Tả Phụ Mật Tích. Hữu bật tức là trời Na La Diên, vì vị thần trời này có sức rất mạnh, xua đuổi được tất cả quỉ thần. Còn Tả phụ tức là lực sĩ Kim Cương Mật Tích. [X. phẩm Mật Ấn Kinh Đại Nhật; Kinh Đà La Ni Tập Q.12]. (xt. Nhị Vương Tôn, Na La Diên Thiên).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạm:Àzraya. Pàli: Assaya.", "definition": "I.Sở Y.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạn", "definition": "梵. Tiếng nhà Phật có nghĩa là thanh tịnh, trong sạch Thứ chữ cổ Ấn Độ, dùng viết kinh Phật, tức chữ Phạn Thuộc về nhà Phật. Phạn 梵: Cây phướn nhà chùa. “Mảng xem cây phạn thú mầu” (B. C. K. N.).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Bản", "definition": "Tức là kinh điển bằng ngữ văn Ấn-độ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phạn Bối", "definition": "(梵唄, Bonbai): từ gọi chung chỉ cho Thanh Minh (聲明). Phạn hay Phạm (梵) là tiếng gọi tắt của Phạn Ngữ (梵語), Phạm Âm (梵音), Phạm Thanh (梵聲), v.v. Bối (唄) là từ xuất hiện đơn độc trong Thập Tụng Luật (十誦律) và thỉnh thoảng cũng thấy xuất hiện một số từ ghép như Bối Nặc (唄匿), Bối Tụng (唄誦), Kinh Bối (經唄), v.v. Nó là từ âm tả tiếng Phạn, còn Bối Nặc được xem như là âm tả của từ pāṭha (đọc tụng). Theo gốc tiếng Sanskrit, Phạn Bối có nghĩa là tán ca, nhưng hiện tại nó ám chỉ cho Thanh Minh vốn bao gồm cả Hán Ngữ Tán cũng như Hòa Tán, v.v., hay nói rộng ra là âm nhạc theo nghi thức Phật Giáo nói chung. Tại Trung Quốc, theo bộ Pháp Hoa Huyền Tán (法華玄讚) quyển 4, truyền thuyết cho rằng nhân một ngày nọ Tào Thực (曹植, 192-232, tức Trần Tư Vương [陳思王] của nhà Ngụy thời Tam Quốc) leo lên đỉnh núi Ngư Sơn (魚山), bỗng nghe được âm điệu văng vẳng như tiếng tụng kinh truyền lại từ trong hang núi, nên lần đầu tiên ông chế ra Phạn Bối.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phạn Chúng", "definition": "梵衆. Chỉ chung các tu sĩ đạo Phật. Cũng như: Tăng chúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Cung", "definition": "梵宮. Chùa Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Dự", "definition": "Brahmadatta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạn Hàm", "definition": "飯銜. Bỏ gạo vào miệng người chết lúc sắp chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Hành", "definition": "梵行. Tu theo đạo Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Học", "definition": "梵學. Sự nghiên cứu tìm tòi về giáo lí nhà Phật. Cũng như: Phật học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Khánh", "definition": "Chiếc khánh dùng để báo hiệu giờ thụ trai của chư tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạn Ngưu", "definition": "飯牛. Cho trâu ăn. Chăn trâu. Bài Hàn nho phong vị phú của Nguyễn Công trứ có câu: “Tiếc tài cả lúc phạn ngưu bản trúc, dấu xưa ông Phó ông Hề”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Ngữ", "definition": "Sanskrit (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạn Sàng", "definition": "Cũng gọi Phạn Trác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạn Sát", "definition": "梵殺. Chùa Phật. “Miền phạn sát hỡi xa chừng vòi vọi” (Sãi vãi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Tăng", "definition": "(飯僧): tên gọi khác của Trai Tăng (齋僧), tức thiết bày cơm chay cúng dường Tăng chúng, chỉ chung cho việc cúng dường tại các tự viện hay tư gia Phật tử. Theo Phạm Võng Kinh (梵綱經) quyển hạ, vào ngày cha mẹ, anh em, Hòa Thượng, A Xà Lê (阿闍梨) qua đời, hoặc vào dịp 21 ngày hay 49 ngày, nên đọc tụng, thuyết giảng kinh luật Đại Thừa, thiết lập Trai Hội để hồi hướng công đức cho những người này. Ban đầu, việc Trai Tăng thể hiện tín tâm, quy y; nhưng về sau thì chuyển sang mục đích chúc tụng, báo ân, làm điều thiện, v.v.; vì vậy việc làm này trở thành phổ cập hóa. Tại Trung Quốc, Pháp Hội Trai Tăng rất thịnh hành dưới thời nhà Đường, vào năm thứ 7 (772) niên hiệu Đại Lịch (大曆), trong khoảng niên hiệu Trinh Nguyên (貞元, 785-805), năm thứ 12 (871) niên hiệu Hàm Thông (咸通), đều có cử hành những lễ Trai Tăng long trọng. Ngoài ra, tại Nhật Bản, Triều Tiên, Đài Loan, Việt Nam, v.v., hình thức Trai Tăng cũng rất phổ cập và được xem trọng. Trong Ma Ha Tăng Kỳ Luật (s: Mahāsaṅghavinaya, 摩訶僧祇律卷, Taishō No. 1425) quyển 22 có đoạn: “Nhĩ thời hữu Trưởng Giả tựu Tinh Xá trung phạn tăng, Lục Quần Tỳ Kheo tiên đa thọ canh, hậu thọ phạn (爾時有長者就精舍中飯僧、六群比丘先多受羹、後受飯, lúc bấy giờ có vị Trưởng Giả đến Tinh Xá cúng dường Trai Tăng, nhóm Lục Quần Tỳ Kheo trước hết thọ nhận nhiều canh xúp, sau mới thọ nhận cơm).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phạn Tự", "definition": "梵字. Chữ viết của người Ấn Độ thời cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Văn", "definition": "梵文. Như Phạn tự 梵字.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Vũ", "definition": "梵宇. Chùa Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Điếm", "definition": "飯店. Tiệm bán cơm và đồ ăn. “Vào nơi Phạn điếm hỏi chừng trước sau” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Điển", "definition": "梵典. Sách vở nhà Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạn Đại Tử", "definition": "飯 袋 子. Còn gọi: Phạn Dũng (thùng cơm). Cái túi cơm. Chỉ cho hạng tầm thường chỉ biết ăn hại. Thiền Tông mượn từ này để chỉ các vị tăng chẳng linh lợi, chẳng lãnh ngộ. Vân Môn Quảng Lục, q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phạn Đầu", "definition": "Chức vụ của vị tăng trông nom cơm cháo cho Đại Chúng trong Thiền Lâm, dưới quyền vị Điển Tọa.Vị này có trách nhiệm chu toàn các việc như kiểm tra số chúng tăng, xem xét lúa gạo tốt hay xấu, phân biệt nước uống trong hay đục, rau cải nhiều ít, củi than có hay không, cho đến chùi rửa các dụng cụ nhà bếp, xử lí các thực phẩm hư thiu v.v... [X. điều Phạn đầu trong Huyễn trụ thanh qui; môn Chức Vị trong Thiền Lâm Tượng Khí Tiên; điều Phạn đầu trong Tăng Đường Thanh Qui Q.5].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạp", "definition": "乏. Thiếu. Td: Khuyết phạp (thiếu thốn, không đầy đủ) Nghèo túng. Td: Bần phạp (nghèo nàn túng thiếu) Không. Không còn gì. Xem Phạp nguyệt Mệt nhọc. Td: Bì phạp (mỏi mệt nhọc nhằn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạp Nguyệt", "definition": "乏月. Một tên chỉ tháng tư âm lịch (vì ở tháng này, lúa mới chưa có mà lúa cũ đã hết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạp Đạo", "definition": "Nghèo đạo. Là từ dịch khác của chữ Sa Môn (Phạm: Zramaịa).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạt", "definition": "伐. Đánh giặc. Đánh kẻ có lỗi Đem binh đi đánh. Td: Chinh phạt Tự khoe công lao của mình Đánh. Gõ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Chiết La", "definition": "Phạm: Vajra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạt Cổ", "definition": "伐鼓. Đánh trống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Kim", "definition": "罰金. Số tiền mà người có tội phải nộp cho toà án.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Kì Sa Lạp", "definition": "Phạt Kì Sa Lạp (?-?).Pàli: Vàcissara.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạt Lí Sa", "definition": "Phạm: Vàrwya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạt Lạp Tì Quốc, Phạt Lạp Tì", "definition": "Phạm: Valabhì. Cũng gọi Bạt Lạp Tì Quốc, Bắc La La Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạt Mưu", "definition": "伐謀. Đánh tan sự tính toán sắp xếp của giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Mộc", "definition": "伐木. Chặt cây. Đẵn cây Tên một bài trong thiên Tiểu nhã kinh Thi, nói về tình thân thích và bằng hữu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Na Bà Tư", "definition": "Vanavasin (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạt Thiện", "definition": "伐善. khoe cái hay, cái tốt của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Trí Ha Lợi", "definition": "Phạm: Bhartfhari.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phạt Tác", "definition": "罰作. Công việc nặng nhọc mà kẻ có tội phải làm, coi như một cách trừng trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Tô Bàn Độ", "definition": "Xem Thế Thân Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạt Tội", "definition": "伐罪. Đem quân đi đánh kẻ có lỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phạt Xà La Phất Đa La", "definition": "Vajraputra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phạt-Xà-La-Phất-Đa-La", "definition": "Vajraputra (S).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phả", "definition": "叵. Không thể Bèn Dùng như chữ Phả 頗.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phả Hệ", "definition": "譜系. Cuốn sách ghi chép sự liên lạc họ hàng. Hoa Tiên có câu: “Sẵn nơi trú ngụ đâu tày, tiện tra phả hệ bấy nay cho tường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phả La Đọa", "definition": "Phạm: Bharadvàja. Cũng gọi Phả La tra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phả Lặc Củ Noa", "definition": "Phạm: Phàlguna. Pàli: Phagguịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phả Ni Đa", "definition": "Phạm: Phàịita.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phả Nại", "definition": "叵奈. Biết làm sao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phả Trắc", "definition": "叵測. Khó biết. Không lường trước được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phả Tín", "definition": "叵信. Không thể tin được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phả Đồng", "definition": "譜桐. Phả là sách chép bài nhạc, đồng là cây đàn mà thùng đàn làm bằng gỗ Ngô đồng. Phả đồng chỉ sách bài đàn. Hoa Tiên có câu: “Viện thơ khung dệt màu thêu, chữ đề thiếp tuyết cầm treo phả đồng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản", "definition": "反. Lật lại Trở về, quay về Tự xét mình. Td: Phản tỉnh Làm ngược lại. Td: Phản bội Mặt trái, bề trái Một âm là Phiên. Xem Phiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Bạn", "definition": "反伴. Làm hại lại người chơi thân với mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Bội", "definition": "反背. Làm ngược lại, xoay lưng lại, ý nói đối xử ngược lại với lúc trước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Chiếu", "definition": "反照. Rọi ngược trở lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Chính", "definition": "反正. Trở về con đường ngay thẳng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Chưởng", "definition": "反掌. Lật bàn tay, ý nói rất dễ dàng, như trở bàn tay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Chứng", "definition": "反證. Cái bằng cớ đưa ra để bác bỏ một bằng cớ khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Cung", "definition": "反供. Nói ngược lại những điều đã khai ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Cố", "definition": "反顧. Quay đầi lại mà nhìn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Diện", "definition": "反面. Mặt trái, bề trái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Gián", "definition": "反間. Làm cho chia rẽ, chống đối lẫn nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Hưởng", "definition": "反響. Tiếng dội, tiếng vang lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Hồi", "definition": "反囘. Quay về, trở về “Vân Tiên chém Cốt Đột rồi, đầu treo cổ ngựa phản hồi bổn quân” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Kháng", "definition": "反抗. Chống cự lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Kinh", "definition": "反經. Trái với lẽ thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Loạn", "definition": "反亂. Gây rối để chống lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Lưu Tứ Vị", "definition": "Cũng gọi Thủy Giác Tứ Vị, Thủy Giác Phản Lưu Tứ Vị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phản Lộ", "definition": "反路. Con đường trở về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Mệnh", "definition": "反命. Trình báo lại cái lệnh đã được thi hành xong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Mục", "definition": "反目. Trái mắt, không chấp nhận được Cũng chỉ vợ chồng bất hoà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Nghịch", "definition": "反逆. Kẻ dưới dùng sức mạnh mà chống lại người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Nhãn", "definition": "反眼. Trở mắt, nhìn đi chỗ khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Phúc", "definition": "反覆. Lật lọng tráo trở Lật qua lật lại xem xét kĩ lưỡng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Phục", "definition": "反服. Người trên để tang cho kẻ dưới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Quang", "definition": "反光. Chiếu sáng trở lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Sao", "definition": "Lật trái mặt trước của ca sa vắt lên vai bên phải.Nam Hải Kí Qui Nội Pháp Truyện quyển 2 (Đại 54, 215 thượng) nói: “Làm việc riêng ở chỗ vắng, được tùy ý phản sao. Nếu đứng trước tôn dung thì cần phải tề chỉnh, vắt góc áo bên phải lên vai trái, cho rủ xuống phía sau lưng, không được vắt lên khuỷu tay”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phản Thủ", "definition": "反手. Như Phản Chưởng 反掌.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Trắc", "definition": "反側. Lật lọng, tráo trở. Văn tế sĩ dân lục tỉnh của Nguyễn Đình Chiểu có câu: “Chẳng qua dân mắc nạn trời, hoài cựu chúa mang lời phản trắc”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Tâm", "definition": "反心. Tấm lòng tráo trở thay đổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Tặc", "definition": "反賊. Quân giặc chống lại nhà nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Tỉnh", "definition": "反省. Quay về mình mà tự xét mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Tố", "definition": "反訴. Kiện ngược trở lại, bị cáo kiện ngược trở lại nguyên cáo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Tục", "definition": "Chỉ cho vị tăng trở về làm người thế tục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phản Xuất Sinh Tử", "definition": "Ra khỏi sinh tử, 1 trong 7 loại sinh tử, do Nhiếp Đại Thừa Luận Sư lập ra. Nghĩa là nếu chúng sinh phát tâm tu hành, bỏ vọng về chân thì có thể ra khỏi sinh tử mà đến Niết Bàn. [X. Chỉ Quán Phụ Hành Truyền Hoằng Quyết Q.7, phần 1; Đại Minh Tam Tạng Pháp Số Q.30]. (xt. Thất Chủng Sinh Tử).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phản Xạ", "definition": "反射. Rọi chiếu lại Chỉ sự đáp ứng của cơ thể trước những kính thích bên ngoài. Sự đáp ứng này tự nhiên và tức khắc, không suy nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Ánh", "definition": "反映. Chiếu ngược trở lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Đối", "definition": "反對. Đưa ra ý kiến chống lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Đồ", "definition": "反徒. Kẻ bội bạc Đứa học trò bội bạc với thầy học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản Động", "definition": "反動. Làm ngược lại với những người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phản ứng", "definition": "反應. Đáp lại, bày tỏ thái độ để đáp lại Hiện tượng phát sinh do tác dụng hoá học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phảng", "definition": "仿. Giống như Y theo. Bắt chước theo Cũng đọc Phỏng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phảng Cổ", "definition": "仿古. Bắt chước theo xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phảng Phất", "definition": "仿佛. Gần giống như Ta còn hiểu là qua lại nhẹ nhàng. Hát nói của Nguyễn Khắc Hiếu có câu: “Gặp gió đây ta hỏi một đôi lời. Ta hỏi gió quen ai mà phảng phất” Hoặc còn hiểu là văng vẳng, nghe xa xa không rõ. Bài Tụng Tây hồ phú của Nguyễn Huy Lượng có câu: “Trước huân phong nghe phảng phất cung đàn, làn thâm thuỷ muốn vang lên ngũ bái”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn", "definition": "坋. Bụi đất Hạt nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Bút", "definition": "粉筆. Cây bút bằng phấn, tức viên phấn, cục phấn (dùng để viết bảng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Chấn", "definition": "奮震. Hăng hái thêm lên. mạnh mẽ lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Cốt Toái Thân", "definition": "粉骨碎身. Tan xương nát mình, ý nói quên cả mạng sống để làm việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Cốt Toái Thân.", "definition": "Xương thịt bị nghiền nát ra như bột. Ý nói vì pháp mà tan xương nát thịt. Trong kinh điển có nhiều chỗ ghi chép các trường hợp vì pháp mà không tiếc thân mệnh, như Bồ Tát Thường đề khi ở Hương thành học Bát Nhã, đập xương lấy tủy đem bán cho trưởng giả lấy vàng mua các thứ hương hoa để cúng dường. Lại như trường hợp Đức Phật Thích Ca văn đã bỏ mình để chỉ cầu được nghe 2 câu kệ (Sinh Diệt Diệt Dĩ, Tịch Diệt Vi Lạc)khi còn ở địa vị tu nhân. [X. Phẩm Tát Đà Ba Luân trong Kinh Đại Phẩm Bát Nhã; Kinh Niết Bàn Q.14 (bản Bắc). (xt. Thường Đề Bồ Tát, Tuyết Sơn Đại Sĩ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phấn Hoa", "definition": "Raja (nam), reṇu (nam) (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phấn Hương", "definition": "粉香. Bột thoa mặt và dầu thơm, hai vật dụng trang điểm của đàn bà con gái Chỉ đàn bà con gái Còn chỉ gái điếm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Khích", "definition": "奮激. Được thúc đẩy mà hăng hái lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Khởi", "definition": "奮起. Nổi dậy mạnh mẽ Hăng hái mạnh mẽ mà làm việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Lực", "definition": "奮力. Gắng sức Sức hăng hái “Phen nầy phấn lực dương uy”. ( Hạnh thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Mặc", "definition": "粉墨. Bột thoa mặt và thứ mực riêng để vẽ mắt. Như Phấn đại 粉黛.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Nhiên", "definition": "奮然. Hăng hái mạnh mẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Phát", "definition": "奮發. Như Phấn khởi 奮起 Phấn phát 奮發: Ra sức tiến lên. “Nhất thinh phấn phát oai lôi, tiên phuông hậu tập trống hồi tấn binh” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Phụ", "definition": "粉父. Chỉ người cha của vị phò mã, tức cha chồng của công chúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Sức", "definition": "粉飾. Thoa phấn vào mặt Trang điểm Làm đẹp ở bề ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Thơm", "definition": "Vilepana (trung), gandhacuṇṇa (trung), cuṇṇaka (trung), vāsacuṇṇa (trung), vāsitaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phấn Toái", "definition": "粉碎. Vỡ nát Nghiền nhỏ thành bột.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Tảo", "definition": "糞 掃. Rác rưởi. Tiết Vân Nham Hòa Thượng trong TĐT q. 5 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phấn Tảo Đôi Đầu, Trùng Thiêm Khạp Thiệm", "definition": "糞 掃 堆 頭 重 添 搕 〖⿰扌䪞〗. Trên đống rác còn bỏ thêm rác rưởi, tỷ dụ vốn có lời nói tri giải còn thêm lời nói tri giải nữa. Mật Am Ngữ Lục:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phấn Từ", "definition": "奮辭. Nói lớn. Lời nói vang dội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Xoa Sau Khi Rửa Ráy", "definition": "Vāsacuṇṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phấn Y", "definition": "奮衣. Rũ áo phủi bụi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Đại", "definition": "粉黛. Phấn để thoa mặt và chì để vẽ mắt, hai vật dụng trang điểm của phụ nữ Chỉ đàn bà con gái. “Uốn cái lưỡi chỉ dày duyên phấn đại”. (Tần cung nữ oán Bát công ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phấn Đấu", "definition": "奮鬥. Hăng hái gắng sức tranh hơn kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phất", "definition": "冹. Rất lạnh vì gió thổi. Cũng nói Tất phất 㓖冹.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phất Bà La Ha", "definition": "Xem Táng Chi Đại Tướng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Bính Tại Thủ", "definition": "拂 柄 在 手. Ý nói trụ trì tự viện, vì chúng thuyết pháp. Tiết Tùng Nguyên Sùng Nhạc Thiền Sư trong TTĐL q. 35 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phất La Bà", "definition": "Xem Táng Chi Đại Tướng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Ngộ", "definition": "弗 遇. X. Phúc Ngộ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phất Nhã Đa La", "definition": "Puṇyatrata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Như Đàn", "definition": "Phất Như Đàn ( ?- ? )…Cũng gọi Pháp Nhiêu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phất Sa", "definition": "I.Phất Sa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phất Sa Bồ Tát", "definition": "Xem Để Sa Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Sa Mật Đa La Vương", "definition": "Puṣpamitra (P), Puṣyamitra (S), Puspamitra (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Sa Phật", "definition": "Xem Để Sa Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Thức", "definition": "拂拭. Phủi quét cho sạch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phất Tri Nhân Sự", "definition": "弗 知 人 事. Chỉ cho chữ Phật. Theo thuật chiết tự, chữ Phật (佛) gồm có chữ Nhân (亻) là người, chữ Phất (弗) là chẳng. Thế nên gọi chữ Phật là Phất tri nhân sự (chẳng biết việc người). Đây là quan niệm của nhà Nho Việt Nam (Nguyễn Cư Trinh) trong tác phẩm Sãi Vãi, câu 135: Suy chữ nọ cho chân, chữ Phật là “Phất tri nhân sự”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phất Trần", "definition": "Vyajana (S), Vijani (P), Valavyajana (S), Vijani (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Trần Khán Tịnh", "definition": "Phủi bụi thấy sạch. Nghĩa là quét sạch bụi nhơ, đánh tan mây mờ để nhận rõ bản lai diện mục. Đây là chủ trương tu hành của ngài Thần Tú thuộc hệ thống Thiền Bắc Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phất Tu Nhĩ", "definition": "Foucher Alfred (1865-1952).Nhà học giả Đông Phương Học và Phật Giáo Sử người Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phất Tích Nhập Huyền", "definition": "Cũng gọi Phát Tích Nhập Nguyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phất Tử", "definition": "Hossu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phất Vu Đại Châu", "definition": "Xem Đông Thắng Thần Châu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phần", "definition": "份. Cái phần đã được chia ra. Cũng đọc là Phận Một âm là Phân. Xem Phân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Biệt Giải Thoát", "definition": "Chỉ có chư Phật mới đạt được cảnh giới giải thoát rốt ráo; tất cả còn lại, từ hàng Bồ-tát trở xuống, sự giải thoát chỉ đạt được từng phần (không rốt ráo) mà thôi, gọi là “phần biệt giải thoát”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phần Châu", "definition": "Feng-chou (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phần Châu Vô Nghiệp", "definition": "Feng chou Wu yeh (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phần Chứng", "definition": "Nghĩa là hàng Bồ Tát từ Sơ Địa trở lên, theo thứ tự tu hành, hễ đoạn trừ 1 phần phiền não thì chứng ngộ được 1 phần Trung Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Chứng Tức", "definition": "Cũng gọi Phần chân tức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Du", "definition": "枌榆. Cây phần và cây du. Lại có thuyết cho rằng Phần du là tên một loài cây bưởi. Dù là một hay hai loài cây, thì Phần du cũng thường được trồng ở vườn nhà, do đó còn chỉ quê nhà, gia đình. Có thuyết lại cho rằng Phần du là cây bưởi và cây dâu. Bài Chiến Tụng Tây hồ phú của Phạm Thái có câu: “Nghĩa chước sợ lây hơi chung đỉnh Nên mình còn nhận dấu phần du” (nhận dấu phần du ý nói còn sống ở quê nhà, không chịu ra làm quan).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Dương Ngũ Môn Cú", "definition": "Năm câu ví dụ cho 5 giai đoạn tu hành Phật đạo, do Thiền Sư Thiện Chiêu ở Phần Dương, thuộc Tông Lâm Tế đời Tống đặt ra. Năm câu ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Tam Cú", "definition": "Ý nói giống như Tổ Đạt Ma thuyết pháp, không có gì trở ngại, lại như vượt qua sông vào Tân La (nước Triều Tiên), theo dòng mà xuôi, thế rất mau lẹ; cũng như thân ở đất Bắc, dùng sắt xứ Bân mà làm dao, rất dễ dàng tiện lợi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Tam Cú.", "definition": "Ba ngữ cú do Thiền Sư Thiện Chiêu ở Phần Dương, thuộc Tông Lâm Tế đời Tống, lập ra để tiếp dẫn người học.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Tam Quyết", "definition": "Ba loại cơ pháp do Thiền Sư Thiện Chiêu, thuộc Tông Lâm Tế đời Tống ở Phần Dương đặt ra để dẫn dắt người học.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Thiện Chiêu", "definition": "Funyō zenshō (J), Fenyang Shanzhao (C), Fenyang Shanzhao (C), Fun'yo Zensho (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phần Dương Thập Bát Vấn", "definition": "Thiền Sư Thiện Chiêu thuộc Tông Lâm Tế đời Tống, ở Phần Dương, đem những vấn đề do người học hỏi thầy, chia làm 18 loại, Thiền Lâm gọi là Phần Dương Thập Bát Vấn. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Thập Trí Đồng Chân", "definition": "Mười thứ trí mà bậc thầy phải có để dẫn đắt người học, do Thiền Sư Thiện Chiêu thuộc Tông Lâm Tế đời Tống, ở Phần Dương chủ trương. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Trụ Trượng", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Tứ Cú.", "definition": "Bốn câu do Thiền Sư Thiện Chiêu thuộc Tông Lâm Tế đời Tống, ở Phần Dương đặt ra để khám nghiệm người học. Bốn câu ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Vãn Tham", "definition": "Vãn tham là tham học vào buổi chiều. Trong Thiền Lâm, Vãn tham do Thiền Sư Thiện Chiêu thuộc Tông Lâm Tế đời Tống, ở Phần Dương, thực hành, vì thế nên gọi là Phần Dương vãn tham. [X. chương Dương Kì Phương Hội trong Gia Thái Phổ Đăng Lục Q.3].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dương Vô Đức Thiền Sư Ngữ Lục", "definition": "Cũng gọi Phần Dương Thiện Chiêu Thiền Sư Ngữ Lục, Vô Đức Hòa Thượng Ngữ Lục, Phần Dương Lục.Ngữ Lục, 3 quyển, do ngài Sở Viên biên tập vào đời Tống, được thu vào Đại Chính Tạng tập 47.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Dụ", "definition": "Thí Dụ một phần. Tức thí dụ chỉ mới so sánh được 1 phần ý nghĩa của 1 pháp, chứ chưa nêu rõ được toàn bộ ý nghĩa của pháp ấy, gọi là Phần dụ. Như nói “mặt như trăng tròn” là dùng vầng trăng đầy đặn để so sánh với khuôn mặt đầy đặn, chứ không phải nói khuôn mặt tròn như mặt trăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Giáp Đầu Gối", "definition": "Jaṅgheyya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phần Hương", "definition": "枌鄉. Làng trồng cây bưởi, chỉ quê nhà. Hoa Tiên có câu: “Tình kiều tử dạ phần hương, dù cay đắng cũng phận thường nghĩ nao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Khí", "definition": "焚棄. Đốt bỏ đi, không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Kinh Đài", "definition": "Đài đốt kinh. Đây là nơi mà vào thời vua Minh Đế nhà Hán, đạo Phật và đạo Lão đốt kinh để xem đạo nào chân thật, đạo nào không chân thật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Kíp", "definition": "焚刧. Đốt phá cướp bóc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Lan", "definition": "枌蘭. Tên nước cộng hoà ở Bắc Âu (Finlande).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Lược", "definition": "焚掠. Đốt phá, cướp bóc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Mộ", "definition": "墳墓. Chỉ chung mồ mả. “Thưa rằng: Hoạn nạn xiết bao, mẹ tôi phần mộ nơi nào viếng an”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Ngoài", "definition": "Bahiddhā (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phần Nhiều", "definition": "Yebhuyya (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phần Như", "definition": "焚如. Tai nạn cháy nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Nịch", "definition": "焚溺. Cháy nhà và chết đuối. Chỉ chung tai nạn, cũng chỉ cảnh khốn khổ trong nước mà dân chúng phải chịu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Thư", "definition": "焚書. Đốt sách vở. Chỉ tội ác của Tần Thuỷ Hoàng thời xưa, đó là tội ác Phần thư khanh nho (đốt sách, chôn học trò).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Trang bao trong Thiền Uyển Thanh Qui quyển 1 (Vạn Tục 111, 439 thượng) nói: “Khi vào chùa, phải bỏ nón xuống để ở ngoài cửa Tam quan”.", "definition": "III.Nhập Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Trước", "definition": "Pubbabhāga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phần Tu", "definition": "焚修. Đốt nhang mà sửa mình. Chỉ sự tu hành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Tử", "definition": "分子. Cái cấu tạo thành một toàn thể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phần Vị", "definition": "Chỉ cho thời phần và địa vị của mỗi sự vật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần tự thuyết ở đầu 1 bộ kinh, gọi là Khai Kinh. Còn phần cuối là phần kết luận tổng quát yếu chỉ của bộ kinh, thì gọi là Kết Kinh. Khai kinh, kết kinh gọi chung là Khai kết. Như phần khai kinh của Kinh Pháp Hoa là chỉ cho Kinh Vô Lượng Nghĩa, còn phần kết kinh thì chỉ cho Phẩm Quán Phổ Hiền. [X. Chú Vô Lượng Nghĩa Kinh Q.1].", "definition": "II.Khai Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Đoạn Luân Hồi", "definition": "Chỉ cho sự sống chết xoay vòng của chúng sinh trong ba cõi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Đoạn Sanh Tử", "definition": "(分段生死): Phật Giáo chia sanh tử của chúng sanh làm 2 loại: Phần Đoạn Sanh Tử và Biến Dị Sanh Tử (變異生死). Phần Đoạn Sanh Tử, còn gọi là Phần Đoạn Tử (分段死), Hữu Vi Sanh Tử (有爲生死), đối xưng với Biến Dị Sanh Tử, tức chỉ chúng sanh mỗi đời quả báo chiêu cảm không giống nhau, cho nên hình tướng, thọ mạng cũng khác nhau; đó được gọi là Phần Đoạn Thân (分段身). Sau khi thọ thân này, tất phải có một lần kết thúc sinh mạng, vì vậy có tên là Phần Đoạn Sanh Tử. Trong kinh điển Phật Giáo có rất nhiều ví dụ về sanh tử. Như Câu Xá Luận (俱舍論) ví sanh tử như bùn: “Sanh tử nê giả, do bỉ sanh tử, thị chư chúng sanh trầm nịch xứ cố, nan khả xuất cố, sở dĩ thí nê (生死泥者、由彼生死、是諸眾生沉溺處故、難可出故、所以譬泥, bùn sanh tử là do sanh tử ấy, là nơi chúng sanh bị chìm đắm, khó có thể ra được, vì vậy mới ví như bùn).” Thành Duy Thức Luận (成唯識論) thì ví như đêm dài: “Vị đắc chơn giác, hằng xử mộng trung, cố Phật thuyết vi sanh tử trường dạ (未得眞覺、恆處夢中、故佛說爲生死長夜, chưa được chánh giác, thường ở trong mộng, cho nên Phật dạy sanh tử là đêm dài).” Trong Phật Sở Hành Tán (佛所行讚) lại cho sanh tử là biển cả: “Đương thừa trí tuệ chu, siêu độ sanh tử hải (當乘智慧舟、超度生死海, phải lên thuyền trí tuệ, vượt qua biển sanh tử).” Hay Vô Lượng Thọ Kinh (無量壽經) thì xem sanh tử như là đám mây mù: “Huệ nhật chiếu thế gian, tiêu trừ sanh tử vân (慧日照世間、消除生死雲, trời tuệ chiếu thế gian, tiêu trừ mây sanh tử).” Trong khi đó, Đại Trí Độ Luận (大智度論) ví sanh tử là bánh xe: “Sanh tử luân tải nhân, chư phiền não kiết sử, đại lực tự tại chuyển, vô nhân năng cấm chỉ (生死輪載人、諸煩惱結使、大力自在轉、無人能禁止, xe sanh tử chở người, các phiền não kiết sử, lực lớn tùy ý chuyển, chẳng ai ngăn cấm được).” Hoặc Vãng Sanh Luận Chú (徃生論註) lại ví dụ sanh tử là khu vườn: “Thị ứng hóa thân, hồi nhập sanh tử viên, phiền não lâm trung du hí thần thông (示應化身，迴入生死園、煩惱林中遊戲神通, hiện thân ứng hóa, trở lại vào vườn sanh tử, thần thông rong chơi trong rừng phiền não).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phần Đoạn Sinh Tử", "definition": "Tất cả chúng sinh trong ba cõi sáu đường, do chiêu cảm các nghiệp lành dữ mà mạng sống đều có phần hạn (phần), thân hình đều có tướng trạng, kích thước (đoạn) khác nhau, cho nên sự sinh tử của chúng sinh được gọi là “phần đoạn sinh tử”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phần Đoạn Tam Đạo", "definition": "Chỉ cho 3 đường mê muội: Hoặc, Nghiệp và Khổ. Phần đoạn nghĩa là phân biệt, đặc biệt chỉ cho tướng sai khác của quả báo hiển hiện ra bên ngoài, như hình dáng, tuổi thọ... Vì quả báo trong 3 đường Hoặc, Nghiệp và Khổ khác nhau, nên có tướng sai biệt về hình dáng, cho nên gọi 3 đường ấy là “Phần đoạn tam đạo”. đại khái, ý nói trong 3 đường mỗi đường đều có sự khác nhau về mặt quả báo. Tông Thiên Thai căn cứ vào nghĩa xoay vòng của 3 đường này mà nói về sự sai khác của Tam đạo, tức gọi Kiến, Tư Hoặc là Phiền não đạo, gọi phiền não nhuận nghiệp là Nghiệp đạo và gọi sự chiêu cảm sinh tử trong 3 cõi là Khổ đạo. (xt. Tam Đạo).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Đoạn Thân", "definition": "Chỉ cho thân phần đoạn sinh tử, tức thân của Phàm Phu luân hồi trong 6 đường, chịu các thứ quả báo khác nhau, như tuổi thọ có dài ngắn, hình thể có lớn nhỏ...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Đoạn Đồng Cư", "definition": "Phần đoạn là gọi tắt của Phần Đoạn Sinh Tử Thân, tức chỉ cho thân thể con người.Phần đoạn nghĩa là do quả báo khác nhau mà có thân tướng và tuổi thọ khác nhau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phần Đông", "definition": "Yebhuyyena (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phầu", "definition": "抔. Thò tay bốc. Cũng đọc Bồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm", "definition": "Varga (S), Vagga (P), Vakya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Ba Dật Đề", "definition": "Pacittiya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Ba La Di", "definition": "Pārājika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Bình", "definition": "品評. Bàn bạc khen chê. Cũng như Bình phẩm Phẩm bình: 品評 Chung vinh: 鍾嶸 đời Nam Bắc triều bên Tàu soạn ba quyển thơ, liệt các bài ngũ ngôn từ đời Hán đời Nguỵ 103 nhà, theo sự phê bình hơn kém mà chia ra làm 3 phẩm: Thượng, trung, hạ. Sau người ta quen dùng hai chữ Phẩm bình để nói chuyện thơ. “Tây hồ tiên tích mấy nơi phẩm bình” (B. C. K. N.).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Bỉ Ngạn Đạo", "definition": "Parayānavagga (P), The Chapter on the Way to the Far Shore (chapter SN V).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Bồ Đề Tâm Hồi Hướng", "definition": "Pariṇāmāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Bồ Đề Tâm Nhẫn Nhục", "definition": "Kṣānti-pāramitā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Bồ Đề Tâm Thí Cúng Dường", "definition": "Papadesana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Bồ Đề Tâm Tinh Tấn Ba La Mật Đa", "definition": "Xem Tinh Tấn Ba La Mật. Tên một trong 8 phẩm của Bồ Đề Hạnh Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Bồ Đề Tâm Tĩnh Lự Bát Nhã Ba La Mật", "definition": "Dhyāna Pāramitā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Chất", "definition": "品質. Cái tinh chất của một vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Chức", "definition": "品職. Giá trị đạo đức và công việc đảm nhiệm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Cách", "definition": "品格. Cái giá trị bày lộ ở bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Cấp", "definition": "品級. Thứ bậc cao thấp của quan lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Hàm", "definition": "品銜. Thứ bậc cao thấp của quan lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Hạnh", "definition": "行品. Nết tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Hộ Giới", "definition": "Saṃprājanyaraksana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Loại", "definition": "品類. Loài, thứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Loại Túc Luận", "definition": "Prākāraṇapada (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Lưu", "definition": "品流. Thứ hạng cao thấp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Mạo", "definition": "品貌. Tài đức và mặt mũi dáng dấp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Mật Ấn Kinh Đại Nhật (Đại 18, 30 thượng), nói: “Nên biết thân thể cử động hay bất động đều là Mật Ấn; những lời uyển chuyển nói ra đều là Chân Ngôn”.", "definition": "II.Mật Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Nghĩa", "definition": "Aṭṭhaka vagga (P), The Octet Chapter (chapter SN IV).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Pháp Sư Kinh Pháp Hoa (Đại 9, 31 trung) nói: “Nếu những nơi nào có kinh điển này, hàng ngày giảng nói, đọc tụng, viết chép, thì nên xây tháp bảy báu để tôn thờ mà không cần phải an trí xá lợi.Vì sao? Vì trong đó đã có toàn thân của Đức Như Lai.Nên đem hoa, hương, anh lạc, lọng lụa, cờ phướn, kĩ nhạc, cúng dường, cung kính, tôn trọng, khen ngợi tháp ấy”. [X. Đại Đường Tây Vực Kí Q.9].", "definition": "II.Pháp Xá Lợi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Pháp Thân trong Kinh Nhập Lăng Già quyển 7 (Đại 16, 550 trung) nói: “Đại Tuệ! Giữa Pháp Thân Như Lai và 5 ấm khác nhau thì có 2 pháp, thể tướng không đồng, như 2 cái sừng của con bò, tuy giống nhau nhưng lại thấy có thể riêng, dài ngắn khác nhau. Đại Tuệ! Như vậy, đáng lẽ tất cả các pháp không khác nhau mà lại có khác nhau, như cái sừng bên trái của con bò khác với sừng bênphải, sừng bên phải khác với sừng bên trái.Các pháp cũng như thế”. [X.hội Thụ Huyễn Sư Bạt Đà La Kí trong Kinh Đại Bảo Tích Q.85; Luận Đại Trí Độ Q.35, Khởi Tín Luận Sớ Q.thượng].", "definition": "II.Sai Biệt. Phạm: Viziwỉa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Phật Quốc trong Kinh Duy Ma (Đại 14, 519 hạ), nói: “Lúc đầu, Đức Phật ngồi dưới gốc cây Bồ Đề dùng sức định hàng phục ma vương, được cam lộ diệt, giác đạo thành tựu”.", "definition": "II.Giác Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Phật Quốc trong Kinh Duy Ma Cật Sở Thuyết quyển thượng (Đại 14, 538 thượng) nói: “Bồ Tát ở cõi nước thanh tịnh đều là nhiêu ích cho các chúng sinh”.", "definition": "II.Nhiêu Ích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Phổ Hiền Hành Nguyện trong Kinh Hoa Nghiêm quyển 40 (Đại 10, 845 thượng) nói: “Thiện nam tử! Trong các thứ cúng dường, cúng dường pháp là hơn hết”.", "definition": "II.Pháp Cúng Dường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Phổ Môn", "definition": "Xem Quán Thế Âm Phổ Môn Phẩm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Phục", "definition": "品服. Áo của các quan, phân biệt thứ bậc cao thấp đã định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Thành tựu chư vật tướng Kinh Tô Tất Địa Yết La quyển trung (Đại 18-622 hạ), nói: “Nếu muốn thành tựu Đao pháp, thì phải dùng dao bằng thép, dài 2 khuỷu tay, rộng bằng 4 ngón út, nhẫn nhụi, mầu xanh biếc”. [X. Phẩm Tất Địa Xuất Hiện Kinh Đại Nhật Q.3; Tuệ Lâm Âm Nghĩa Q.36; Phạm Ngữ Tạp Danh].", "definition": "II.Khát Già.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Thí Dụ Kinh Pháp Hoa (Đại 9, 14 hạ) nói: “Ba cõi (tam giới) không yên ổn, giống như căn nhà lửa, chúng sinh chịu toàn khổ não, rất đáng sợ hãi”. [X. Kinh Đại Bát Niết Bàn Q.13; (bản Nam); Luận Câu Xá Q.8; Luận Phẩm Loại Tác Q.5; Luận Đại Tì Bà Sa Q.75; Luận Du Già Sư Địa Q.4; Đại Trí Độ Q.21; Hoa Nghiêm Kinh Khổng Mục Chương Q.2]. (xt. Cửu Địa, Sắc Giới, Dục Giới, Vô Sắc Giới).", "definition": "II.Tam Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Thí Dụ trong Kinh Pháp Hoa (Đại 9, 14 hạ) nói: “Tất cả chúng sinh trong ấy đều là con ta (...) chỉ 1 mình ta (Nhất nhân) có năng lực cứu được”.", "definition": "I.Nhất Nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Thích Tự Mẫu trong Kinh Kim Cương Đính cho rằng, chữ Ma tức biểu thị nghĩa vào các pháp “ngã sở” là bất khả đắc. Phẩm Thị Thư trong Kinh Phương Quảng Đại Trang Nghiêm quyển 4 thì cho rằng, khi xướng chữ Ma có thể phát ra âm thanh tiêu diệt tất cả sự kiêu mạn. Kinh Hoa Nghiêm quyển 33 (bản dịch cũ) nói, khi xướng chữ Ma thì nhập vào môn Bát Nhã Ba La Mật. Còn Phẩm Tập Học Kĩ Nghệ trong Kinh Phật Bản Hạnh Tập quyển 11 thì nói (Đại 3, 704 trung): “Khi xướng chữ Ma thì phát ra âm thanh nói về sinh tử là tất cả sự khủng bố rất đáng sợ” v.v... Sở Dĩ chữ Ma có các nghĩa trên là vì những tiếng Phạm mamatà (ngã), mamakàra (ngã sở = của ta), mada (kiêu mạn) v.v... đều bắt đầu bằng chữ “ma”. [X. Phẩm Quảng Thừa trong Kinh Đại Phẩm Bát Nhã Q.5; Phẩm Đà La Ni trong Kinh Phóng Quang Bát Nhã Q.4; Phẩm Tự Mẫu trong Kinh Văn Thù Sư Lợi Vấn Q.thượng; Kinh Đại Bát Niết Bàn Q.8 (bản Bắc); Phẩm Cụ Duyên trong Kinh Đại Nhật Q.2].", "definition": "IV. Ma", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Tiết", "definition": "品節. Nết tốt và lòng ngay thẳng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Toát Yếu", "definition": "Parivarga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Trật", "definition": "品秩. Thứ bậc trên dưới của quan lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Tán Bồ Đề Tâm", "definition": "Bodhi-citta saṃsa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Tính", "definition": "品性. Nết tốt Tính chất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Tựa Kinh Pháp Hoa (Đại 9, 3 thượng) nói: “Ta thấy hằng sa Bồ Tát ở cõi ấy, có nhiều nhân duyên để cầu Phật đạo”. [X. Đại Thừa Nghĩa Chương Q.18].", "definition": "II.Phật Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Tựa Kinh Pháp Hoa quyển 1 (Đại 9, 2 trung) nói: “Tất cả đều lễ chân Đức Phật, rồi lui ra ngồi ở một phía”.", "definition": "III.Nhất Diện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩm Vương Thọ Ký", "definition": "Rājavyākaraṅa-parivarta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Vật", "definition": "品物. Món đồ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Vị", "definition": "品位. Đức hạnh và ngôi thứ xã hội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Xà", "definition": "Uraga-vagga (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẩm Đề", "definition": "品題. Viết ra để bàn bạc khen chê. Hát nói của Nguyễn Công Trứ có câu: “Thơ một túi phẩm đề câu nguyệt lộ, rượu ba chung tiêu sái cuộc yên hà”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Đệ", "definition": "品笫. Thứ bậc cao thấp trên dưới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩm Đệ tử trong Kinh Tăng Nhất A Hàm quyển 3 (Đại 2, 557 thượng), nói: “Mau chóng thành tựu thần thông, trong đó không có hối tiếc, chính là Tỉ Khưu Ma Ha Nam”. [X. Kinh Thị Giả trong Trung A Hàm Q.8; Kinh Quá Khứ Hiện Tại Nhân Quả Q.3; Luật Tứ Phần Q.32; Luận Đại Tì Bà Sa Q.182; Pháp Hoa Văn Cú Q.1, thượng, Đại Đường Tây Vực Kí Q.7].", "definition": "II.Ma Ha Nam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩn", "definition": "糞. Trừ bỏ đi Xấu xa, thấp hèn, phân bón ruộng Cũng còn chỉ phân người ( cứt ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩn Quả", "definition": "Chỉ cho trái cây ở trong đống phân, có kẻ lấy ra rồi lại bỏ đi, ví dụ cho tâm thích sống, ghét chết của Phàm Phu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩn Thổ", "definition": "糞土. Đất được bón phân Chỉ sự xấu xa thấp hèn, đáng ghét, như đất, như phân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩn Trừ", "definition": "糞除. Diệt bỏ đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẩn Tảo Y", "definition": "Phạm: Pàôsu-kùla. Pàli: Paôsu-kùla.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẩu Quyết", "definition": "剖 決. Phán định rõ ràng. Tiết Tuyết Đậu Tự Tông Thiền Sư trong NĐHN q. 14 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phẫn", "definition": "Krodha (S), Anger, Kodha (P)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẫn Khí", "definition": "憤氣. Hơi giận bốc lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Khích", "definition": "憤激. Nổi giận vì bị khêu chọc bởi sự việc ngang trái bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Ngôn", "definition": "憤言. Lời nói chứa niềm oán giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Nộ", "definition": "Xem Sân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẫn Nộ Câu Quan Thế Âm Bồ Tát", "definition": "Phạm: Amogha-krodhàíkuza-ràja.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẫn Nộ Câu Quán Thế Âm Bồ Tát", "definition": "Amogha-krodhāṇkuśa-rāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẫn Nộ Nguyêt Yểm Bồ Tát", "definition": "Phẫn nộ nguyệt yểm. Phạm: Krodhacandra- tilaka.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẫn Nộ Nhãn", "definition": "Mắt giận dữ, 1 trong 3 loại mắt trong pháp Du Già của Mật Giáo. Đây là mắt của các vị tôn Minh Vương trợn trừng, vẻ giận dữ, uy mãnh để hàng phục bọn quân ma phiền não.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẫn Nộ Quyền", "definition": "Nắm tay giận dữ, 1 trong 6 loại ấn nắm tay (Quyền ấn) của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẫn Nộ Trì Kim Cang Bồ Tát", "definition": "Vajragra-Vajadhrah (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẫn Nộ Trì Kim Cương Bồ Tát", "definition": "Phạm: Vajràgra-vajradhara.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẫn Nộ Tướng", "definition": "Đối lại: Từ bi tướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phẫn Nộ Vương", "definition": "Heruka (S), trak thung (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phẫn Oán", "definition": "憤怨. Giận, ghét. Giận hờn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Quân", "definition": "僨軍. Toán lính bại trận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Sự", "definition": "僨事. Việc thất bại, không thành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Thán", "definition": "憤歎. Giận hờn than thở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Thế", "definition": "憤世. Giận đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Tâm", "definition": "憤心. Lòng giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫn Tật", "definition": "憤疾. Giận ghét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫu", "definition": "剖. Dùng dao mà bổ ra Mổ xẻ. Td: Giải phẫu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫu Lộ", "definition": "剖 露. Biểu lộ tâm đắc của mình khi tham thiền với hy vọng được thiền sư ấn chứng cho. Tiết Thế Kỳ Thủ tọa trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phẫu Quyết", "definition": "剖決. Như Phẫu đoán 剖斷.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫu Tâm", "definition": "剖心. Mổ tim ra. Ý nói bày tỏ hết lòng thành thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫu Tích", "definition": "剖析. Mổ xẻ tìm hiểu để phân biệt rõ ràng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phẫu Đoán", "definition": "剖斷. Mổ xẻ sự việc để tìm biết và quyết định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận", "definition": "分. Các phần mà trời đã chia sẵn cho mỗi người, chỉ cuộc đời một người. Đoạn trường tân thanh có câu:”Hoa trôi bèo giạt đã đành, biết duyên mình biết phận mình thế thôi” Địa vị trong xã hội. Td: Chức phận các âm khác là Phân, Phần. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Duyên", "definition": "分緣. Cái phần trời chia sẵn cho mỗi người và những ràng buộc đã được định sẵn giữa mỗi người với cuộc đời. Chỉ cuộc sống đã được định sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Hạn", "definition": "分限. Cái ranh giới quyền lực thuộc về chức vụ của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Mệnh", "definition": "分命. Chỉ cuộc đời của mỗi người, coi như cái phần trời đã dành sẵn cho mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Ngoại", "definition": "分外. Không thuộc chức vụ của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Số", "definition": "分數. Như Phận mệnh 分命.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Sự", "definition": "分事. Công việc thuộc về phần vụ của mình. Hát nói của Nguyễn Công Trứ có câu: “ Trong vũ trụ đã đành phận sự, phải có danh mà đối với núi sông”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phận Sự Nên Làm", "definition": "Kattabba (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phật", "definition": "Butsu-da (J), Butsu (J), Buddho (P), Buddha (S), Sangs Rgyas (T), Bul (K), Awakened One.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật A Di Đà", "definition": "Bouddha Amitabha Amitabha Budha 阿彌陀佛 Amitābha Budha", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phật A Di Đà khi lễ bái Ngài.", "definition": "VIII.Tam Lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật A Lợi Sá", "definition": "Arittha (P), Ariṣṭa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật A Súc Bệ", "definition": "Akkhobbha-buddha (P), mi bskyod pa (T),Akṣobhya (S), Imperturbable Buddha, Akkhobbha-Buddha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật A Súc Tỳ Hoan Hỷ Quang", "definition": "Buddha of Imperturbable-Joy Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật A-Lợi-Sá", "definition": "Arittha (P), Ariṣṭa (S).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Ba Đời", "definition": "Buddha of the three existences", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phật Bào Cái Chiếu Không Tự Tại Vương", "definition": "Buddha of Sovereign King of the Precious Canopy Which Illumines Space.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Bát", "definition": "Cũng gọi Phật Bát Vu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Bát Niết Bàn Kinh", "definition": "S. Nirvana sutra hay Mahaparinirvana sutra. Bộ Kinh rất quan trọng kể sự kiện Phật nhập Niết Bàn. Trong Kinh tạng Pali, đó là Kinh Đại Bát Niết Bàn (P. Mahaparinibbanasuttanta), thuộc Trường Bộ Kinh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Bát Thế La", "definition": "S. Purvasailah. Một trong các bộ phái Phật giáo, xuất hiện trong thời Phật giáo bộ phái, khoảng 100 năm sau Phật nhập Niết Bàn. Bộ phái này thuộc Đại Chúng bộ hệ (Mahasanghikas, x. Đại Chúng bộ). Cũng gọi là Đông Sơn Trụ Bộ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Bát Ấn", "definition": "Cũng gọi Như Lai Bát, Thích Ca Đại Bát, Bát Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Bản Hạnh Tập Kinh", "definition": "Abhiniṣkramaṇa Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Bản Hạnh Tập Kinh Dị Bản", "definition": "Xem Đại Sự Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Bảo", "definition": "Buddha-ratna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Bảo Bồ Tát Hoa đức: Thiện nam tử! Tam Muội này gọi là Hiện nhất thiết sắc thân, Bồ Tát Diệu Âm trụ trong Tam Muội này nên mới có năng lực lợi ích vô lượng chúng sinh như thế”.", "definition": "II.Phổ Hiện Sắc Thân Tam Muội.Cũng gọi Phổ Nhãn Tam Muội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Bất Động Trí Quang", "definition": "Buddha of Unshakable Insight.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Bổn Hạnh Tập Kinh", "definition": "Fo-pen-hsing-chi ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Bổng Chi Tranh", "definition": "Sự tranh luận giữa Phật Giáo và Bổng Giáo tại Tây Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Bộ", "definition": "Cũng gọi Như Lai Bộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Bộ Chủ", "definition": "Trong Mật Giáo, Phật Bộ chủ có 2 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Bộ Tam Muội Da Ấn", "definition": "Cũng gọi Pháp Giới Tháp Ấn.Ấn Tam Muội Da của Phật Bộ, 1 trong 5 loại ấn ngôn của pháp Hộ thân trong Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ca Diếp", "definition": "Một vị cổ Phật, là một trong bảy đức Phật đã từng giáo hóa ở cõi đời này trước Phật Thích Ca.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Chiên Đàn Khốt Trang Nghiêm Thắng", "definition": "Buddha of Gloriously Adorned Excellence of the Sandalwood Cave.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Chiên Đàn Quang", "definition": "Buddha of SandalWood Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Chiếu Quang Hòa Thượng Ngữ Yếu", "definition": "Ngữ Lục, 1 quyển, do ngài Chuyết Am Đức Quang thuộc Tông Lâm Tế soạn vào đời Tống, ấn hành vào năm Gia Hi thứ 5 (1238), được thu vào Tục Cổ Tôn Túc Ngữ Yếu quyển 5 trong Vạn Tục Tạng 119.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Chiếu Thiền Sư", "definition": "佛 照 禪 師. Hiệu của Thiền tăng Đức Quang, do vua Tống Hiếu Tông ban cho. X. Đức Quang.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Chiếu Thiền Sư Ngữ Lục", "definition": "Tên đầy đủ: Phật Chiếu Thiền Sư Trụ Tuệ Nhật Sơn Đông Phúc Thiền Tự Ngữ Lục. Cũng gọi: Bạch Vân Tuệ Hiểu Thiền Sư Ngữ Lục. Ngữ Lục, 2 quyển, do ngài Bạch Vân Tuệ Hiểu (1223-1297), người Nhật soạn, Hư Thất Hi Bạch Biên Tập, được thu vào Đại Chính Tạng tập 80.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Chính Pháp Nhãn Tạng", "definition": "Chỉ cho giáo pháp chân chính của đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Chủng", "definition": "Xem Kinh Phật Sự.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Chủng Tánh Chú Sở", "definition": "Buddhavaṃ-satthakatha tika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Chủng Tính Kinh", "definition": "Pàli: Buddha-vaôsa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Chủng Tộc", "definition": "Dòng họ của Phật, có 2 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Cung", "definition": "(佛宮): cung điện thờ Phật, tức chỉ cho tự viện Phật Giáo; tương đương với Phạm cung (梵宮), Phạm vũ (梵宇), Phạm sát (梵刹). Như trong Tử Bá Tôn Giả Toàn Tập (紫柏尊者全集, 卍Tục Tạng Kinh Vol. 73, No. 1452) quyển 28 có bài thơ Quá Hướng Thành Quảng Phước Tự (過向城廣福寺) rằng: “Vạn thốc vân sơn ủng Phật cung, tuyền đề tảo tỉnh thảo lai phong, tịch dương khư lạc hướng thành Bắc, kỉ độ chung thanh tống vãn phong (萬簇雲山擁佛宮、璇題藻井草萊封、夕陽墟落向城北、幾度鐘聲送晚風, vạn cụm núi mây ôm Phật cung, biển ngọc phù điêu cỏ xanh um, bóng chiều thành cũ xuôi về Bắc, mấy độ chuông chùa theo gió ngân).” Hay trong Quảng Thanh Lương Truyện (廣清涼傳, Taishō Vol. 51, No. 2099) quyển Hạ có câu: “Nhân tức sáng hưng Phạm vũ, đế cấu Phật cung, thập hữu thất niên bất hạ phong đảnh, Thiền tụng tinh cần, thốn âm vô phế (因卽創興梵宇、締搆佛宮、十有七年不下峰頂、禪誦精勤、寸陰無廢, nhân đó mà sáng lập Phạm vũ, xây dựng Phật điện, trong vòng mười bảy năm không xuống đỉnh núi, hành Thiền tinh tấn, thời gian không bỏ phí).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Cúng", "definition": "Cũng gọi Phật Hướng, Phật Phạn, Thục Phật Cúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Cảnh", "definition": "佛境. Nơi Phật ở Ngôi chùa Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Cảnh Giới Trang Nghiêm Tam Muội", "definition": "Tam Muội của Bồ Tát Phổ Hiền. Phổ Hiền tượng trưng cho Đại Nhật Như Lai đầy đủ muôn hạnh, dùng Đại Bi Thai Tạng mạn đồ la phổ hiện sắc thân, đầy khắp hư không pháp giới, tu hành hạnh Bồ Tát, trang nghiêm các cõi Phật, thành tựu tất cả chúng sinh, hiện khởi 1 thiện căn nhưng tùy theo đó mà đầy đủ muôn đức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Cốt Tông", "definition": "Tông xương Phật. Từ ngữ này được dùng với ý mỉa mai để chỉ cho những người chấp trước vào Phật Tâm Tông (tông tim Phật). Phật Tâm Tông là tên khác của Thiền Tông. Bởi vì Thiền Tông vốn không coi trọng kinh điển văn tự mà lấy việc trực tiếp truyền trao tâm ấn của Phật làm tông chỉ, cho nên các kinh điển quan trọng của Thiền Tông như Lục Tổ Đàn Kinh, Bích Nham Lục cho đến lịch Đại Tổ Sư, Tông sư đều gọi Thiền Tông là Phật Tâm Tông. Nhưng gọi lâu thành quen, không khỏi rơi vào lối mòn khuôn sáo, cố chấp, thiên lệch, hẹp hòi, cứ mải mê bám lấy danh tướng, ngữ ý của nhóm từ “Phật Tâm Tông”, mà quên đi cái tinh thần cơ bản vốn hoạt bát, sinh động, nhậm vận tự do, minh tâm kiến tính của Thiền. Chính vì muốn đả phá cái lề thói mê chấp ấy, nên nhiều tên gọi tương tự mang ý vị châm biếm như: Phật cốt tông, Phật thân tông, Phật Nhãn Tông (tông mắt Phật), Phật tủy tông, cho đến Phật cước tong (tông chân Phật), Phật nhĩ tông (tông tai Phật), Phật Tị Tông (tông mũi Phật), Phật thiệt tong (tông lưỡi Phật)... đã phương tiện được đặt ra với mục đích chế diễu để thức tỉnh những Thiền Giả chấp mê. Như tổ Vĩnh Bình Đạo Nguyên của Tông Tào Động Nhật Bản, 1 đời đề xướng tọa thiền là Phật Pháp chính truyền, cũng phản đối những tên gọi như Thiền Tông, Đạt Ma Tông, Phật Tâm Tông... cho đó đều là lời nói khuôn sáo, phô trương, hư dối của bọn thiền đồ tầm thường. [X. Chính Pháp Nhãn Tạng Phật đạo].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Cụ", "definition": "Cũng gọi Pháp Cụ, Phật Khí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Cụ Cửu Não", "definition": "佛具九惱 (Đại Trí Độ Luận và Hưng khởi hành kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Danh Hội", "definition": "Cũng gọi Phật Danh Sám Hối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Danh Kinh", "definition": "Kinh, 12 quyển, do ngài Bồ Đề Lưu Chi dịch vào đời Nguyên Ngụy, được thu vào Đại Chính Tạng tập 14.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Di Lặc", "definition": "Mirokou (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Di Lặc Tiên Quang", "definition": "Buddha of Sagely Light of Loving Kindness.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Diên Thượng Quát Kim", "definition": "Cạo lấy lớp vàng mạ trên mặt tượng Phật. Câu ngạn ngữ này dùng để ví dụ cho kẻ nhắm vào bậc tôn trưởng để đòi hỏi tiền của, hàm trách những người làm việc dối trá; hoặc vídụ người có tâm tham dùng mọi thủ đoạn bóc lột của cải người khác; không việc xấu xa nào mà chẳng làm; cũng hàm ý quở trách những kẻ làm việc cực ác, không từ 1 chút gì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Diệt", "definition": "Cũng gọi Tịch Diệt, Viên Tịch, Đại Viên Tịch (Phạm: Mahà-parinirvàịa, Pàli: Mahà-parinibbàna).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Diệt Niên Đại", "definition": "Niên Đại Phật nhập diệt. Tư liệu về niên đại Đức Phật nhập diệt thì từ xưa thường dùng thuyết “Chúng Thánh Điểm Kí” (các bậc Thánh ghi dấu chấm). Nghĩa là năm Đức Phật nhập diệt, sau khi kết tập tạng Luật, đúng vào ngày chư tăng Tự Tứ năm ấy, Tôn Giả Ưu Bà Li - người tụng tạng Luật trong lần kếttập đầu tiên - ghi 1 cái chấm (điểm) ở đầu tạng Luật để đánh dấu năm Đức Phật nhập Niết Bàn. Từ đó về sau, hàng năm, vào ngày kết thúc An Cư (ngày chư tăng Tự Tứ), các vị Trưởng lão lại thắp hương rồi ghi thêm 1 cái chấm vào tạng Luật để ghi nhớ 1 năm đã qua, gọi là Chúng Thánh Điểm Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Diệu Âm Thắng", "definition": "Buddha of Sublime Sound.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Duyên", "definition": "Cũng gọi Phật Nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Dĩ Nhất Âm Diễn Thuyết Pháp", "definition": "Đối lại: Chúng Sinh tùy loại các đắc giải.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Gia", "definition": "Buddhakula (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Già Da", "definition": "Bodh-gaya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Giác Tam Muội", "definition": "Tam Muội (Thiền Định) nhờ sự gia bị của Phật mà có năng lực giác ngộ như Phật. Cứ theo Pháp Hoa Văn Cú quyển 1, phần đầu, thì Tôn Giả A Nan từng được Tam Muội này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giám", "definition": "佛 鍳. Hiệu của Thiền tăng Sư Trách, sống vào đời Minh. X. Sư Trách.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Giám Huệ Cần", "definition": "(佛 鑑 慧 懃, Bukkan Egon, 1059-1117): vị tăng của Lâm Tế Tông Trung Quốc, xuất thân vùng Thư Châu (舒州, Tỉnh An Huy), họ là Uông (汪), pháp từ của Ngũ Tổ Pháp Diễn (五祖法演), trú trì Hưng Quốc Thiền Viện (興國禪院) ở Thái Bình Sơn (太平山), thuộc Thư Châu. Vào năm đầu niên hiệu Chính Hòa (政和, 1111-1118) đời vua Huy Tông nhà Tống, ông nhận sắc chỉ của nhà vua đến trú tại Trí Hải Tự (智海寺) trên kinh đô, sau đó chuyển đến Tương Sơn (蔣山). Vào ngày mồng 8 tháng 11 năm thứ 7 niên hiệu Chính Hòa, ông tắm rửa sạch sẽ, thay áo quần rồi ngồi ngay ngắn mà thị tịch. Sau đó ông được cho hiệu là Phật Giám Thiền Sư (佛鑑 禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Giám Thiền Sư", "definition": "佛 鍳 禪 師. 1. Hiệu của Thiền tăng Huệ Cần, sống vào đời Tống. X. Huệ Cần. 2. Hiệu của Thiền tăng Sư Phạm do vua Tống Lý Tông ban cho. X. Sư Phạm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Giám Thiền Sư Ngữ Lục", "definition": "佛 鍳 禪 師 語 錄. X. Vô Chuẩn Sư Phạm Thiền Sư Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Giáng Sinh Tượng", "definition": "Chỉ cho tượng của Đức Phật lúc Đản Sinh, tay phải chỉ trời, tay trái chỉ đất. Cứ theo điều Phật Giáng Đản trong Sắc Tu Bách Trượng Thanh Qui quyển 2, thì hằng năm vào ngày Đức Phật Đản Sinh (ngày mồng 8 tháng 4 âm lịch), 1 cỗ đình kết bằng hoa được thiết trí, ở trong đặt tượng Phật giáng sinh, phía dưới tượng, chuẩn bị 1 chậu nước thơm, sau khi Đại Chúng bái lễ xong, dùng nước thơm tắm tượng Phật. Phong tục này, cho đến nay, vẫn còn là 1 trong những Phật Sự quan trọng hằng năm của Phật Giáo. [X. Kinh Dục Phật Công Dức; Đại Tống Tăng Sử Lược Q.thượng; Thích Thị Yếu Lãm Q.trung; môn Báo Đảo trong Thiền Lâm Tượng Khí Tiên]. (xt. Dục Phật).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo", "definition": "Buddhāgama (S), Buddhasāsanaṁ (P), Buddhasāsana (P),Buddha-śāsana (S), Bukkyō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Giáo Bác Vật Quán", "definition": "Nơi bảo tồn những vật quí báu của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Bách Khoa Toàn Thư", "definition": "Encyclopedia of Buddhism. Bộ Bách khoa toàn thư của Phật Giáo bằng tiếng Anh, do Tiến sĩ G.P. Malalasekera làm chủ biên và chính phủ Tích Lan xuất bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Bích Họa", "definition": "Tranh tường của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Các Tông Cương Yếu", "definition": "Tác phẩm 12 quyển, 5 tập, do Hiệp hội các tông phái Nhật Bản biên soạn. Nội dung sách này trình bày về sử truyện và Đại cương tông nghĩa của 12 tông phái trong Phật Giáo Nhật Bản. Dưới phần sử truyện của mỗi tông đều có nêu 2 đoạn lịch sử và Kỉ Truyện, phần Đại Cương Tông Nghĩa thì chia làm 4 đoạn: Chính Y Kinh Điển, Tông Danh, Phán Thích và Tông Ý. Trong quyển đầu tập 1 có bài tựa, phàm lệ, tổng luận, cuối quyển 5 có lời bạt của ngài Mặc Lôi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Cải Cách", "definition": "Sự cải cách trong Phật Giáo qua thời gian và không gian.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Cố Sự Tập", "definition": "Xem Bồ Tát Mãn Sanh Man Luận.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Giáo Di Tích", "definition": "Những di tích Phật Giáo. Tức là những dấu vết có liên quan đến Phật, Bồ Tát và các bậc Tổ Sư nhiều đời còn để lại cho người sau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Giáo Chế", "definition": "Chỉ cho những qui chế trong tổ chức giáo đoàn của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Giáo Kì", "definition": "Lá cờ của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Giáo Lí", "definition": "Giáo lí của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Giáo Điển", "definition": "Chỉ chung cho tất cả các loại kinh sách có kiên quan đến Phật Giáo. (xt. Đại Tạng Kinh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Hòa Hảo", "definition": "Một tôn giáo do Huỳnh Phú Sổ ở miền Nam Việt Nam làng Hòa Hảo, tỉnh Long Xuyên lập ra (hiện nay là tỉnh An Giang). Phật giáo Hòa Hảo vào thời cực thịnh của nó có khoảng 2 triệu tín đồ. Tuy về mặt giáo lý, đạo Hòa Hảo chịu ảnh hưởng nhiều của đạo Phật (thí dụ, các thuyết Tam Bảo Phật, Pháp, Tăng, Tứ Ân: ân tổ tiên, Cha mẹ, ân Đất nước, ân Tam Bảo, ân chúng sinh nhân loại; Bát chính đạo, v.v…), nhưng trong thực tế, dưới thời Pháp thuộc cũng như Mỹ chiếm đóng, Hòa Hảo thiên nhiều về mê tín dị đoan, tổ chức chính quyền riêng và quân đội riêng, làm nhiều việc xa lạ với Phật giáo.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Giáo Học Quan Hê Tạp Chí Luận Văn Phân Loại Mục Lục", "definition": "Tác phẩm, 1 tập, do thư viện Đại Học Long Cốc ở Nhật Bản biên soạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Lịch Pháp", "definition": "Lịch pháp của Phật Giáo, tức là Phạm lịch đời cổ. Lịch pháp thiên văn nói trong kinh Phật là loại lịch pháp được thông dụng ở thời bấy giờ. Lịch pháp này là Phật Giáo căn cứ vào thuyết núi Tu Di mà thành lập. Phạm lịch lấy khoảng thời gian từ ngày 16(ngày trăng tròn) tháng này đến ngày 15 tháng sau làm 1 tháng. Khoảng thời gian từ ngày 16 đến ngày 30 (hoặc 29 nếu là tháng thiếu), gọi là Hắc Phần (phần đen) hoặc Hắc Nguyệt (tháng đen). Từ ngày mồng 1 (trăng nhú) đến ngày 16 (trăng tròn) gọi là Bạch Phần (phần trắng) hay Bạch Nguyệt (tháng trắng). Cho nên, 1 tháng theo Phạm lịch tương đương với khoảng thời gian từ ngày 16 âm lịch đến ngày 15 tháng sau. Tên của 12 tháng trong 1 năm theo Phạm lịch đối chiếu với Nông lịch (âm lịch) được đồ biểu như sau (thiếu ):", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Nghi Lễ", "definition": "Những nghi lễ được cử hành trong Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Nghệ Thuật", "definition": "Nghệ thuật Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Nguyên Thủy", "definition": "Xem Thượng Tọa Bộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Giáo Ngạn Ngữ Lí Ngữ", "definition": "Trong đó, từ ngày 16 tháng giêng đến ngày 15 tháng 3 là thời gian không khí nóng dần lên; từ ngày 16 tháng 3 đến 15 tháng 5 là thời gian rất nóng; từ ngày 16 tháng 5 đến 15 tháng 7 là thời gian mưa nhiều, từ ngày 16 tháng 7 đến 15 tháng 9 là thời gian cây cỏ tốt tươi, từ ngày 16 tháng 9 đến 15 tháng 11 là thời gian khí hậu lạnh dần, từ ngày 16 tháng 11 đến 15 tháng giêng năm sau là thời gian khí hậu rất lạnh; trên đây gọi là Tuế Phân Lục Thời (1 năm chia làm 6 mùa), gọi tắt là Lục thời.Trong lục thời, thời gian nóng dần và thời gian rất nóng được gộp chung lại gọi là Nhiệt Thời hoặc Nhiệt Tế; thời gian mưa nhiều và thời gian cây cỏ tốt tươi gộp chung lại gọi là Vũ thời hoặc Vũ Tế (mùa mưa); thời gian lạnh dần và thời gian rất lạnh gộp chung lại gọi là Hàn thời hoặc Hàn Tế (mùa lạnh). Trên đây gọi là Tam thời hoặc Tam Tế. Nhưng vấn đề Tam Tế được phối hợp như thế nào với ngày tháng thì có nhiều thuyết khác nhau. Điều được trình bày trên đây là căn cứ theo thuyết của ngài Chân Đế của Đại Đường Tây Vực Kí. Ngoài ra cũng có thuyết sớm hơn 1 tháng hoặc sớm hơn 2 tháng. Thời gian từ tháng Chế Đát La đến tháng Thệ sắt tra là “Xuân”; thời gian từ tháng Át sa đồ đến tháng Bà đạt la bát đà là “Hạ”; thời gian từ tháng A Thấp Phạ Dữu Xà đến tháng Mạt Già Thủy La là “Thu”; thời gian từ tháng Báo sa đến tháng Phả lặc lũ noa là “Đông”. Trên đây cũng gọi là Tứ thời (4 mùa). Cũng có thuyết chia làm Đông, Xuân, Vũ, Chung và Trường gọi là Ngũ Thời.(xt. Phật Giáo Thiên Văn Học). Những dụng ngữ Phật Giáo được dùng như những tục ngữ quen thuộc trong dân gian.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Nhập Truyền Lộ Tuyến", "definition": "Con đường Phật Giáo truyền vào Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Nhật Bản", "definition": "日 本 佛 教. Tại Nhật, Phật giáo du nhập năm 522 với điểm xuất phát là Hàn Quốc. Mới đầu người Nhật thấy đây là một nền văn hóa ngoại lai, nhưng năm 585, Phật giáo được Nhật hoàng Dụng Minh (j: yomei) thừa nhận. Dưới thời vua Thánh Ðức (j: shokotu, 593-621), Phật giáo trở thành quốc giáo. Năm 594 nhà vua ra lệnh cho dân chúng phải thờ phụng Tam bảo (s: triratna). Ông khuyến khích dịch và viết kinh sách, bản thân ông cũng viết luận giải về các kinh (Duy-ma-cật sở thuyết kinh) và cho xây chùa chiền và thành lập Pháp Long tự (j: hōryū-ji) nổi tiếng ở Nại Lương (nara). Các Cao tăng Trung Quốc và Hàn Quốc được mời đến giáo hóa, người Nhật bắt đầu gia nhập Tăng-già. Trong thời kì này, tông Tam luận được thịnh hành. Trong thời gian từ 710-794, có sáu tông phái tại Nhật Bản, phần lớn do Trung Quốc du nhập: Câu-xá (j: kusha), Pháp tướng (j: hossū), Tam luận (j: sanron), Thành thật (j: jōjitsu), Luật (j: ritsu), Hoa nghiêm (j: kegon). Phật giáo Nhật Bản có ảnh hưởng mạnh lên hoàng tộc, nhất là Hoa nghiêm tông. Bộ kinh Kim quang minh tối thắng vương (s: suvar ṇ aprabhāsottamarāja-sūtra) đóng một vai trò rất quan trọng trong việc truyền bá đạo Phật tại Nhật Bản vì được triều đình thời đó chấp nhận. Ðến thời kì Bình An (heian, 794-1184), tông Thiên Thai (j: tendai) và Chân ngôn (j: shingon) bắt đầu có ảnh hưởng. Ðến giữa thế kỉ thứ 10, việc tôn thờ phật A-di-đà bắt đầu thịnh hành và từ đó thành hình ra Tịnh độ (j: jōdo-shū) và Tịnh độ chân tông (j: jōdo-shin-shū) trong thời đại Liêm Thương (kamakura, 1185-1333). Năm 1191, Thiền tông du nhập Nhật Bản, một tông phái Phật giáo đã chứng tỏ dược sức sống mãnh liệt đến ngày nay. Thiền Nhật Bản cũng có hai hệ phái: Tào Ðộng (j: sōtō) và Lâm Tế (j: rinzai). Trong thế kỉ thứ 13, Nhật Liên (nichiren) thành lập Nhật Liên tông, chủ trương theo kinh Diệu pháp liên hoa, xem đó là kinh quan trọng duy nhất. Trong các thế kỉ sau đó, đạo Phật không còn phát triển. Ðến thế kỉ 19, quan điểm Thần đạo (j: shintō) trở thành quốc giáo. Sau thế chiến thứ hai, Phật giáo phục hưng, hình thành các phái như Sáng Giá Học Hội (sōka gakkai), Lập Chính Giải Chính (risshō koseikai), Nhật Bản Sơn Diệu Pháp Tự (nipponzan myōhōji). Các tông phái này đều lấy Diệu pháp liên hoa kinh làm căn bản.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Giáo Phạm Ngữ", "definition": "Chỉ cho loại tiếng Phạm (Sanskrit) đặc biệt được sử dụng trong kinh điển Phật Giáo. Về văn pháp, hình dạng chữ, cách phát âm của loại tiếng Phạm đặc thù này đều khác với tiếng Phạm cổ điển (Classical Sanskrit) do các nhà văn pháp cổ điển như Ba Nhĩ Ni qui định, xác lập. Vì ý nghĩa, cách sử dụng và ngữ vựng đặc thù của loại tiếng Phạm này không được thấy trong các văn hiến của hệ thống Bà La Môn chính thống, cho nên các học giả cận đại đặcbiệt gọi nó là “Phật Giáo Phạm Ngữ” (Buddhist Sanskrit). Ông Franklin Edgerton, học giả người Mĩ thời gần đây, thì gọi nó là “Phật Giáo hỗn hợp Phạm Ngữ” (Buddhist Hybrid Sanskrit).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Sử Thư", "definition": "Những sách ghi chép lịch sử của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Thi Ca", "definition": "Thơ ca trong Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Thánh Điển Hiệp Hội", "definition": "Buddhist Text Society.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Trung Quốc", "definition": "Buddhism in China", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Giáo Trung Quốc và Phật Giáo Nhật Bản chịu ảnh hưởng rất sâu, tiêu biểu là các nghi thức phóng sinh. Kì Na Giáo chủ trương muôn vật đều có linh hồn, cho nên giữ giới không giết hại một cách cực đoan. Điều thứ nhất trong giới Đại thệ là giới không giết hại.Ấn Độ Giáo cũng có giáo lí luân hồi chuyển sinh, linh hồn bất diệt, nên đã đưa ra quan niệm “Sự sống của muôn vật đều là một thể” và nêu cao lí tưỏng không làm thương tổn tất cả sinh vật. [X. Kinh Tạp A Hàm Q.28].", "definition": "II.Bất Hại.Tên tâm sở. Một trong 75 pháp thuộc Tông Câu Xá, một trong 100 pháp thuộc Tông Duy Thức. Đối lại với “Hại”, là tác dụng tinh thần không làm tổn não người khác. Thuyết Nhất Thiết Hữu Bộ chủ trương Bất Hại có thể riêng biệt, thuộc một trong mười Đại Thiện Địa Pháp. Nhưng các nhà Duy Thức Đại Thừa thì cho rằng, Bất Hại là dựa trên tác dụng Vô Sân mà giả đặt, chứ không lập thể riêng biệt và là một trong 11 thứ Thiện tâm sở. Luận Thành Duy Thức quyển 6 nói, nghĩa của Vô Sân và Bất Hại có khác nhau: Vô Sân là ban vui, thuộc tính chất từ (hiền lành), Bất Hại là cứu khổ, thuộc tính chất bi (thương xót). [X. Luận Nhập A Tì Đạt Ma Q.thượng; Luận Câu Xá Q.29; Luận Phẩm Loại Túc Q.3; Luận Đại Tì Bà Sa Q.42; Luận Thuận Chính Lí Q.11].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Truyền Vào Tây Tạng", "definition": "Từ thời Hán, người Trung-quốc vẫn gọi Tây-tạng là nước Thổ-phồn, nhưng ngày nay, Thổ-phồn là nước East Turkestan. Tây-tạng (Tibet - tiếng Phạn: Bhota) là một nước ở vùng địa thế rất cao (có nơi cao tới hơn 8.000m so với mặt biển), từng được gọi là “nóc nhà thế giới”, khí hậu rất lạnh, nằm giữa hai mạch núi vĩ đại là Côn-lôn ở phía Bắc và Hi-mã-lạp ở phía Nam; Đông giáp Trung-quốc, Nam giáp Miến-điện, Ấn-độ, Bhutan, Sikkim, và Nepal, Tây giáp Ấn-độ, Bắc giáp East Turkestan.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Giáo Tuyệt Tích Ở Ấn Độ", "definition": "Từ triều đại A Dục Vương (thế kỉ thứ 3 tr. TL), Phật giáo bắt đầu phát triển và bành trướng rộng rãi trên gần khắp lục địa Ấn-độ. Từ đầu kỉ nguyên Tây lịch cho đến tiền bán thế kỉ thứ 7 (dưới triều đại Giới Nhật vương - Shiladitya, hay Harsa, lên ngôi khoảng năm 610), có thể coi đó là thời đại hoàng kim của Phật giáo, chiếm địa vị độc tôn, lấn át cả Ấn giáo và Kì-na giáo trên khắp lãnh thổ Ấn-độ. Nhưng từ giữa thế kỉ thứ 7 trở đi, Ấn giáo (tức hậu thân của Bà-la-môn giáo) bắt đầu quật khởi và lấn át, làm cho Phật giáo đi dần vào giai đoạn suy thoái. Đến thế kỉ thứ 9, Phật giáo chỉ còn có mặt tại vài khu vực ở Trung, Đông và Nam Ấn-độ. Khi người Hồi giáo xâm lăng Ấn-độ, thì Phật giáo bị hủy diệt. Cuối thế kỉ 12, quân Hồi giáo chiếm thủ đô của tỉnh Bihar (miền Đông-Ấn, vùng hạ lưu sông Hằng), phá hủy hết chùa tháp, giết sạch tăng chúng, thì Phật giáo trên đất Ấn đã thực sự cáo chung, sau 17 thế kỉ (từ ngày đức Phật nhập diệt) có mặt liên tục trên lục địa Ấn-độ. (Cũng có tài liệu nói, riêng Phật giáo ở Nam-Ấn, lúc đó vẫn còn tồn tại, và khá thịnh; mãi đến hai thế kỉ sau nữa mới suy tàn hẳn. Như vậy, phải 19 thế kỉ Phật Lịch, Phật giáo mới thực sự tuyệt tích ở Ấn-độ.) Đến cuối thế kỉ 19 dương lịch, Phật giáo tại Ấn-độ đã được phát hiện trở lại, rồi dần dần phục hưng và phát triển cho đến ngày nay.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Giáo Tây Tạng", "definition": "西 藏 佛 教; cũng được nhiều nơi gọi là Lạt-ma giáo (e: lamaism); Một hệ phái Phật giáo quan trọng thuộc Ðại thừa, được truyền bá nhiều nơi gần Hi-mã-lạp sơn, không chỉ ở Tây Tạng. Ðặc trưng của Phật giáo Tây Tạng là sự trộn lẫn của các giới luật của Nhất thiết hữu bộ và các phép tu của Kim cương thừa. Phật giáo Tây Tạng được xem là thành hình trong thế kỉ thứ 8 dưới triều vua Tri-song Ðet-sen (t: trisong detsen, 755-597), do hai Cao tăng Ấn Ðộ là Tịch Hộ (s: śāntarakṣita) và Liên Hoa Sinh (padmasambhava) truyền sang. Ðợt đầu của việc truyền bá đạo Phật qua Tây Tạng chấm dứt trong thế kỉ thứ 9. Trường phái Ninh-mã (t: nyingmapa) được thành lập từ thời gian đó. Sau một thời gian bị bức hại, Phật giáo lại phục hưng trong thế kỉ 11, phát sinh hai trường phái Ca-nhĩ-cư (t: kagyupa) và Tát-ca (t: sakyapa) và đó là thời gian mà rất nhiều kinh sách được dịch ra tiếng Tây Tạng. Kể từ thế kỉ 14, phái Cách-lỗ (t: gelugpa) thịnh hành, được xem là một trong bốn trường phái lớn của Phật giáo Tây Tạng. Ngày nay, trên thế giới, Phật giáo Tây Tạng được coi trọng, nhiều Lạt-ma Tây tạng đang giáo hóa tại các nước phương Tây. Trước khi Phật giáo du nhập vào Tây Tạng thì đạo Bôn được xem là quốc giáo. Khoảng dưới thời vua Tùng-tán Cương-bố (t: songten gampo; 620-649) thì hoàng gia bắt đầu quay qua Phật giáo. Năm thế hệ sau vị vua này thì Phật giáo được tuyên bố chính thức là quốc giáo và với sự xây dựng tu viện Tang-duyên (samye, 775), các tăng sĩ Tây Tạng bắt đầu thành lập Tăng-già. Mới đầu Phật giáo Tây Tạng cũng có tiếp xúc, tranh luận với Thiền tông Trung Quốc, nhưng sau đó, người ta theo hẳn giáo lí của Trung quán tông (s: mādhyamika; t: dbumapa). Khoảng dưới thời vua Lãng-đạt-ma (langdarma, 838-842), Bôn giáo lại được phục hồi, Phật giáo bị bức hại. Trong thời gian đó, chỉ có phái “áo trắng”, là các vị cư sĩ tại gia, được bảo tồn. Ngày nay phái này còn lưu truyền với phái Ninh-mã (nyingmapa). Với A-đề-sa, đạo Phật lại được truyền bá lần thứ hai sang Tây Tạng. Từ đây, người ta lại quan tâm đến các trường phái, nhất là các phái truyền tâm từ thầy qua trò, và từ đó sinh ra các tu viện lớn của tông Tát-ca (1073), lôi kéo được “dịch giả” Mã-nhĩ-ba (marpa) – người sáng lập tông Ca-nhĩ-cư (kagyupa) – sang Ấn Ðộ thu thập kinh sách. Trong Phật giáo Tây Tạng và các tông phái tại đây, các vị đại sư được gọi là Lạt-ma, đóng một vai trò rất quan trọng. Một trong các vị quan trọng nhất là Tông-khách-ba (t: tsong-kha-pa), “Nhà cải cách”, là người thiết lập và tổ chức lại toàn bộ các tông phái. Sư cũng là người xây dựng tu viện Gan-den (1409) và thành lập tông Cách-lỗ (t: gelugpa). Các tông phái và giáo lí khác như Ðoạn giáo (chod), tuy có một hệ thống kinh sách mạch lạc, nhưng lại không xây dựng tu viện nên cuối cùng hòa vào các dòng khác. Các dòng tu quan trọng của Tây Tạng thường hay có một hệ thống các tu viện, đồng thời cũng bắt nguồn từ các vị Ma-ha Tất-đạt (s: mahāsiddha). Về mặt lí thuyết, ngoài A-tì-đạt-ma, Phật giáo Tây Tạng còn dựa vào các giáo pháp Ðại thừa của Long Thụ (s: nāgārjuna) và Vô Trước (s: asa ṅ ga), xem đó là hai lí thuyết căn bản mà đặc biệt là triết lí Trung qu á n cụ duyên (mādhyamika-prāsaṅgika) được xem trọng hơn hết. Ngoài ra Nhân minh học (s: hetuvidyā; có thể gọi là logic, luận lí học) cũng được đưa vào để luận giải các vấn đề có tính giáo khoa. Ðặc biệt, các phép tu Tan-tra hay được dùng để biến các kiến thức lí thuyết thành kinh nghiệm bản thân. Năm chủ đề (s: pañcavacanagrantha) quan trọng phải được học hỏi, nghiên cứu trong một thiền viện tại Tây Tạng trước khi đạt được danh hiệu Ge-she (tương ưng với Hòa thượng tại Ðông, Ðông nam á, có thể so sánh với bằng cấp Tiến sĩ của Tây phương):", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Giáo Từ Điển", "definition": "Kinh Phật nghĩa lí sâu xa vi diệu, cho nên biên soạn từ điển để giải thích những thuật ngữ Phật Giáo và văn hóa Phật Giáo là việc làm cần thiết. Có thể nói, những việc đầu tiên phải làm để biên soạn thành bộ từ điển Phật Giáo là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Việt Nam", "definition": "越 南 佛 教 .Lịch sử Phật giáo tại Việt Nam được trình bày khá rõ trong Việt Nam Phật giáo sử luận của Nguyễn Lang. Theo tác phẩm này, trong thế kỉ thứ nhất, thứ hai sau Công nguyên, ngoài hai trung tâm Phật giáo tại Trung Quốc là Lạc Dương và Bành Thành, một trung tâm thứ ba xuất hiện tại Luy Lâu, thuộc xứ Giao Chỉ, ngày nay thuộc tỉnh Bắc Ninh, Việt Nam. Có người cho rằng, Luy Lâu hình thành trong đầu thế kỉ thứ nhất, sớm hơn cả Lạc Dương và Bành Thành, làm bàn đạp cho sự thành lập hai nơi đó. Ðiều chắc chắn là trung tâm Luy Lâu được hình thành do các tăng sĩ Ấn Ðộ trực tiếp mang lại, chứ không phải từ Trung Quốc truyền xuống. Tập luận thuyết đầu tiên về đạo Phật được Mâu Tử (sinh khoảng năm 165) viết tại Giao Châu. Khang Tăng Hội ( 康 僧 會; cuối thế kỉ thứ hai) được xem là tăng sĩ đầu tiên của Việt Nam. Qua thế kỉ thứ ba thì tại Giao Châu đã có khoảng năm trăm vị tăng sĩ và lưu hành ít nhất 15 bộ kinh, trong đó bộ Tứ thập nhị chương ( 四 十 二 章 經; s: dvācatvāriṃśat-khanda-sūtra) là kinh chủ yếu dành cho người xuất gia. Sau đ ó Thiền tông vào Việt Nam rất sớm, Khang Tăng Hội được xem là Khai tổ của Thiền học Việt Nam. Sư là tác giả của tập Nê-hoàn phạm bối ( 泥 洹 梵 唄 ), một tập thi ca về Niết-bàn dịch từ văn hệ Pā-li. Sư cũng viết tựa cho tập kinh An-ban thủ ý ( 安 般 守 意; p: ānāpānasati), soạn bộ Lục độ tập kinh ( 六 度 集 經 ) và dịch một kinh bản của kinh Bát-nhã ba-la-mật-đa. Như thế, trong đầu thế kỉ thứ ba, Phật giáo Việt Nam đã là Phật giáo Ðại thừa. Khoảng thế kỉ thứ năm, người ta nhắc đến hai vị Thiền sư ở Giao Châu là Pháp Thiên ( 法 天; s: dharmadeva) và Huệ Thắng ( 慧 勝 ), theo thiền pháp Ðại thừa. Người ta biết rằng Sơ tổ Thiền tông Trung Quốc là Bồ-đề Ðạt-ma đến nước này năm 520, nhưng có truyền thuyết cho rằng, Ngài có thể đã cùng Pháp Thiên đến Giao Châu cuối đời nhà Tống (khoảng năm 470). Cuối thế kỉ thứ sáu, Thiền sư Tì-ni-đa Lưu-chi ( 毘 尼 多 流 支; s: vinītaruci; cũng gọi là Diệt Hỉ) – học trò của vị Tổ thứ ba của Thiền Trung Quốc là Tăng Xán ( 僧 璨 ) – đến Giao Châu khai sáng dòng thiền cùng tên. Sau đó còn có phái thiền Vô Ngôn Thông ( 無 言 通 ) và Thảo Ðường cũng xuất phát từ Trung Quốc lưu hành tại Việt Nam. Phái Thiền của Tì-ni-đa Lưu-chi truyền được 19 đời (đến năm 1213), bắt đầu bằng kinh Tượng đầu tinh xá ( 象 頭 精 舍 經 ), một bộ kinh thuộc hệ thống Bát-nhã, tạo sự lớn mạnh của Phật giáo Ðại thừa và cả Mật tông tại Việt Nam. Phái Thiền Vô Ngôn Thông truyền được bốn thế kỉ, sử dụng chủ yếu các kinh Viên giác ( 圓 覺 ), Pháp hoa ( 法 華 ), chủ trương “Ðốn ngộ” ( 頓 悟 ) và “Vô sở đắc” ( 無 所 得 ), rất gần với Thiền phương nam của Trung Quốc. Phái thiền Thảo Ðường ( 草 堂 ) bắt đầu từ cuối thế kỉ thứ mười một, do Thiền sư Thảo Ðường sáng lập, vốn là một tù nhân của vua Lí Thánh Tông bị bắt năm 1096. Sách Thiền uyển tập anh ( 禪 苑 集 英 ) cho rằng Thảo Ðường là môn đệ của Thiền sư Tuyết Ðậu Trọng Hiển ( 雪 竇 重 顯 ), là phái chủ trương dung hợp giữa Phật và Nho giáo tại Trung Quốc. Phái Thảo Ðường truyền được sáu thế hệ trong đó có những người nổi tiếng như Không Lộ ( 空 露 ) và Giác Hải ( 覺 海; hai vị cũng được xếp vào thiền phái Vô Ngôn Thông). Khoảng thế kỉ thứ mười, Việt Nam giành được quyền độc lập và Phật giáo bắt đầu có ảnh hưởng trong giới vua quan. Năm 971 Ðinh Tiên Hoàng ban chức “Tăng thống” đầu tiên cho Thiền sư Khuông Việt ( 匡 越; Ngô Chân Lưu; 吳 真 流 ). Vua Lê Ðại Hành mời Thiền sư Pháp Thuận ( 法 順 ) và Vạn Hạnh ( 萬 行 ) làm cố vấn chính trị. Về sau Vạn Hạnh phò Lí Công Uẩn ( 李 公 蘊 ) lên ngôi (1010), nhà vua cho dựng nhiều chùa chiền, sùng bái đạo Phật. Năm 1036, Lí Thái Tông ( 李 太 宗 ) lên ngôi, cũng là một nhà vua quí trọng đạo Phật. Năm 1049, chùa Một Cột ( 延 祐; Diên Hựu) được xây dựng. Các nhà vua đời Lí về sau đều tôn sùng đạo Phật và lấy đạo từ bi làm phương pháp trị nước. Trong thời gian này, Phật giáo Ðại thừa với các bộ kinh như Kim cương, Dược sư, Pháp hoa, Viên giác... được truyền tụng. Ðầu thế kỉ thứ 13, nhà Trần lên ngôi, đồng thời ba thiền phái Tì-ni-đa Lưu-chi, Vô Ngôn Thông và Thảo Ðường dần dần nhập lại một. Ðây là thời kì phát triển rực rỡ nhất của Phật giáo Việt Nam. Các nhà vua đời Trần cũng đều là những Thiền sư uyên bác, mà một trong những người xuất sắc nhất phải kể đến là vua Trần Thái Tông ( 陳 太 宗; 1218-1277). Thiền phái duy nhất Việt Nam thời này, được xem là sự tổng hợp của ba thiền phái kia là thiền Yên Tử hay Trúc Lâm. Trần Thái Tông đã để lại một loạt tác phẩm thiền học rất quan trọng. Một nhân vật quan trọng của Phật giáo đời Trần là Huệ Trung Thượng sĩ ( 慧 忠 上 士 ), tức là Trần Quốc Tung, anh cả của Trần Hưng Ðạo, anh vợ của Trần Thánh Tông. Sau Thái Tông là Trần Nhân Tông ( 陳 仁 宗 ), cũng là một ông vua xuất gia, trở thành tổ thứ sáu của trường phái Yên Tử và Ðệ nhất tổ của dòng thiền Trúc Lâm Yên Tử. Trong thời nhà Trần, các bộ kinh Kim cương, Pháp hoa, Bát-nhã, Nhập Lăng-già và Hoa nghiêm được lưu truyền rất rộng rãi. Hai nhà sư đóng góp lớn nhất vào việc học Phật thời đó là Pháp Loa ( 法 螺 ) và Huyền Quang ( 玄 光 ). Ðến cuối thế kỉ 14, Phật giáo bắt đầu suy đồi, nhà Trần đã nằm trong tay Hồ Quí Li. Trong đời nhà Lê, vua quan coi trọng Nho giáo với kết quả là năm 1464, Lê Thánh Tông cấm xây dựng chùa mới. Khoảng giữa thế kỉ 17, lúc Nam Bắc phân tranh, Phật giáo lại phục hưng, trong đó Thiền sư Chân Nguyên và Hương Hải hoạt động ở Ðàng ngoài. Ở Ðàng trong, chúa Nguyễn Hoàng (1558-1613) là người tôn trọng đạo Phật, cho xây chùa Thiên Mụ năm 1601. Tại đây, môn phái của Thiền sư Liễu Quán ( 了 觀 ) có công phục hưng Phật giáo. Ðầu thế kỉ thứ 19, Gia Long thắng Tây Sơn, chấm dứt những năm chinh chiến, trong đó đạo Phật cũng bị thương tổn. Các vua triều Nguyễn như Minh Mạng, Thiệu Trị, Tự Ðức cũng có để tâm phục hưng lại đạo Phật. Trong tiến trình lịch sử Việt Nam, tuy có lúc thịnh lúc suy, nhưng nói chung Phật giáo chưa bao giờ mất ảnh hưởng trong dân tộc Việt Nam.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Giáo Văn Học", "definition": "Văn học của Phật Giáo. Chỉ cho những bộ kinh điển của Phật Giáo mang sắc thái văn học. Chẳng hạn những bộ kinh như: Pháp Cú, Thí Dụ, Bản Sinh, Duy Ma, Pháphoa, Hoa Nghiêm...… là những Thánh điển đậm đà sắc thái văn học.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Văn Khố", "definition": "Cũng gọi Phật Giáo Tùng Thư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Vũ Đạo", "definition": "Nghệ thuật nhảy múa trong Phật Giáo. Ấn Độ từ nghìn xưa đã thấy có ghi chép về nghệ thuật nhảy múa, như được tường thuật trong Lê Câu Phệ Đà. Nay trong văn học Phật truyện cũng thấy miêu tả vũ đạo trong cung đình, như vậy đủ biết ở thời đại Đức Phật vũ đạo đã được phổ biến.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Âm Nhạc", "definition": "Âm nhạc Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Đại Hê", "definition": "Tác phẩm, 64 tập, do “Hội Phật Giáo Đại Hệ San Hành” của Phật Giáo Nhật Bản ấn hành, bắt đầu từ năm Đại Chính thứ 6 (1917) đến năm Chiêu Hòa 13 (1938) mới hoàn tất. Đây là tác phẩm tập đại thành chính văn và các sách chú thích, tiêu biểu của khoảng 130 bộ luận sớ chủ yếu trong Phật Giáo Như: Câu Xá Luận, Thất thập ngũ pháp, Lược Thuật Pháp Tướng Nghĩa, Thành Duy Thức Luận, Tam Luận Đại nghĩa sao, Tam Luận Huyền Nghĩa, Hoa Nghiêm Pháp Giới Nghĩa Kính, Kim Sư Tử Chương, Đại Thừa khởi tín luận, Hoa Nghiêm Ngũ Giáo Chương, Tịnh Độ tam bộ kinh, Tuyển Trạch Bản Nguyện Niệm Phật Tập, Giáo Hành Tín Chứng, Tứ thiếp sớ, Pháp Hoa Huyền Nghĩa, Thiên Thai Tứ Giáo Nghi, Ma Ha Chỉ Quán, Quán Tâm bản tôn sao, Đại Nhật Kinh Sớ, Khai Mục Sao, Chính Pháp Nhãn Tạng v.v…...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Đại Từ Vựng", "definition": "Tác phẩm gồm 7 tập, do Đại Học Phật Giáo (Đại Học Long Cốc hiện nay) của phái Bản Nguyện tự thuộc Tịnh Độ Chân Tông Nhật Bản soạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Đồ Thư Quán", "definition": "Thư viện Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giáo Đồ Tượng Học", "definition": "Phương pháp tạo tượng trong Phật Giáo, đặc biệt là Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Giới", "definition": "Xem Phật Độ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Gô Ta Ma", "definition": "Buddha Gautama (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hiên", "definition": "Tên 1 loài chim ở núi Nga Mi bên Trung Quốc. [X. Nguyệt Linh Quảng Nghĩa].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Hiền Thiện Thủ", "definition": "Buddha of Worthy and Excellent Leader.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hiệu", "definition": "(佛號): có hai nghĩa.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Hoa Nghiêm Nhập Như Lai Trí Bất Tư Nghị Cảnh Giới Kinh", "definition": "Fo-hua-yen ju ju-lai te-chih pu-ssu-i ching-chieh ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hoan Hỷ Nhựt", "definition": "Ngày vui vẻ của Phật. Ấy là ngày Rằm tháng bảy âm lịch. Ngày ấy, các vị Tỳ Kheo ra khỏi cuộc an cư mùa hạ, đã qua một tuổi tu, cho nên chư Phật đều lấy làm vui vẻ. Và là ngày chư tăng tự tứ, tức tự mình xưng tội sau khi nghe đọc giới bổn. Lại là ngày mà các nhà thiện tín có thể cúng dường cho chư Tăng, cho các vị Thánh sống, Phật sống để cầu phước đức cho cha mẹ hiện tiền hoặc quá vãng. Bởi các lẽ ấy cho nên ngày Rằm tháng bảy kêu là Phật hoan hỷ nhựt.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Hoan Hỷ Tạng Ma Ni Bảo Tích", "definition": "Buddha of Joyous Treasury of the Mani-Jewel Heap.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Huyễn", "definition": "佛 幻. Hiệu của Thiền tăng Tâm Thái, sống vào đời Minh. X. Tâm Thái.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Huệ", "definition": "Tathāgata-jñāna-darśana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Huệ Cự Chiếu", "definition": "Buddha of Ten-direction Wisdom Torch.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Huệ Oai Đăng Vương", "definition": "Buddha of Awesome Lamp of Wisdom King.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Huệ Tràng Thắng Vương", "definition": "Buddha of the King of the Victorious-Banner Wisdom.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Huệ Viên Giám Thiền Sư", "definition": "佛 慧 圓 鍳 禪 師. Thụy hiệu của Thiền tăng Nguyên Trường, sống vào đời Nguyên. X. Nguyên Trường.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Hàng Phục Chúng Ma Vương", "definition": "Buddha of of the King Who Causes All Demons to Submit.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hành Li Địa Tam Ý", "definition": "Đức Phật bước đi, chân không bén đất, có 3 lí do:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Hành Ly Địa Tam Ý", "definition": "佛行離地三意 (Hoa Nghiêm Kinh Tùy Sở Diễn Nghĩa Sao và Phật Thuyết Xứ Xứ Kinh )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Hóa", "definition": "Phật Hóa (1834-1913). Danh tăng Trung Quốc thuộc Tông Lâm Tế, sống vào cuối đời Thanh, người Tuyền Châu, Phúc Kiến, họ Lâm, pháp danh Như Huyễn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Hóa Thân Tam", "definition": "佛化身三 (Quán Phật Tam Muội Hải Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Hư Không Bảo Hoa Quang", "definition": "Buddha of Precious-Flower Light of the Void.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hương Các", "definition": "Gác Phật hương, một kiến trúc nổi tiếng ở vườn Di Hòa, phía trước núi Vạn Thọ, ở Bắc Kinh, được xây dựng vào thời vua Càn Long, nhà Thanh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Hướng Thượng Sự", "definition": "Gọi tắt: Phật Hướng Thượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Hạnh Thiền Sư", "definition": "佛 行 禪 師. Hiệu của Thiền tăng Đạo Xương, sống vào đời Tống. X. Đạo Xương.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Hải", "definition": "佛海. Chỉ giáo lí của Phật (to lớn như biển).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Hải Đức Quang Minh", "definition": "Buddha of Sea-Vast Virtue Radiance.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hậu Phổ Hiền", "definition": "Sau khi tu hành đã chứng được quảPhật, hành giả lại noi theo đức hạnh của Bồ Tát Phổ Hiền mà tu hành giáo hóa chúng sinh, mang lại lợi ích cho họ, cũng gọi là Phật hậu Phổ Hiền (sau khi thành Phật, lại tu hạnh Phổ Hiền).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Họa", "definition": "Cũng gọi Họa tượng, Hội tượng. Đem vẽ hình tượng Phật, Bồ Tát trên mặt tường vách, trên giấy, hoặc thêu trên vải lụa...… để làm đối tượng lễ bái, cúng dường, hoặc để lưu truyền, gọi là Phật họa. Ở Ấn Độ, nguồn gốc Phật họa đã có từ thời Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Học", "definition": "Môn học nghiên cứu về hệ thống, nguồn gốc và sự phát triển tư tưởng của Phật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Học Tùng Báo", "definition": "Tạp Chí Phật Giáo do các ông Địch Bảo Hiền và Bộc Nhất Thừa phát hành tại Thượng Hải, Trung Quốc vào năm 1912.Trước đó, họ Địch cùng với các ông Khang hữu vi, Lương Khải Siêu mưu đồ làm cách mạng lật đổ nhà Thanh để canh tân Trung Quốc, âm mưu thất bại, bèn đến Thượng Hải làm nhà báo. Vì chuyển hướng nghiên cứu Phật học nên xuất bản tờ báo này. Tuy đến 12 số thì phải đình bản, nhưng đây vẫn là tờ tạp chí Phật Giáo đầu tiên ấn hành tại Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Học Viên", "definition": "Cơ sở giáo dục Phật Giáotheo hình thức mới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Hộ", "definition": "Buddhapālita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hội", "definition": "Parsad-maṇdala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Hữu Ngũ Sự", "definition": "佛有五事 (Tăng Nhất A Hàm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Khám", "definition": "Cái khám để thờ Phật, phần nhiều làm bằng đá hoặc gỗ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Khí", "definition": "Chỉ cho cái bát đựng cơm cúng dường Đức Phật. Hình dáng giống cái nấm, phần nhiều làm bằng kim loại như sắt, đồng, cũng có khi được làm bằng sành, sứ…...; bên ngoài khắc hình hoa sen, hoặc cỏ…...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Không Vương", "definition": "Void King Buddha", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phật Khúc", "definition": "Những ca khúc trong Phật Giáo được phổ nhạc bằng những câu kệ trong kinh. Cứ theo Tây hà thi thoại của ông Mao kì linh thì ở các đời Tùy, Đường của Trung Quốc đã có Phật khúc rồi, chứ không phải mới bắt đầu từ thời Kim, Nguyên, như Đường nhạc phủ có Phổ Quang Phật Khúc, Nhật Quang Minh Phật Khúc, Thích Ca Văn Phật Khúc, Diệu Hoa Phật Khúc, Ma Ni Phật Khúc, Nhật Đằng Quang Phật Khúc…... được soạn theo nhiều thanh điệu khác nhau như Song, Thương, Chủy, Vũ…...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Khẩu", "definition": "Cũng gọi Phật thuyết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Kim Cang Lao Cương Phổ Tán Kim Quang", "definition": "Buddha of Universally Radiated Golden Light of Adamantine Firm Strength.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Kim Hoa Quang", "definition": "Buddha of Golden-Flower Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Kim Hải Quang", "definition": "Buddha of Golden-Sea Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Kim Túc", "definition": "Là một đức Phật đời quá khứ, mà theo Truyền thuyết, là tiền thân của cư sĩ Duy Ma Cật. Truyền thuyết này rất được thịnh hành từ xưa tới nay. Có người nói rằng, Truyền thuyết này đã phát xuất từ kinh Phát Tích và kinh Tư Duy Tam Muội, nhưng hai kinh này đến nay chưa ai tìm thấy.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Kinh", "definition": "Buddha-vacana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Kiến", "definition": "I.Phật Kiến.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Kí", "definition": "Huyền kí của Đức Phật, cũng chỉ cho Kí Biệt của Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Li Tổ Thất", "definition": "Bờ rào của Phật, nhà ở của tổ. Tổ chỉ cho tổ Đạt Ma của Thiền Tông. Phật li là cửa Phật; Tổ thất là cửa Thiền. Phật li tổ thất là chỉ chung cho Phật Giáo, Phật đạo, Phật môn. [X. Viên Thoa Tập Huyễn Trụ Am Kí].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Long Chủng Thượng Tôn Vương", "definition": "Buddha of Honoured King of the Supreme-Insight Nagas.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Lãng Thiền Sư", "definition": "佛 朗 禪 師.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Lão", "definition": "佛老. Đức Phật và Lão Tử. Đạo Phật và Đạo Lão.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Lưu Ly Trang Nghiêm Vương", "definition": "Buddha of the King Gloriously Adorned with Lapis Lazuli.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Lạp Nhật", "definition": "Chỉ cho ngày kết thúc hạ An Cư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Lịch", "definition": "Là niên lịch Phật giáo, được tính bắt đầu từ năm đức Phật Thích Ca Mâu Ni nhập diệt. Các tài liệu về niên đại nhập diệt của đức Phật, xưa nhất là thuyết “Chúng thánh điểm kí” của Phật giáo Nam-truyền. Theo thuyết này, sau khi Phật nhập diệt, tôn giả Ưu Ba Li kết tập Luật tạng. Vào cuối mùa an cư, ngày Rằm tháng Bảy, sau lễ tự tứ, tôn giả Ưu Ba Li đã dùng hương hoa cúng dường Luật tạng, rồi chấm xuống một chấm trước nơi đặt Luật tạng. Từ đó về sau, cứ mỗi năm, khi mùa an cư hoàn mãn, chư thánh tăng đều nối tiếp nhau chấm một chấm như vậy, để ghi số năm trôi qua sau khi Phật nhập diệt. Công việc này vẫn được tiếp nối sau khi Phật giáo truyền vào Trung-quốc. Đến niên hiệu Vĩnh-minh thứ 8 nhà Tề, thời đại Nam-triều, Trung-quốc (tức năm 490 TL, một năm sau khi ngài Tăng Già Bạt Đà La dịch bộ Luật Thiện Kiến Tì Bà Sa), vào nửa đêm ngày Rằm tháng Bảy, mùa an cư vừa hoàn mãn, một chấm nữa được chấm xuống; đến đây, cộng lại từ chấm đầu tiên sau khi Phật nhập diệt, được cả thảy 975 điểm. Từ đó mà suy tính thì đức Phật nhập diệt 486 năm tr. TL.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Lục Thập Tứ Chủng Phạm Âm", "definition": "佛六十四種梵音 (Bất Tư Nghì Bí Mật Đại Thừa Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Lực", "definition": "Buddhavisaya (P), Buddha's power.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Ma Nhất Như", "definition": "Phật và ma về mặt tướng dụng tuy có khác nhau, nhưng về mặt thể tính thì chỉ là một. Bởi vì các pháp vốn không có tự tính, cho nên Phật thiện và ma ác, tướng thuận và tướng nghịch đều thuộc thế giới hình tướng bề ngoài, thực thì bản tính Phật và ma vốn chẳng hai, vì thế gọi là Phật Ma Nhất Như.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ma Ni Tràng", "definition": "Buddha of Mani Banner.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Ma Ni Tràng Đăng Quang", "definition": "Buddha of Man- Banner Shining Lamp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Minh", "definition": "Xem Phật Âm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Môn", "definition": "佛門. Cửa Phật. Chỉ giáo lí nhà Phật Cũng chỉ chùa Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Mẫu", "definition": "Buddhamatṛ (S), Butsumo (J), Butsumo (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Mẫu Bát Nhã Nê Hoàn Kinh", "definition": "Kinh, 1 quyển, do ngài Tuệ Giản dịch vào đời Lưu Tống, được thu vào Đại Chính Tạng tập 2.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Mẫu Gia Trì", "definition": "Cũng gọi Phật Bộ Mẫu Gia Trì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Mẫu Mạn Đồ La", "definition": "Cũng gọi Hư Không Nhãn Mạn Đồ La, Phật Mẫu Biệt Đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Mẫu Đại Khổng Tước Vương Kinh", "definition": "Mahāmāyūrī vidyuārājini (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nguyên Thiền Sư", "definition": "佛 源 禪 師. Thụy hiệu của Thiền tăng Chính Niệm, sống vào đời Nguyên. X. Chính Niệm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Nguyệt", "definition": "Mặt trăng Phật. Có 2 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ngũ Tánh", "definition": "佛五姓 (Thích Thị Yếu Lãm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Ngũ Tính", "definition": "Năm họ của Đức Phật trước khi xuất gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ngữ", "definition": "Đồng nghĩa: Phật Thuyết, Kim Khẩu. Những lời nói của Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ngữ Pháp Môn Kinh", "definition": "Cũng gọi Phật Ngữ Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nha", "definition": "Răng của Đức Phật Thích Ca Mâu Ni.Cứ theo truyền thuyết, sau khi trà tì (thiêu = đốt), toàn thân Đức Thế Tôn hóa thành những hạt xá lợi nhỏ, chỉ còn lại một số răng không bị hư tổn, gọi là Phật Nha Xá Lợi (Phạm, Pàli: Dantadhàtu).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nha Sử", "definition": "Dathavaṃsa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nha Tiết", "definition": "Lễ hội rước răng Phật thịnh hành ở Tích Lan.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nha Tự", "definition": "Dalada-maligava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nha Xá Lợi Tháp", "definition": "Tháp thờ xá lợi răng của Đức Phật được xây trên nền cũ chùa Linh Quang, núi Tây Sơn, gần thành Bắc Kinh, Trung Quốc. Tháp được kiến trúc bằng gạch, mái dày, hình bát giác, 13 tầng, cao 51m, đứng sừng sững dưới chân núi Tây Sơn, màu vàng chói lọi, rực rỡ huy hoàng, là 1 trong những thắng cảnh nổi tiếng ở vùng ngoại ô Bắc Kinh. Trong tầng thứ nhất có tấm bản đồng khắc văn Kinh Kim Cương Bát Nhã, tương truyền là thủ bút của Triệu Mạnh Phủ, nhà thư pháp đời Nguyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhiên Đăng", "definition": "Buddha Burning Torch", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phật Nhãn", "definition": "Oeil de bouddha 佛眼 buddha-cakṣus", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phật Nhãn Chân Ngôn", "definition": "Cũng gọi Phật Nhãn Chú, Phật Nhãn Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhãn Mạn Đồ La", "definition": "Mạn Đồ La Mật Giáo lấy Phật Nhãn Phật Mẫu làm bậc Trung Tôn mà kiến lập hoa sen 8 cánh 3 lớp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhãn Phái", "definition": "Butsugen-ha (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhãn Phật Mẫu", "definition": "Buddha-locani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhãn Thanh Viễn", "definition": "Fo yen cheng yuan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhãn Thanh Viễn Thiền Sư Ngữ Lục", "definition": "Cũng gọi Thư Châu Phật Nhãn Hòa Thượng Ngữ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhãn Thiền Sư", "definition": "Butsugen zenji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhãn Thiền Sư Ngữ Lục", "definition": "佛 眼 禪 師 語 錄. X. Vô Môn Huệ Khai Thiền Sư Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Nhãn Tương Khán", "definition": "Nhìn nhau bằng ánh mắt của Phật. Nghĩa là người ta nên đối đãi với nhau bằng tấm lòng từ bi, hỉ xả và vị tha của Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhãn Ấn", "definition": "Ấn Phật Nhãn, 1 trong những thủ ấn của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhất Thiết Pháp Tràng Mãn Vương", "definition": "Buddha of King of Eternal Completion of All Things.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhất Thiết Thế Gian Nhạo Kiến Thượng Đại Tinh Tiến", "definition": "Buddha of Supreme in the Great Striving, Whom All the World Takes Joy in Seeing.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhật", "definition": "佛日. Chỉ giáo lí nhà Phật (như mặt trời rọi sáng khắp nơi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Nhật Khế Tung", "definition": "(佛 日 契 嵩, Butsunichi Kaisū, 1007-1072): vị tăng của Vân Môn Tông, người vùng Đàm Tân (鐔津) thuộc Đằng Châu (藤州, Tỉnh Quảng Tây), họ là Lý (李), tự là Trọng Linh (仲靈), tự xưng hiệu là Tiềm Tử (潛子). Vào năm thứ 6 (1013) niên hiệu Đại Trung Tường Phù (大中祥符), ông xuất gia lúc 7 tuổi, và đến năm lên 13 tuổi thì xuống tóc thọ giới. Năm 19 tuổi, ông đi hành cước khắp nơi, tham yết Thần Đỉnh Hồng Yên (神鼎洪諲) ở Nam Nhạc, và cuối cùng kế thừa dòng pháp của Động Sơn Hiểu Thông (洞山曉聰) ở Quân Châu (筠州, Tỉnh Giang Tây). Trong khoảng niên hiệu Khánh Lịch (慶 曆, 1041-1048), ông đến Tiền Đường (錢 塘) và sống tại Hồ Sơn (湖山), rồi theo tham học với Vĩnh An Lan Nhã (永安蘭若) ở Linh Ẩn Tự (靈隠寺). Ông viết cuốn Nguyên Giáo Hiếu Luận (原教孝論) để nói về sự nhất quán của Nho và Thích và phản bác luận thuyết bài Phật của Hàn Thối Chi (韓 退之). Bên cạnh đó ông còn trước tác Thiền Môn Định Tổ Đồ (禪門定祖圖), Truyền Pháp Chánh Tông Luận (傳 法 正 宗 論) và Phụ Giáo Biên (輔 教 編) để làm rõ hệ thống truyền thừa của Thiền Tông. Vào năm thứ 6 (1061) niên hiệu Gia Hựu (嘉祐), ông trình những trước tác của mình lên vua Nhân Tông; nhà vua xem xong hạ chiếu chỉ ban thưởng và năm sau ban cho ông hiệu Minh Giáo Đại Sư (明教大師). Về sau ông đến sống tại Phật Nhật Sơn (佛日山) và thị tịch vào ngày mồng 4 tháng 6 năm thứ 5 niên hiệu Hy Ninh (熙 寧), hưởng thọ 66 tuổi. Ngoài ra ông còn một số các trước tác khác như Truyền Pháp Chánh Tông Ký (傳法正宗記), Đàm Tân Văn Tập (鐔津文集), Trị Bình Tập (治平集), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Nhật Nguyệt Châu Quang", "definition": "Buddha of the Sun and Moon Gems.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhật Nguyệt Quang", "definition": "Buddha of the Sun and Moon Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Nhật Viên Minh Đại Sư", "definition": "佛 日 圓 明 大 師. Thụy hiệu của Thiền tăng ấn Giản, sống vào khoảng đời Kim, đời Nguyên. X. Ấn Giản.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Nhật Đại Sư", "definition": "佛 日 大 師. Hiệu của Thiền tăng Tông Cảo, sống vào đời Tống. X. Tông Cảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Nhật Đậu Bộc", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Nhị Chủng Thập Thân", "definition": "佛二種十身 (Hoa Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Oan Thiền Sư Ngữ Lục", "definition": "Ngữ Lục, 12 quyển, do ngài Phật oanTriệt cương soạn vào đời Thanh, ngài Tính thuần biên tập, ấn hành vào năm Khang Hi 36 (1697).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Phàm Nhất Thể", "definition": "Cũng gọi Sinh Phật Bất Nhị, Sinh Phật Nhất Như, Sinh Phật Bình Đẳng, Phàm Thánh Bất Nhị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp", "definition": "Buddha dharma (S), Buddhism Butsudo (J), Buppō (J), Buppō daimeiroku (J),", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Pháp Chân Như", "definition": "Phật Pháp chỉ cho 5 trí, 37 trí...… mà Đức Phật có đầy đủ, trí này là trí đức của Thức Đại (Đại thứ 6); còn Chân Như là chỉ cho cái lí mà Đức Phật chứng được, lí này là lí đức của 5 Đại trước (đất, nước, gió, lửa, không).Hợp chung 2 đức lí và trí lại thì đó là thể tính của thực tướng sắc tâm sẵn có trong chúng sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Kim Thang Biên", "definition": "Tác phẩm, 16 quyển, do ngài Đại Tông Tâm Thái (1327-1415) soạn vào đời Minh, được đưa vào Vạn Tục Tạng tập 148.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Kim Thang Lục", "definition": "Tác phẩm, 3 quyển, do cư sĩ Hồng Bao hiệu Đồ Long soạn vào đời Minh, sách được hoàn thành vào năm Vạn Lịch 30 (1602). Quyển thượng, tác giả trưng dẫn luận điệu bài Phật của các Nho gia đời Tống để bác bỏ. Trong 2 quyển trung, hạ tác giả dùng những lời giản dị để giải thích những danh từ Phật Giáo khó hiểu trong các Tông Thiên Thai, Tịnh Độ, Luật, Thiền...… nhằm làm cho sự truyền bá Phật Giáo được phổ cập trong nhân gian….", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Kim Thang Thiên", "definition": "(佛法金湯篇, Buppōkintōhen): 16 quyển, do Đại Tông Tâm Thái (岱宗心泰) nhà Minh biên, trùng khắc vào năm thứ 24 (1596) niên hiệu Vạn Lịch (萬曆). Đây là thư tịch lịch sử hộ trì Phật pháp do Đại Tông Tâm Thái―vị tăng ở Đông Sơn Thiền Tự (東山禪寺) vùng Việt Châu (越州, Tỉnh Sơn Đông)―thâu tập 398 mẫu truyện của những người đã từng quy y và hộ trì Phật pháp như các đấng quân chủ, Tể Quan, danh Nho, v.v., trải qua các đời từ vua Chiêu Vương (昭王) nhà Chu cho đến Thuận Tông (順宗) nhà Nguyên. Đầu sách có lời tựa của Tông Lặc (宗泐), Thanh Tuấn (清濬), Thủ Nhân (守仁), Tô Bá Hành (蘇伯衡), v.v., và lời tựa trùng san của Du Nhữ Vi (俞汝爲).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Pháp Lục Danh", "definition": "Sáu tên gọi khác của Phật Pháp. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Thân", "definition": "Buddhadharmakāya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Pháp Thắng Vương", "definition": "Buddha of Dharma-King Victory.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Pháp Thọ Mệnh", "definition": "Sự sống lâu dài của Phật Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Tăng", "definition": "Buddha dharma shanga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Pháp Tử Nhân", "definition": "Xác chết trong Phật Pháp, tức chỉ cho người vi phạm 4 tội nặng: Giết người, dâm loạn, ăn cướp và nói dối mà giới luật Tiểu Thừa cấm ngặt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Vô Biên", "definition": "Giáo pháp của Đức Phật rộng lớn như biển cả không có bờ bến.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Đại Long", "definition": "佛 法 大 龍. Rồng lớn Phật pháp dụ chỉ bậc có oai đức lớn và nhiều thần lực trong cửa Phật. Hoằng Nhẫn truyện trong TCTT q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Pháp Đại Minh Lục", "definition": "Tác phẩm, 20 quyển, do cư sĩ Khuê Đường, soạn vào cuối đời Tống.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Pháp Đại Ý", "definition": "佛 法 大 意. Đại ý của phật pháp, Ý chính của Phật pháp. Đây là vấn đề vô thượng thậm thâm, bất khả tư nghì, không thể dùng ngôn ngữ, văn tự mà biểu đạt, cũng không thể cố gắng dùng phàm tình mà mong nắm bắt được. Vì vậy đối với các thiền sư đắc đạo thì kẻ nào chưa ngộ mà hỏi bàn đến Phật pháp đại ý là đã làm một hành động vô lý ngược đời. Các ngài trả lời bằng cách: Hoặc nín thinh một chập rồi hỏi lại “hiểu không”, hoặc trả lời bâng quơ dường như vô nghĩa, hoặc chỉ những vật, nói những điều thật bình thường giản dị hợp tự nhiên, hoặc đối đáp bằng cử chỉ hay lời nói vô lý ngược đời, hoặc dùng cách mạnh bạo là hét hay đánh. Chương Hành Tư Thiền Sư trong TĐT q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Phát", "definition": "Buddhakesa (S), Buddha's hair.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Phược Pháp Phược", "definition": "Đồng nghĩa: Phật kiến pháp kiến. Phật buộc pháp buộc, nghĩa là tâm bị Kiến Chấp đối với Phật Pháp trói buộc không thể giải thoát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Phật", "definition": "Hàm ý là chư Phật. Chẳng hạn như từ Phật phật tổ tổ là chỉ cho chư Phật ba đời mười phương và lịch Đại chư tổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Phổ Hiện Sắc Thân Quang", "definition": "Buddha of the Light of Universally Manifested Form", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Phổ Kiến Như Lai", "definition": "Xem Văn Thù Sư Lợi Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Phổ Minh", "definition": "Buddha of Universal Brilliance.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Phổ Quang", "definition": "Buddha of Universal Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Phổ Tịnh", "definition": "Buddha of Tranquility.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quan Thế Đăng", "definition": "Buddha of Lamp that Observes the World.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quang", "definition": "Bukkho (J), Fokuang (C), Bukkho (J), Buddha ransi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quang Phái", "definition": "Bukkō-ha (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quang Quốc Sư", "definition": "Bukko Kokushi (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quang Quốc Sư Ngữ Lục", "definition": "Gọi đủ: Sắc Thụy Phật Quang Viên Mãn Thường Chiếu Quốc Sư Tam Hội Ngữ Lục. Cũng Gọi Phật Quang Viên Mãn Thường Chiếu Quốc Sư Ngữ Lục, Viên Mãn Thường Chiếu Quốc Sư Ngữ Lục, Phật Quang Hòa Thượng Ngữ Lục, Phật Quang Thiền Sư Ngữ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quang Sơn Tự", "definition": "Ngôi chùa ở làng Đại Thụ, huyện Cao Hùng, Đài Loan, do Đại Sư Tinh Vân sáng lập vào năm Dân Quốc 56 (1967), trên 1 khoảng đất hơn 50 mẫu Tây.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quang Thiền Sư", "definition": "Bukkō Zenji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quang Tịnh Xá", "definition": "Một trong những cơ sở phúc lợi xã hội do Phật Quang Sơn sáng lập.Tinh Xá được xây dựng ở chân núi phía tây Phật Quang Sơn trong làng Đại thụ, huyện Cao Hùng, Đài Loan, phía dưới ngọn Nga Mi, phía sau trường Trung học Phổ Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quang Tổ Nguyên", "definition": "(佛光祖元, Bukkō Sogen, 1226-1286): vị Thiền tăng của Phái Dương Kì và Phá Am thuộc Lâm Tế Tông Trung Quốc, vị tổ khai sơn Viên Giác Tự (圓覺寺, Enkaku-ji) ở vùng Liêm Thương (鎌倉, Kamakura), vị tổ của Phái Phật Quang (佛光派), tự là Tử Nguyên (子元), hiệu Vô Học (無學), người Phủ Khánh Nguyên (慶元府, thuộc Tỉnh Triết Giang ngày nay), họ là Hứa (滸). Theo lời chỉ thị của anh là Trọng Cử Hoài Đức (仲擧懷德), ông đến tham bái Bắc Nhàn Cư Giản (北礀居簡) ở Tịnh Từ Tự (淨慈寺), Hàng Châu (杭州, thuộc Tỉnh Triết Giang) và xuất gia theo vị nầy. Sau đó, ông đến làm môn hạ của Vô Chuẩn Sư Phạm (無準師範) ở Kính Sơn (徑山), được vị nầy ấn khả cho và kế thừa dòng pháp. Sau khi thầy ông qua đời, ông lại đến tham yết một số danh tăng khác như Thạch Khê Tâm Nguyệt (石溪心月) ở Linh Ẩn Tự (靈隱寺), Yển Khê Quảng Văn (偃溪廣聞) ở Dục Vương Sơn (育王山), Hư Đường Trí Ngu (虛堂智愚), v.v. Sau đó, ông trở về quê cũ, theo làm môn đệ của Vật Sơ Đại Quán (物初大觀) ở Đại Từ Tự (大慈寺) mà tu hành tọa Thiền suốt hai năm ròng. Về sau, thể theo lời thỉnh cầu của vị ấp chủ La Quý Trang (羅季莊), ông đến trú tại Bạch Vân Am (白雲庵) ở Đông Hồ (東湖). Khi ấy ông 37 tuổi, ông sống nơi đây trong vòng 7 năm, rồi sau khi thân mẫu ông qua đời, ông đến phụ giúp với pháp huynh Thối Canh Hành Dũng (退耕行勇) ở Linh Ẩn Tự. Kế tiếp ông lại được Đại Truyền Cống Thu Hác (大傳賈秋壑) cung thỉnh đến trú tại Chơn Như Tự (眞如寺), vùng Đài Châu (台州, thuộc Tỉnh Triết Giang ngày nay) trong vòng 7 năm. Đến năm đầu (1275) niên hiệu Đức Hựu (德祐), để lánh nạn đao binh của quân nhà Nguyên, ông đến trú tại Năng Nhân Tự (能仁寺) vùng Ôn Châu (溫州, thuộc Tỉnh Triết Giang ngày nay). Sau đó, ông lại trở về Tứ Vương Sơn (四王山), đến tham viếng pháp huynh ở Thiên Đồng Sơn (天童山) là Hoàn Khê Duy Nhất (環溪惟一), dừng chân lưu lại đây và thuyết giáo cho đại chúng. Đến năm thứ 2 (1279) niên hiệu Hoằng An (弘安), nhân việc Tướng Quân Bắc Điều Thời Tông (北條時宗, Hōjō Tokimune) triệu thỉnh những vị Thiền tăng cao đức sang Nhật làm trú trì Kiến Trường Tự (建長寺, Kenchō-ji) ở vùng Liêm Thương (鎌倉, Kamakura), Tổ Nguyên được suy cử, nên vào tháng 5 cùng năm nầy ông rời khỏi Thái Bạch Sơn (太白山), rồi ngày 30 tháng 6 thì đến Thái Tể Phủ (太宰府), và tháng 8 thì đến Liêm Thương. Khi ấy Thời Tông nghênh đón ông rất trọng thể, và cử ông làm trú trì Kiến Trường Tự sau khi Lan Khê Đạo Long (蘭溪道隆) qua đời. Vào mùa đông năm 1282, Thời Tông kiến lập nên Viên Giác Tự, rồi thỉnh Tổ Nguyên đến làm tổ khai sơn chùa nầy. Về sau, ông kiêm quản cả hai chùa Kiến Trường và Viên Giác, bố giáo Thiền phong khắp vùng Liêm Thương, và trong vòng 8 năm lưu trú tại Nhật, ông đã xác lập cơ sở Lâm Tế Tông Nhật Bản. Vào tháng 8 năm thứ 9 niên hiệu Hoằng An (弘安), ông phát bệnh, và đến ngày mồng 3 tháng 9 thì viên tịch, hưởng thọ 61 tuổi đời, 49 pháp lạp. Ông được ban thụy hiệu là Phật Quang Quốc Sư (佛光國師) và hiệu là Viên Mãn Thường Chiếu Quốc Sư (圓滿常照國師). Bộ Phật Quang Quốc Sư Ngữ Lục (佛光國師語錄) của ông gồm 10 quyển hiện còn lưu hành.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Quang Tự", "definition": "I.Phật Quang Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quang Xuất Bản Xã", "definition": "Nhà xuất bản Phật Quang, 1 trong những cơ sở xuất bản văn hóa của Phật Quang Sơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quán Ngũ Sự Giáng Sanh", "definition": "佛觀五事降生 (Nhân Quả Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Quán Ngũ Sự Giáng Sinh", "definition": "Đức Phật Quán xét năm việc giáng sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quả", "definition": "Buddhaphala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quả Thiền Sư", "definition": "佛 果 禪 師. Hiệu của Thiền tăng Khắc Cần, sống vào đời Tống. X. Khắc Cần.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Quảng Trang Nghiêm Vương", "definition": "Buddha of King Adorned by Vast Glory.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quật Duy Tắc", "definition": "(佛窟惟則, Bukkutsu Isoku, 751-830): vị tăng của Ngưu Đầu Tông Trung Quốc, còn gọi là Di Tắc (遺 則), xuất thân vùng Kinh Triệu (京 兆, Trường An), họ Trường Tôn (長孫). Ông xuất gia khoảng năm 23 tuổi, theo làm môn hạ của Huệ Trung (慧 忠) thuộc Ngưu Đầu Tông. Sau khi đại ngộ, ông vào trong hang núi Phật Quật (佛窟) trên Thiên Thai Sơn (天台山) kiến lập tinh xá và trở thành vị tổ của Học Phái Phật Quật. Vào ngày 15 mùa hè năm thứ 4 niên hiệu Thái Hòa (太和), ông thị tịch, hưởng thọ 80 tuổi. Trước tác của ông để lại cho hậu thế có Dung Tổ Sư Văn (融祖師文) 3 quyển, Bảo Chí Thích Đề (寳誌釋題), Nam Du Phó Đại Sĩ Tự (南遊傅 大士序), Vô Sanh Đẳng Nghĩa (無生等義) và thi ca hơn 10 thiên.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Quật Tự", "definition": "Chùa ở núi Ngưu Đầu, phía nam huyện Giang Ninh, tỉnh Giang Tô, Trung Quốc. Trong núi này có hang động, đời gọi là động Bích Chi Phật. Khoảng những năm Vĩnh Sơ, Cảnh Bình, quan Tư Không họ Lưu dựa theo hang núi mà lập chùa, gọi là Phật quật tự(chùa Hang Phật). (Hoặc có thuyết cho rằng chùa này do quan Tư Không Từ độ sáng lập vào khoảng năm Thiên Giám đời Lương). Quan Tư Không họ Lưu cũng chép 7 tạng kinh sách cất giữ trong chùa, người tu thiền từ khắp nơi đến chùa này. Vào cuối đời Tùy đầu đời Đường, Đại sư Pháp Dung cũng từng chú tích tại đây, chùa trở thành nơi đọc Đại Tạng và mở đạo của ngài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quốc", "definition": "Buddha-bhūmi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Quốc Duy Bạch", "definition": "(佛國惟白, Bukkoku Ihaku, ?-?): vị tăng của Vân Môn Tông sống vào cuối thời Bắc Tống, pháp từ của Pháp Vân Pháp Tú (法雲法秀). Ông đã từng trú trì ở Pháp Vân Tự (法雲寺) thuộc Biện Kinh (汴京). Ông được vua Triết Tông, Huy Tông quy y theo, được ban cho thụy hiệu là Phật Quốc Thiền Sư (佛 國禪 師). Vào tháng 8 năm đầu (1101) niên hiệu Kiến Trung Tĩnh Quốc (建中靖國), ông soạn bộ Kiến Trung Tĩnh Quốc Tục Đăng Lục (建中靖國續燈錄, Kenchūseikokuzokutōroku, 30 quyển), được nhà vua ban ngự chế lời tựa và cho nhập vào Đại Tạng. Đến cuối đời ông chuyển đến Thiên Đồng Sơn (天童山). Ngoài ra ông còn viết bộ Đại Tạng Cương Mục Chỉ Yếu Lục大藏綱目指要錄, 8 quyển).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Quốc Kí Địa Lí Khảo Chứng", "definition": "Tác phẩm, 1 quyển, do ông Đinh Khiêm đời Thanh soạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quốc Lịch Tượng Biên", "definition": "Tác phẩm, 5 quyển, do ngài Vô Ngoại Tử, Viên Thông (1745-1834) thuộc tôngThiên Thai Nhật Bản biên soạn. Soạn giả đã nghiên cứu về ngày tháng và đồ dùng để nghiên cứu thiên văn ghi trong ccác kinh điển Phật Giáo suốt 30 năm, cho mãi đến năm Văn Minh thứ 7 (1810) mới công bố.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Quốc Thiền Sư Ngữ Lục", "definition": "Ngữ Lục, 2 quyển, do ngài Cao Phong Hiển Nhật (12411316) người Nhật Bản soạn, được thu vào Đại Chính Tạng tập 80.Nội dung sách này ghi chép các Ngữ Lục như:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Sinh Hội", "definition": "Cũng gọi Quán Pháp Hội, Giáng Đản Hội, Dục Hóa Trai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Sát", "definition": "Xem Phật Độ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Sơn", "definition": "Núi ở huyện Hải Nam, tỉnh Quảng Đông, Trung Quốc, cách thành phố Quảng Châu khoảng 16 cây số.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Sơn Hải Huệ Tự Tại Thông Vương", "definition": "Buddha of Sovereign and Universal King of Mountains and Seas Wisdom.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Sư", "definition": "Cũng gọi Tạo Phật Sư, Tạo Phật Công, Phật Công.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Sư Tử Hống Tự Tại Thắng Vương", "definition": "Buddha of King of the Sovereign Force of Lion Roar.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Sở Hành", "definition": "Buddha-carita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Sở Hành Tán", "definition": "Phạm: Buddhacarita.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Sở Hành Tán Kinh", "definition": "Buddha-carita Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Sử", "definition": "Buddha-vaṃsa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Sự", "definition": "Tất cả các công việc nhằm hộ trì Tam Bảo, hoằng dương Phật pháp và giáo hóa chúng sinh, đều được gọi là “Phật Sự”. Riêng trong Thiền Tông Trung-quốc, từ “Phật Sự” được dùng để chỉ cho các công việc nhất định trong thiền môn như an vị Phật, khai nhãn, niêm hương, thượng đường, nhập thất, khai thị, phổ thuyết v.v... Ngày nay, Phật giáo Trung-quốc thường dùng từ này để gọi chung cho các nghi thức được cử hành trước Phật, kể cả nghi thức tụng kinh cầu siêu cho các vong linh; và từ Phật Sự ở đây cũng được gọi là pháp sự, hay pháp hội.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Tam Mật", "definition": "佛三密 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Tam Ngữ", "definition": "佛三語 (Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Tam Sự Nhập Thành", "definition": "佛三事入城 (Kim Cang Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Tam Thân Tán", "definition": "Cũng gọi Tam Thân Tán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tang Hoa", "definition": "Chỉ cho hoa trắng. Hoa trắng tượng trưng cho hoa của 2 cây Sa La biến thành màu trắng khi Đức Thế Tôn nhập diệt, giống như màu trắng của chim hạc, cho nên gọi là Phật tang hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thiện Tịch Nguyệt Âm Diệu Tôn Trí Vương", "definition": "Buddha of the King of Sublime and Honoured Insight, and Excellence Quiescent Lunar Sound.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thiện Ý", "definition": "Buddha of Excellent Mind.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết", "definition": "Phật nói: Đức Phật dùng kim khẩu (miệng vàng) tự giảng nói các pháp.Vì để nêu rõ pháp do chính kim khẩu của Phật nói ra và để phân biệt với các pháp do Tam Thừa, trời, người nói ra nên ở đầu các kinh thường đặt 2 chữ “Phật thuyết” để chứng minh pháp do Phật nói là giáo pháp chân thực. Còn pháp do Bồ Tát nói nếu được Đức Phật ấn khả thì cũng được coi như Phật thuyết. [X. Luận Đại Trí Độ Q.2; Kim Cương Bát Nhã Sớ Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thuyết Bát Đại Cát Tường Chú Vương Kinh", "definition": "Fo-shuo pa-chi-hsiang shen-chou ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Duy Ma Cật Kinh", "definition": "Fo-shuo Wei-mo-chieh ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Dược Vương Dược Thượng Nhị Bồ Tát Kinh", "definition": "Fo-shuo kuan Yao-wang Yao-shang erh-p'u-sa ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Hoa Thủ Kinh", "definition": "Fo-shuo hua-shou ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Như Vậy", "definition": "Xem Như Thị Ngữ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Phật Danh Kinh", "definition": "Fo-shuo fo-ming ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Quán Di Lặc Bồ Tát Thượng Sanh Đâu Suất Thiên Kinh", "definition": "Fo-shuo kuan Mi-lo p'u-sa shang-sheng Tu-shi-t'ien ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Quán Phật Tam Mui Hải Kinh", "definition": "Fo-shuo kuan-fo san-mei-hai ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Quán Phổ Hiền Bồ Tát Hạnh Pháp Kinh", "definition": "Fo-shuo kuan Pu'-sien p'u-sa hsing-fa ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Quán Đảnh Kinh", "definition": "Fo-shuo kuan-t'ing ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Thiết Thành Nê Lê Kinh", "definition": "Kinh, 1 quyển, do ngài Trúc Đàm Vô Lan dịch vào đời Đông Tấn, được thu vào Đại Chính Tạng tập 1.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thuyết Thiền Môn Kinh", "definition": "Kinh, 1 quyển, 1 trong các bộ kinh giả được soạn vào đời Đường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thuyết Tác Phật Hình Tượng Kinh", "definition": "Fo-shuo tso fo-hsing-hsiang ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Tôn Thắng Đà Ra Ni Kinh", "definition": "Po-ting tsun-sheng t'o-lo-ni ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Vô Lượng Môn Phá Ma Đà La Ni Kinh", "definition": "Buddha-bhāṣita-amita-mukha-mārajid-dhāraṇī-Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Vô Lượng Môn Vi Mật Trì Kinh", "definition": "Buddha-bhāṣita-amitamukha-guhyadhara-Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Vị Tằng Hữu Kinh", "definition": "Fo-shuo wei-tseng yu ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Xuất Sinh Vô Biên Môn Đà La Ni Kinh", "definition": "Buddha-bhāṣita-jātānantamukha-dhārāṇi Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thuyết Đại Tập Hi Chánh Pháp Kinh", "definition": "Fo-shuo to-chi-hui cheng-fa ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thành Đạo Nhật", "definition": "Cũng gọi Thành Đạo Hội, Thành Đạo Tiết, Lạp Bát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tháp", "definition": "Tháp là nơi thờ xá lợi của Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thân", "definition": "Buddha-kāya (S), Busshin (J), Sang gye chi cho (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thích Ca Mâu Ni", "definition": "Sakya-muni : là vị Giáo Tổ của Phật giáo. Ngài nguyên là thái tử Tất Đạt Đa (Siddhartha Gautama), con của vua Tịnh Phạn (Suddhodana Gautama) và hoàng hậu Ma Ha Ma Da (Mahamaya) ở thành Ca-tì-la-vệ (Kapila-vastu) của vương quốc Thích-ca (Sakya), ở phía Bắc bán đảo Ấn-độ thời cổ đại (nay là miền Nam của nước Nepal). Ngài đản sinh trong vườn Lam-tì-ni (Lumbini – phía Đông thành Ca-tì-la-vệ, nay thuộc lãnh thổ nước Nepal), vào ngày trăng tròn tháng Vesaka (lịch Ấn-độ – nhằm ngày trăng tròn tháng 5 dương lịch, tức ngày Rằm tháng Tư âm lịch) năm 624 tr. TL. Sau khi sinh thái tử được bảy ngày thì hoàng hậu Ma Da từ trần. Vua Tịnh Phạn bèn giao thái tử cho bà di mẫu (mà cũng là kế mẫu) của thái tử là hoàng hậu Ma Ha Ba Xà Ba Đề (Maha-prajapati) nuôi dưỡng và dạy dỗ thành người. Thái tử cực kì thông minh, lại được vua cha cho học hành chu đáo. Các môn như văn học, lí học, số học, nghệ thuật, thiên văn, v.v... kể cả võ nghệ, môn nào ngài cũng học mau chóng và xuất sắc, trội hẳn các vương tử khác trong hoàng tộc, làm cho các vị giáo sư đều phải kinh ngạc, bái phục.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Thư", "definition": "Cũng gọi Phật Điển, Nội Điển, Diệu Điển. Đối Lại: Ngoại Điển, Thế Điển, Ngoại Đạo Thư, Ngoại Tục Thư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thư Giải Thuyết Đại Từ Điển", "definition": "Từ điển, 14 quyển, do học giả Tiểu Dã Huyền Diệu chủ biên, Nhật Bản Đại Đông xuất bản ấn hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thư Xuất Bản Giới", "definition": "Các nhà xuất bản kinh sách Phật Giáo. Tứ đầu thế kỉ XX đến nay, nhờ kĩ thuật ấn loát tiến bộ, các nhà xuất bản kinh sách Phật Giáo ở các nước phát triển mạnh mẽ. Các sách cũ được in lại hoặc sách mới xuất bản, về mặt chất và lượng đều cao.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thường Quang Tràng", "definition": "Buddha of Eternal-Light Banner.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thạch", "definition": "佛 石. Thiền tăng đời Minh, họ Đái, hiệu Pháp Vũ Lão Nhân, người xứ Tiền Đường (nay là Hàng Châu) Trung Quốc. Năm 14 tuổi, sư nương Thiền Sư Tịnh Minh xuất gia; đến 18 tuổi sư theo ngài Châu Hoằng thụ giới cụ túc. Trải qua các pháp hội, sư tu tập giáo quán Thiên Thai. Niên hiệu Vạn Lịch thứ 22 (1594), đến Nam Kinh yết kiến Thiền Sư Tử Bách, được ngài thọ ký, sư trở về Hàng Châu, ở ẩn nơi vắng vẻ thế mà hàng danh sĩ tăng lữ tới lui không ngớt. Một hôm sư đào đất gặp một tấm bia còn sót lại, mới biết đây là nền cũ của chùa cổ Lý An, nên quyên góp của cải để xây dựng lại. Tính sư thích sống cô tịch, về già không tiếp khách, lánh mặt ở trên đỉnh núi.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Thất", "definition": "Chỉ cho tòa ngồi của vị A Xà Lê tu chúng sinh Du Già trong 9 vị trí Bạch Đàn Mạn Đồ La trong Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thần Thông", "definition": "Thần thông của Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thập Chủng Hóa Bất Thất Thời", "definition": "佛十種化不失時 (Hoa Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Thập Nhất Chủng Trì", "definition": "佛十一種持 (Hoa Nghiêm Kinh và Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Thập Nhất Trì", "definition": "Mười một phưong thức trụ trì của đức Phật:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thập Túc Duyên", "definition": "佛十宿緣 (Kinh Phật Thuyết Hưng Khởi Hành)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Thập Vô Ngại", "definition": "佛十無礙 (Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Thế", "definition": "Chỉ cho thời đại Đức Phật đang còn tại thế giáo hóa chúng sinh. Nhưng muốn gặp được Phật tại thế rất khó, đó là 1 trong 8 nạn của chúng sinh. (xt.Bát Nạn).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thế Tôn", "definition": "Buddha Bhagavat (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thế Tịnh Quang", "definition": "Buddha of Light Which Makes the World Serene.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thọ", "definition": "Buddha-dattha (S), Buddha-datta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thọ Luận Sư", "definition": "Buddhatta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thọ Tứ Dụ", "definition": "Bốn thí dụ về tuổi thọ của Đức Phật nói trong Kinh Kim Quang Minh quyển 1.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thổ", "definition": "佛土. Đất Phật. Chỉ nơi Phật ở Cũng chỉ nước Ấn Độ, quê hương của Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Thời", "definition": "Buddhataraṁ (S), Period of a Buddha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Thụ", "definition": "佛樹. Cây Phật, một tên gọi cây Bồ Đề ( vì Phật ngồi dưới cây này mà đắc đạo ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Thụ Kí Tự", "definition": "Chùa ở thành Lạc Dương, do ngài Hoài Nghĩa xây dựng vào đời Đường. Các vị cao tăng từ Ấn Độ đến Trung Quốc, phần nhiều trụ ở chùa này để dịch kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thụ Nha", "definition": "Cũng gọi Phật Thụ Vương Nha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Thủ", "definition": "佛手. Tay Phật Tên một thứ trái cây, vỏ mọc dài ra như hình các ngón tay. Ta cũng gọi là trái Phật thủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Thủ Nham Hòa Thượng", "definition": "佛 手 岩 和 尚. Thiền tăng đời Ngũ Đại, tên Hành Nhân ở trong hang đá Phật Thủ Nham, nên có hiệu “Phật Thủ Nham Hòa Thượng”. X. Hành Nhân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Thừa", "definition": "Nhất Phật Thừa - Nhất thừa. Phật Thừa, hay Nhất Phật Thừa, hay Nhất thừa, là giáo pháp duy nhất đưa đến sự chứng ngộ tuệ giác viên mãn, siêu việt, tối thượng của chư Phật; cũng gọi là giáo pháp liễu nghĩa thượng thừa, hay đệ nhất nghĩa đế.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Thừa Giới", "definition": "Giới Luật của người dốc chí cầu quả vị Phật thụ trì. Tức giới luật được nói trong Kinh Phạm Võng. [X. Phẩm Học Xứ Kinh Đại Nhật]. (xt. Giới).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tiền", "definition": "佛前. Trước bàn thờ Phật. Đoạn trường tân thanh có câu: “Phật tiền thảm lấp sầu vùi. Ngày pho thủ tự đêm nhồi tâm hương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Trang Nghiêm Cảnh Giới Tam Muội", "definition": "Chỉ cho Tam Muội trụ trong thể tự chứng chân thực của chư Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tri Kiến", "definition": "Phạm: Tathàgatajĩàna-darzana.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Triết", "definition": "Phật Triết (?-?). Cũng gọi Phật triệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Truyên Điển Tịch", "definition": "Chỉ cho những kinh sách nói về sự tích 1 đời Đức Phật, hoặc các bộ luận đứng trên lập trường giá trị tư tưởng nhân loại mà nghiên cứu, phân tích, phê bình, đánh giá các sự tích, tinh thần, giáo thuyết của Đức Phật. Ngoài ra, cũng bao gồm những trứ tác với nôi dung phân loại, chỉnh lí, khảo chứng và phê phán các kinh điển, các bộ luận nói trên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Trí", "definition": "Xem Nhất Thiết Chủng Trí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Trí Hoằng Tế Thiền Sư", "definition": "Butchi kōsai zenji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Trí Huệ Thắng", "definition": "Buddha of Victorious Insight and Wisdom.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tu Di Quang", "definition": "Buddha of Mt Sumeru's Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tu Ma Na Hoa Quang", "definition": "Buddha of Jasmine-Blossom Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tuê", "definition": "Phạm: Tathàgata- jĩàna-darzana.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tài Quang", "definition": "Buddha of Adept Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tài Quang Minh", "definition": "Buddha of Radiance of Adept Talent.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tán", "definition": "Những bài kệ tán thán, ca tụng đức", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tánh", "definition": "Buddhatā (P), Buddhahood, Busshō (J), Tathāgatagarbha (S), de shin shek pay nying po (T), de shin shek pay nying po (T), Buddha nature.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tánh Hiểu", "definition": "Busshō-u (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tánh Không", "definition": "Busshō-kū (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tánh Luận", "definition": "Buddhagotra śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tánh Vô", "definition": "Busshō-mu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tâm", "definition": "Buddha-mind.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tâm Bản Tài", "definition": "佛 心 本 才. Thiền tăng Bản Tài có hiệu là Phật Tâm, người đời gọi là Phật Tâm Bản Tài, sống vào đời Tống. X. Bản Tài.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Tâm Kinh Phẩm Diệc Thông Đại Tùy Cầu Đà La Ni", "definition": "Gọi tắt: Phật Tâm Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tâm Pháp", "definition": "Busshin-hō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tâm Thiên Tử", "definition": "Chỉ cho vua Lương Vũ Đế thời Nam Triều. Nhà vua từng mặc ca sa giảng Kinh Phóng Quang Bát Nhã, cho nên người đời gọi ông là Phật Tâm Thiên Tử. [X. Tắc 1, Bích Nham Lục].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tâm Tông", "definition": "Busshin-shū (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tâm Ấn", "definition": "Ấn tâm Phật. Tâm Phật tức là chân tâm sẵn có của chúng sinh, là thể mầu nhiệm của tính Đại Giác, tâm này nhất định không biến đổi, như dấu ấn của thế gian, vì thế gọi là Ấn. [X. Phẩm Cơ Duyên trong Lục Tổ Đàn Kinh; tắc 1 Bích Nham Lục].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tích", "definition": "佛迹. Dấu vết của Phật để lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Tính", "definition": "Xem Pháp Tính.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tính Chân Như", "definition": "Từ ghép của hai khái niệm đồng nghĩa: Phật tính và Chân như. Phật tính chỉ mầm giác ngộ sẵn có trong mỗi chúng sinh. Chân như là Phật tính không sinh diệt, rất chân thực,không hư ngụy.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Tính Dữ Bát Nhã", "definition": "Tác phẩm, 1 quyển, do Mâu tông tam soạn, Đài Loan học sinh thư điếm ấn hành. Nội dung sách này lấy 2 quan niệm Phật Tính và Bát Nhã làm nòng cốt, rồi dùng tư tưởng viên giáo của Tông Thiên Thai để phát huy triết học Phật Giáo Trung Quốc đến cực điểm. Tuy tác giả có trình bày về Bát Nhã, Niết Bàn và nghĩa lí trong các bộ luận của Bồ Tát Long Thụ, nhưng trọng điểm vẫn là tư tưởng nghĩa học của Phật Giáo Trung Quốc các đời Nam Bắc Triều và Tùy Đường, đặc biệt nhấn mạnh Tông Thiên Thai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tính Luận", "definition": "Tác phẩm, 4 quyển, do ngài Thế Thân soạn, ngài Chân Đế dịch vào đời Trần, Trung Quốc, được thu vào Đại Chính Tạng tập 31.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tông", "definition": "佛宗. Đường lối chánh yếu của đạo Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Túc Thạch", "definition": "Cũng gọi Phật Túc Tích, Phật Cước Thạch. Phiến đá có khắc dấu bàn chân của Đức Phật trong đó biểu thị diệu tướng bánh xe nghìn nan hoa. Trông thấy dấu bàn chân của Đức Phật mà tham bái thì cũng giống như tham bái Sinh Thân thân của Đức Phật, có thể trừ diệt vô lượng tội chướng. Ở Ấn Độ, Trung Quốc, Nhật Bản từ xưa đã có Phật Túc Thạch và phong tục sùng kính Phật Túc Thạch cũng rất phổ biến. Phật Giáo Ấn Độ thời kì đầu, vì tôn kính nên không dám trực tiếp đắp vẽ tượng Phật mà chỉ khắc những hình ảnh gián tiếp tượng trưng Đức Phật như bánh xe pháp, cây Bồ Đề, tháp, tòa cao và Phật Túc Thạch...Về sau được truyền đến Trung Quốc, Nhật Bản thì Phật Túc Thạch cũng trở thành đối tượng lễ bái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tăng", "definition": "Bussō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tượng", "definition": "Buddharūpa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tạng Kinh", "definition": "Cũng gọi Phụng Nhập Long Hoa Kinh, Tuyển Trạch Chư Pháp Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tồ Vấn Tấn", "definition": "Trong Thiền Lâm, chắp tay, cúi đầu lễ bái trước tượng chư Phật và lịch Đại Tồ sư, gọi là Phật tổ vấn tấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ", "definition": "Bosso (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tổ Chính Pháp Trực Truyền", "definition": "Tác phẩm, 1 quyển, do ngài Phong ÔngTổ Nhất (quốc tịch không rõ, có thuyết cho là người Trung Quốc, cũng có thuyết cho là người Nhật Bản) biên soạn, được ấn hành vào năm Khang Lịch (Nhật Bản) thứ 3 (1381).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Chính Truyền Cổ Kim Tiệp Lục", "definition": "Cũng gọi Cổ Kim Tiệp Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Chính Tông Đạo Ảnh", "definition": "Tác phẩm, 4 quyển, do ngài Thủ Nhất Không Thành chép lại, ấn hành vào năm Quang Tự thứ 6 (1880) đời Thanh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Cương Mục", "definition": "Tác phẩm, 42 quyển, do Chu Thời An biên soạn vào đời Minh, ấn hành vào năm Sùng Trinh thứ 7 (1634), được thu vào Vạn Tục Tạng tập 140.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Hội", "definition": "Phật Tổ Hội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Khất Mệnh", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Kị Cửu Bái", "definition": "Nghi thức vị Trụ Trì lạy 9 lạy trong ngày giỗ Phật và giỗ Tổ Sư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Lịch Đại Thông Tải", "definition": "Gọi tắt: Thông Tải, Phật Tổ Thông Tải.Tác phẩm, 22 quyển (hoặc 36 quyển), do ngài Niệm Thường (thuộc phái Dương Kì Tông Lâm Tế) soạn vào đời Nguyên, được thu vào Đại Chính Tạng tập 49.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Môn", "definition": "佛 祖 門. Chỉ cho Phật giáo cùng Thiền Tông. Hám Sơn Lão Nhân Mộng Du Tập q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Tổ Tam Kinh", "definition": "Busso sankyō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tổ Tam Kinh Chỉ Nam", "definition": "Tác phẩm, 3 quyển, do ngài Lâm Đạo Bái soạn vào đời Minh, được thu vào Vạn Tục Tạng tập 59.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Thông Tải", "definition": "(佛祖通載, Bussotsūsai): Phật Tổ Lịch Đại Thông Tải (佛祖歷代通載, Bussorekidaitsūsai) (佛祖歷代通載, Bussorekidaitsūsai): còn gọi là Phật Tổ Thông Tải (佛祖通載, Bussotsūsai), Thông Tải (通載, Tsūsai), 22 quyển, do Mai Ốc Niệm Thường (梅屋念常) nhà Nguyên biên tập, san hành vào năm thứ 4 (1576) niên hiệu Vạn Lịch (萬曆). Niệm Thường ở Đại Trung Tường Tự (大中祥寺), Gia Hưng (嘉興, Tỉnh Triết Giang), theo niên kỷ các đời vua từ thời 7 vị Phật ở quá khứ cho đến năm đầu (1333) niên hiệu Nguyên Thống (元統) nhà Nguyên, ghi lại dưới hình thức biên niên các sự tích của Phật Giáo cũng như truyền ký của chư vị cao tăng để hình thành nên tác phẩm lớn này. Trải qua những điển tịch nội ngoại, có dẫn chứng uyên bác, bộ này đã làm sáng tỏ các điển cứ cố sự và đính chính những dị luận. Bản này có lời tựa của Vi Tiếu Am Đạo Nhân Ngu Tập (微笑庵道人虞集) ghi năm đầu (1341) niên hiệu Chí Chánh (至正) và lời tựa của Giác Ngạn (覺岸) vào năm thứ 4 (1344) cùng niên hiệu trên.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phật Tổ Thống Kỉ", "definition": "Gọi tắt: Thống Kỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Tâm Đăng", "definition": "Tác phẩm, 1 quyển (không rõ tác giả), được thu vào Vạn Tục Tạng tập 150.Nội dung sách này gồm 4 hạng mục:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Tông Phái Thế Phổ", "definition": "Tác phẩm, 8 quyển, do ngài Giới Am Ngộ Tiến biên soạn vào đời Thanh, ấn hành vào năm Thuận Trị 11 (1654), được thu vào Vạn Tục Tạng tập 147.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tổ Tông Phái Đồ", "definition": "Chỉ chung các loại đồ biểu trình bày hệ thống các tông phái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Tứ Chúng Hy Hữu", "definition": "佛四衆希有 (Kim Cang kinh toản yếu san định ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Tứ Đức", "definition": "佛四德 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phật Từ Hộ Ấn", "definition": "Cũng gọi Như Lai Từ Hộ Ấn, Phật Đại Từ Hộ Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Từ Lực Vương", "definition": "Buddha of King of Merciful Force.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Từ Thiền Sư", "definition": "佛 慈 禪 師. Hiệu của Thiền tăng Kế Thành do Vua Tống Huy Tông ban cho. X. Kế Thành.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Từ Tạng", "definition": "Buddha of Mercy Treasury.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tử", "definition": "Buddhist.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tử Tịnh Độ Chơn Tông", "definition": "Shin Buddhist.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tự Thuyết Kinh", "definition": "Xem Vô Vấn Tự Thuyết.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Tỳ Lô Giá Na", "definition": "Vairocana(-buddha) (S), Mahā-vairocana-buddha (S), nam par nang dze (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Vô Lượng Âm Thanh Quang", "definition": "Buddha of Limitless-Sound King.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Vật", "definition": "Những vật dụng thuộc về Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị A Chi La Ca Diếp Thuyết Kinh", "definition": "Cũng gọi Tự Hóa Tác Khổ Kinh, Phật Vị A Chi La Ca Diếp Tự Hóa Tác Khổ Kinh. Kinh, 1 quyển, (khuyết dịch), được thu vào Đại Chính Tạng tập 14.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Hoàng Trúc Viên Lão Thuyết Kinh", "definition": "Cũng gọi Phật Vị Hoàng Trúc Viên Lão Bà La Môn Thuyết Học Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Hải Long Vương Thuyết Pháp Ấn Kinh", "definition": "Kinh, 1 quyển, do ngài Nghĩa Tịnh dịch vào đời Đường, được thu vào Đại Chính Tạng tập 15.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Sa Già La Long Vương Sở Thuyết Đại Thừa Kinh", "definition": "Cũng gọi Phật Vị Sa Già La Long Kinh, Phật Vị Sa Già La Long Vương Sở Thuyết Đại Thừa Pháp Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Thiếu Niên Tỉ Khưu Thuyết Kinh", "definition": "Cũng gọi Chính Sự Kinh, Phật Vị Thiếu Niên Tỉ Khưu Thuyết Chính Sự Kinh. Kinh, 1 quyển, do ngài Pháp Cự dịch vào đời Tấn, được thu vào Đại Chính Tạng tập 14.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Thắng Quang Thiên Tử Thuyết Kinh", "definition": "Cũng gọi Phật Vị Thắng Quang Thiên Tử Thuyết Vương Pháp Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Thủ Ca Trưởng Giả Thuyết Nghiệp Báo Sai Biệt Kinh", "definition": "Cũng gọi Phân Biệt Thiện Ác Báo Ứng Kinh, Nghiệp Báo Sai Biệt Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Vị Ưu Điền Vương Thuyết Kinh", "definition": "Cũng gọi Phật Vị Ưu Điền Vương Thuyết Vương Pháp Chính Luận Kinh, Vương Pháp Chính Luận Kinh, Chính Luận Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật hiện ra nơi tâm.", "definition": "III.Tâm Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật là do tu hành muôn hạnh mà thành nên gọi là Phật quả, tức muôn hạnh năng thành là nhân, muôn đức sở thành là quả. Cũng tức là từ nhân tu hành mà đạt đến quả Phật vậy. [X. Kinh Phật Mẫu Xuất Sinh Tam Pháp Tạng Bát Nhã Q.15; Chính Pháp Nhãn Tạng Chư Ác Mạc Tác].", "definition": "II.Phật Quả (1063-1135).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Âm", "definition": "Buddhaghoṣa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Ý", "definition": "咈意. Trái ngược với điều mong muốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Ý Linh Nhạc", "definition": "佛 意 靈 岳 (1725-1821). Thiền tăng đời cuối Lê đầu Nguyễn, quê ở dinh Trấn Biên (tỉnh Biên Hòa hiện nay), miền Nam Việt Nam. Sư quy y thọ giáo với Hòa Thượng Thành Đẳng Minh Lượng chùa Đại Giác tại Đại Phố, Đồng Nai, dinh Trấn Biên (cù lao Phố, xã Hiệp Hòa, Tp Biên Hòa ngày nay). Sư vâng lời Thầy theo lớp dân từ Đồng Nai di cư xuống huyện Tân Bình, dinh Phiên Trấn của phủ Gia Định tức vùng đất Sài Gòn Gia Định sau này để cất am tranh ở. Đến năm 1752 với sự hộ giúp của bản đạo, sư xây dựng chùa Từ Ân (ở vị trí chợ Đũi, quận 3, Tp. Hồ chí Minh hiện nay). Sau khi lên ngôi, vua Gia Long sắc tứ và trùng tu chùa Từ Ân đồng thời ban y bát, sắc phong cho Thượng tọa Phật Ý Linh Nhạc làm Hòa Thượng. Ngày 20 tháng 11 năm Tân Tỵ (1821), Minh Mạng nguyên niên, sư thị tịch tại chùa Từ Ân, thọ 97 tuổi. Đồ chúng và quan chức Gia Định làm lễ an táng sư hết sức long trọng, lập tháp trong khuôn viên chùa Từ Ân (trong khuôn viên vườn Tao Đàn ở Tp. HCM hiện nay). Đến năm 1923, Thiền Sư Hồng Hưng tổ chức lễ thỉnh hài cốt của sư về chùa Giác Lâm và lập tháp mới bên cạnh tháp của Hòa Thượng Tổ Tông Viên Quang trong khuôn viên chùa Giác Lâm. Theo: LSPGĐT của Nguyễn Hiền Đức.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Đa Bảo", "definition": "Buddha Many Treasures", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phật Đa Ma La Bạt Chiên Đàn Hương", "definition": "Buddha of Tamala Leaves and SandalWood.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Điền", "definition": "Ruộng Phật. Trong Phật Giáo, đức được ví dụ như thửa ruộng để chúng sinh gieo trồng hạt giống phúc thiện, vì thế gọi là ruộng phúc. Cúng Dường Phật sẽ được tất cả phúc, tiêu diệt hết thảy tội.Trong tất cả ruộng phúc thì Phật là ruộng phúc hơn hết. [X. Luận Đại Trí Độ Q.30]. (xt. Bát Phúc Điền).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Điển Thích Lê", "definition": "Thông lệ giải thích kinh điển Phật Giáo. Về phương thức cũng như văn cú giải thích, tùy theo các tông phái mà có khác nhau. Nay lấy 3 tông: Tam Luận, Thiên Thai và Chân Ngôn làm tiêu biểu để trình bày như sau:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Điện", "definition": "Buddha hall, Butsuden (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà", "definition": "Butsuda (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Ba Lợi", "definition": "Xem Giác Hộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Bạt Đà La", "definition": "(Buddhabhadra, 359-429): dịch ra Hán ngữ là Giác Hiền. Ngài là người Bắc-Ấn, họ Thích, vốn là hậu duệ của Cam Lộ Phạn vương ở thành Ca-tì-la-vệ. Ngài xuất gia khi lên 17 tuổi, tinh cần tu học, thông thuộc mọi kinh điển, nhưng đặc chuyên về Thiền và Luật. Sau ngài sang nước Kế-tân, nhập môn học Thiền với ngài Phật Đại Tiên (Buddhasena). Tại đây ngài gặp ngài Trí Nghiêm (350-427) từ Trung-quốc sang, cũng đang học Thiền với ngài Phật Đại Tiên, bèn đáp ứng lời mời của ngài Trí Nghiêm, năm 408, cùng về đến Trường-an (kinh đô nhà Tiền-Tần), chuyên truyền bá Thiền học. Lúc ngài đến thì nơi đây đã có ngài Cưu Ma La Thập đang dạy đồ chúng ước khoảng 3.000 người, tiếng tăm lừng lẫy. Hai ngài có tiếp xúc với nhau và bàn luận về Pháp Tướng học, nhưng sau đó, vì môn hạ của hai ngài không dung hợp nhau, nên ngài đã dẫn hơn 40 đệ tử đi về phương Nam, nhận lời mời của ngài Tuệ Viễn, lên núi Lô-sơn, dịch bộ Đạt Ma Đa La Thiền Kinh. Ở đây vài năm, đến năm 415, ngài rời Lô-sơn để đi Kiến-khang, trú tại chùa Đạo-tràng, chuyên việc phiên dịch, cho đến khi viên tịch.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Đà Cù Hý Da", "definition": "Buddhaguhya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Cú Hi Da", "definition": "Phạm: Buddhaguhya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đà Cồ Sa", "definition": "Xem Phật Âm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Da Xá", "definition": "(Buddhayasas, ?-?): là vị cao tăng chuyên dịch kinh ở Trung-quốc vào thời đại Đông-Tấn. Ngài người nước Kế-tân, 13 tuổi xuất gia, đến 15 tuổi thì mỗi ngày có thể tụng hai, ba vạn câu kinh, 27 tuổi mới thọ giới cụ túc. Ngài thông hiểu khắp các kinh luận đại, tiểu thừa, chuyên cần đọc tụng, không biết mệt mỏi. Khi ngài Cưu Ma La Thập còn vân du tham học, từng thờ ngài làm thầy. Năm 408 (tức năm thứ 10 niên hiệu Hoằng-thỉ của nhà Hậu-Tần), đáp ứng lời thỉnh cầu của La Thập, ngài đã đến Trường-an để giúp ngài La Thập dịch Kinh Thập Trụ. Ngài cũng đã cùng với ngài Trúc Phật Niệm dịch các bộ Luật Tứ Phần Tăng Giới Bản, Tứ Phần Luật, và Kinh Trường A Hàm. Sau đó ngài trở về lại nước Kế-tân, tìm được bản Phạn ngữ của Kinh Hư Không Tạng, bèn gửi cho những người khách buôn đem sang tặng chư tăng ở Lương-châu (tỉnh Cam-túc). Về sau không biết ngài ra sao.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Đà Lí", "definition": "Làng Phật, là nơi vua Tôn Quyền nước Ngô, thời Tam Quốc, xây dựng chùa Kiến Sơ cho ngài Khang Tăng Hội ở. Đây là chùa tháp đầu tiên tại đất Ngô và cũng từ đó Phật Pháp khá thịnh hành ở xứ này. [X. Khang Tăng Hội truyện trongLương Cao Tăng Truyện Q.1]. (xt. KhangTăng Hội).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đà Mật Đa", "definition": "Phạm: Buddhamitra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đà Mật Đa Tổ Sư", "definition": "Buddha-mitra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Nan Đề", "definition": "Buddhanandi (S). Xem Nan Đề Tổ Sư.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Phiến Đa", "definition": "Buddhasānta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Tam Khuyến", "definition": "Chỉ cho 3 thứ danh hiệu mà Hòa Thượng Phật đà thường xưng niệm. Cứ theo chương pháp môn Phật đà trong Cảnh Đức Truyền Đăng Lục quyển 14, thì Hòa Thượng Phật đà ở chùa pháp môn tại phủ Phượng tường, thường cầm tràng hạt, xưng niệm 3 thứ danh hiệu: Thích Ca, Nguyên Hòa, Phật đà, lần hết 1 vòng thì trở lại từ đầu. Hành trạng của ngài rất khác thường, người đời không thể hiểu được chỉ gọi sự xưng niệm của ngài là Phật đà tam khuyến (ba cách khuyên người của Hòa ThượngPhật đà). [X. Thiền Uyển Mông Cầu Q.hạ].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đà Thiền Sư", "definition": "Phật Đà Thiền Sư ( ? - ? ).Cũng gọi Bạt Đà, Giác Giả.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đà Thập", "definition": "(Buddhajiva, ?-?): là vị sa môn người nước Kế-tân, sống vào thế kỉ thứ 5. Từ nhỏ ngài xuất gia với tăng đoàn của bộ phái Di Sa Tắc, chuyên cần học Luật, lại thông cả Thiền học. Năm 423 (thời Lưu-Tống) ngài đến Trung-quốc, được Lang Da vương thỉnh ở chùa Long-quang tại kinh đô Kiến-khang, và đã dịch bộ Luật Di Sa Tắc tức bộ Ngũ Phần Luật hiện hành). Hành trạng của ngài sau đó không thấy tài liệu nào ghi chép.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Đà Tăng Ha", "definition": "Buddhasiṃha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Tự", "definition": "Budda-ji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Đa La", "definition": "Buddhatrāta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đà Đà Sa", "definition": "S. Buddhadasa. Tác giả bộ Đại Tỳ Bà Sa Luận là bộ Luận được kết tập trong cuộc Đại hội kết tập kinh điển lần thứ Iv ở Kashmia.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phật Đà Đề Bà", "definition": "Buddhavaca (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đài", "definition": "佛臺. Bàn thờ Phật Chùa thờ Phật. “Nén hương đến trước Phật đài” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Đàn", "definition": "Butsu-dan (J),Bàn thờ Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đê Tử", "definition": "Đệ tử của Đức Phật, như 10 vị đại đệ tử là Ma Ha Ca Diếp, Xá Lợi Phất, Mục Kiền Liên, A Nan v.v... cho đến nhiều đệ tử khác lúc Đức Phật còn tại thế. Về sau, danh từ đệ tử được dùng để chỉ chung cho những ai tín ngưỡng giáo pháp của Đức Phật. (xt. Thập Đại Đệ Tử, Sư Đệ, Thích).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính", "definition": "Phạm: Buddhozịìza, Uwịìwa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính Phá Ma Kết Giới Hàng Phục Ấn", "definition": "Cũng gọi Phật Đính Phá Ma Hàng Phục Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính Phóng Vô Cấu Quang Minh Nhập Phổ Môn Quán Sát Nhất Thiết Như Lai Tâm Đà La Ni Kinh", "definition": "Gọi tắt: Phật Đính Phóng Quang Đà La Ni Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính Quốc Sư Ngữ Lục", "definition": "Gọi đủ: Định Tuệ Minh Quang Phật Đính Quốc Sư Ngữ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính Tôn Thắng Đà La Ni Chân Ngôn", "definition": "Kinh quĩ, 1 quyển, thuộc về pháp Tôn Thắng Đà La Ni trong Mật Giáo, do ngài Nhã Na người nước Cưu Tư dịch, được thu vào Đại Chính Tạng tập 19.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính Tôn Thắng Đà La Ni Kinh Sớ", "definition": "Kinh sớ, 2 quyển, do ngài Pháp sùng soạn vào đời Đường, được thu vào Đại Chính Tạng tập 39.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đính Đại Bạch Tản Cái Đà La Ni Kinh", "definition": "Cũng gọi: Bạch Tản Cái Đà La Ni Kinh, Bạch Tản Cái Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đăng Thủ Tuân", "definition": "Fo chien Fo kuo (C), Hui chin (J), Fo feng Sho hsun (C), Fo chien, Hui chin, Fo chien Fo kuo, Ke chin Fo kuo (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đường", "definition": "佛堂. Nhà thờ Phật. Chùa Phật. Đoạn trường tân thanh có câu: “Đưa nàng đến trước Phật đường. Tam quy ngũ giới cho nàng xuất gia”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phật Đại Bi Quang", "definition": "Buddha of Great Compassion Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đại Cường Tinh Tấn Dõng Mãnh", "definition": "Buddha of Great Strength in Striving and Courage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đại Huệ Lực Vương", "definition": "Buddha of King with Great-Wisdom Force.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đại Thông Quang", "definition": "Buddha of Great Universal Light.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đại Tiên", "definition": "Buddhaṣena (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đạo", "definition": "Buddhist path, lam (T), Butsu-dō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đạo Chi Tranh", "definition": "Sự tranh chấp giữa Phật Giáo và Đạo (Lão) giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đạo Nhân Nhân Cước Cân Hạ", "definition": "Phật đạo dưới gót chân của mọi người.Nghĩa là đạo Phật chẳng phải là chủ nghĩa lí tưởng, cũng chẳng phải là Quan niệm luận, nhưng thực ra là cái mà mọi người vẫn làm trong các sinh họat hàng ngày. Học Đạo Dụng Tâm Tập (Đại 82, 4 hạ) nói: “Người hướng về đạo là người phải biết rõ bờ mé của Phật đạo, phải rõ hình dạng của Phật đạo. Phật đạo ở ngay dưới gót chân của mọi người: Nếu bị đạo trở ngại thì phải ngay đó mà biết trở ngại ở chỗ nào; còn nếu bị ngộ trở ngại thì phải ngay đó mà viên thành”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đạo Vô Thượng Thê Nguyên Thành", "definition": "Cũng gọi Vô thượng Bồ Đề thệ nguyện chứng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đản", "definition": "Vesak (S), Vesākha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đản Nhật", "definition": "Cũng gọi Phật Sinh Nhật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đảnh", "definition": "Uṣnīṣa (S), Uṇhīsa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đầu Trước Phẩn", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đỉnh", "definition": "Butchō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đỉnh Quang Minh Chi Tháp", "definition": "佛 頂 光 明 之 塔. ở trong chùa A Dục Vương, thị trấn Bảo Tràng, huyện Ngân, thành phố Ninh Ba, tỉnh Chiết giang, Trung Quốc. Chùa có một tòa Xá Lợi điện cao hơn 15m, mái chồng đỉnh ngói lưu ly để che chở tháp này. Trong Xá Lợi điện có một tòa Xá Lợi tháp bằng đá, trong tháp đá lại có một tòa tháp gỗ khảm bảy báu, trong tháp gỗ mới là tháp Phật Đỉnh Quang Minh. Đây là một tòa tháp gỗ nhỏ cao vài chục cm, hình dáng và cấu tạo hơi khác với các loại tháp Phật, thể tích nhỏ hơn, chủ yếu dùng để đựng Xá Lợi. Thân tháp điêu khắc theo phong cách ấn Độ rất giống tháp ấn kinh của Ngô Việt Vương tạo dựng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phật Địa", "definition": "Buddha land.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Địa Kinh Luận", "definition": "Buddhabhūmi-Sūtra śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đồ Hộ", "definition": "Phật đồ hộ là cơ sở kinh tế của các chùa viện, do Sa Môn Thống (Tăng thống) Đàm Diệu thời Bắc Ngụy, tâu vua xin thành lập song song với Tăng Kì Hộ. Tức là cơ sở thu nhận những người phạm trọng tội hoặc đầy tớ nhà các quan đến ở trongcácchùa, cho quét dọn chùa viện hoặc cày cấy ruộng đất. Về sau, tùy theo sự gia tăng ruộng chùa mà tài sản các tự viện cũng dần dần thêm lên, làm mất đi ý nghĩa lúc ban đầu. Năm Kiến Đức thứ 3 (574), vì Chu Vũ Đế diệt Phật nên Phật đồ hộ cũng bị dẹp bỏ. [X. Phật Tổ Thống Kỉ Q.38; Ngụy Thư Thích Lão Chí].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Đồ Tràng", "definition": "Buddhacinga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đồ Trừng", "definition": "Buddha-janga (S). Fo-t'u-teng (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Độ", "definition": "Là quốc độ có Phật trụ thế. Một Phật Độ (cõi Phật) là một khu vực giáo hóa của một đức Phật, bao gồm 3 ngàn đại thiên thế giới.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phật Đức", "definition": "Buddhaguṇa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Đức Tỳ Kheo", "definition": "Xem Xà Na Quật Đa Tỳ Kheo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Ưu Đàm Bát La Hoa Thù Thắng Vương", "definition": "Buddha of King of Extraordinary-Udumbara Blossom.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Ảnh", "definition": "Buddha-chāyā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phật Ảnh Quật", "definition": "Phạm: Buddha- chàyà-guhà. Cũng gọi Cù Ba La Quật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ấn", "definition": "I.Phật Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phật Ấn Liễu Nguyên", "definition": "(佛 印 了 元, Butsuin Ryōgen, 1032-1098): vị tăng của Vân Môn Tông, tự là Giác Lão (覺 老), người Phù Lương (浮 梁), Nhiêu Châu (饒 州, Tỉnh Giang Nam), họ là Lâm (林). Từ lúc còn 2 tuổi, ông đã bắt đầu học Luận Ngữ. Sau ông đến lễ bái Nhật Dụng ở Bảo Tích Tự (寳積寺) làm thầy và xuất gia, thọ cụ túc giới. Ông lên Lô Sơn (廬山), tham yết Khai Tiên Thiện Xiêm (開先善暹), rồi đến Viên Thông Cư Nột (圓通居訥). Vào năm 28 tuổi, ông kế thừa dòng pháp của Thiện Xiêm và bắt đầu hoạt động bố giáo ở Thừa Thiên Tự (承天寺) vùng Giang Châu (江 州, Tỉnh Giang Tây). Về sau, ông đã từng sống qua một số nơi như Đẩu Phương Tự (斗方寺) ở Thôi Sơn (淮山), Khai Tiên Tự (開先寺) và Quy Tông Tự (歸宗寺) ở Lô Sơn, Kim Sơn (金山) ở Đơn Dương (丹陽, Tỉnh Giang Tô), Đại Quy Sơn (大潙山) ở Giang Tây (江西), v.v., và trãi qua 4 lần đến sống tại Vân Cư Tự (雲居寺). Ông rất thâm giao với Tô Đông Pha (蘇東坡), còn làm Xã Chủ của Thanh Tùng Xã, dòng kế thừa của Bạch Liên Xã, và có quan tâm đến tư tưởng Tịnh Độ. Vào ngày mồng 4 tháng giêng năm đầu niên hiệu Nguyên Phù (元符), ông thị tịch, hưởng thọ 67 tuổi đời và 52 hạ lạp, được ban cho hiệu là Phật Ấn Thiền Sư (佛印禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phế", "definition": "廢. Ngưng lại. Không làm nữa Bỏ đi không dùng tới. Td: Hoang phế 荒廢 Hư nát. Sa sút. Suy kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Bái", "definition": "廢罷. Bỏ đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Can", "definition": "肺肝. Phổi và gan. Chỉ lòng dạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Chỉ", "definition": "廢址. Nền nhà bỏ hoang, còn sót lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Chức", "definition": "廢職. Bỏ bê công việc thuộc phần mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Cố", "definition": "廢錮. Bị cấm đoán suốt đời, không được làm quan nữa, ( một hình phạt dành cho quan lại thời xưa), tức là cách chức vĩnh viễn, không bao giờ được phục chức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Hoài", "definition": "肺懷. Phổi và lòng. Chỉ lòng dạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Hưng", "definition": "廢興. Suy kém đi và thịnh vượng lên. Chỉ sự thay đổi ở đời. Thơ Bà Huyện Thanh Quan có câu: “ Sóng lớp phế hưng coi đã trộn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Lao", "definition": "肺癆. Bệnh lao phổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Lập", "definition": "廢立. Bỏ đi và dựng nên. Chỉ kẻ quyền thần tự ý bỏ vua này lập vua khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Mạc", "definition": "肺膜. Màng phổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Nghiệp", "definition": "廢業. Bỏ công việc làm ăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Nhân", "definition": "廢人. Người bị hư hỏng một phần thân thể, không làm việc gì được nữa Người bị xã hội ruồng bỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Phật Hủy Thích", "definition": "Cuộc vận động hủy bỏ Phật Giáo trong thời kì Minh Trị Duy Tân (1868-1912) ở Nhật Bản, chính sách này nhằm củng cố quyền lực tuyệt đối của Thiên Hoàng. Cuộc vận động bài Phật rất kịch liệt, thiêu hủy tượng Phật, kinh Phật, pháp khí ở khắp nơi, ra lệnh cho tăng ni phải hoàn tục, các chùa viện hoặc bị phá bỏ hoặc bị sáp nhập. Ý đồ của cuộc vận động này là nhằm phục cổ và quốc giáo hóa Thần đạo để thực hiện đường lối “Tế Chính Nhất Trí” (Thần và Thiên Hoàng là một). (xt. Pháp Nạn, Thần Phật Phân Li).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phế Phủ", "definition": "肺腑. Phổi và các cơ quan tiêu hoá trong bụng. Chỉ lòng dạ. Bài Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “ Những là khen dạ đá gan vàng, bóng bạch câu xem nửa phút như không, ơn dày đội cũng cam trong phế phủ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Quyền Lập Thực", "definition": "Cũng gọi Phế Tam Hiển Nhất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phế Thoái", "definition": "廢退. Cách chức và đuổi về quê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Thuyên Đàm Chỉ", "definition": "Đối lại: Y Thuyên Đàm Chỉ. Cũng Gọi Phế Thuyên Biện Thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phế Thải", "definition": "廢汰. Lựa ra ma bỏ đi, không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Tiền Giáo", "definition": "Xóa bỏ những điều đã dạy bảo trước. Nghĩa là khi Đức Phật nói Kinh Niết Bàn, Ngài đã hủy bỏ bộ phận giới luật mà Ngài đã chế định từ trước. Như trước kia các vị Tỉ Khưu được phép ăn 3 thứ thịt thanh tịnh (không thấy con vật khi nó bị giết, không nghe thấy tiếng con vật kêu khi bị giết, không nghi ngờ con vật bị giết là vì mình), nhưng đến khi Phật nói Kinh Niết Bàn thì hoàn toàn bị nghiêm cấm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phế Truất", "definition": "廢黜. Bỏ đi Cách chức. Cũng nói: Truất phế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Trí", "definition": "廢置. Bỏ đi, xếp vào một chỗ, không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Trướng", "definition": "肺脹. Bệnh sưng phổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Trừ", "definition": "廢除. Diệt bỏ đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Tuyệt", "definition": "廢絶. Bỏ hẳn, dứt hẳn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Tích Hiển Bản", "definition": "Cũng gọi Phế Tích Lập Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phế Tạng", "definition": "肺臟. Buồng phổi. Lá phổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Tật", "definition": "廢疾. Sự tàn tật trên thân thể, khiến không làm việc gì được nữa Một tên chỉ bệnh bại liệt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Viêm", "definition": "肺炎. bệnh đau màng phổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Vật", "definition": "廢物. Đồ bỏ đi.Đồ vô dụng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế Đế", "definition": "廢帝. Vị vua bị bỏ đi, bị buộc phải rời ngôi vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phế, Bái", "definition": "胇. Như chữ 肺.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phết", "definition": "Vilampati (vi + lip + ṃ + a), vilimpeti (vi + limp + e), vilepeti (vi + lip + e), vilepana (trung), sammakkheti (saṃ + makkh + e), sammakkhana (trung), avalimpati (ava + lip + ṃ + a), avalepana (trung), makkhaṇa (trung), makkheti (makkh + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phệ", "definition": "吠. Sủa. Tiếng chó sủa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phệ Lam", "definition": "Xem Tì Lam.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phệ Quy", "definition": "(筮龜) hay Phệ Bốc (筮卜): bói toán bằng thẻ tre (một bó có 50 thẻ) và bằng cách đốt mu rùa. Từ đó nó có nghĩa là bói toán nói chung. Trong Chu Dịch Chánh Nghĩa (周易正義), phần Nhĩ Nhã (爾雅) có giải thích về 10 loại thẻ rùa để bói toán, quyết đoán mọi nghi nan rằng: “Thập bằng chi quy giả, nhất viết Thần Quy, nhị viết Linh Quy, tam viết Nhiếp Quy, tứ viết Bảo Quy, ngũ viết Văn Quy, lục viết Phệ Quy, thất viết Sơn Quy, bát viết Trạch Quy, cửu viết Thủy Quy, thập viết Hỏa Quy (十朋之龜者、一曰神龜、二曰靈龜、三曰攝龜、四曰寶龜、五曰文龜、六曰筮龜、七曰山龜、八曰澤龜、九曰水龜、十曰火龜, mười loại thẻ bói rùa, một là Thần Quy, hai là Linh Quy, ba là Nhiếp Quy, bốn là Bảo Quy, năm là Văn Quy, sáu là Phệ Quy, bảy là Sơn Quy, tám là Trạch Quy, chín là Thủy Quy, mười là Hỏa Quy).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phệ Thế Sử Ca Phái", "definition": "Xem Thắng Luận Phái.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phệ Xá", "definition": "Vaiśya (S), Drha-pati (S), Vessa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phệ Xá Ly", "definition": "Xem Quảng Nghiêm Thành.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phệ Đà", "definition": "Hay Vệ Đà - Veda: là kinh điển căn bản của đạo Bà-la-môn. Khoảng 1.500 năm trước TL, giống dân du mục Arya từ miền Trung Á tràn vào vùng Tây Bắc Ấn-độ. Họ đã chiến thắng dân bản xứ (Dravida), chiếm cứ vùng đất rộng lớn từ Punjab (cũng viết là Panjab) xuống đến lưu vực sông Hằng. Họ tự đặt mình ở địa vị chủ nhân ông, và biến người dân bản xứ thành hàng nô lệ. Sau khi mọi việc đã được bình định, giai cấp lãnh đạo tinh thần của giống Arya là các giáo sĩ Bà-la-môn, đã sưu tập lại tất cả những bài ca tán tụng thần thánh đã có từ trước và trong suốt thời kì chinh phục Ấn-độ, làm thành bộ thánh thư xưa nhất của Ấn-độ là Vệ Đà, gồm có bốn tập:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phệ Đà Thánh Điển Cương Yếu", "definition": "Vedartha-saṃgraha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phệ Đàn Đa Phái", "definition": "Vedanta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phỉ", "definition": "吡. Đua ra làm thí dụ Một âm là Tật. Xem Tật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Ban", "definition": "匪頒. Nói về vua đem vật quý tặng cho quần thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Báng", "definition": "誹謗. Kể xấu, chê bai người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Báng Chánh Pháp", "definition": "Saddharma-pratiksepa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phỉ Báng Chính Pháp", "definition": "Calomnier le Dharma bouddhique 誹謗正法 saddharma-pratikṣepa", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Phỉ Báng Và Cố Chấp", "definition": "Makkha thambha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phỉ Liêm", "definition": "蜚蠊. Con gián.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Loại", "definition": "匪類. Phường bất chánh, trộm cướp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Ngôn", "definition": "誹言. Lời nói xấu. Lời dèm pha.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Nhân", "definition": "匪人. Như Phỉ đồ 匪徒.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Phong", "definition": "菲葑. tên hai loài rau, rau Phỉ và rau Phong, dân nhà quê thường ăn. Chỉ sự quê mùa mộc mạc. Đoạn trường tân thanh có câu: “Ngần ngừ nàng mới thưa rằng, thói nhà băng tuyết chất hằng phỉ phong” Thái phong thái phỉ 采葑彩菲: ( Kinh Thi). Hái rau Phong rau Phỉ, ý nói mình quê mùa mộc mạc. “Ngần ngừ nàng mới thưa rằng, thói nhà băng tuyết, chất bằng phỉ phong” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Phẫn", "definition": "悱憤. Uất giận trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Thuý", "definition": "翡翠. Con chim trả Tên loại ngọc màu xanh biếc, cực đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Trắc", "definition": "悱惻. Lo buồn trong dạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Tặc", "definition": "匪賊. Giặc cướp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉ Đồ", "definition": "匪徒. Bọn trộm cướp Kẻ gian.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỉnh Gạt", "definition": "Māyā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phị", "definition": "俷. Thối nát. Hư hỏng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phị Đức", "definition": "俷徳. Tính nết xấu xa bại hoại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phọc", "definition": "縛. Lấy dây trói lại, buộc lại Chỉ sự ràng buộc. Td: Thê tróc tử phọc (bị vợ bắt, bị con trói, ý nói vợ con chồng ràng buộc) Cũng đọc Phược.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phọc Dã Phệ", "definition": "Vāyave (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phỏng", "definition": "仿. Như chữ Phỏng 倣 Một âm khác là Phảng. Xem Phảng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Biện", "definition": "倣辨. Theo đường lối cũ mà lo công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Chiếu", "definition": "倣照. Noi theo, bắt chước theo cái có sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Chất", "definition": "訪質. Hỏi kĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Cổ", "definition": "倣古. Bắt chước đời xưa. Noi gương xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Hữu", "definition": "訪友. Tìm hiểu tin tức bạn bè.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Nã", "definition": "訪拿. Hỏi han tìm kiếm để bắt giữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Sát", "definition": "訪察. Tìm hỏi xem xét sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Sử", "definition": "倣使. Nếu như. Thí dụ như.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Sự", "definition": "訪事. Xem Phóng sự. Vần Phóng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Tác", "definition": "倣作. Xem Phóng tác. Vần Phóng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Tạo", "definition": "倣造. Theo kiểu có sẵn mà làm ra, chế ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Vấn", "definition": "訪問. Hỏi han tìm biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phỏng Đoán", "definition": "Upadhāreti (upa + dhar + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phố", "definition": "圃. Vườn trồng cây, trồng hoa Người làm vườn. Td: Lão phố (ông già làm vườn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phố Bảo", "definition": "鋪保. Giấy cho phép mở cửa tiệm buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phố Phường", "definition": "鋪坊. Vùng đất có nhiều cửa tiệm buôn bán, chỉ nơi cư ngụ buôn bán đông đúc. Thơ Trần Tế Xương có câu: “Phố phường chật hẹp người đông đúc, bồng bế nhau lên nó ở non”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phốc", "definition": "剝. Đánh. Dùng roi, gậy mà đánh Một âm là Bác. Xem Bác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phốc Lạc", "definition": "扑落. Đánh cho tả tơi rơi rụng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phốc Phạt", "definition": "扑罰. Việc trị tội bằng roi, gậy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phốc Đầu", "definition": "幞頭. Tên một loại mũ thời xưa, trông giống như cái khăn xếp lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối", "definition": "配. Thành vợ chồng. Thành đôi. Td: Hôn phối Đày đi xa Phân chia sắp xếp cho thoả đáng. Td: Phân phối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Cách", "definition": "配格. Đường lối sắp xếp Đường lối đày người có tội đi xa hoặc gần tùy tội nặng hay nhẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Cảnh", "definition": "配景. Danh từ Hội hoạ, chỉ sự sắp đặt các chi tiết trong một bức tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Hưởng", "definition": "配享. Cúng tế tổ tiên các đời chung trong một cuộc tế lễ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Hợp", "definition": "配合. Họp lại trong sự sắp xếp ổn thoả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Ngẫu", "definition": "配偶. Sanh đôi, thành vợ chồng Danh từ luật pháp, chỉ người đã có đôi bạn và phải làm tròn bổn phận gia đình, tức người chồng hoặc người vợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Quân", "definition": "配軍. Đày làm lính ở xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Sắc", "definition": "配色. Danh từ Hội hoạ, chỉ sự sắp đặt, hoà hợp các màu trong bức tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Trí", "definition": "配置. Bày biện sắp xếp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phối Đương", "definition": "配當. Phân chia sắp xếp ổn thoả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phốt", "definition": "昢. Mặt trời chưa mọc hẳn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phốt Phốt", "definition": "昢昢. Le lói. Nói về ánh sáng chưa nhiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ", "definition": "Samanta (S), Immense.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Am", "definition": "(1115-1169).Thiền Sư Trung Quốc, thuộc Tông Lâm Tế, sống vào đời Nam Tống, người Nghi Xuân (Nghi Xuân, Viên Châu, Giang Tây), họ Dư, húy Ấn Túc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Am Ấn Túc", "definition": "(普庵印肅, 1115-1169), còn gọi là Phổ Am Thiền Sư (普庵[菴]禪師), Phổ Am Tổ Sư (普庵祖師); trong dân gian vẫn thường gọi là Phổ Án (普唵). Ngài là bậc cao tăng của Lâm Tế Tông, pháp từ của Mục Am Pháp Trung (牧庵法忠), sanh vào năm thứ 5 (1115) niên hiệu Chính Hòa (政和) đời vua Huy Tông (徽宗, tại vị 1100-1125) nhà Tống; xuất thân Nghi Xuân (宜春), Viên Châu (袁州); họ là Dư (余), dung mạo rất kỳ khôi, thiên tánh mẫn tuệ. Khi hạ sanh ông, mẫu thân mộng thấy ánh sáng tỏa khắp bầu trời, hoa sen sanh trên lối đi. Lúc còn nhỏ, Phổ Am mộng thấy một vị dị tăng chỉ vào ngực ông mà bảo rằng: “Ngươi ngày kia sẽ tỉnh ngộ.” Tỉnh dậy, ông đem câu chuyện ấy kể cho mẹ nghe, người mẹ bèn vạch ngực ông ra xem thì quả nhiên có một điểm màu hồng như trái đào. Vào năm 1134 (Thiệu Hưng [紹興] 4), lúc 20 tuổi, ông xuất gia với Thiền Sư Thọ Long Hiền (壽隆賢); rồi đến năm 1141 (Thiệu Hưng 11) mới được xuống tóc và năm sau thì thọ giới ở Khai Nguyên Tự (開元寺), Viên Châu (袁州). Vào năm 1143 (Thiệu Hưng 13), ông đến dạo chơi Hồ Tương (湖湘), tham yết Thiền Sư Yết Mục Am Pháp Trung (牧庵法忠), được vị này khai thị cho nên tỉnh ngộ. Sau ông trở về Thọ Long Viện (壽隆院). Đến năm 1153 (Thiệu Hưng 23), năm lên 39 tuổi, ông được thỉnh làm Trú Trì Từ Hóa Tự (慈化寺) ở Nghi Xuân, Giang Tây (江西). Ông thường mặc áo vải thô sơ, lưng chưa hề chấm chiếu, chuyên tâm Thiền định, nhân một hôm đọc đến đoạn “đạt bổn tình vong, tri tâm thể hợp (達本情忘、知心體合, đạt gốc tình quên, biết tâm thể hợp)” trong Kinh Hoa Nghiêm thì hoát nhiên tỉnh ngộ. Vào năm 1169 (Càn Đạo [乾道] 5, đời vua Hiếu Tông [孝宗, tại vị 1162-1189] nhà Nam Tống), ông tắm rửa, viết bài kệ, ngồi xếp bằng viên tịch. Bộ Phổ Am Ấn Túc Thiền Sư Ngữ Lục (普菴印肅禪師語錄), 3 quyển, của ông hiện được thâu lục trong bộ Vạn Tân Toản Tục Tạng Kinh (卍新纂續藏經, Vol. 69, No. 1356). Do vì khi còn tại thế, có rất nhiều truyền thuyết linh nghiệm về ông, sau khi qua đời, Thiền Sư Phổ Am được mọi người tín ngưỡng, trở thành một vị thần thánh của Phật Giáo chuyên tiêu tai, giải ách. Như vào năm 1156 (Thiệu Hưng 26), một hôm nọ Thiền Sư mở pháp hội, mọi người đến tham dự rất đông; vì vậy quan phủ cho người đến điều tra xem thử hư thực thế nào, nhưng đột nhiên cuồng phong, mưa lớn, trên trời hiện ra một con rồng lớn, nên quan phủ không dám điều tra, bèn quay trở về. Lại có hôm nọ, đáp ứng lời mời của người tín đồ tên Trần Thiên Chương (陳天章), cử hành pháp sự tại tư gia của người này, nhưng chỉ sai chúng tăng tụng một bộ Kinh Kim Cang. Nhân đó, Trần Thiên Chương không vui lòng, vì vậy Thiền Sư Phổ Am phải tụng thêm một bộ Kinh Kim Cang nữa. Về sau, Trần Thiên Chương bị chết sấp giữa đường, rồi ba ngày sau thì tái sanh lại, tự cho là ông bị dẫn xuống Địa Phủ, Phán Quan quở trách ông rằng: “Sao nhà ngươi lại bất kính với Thiền Sư Phổ Am, rồi bắt tụng thêm biến Kinh Kim Cang.” Sau đó, Trần Thiên Chương lại mang một xâu tiền đèn dầu cúng cho Thiền Sư và nhân đó Thiền Sư viết lên lên lưng ông bốn chữ “thí tài công cứ (施財功據, công đức bố thí tiền tài)”. Sau khi Trần Thiên Chương qua đời, trong một gia đình họ Cam (甘) hạ sanh một đứa bé, trên lưng đứa bé ấy xuất hiện dấu tích bốn chữ như vậy. Tương truyền Thiền Sư rất sùng kính Kinh Kim Cang, từng dùng máu mình viết bộ kinh này trong vòng 5 năm trường và sau đó được tôn thờ tại Từ Hóa Tự. Bộ kinh này cùng với bài văn bia Kim Cang Kinh của thi hào Tô Đông Pha (蘇東坡, 1036-1101) ở Huệ Lực Tự (慧力寺), Lâm Giang (臨江), được xem như là hai bảo vật vô giá về Kinh Kim Cang của Giang Tây. Vào năm 1300 (Đại Đức [大德] 4, đời vua Thành Tông [成宗, tại vị 1294-1307] nhà Nguyên), ông được ban cho thụy hiệu là Đại Đức Huệ Khánh (大德慧慶); rồi đến năm 1420 (Vĩnh Lạc [永樂] 18, đời vua Thành Tổ [成祖, tại vị 1402-1424] nhà Minh), ông lại được phong thêm hiệu là Phổ Am Chí Thiện Hoằng Nhân Viên Thông Trí Tuệ Tịch Cảm Ứng Từ Tế Chơn Giác Chiêu Huống Huệ Khánh Hộ Quốc Tuyên Giáo Đại Đức Bồ Tát (普庵至善弘仁圓通智慧寂感妙應慈濟眞覺昭貺慧慶護國宣敎大德菩薩). Tại các tự viện của Lâm Tế Tông, thường có thờ Thần Vị của Thiền Sư Phổ Am để hàng phục yêu ma. Do vì ông có tính thần dị, có các đạo sĩ không thuộc Phật Giáo lại tôn sùng ông là Tổ Sư, xưng hiệu là Phổ Án Giáo Chủ (普唵敎主) của Phổ Am Phái (普庵派) hay Phổ Án Phái (普唵派). Tượng của ông có nhiều loại khác nhau như tượng Tỳ Kheo, Đạo Sĩ, Tướng Quân, Đế Vương, v.v. Thậm chí như những người chuyên về ngư nghiệp, thuyền hải cũng thường tôn thờ Thần Vị của Thiền Sư Phổ Am trên thuyền của họ để cầu bình an trên sông nước; nên ông còn được xem như là người có công năng như Hải Thần vậy. Theo truyền thuyết của dân gian, nếu lấy giấy màu hồng, vàng viết lên 8 chữ “Phổ Am đáo thử bách vô cấm kỵ (普庵到此百無禁忌, Phổ Am đến đây, trăm điều không còn cấm kỵ nữa)”, rồi dán trong nhà thì có thể cải thiện được vấn đề phong thủy; hay mang nơi thân mình thì có thể xua đuổi điều xấu và mang lại điều lành. Trong lúc sinh tiền, ông thường làm những điều linh nghiệm như bẻ cây trị bệnh, chặt cây ma quái, cầu mưa, v.v. Hơn nữa, ông lại rất tinh thông Phạn văn, từng lấy Phạn văn phiên âm thành chú, người đời gọi đó là Phổ Am Chú (普庵咒). Thần chú này có thần lực làm cho an định mười phương và tòng lâm, nên thường được tụng tại các tự viện vào mỗi dịp đầu và giữa tháng. Thậm chí thần chú này còn có công năng xua đuổi các loài muỗi, trùng, rắn rít, v.v. Trong khoảng niên hiệu Vạn Lịch (萬曆, 1573-1620) nhà Minh, Thiền Sư Vân Thê Châu Hoằng (雲棲袾宏, 1535-1615) mới đưa thần chú này vào bản Chư Kinh Nhật Tụng (諸經日誦).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phổ Bi Quan Âm", "definition": "Một trong 33 hóa nhân của Bồ Tát Quán Thế Âm, tương đương với hóa thân nói trong Phẩm Phổ Môn Kinh Pháp Hoa (Đại 9, 57 trung): “Người cần đến thân trời Đại Tự Tại để được độ, liền hiện thân trời Đại Tự Tại mà nói pháp cho họ nghe”. Hình tượng của", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Biến", "definition": "普徧. Khắp cả, nơi nào cũng có Làm lan tràn khắp nơi, chỗ nào cũng có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Biến Kim Cang Bồ Tát", "definition": "Xem Bất Không Kiến Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Bác", "definition": "普博. Rộng lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Chiếu", "definition": "Pu chao (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Chiếu Quốc Sư Ngữ Lục", "definition": "Fushō kokushi goroku (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Chứng Đại Sư", "definition": "普 證 大 師. Thụy hiệu của Thiền tăng Pháp Thành, sống vào đời Tống. X. Pháp Thành.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Cập", "definition": "普及. Tới được khắp nơi, chỗ nào cũng tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Cứu Tự", "definition": "Chùa tọa lạc giữa khoảng Hoàng Hà và Phần Hà, thuộc huyện Vĩnh Tế, tỉnh Sơn Tây, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Diệu Kinh", "definition": "Lalitavistara Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Dung", "definition": "普 融. Hiệu của Thiền tăng Đạo Bình, đời Tống. X. Đạo Bình.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Giác Thiền Sư", "definition": "普 覺 禪 師. 1. Hiệu của Thiền tăng Chí Phùng, sống vào đời Ngũ Đại. X. Chí Phùng. 2. Thụy hiệu của Thiền tăng Tông Cảo, sống vào đời Tống. X. Tông Cảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Hiền", "definition": "Tông Hoa Nghiêm gọi cảnh giới Phật đoạn tuyệt tất cả lời nói, ý nghĩ, là Tính Hải Quả Phần, tức là pháp môn của Đức Phật Tì Lô Giá Na. Trái lại, ứng với cơ duyên của chúng sinh mà thuyết pháp, giáo hóa thì gọi là Duyên Khởi nhân phần, tức là pháp môn của Bồ Tát Phổ Hiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hiền Bồ Tát", "definition": "P'u-hsien (C), Kuntuzangpo (T), Fugen (J), Samantabhadrā (S), Samanta-bhadrā Bodhisattva (S), Fugen (J); P'u-hsien (C), Kuntu-zangpo (T), Viśvabhadrā Bodhisattva (S), All-over Beneficience Bodhisattva.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hiền Bồ Tát Hành Nguyên Tán", "definition": "Phạm: Bhadra-carì-praịi dhàna, hoặc Samantabhadra-caryàpraịidhàna- ràja.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hiền Bồ Tát Hạnh Nguyện Tán", "definition": "Bhadrā-cari-praṇidhāna-samantabhadrā-caryā-pranidhara-rāja (S), Bhadrā-caripraṇidhāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hiền Diên Mệnh Pháp", "definition": "Pháp tu thờ Bồ Tát Phổ Hiền Diên Mệnh làm Bản Tôn, cầu tiêu trừ tai nạn và kéo dài mệnh sống (diên mệnh). Nghi thức của pháp tu này là: An vị tượng Phổ Hiền Diên Mệnh, chínhdiện là Đại đàn, bên trái là đàn Thánh Thiên, bên phải là đàn Hộ Ma với lò lửa hình giáp trụ, 4 góc là bốn đàn Thiên Vương; bên trái đàn Thiên Vương về phía đông thiết lập đàn Thập Nhị Thiên. Trước Bản Tôn thắp 7 lớp đèn, chung quanh đàn tràng treo phan phướn nhiều màu, dùng 1 bức màn lớn ngăn cách trong với ngoài; ngoàimàn đặt tòa ngồi của chư tăng. Trong khi tu pháp phải liên tục tụng Kinh Kim Cương Thọ Mệnh Đà La Ni, lúc kết nguyện lại thiết lập 21 Tiểu đàn trên Đại đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hiền Như Lai", "definition": "Xem Văn Thù Sư Lợi Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hiền Tam Muội", "definition": "Pháp tu của Bồ Tát Phổ Hiền, tùy theo Hiển Mật mà có 2 pháp:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hiền Thập Nguyện", "definition": "Mười Nguyện Lớn Của Bồ Tát Phổ Hiền. Phổ Hiền (có nghĩa là sự hiền đức phổ cập khắp nơi) là tên của một vị Bồ Tát lớn, thường được các kinh điển Đại Thừa (nhất là Hoa Nghiêm và Pháp Hoa) nhắc nhở và khen ngợi. Vì lòng đại bi, ngài nguyện luôn luôn dùng mọi phương tiện để tuyên dương Phật Pháp, hóa hiện mọi thân tướng để cứu độ chúng sinh, và ủng hộ tất cả những ai hành trì và hoằng dương Phật Pháp. Ngài có lập mười điều nguyện lớn, được ghi trong kinh Hoa Nghiêm như sau:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Phổ Hiền Tát Đỏa Bồ Tát", "definition": "Xem Kim Cang Tát Đỏa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hiện Sắc Thân", "definition": "Chư Phật, Bồ Tát vì phương tiện hóa độ chúng sinh, nên ứng theo căn cơ của chúng sinh mà thị hiện các loại sắc thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hiện Sắc Thân Tam Muội", "definition": "I.Phổ Hiện Sắc Thân Tam Muội.Cũng gọi Hiện Nhất Thiết Sắc Thân Tam Muội, Phổ Hiện Tam Muội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hiệp", "definition": "Phổ Hiệp (1346-1426). Cao tăng Trung Quốc, sống vào đời Minh, người Sơn Âm, Cối Kê, họ Lục, tự Nam Châu, là hậu duệ của Phóng Ông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Hóa", "definition": "P'u-k'o (C), Fuke (J), Puhua (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hóa Phái", "definition": "Puke School.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hóa Tông", "definition": "P'u-hua tsung (C), P'u-hua ch'an (C), Puhuachan (C), Fuke- shū (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hương", "definition": "Pervading Fragrance", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phổ Hương Thiên", "definition": "Samantagandha-deva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Hệ", "definition": "譜系. Mối ràng buộc giữa những người cùng họ, theo các đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Hội Đại Sư", "definition": "普 會 大 師. Thụy hiệu của Thiền tăng Khánh Chư, sống vào đời Đường. X. Khánh Chư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Khuyến Tọa Thiền Nghi", "definition": "Gọi tắt: Tọa Thiền Nghi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Lễ", "definition": "Lễ khắp cả, nghĩa là hành giả Mật Giáo ở trong đạo tràng lễ bái Bản Tôn, cùng tất cả các vị tôn trên Mạn Đồ La.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Lục", "definition": "譜錄. Ghi chép vào sổ sách Ghi chép mối liên hệ các đời trong họ hàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Minh", "definition": "Universal Brightness", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phổ Minh Bồ Tát Hội", "definition": "Pu-ming p'u-sa hui (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Minh Như Lai", "definition": "Samantaprabhāsa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Minh Tháp", "definition": "普 明 塔. Tháp ở trong khuôn viên chùa Phổ Minh (chùa Tháp), nay thuộc xã Lộc Vượng, thị xã Nam Định, tỉnh Hà Nam Ninh, Việt Nam, cách Nam Định 5km phía bắc. Tháp gồm 14 tầng, cao 19m, mặt bằng hình vuông, mọc từ một khoảng sân vuông, mỗi chiều 8,6m, sâu chừng 0,5m, xung quanh có lan can, mở cửa bốn phía, thềm bậc trang trí rồng đá, sóc đá. Tầng đế tháp xây bằng đá xanh, mang hình bông sen nở xòe trên mặt nước cao 2,2m, rộng 5,2m, bốn góc có trụ giả đỡ đầu rồng, cửa giữa cuốn cao 1,1m, rộng 0,8m. Các tầng trên xây gạch trần, bốn góc nẹp đá, bốn mặt có cửa cuốn tò vò thu nhỏ dần theo chiều cao, kết thúc bằng chỏm nhọn hình bầu rượu. Gạch đá xây tháp được gia công kỹ trước khi xây, tùy theo vị trí mà có những hình dạng thích hợp như của vòm đá, chốt đá góc tháp, gạch chèn cửa vòm, gạch chèn góc, gạch xây… Năm 1987, Nhà nước trùng tu lại ngôi tháp này để giữ gìn vẻ đẹp lâu dài. Theo: VNVHTH 1989-1995.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Minh Tự", "definition": "普 明 寺. Còn gọi: Chùa Tức Mặc, Chùa Tháp. Chùa ở thôn Tức Mặc xã Lộc Vượng, huyện Mỹ Lộc, thị xã Nam Định, tỉnh Hà Nam Ninh, Việt Nam, cách Nam Định 5km về phía bắc.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Môn", "definition": "Samanta-mukha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Môn Phẩm", "definition": "Xem Quán Thế Âm Phổ Môn Phẩm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Môn Thiên", "definition": "Vaisramāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Môn Thị Hiện", "definition": "Chư Phật, Bồ Tát vận dụng năng lực thần thông tự tại thị hiện các loại thân tướng, mở ra Vô Lượng Pháp Môn làm cho chúng sinh chứng được viên thông. Như Phẩm Phổ Môn trong Kinh Pháp Hoa đã nói rõ về sự hóa đạo của Bồ Tát Quan Thế Âm, Ngài thị hiện 33 tướng, 19 thân thuyết pháp, đó là đức dụng Phổ Môn Thị Hiện của Ngài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Môn Tự", "definition": "Fumon-ji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Môn Viện", "definition": "Fumon'in (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Môn, dũng mãnh tiến tu, được Tam Mật gia hộ. Khi nguồn tâm đã sáng, mới biết tất cả danh ngôn đều là Mật hiệu của Như Lai, những người thường tình không thể biết được. Như nói trì tụng 3 tháng, cho đến phương tiện 3 chuyển trong tính thanh tịnh viên minh, há có thể hiểu là 9 tuần thôi sao? Lại như Phật Bảo Chàng ở phương đông, là nghĩa mới phát tâm bồ đề, há chỉ hiểu là 4 phương được sao?”", "definition": "II.Mật Hiệu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Ngu", "definition": "普 愚 (1301-1382). Sa môn Cao Ly (tên nước Triều Tiên thời xưa), họ Phác. Vào niên hiệu Chí Chính thứ 6 (1346) sư vào nhà Nguyên (Trung Quốc) ở chùa Đại Quán nơi Yên Kinh hỏi han tìm kiếm bậc tri thức. Năm sau đến núi Hà Vụ thuộc Hồ Châu (Chiết Gaing) tham yết Thiền Sư Thanh Củng được truyền tâm ấn, nối pháp đời thứ 24 hệ Nam Nhạc, là một trong những người sáng lập tông Tào Khê ở Triều Tiên. Sư được thỉnh khai đường thuyết pháp tại chùa Vĩnh Ninh ở Lạc Dương. Niên hiệu Chí Chính thứ 8 sư trở về Triều Tiên hoằng pháp.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Nguyên", "definition": "Phổ Nguyên (748-834). Thiền Sư Trung Quốc, sống vào đời Đường, người ở Tân trịnh thuộc Trịnh Châu (Tân trịnh, huyện Khai Phong, tỉnh Hà Nam), họ Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Nguyện", "definition": "普 願 (748-834). Thiền tăng đời Đường, họ Vương, người Tân Trịnh (Hà Nam) Trung Quốc.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Ngạn", "definition": "普 岸 (770-843). Thiền tăng đời Đường, họ Thái, người xứ Hồng Châu (nay là huyện Nam Xương, tỉnh Giang Tây) Trung Quốc. Sư xuất gia từ thuở bé, tham vấn ngài Bách Trượng Hoài Hải. Ban ngày theo chúng làm công tác, tối đến một mình cầm đuốc tụng kinh, chẳng từ lao khổ. Về sau, sư đến Thiên Thai ở nơi rừng núi tu khổ hạnh. Mọi người ngưỡng mộ đạo đức của sư xây dựng viện Bình Điền để sư an trụ", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Nhãn Tam Muội Môn", "definition": "Cũng gọi Phổ Môn Thế Giới Tam Muội Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Ninh", "definition": "普 寧 (1214-1276). Thiền tăng đời Nam Tống, họ tên là Phổ Ninh, tự Ngột Am, người xứ Bồi Lăng, Tứ Xuyên, Trung Quốc. Đắc pháp nơi Thiền Sư Vô Chuẩn Sư Phạm chùa Dục Vương, đời thứ 21 hệ Nam Nhạc, đời thứ 3 tông Lâm Tế. Trụ trì Kiến Trường Hưng Quốc Thiền Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Phiếm", "definition": "普泛. Rộng lớn khắp cả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Pháp Biệt Pháp", "definition": "Cũng gọi Phổ Biệt Nhị Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Quang", "definition": "(?-?): là một vị cao tăng sống vào đời Đường, quê quán và tuổi tác đều không rõ. Ngài tư chất thông minh, ở chùa Từ-ân, thờ pháp sư Huyền Trang làm thầy, tuy học ít nhưng chứng nhập nhiều, được pháp sư Huyền Trang âm thầm ấn khả. Trong 20 năm (645-664) pháp sư Huyền Trang dịch được 75 bộ kinh luận, đa phần do ngài bút thọ. Năm 654, khi pháp sư Huyền Trang dịch xong bộ Luận Câu Xá, trước tiên trao cho ngài. Nhân đó ngài đã soạn bộ Câu Xá Luận Kí, gồm 30 quyển, trở thành một trong những điển tịch chủ yếu của tông Câu Xá. Ngoài ra ngài còn soạn Câu Xá Luận Pháp Tông Nguyên, Bách Pháp Minh Môn Luận Sớ v.v... Người sau đã công nhận ngài là đệ tử chánh truyền của pháp sư Huyền Trang về môn học Câu Xá.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phổ Quang Minh Điện", "definition": "Cũng gọi Phổ Quang Pháp Đường. Tòa điện đường nằm cạnh Bồ Đề Đạo Tràng, nước Ma Yết Đà, Trung Ấn Độ. Thủa xưa, điện này là nơi Đức Phật từng hội thứ 2, thứ 7, thứ 8 trong 9 hội của Kinh Hoa Nghiêm (bản 80 quyển) hoặc là hội thứ 2 và hội thứ 7 trong 8 hội Kinh Hoa Nghiêm (bản 60 quyển).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Quang Tam Muội", "definition": "Tam Muội phát ra ánh sáng do tọa thiền quán tưởng thân Như Lai, chứng được 5 thần thông,4 Vô Lượng tâm,4 Vô ngại giải, cho đến đầy đủ ánh sáng rực rỡ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Quang Vương Tự", "definition": "Chùa ở phương Tín Nghĩa, phía đông nam huyện Tứ, tỉnh An Huy, Trung Quốc, do ngài Tăng già, người Tây Vực, sáng lập vào đầu năm Long Sóc (661-663) đời Đường. Khoảng Năm Trinh Nguyên (785- 804), chùa bị cháy, sau đó được ngài Thanh Lương Trừng Quán kiến thiết lại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Quán Quán Tưởng", "definition": "Cũng gọi Tự Vãng Sinh Quan, Phổ Vãng Sinh Quan, Phổ Quan Tưởng, Phổ Quan. Pháp quán tưởng của người nguyện sinh Tịnh Độ phương tây, có xuất xứ từ Kinh Quán Vô Lượng Thọ, 1 trong 16 pháp quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Quát", "definition": "普括. Bao gồm khắp nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Quảng Bồ Tát", "definition": "Một vị Bồ Tát du hành. Phổ: Rộng, Khắp. Quảng: Rộng rãi, rộng lớn. Theo Địa Tạng Kinh, ngài Phổ Quảng Bồ Tát có khải thỉnh đức Phật Thích Ca giảng thuyết sự lợi ích của Địa Tạng Bồ Tát đối với chúng sanh. Đồng thời, Phổ Quảng Bồ Tát cũng có thỉnh đức Phật giảng giải những phước đức do sự chiêm ngưỡng đức Địa Tạng Bồ Tát.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phổ Quảng Đại Sư", "definition": "普 廣 大 師. Hiệu của Thiền tăng Huệ Thâm, sống vào đời Ngũ Đại. X. Huệ Thâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ San", "definition": "Poussin, Louis de la Vallée (1869-1937) Học giả Phật Giáo người Bỉ. Lúc trẻ, ông từng theo học giả người Pháp là Lévi, Sylvain nghiên cứu Đông Phương Học. Từ năm 1893 về sau, ông làm Giáo sư Đại Học Grand dạy tiếng Hi Lạp, tiếng La Tinh, sau ông chuyên nghiên cứu về Ấn Độ học và Phật Giáo Đại Thừa. Ông tinh thông tiếng Phạm, Hán, Tây Tạng, trứ tác rất nhiều, thành quả rực rỡ, nghiễm nhiên trở thành người xúc tiến phong trào nghiên cứu Phật học ở Châu Âu. Năm 1921, ông tổ chức hội nghiên cứu Đông Phương Học, hiệu đính phiên dịch kinh điển Phật Giáo, soạn Bách khoa toàn thư về tông giáo và luân lí, viết các luận văn phát biểu về Phật Giáo, làm mục lục về văn hiến Kì Na Giáo được tàng trữ tại Đại Học Cambridge, mục lục các kinh điển đào được do ông A. Stein mang từ Trung Á về và mục lục kinh điển Phật tiếng Tây Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Tang Tiết", "definition": "Phổ tang, âm của tiếng Tích Lan: Poson. Ngày lễ lớn của Tích Lan và các nước Phật Giáo Thượng Tọa Bộ vùng Đông Nam Á, kỉ niệm ngài Ma Hi Đà, con của vua A Dục, đến Tích Lan truyền bá Phật Giáo. Vào ngày trăng tròn tháng 6 hàng năm, vùng Mahintale của Tích Lan tổ chức các hoạt động kỉ niệm ngài rất long trọng. Theo truyền thuyết, ngài Ma Hi Đà từng hội kiến với Quốc vương của Tích Lan là Thiên Ái Đế Tu (Pàli: Devànampiya Tissa, ở ngôi 250- 210 trước Tây lịch) và giảng kinh thuyết pháp cho vua nghe lần đầu tiên ở nơi này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thiên", "definition": "普天. Khắp trời Khắp nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Thiện Thần", "definition": "Phổ thiện, Phạm: Pùwan. Cũng gọi Bố Hàm Thần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thuyết", "definition": "Đối lại: Nhập Thất, Độc Tham, Tiểu Tham.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thí", "definition": "普施. Đem cho khắp nơi, làm ơn cho mọi người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Thông", "definition": "普通. Suốt khắp mọi nơi ở đâu cũng có, cũng thấy, không có gì đặc biệt cả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Thông Hợp Chưởng", "definition": "Cũng gọi Phổ Thông Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thông Thiền Tự", "definition": "普 通 禪 寺. Chùa Dương Kỳ vào đời Tống được gọi là “Phổ Thông Thiền Tự”. X. Dương Kỳ Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Thông Viên", "definition": "Nhà nghỉ được xây dựng ven đường dành cho những người hành hương chiêm bái Thánh Tích núi Ngũ Đài, Trung Quốc, bắt đầu từ đời Đường về sau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thỉnh", "definition": "Cũng gọi Xuất Pha. Mời tất cả mọi người.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thụy", "definition": "(?-?).Cao tăng Trung Quốc sống vào đời Nguyên, người Du Thành (tỉnh Vân Nam), tự Tuyết đình, hiệu Diệu Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Thủ Bồ Tát", "definition": "Parigudha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Trang", "definition": "(1347-1403).Thiền Sư Trung Quốc thuộc phái Dương Kì Tông Lâm Tế, sống vào đầu đời Minh, người Tiên Cư, Thai Châu (Chiết Giang), họ Viên, hiệu Ngốc Am, cũng gọi Kính Trung.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Trang Nghiêm Đồng Tử", "definition": "Dịch mới: Đại Uy Quang Thái Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Trà", "definition": "Đối lại: Đặc Vị Trà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Trì", "definition": "普 持 (1310-1387). Thiền tăng đời Minh, họ Vạn tự Bảo Tạng người xứ Đại Y Sơn. Sư tham vấn Thiền Sư Thời Úy và đắc pháp, thuộc tông Lâm Tế. Niên hiệu Hồng Võ thứ 14 (1381), sư kế vị trụ trì chùa Thánh Ân, núi Thời Úy tại Tô Châu, người đời gọi sư là “Thánh Trì Tổ”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Trí Thiên Nhân Tôn", "definition": "Tôn hiệu của Đức Phật, vì trí tuệ của Phật chiếu soi khắp sự lí, là bậc tôn quí nhất trong trời, người, nên có tôn hiệu này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Tế", "definition": "(1179-1253).Thiền Sư Trung Quốc sống vào đời Tống, người Phụng Hóa, Tứ Minh, họ Trương, hiệu Đại xuyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Tế Thiền Tự", "definition": "普 濟 禪 寺. ở làng Tây, thành phố Đài Trung, tỉnh Đài Loan, Trung Quốc. Năm 1941 do Hòa Thượng Đạt Thiện khai sơn sáng lập. Về sau bởi nhiều năm không tu sửa tường nền sụp lở cơ hồ thành phế tự. Đạt Thiện sai đệ tử là Pháp sư Chân Đắc tiếp quản chùa này. Trải qua bao khổ nhọc xây cất chùa chiền mới khôi phục như cũ. Năm 1980 được sự trợ giúp của tín đồ khắp nơi khởi công xây dựng lại lần nữa chùa y như mới.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Tịch", "definition": "(651-739).Thiền Sư Trung Quốc sống vào đời Đường, người Hà Đông, Bồ Châu (Vĩnh Tế, tỉnh Sơn Tây), họ Phùng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Tịnh", "definition": "普 淨. Thiền tăng đời Nguyễn, quê ở Võ Lăng, Thượng Phúc, miền Bắc Việt Nam. Thuở nhỏ đã theo Hòa Thượng Phúc Điền xuất gia tu học. Một hôm, sư đến chùa Vân Trai đảnh lễ Đại sư Tường Quang xin thụ giới cụ túc. Sau khi thụ giới, sư thành tâm trì giới hành đạo. Từ bé chí trưởng, sư chuyên tâm nghiên cứu kinh luật, không dám một phút lơi lỏng. Quá ngọ tuyệt đối không ăn gì cả. Sư về trụ trì chùa Tường Quang trên núi Đại Hùng ở Hà Nội, do Hòa Thượng Phúc Điền khuyến hóa xây cất. Nơi đây, sư độ tăng tục khá đông, vì thế ngôi chùa càng trang nghiêm đẹp đẽ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Từ", "definition": "普 慈 (1355-1450). Thiền tăng đời Minh, họ Tiễn, hiệu Hải Chu, người Thường Thục (Giang Tô) Trung Quốc. Sư xuất gia từ thuở nhỏ tại chùa Phá Sơn núi Ngu Sơn, sớm tối xem kinh tìm tòi thật nghĩa. Đến chùa Thánh Ân, Đặng Úy, Tô Châu tham kiến Thiền Sư Thời Úy được ấn khả. Rồi đến núi Động Đình, Thái Hồ ẩn cư 29 năm. Nghe Huệ Nhật nói pháp nơi chùa Đông Minh sư liền đến yết kiến, chợt gặp lúc đèn lưu ly rớt xuống hoát nhiên đại ngộ, được ấn chứng làm truyền nhân tông Lâm Tế. Huệ Nhật tịch, sư kế tục trụ trì chùa Đông Minh. Tác phẩm: Tụng Cổ Thi.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Từ Bồ Tát", "definition": "Xem Thường Đề Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Tựu", "definition": "普 就 (1238-1314). Thiền tăng đời Nguyên, họ Lưu, hiệu Cổ Nham, người Chân Định (nay thuộc Hà Bắc) Trung Quốc. Sư nối pháp thiền sư Túc Am, trụ trì chùa Linh Nham ở Thái An (nay thuộc Sơn Đông). Năm 1312 dời về ở Tổ đình Thiếu Lâm, được triều đình ban hiệu “Diệu Nghiêm Hoằng Pháp Đại Thiền Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Uyển", "definition": "(?-?).Cao tăng Trung Quốc sống vào đời Thanh, người Côn Sơn, họ Cố, tự Lan Cốc. Đầu năm Thuận Trị (1644) đời vua Thế Tổ, sư đến Vân Nam, thường gặp nhiều biến loạn nên ẩn cư tu hành. Đến khoảng năm Khang Hi, đức hạnh của sư được truyền rộng, 4 chúng đều qui phục. Sư xây dựng chùa Pháp Giới và chùa Báo quốc ở Côn Minh, qui tụ đồ chúng giảng dạy. Sư có kiến thức uyên bác, thông suốt Phật Giáo, Nho học, giỏi thi thư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Văn Thiên", "definition": "Xem Dư Thiên Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Vị Thừa Giáo Tông", "definition": "Gọi đủ: Phổ Vị Nhất Thiết Thừa Giáo Tông. Tên gọi khác của Tông Pháp Tướng. Tông này cho rằng Kinh Giải Thâm Mật là giáo pháp vì (vị) 5 thừa (Nhân, Thiên,", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Ân", "definition": "普 恩. Thiền tăng đời Minh, họ Kim, người xứ Sơn Âm (nay là huyện Thiệu Hưng, tỉnh Chiết Giang) Trung Quốc. Thuở lên mười, sư xuất gia và theo học với ngài Diên Phúc Giám Hồ. Năm 19 tuổi, sư chợt nhớ đến việc lớn sinh tử, nhen nhúm ý định tham thiền. Ban đầu, sư đến tham vấn ngài Vô Tế ở chùa Đại Từ, có sở đắc và trình kệ như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Điệp", "definition": "譜牒. Sách ghi chép liên hệ giữa mọi người trong họ theo từng đời tiếp nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ Đà", "definition": "S. Potala. Một hòn đảo ở gần cửa sông Indus ở Ấn Độ. Được quần chúng tin là trú xứ của Bồ Tát Quang Âm. Ở Trung Hoa, ngoài khơi Ninh Ba, có đảo Phổ Đà, cũng được xem là một trú xứ của Bồ Tát Quan Âm. Potala cũng là tên gọi cung điện của vị Đạt Lai Lạt Ma Tây Tạng, và dân Tây Tạng tin rằng vị này là một hóa thân của Bồ Tát Quan Âm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Phổ Đà Liệt Tổ Lục", "definition": "Tác phẩm, 1 quyển, do ngài Triều Âm Thông Húc (1649-1698) biên soạn vào đời Thanh, ấn hành năm Khang Hi 35 (1686), được thu vào Vạn Tục Tạng tập 147.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Đà Lạc Ca Tân Chí", "definition": "普 陀 洛 迦 新 志. Chí, 20 quyển, do Vương Ngạn Hanh soạn vào thời cận đại, được xếp vào Trung Quốc Phật Tự Sử Chí Vựng San tập 1. Từ đời Minh, Chu ứng Tân sửa lại “Phổ Đà Sơn Chí” đến nay đã có 4 thứ “Phổ Đà Sơn Chí” được soạn xong vào đời Thanh,", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổ Đà Lạc Già Sơn", "definition": "Xem Quang Minh Sơn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Đà Sơn", "definition": "P'u-t'o shan (C), Putoshan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phổ Đăng Lục", "definition": "(普燈錄, Futōroku): xem Gia Thái Phổ Đăng Lục(嘉泰普燈錄, Kataifutōroku) (嘉泰普燈錄, Kataifutōroku): 30 quyển, tổng mục có 3 quyển, do Lôi Am Chánh Thọ (雷庵正受) biên tập, san hành dưới thời nhà Tống. Lôi Am Chánh Thọ ở Báo Ân Quang Hiếu Tự (報恩光孝寺) thuộc Phủ Bình Giang (平江府) bắt đầu biên tập bộ này trong khoảng thời gian niên hiệu Gia Thái (嘉泰, 1201-1204) đời vua Ninh Tông nhà Nam Tống, hoàn thành vào năm thứ 4 (1204), đem dâng lên đức vua xem và được phép cho nhập vào Đại Tạng Kinh. Là bộ Đăng Sử Thiền Tông kế thừa bước chân của Cảnh Đức Truyền Đăng Lục (景德傳燈錄), Thiên Thánh Quảng Đăng Lục (天聖廣燈錄), Kiến Trung Tĩnh Quốc Tục Đăng Lục (建中靖國續燈錄) và bổ sung thêm cho các bộ sử thư đi trước, tác phẩm này đã thâu tập 17 đời môn hạ của Nam Nhạc (南岳) cho đến 16 đời môn hạ của Thanh Nguyên (青原). Lôi Am cho rằng xưa nay các bộ Truyền Đăng Sử chỉ thâu lục truyền ký, hành trạng của các vị tu sĩ, chứ không đề cập đến tầng lớp vương hầu, sĩ thứ, nữ lưu, ni chúng, v.v.; cho nên trong tác phẩm này từ đầu cho đến quyển 21 thì thuộc về tầng lớp xuất gia, từ quyển 22 trở đi được chia làm các phần như Thánh Quân (聖君), Hiền Thần (賢臣), Ứng Hóa Thánh Hiền (應化聖賢), Thập Di (拾遺), Chư Phương Quảng Ngữ (諸方廣語), Niêm Cổ (拈古), Tụng Cổ (頌古), Kệ Tán (偈贊), Tạp Trước (雜著), v.v., toàn bộ thánh hiền, thứ dân đều được thâu lục vào. Vì vậy nó có tên là Phổ Đăng Lục (普燈錄, Futōroku). Ngoài san bản nhà Tống ra, còn có khá nhiều dị bản như Bản Ngũ Sơn, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phổ Đẳng Tam Muội", "definition": "Chỉ cho Tam Muội mà trong đó hành giả đồng thời được thấy tất cả chư Phật. Kinh Vô Lượng Thọ quyển thượng (Đại 12, 269 thượng) nói: “Nếu ta thành Phật, các chúng Bồ Tát ở cõi nước phương khác, nếu được nghe tên của ta thì đều mau chóng chứng đắc Phổ đẳng tam muội.Trụ Tam Muội này, cho đến khi thành Phật, thường thấy vô lượng bất khả tư nghị hết thảy Như Lai”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Đồng Vấn Tấn", "definition": "Cũng gọi Phổ Thông Vấn Tấn, Phổ Vấn Tấn, Thập Vấn Tấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phổ Độ", "definition": "普度. Tiếng nhà Phật, chỉ sự giúp đỡ cho tất cả chúng sinh ở mọi nơi. “Phật hữu tình từ bi phổ độ” (Chiêu hồn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phổ ứng Quốc Sư", "definition": "普 應 國 師. Thụy hiệu của Thiền tăng Minh Bản, sống vào đời Nguyên. X. Minh Bản.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phổi", "definition": "Papphāsa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phộc", "definition": "攴. Đánh khẽ. Vỗ nhẹ Tên một bộ chữ Trung Hoa, tức bộ Phộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phớt Qua", "definition": "Nighaṃsati (ni + gaṃs + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phụ", "definition": "付. Dùng như chữ Phụ 祔 Một âm là Phó. Xem Phó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Bạc", "definition": "負薄. Ăn ở xấu xa, trái ngược với sự ăn ở tốt đẹp của người khác đối với mình. Đoạn trường tân thanh có câu: “Mấy người phụ bạc xưa kia, chiếu danh tầm bắt về hỏi tra”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Bại", "definition": "負敗. Thua. Thua trận Hư việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Bản", "definition": "蝜蝂. Tên một loại côn trùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Bật", "definition": "輔弼. Giúp đỡ. Nói về bề tôi giúp vua lo việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Châm Tiện Lãm", "definition": "婦箴便覽. Tên một cuốn sách bằng chữ nôm của Lí Văn Phức, danh sĩ đời Nguyễn, nội dung gồm những điều khuyên dạy đàn bà con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Chính", "definition": "輔政. Giúp đỡ việc nước, Nói về quan đại thần cầm quyền khi vua còn quá nhỏ. “Đặt quan phụ chính để nay giúp phò”. (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Chấp", "definition": "父執. Chỉ chung những người bạn của cha mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Chức", "definition": "婦職. Công việc thuộc phần của người đàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Công", "definition": "婦工. Việc làm hàng ngày của người đàn bà, của người vợ trongnhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Cấp", "definition": "附給. Đưa thêm Món tiền đưa thêm, ngoài món tiền chính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Cận", "definition": "附近. Gần, dựa sát ngay bên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Dung", "definition": "附庸. Dựa vào, thuộc vào một nước khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Dực", "definition": "輔翼. Giúp đỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Gia Hình", "definition": "附加刑. Sự trừng phạt thêm vào cái hình phạt chính. Thí dụ đã bị tử hình, còn bị tịch thu tài sản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Giáo", "definition": "婦教. Việc dạy dỗ đàn bà con gái trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Giáo Biên", "definition": "Tác phẩm, 3 quyển, do ngài Khế Tung soạn vào đời Bắc Tống, được thu vào Đàmtân văn tập quyển 1-3 trong Đại Chính Tạng tập 52.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụ Hoá", "definition": "附化. Thay đổi mà xin dựa theo, không chống lại như trước nữa (nói về nước này quy thuận hước kia).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Huynh", "definition": "父兄. Cha và anh. Chỉ những người lớn trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Hà", "definition": "負荷. Mang vác nặng nề. Gánh vác trách nhiệm lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Họa", "definition": "附和. Lên tiếng thêm vào mà hòa theo. Chỉ dự tán thành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Học", "definition": "婦學. Như Phụ giáo 婦教.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Khoa", "definition": "婦科. Nghành chữa trị các chứng bệnh cửa đàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Khí", "definition": "負氣. Nổi giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Lão", "definition": "父老. Người già, đáng tuổi cha.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Lương", "definition": "輔 良 (1317-1371). Thiền tăng đời Nguyên, họ Phạm, tự Dụng Chân, Dụng Trinh, hiệu Giới Am, người huyện Ngô (nay là Tô Châu) Trung Quốc. Năm 15 tuổi, sư theo ngài Thọ Di ở viện Đồng Lý Ngưỡng Phúc xuất gia, thụ giới Cụ túc. Sau đó theo Trạch Pháp sư ở chùa Bắc Thiền tu tập Thiên Thai Giáo Quán, nghiên cứu tinh hoa của pháp môn này sư được chỗ giống như khế ngộ. Sư đến chùa Long Tường ở Nam Kinh tham vấn Thiền Sư Đại Tố. Ngài vừa gặp sư liền biết là pháp khí nên sai làm Thị giả. Một thời gian lâu, sư khế ngộ tâm pháp, nối pháp ngài thuộc tông Lâm Tế. Niên hiệu Chí Thánh thứ 2 (1342), khi ra hoằng pháp sư trụ chùa Tư Thánh ở Gia Hưng (nay thuộc Chiết Giang). Sư từng trụ trì chùa Thiên Đồng và Linh ẩn. Gặp lúc loạn lạc cuối đời Nguyên, chùa Linh ẩn cũng bị họa lây, sư bèn chặt phá gai góc, lùm bụi, kết cỏ làm nhà để người học khắp nơi có chỗ nương tựa. Mặc dù gặp buổi điêu linh nhưng sư vẫn khai thị đồ chúng, cử dương Phật pháp, dùng pháp môn Tịnh Độ làm thuyền bè đưa người qua biển khổ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phụ Lục", "definition": "Xem Truyền Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phụ Lục Thân", "definition": "父六親 (Thiện Kiến Tì Bà Sa Luật)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Phụ Lực", "definition": "負力. Cậy sức mạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Mã", "definition": "駙馬. Tên một chức quan đời Hán, tức Phụ mã Đô uý, trông coi việc xe cộ của vua và triều đình Từ các đời Nguỵ, Tấn về sau, người đàn ông khi trở thành chồng của công chúa (rể của vua), đều được phong chức Phụ mã Đô uý này. Do đó, Phụ mã chỉ chàng rễ của vua. Ta vẫn đọc trại Phò mã.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Mẫu", "definition": "父母. Cha và mẹ. “Thấy hào phụ mẫu khắc cùng tử tôn”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Mẫu Ân Trọng Kinh", "definition": "Kinh 1 quyển, được thu vào Đại Chính Tạng tập 85.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụ Nghi", "definition": "Tiền bạc và phẩm vật tặng thân nhân của người chết để giúp vào việc làm đám tang.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụ Nghĩa", "definition": "負義. Trái với đạo phải ở đời. “Há phải nhân mà đành phụ nghĩa”. (Nhị Thập Tứ Hiếu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Nhân Ngộ Cô Kinh", "definition": "Cũng gọi Phật Ngộ Đối Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụ Nữ", "definition": "Itthī (P), Strī (S), Woman.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phụ Nữ Mang Thai", "definition": "Gabbhinī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phụ Nữ Đẹp", "definition": "Rūpinī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phụ Phật Pháp Ngoại Đạo", "definition": "Chỉ cho những kẻ nương nhờ Phật Giáo, sống trong Phật Giáo mà lập ra học thuyết sai lầm, phản lại chính nghĩa của Phật Giáo. Là 1 trong 3 loại ngoại đạo được đề cập đến trong Ma Ha Chỉ Quán. Như Tông Hoa Nghiêm cho Độc Tử Bộ của Tiểu Thừa là Phụ Phật Pháp ngoại đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụ Thiền", "definition": "蚹蟬. Tên một loài ve sầu mình ngắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Thuộc", "definition": "Xem Hữu Vi.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phụ Thành", "definition": "Thành của phụ vương Đức Phật, tức là thành Ca Tì La, nơi vua Tịnh Phạn đóng đô, nên gọi là Phụ thành, cũng là nơi sinh của Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụ Thân", "definition": "父親. Người cha. Bản dịch Chinh phụ ngâm có câu: “Ngọt bùi thiếp đã hiếu nam, dạy con đèn sách thiếp làm phụ thân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Thạch Thung Khang", "definition": "負 石 舂 穅. Còn gọi: Yêu Thạch Thung Mễ. Mang đá giã gạo. Câu chuyện hết lòng phục vụ chư tăng của ngài Huệ Năng trong pháp hội của Ngũ Tổ Hoằng Nhẫn tại Huỳnh Mai. Phần Dương Ngữ Lục, q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phụ Trách", "definition": "負責. Gánh vác về một công việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Trái", "definition": "負債. Thiếu nợ. Mắc nợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Trọng", "definition": "負重. Vác nặng. Ý nói gánh vác việc lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Trọng (Núi)", "definition": "Vebhara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phụ Trợ", "definition": "輔助. Như Phụ tá 輔佐.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tá", "definition": "輔佐. Giúp đỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tâm", "definition": "負心. Lòng dạ phản bội, xấu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tân", "definition": "負薪. Vác củi Chỉ việc làm thấp hèn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tình", "definition": "負情. Trái ngược lại lòng yêu thương của người khác đối với mình. Đoạn trường tân thanh có câu: “Phụ tình án đã rõ ràng, dơ tuồng nghĩ mới kiếm đường tháo lui”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tùng", "definition": "附從. Xin theo để dựa vào một nước khác Đi theo để thêm vào. Kèm theo Nay ta còn hiểu là những bộ phận rời của xe cộ máy móc, kèm theo với các loại xe cộ máy móc đó, để thay thế khi hư hỏng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tùy", "definition": "Parivāra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phụ Tướng", "definition": "婦相. Chỉ người vợ. Như: Nội tướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tử", "definition": "父子. Cha và con. “Chẳng qua việc của quân vương, Cho nên phụ tử hai đường xa xôi”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Tử Thi Hành", "definition": "負 死 尸 行. Vai mang tử thi mà tới lui. Đây là lời chê trách các vị tăng hành cước chẳng rõ tự tâm là Phật, uổng công tìm kiếm bên ngoài. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phụ Xảo", "definition": "婦巧. Chỉ chung những công việc của đàn bà, cần đến sự khéo léo. Bản dịch Chinh phụ ngâm khúc có câu: “Đâu xiết kể trăm sầu nghìn não, Từ nữ công phụ xảo đều nguôi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Ân", "definition": "負恩. Làm trái lại với điều ơn mà người khác đã làm cho mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Đái", "definition": "負戴. Vác và đội. Ý nói gánh nhiệm vụ lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Đạo", "definition": "婦道. Đường lối mà người đàn bà phải theo để cư xử hàng ngày. “Hãy cơm áo trọn bề phụ đạo”. (Gia huấn ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Đảm", "definition": "負擔. Gánh vác. Cũng nói: Đảm phụ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Đầu", "definition": "埠頭. Bến tàu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Đức", "definition": "婦德. Nết na của đàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụ Ước", "definition": "負約. Trái ngược lại với sự hẹn hò lúc trước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục", "definition": "伏. Cúi sát mặt xuống đất. Td: Phủ phục. Đoạn trường tân thanh có câu: “Lạ thay oan khí tương triền, nàng vừa phục xuống Từ liền ngã ra” Ẩn giấu. Núp kín. Td: Mai phục Chịu theo. Td: Khuất phục Chịu tội. Td: Phục chu (bị xử chém).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Ba", "definition": "伏波. Danh hiệu võ tướng, tức Phục ba Tướng quân Chỉ danh tướng Mã Viện đời Hán. Vì họ Mã được phong Phục Ba tướng quân. Bản dịch Chinh phụ ngâm khúc có câu: “Săn Lâu Lan rằng theo Giới Tử, tới Man khê bàn sự Phục ba” Phục ba: Một chức của Mã viện (Mã viện thường gọi là Phục Ba Tướng quân). Mã viện người Mậu Lăng, đời Đông Hán. Ban đầu nương nhờ Ổi Hiêu, sau về đầu Quan Võ Ổi Hiêu làm phản, Viện giúp Quan Võ dẹp Ổi Hiêu. Viện lại đem quân sang đánh nước ta để trả thù việc Tô Định bị Trưng Trắc giết chết. Sau khi lấy được Giao Chỉ lập đồng trụ ở biên giới khắc mấy chữ “Đồng Trụ chiết, Giao Chỉ diệt” (Cột đồng gãy, người Giao Chỉ sẽ bị diệt). Giặc mọi Man khê làm phản. Viện đem quân dẹp mới yên, lúc bấy giờ Viện đã 80 tuổi. (Tầm nguyên tự điển). (Đến Man khê bàn sự Phục Ba).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Binh", "definition": "伏兵. Toán quân núp sẵn ở một nơi kín để đánh úp quân giặc Cho quân lính ẩn núp để chờ đánh quân địch đi ngang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Bái", "definition": "伏拜. Cúi đầu sát đất mà lạy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Chính", "definition": "復政. Lấy lại được quyền trị nước (nói về ông vua).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Chế", "definition": "服制. Luật lệ về các loại quần áo tang, dùng trong các trường hợp để tang khác nhau, tùy theo thân sơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Chức", "definition": "復職. Được trở về với việc làm và địa vị cũ. “Kiều công xưa mắc tội oan, trẫm cho phục chức làm quan Đông thành”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Cổ", "definition": "復古. Trở lại đời xưa. Theo xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Duy", "definition": "伏惟. Cúi sát mặt xuống đất mà nghĩ tới. Tiếng kính trọng của kẻ dưới, dùng với người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Dâm Kinh", "definition": "Kinh, 1 quyển, do ngài Pháp Cự dịch vào đời Tây Tấn, tức là Kinh Hành Dục trong Trung A Hàm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phục Dược", "definition": "服藥. Uống thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Dịch", "definition": "服役. Làm việc nặng nhọc Ta còn hiểu là làm việc nặng nhọc, hầu hạ người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Dụng", "definition": "服用. Quần áo và các đồ dùng hằng ngày.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Hoạt", "definition": "復活. Sống lại (sau khi đã chết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Hoạt Tiết", "definition": "復活節. Lễ mừng Chúa sống lại, tức lễ Phục sinh (Pâques).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Hy", "definition": "Fu-Hsi (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phục Hình", "definition": "伏刑. Nhận chịu sự trừng phạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Hưng", "definition": "復興. Lại thịnh vượng trở lại Làm cho thịnh vượng trở lại như xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Hồi", "definition": "復囘. Trở lại. Hát nói của Cao Bá Quát có câu: “… Bôn lưu đáo hải bất phục hồi” (chảy ra biển mà không trở lại) Làm trở lại tình trạng cũ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Hồn", "definition": "復魂. Làm cho tỉnh lại, không còn mê man nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Kiếm", "definition": "伏劍. Dùng gươm tự tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Kiến Thiên Hoàng", "definition": "(伏見天皇, Fushimi Tennō, tại vị 1287-1298): vị Thiên Hoàng sống vào cuối thời Liêm Thương, vị Hoàng Tử thứ 2 của Hậu Thâm Thảo Thiên Hoàng (後深草天皇, Gofukakusa Tennō, tại vị 1246-1259), tên là Hy Nhân (熙仁, Hirohito), còn gọi là Trì Minh Viện Điện (持明院殿). Sau khi nhường ngôi, ông làm Viện Chính.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phục Kỳ", "definition": "伏祈. Rạp mình cầu xin.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Lao", "definition": "服勞. Làm việc mệt nhọc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Long", "definition": "伏龍. Con rồng nằm mọp một chỗ, còn giấu mình. Chỉ người tài chưa gặp thời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Lễ", "definition": "I.Phục Lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phục Ma Pháp Sư", "definition": "Abhicāraka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phục Mãng", "definition": "伏莽. Ẩn núp trong bụi rậm. Chỉ kẻ trộm cướp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Mệnh", "definition": "復命. Thi hành lệnh xong, trở về trình lại. “Định ngày phục mệnh lai kinh”. (Nhị Độ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Nghĩa", "definition": "服義. Làm theo điều phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Nguyên", "definition": "復原. Trở lại như lúc đầu. Chỉ sự khỏi bệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Ngưu Tự Tại", "definition": "(伏牛自在, Fukugyū Jizai, 741-821): người Ngô Hưng (呉興, thuộc Tỉnh Triết Giang), họ là Lý (李). Ông xuất gia ở Kính Sơn (徑山), rồi đăng đàn thọ giới tại Tân Định (新定). Sau ông đi tham vấn khắp các nơi, và cuối cùng đạt ngộ với Mã Tổ Đạo Nhất (馬祖道一) ở Nam Khang (南康, Tỉnh Giang Tây). Trong khoảng niên hiệu Nguyên Hòa (元和, 806-820), ông thân giao với Đơn Hà Thiên Nhiên (丹 霞 天然) ở Hương Sơn (香 山) và còn giao hảo thư từ qua lại với Nam Dương Huệ Trung (南 陽 慧 忠). Ông đã từng đi ngao du khắp các nơi như Long Môn (龍 門), Ngọc Ốc Sơn (玉屋山), Tung Sơn (嵩山), v.v., và cuối cùng đến trú tại Phục Ngưu Sơn (伏 牛 山), Lạc Dương (洛 陽, thuộc Tỉnh Hà Nam). Vào năm đầu niên hiệu Trường Khánh (長慶), ông thị tịch tại Khai Nguyên Tự (開元寺), Tùy Châu (隨州, thuộc Tỉnh Hồ Bắc), hưởng thọ 81 tuổi.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phục Ngự", "definition": "服御. Quần áo xe cộ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Nhân", "definition": "復 仁 (1889-1973). Tăng nhân hiện đại, họ Vương, người Đại Bộ tỉnh Quảng Đông, Trung Quốc. Tuổi trẻ đi kinh doanh ở Thái Lan. Đến năm 33 tuổi, sư theo Hòa Thượng Lô Quảng ở chùa Cam Lộ tại Bangkok xuất gia. Sau khi về nước, sư thụ giới Cụ túc tại chùa Thiên Đồng ở Ninh Ba, rồi đi hành hương các núi: Phổ Đà, Ngũ Đài. Sư từng tham học tại các đại tùng lâm như: Ngũ Đài Sơn, Cao Mân tự, Trường Sinh Tự, Kim Sơn Tự, Tiêu Sơn, Dũng Tuyền Tự và thọ giáo các vị như: Giới Thừa, Huệ Minh, Lai Quả, ấn Quang. Năm 1931, sư đến chùa Dũng Tuyền ở Phúc Châu nương Hư Vân Lão hòa thượng. Năm kế, vâng lời ngài đến Quảng Đông quyên góp lương thực, rồi sang Bangkok quyên góp, được tín chúng nơi đây ủng hộ, mời sư trụ trì chùa Long Hoa. ở đấy vài năm sư làm hưng thịnh Thiền Tông. Năm 1938, sư về nước nối pháp Hòa Thượng Hư Vân, thuộc tông Tào Động đời thứ 48. Năm 1948, sư sang HongKong, xây dựng thiền viện Pháp Lâm ở núi Đại Dư, mỗi năm đều mở thiền thất đạo tràng. Năm 1965, sư trụ trì nhiệm kỳ đầu của “Hư Vân Hòa Thượng Kỷ Niệm Đường” tại núi Phù Dung. Năm 1973, sư thị tịch tại HongKong.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phục Nhẫn", "definition": "Các hành giả mới phát tâm, muốn chịu đựng được trước những cảnh thuận hay nghịch, trước hết phải điều phục tâm ý, gọi là “phục nhẫn”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Phục Niệm", "definition": "伏念. Như Phục duy 伏惟.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Pháp", "definition": "伏法. Nhận chịu phép nước. Chịu tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Quyền", "definition": "復權. Cho phép được hưởng trở lại những điều được có, được làm, được đòi hỏi, mà trước kia bị cấm đoán vì phạm lỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Quốc", "definition": "復國. Giành lại đất nước khỏi tay người ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Sinh", "definition": "復生. Sống lại Một lễ trọng của đạo Cơ đốc. Xem Phục hoạt tiết 復活節. “Tưởng rằng Tây tử giáng hồn phục sinh”. (Hoàng Trừu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Sắc", "definition": "服色. Màu sắc của quần áo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Sức", "definition": "服飾. Quần áo mặc vào người và các đồ đeo trên người cho đẹp Chỉ chung sự ăn mặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Sự", "definition": "服事. Làm việc Làm việc cho người khác. Cũng như Phụng sự.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Tang", "definition": "服喪. Mặc quần áo đặc biệt để tỏ lòng thương nhớ người chết. Mặc đồ tang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Thi", "definition": "(伏屍・伏尸): thây chết nằm trên mặt đất, như trong Chiến Quốc Sách (戰國策), phần Ngụy Sách (魏策) thứ 4 có câu: “Nhược sĩ tất nỗ, phục thi nhị nhân, lưu huyết ngũ bộ (若士必怒、伏屍二人、流血五步, nếu là kẻ sĩ tất uy thế, xác chết hai người, máu chảy dài năm bước).” Hay trong Văn Tuyển (文選), phần Cổ Nghi (賈誼), Quá Tần Luận (過秦論) lại có câu: “Truy vong trục bắc, phục thi bách vạn, lưu huyết phiêu lỗ (追亡逐北、伏尸百萬、流血漂櫓, đuổi giặc về phướng bắc, thấy chết cả trăm vạn, máu chảy đầy khắp).” Hoặc trong Thái Bình Quảng Ký (太平廣記) quyển 317 có đoạn: “Trung hữu phục thi, Trúc dạ văn kỳ khấp thanh, hốt kiến nhất phụ nhân, đản bối nhi lai (中有伏尸、竺夜聞其泣聲、忽見一婦人、袒背而來, bên trong có thấy chết; ban đêm Trúc nghe tiếng khóc của thây ma đó, lại chợt thấy một phụ nữ, mặc áo để lộ vai đi đến).” Trong Phật Thuyết Địa Tạng Bồ Tát Phát Tâm Nhân Duyên Thập Vương Kinh (佛說地藏菩薩發心因緣十王經, CBETA No. 20) cũng có đoạn như sau: “Như kim chúng sanh, y ngã tu thiện, linh đắc Phật đạo; nhất thiết chúng sanh, diệc phục như thị, thất chủng phách thức; nhất danh Tước Âm Phách Thần Thức, nhị danh Thiên Tặc Phách Thần Thức, tam danh Phi Độc Phách Thần Thức, tứ danh Thi Cấu Phách Thần Thức, ngũ danh Xú Phế Phách Thần Thức, lục danh Trừ Uế Phách Thần Thức, thất danh Phục Thi Phách Thần Thức (如今眾生、依我修善、令得佛道、一切眾生、亦復如是、七種魄識、一名雀陰魄神識、二名天賊魄神識、三名非毒魄神識、四名尸垢魄神識、五名臭肺魄神識、六名除穢魄神識、七名伏尸魄神識, như nay chúng sanh, theo ta tu thiện, khiến được Phật đạo; hết thảy chúng sanh, cũng lại như vậy, bảy loại phách thức; một là Tước Âm Phách Thần Thức, hai là Thiên Tặc Phách Thần Thức, ba là Phi Độc Phách Thần Thức, bốn là Thi Cấu Phách Thần Thức, năm là Xú Phế Phách Thần Thức, sáu là Trừ Uế Phách Thần Thức, bảy là Phục Thi Phách Thần Thức).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phục Thiện", "definition": "服善. Nghe theo điều tốt, điều phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Thù", "definition": "復讎. Trả lại mối giận ghét mà kẻ khác đã gieo cho mình. Trả thù. “Hầu ra Tần sở liệu phương phục thù”. (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Thư", "definition": "伏雌. Gà mái nằm ẹp xuống, tức gà ấp trứng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Thổ", "definition": "伏土. Chôn xuống đất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Thủy Luận Sư", "definition": "Phái ngoại đạo chủ trương nước là nguyên nhân sinh ra muôn vật, là một trong 20 thứ ngoại đạo ở Ấn Độ đời xưa. Phái ngoại đạo này cho rằng nước làgốc của muôn vật. Nước sinh ra trời đất và hết thảy hữu tình, vô tình; dưới đến địa ngục A Tị, trên đến cõi trời A Ca Ni Tra, tất cả đều lấy nước làm chính. Lại vì nước sinh ra vạn vật, mà cũng hủy hoại vạn vật, nên gọi là Niết Bàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phục Thức", "definition": "服式. Kiểu quần áo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Thực", "definition": "服食. Đồ mặc và đồ ăn. Quần áo và thực phẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Tùng", "definition": "服從. Chịu nghe theo, tin theo, làm theo. “Ngạnh cường chẳng khứng phục tùng” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Tư", "definition": "伏思. Như Phục duy 伏惟.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Tạng", "definition": "I.Phục Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phục Tửu", "definition": "服酒. Uống rượu Đổ rượu cho người khác uống thật say.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Viên", "definition": "復園. Về vườn, chỉ sự bị sa thải khỏi cơ quan quân đội hoặc chính quyền vì không đủ khả năng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Vật", "definition": "服物. Quần áo và đồ dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Vụ", "definition": "服務. Làm việc trong phần việc của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Án", "definition": "伏案. Cúi đầu trên bàn, chỉ sự chăm học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phục Đoạn", "definition": "Tức phục hoặc và đoạn hoặc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phục Đạo", "definition": "Cũng gọi Năng Phục Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phục Độc", "definition": "服毒. Uống thuốc độc Đầu độc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng", "definition": "𠤈. Như chữ Phụng 鳳.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng An", "definition": "奉安. Chôn cất cho người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Chiếu", "definition": "奉詔. Vâng theo lệnh vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Chỉ", "definition": "奉旨. Vâng theo ý vua Phụng chỉ thăng thuyên: Vâng chiếu chỉ cho thăng chức và chuyển bổ đi nơi khác. “Mai công phụng chỉ thăng thuyên” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Chức", "definition": "奉職. Làm việc theo phần việc và địa vị của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Công", "definition": "奉公. Làm việc nước, việc chung Chỉ biết lo việc chung, không hề có ý riêng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Cúng", "definition": "Pūjeti (pūj + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phụng Dưỡng", "definition": "奉養. Nuôi nấng chăm sóc người trên. “Rước về phụng dưỡng đêm ngày thay con” (Phan Trần).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Giáo", "definition": "奉教. Vâng chịu sự chỉ dạy. Ý nói theo học với thầy. Như: Thụ giáo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Hiến", "definition": "奉獻. Dâng lên, đưa lên cho người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Hành", "definition": "奉行. Vâng theo lời mà làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Lệnh", "definition": "奉令. Vâng theo điều sai khiến của bề trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Mao Tế Mỹ", "definition": "(鳳毛濟美): lông con chim phụng ngay thẳng, xinh đẹp. Câu này có xuất xứ trong Ấu Học Quỳnh Lâm (幼學瓊林) quyển 2, phần Tổ Tôn Phụ Tử (祖孫父子): “Xưng hoạn hữu hiền lang, viết phụng mao tế mỹ (稱宦有賢郎、曰鳳毛濟美, chúc mừng quan có con trai hiền gọi là phụng mao tế mỹ).” Hay trong hồi thứ 34 của Quan Trường Hiện Hình Ký (官塲現形記) của Lý Bảo Gia (李寶嘉) nhà Thanh có đoạn: “Nhĩ bất thính kiến thuyết tha môn thế huynh tức nhật dã yếu bảo đạo đài, chơn chánh thị phụng mao tế mỹ, khả khâm khả kính (你不聽見說他們世兄卽日也要保道台、眞正是鳳毛濟美、可欽可敬, Người chẳng nghe thấy anh em nhà kia hôm ấy cũng cần phải giữ gìn đạo nghĩa chăng ? Quả đúng là con hiền nối nghiệp cha. Thật đáng phục, đáng kính !).” Cho nên, ngày xưa câu này thường dùng để ví cho người cha đi làm quan, con có thể kế thừa sự nghiệp cha. Về sau, nó được dùng để chúc tụng sinh con trai nhân hậu.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Phụng Mã", "definition": "奉 馬. Dâng ngựa. Thiền Tông mượn từ này để chỉ việc âm thầm khế hợp, tương ưng. X. Tiên Đà Khách. Thung Dung Am Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phụng Mệnh", "definition": "奉命. Như Phụng lệnh 奉令.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Pháp Yếu", "definition": "Tác phẩm, 1 quyển, do ông Hi Siêu (336- 377) soạn vào đời Đông Tấn, được thu vào Hoằng Minh Tập quyển 13 trong Đại Chính Tạng tập 52.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụng Sứ", "definition": "奉使. Vâng lệnh vua mà thay vua đi lo việc ở nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Sự", "definition": "奉事. Làm việc cho người trên Nay hiểu là làm việc cho một mục đích cao đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Thỉnh", "definition": "Kính thỉnh chư Phật, Bồ Tát, thiên thần... giáng lâm đạo tràng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phụng Thừa", "definition": "奉承. Vâng theo Nịnh bợ mà hùa theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Tiên", "definition": "奉先. Thờ cúng ông cha các đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Trát", "definition": "奉札. Vâng theo giấy tờ của quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phụng Trì", "definition": "Honor and uphold, Uphold and embrace (to)", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Phụng Tống", "definition": "奉送. Đưa tới dâng cho người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ", "definition": "否. Chẳng Không phải Tiếng dùng trong câu hỏi: Td: Khả phủ (được hay không) Một âm khác là Bí. Xem Bí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ An", "definition": "撫安. Vỗ về cho yên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Biên Tạp Lục", "definition": "撫邊雜錄. tên một cuốn sách khảo cứu, viết bằng chữ Hán của Lê Qu‎ý Đôn, học giả đời Lê mạt, nội dung nói về lịch sử, địa dư, chính trị, phong tục tại Thuận hoá và Quảng nam, trong thời gian ông giữ chức Hiệp đồng Kinh lí quân sự tại hai vùng này. Bài tựa viết năm 1767.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Châu Tào Sơn Bản Tịch Thiền Sư Ngữ Lục", "definition": "撫 州 曹 山 本 寂 禪 師 語 錄. Ngữ Lục, 2 quyển, do Tào Sơn Bản Tịch soạn vào đời Đường, được xếp vào Tục Tạng Kinh tập 119, trang 922.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Phủ Châu Tào Sơn Nguyên Chứng Thiền Sư Ngữ Lục", "definition": "Cũng gọi Tào Sơn Đại Sư Ngữ Lục, Tào Sơn Bản Tịch Thiền Sư Ngữ Lục, Tào Sơn Nguyên Chứng Thiền Sư Ngữ Lục, Tào Sơn Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phủ Chính", "definition": "斧正. Lấy rìu mà đẽo sửa lại cho thẳng. Ý nói sửa lại cho đúng (thường dùng làm lời nói khiêm nhường, khi nhờ người khác sửa chữa văn chương hoặc lời lẽ của mình).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Chưởng", "definition": "撫掌. Vỗ tay (Tỏ ‎ý hoan nghênh).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Chất", "definition": "斧質. Cái rìu để chặt đầu kẻ tử tội và cái thớt để kê đầu kẻ tử tội lên mà chặt. chỉ hình phạt chặt đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Cân", "definition": "斧斤. Rìu và búa. Chỉ sự trừng phạt nặng nề.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Cúc", "definition": "撫鞠. Vỗ về săn sóc (Công ơn cha mẹ đối với con cái).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Doãn", "definition": "府尹. Chức quan đứng đầu một phủ, nơi đặt kinh đô. Hát nói của Nguyễn Công Trứ có câu: “Lúc Bình tây cờ Đại Tướng, Có khi về Phủ doãn Thừa thiên” (Phủ doãn tương tự như Đô trưởng ngày nay).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Dân", "definition": "撫民. Khuyên nhủ vỗ về người trong nước để duy trì sự yên ổn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Dưỡng", "definition": "撫養. Vỗ về nuôi nấng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Dụ", "definition": "撫誘. Vỗ về khuyên nhủ. “Khâm tuân phủ dụ biết tôn biết vì”. (Hạnh Thục Ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Kha", "definition": "斧柯. Cái cán rìu Chỉ sự nắm giữ quyền trị nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Khố", "definition": "府庫. Kho chứa tiền bạc của cải của triều đình hoặc quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Kiếm", "definition": "撫劍. Vỗ tay vào gươm, dáng điệu muốn rút gươm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Ngưỡng", "definition": "俯仰. Cúi và ngẩng. Chỉ cử động sinh hoạt hàng ngày. Cũng chỉ sự kính cẩn Mạnh tử: Ngưỡng bất quý tư thiên phủ, bất tạc ư địa (ngửa lên không thẹn với trời, cúi xuống không thẹn với đất). “Lòng ai biết Hán hay Hàn, Phải biện bạch kẻo thẹn cùng phủ ngưỡng”. (Nguyễn Hữu Chỉnh).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Nhận", "definition": "否認. Từ chối. Không nhìn như vậy là đúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Niệm", "definition": "撫念. Nghĩ tới và vỗ về, chỉ sự chăm sóc của người trên đối với kẻ dưới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Phục", "definition": "頫伏. Cúi rạp mình xuống đất. Lạy sụp xuống đất. “Trước thềm phủ phục mướt mồ hôi lưng”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Quan", "definition": "府官. Người viên chức đúng đầu một phủ thời trước. Truyện Trê Cóc có câu: “Trình đơn trước mặt công đình, Phủ quan nổi giận lôi đình thét vang”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Quyết", "definition": "否決. Bày tỏ sự không chấp nhận. Bỏ phiếu không chấp nhận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Sơn Huyền Chuyết", "definition": "Fuzan Genshutsu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Phủ Thừa", "definition": "府丞. Chức quan dưới chức Phủ doãn. Xem Phủ doãn 府尹.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Trấn", "definition": "撫鎭. Đóng giữ, và vỗ về dân chúng địa phương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Tuất", "definition": "撫恤. Vỗ về thương xót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Tồn", "definition": "撫存. Vỗ về thăm hỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Việt", "definition": "斧鉞. Rìu và búa lớn. Chỉ hình phạt nặng nề.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Đường", "definition": "府堂. Dinh của ông quan đứng đầu một phủ Tiếng tôn xưng gọi ông quan phủ. Đoạn đường tân thanh có câu: “Đất bằng nổi sóng đùng đùng, Phủ đường sai lá phiếu hồng thôi tra”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủ Định", "definition": "否定. Quyết chắc là không Không nhận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủi", "definition": "Niddhurana (trung), nippoṭhana (trung), uppoṭheti (u + poth +e), vidhunāti (vi + dhū + nā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Phủng", "definition": "唪. Cười lớn Nói lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủng Phúc", "definition": "捧腹. Ôm bụng. Dáng điệu cười ngặt nghẽo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phủng Phủng", "definition": "唪唪. Sai trái (nói về cây cối).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức", "definition": "愊. Lòng thành Rất thành thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Bích", "definition": "複壁. Tường nhà hai lớp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Bản", "definition": "複本. Bản nhì. Như Phó bản 副本.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Danh", "definition": "複名. Cái tên có từ hai chữ trở lên. Tên kép.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Diệp", "definition": "複葉. Lá kép, loại lá cây do nhiều lá nhỏ đính lại mà thành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Gián", "definition": "愎諫. Ngang ngược, làm theo ý mình, không chịu nghe lời can ngăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Hợp", "definition": "複合. Gom góp nhiều thứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Loại", "definition": "愎類. Cứng cỏi, ngang bướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Lợi Tức", "definition": "複利息. Lãi kép. Vốn sinh lãi, rồi phần lãi lại sinh lãi nữa, cứ thế chồng chất lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Nhãn", "definition": "複眼. Danh từ Động vật học, chỉ loại mắt của động vật do nhiều mắt nhỏ ghép lại mà thành (chẳng hạn mắt của con chuồn chuồn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Quả", "definition": "複果. Danh từ Thực vật học, chỉ loại trái cây có thể tách rời ra, giống như được ghép lại bởi nhiều trái nhỏ (chẳng hạn quả của cây thông).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Sư", "definition": "Vị tăng có nhiệm vụ thuật lại (phức) những lời của Giảng Sư để làm cho nghĩa lí sáng tỏ hơn, là một chức vị trong Tông Hoa Nghiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phức Tuyển", "definition": "複選. Cách chọn kép, tức cách bầu cử hai vòng để lựa người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Tính", "definition": "複姓. Họ kép, có từ hai chữ trở lên (chẳng hạn họ Tư Mã).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Tạp", "definition": "複雜. Nhiều, rắc rối, lộn xộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Tả Chỉ", "definition": "複寫紙. Thứ giấy giúp viết thành hai hoặc nhiều bản giống hệt như nhau cùng một lúc, tức giấy than, giấy cạc bon (Papier carbone).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Tử", "definition": "Cũng gọi Phức Bao, Phức Phạ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Phức Đát", "definition": "愊怛. Gấp rút, nóng nảy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phức Ức", "definition": "愊憶. Chứa chất trong lòng, không nói ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Phữu", "definition": "缶. Cái bình sành để đựng rượu Một thứ nhạc khí cổ, bằng sành, dùng để gõ nhịp. Tên một đơn vị đo lường thời cổ, bằng 4 hộc. Tên một bộ chữ Trung Hoa, tức bộ Phữu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Pictogram", "definition": "Biểu đồ thống kê", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pierce", "definition": "Đâm vào, chọc thủng, xuyên qua", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Piety", "definition": "Lòng mộ đạo, lòng hiếu thảo, lòng trung thành", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pindapata", "definition": "Trì bình hay khất thực: chư tăng ôm bát nhận cơm cúng dường của bá tánh.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Pinnacle", "definition": "Surmount = tháp nhọn, đỉnh núi cao nhọn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pious", "definition": "Ngoan đạo, sùng đạo, hiếu thảo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Piss", "definition": "Nước tiểu, đi tiểu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pitfall", "definition": "Hầm bẫy, cạm bẫy, điều nguy hiểm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pittance", "definition": "Tiền thù lao rẻ mạt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pivotal", "definition": "Nồng cốt, mấu chốt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Piyadassi", "definition": "Piyadassi (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Piyarūpasatarūpa", "definition": "Mười nhóm sắc khả ái khả ý.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Placebo", "definition": "Tác dụng làm người ốm an lòng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plagiarism", "definition": "Phái ăn cấp ý, ăn cấp văn…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plague", "definition": "Bệnh dịch, tai họa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plasticity", "definition": "Tính dẽo, mềm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plebeian", "definition": "Người bình dân thời La Mã", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plenary", "definition": "Complete in every respect absolute = nguyên vẹn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plenitude", "definition": "Sung túc, phong phú", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plethora", "definition": "Trạng thái quá thừa thải", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pleurisy", "definition": "Viêm màng phổi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plexus", "definition": "(giải phẫu) mạch máu trong cơ thể; hệ thống mô sợi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pliancy", "definition": "Pliable = dẻo, dễ uốn, tính mềm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plight", "definition": "Cảnh ngộ khốn khổ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plinth", "definition": "Chân cột, chân tường, bệ tượng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plodder", "definition": "Người làm việc cần cù", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plop", "definition": "Tiếng rơi tỏm xuống nước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Plunder", "definition": "Cướp bóc, tước đoạt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Poignancy", "definition": "Chua cay, lời châm chọc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Polarity", "definition": "Cực, chiều phân cực", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Polemic", "definition": "Aggressive attack = luận chiến, bút chiến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Polytheistic", "definition": "Đa thần giáo (Polytheism = chủ nghiã đa thần)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pomodrupa", "definition": "Pomodrūpa (S), phag mo grub pa (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Pompous", "definition": "Hoa lệ, tráng lệ (Pomp – phô trương rực rỡ)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pontificate", "definition": "Chức giáo chủ, chức giáo hoàng, nhiệm kỳ giáo hoàng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pore", "definition": "Mải mê, miệt mài", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Porfolio", "definition": "Cặp giấy, tổ hợp đầu tư", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Porosity", "definition": "Trạng thái xốp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Portal", "definition": "Cửa, cổng chính", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Portend", "definition": "Báo hiệu, điềm báo trước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Portico", "definition": "Mái dẫn vào toà nhà lớn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Posthumous", "definition": "Được xuất bản sau khi tác giả chết", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Postulate", "definition": "Mặc nhận, định đề", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Posture", "definition": "Tư thế, dáng điệu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Potala", "definition": "The Potala was a traditional Winter palace of the Dalai Lamas, and a symbol of the religious and historical heritage of Tibet. Originally built by the Tibetan King Song-tsen Gambo in the seventh centuty, it was later destroyed and not rebuilt until the seventeenth century by the fifth Dalai Lama. The current structure rises a majestic 440 ft from the Summit of the “Red Hill” in Lhasa. It is over a quarter mile long, thirteen stories high and filled with over a thousand chambers, assembly halls, shrines and chapels…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Potalaka", "definition": "Tên một hòn đảo tại Ấn Độ Dương. Hòn đảo này cũng được biết là trú xứ của Đức Quan Thế Âm. Năm 847, một vị tăng người Ấn bỗng nhiên thấy ngài Quan Thế Âm xuất hiện trong một hang động trên một ngọn núi. Sau đó vị này đặt tên cho núi này là Potalaka, dịch là Phổ Đà.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Potentate", "definition": "Kẻ thống trị, vua chuyên quyền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pragmatic", "definition": "Thực tế, thực dụng –Pragmatist: người theo chủ nghiã thực dụng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prajna-paramita", "definition": "Bát Nhã Ba La Mật Đa (Prajna = wisdom; Paramita =", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prajnaparamita", "definition": "The Perfection of Wisdom, the great Buddhist Jhana text: “Gate gate paragate parasamgate bodhi svaha” – Gone, gone, gone beyond, gone altogether beyond, oh what an awakening, all hail!", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prankster", "definition": "Người hay tinh nghịch, đùa cợt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precede", "definition": "Come ahead or in front = đi trước, đứng trước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precept", "definition": "Lời giáo huấn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precession", "definition": "Sự tiến động trong thiên văn học (Precession of the equinoxes)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Preclude", "definition": "Loại trừ, ngăn ngừa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precocious", "definition": "Sớm ra hoa, sớm kết quả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precocity", "definition": "Phát triển sớm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precognition", "definition": "Sự nhận thức trước, biết trước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Precursor", "definition": "Điềm báo trước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Predicament", "definition": "Điều đã được dự đoán, khẳng định", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Predilection", "definition": "Lòng ưa thích, yêu chuộng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Predisposition", "definition": "Tình trạng dễ thiên về, khuynh hướng thiên về", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Preeminent", "definition": "Xuất sắc, ưu việt, trội hơn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Preen", "definition": "Làm dáng, tô điểm, tự khen mình", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prefrontal", "definition": "Trước trán, trên trán", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prejudice", "definition": "Định kiến, thành kiến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Premonition", "definition": "Điềm báo trước, linh cảm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Preponderance", "definition": "Trội hơn, ưu thế", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prerogative", "definition": "Exclusive; special right; power; privilege = đặc quyền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prescience", "definition": "Biết trước, nhìn thấy trước", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prestige", "definition": "Uy tín, thanh thế", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Presumptuous", "definition": "Tự phụ, kiêu ngạo, quá tự tin", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pretence", "definition": "Giả vờ, làm ra vẻ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prevail", "definition": "Thắng thế, chiếm ưu thế, đánh bại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prevalent", "definition": "Thịnh hành, phổ biến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prevarication", "definition": "Sự lảng tránh, sự quanh co", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pricked", "definition": "Bị châm chọc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Primeval", "definition": "Ancient, primitive = nguyên thuỷ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Primordial", "definition": "First created = nguyên thuỷ, nguyên sơ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Primp", "definition": "Đẹp, sang, lịch sự", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prismatic", "definition": "Thuộc lăng kính", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pristine", "definition": "Pure, fresh and clean", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Privy", "definition": "Private", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Proclivity", "definition": "Khuynh hướng, xu hướng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Procrastination", "definition": "Put off intentionally = trì hoản", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prodding", "definition": "To thrust a pointed instrument into… (Prod = vật dùng để đâm)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prodigal", "definition": "Tiêu tiền hoang phí", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prodigious", "definition": "Strange = unusual (Prodigy = người kỳ diệu, phi thường)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Profane", "definition": "Ngoại đạo, trần tục, tục tỉu, bẩn thỉu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Profundity", "definition": "Sâu sắc, uyên thâm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Progenitor", "definition": "Tổ tiên (của người, động vật, cây cối), bậc tiền bối", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Progeny", "definition": "Con cháu, dòng dõi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prognosticate", "definition": "Tiên đoán, báo trước (Prognosis – tiên lượng bệnh)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Progression", "definition": "Phát triển, tiến bộ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Proliferation", "definition": "Sinh sôi nẩy nở, sự tăng nhanh, phát triển", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prolific", "definition": "Sinh đẻ nhiều, sản xuất nhiều", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Promiscuity", "definition": "Trạng thái hổn tạp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Promontory", "definition": "Doi đất, mũi đất", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prompter", "definition": "Người nhắc kịch trên sân khấu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Promulgate", "definition": "Ban hành, công bố", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prone", "definition": "Nằm xấp xuống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Propel", "definition": "Đẩy tới", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Propensity", "definition": "Inclination, leaning= xu hướng, khuynh hướng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prophesy", "definition": "Tiên đoán, tiên tri", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prophet", "definition": "Nhà tiên tri", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Propitiate", "definition": "Làm lành, làm dịu, làm nguôi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Proponent", "definition": "Propound - đề nghị, đề suất", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prosaic", "definition": "Không sáng tạo, tầm thường", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Proscribe", "definition": "Đặt ngoài vòng pháp luật, trục xuất", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prose", "definition": "Văn xuôi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Proselytizing", "definition": "Bắt ai từ bỏ tôn giáo, tín ngưỡng cuả mình", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prostrate", "definition": "Quy phục, phủ phục, tôn sùng (Prostration - sự quy phục)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prostration", "definition": "Placing hands together in prayer, touching the forehead, neck, and heart area, and then bending forward and lay prone on the ground with hands outstretching and the forehead touching the earth…(cách lạy của người Tây Tạng)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Protagonist", "definition": "Người giữ vai chính trong vở kịch", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Protestant", "definition": "Người phản kháng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Protoplasm", "definition": "Chất nguyên sinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Protuberance", "definition": "Phồng lên, lồi lên, u lên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Provenance", "definition": "Nguồn gốc, lai lịch", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Proviso", "definition": "Điều khoản, điều quy định", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prow", "definition": "Mũi tàu, mũi thuyền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prowess", "definition": "Lòng dũng cảm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prowl", "definition": "Đi lảng đảng, đi rình mò", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Prudishness", "definition": "Cả thẹn, làm bộ kiểu cách", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pry", "definition": "Nhìn soi mói, nhìn tọc mạch", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ps A.449.", "definition": "(Desanā kathā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Ps.I83", "definition": "Bốn cõi, cõi chúng sanh, phạm vi tái sanh", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pseudonym", "definition": "Biệt hiệu, bút danh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Psychic", "definition": "Means of the soul, is utilizing your sixth sense or intuition. Every one has a sixth sense and is capable of developing their intuition as well as psychic abilities.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Psychodrama", "definition": "Kịck tâm lý", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Psychopath", "definition": "Người bịnh tâm thần", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Psychosomatic", "definition": "Bệnh căng thẳng thần kinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Psychotherapist", "definition": "Người chữa bệnh bằng tâm lý", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pubbe-Nira Sanussati Nara", "definition": "Túc mệnh minh: có thể nhớ lại tiền kiếp Túc mệnh thông, còn gọi là Túc mệnh minh: biết được kiếp trước của chính bản thân mình và của chúng sinh trong lục đạo, từ một đời, hai đời cho đến trăm ngàn vạn đời trước đều biết rõ, nhớ rõ sinh ra ở đâu, cha mẹ là ai, tên gì, làm gì...", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Puberty", "definition": "Tuổi dậy thì", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pucchā", "definition": "Năm cách hỏi pháp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Puddle", "definition": "Vũng nước nhỏ; việc rắc rối", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Puerile", "definition": "Trẻ con, non nớt, khờ dại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Puff", "definition": "Hơi thở, luồng gió thổi phụt qua", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Puggala", "definition": "Bốn sở hành chúng sanh, bốn hạng người.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pugilist", "definition": "Võ sĩ quyền anh chuyên nghiệp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pulsated", "definition": "Moved rhythmitically = dao động, rung động", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pulverize", "definition": "Tán thành bột, giả nhỏ như cám", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pumice", "definition": "Loại đá bọt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pummel", "definition": "Đánh túi bụi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pun", "definition": "Chơi chữ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Punctilious", "definition": "Chú ý những chi tiết tỉ mỉ, hình thức vụn vặt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Purgative", "definition": "Làm tinh khiết, tẩy (purge = thanh lọc, thanh trừng)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Purgatory", "definition": "Chuộc tội, ăn năn hối lỗi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Purisamala", "definition": "Chín trần cấu nhơn.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Purloin", "definition": "Ăn cắp, ăn trộm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Purport", "definition": "Nội dung, ý nghiã, mục đích", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Purveyor", "definition": "Người cung cấp hàng hoá, công ty cung cấp hàng hoá", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Putative", "definition": "Giả định là, coi là", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Puthujjana", "definition": "Thế tục", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Putrefaction", "definition": "Sự thối rữa, sự đồi bại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Putrid", "definition": "Trở thành thối rữa, mục nát", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Putta", "definition": "Ba hạng con.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Puññakiriyavatthu", "definition": "Mười phước nghiệp sự, phúc hành tông, việc làm tạo phước báu", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Puññakiriyāvatthu", "definition": "Ba phước nghiệp sự, ba việc tạo phước.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Puññasammukhībhāva", "definition": "Ba yếu tố thiết thực để tạo phước thí.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Puññābhisandā", "definition": "Tám nguồn công đức sanh nhân thiên.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pyre", "definition": "A heap of combustible = giàn thiêu để thiêu xác", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pyroclastic", "definition": "Nham tầng do núi lửa tạo thành", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pyrrhic", "definition": "Chiến thắng với giá quá đắt (thắng nhưng thiệt hại nhiều)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Pāpaṇikadhammā", "definition": "Ba pháp thương nhân.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pārisuddhisīla", "definition": "Bốn thanh tịnh giới.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pāvacana", "definition": "Hai loại kinh điển, giáo lý Phật ngôn", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pāṇini", "definition": "(520-460 trước công nguyên): âm dịch là Ba Nhĩ Ni (波爾尼), Ba Nị Ni (波膩尼), Ba Ni Ni (波尼尼), nhà văn pháp trứ danh của Ấn Độ ngày xưa, xuất thân vùng Ta La Đỗ La (s: Śalātura, 娑羅覩邏), nước Kiền Đà La (s, p: Gandhāra, 健駄邏), thuộc Quận Attock, Tỉnh Punjab, Pakistan ngày nay, nằm giữa Rawalpindi và Peshawar. Theo Đại Đường Tây Vức Ký (大唐西域記) quyển 1, phần Kiền Đà La Quốc (健駄邏國), Ba Nhĩ Ni sanh ra đã thông hiểu tất cả, nhạy bén, lanh lợi, có chí muốn viết sách, được trời Tự Tại Thiên (自在天) chỉ giáo cho, nhờ vậy ông nghiên cứu sâu sắc hơn, lấy các ngôn ngữ mà viết thành sách. Sách này thông cả xưa nay, bao quát hết văn từ, ý ngữ; nhà vua thấy vậy rất kinh ngạc, bèn truyền khắp trong nước nếu có ai tụng thuộc sách này thì sẽ được ban thưởng tiền vàng; cho nên sách này được lưu truyền rất thịnh hành. Tương truyền sách này là văn điển Vyākaraṇa (毘伽羅論, Tỳ Già La Luận) gồm 1.000 bài tụng và 32.000 từ. Văn điển do ông trước tác vốn không có tiêu đề và ông rất nổi tiếng về văn pháp tiếng Sanskrit, đặc biệt là hệ thống 3.959 nguyên tắc của hình thái học tiếng Sanskrit về văn phạm, thường được gọi là Aṣṭādhyāyī (nghĩa là “Tám Chương”). Đây là văn bản cơ sở thuộc trường phái văn pháp của Vedāṅga. Aṣṭādhyāyī là sách văn phạm tiếng Sanskrit cổ xưa nhất (mặc dầu một số học giả cho rằng nó lập cước trên các tác phẩm xưa hơn), là tác phẩm sớm nhất về ngôn ngữ học miêu tả và về ngôn ngữ học nói chung. Thông thường lý thuyết dễ hiểu và rất khoa học về văn pháp của Pāṇini được xem như đánh dấu sự chấm dứt giai đoạn tiếng Sanskrit Phệ Đà (Vedic Sanskrit), bằng dịnh nghĩa giới thiệu tiếng Sanskrit Cổ Điển (Classical Sanskrit). Mặc dầu tác phẩm của ông thuần túy mang tính văn pháp và từ điển, chúng ta có thể rút ra vài luận cứ về văn hóa cũng như địa lý qua từ ngữ do ông dùng trong các ví dụ và từ những thư từ ông gởi cho bạn bè văn pháp học của ông", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Pāṭihāriya", "definition": "Ba loại thần thông.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pīti", "definition": "Năm thứ hỷ lạc, phỉ lạc, sự no vui do thiền định sanh", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Pūjā", "definition": "Hai sự cúng dường.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Qua", "definition": "咼. Họ người. Họ Qua Một âm là Quai. Xem Quai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Bích", "definition": "Mông Cổ: Gobi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qua Cát", "definition": "瓜葛. Dây của cây dưa, xoắn xít ràng buộc nhau. Chỉ mối liên hệ ràng buộc giữa người này với người khác. Td: Tình qua cát (chỉ tình họ hàng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Giác", "definition": "蝸角. Cái râu, trông như cái sừng của con sên Chỉ sự nhỏ bé. Td: Qua giác khí cục (lòng dạ hẹp hòi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Giáp", "definition": "戈甲. Cây dáo và áo giáp, vật dụng của quân lính. Chỉ việc chiến tranh Qua giáp: Qua: Ngọn giáo: Giáp: Áo giáp che tên đạn. Qua giáp là nói về quan võ. “Đem tài qua giáp, ép người văn chương” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Khỏi", "definition": "Atikkamati (ati + kam + a), atikkhama (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Qua Lí", "definition": "瓜李. Dưa và mận. Xem Qua điền lí hạ 瓜田李下.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Man", "definition": "瓜蔓. Sợi dây của cây dưa bò lan. Chỉ chuyện này dính dấp tới chuyện kia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Miên", "definition": "(瓜綿): xem phần chú thích qua điệt miên miên (瓜瓞綿綿) bên trên, có nghĩa là con cháu hưng thịnh, đông đúc. Câu “vĩnh thùy diễn tiêu qua miên (永垂衍椒瓜綿)” có nghĩa là mãi mãi được hưởng ân đức của tổ tông để con cháu đông đúc, hưng thịnh.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Qua Nguyệt", "definition": "(瓜月): tên gọi khác của tháng Bảy Âm Lịch. Do vì trái dưa thường chín, ngát hương vào tháng Bảy Âm Lịch, nên tháng này được gọi như vậy. Như trong Thi Kinh (詩經), Chương Bân Phong (豳風), Thất Nguyệt (七月) có giải thích rằng: “Thất nguyệt thực qua, bát nguyệt đoạn hồ (七月食瓜、八月斷壺, tháng Bảy ăn quả dưa, tháng Tám bửa trái bầu).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Qua Ngưu", "definition": "蝸牛. Con sên. Cũng đọc Oa ngưu. Còn có tên là Khoát du. Cũng thường gọi tắt là Qua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Phân", "definition": "瓜分. Bổ trái dưa ra. Chỉ sự chia cắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Phẫu", "definition": "瓜剖. Như Qua phân 瓜分.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Xá", "definition": "蝸舍. Căn nhà rất nhỏ bé (như vỏ con sên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Điền Lí Hạ", "definition": "瓜田李下. Ruộng dưa và dưới cây mận, chỉ nơi dễ bị nghi ngờ. Cẩn thận trọng cũng như đi ngang ruộng dưa mà cúi xuống sửa giày sẽ bị nghi là ăn cắp dưa, đi ngang dưới cây mận mà đưa tay sửa mũ sẽ bị nghi là ăn cắp mận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qua Điệt Miên Miên", "definition": "(瓜瓞綿綿): còn gọi là miên miên qua điệt (綿綿瓜瓞). Qua (瓜) là loại dưa lớn, điệt (瓞) là loại dưa nhỏ; như Thi Kinh (詩經) có câu: “Đại giả viết qua, tiểu giả viết điệt (大者曰瓜、小者曰瓞, loại lớn gọi là qua, loại nhỏ là điệt).” Miên miên (綿綿) có nghĩa là dài lâu, bền vững, như nhiều trái dưa lớn, dưa nhỏ treo lủng lẳng liên tiếp trên dây leo; cho nên câu này dùng để chúc tụng các đời con cháu hưng thịnh, truyền thế lâu dài. Nó vốn phát xuất từ phần Đại Nhã (大雅) của Thi Kinh: “Miên miên qua điệt, dân chi sơ sinh (綿綿瓜瓞、民之初生, dài lâu con cháu, dân lúc mới sanh).” Trong Mao Truyện (毛傳) lại có câu rằng: “Miên miên bất tuyệt mạo, qua thiệu dã, điệt chước dã (綿綿不絕貌、瓜紹也、瓞瓝也, dài lâu không dứt bóng dáng; dưa lớn nối tiếp, dưa nhỏ kế thừa).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Qua Đời", "definition": "Marati (mar + a), maraṇa (trung), cuti (nữ), pahīyati (pa + hā + i + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quadrant", "definition": "Góc, cung ¼", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quagmire", "definition": "Vũng lầy, đầm lầy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quai", "definition": "𠁬. Như chữ Quai 乖.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quai Dị", "definition": "乖異. Như Quai trương 乖張.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quai Trương", "definition": "乖張. Chỉ tính tình khác lạ, không hợp với người xung quanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quai Xảo", "definition": "乖巧. Khôn lanh khéo léo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Qualm", "definition": "Nỗi lo ngại, sợ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quan", "definition": "倌. Bề tôi cấp dưới Viên chức hạng thấp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Binh", "definition": "官兵. Lính tráng của triều đình, nhà nước Lính tráng và người chỉ huy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Biện", "definition": "官辦. Do triều đình, nhà nước đứng ra lo liệu Lo liệu việc công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Báo", "definition": "官報. Xấp giấy in các tài liệu, luật lệ quốc gia. Cũng gọi là Công báo (Journal Officiel).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Bình Thái Tử", "definition": "(關平太子): nhân vật trung hiếu vẹn toàn, còn gọi là Linh Hầu Thái Tử (靈候太子), sanh ngày 13 tháng 5 thuộc năm đầu (178) đời vua Linh Đế nhà Hán, là con nuôi của Quan Thánh Đế Quân (關聖帝君). Trong Tam Quốc Diễn Nghĩa (三國演義), có kể chuyện khi Quan Công muốn đến tại Ngọa Ngưu Sơn (臥牛山) để chiêu binh mãi mã, giữa đường gặp một trang viện; vị trang chủ Quan Định (關定) có hai con trai, người con đầu tên là Quan Ninh (關定), chuyên học về văn; người con kế tên là Quan Bình (關平), chuyên học về võ. Người này vâng lời cha theo hầu Tướng Quân Quan Vũ (關羽) và tôn thờ vị này làm cha nuôi. Tánh tình ông khiêm hậu, ôn hòa, được chúng bộ hạ thương kính; hơn nữa võ nghệ của ông lại siêu phàm. Vào năm thứ 19 (214) niên hiệu Kiến An (建安), Quan Công trấn thủ Kinh Châu (荆州), phía Bắc thì đối cự với Tào Tháo (曹操), phía Đông thì hòa hoãn với Tôn Quyền (孫權). Đến năm thứ 24 (219) cùng niên hiệu trên, cha ông bị trúng kế của Lữ Mông (呂蒙), bị quân Đông Ngô bắt giam; Quan Bình thân chinh đến cứu, bị quân địch bao vây và đến tháng 12 cùng năm này, cả hai cha con đều bị hại. Mọi người cảm phục sự trung hiếu vô song của ông, tôn thờ ông cùng với Châu Thương Tướng Quân (周倉將軍) trong Miếu Quan Thánh như là vị thần hai bên tả hữu của Quan Thánh Đế Quân. Thông thường Quan Bình Thái Tử đứng hầu sau Quan Thánh Đế Quân, tay bắt Hán Thọ Đình Hầu Ấn (漢壽亭候印); Châu Thương Tướng Quân đứng bên phải Đế Quân, tay cầm Thanh Long Yển Nguyệt Đao (青龍偃月刀). Như trong Đào Viên Minh Thánh Kinh (桃園明聖經) của Đạo Giáo có xưng tán rằng: “Chí tâm quy mạng lễ: Linh Hầu Thái Tử, văn kinh võ vĩ, khuôn vương hộ quốc, đức nghĩa nguy nguy, trung hiếu tiết nghĩa, toàn thọ toàn quy, kỳ huân tảo kiến ư Tây Thục, dị lược tố trứ ư Bắc Ngụy, đại trung đại hiếu, chí nhân chí dũng, bổ tạo hóa chi bất túc, tá Thánh Đế dĩ lập công, hộ triều hộ quốc, tận hiếu tận trung, Cửu Thiên Uy Linh Hiển Hóa Đại Thiên Tôn (志心皈命禮、靈侯太子、文經武緯、匡王護國、德義巍巍、忠孝節義、全受全歸、奇勳早建於西蜀、異略素著於北魏、大忠大孝、至仁至勇、補造化之不足、佐聖帝以立功、護朝護國、盡孝盡忠、九天威靈顯化大天尊, Một lòng quy mạng lễ: Linh Hầu Thái Tử, văn võ song toàn, phò vua giúp nước, đức nghĩa vời vợi, trung hiếu tiết nghĩa, thảy đều vẹn toàn, mới lập kỳ tích nơi Tây Thục, kinh lược lừng lẫy chốn Bắc Ngụy, đại trung đại hiếu, trọn nhân trọn dũng, thêm tạo hóa còn chưa đủ, phò Thánh Đế để lập công, giúp vua giúp nước, tận hiếu tận trung, Cửu Thiên Uy Linh Hiển Hóa Đại Thiên Tôn).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Bạch", "definition": "(關白, Kampaku): tên gọi một chức quan trọng yếu nhằm bổ tá cho Thiên Hoàng và chấp hành các công việc chính trị, được dùng vào cuối thời Bình An trở đi. Vào năm 884, dưới thời Quang Hiếu Thiên Hoàng (光孝天皇, Kōkō Tennō, tại vị 884-887) thì hết thảy văn thư trước khi đưa cho nhà vua ngự lãm thì thường giao qua cho vị Quan Bạch tên Đằng Nguyên Cơ Kinh (藤原基經, Fujiwara Mototsune, 1218-1256) xem trước, và từ đó chức quan này ra đời. Chức quan này thường ngồi cao hơn Thái Chính Đại Thần", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Bất Dung Châm Tư Thông Xa Mã", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quan Bất Dung Châm, Tư Thông Xa Mã", "definition": "官 不 容 針 私 通 車 馬. Pháp luật nghiêm minh, tra xét kỹ càng cho đến cây kim cũng không lọt, nhưng vì tình cảm thiên vị mà ngựa xe vẫn lọt qua cửa khẩu, qua chốt kiểm tra như thường. Thiền Tông mượn từ này để chỉ cho thiền sư khi tiếp dẫn người học có thể tùy cơ ứng vật mà dùng nhiều phương thức khác nhau. NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quan Bổng", "definition": "官棒. Tiền cấp cho các viên chức triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Chinh", "definition": "關征. Thuế phải nộp khi đem hàng hoá ra vào lĩnh thổ một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Chiêm", "definition": "觀瞻. Xem xét dòm ngó. Thành ngữ: Nhĩ mục quan chiêm (chỉ nơi tai mắt dòm ngó). “Trăm năm đẹp mắt kẻ quan chiêm”. (Phan văn Trị).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Chế", "definition": "官制. Cách tổ chức, ấn định quyền hạn và nhiêm vụ của những người ra làm việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Chức", "definition": "官職. Phần việc và địa vị của người ra làm việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Cái", "definition": "冠蓋. Mũ và lọng. Chỉ người có chức vị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Cân", "definition": "冠巾. Mũ và khăn. Chỉ sự phân biệt người có chức vị và người thường, hoặc kẻ sĩ và người thường. Thời cổ, các quan và kẻ sĩ mới đội mũ, còn thường dân thì đội khăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Cảm", "definition": "觀感. Nghĩ và thấy trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Cận Thần", "definition": "Khattu (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quan Diêm", "definition": "官鹽. Muối ăn, do triều đình khai thác, quản trị và phân phối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Dạng", "definition": "官樣. Dáng dấp oai vệ của người ra làm việc triều đình. Cái vẻ quan lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Giai", "definition": "官階. Thứ bậc cao thấp của những người làm việc triều đình. Đoạn trường tân thanh có câu: “Một nhà phúc lộc gồm hai. Nghìn năm dài dặc quan giai lần lần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Giá", "definition": "官價. Số tiền mua vật gì, theo sự ấn định của triều đình, nhà nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Giữ Kho", "definition": "Kosārakkha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quan Hoài", "definition": "關懷. Bận lòng, lo nghĩ trong lòng. Bản dịch Chinh phụ ngâm có câu: “Nay một thân nuôi già dạy trẻ, Mối quan hoài mang mể biết bao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Huống", "definition": "官况. Tình cảnh làm việc của triều đình. Tình trạng làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Hà", "definition": "關河. Cửa ải và sông, chỉ sự xa xôi, đi xa. Đoạn trường tân thanh có câu: “Tiễn đưa một chén quan hà, Xuân đình thoắt đã dạo ra cao đình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Hàm", "definition": "官銜. Danh hiệu cao quý theo thứ bậc của người làm việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Hải", "definition": "觀海. Xem biển, chỉ cái nhìn xa rộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Hệ", "definition": "關係. Ràng buộc, dính dấp tới Chỉ sự việc lớn lao, dính dấp tới nhiều việc khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Hữu Vô Đảng", "definition": "Kuan yu Wu tang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Khoá", "definition": "官課. Thuế má do triều đình, nhà nước ấn định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Khách", "definition": "官客. Chỉ chung người có chức vị hiện diện trong một cuộc tổ chức gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Kiện", "definition": "關鍵. Cái then cài cửa, cái chốt cửa Chỉ phần trọng yếu nhất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Kỷ", "definition": "官紀. Phép tắc mà những người làm việc triều đình phải tuân giữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Kỹ", "definition": "官妓. Gái điếm được triều đình chính thức nhìn nhận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Lang", "definition": "官郎. Danh hiệu chỉ con trai các vua Hùng Vương nước ta. Con gái gọi là Mị Nương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Liên", "definition": "關聯. Ràng buộc, dính dấp tới. Cũng nói: Liên quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Liêu", "definition": "官僚. Như Quan lại 官吏.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Liệt Tử", "definition": "關 捩 子. Gọi tắt: Quan liệt (chữ Liệt cũng viết〖⿰木戾〗). Chỗ chí cực vi diệu của thiền cơ, điểm then chốt của sự lý. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quan Lại", "definition": "官吏. Chỉ chung những người làm việc triều đình. Quan là người đứng đầu công việc. Lại là người để quan sai phái. Truyện Trê Cóc có câu: “Kẻo khi quan lại còn xa, Đây mà nổi giận lôi ra kéo vào”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Lập", "definition": "官立. Do triều đình, nhà nước làm ra. Cũng như: Công lập.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Lễ", "definition": "冠禮. Lễ đội mũ cho con trai nhà quyền quý, khi vừa tròn 20 tuổi, tức lễ Gia quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Lộ", "definition": "官路. Như Quan đạo 官道.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Lộc", "definition": "官祿. Chỉ chung tiền bạc vật phẩm vua ban cho người làm việc triều đình. “Tốt cung quan lộc, Vượng hào thê nhi”. (Phan Trần).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Miện", "definition": "冠冕. Mũ đội khi làm việc triều đình và mũ đội khi tế lễ hay có cuộc lễ. Chỉ người có chức vị cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Mại", "definition": "官賣. Do triều đình, nhà nước đứng bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Nghiêm Tự Bi Văn", "definition": "關嚴寺碑文. Tên một bài văn bằng chữ Hán của Trương Hán Siêu, danh sĩ đời Trần, khắc trên bia đá ở chùa Quan nghiêm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Ngoại", "definition": "關外. Ở ngoài cửa ải. Chỉ vùng đất xa xôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Ngại", "definition": "關礙. Ngăn trở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Ngọc", "definition": "冠玉. Viên đá quý gắn vào mũ của người có chức việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Nha", "definition": "官衙. Nơi làm việc triều đình Nhà ở của người làm việc triều đình. Đoạn trường tân thanh có câu: “Một đoàn về đến quan nha, Đoàn viên vội mở tiệc hoa vui vầy”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Nhân", "definition": "倌人. Người đánh xe Kĩ nữ. Gái điếm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Niệm", "definition": "觀念. Điều nghĩ ngợi hoặc cảm thấy một sự việc, một vấn đề.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Niệm Luận", "definition": "Trong Phật Giáo có các tông như Tông Duy Thức, Tông Hoa Nghiêm... chủ trương vũ trụ là do tâm biến hiện, nếu lìa tâm thì tất cả muôn pháp cũng không tồn tại, cho nên có các câu nói như: “Ba cõi duy nhất tâm, ngoài tâm không pháp khác”, “Chỉ có thức không có cảnh”... Do nhấn mạnh thuyết Duy Tâm hoặc Duy Thức nên Phật Giáo thường được giới triết học phương Tây xem là Quan Niệm Luận hoặc Duy Tâm Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quan Năng", "definition": "官能. Sự làm việc của bộ phận cơ thể (Fonction).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Nội", "definition": "關內. Vùng đất bên trong cửa ải. Trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Nội Tứ Thánh", "definition": "Cũng gọi Quan Trung Tứ Kiệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quan Phiệt", "definition": "官閥. Dòng dõi làm việc triều đình, đời đời có chức vị cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Phong", "definition": "觀風. Xem chiều gió Xem xét sự biến chuyển để tìm cơ hội. “Quan phong khi giá nam hành” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Pháp", "definition": "官法. Luật lệ quốc gia. Cũng chỉ luật lệ khắt khe của người làm việc triều đình (ông quan). Truyện Trê Cóc có câu: “Lệ rằng quan pháp như lôi, Chỉ đâu đánh đó chẳng đâu là lành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Phòng", "definition": "關房. Giữ gìn chỗ đất hiểm yếu ở biên giới Đóng chặt giữ gìn. Đoạn trường tân thanh có câu: “Quan phòng then chặt lưới mau, Nói lời trước mặt rơi châu vắng người”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Phẩm", "definition": "官品. Như Quan đẳng 官等.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Phục", "definition": "官服. Quần áo của người làm việc triều đình. Quần áo của quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Quang", "definition": "觀光. Xem xét, tìm biết văn hoá một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Quy", "definition": "官規. Như Quan chế 官制.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Quyền", "definition": "官權. Điều mà người lo việc được phép làm trong phạm vi chức vụ của mình Ta còn hiểu là người có chức vụ và thế lực.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Quách", "definition": "棺槨. Hòm đựng xác người chết, và lớp vỏ bao ngoài. Ta thường nói: Trong quan ngoài quách (chỉ cái hòm hai lớp dùng trong đám tang nhà quyền quý).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Quân", "definition": "冠軍. Người đứng đầu một toán binh lính Danh hiệu dùng cho vị võ tướng, dùng trong các đời Nguỵ Tấn tới thời Nam Bắc triều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Quả", "definition": "鰥寡. Người đàn ông goá vợ và người đàn bà goá chồng. Cũng chỉ người không nơi nương tựa. Gia huấn ca của Nguyễn Trãi có câu: “Thương người quan quả cô đơn, Thương người đói rét lầm than kêu đường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan San", "definition": "關山. Như Quan sơn 關山. Đoạn trường tân thanh có câu: “Người lên ngựa kẻ chia bào, rừng phong thu đã nhuộm màu quan san”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Sát", "definition": "觀察. Xem xét kĩ càng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Sơn", "definition": "關山. Cửa ải và núi non. Chỉ sự xa xôi cách trở. Bản dịch Chinh phụ ngâm khúc có câu: “Nỡ nào đôi lứa thiếu niên, Quan sơn để cách hàn huyên bao đành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Sơn Huệ Huyền", "definition": "(關山慧玄, Kanzan Egen, 1277-1360): vị tăng của Tông Lâm Tế Nhật Bản, sống vào khoảng giữa hai thời đại Liêm Thương (鎌倉, Kamakura) và Nam Bắc Triều, vị tổ khai sáng Diệu Tâm Tự (妙心寺, Myōshin-ji), húy Huệ Nhãn (慧眼), Huệ Huyền (慧玄), đạo hiệu Quan Sơn (關山), nhụ hiệu Bổn Hữu Viên Thành (本有圓成), Phật Tâm Giác Tánh (佛心覺性), Đại Định Thánh Ứng (大定聖應), Quang Đức Thắng Diệu (光德勝妙), Tự Tánh Thiên Chơn (自性天眞), Phóng Vô Lượng Quang (放無量光), Vô Tướng Đại Sư (無相大師), xuất thân vùng Tín Nùng (信濃, Shinano, thuộc Nagano-ken [長野縣]). Ông là người con thứ 2, sanh ra trong gia đình Thủ Cao Gia (守高家) của Mỹ Nùng, lúc còn nhỏ được gọi là Tào Tử Triêu Minh Lữ (曹子朝明麿), theo học với chú là Nguyệt Cốc Tông Trung (月谷宗忠). Ban đầu ông theo xuất gia với Đông Truyền Sĩ Khải (東傳士啓) ở Quảng Nghiêm Am (廣嚴庵), Kiến Trường Tự (建長寺, Kenchō-ji) vùng Liêm Thương (鎌倉, Kamakura). Đến năm 1307 (năm thứ 2 niên hiệu Đức Trị [德治]), ông gặp Đại Ứng Quốc Sư Nam Phố Thiệu Minh (大應國師南浦紹明) ở Kiến Trường Tự, được ban cho tên là Huệ Nhãn (慧眼) và theo hầu vị này tu tập. Nhưng vì không có chỗ sở ngộ nên sau đó vào năm 1327 (năm thứ 2 niên hiệu Gia Lịch [嘉曆]) ông lại đến kế thừa dòng pháp của Đại Đăng Quốc Sư Tông Phong Diệu Siêu (大燈國師宗峰妙超) ở Đại Đức Tự (大德寺, Daitoku-ji) vùng Sơn Thành (山城, Yamashiro). Năm 1328, ông đến ẩn cư ở vùng Y Thâm (伊深), Mỹ Nùng (美濃, Mino), đến năm 1330 (năm thứ 2 niên hiệu Nguyên Đức [元德]), ông được ấn chứng cho là đã ngộ được công án chữ Quan (關) của Vân Môn (雲門), nên được ban cho hiệu là Quan Sơn (關山), hiệu là Huệ Huyền (慧玄). Vào năm 1342, Hoa Viên Thượng Hoàng (花園上皇, Hanazono Jōkō) biến Hoa Viên Ly Cung thành Diệu Tâm Tự và cung thỉnh ông đến làm tổ khai sơn chùa nầy. Sau đó, ông lại đến dựng am sống ở vùng Viễn Giang (遠江), nhưng đến năm 1351 ông trở về lại Diệu Tâm Tự và cử xướng Thiền phong uy nghiêm của ông. Dòng pháp từ của ông có Thọ Ông Tông Bật (授翁宗弼). Chính dòng pháp hệ nối tiếp Thiệu Minh (紹明), Diệu Siêu (妙超), Huệ Huyền (慧玄) đã chiếm vai trò lãnh đạo Thiền Lâm Tế về sau. Vào năm 1360 (năm thứ 5 niên hiệu Diên Văn [延文]), ông thị tịch, hưởng thọ 84 tuổi. Trước tác của ông có Quan Sơn Hòa Thượng Bách Tắc Công Án (關山和尚百則公案) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Sơn Huệ Huyền", "definition": "Kanzan Egen (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Sản", "definition": "官產. Của cải chung, do triều đình, nhà nước quản trị. Cũng như Công sản 公產.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Sảnh", "definition": "官𢌖. Như Quan nha 官衙.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Sự", "definition": "官事. Việc công, việc quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thiết", "definition": "關切. Ràng buộc chặt chẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thiệp", "definition": "關涉. Dính dấp ràng buộc với. Như: Quan hệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thoại", "definition": "官話. Thứ tiếng Trung Hoa dùng trong việc triều đình Chỉ tiếng Bắc Kinh, tức tiếng Quốc ngữ của Trung Hoa ngày nay. Còn gọi là tiếng phổ thông. Ta thường gọi lầm là tiếng Quan hoả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thuộc", "definition": "官屬. Những người làm việc cho triều đình Những viên chức giúp việc cho một vị quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thánh", "definition": "(關聖): tên gọi một vị danh tướng của nhà Thục thời Tam Quốc, tên là Quan Vũ (關羽), tự là Trường Sanh (長生), Vân Trường (雲長), thường gọi là Quan Công (關公). Ông đã từng phục vụ cho Lưu Bị (劉僃) nhà Thục, rất liêm chính, cương trực, sau bị Tôn Quyền (孫權) nhà Ngô giết chết. Ông được sùng kính như là vị anh hùng của quốc dân, được xem như là bậc thánh và được thờ tại Quan Đế Miếu (關帝廟), cho nên có tên gọi là Quan Thánh Đế Quân (關聖帝君). Ông còn được gọi là Quan Đế Da (關帝爺), Tây Sơn Phu Tử (西山夫子), Cái Thiên Cổ Phật (蓋天古佛), Hiệp Thiên Đại Đế (協天大帝), Phục Ma Đại Đế (伏魔大帝), v.v. Dưới thời nhà Tống, vua Huy Tông (徽宗) phong ông lên ba cấp từ Trung Huệ Công (忠惠公), Sùng Ninh Chơn Quân (崇寧眞君) cho đến Chiêu Liệt Võ An Vương (昭烈武安王). Vua Văn Tông (文宗) nhà Nguyên lại phong cho ông là Hiển Linh Nghĩa Dũng Võ An Anh Tế Vương (顯靈義勇武安英濟王). Vua Thần Tông (神宗) nhà Minh phong cho ông tước hiệu Tam Giới Phục Ma Đại Đế Thần Uy Viễn Trấn Thiên Tôn Quan Thánh Đế Quân (三界伏魔大帝神威遠鎭天尊關聖帝君). Đến thời nhà Thanh, vua Đức Tông (德宗) phong cho ông tước hiệu dài nhất là Trung Nghĩa Thần Võ Linh Hựu Nhân Dũng Hiển Uy Hộ Quốc Bảo Dân Tinh Thành Tuy Tĩnh Dực Tán Tuyên Đức Quan Thánh Đại Đế (忠義神武靈佑仁勇顯威護國保民精誠綏靖翊讚宣德關聖大帝). Tín ngưỡng về Quan Thánh rất phổ biến kể từ thời nhà Đường, nhưng đến thời nhà Thanh thì ông được sùng kính như là vị thần hộ vệ cho hoàng tộc. Vì lẽ đó, trong suốt giai đoạn này bất cứ nơi đâu người ta đều thấy xuất hiện Quan Đế Miếu (關帝廟). Ngoài ra, ông còn được xem như là Thần Tài, vị thần phù hộ làm ra nhiều tiền và thịnh vượng. Đặc biệt, trong Phật Giáo, ông được tôn kính như là vị đại hộ pháp. Trong một vài thư tịch của Thiền Tông, có đề cập đến câu chuyện sau khi ông bị chém đứt đầu chết thì biến thành con quỷ không đầu, hồn phách thường lảng vảng trong rừng trải qua đến ba bốn trăm năm. Cuối cùng con quỷ không đầu ấy gặp Trí Khải Đại Sư (智顗大師, 538-397)—người sáng lập ra Thiên Thai Tông Trung Quốc, được Đại Sư dùng pháp Phật làm cho siêu độ và thoát khỏi thân quỷ. Sau khi được siêu độ, có chánh tín vào Phật pháp, Quan Công phát nguyện lớn đời đời kiếp kiếp sẽ hộ trì chánh pháp, hàng phục yêu ma, bảo hộ già lam thánh chúng. Cho nên ông trở thành vị Bồ Tát hộ pháp cho chốn già lam, được liệt vào hàng ngũ hai vị thần hộ pháp cùng với Vi Đà Tôn Thiên Bồ Tát (韋駄尊天菩薩). Hằng năm, người dân vẫn tưởng niệm ngày khánh đản của ông vào ngày 24 tháng 6 âm lịch. Đạo Giáo Trung Quốc vẫn lưu hành Quan Thánh Đế Quân Giác Thế Chơn Kinh (關聖帝君覺世眞經), trong đó có dạy rằng: “Nhân sanh tại thế, quý tận trung hiếu tiết nghĩa đẳng sự, phương ư nhân đạo vô quý, khả lập ư thiên địa chi gian (人生在世、貴盡忠孝節義等事、方於人道無愧、可立於天地之間, con người ở đời, quý nhất các việc tận trung, hiếu, tiết nghĩa, mới không xấu hổ với mọi người, có thể đứng vững giữa trời đất).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Thân", "definition": "官紳. Chỉ chung những người thi đậu, được lo việc triều đình. Nhị Độ Mai có câu: “Triều ban dự bậc quan thân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thông", "definition": "關通. Liên lạc với nước ngoài. “Để cho dứt nẻo quan thông đôi nhà” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thư", "definition": "(關雎): có nhiều nghĩa khác nhau.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Thưởng", "definition": "觀賞. Xem cho thích. Xem để thưởng thức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thế Âm", "definition": "Xem Quán Thế Âm Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Thế Âm Tự", "definition": "(觀世音寺, Kanzeon-ji): ngôi tự viện của Thiên Thai Tông, tọa lạc tại Dazaifu-shi (大宰府市), Fukuoka-ken (福岡縣). Chùa do Thiên Trí Thiên Hoàng (天智天皇, Tenchi Tennō) phát nguyện xây dựng để cầu nguyện hồi hướng công đức cho mẹ ông là Tề Minh Thiên Hoàng (齊明天皇, Saimei Tennō) qua đời ở vùng Khủng Tử (筑紫, Chikushi); tuy nhiên đến năm 746 (niên hiệu Thiên Bình [天平] thứ 18) mới hoàn thành. Chùa tọa lạc về phìa Đông của Thái Tể Phủ (大宰府, Daizaifu). Giới Đàn Viện của chùa là một trong 3 giới đàn nổi tiếng trong thiên hạ, cùng sánh ngang hàng với hai Giới Đàn Viện ở Đông Đại Tự (東大寺, Tōdai-ji) và Dược Sư Tự (藥師寺, Yakushi-ji). Tăng ni ở vùng tây nam Nhật Bản đều phải đến đây thọ giới. Chùa đã trãi qua một thời rất hưng thịnh, nhưng đến cuối thời Bình An (平安, Heian) thì suy tàn và trở thành chùa phụ thuộc của Đông Đại Tự. Chùa hiện vẫn còn lưu giữ Phạn Chung thuộc Thời Đại Bạch Phụng (白鳳時代, Hakuhō-jidai), các tượng Thập Nhất Diện Quan Âm (十一面觀音), Mã Đầu Quan Âm (馬頭觀音), Bất Không Quyên Sách Quan Âm (不空羂索觀音), v.v., thuộc Thời Đại Bình An. Trong thời gian bị lưu đày, Quản Nguyên Đạo Chơn (菅原道眞, Sugawara-no-Michizane, 845-903) có vịnh hai câu thơ rất nổi tiếng về chùa này: “Lầu Đô Phủ mới nhìn màu ngói, Chùa Quan Âm vẳng nghe tiếng chuông” (Quản Gia Hậu Tập [菅原後集]).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Thứ", "definition": "官次. Như Quan đẳng 官等.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Thự", "definition": "官署. Như Quan nha 官衙, Quan sảnh 官𢌖.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tinh", "definition": "Guanxing (C) , Kuan-hsing (C), Star of State Officials Guanxing (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Tiết", "definition": "關節. Khớp xương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Trai Giới", "definition": "Chữ “quan” nghĩa là đóng; ở đây có nghĩa là đóng các cánh cửa giác quan lại, bớt tiếp xúc với các trần cảnh, để ngăn chận phiền não, tội lỗi, gây ra bởi trần cảnh. Chữ “giới” tức là giới luật, có công năng phòng hộ thân khẩu ý, không để chạy theo trần cảnh mà gây các nghiệp xấu. Chữ “trai”, nghĩa rộng là làm cho thân tâm thanh tịnh; nghĩa hẹp là ăn đúng giờ ngọ. “Quan Trai Giới” tức là một loại giới pháp (gồm có tám giới điều) được lập ra để giúp cho người cư sĩ tại gia có cơ hội sống 24 giờ (một ngày đêm) trong chùa, theo nếp sống li dục, thanh tịnh của người xuất gia.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quan Trình", "definition": "官程. Thời hạn đi đường để nhận việc triều đình Con đường làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Trường", "definition": "官場. Chỉ chung những người có chức vị, làm việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Trật", "definition": "官秩. Như Quan giai 官階, Quan đẳng 官等.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Trọng", "definition": "Mukhya (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quan Tuyển", "definition": "官選. Do triều đình lựa chọn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tuế", "definition": "冠歲. Tuổi đội mũ, tức tuổi 20.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tài", "definition": "棺材. Hòm đựng xác người chết, cũng nói tắt là Quan. Thơ Nguyễn Khuyến có câu: “Ơn nước chưa đền danh cũng hổ, Quan tài sẵn đó chết thì chôn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tào", "definition": "官曹. Chỉ chung những người làm việc triều đình, nhà nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tái", "definition": "關塞. Cửa ải ở biên giới. Đoạn trường tân thanh có câu: “Một màu quan tái mấy mùa gió trăng”. Chỉ sự xa cách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tâm", "definition": "關心. Dính dấp trong lòng. Bận lòng. Nghĩ tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tòa", "definition": "Akkhadassa (nam), adhikaraṇika (nam), daṇḍanāyaka (nam), vohārika (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quan Tăng", "definition": "Chỉ cho những người xuất gia được triều đình chứng nhận và cấp cho độ điệp, hoặc chỉ cho những người xuất gia được bổ nhiệm giữ các chức quan tăng như Tăng Chính,Tăng đô, Luật sư...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quan Tư", "definition": "官資. Chỉ chung dáng điệu, ngôn ngữ và cách đối xử của người ra làm việc triều đình. Tức tư cách của vị quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tước", "definition": "官爵. Danh vị cao quý ban cho người làm việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tướng", "definition": "觀相. Xem xét diện mạo dáng dấp bên ngoài mà biết được cuộc đời một người. Xem tướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tượng", "definition": "觀象. Xem xét những điều xảy ra trên trời để biết sự thay đổi của thời tiết khí hậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tượng Đài", "definition": "觀象臺. Nơi xây cao để xem xét điều xảy ra trên trời. Cũng như: Thiên văn đài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tịch", "definition": "官籍. Sổ sách của triều đình, nhà nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tộc", "definition": "冠族. Dòng họ hiển vinh, đời đời có chức vị cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Từ", "definition": "冠詞. Tiếng đứng trước một tiếng danh từ, coi như cái mũ đội cho danh từ đó, còn gọi là Mạo từ (Article).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tử", "definition": "冠子. Cái mũ dành cho đàn bà quuyền quý Trung Hoa thời cổ Người con trai trong nhà ở tuổi 20, đã được đội mũ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Tự", "definition": "Chùa quan, tức các chùa viện được ban bổng lộc và chịu sự quản lí của triều đình. Tại Trung Quốc, những Thiền Viện như Ngũ Sơn, Thập sát được đặt ra ở đời Tống là thuộc Quan tự. Ngũ Sơn gồm: Hưng Thánh Vạn Thọ Thiền Tự, Cảnh Phúc Linh Ẩn Tự, Tịnh Từ Tự, Cảnh Đức Tự Và Quảng Lợi Tự. Thập sát thì có: Trung Thiên Trúc Sơn Thiên Ninh Vạn Thọ Vĩnh Tộ Tự, Đạo Tràng Sơn Hộ Thánh Vạn Thọ Tự, Tưởng SơnThái Bình Hưng Quốc Tự, Vạn Thọ Sơn Báo Ân Quang Hiếu Tự, Tuyết Đậu Sơn Tư Thánh Tự, Giang Tâm Sơn Long Tường Tự, Tuyết Phong Sơn Sùng Thánh Tự, Vân Hoàng Sơn Bảo Lâm Tự, Hổ Khâu Sơn Vân Nham Tự Và Thiên Thai Sơn Quốc Thanh Trung Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quan Viên", "definition": "官員. Người làm việc triều đình Tiếng tôn xưng những người có chức vị Tiếng tôn xưng những người đi hát cô đầu thời trước Tiếng tôn xưng người khác. Td: Quan viên hai họ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Văn", "definition": "Chỉ cho những câu văn mà Thiền gia viết trên quan tài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quan Vũ", "definition": "Kuan Yu (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Vọng", "definition": "觀望. Xem xét trông đợi. Xem xét cho kĩ rồi mới quyết định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Xích", "definition": "官尺. Cái thước để đo, mà bề dài thống nhất, do triều đình ấn định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Âm", "definition": "Kannon (J), Kanzeon (J), Kwannon (J), Avalokitesvara (S), Kuan-yin (C), Guanyin (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Âm Cấm", "definition": "Avalokitavrata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Âm Kinh Phổ Môn Phẩm", "definition": "Xem Quán Thế Âm Phổ Môn Phẩm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Âm Nam Hải", "definition": "Truyện thơ Việt Nam kể chuyện công chúa Diệu Thiện, con gái thứ ba vua Diệu Trang Vương, nước Hùng Lâm (Ấn Độ), sang tu ở chùa Hương Tích (Việt Nam) và thành Phật Bà Quan Âm tại đây.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quan Âm Nữ", "definition": "Danh hiệu do dân chúng tặng Dương Phi Ỷ Lan, trị vì thay vua Lý Thánh Tông trong lúc vua đi đánh Chiêm Thành.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quan Âm Phật", "definition": "Kouan Yin (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Âm Thị Kính", "definition": "Truyện thơ Việt Nam kể chuyện Thị Kính mắc oan giết chồng, và sau khi cải trang nam giới đi tu lại bị vu oan là phá giới, gian dâm, nhưng nhờ đức hạnh từ bi, nhẫn nhục của mình nên cuối cùng vừa được minh oan, vừa đắc đạo trở thành Bồ Tát Quan Âm. Truyện thơ viết theo thể văn vần lục bát, gồm tất cả 786 câu. Tương truyền tác giả là Hoà Thượng Chân Nguyên, nhưng các sách văn hoc sử đều ghi khuyết danh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quan Âm Đạo Lợi Viện Hưng Thánh Bảo Lâm Tự", "definition": "(觀音導利院興聖寶林寺): còn gọi là Hưng Thánh Tự (興聖寺, Kōshō-ji), đạo tràng sơ khai của Tào Động Tông Nhật Bản, hiện tọa lạc tại số 27 Yamada (山田), Uji-shi (宇治市), Kyoto-fu (京都府); hiệu núi là Phật Đức Sơn (佛德山); gọi đủ là Phật Đức Sơn Quan Âm Đạo Lợi Viện Hưng Thánh Bảo Lâm Tự (佛德山觀音導利院興聖寶林寺). Tượng thờ chính là Thích Ca Tam Tôn. Vị Khai Tổ của Tào Động Tông Nhật Bản là Đạo Nguyên (道元, Dōgen) đã từng sang Trung Quốc cầu pháp, rồi trở về nước vào năm 1232 (Trinh Vĩnh [貞永] nguyên niên), lúc ông 33 tuổi. Năm sau 1233 (Thiên Phước [天福] nguyên niên), ông kiến lập một ngôi chùa trên nền đất cũ của Cực Lạc Tự (極樂寺, Gokuraku-ji), ở vùng Thâm Thảo (深草, Fukakusa), Quận Vũ Trị (宇治郡, Uji-gun); và ban đầu chùa có tên là Hưng Thánh Bảo Lâm Tự (興聖寶林寺). Khi ấy Chánh Giác Thiền Ni (正覺禪尼) cúng dường tiền xây dựng Pháp Đường, rồi tiếp theo Đằng Nguyên Giáo Gia (藤原敎家) cũng phát tâm cúng dường Đàn Tu Di để phụng nạp trong Pháp Đường này. Trong suốt 11 năm trường cho đến khí dời về Vĩnh Bình Tự (永平寺, Eihei-ji) ở Fukui-ken (福井懸), chính Đạo Nguyên đã từng thuyết giáo, cao xướng chánh pháp tại đây. Phần lớn các đệ tử nổi danh của ông đều đã từng tu tập tại Thánh địa này. Tuy nhiên, sau khi Đạo Nguyên dời về Vĩnh Bình Tự, cũng như sau khi ông qua đời, ngôi chùa đã bị đốt cháy tan tành, dần lụi tàn theo năm tháng và không còn thấy bóng dáng nữa. Kiến trúc hiện tại của chùa nằm ở vị trí khác với vị trí chùa trước. Vào năm 1648 (Khánh An [慶安] nguyên niên) dưới thời đại Giang Hộ (江戸, Edo), thể theo lời nguyện ước của vị Thành chủ Thủy Tỉnh Thượng Chính (水井尚政, Nagai Naomasa), ngôi chùa được tái kiến lại. Trong Khai Sơn Đường có thờ tôn tượng của Thiền Sư Đạo Nguyên, và nơi ngôi tháp khai sơn có hài cốt của Thiền Sư.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quan Điền", "definition": "官田. Ruộng công, của triều đình, nhà nước. Cũng như: Công điền 公田.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Đái", "definition": "冠帶. Mũ và đai. Chỉ chung quần áo và sự ăn mặc Chỉ người có chức vị cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Đại Thần", "definition": "Mantī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quan Đạo", "definition": "官道. Đường đắp lên cho xe ngựa của viên chức triều đình đi Đường sá do triều đình, nhà nước cho lập ra để dân chúng dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Đẳng", "definition": "官等. Thứ hạng trên dưới của những người ra làm việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Đế", "definition": "Kuan-Ti (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quan Đỉnh", "definition": "觀鼎. Nhòm ngó cái vạc, chỉ sự nhòm ngó ngôi vua, có ý cướp ngôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Địa", "definition": "官地. Đất công, của triều đình hoặc nhà nước, không phải của tư nhân. Cũng như: Công thổ 公土.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan Ải", "definition": "關隘. Vùng đất hiểm yếu ở biên giới, có đường dẫn vào nội địa. Bản dịch Chinh phụ ngâm có câu: “Bóng kì xí rợp ngoài quan ải”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quan ấn", "definition": "官印. Con dấu đóng trên các giấy tờ triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quandary", "definition": "Tình thế khó xử, tình huống khó khăn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quang", "definition": "Prabhāsa (S), Ray.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Bạn", "definition": "Cũng gọi Quang Ưng, Quang Cứ. Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Bảo", "definition": "Tức Phổ Quang và Pháp Bảo, 2 vị tăng, học trò ngài Huyền Trang đời Đường. Hai vị này đều có chú thích Luận Câu Xá. Sư Phổ Quang soạn trước Câu Xá Luận Kí 30 quyển, sư Pháp Bảo soạn sau Câu Xá Luận Sớ 39 quyển, gọi là Quang Bảo Nhị Kí, nên người đời thường ghép chung tên 2 vị tăng này mà gọi là Quang Bảo. Tống Cao Tăng Truyện quyển 4 (Đại 50, 727 thượng) nói: “Bấy giờ, 2 pháp sư Quang Bảo (Phổ Quang và Pháp Bảo) cũng đều nổi tiếng như 2 pháp sư Dung Duệ (Đạo Dung và Tăng Duệ) học trò ngài La Thập vậy”. (xt. Pháp Bảo, Phổ Quang).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Bối", "definition": "Cũng gọi Hậu Quang, Quang Diệm, Quang.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Chiếu", "definition": "光照. Rọi sáng. Như Quang cố 光顧.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Chất", "definition": "光質. Tên chất Radium.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Cảnh", "definition": "光景. Chỉ chung những gì bày ra trước mắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Cố", "definition": "光顧. Ngoảnh lại mà rọi sáng tới, tiếng tôn xưng người khác ngó ngàng tới mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Diễm", "definition": "光豔. Sáng sủa đẹp đẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Diệu", "definition": "光耀. Sáng sủa rực rỡ Vẻ vang chói lọi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Dung", "definition": "Ánh sáng và sự dung hòa. Nghĩa là ánh sáng của Phật Pháp có năng lực dung hòa tất cả. Hoằng dương chính pháp để dung hòa và thu nhiếp những người Tà Kiến vào Phật Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Dũng", "definition": "光 涌 (850-938). Thiền tăng đời Ngũ Đại, họ Chương, người xứ Phong Thành (nay thuộc Giang Tây). Thuở nhỏ học sách Nho, năm 13 tuổi có thể giảng giải nghĩa kinh. Đến khi trưởng thành, đi dạo chùa Khai Nguyên gặp dị tăng giao cho chỉ quyết kinh Duy Ma, liền đến chùa Thạch Đình ở Hồng châu nương Thiền Sư Ngưỡng Sơn Huệ Tịch xuất gia, 19 tuổi thọ giới cụ túc. Sư từng tham vấn Lâm Tế Nghĩa Huyền, y theo lời dạy mà trở về hầu hạ Huệ Tịch. Sau được tâm ấn, nối pháp làm truyền nhân tông Quy Ngưỡng. Khi Huệ Tịch mất, Quang Dũng đốt ngón tay cúng dường, và ở lại Nam Tháp Ngưỡng Sơn phát dương tông phong. Niên hiệu Thiên Hựu thứ 1 (904) đến Hồng Châu trụ trì chùa Thạch Đình, 14 năm sau từ biệt trở lại Ngưỡng Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Hiếu Thiên Hoàng", "definition": "(光孝天皇, Kōkō Tennō, tại vị 884-887): vị Thiên Hoàng sống vào đầu thời kỳ Bình An, Hoàng Tử thứ 4 của Nhân Minh Thiên Hoàng (仁明天皇, Nimmyō Tennō), tên là Thời Khang (時康, Tokiyasu), còn gọi là Tiểu Tùng Đế (小松帝).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quang Hiếu Tự", "definition": "Chùa ở phía tây bắc Quảng Châu, tỉnh Quảng Đông, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Hiếu Tự Thiết Tháp", "definition": "光 孝 寺 鐵 塔. Trong khuôn viên chùa Quang Hiếu, thành phố Quảng Châu, tỉnh Quảng Đông, Trung Quốc. Đông thiết tháp nằm ở phía đông ao Bạch Liên, chùa Quang Hiếu, niên hiệu Đại Bảo thứ 10 (967) Nam Hán chúa Lưu Sưởng quyên tạo. Tháp hình vuông 7 tầng cao 6,35m, có tòa Tu Di bằng đá khắc, cao 1,34m. Toàn tháp có hơn 900 cái khám thờ Phật, trong mỗi khám đều có một tượng Phật nhỏ, công nghệ tinh xảo, lúc mới thành toàn thân thếp vàng, được gọi là “Đồ kim thiên Phật tháp”. Xung quanh có điêu khắc “Hành long hỏa châu”, “Thăng long giáng long hỏa diệm tam bảo châu”, tạo dáng sinh động. Tháp nguyên đặt tại chùa Khai Nguyên, Quảng Châu (đã bị phá hủy), khoảng niên hiệu Đoan Bình (1234- 1236) đời Tống do tăng trụ trì di dời đến chùa Quang Hiếu, xây điện che phủ. Tháp này dùng kỷ nghệ đúc luyện và điêu khắc cao siêu, là một trong những tháp sắt hoàn chỉnh nhất, cổ xưa nhất hiện còn ở Trung Quốc. Tây thiết tháp nằm ở phía tây Đại điện chùa Quang Hiếu. Niên hiệu Đại Bảo thứ 6 (963) Thái giám của Lưu Sưởng là Cung Trừng Khu và người vợ thứ 33 họ Đặng liên danh quyên tiền đúc tháp. Hình thức cùng quy mô giống như Đông thiết tháp (trên thực tế thì Đông thiết tháp phỏng chế theo Tây thiết tháp), xung quanh thân tháp là tượng Phật và điêu khắc bảo liên hoa. Trong thời kháng chiến, tháp điện bị sụp đổ 4 tầng trên, hiện chỉ còn 3 tầng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Hiển", "definition": "Rõ ràng, rạng rỡ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Hiểu", "definition": "Ánh sáng ban mai, ví dụ ánh sáng trí tuệ của Phật có công năng phá dẹp phiền não vô minh, giống như ánh sáng ban mai xua tan bóng đêm dày đặc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Hoa", "definition": "光華. Rực rỡ đẹp đẽ Vẻ vang rực rỡ. Như: Vinh hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Hoạt", "definition": "光滑. Trơn bóng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Huy", "definition": "光輝. Rực rỡ chói lọi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Học", "definition": "光學. Ngành nghiên cứu về ánh sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Luân", "definition": "Vầng hào quang của Phật tròn trịa như bánh xe.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Lâm", "definition": "光臨. Tới và đem ánh sáng tới. Tiếng tôn xưng người trên tới thăm mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Lãng", "definition": "光浪. Làn sóng ánh sáng. Sự rung động của ánh sáng trong không khí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Lộc", "definition": "光祿. Danh hiệu ban cho vị quan trông coi việc ăn uống của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Lộc Tự", "definition": "光祿寺. Nơi lo việc ăn uống cho vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Man Thiên Tử", "definition": "Một trong 5 vị Thiên Tử (Tự Tại Thiên Tử, Phổ Hoa Thiên Tử, Quang Man Thiên Tử, Ý Sinh Thiên Tử, Biến Âm Thiên Tử) ở cõi trời Ngũ Tịnh Cư của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Mang", "definition": "光芒. Tia sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Minh", "definition": "Prabhāsvara (S), Pabhasa (P) Jvāla (S), Halo (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Bản Tôn", "definition": "Cũng gọi Quang Minh Bản, Hội Hệ Đồ. Bức tranh vẽ theo Mạn Đồ La: Trong ánh sáng của Phật A Di Đà (Bản Tôn), lấy danh hiệu Di Đà làm trung tâm, chung quanh vẽ Phật, Bồ Tát hoặc tượng các vị Tổ Sư của Tông Tịnh Độ để biểu thị sự truyền thừa của Tịnh Độ Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Chiếu", "definition": "Xem Địa Tạng Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Chân Ngôn", "definition": "Gọi đủ: Bất Không Đại Quán Đính Quang Chân Ngôn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Chân Ngôn Mạn Đồ La", "definition": "Cũng gọi Quang Minh Chân Ngôn Phá Địa Ngục Mạn Đồ La.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Chân Ngôn Pháp", "definition": "Cũng gọi Quang Minh Cúng, Quang Ngôn Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Chính Đại", "definition": "光明正大. Rõ ràng sáng sủa, to lớn đàng hoàng, không có gì ẩn giấu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Minh Cõi", "definition": "Avabhāṣā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Danh Hiệu Nhân Duyên", "definition": "Gọi tắt: Quang Hiệu Nhân Duyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Giáo", "definition": "Mithraism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Kinh", "definition": "Một bộ Kinh Đại thừa, thuyết minh lý Không. Có năm bản Hán dịch tất cả. Bản dịch xưa nhất là của Đàm Vô Sấm đời Bắc Lương, lấy tên kinh là Quang Minh Kinh. Ba bản dịch khác cũng dùng tên Kinh này. Riêng bản dịch của sư Nghĩa Tịnh đời nhà Đường, lấy tên Kinh là “Kim Quang Minh Tối Thắng Vương Kinh”.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quang Minh Như Lai", "definition": "Ramiprabhāsa Tathāgatha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Niệm Tụng", "definition": "Một trong 5 cách thức niệm tụng. Hành Giả niệm tưởng vừng trăng tâm của mình trong ngoài đều thanh tịnh, nhờ đó mà phát ra hơi thở, dù thành tiếng hay không thành tiếng, miệng đều có quang minh mà trì tụng danh hiệu Phật hoặc Chân Ngôn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Sơn", "definition": "Potalaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Trang Nghiêm", "definition": "Light Bright Adornment", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Quang Minh Tâm Điện", "definition": "Gọi đủ: Bản Hữu Kim Cương Giới Tự Tại Đại Tam Muội Da Tự Giác Bản Sơ Đại Bồ Đề Tâm Phổ Hiền Mãn Nguyện Bất Hoại Kim Cương Quang Minh Tâm Điện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Tạng", "definition": "Kho báu ánh sáng, tức chỉ cho thân Như Lai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Tự", "definition": "(光明寺, Kōmyō-ji): ngôi chùa trung tâm của Tây Sơn Tịnh Độ Tông, tên chính thức là Báo Quốc Sơn Niệm Phật Tam Muội Viện (報國山念佛三昧院光明寺), tên gọi riêng là Túc Sanh Quang Minh Tự (粟生光明寺); hiệu núi là Báo Quốc Sơn (報國山); hiện tọa lạc tại Aō (粟生), Nagaokakyō-shi (長岡京市), Kyōto-fu (京都府); được xem như là nơi phát xuất của Tịnh Độ Tông Nhật Bản. Tượng thờ chính của chùa là A Di Đà Như Lai. Vào năm 1198, Hùng Cốc Trực Thật (熊谷直實, tức Liên Sanh Phòng [蓮生房]), kiến lập nên đường vũ ở vùng đất Túc Sanh (粟生, Aō) này, và mời Pháp Nhiên đến làm Tổ khai sơn chùa. Vào năm 1227, do vì đồ chúng của Duệ Sơn rắp tâm định phá hoại ngôi mộ của Pháp Nhiên được an táng trên đó, nên hài cốt của ông được dời về chùa này, rồi hành lễ trà tỳ, và tạo nên chỗ thờ mới ở đây. Sau đó, đến thời vị Tổ đời thứ 4 của chùa là Chứng Không (証空), thì trong quan tài bằng đá của Pháp Nhiên bỗng có ánh sáng kỳ lạ phát ra; nhân đó Tứ Điều Thiên Hoàng (四條天皇, Shijō Tennō) mới đặt tên chùa là Quang Minh Tự. Chứng Không vốn là cao đệ của Pháp Nhiên, là người có công lao trong việc đã lập ra được một dòng phái riêng gọi là Tây Sơn Phái (西山派) và lấy chùa này làm đạo tràng căn bản để truyền đạo. Đồng thời ông cũng là vị học Tăng của Thiên Thai Tông, nên đương thời cho dầu nơi đây là ngôi chùa của Tịnh Độ Tông, nhưng vẫn có làm lễ cầu đảo nguyện cầu tật bệnh tiêu trừ. Các ngôi đường xá của chùa đã trãi qua mấy lần bị hỏa hoạn cháy rụi, nhưng rồi cũng được phục hưng lại như cũ. Và các kiến trúc hiện tại là thuộc khoảng niên hiệu Khoan Diên (寛延, 1748-1751). Hiện chùa là nơi linh nghiệm thứ 16 của Pháp Nhiên trong số 25 khu vực trên toàn quốc. (光明寺, Kōmyō-ji): ngôi tự viện trung tâm của Trấn Tây Nghĩa Lục Phái (鎭西義六派) thuộc Tịnh Độ Tông, hiện tọa lạc tại số 6-17-19 Zaimokuza (材木座), Kamakura-shi (鎌倉市), Kanagawa-ken (神奈川縣); hiệu núi là Thiên Chiếu Sơn (天照山), Viện hiệu là Liên Hoa Viện (蓮華院). Tượng thờ chính là A Di Đà Như Lai. Vào năm 1243 (Khoan Nguyên [寛元] nguyên niên), Nhiên A Lương Trung (然阿良忠) của Phái Trấn Tây Nghĩa (鎭西義) được người chấp quyền chính quyền Mạc Phủ Liêm Thương lúc bấy giờ là Bắc Điều Kinh Thời (北條經時, Hōjō Tsunetoki) quy y theo; ông kiến lập ngôi Liên Hoa Tự (蓮華寺) ở Tá Giới Cốc (佐介谷) thuộc Liêm Thương, về sau đổi thành Quang Minh Tự. Bên cạnh đó, Lương Trung còn được sự hỗ trợ của Bắc Điều Thời Lại (北條時頼, Hōjō Tokiyori), lấy chùa này làm trung tâm bố giáo. Về sau, vị Tổ đời thứ 2, đệ tử của ông là Tịch Huệ Lương Hiểu (寂慧良曉), Tổ khai sáng Dòng Bạch Kỳ (白旗流), đã tạo cơ sở hạt nhân cho Phái Trấn Tây Nghĩa (鎭西義). Vào năm 1495 (Minh Ứng [明應] 4), vị Tổ đời thứ 8 là Trường Liên Xã Quán Dự Hựu Sùng (長蓮社觀譽祐崇) tiến hành trì tụng Tịnh Độ Tam Bộ Kinh và Dẫn Thanh Niệm Phật trong cung nội; nhờ vậy chùa được ban cho hiệu là ngôi chùa trung tâm của 6 phái vùng Quan Đông (關東, Kantō). Nhờ vậy, Quang Minh Tự hưng thịnh cao độ với tư cách là ngôi chùa Đàn Lâm của Tịnh Độ Tông; vào năm 1532 (Thiên Văn [天文] nguyên niên), dòng họ Bắc Điều ở Tiểu Điền Nguyên (小田原, Odawara) đã hạ lệnh cho chúng Nhất Hướng Môn Đồ (一向門徒) ở tiểu quốc Tương Mô (相模, Sagami) đến sát nhập làm tín đồ của chùa. Đến năm 1591 (Thiên Chánh [天正] 9), Đức Xuyên Gia Khang (德川家康, Tokugawa Ieyasu) cúng dường thêm đất đai và sau này đã xếp hạng chùa trở thành bậc nhất trong số 18 ngôi chùa Đàn Lâm vùng Quan Đông. Dưới thời đại Giang Hộ, vị thành chủ của vùng Diên Cương (延岡, Nobeoka) thuộc tiểu quốc Nhật Hướng (日向, Hyūga) là Nội Đằng Nghĩa Khái (內藤義概, Naitō Yoshimune) đã dời nhà thờ bài vị cũng như tháp bằng đá từ Linh Nham Tự (靈巖寺) vùng Giang Hộ đến chùa này. Hiện vẫn không xác định được niên đại chùa được di chuyển về vị trí hiện tại lúc nào. Chùa hiện còn lưu giữ một số bảo vật được xếp hạng quốc bảo có Đương Ma Mạn Trà La Duyên Khởi (當麻曼茶羅緣起); các bảo vật khác thuộc Tài Sản Văn Hóa Trọng Yếu như Tịnh Độ Ngũ Tổ Hội Truyện (淨土五祖繪傳), Đương Ma Mạn Trà La Đồ (當麻曼茶羅圖), Thập Bát La Hán Cập Tăng Tượng (十八羅漢及僧像), Tịnh Độ Ngũ Tổ Hội (淨土五祖繪), v.v. (光明寺, Kōmyō-ji): ngôi chùa trung tâm bổn sơn của Tịnh Độ Tông, hiệu là Thiên Chiếu Sơn Liên Hoa Viện (天照山蓮華院); tên chính thức là Thiên Chiếu Sơn Liên Hoa Viện Quang Minh Tự (天照山蓮華院光明寺); hiện tọa lạc tại số 6-17-19 Zaimokuza (材木座), Kamakura-shi (鎌倉市), Kanagawa-ken (神奈川縣). Tượng thờ chính là A Di Đà Như Lai. Vào năm 1240 (Nhân Trị [仁治] nguyên niên), vị chấp quyền đương thời là Bắc Điều Kinh Thời (北條經時, Hōjō Tsunetoki) đã kiến lập Liên Hoa Tự (蓮華寺) cho Thiền sư Nhiên A Lương Trung (然阿良忠); sau đó ông dời chùa về vị trí hiện tại, và đổi tên chùa là Quang Minh Tự. Có ký lục ghi rằng chùa được di chuyển vào năm 1243 (Khoan Nguyên [寛元] nguyên niên), nhưng vẫn chưa có xác chứng rõ ràng. Ngoài ra còn có thuyết cho rằng Liên Hoa Tự chính là Ngộ Chơn Tự (悟眞寺). Đến năm 1495, vào đời Quán Dự Hựu Sùng (觀譽祐崇), vị Tổ đời thứ 8 của chùa, ông được Hậu Thổ Ngự Thiên Hoàng (後土御門天皇) quy y theo, nên chùa được sắc phong thành ngôi Tổng Bản Sơn của Tịnh Độ Tông vùng Quan Đông, và từ đó trở đi chùa trở thành nơi bố giáo trung tâm Tông phái vùng Quan Đông. Ngoài ra chùa còn lưu giữ nhiều bảo vật như tượng ngồi Ký Chủ Thiền Sư (記主禪師), tượng ngồi Địa Tạng Bồ Tát bằng đá, Đương Ma Mạn Trà La Duyên Khởi (當麻曼荼羅緣起) 2 bức, truyện tranh Tịnh Độ Ngũ Tổ, tranh vẽ Quang Minh Đại Sư (光明大師), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quang Minh Vô Lượng Nguyện", "definition": "Cũng gọi Đắc Thắng Quang Minh Nguyện, Tự Thân Quang Vô Hạn Nguyện, Phật Quang Vô Hạn Lượng Nguyện, Quang Sắc Nguyện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Đại Phạm", "definition": "Djyotichprabhā-Brahma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Minh Đại Sư", "definition": "Danh hiệu tặng sư Thiện Đạo, một danh tăng đời nhà Đường (dưới triều vua Đường Cao tông).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quang Minh Đồng Tử Nhân Duyên Kinh", "definition": "Cũng gọi Phật Thuyết Quang Minh Đồng Tử Nhân Duyên Kinh, Quang Minh Đồng Tử Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Minh Độ", "definition": "Độ là cõi đất. Một tên gọi khác của cõi Cực Lạc phương Tây nơi Phật A Di Đà đang giáo hóa chúng sinh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quang Mục", "definition": "光 穆. Thiền tăng đời Đường, họ Chương, tự Dật Thế, hiệu Tây Tháp, người Cao An, Giang Tây, Trung Quốc. Sư nối pháp thiền sư Huệ Tịch, thuộc tông Quy Ngưỡng đời thứ 3. Sau khi thầy tịch, sư kế tiếp trụ trì Ngưỡng Sơn. Sư dùng 36 phép đối của Lục Tổ để tiếp dẫn thiền cơ, hết sức tuyệt vời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Mục Nữ", "definition": "Tiền thân của Bồ Tát Địa Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Nghi", "definition": "光儀. Vẻ mặt sáng sủa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Nghiêm Bồ Tát", "definition": "Prabhāvyūha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Ngoa", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Nguyên", "definition": "光源. Nguồn phát ánh sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Nhân Thiên Hoàng", "definition": "(光仁天皇, Kōnin Tennō, tại vị 770-781): vị Thiên Hoàng sống vào cuối thời kỳ Nại Lương, hoàng tôn của Thiên Trí Thiên Hoàng (天智天皇, Tenji Tennō), con thứ 6 của Thân Vương Thí Cơ (施基, Shiki), tên là Bạch Bích (石壁, Shirakabe). Ông được nhóm Đằng Nguyên Bách Xuyên (藤原百川, Fujiwara-no-Momokawa) đưa lên cầm quyền, cho mời Hòa Khí Thanh Ma Lữ (和氣清麻呂, Waki-no-Kiyomaro) về để thực hiện chính sách cải cách.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quang Phạn", "definition": "侊飯. Bữa cơm nhiều đồ ăn ngon, thịnh soạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Phỏng", "definition": "光 訪. (Từ tôn kính để gọi) những người khách đến thưa hỏi. Tiết Chính Pháp Hy Minh Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Phục", "definition": "光復. Dựng lại được nghiệp cũ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Thái", "definition": "光彩. Nhiều màu rực rỡ chói lọi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Thế Âm Ứng Nghiêm Kí", "definition": "Tác phẩm, 1 quyển, do cư sĩ Phó Lượng soạn vào đời Lưu Tống thuộc Nam Triều. Hiện nay, tại Trung Quốc, sách đã thất lạc, nhưng Viện Thanh Liên ở Kyoto, Nhật Bản, còn giữ được bản chép tay vào giữa thời kì Liêm Thương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Trung", "definition": "光中. Hiệu của Nguyễn Huệ, vua nhà Tây Sơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Tráng", "definition": "光 壯. Hoằng dương, làm cho vinh quang rạng rỡ. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Trạch", "definition": "光澤. Trơn láng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Trạch Tứ Thừa", "definition": "光宅四乘 (Hoa Nghiêm Kinh Sớ. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quang Trạch Tự", "definition": "I.Quang Trạch Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Trạng Nguyên", "definition": "光 狀 元. Biệt hiệu của Thiền tăng Di Quang đời Tống. X. Di Quang.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Tuyến", "definition": "光線. Tia sáng. Đường ánh sáng đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Tán Bát Nhã Ba La Mật Kinh", "definition": "Cũng gọi Quang Tán Ma Ha Bát Nhã Kinh, Quang Tán Kinh, Quang Tán Bát Nhã Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Tướng", "definition": "Cũng gọi Quang Minh Tướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Tướng Bồ Tát", "definition": "Prabhāketu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Tướng Tự", "definition": "Chùa ở trên chót đỉnh núi Đại Nga, phía tây nam huyện Nga Mi, tỉnh Tứ Xuyên, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Tọa", "definition": "Cũng gọi Quang Phu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Tộ", "definition": "Kuang-tsu (C), Guangzi (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Tụ Phật Đính", "definition": "Phạm: Tejoràzyuwịìwa hoặcUwịìwatejoràzi.Hán âm: Đế Nho Ra Thi U Sắt Ni Sái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Tụ Phật Đảnh", "definition": "Tejorāśi (S), Uṣnīṣatejorasi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Tụ Phật Đảnh Luân Vương", "definition": "Xem Quang Tụ Phật Đảnh Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Tụ Tán Cái Phật Đảnh Bồ Tát", "definition": "Tejorāśyusnisaḥ (S), Usnisatejorasi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Tự", "definition": "光 緒. Thiền tăng đời Ngũ Đại, tham vấn Huyền Sa Sư Bị và đắc pháp. Khi ra hoằng pháp ở viện Vân Phong, núi Thiên Thai. Ngô Việt Vương rất hậu đãi sư, ban cho hiệu “Chí Đức Đại Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Vinh", "definition": "光榮. Vẻ vang rực rỡ. Cũng nói: Vinh quang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Viễn", "definition": "Quang Viễn (1149-1241). Cao tăng Trung Quốc sống vào đời Nam Tống, người Định Hải, Tứ Minh (Trấn hải, Chiết Giang) họ Phương, tên Thiện Nguyệt, hiệu Bá Đình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Vân", "definition": "Mây ánh sáng. Ví dụ quang minh của Phật. Mây có khả năng tưới mưa thấm nhuần giúp ích cho vạn vật, giống như ánh sáng làm lợi cho muôn loài, bởi thế dùng mây ví dụ cho quang minh của Phật. Kệ tán A Di Đà Phật (Đại 47, 421 thượng) nói: “Quang vân vô ngại như hư không", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Võng Bồ Tát", "definition": "Jaliniprabhākumarā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Võng Đồng Tử", "definition": "Quang Võng, Phạm: Jàlinì-prabha (Hán âm: Chế Lị Ni Ba La Bà), hoặc Prabhajàla (Hán âm: Ba Ra Bà Xà La).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Xúc", "definition": "Ánh sáng của Phật tiếp xúc và chiếu rọi thân hành giả.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang là ánh sáng của mặt trời, Minh là ánh sáng của mặt trăng, của các ngôi sao, và của các vật khác. Quang và Minh là 2 sắc trong 12 hiển sắc. Quang có 2 màu vàng và đỏ; Minh có 4 màu xanh, đỏ, vàng, trắng. [X. Luận Đại Tì Bà Sa Q.13; Luận Thuận Chính Lí Q.1]. (xt. Hiển Sắc).", "definition": "II.Quang Minh. Phạm: Prabhà. Cũng gọi Quang.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Âm", "definition": "光陰. Ánh sáng và bóng tối, chỉ ngày và đêm, chỉ thời gian. Bản dịch Chinh phụ ngâm khúc có câu: “Nghĩ nhan sắc đương chừng hoa nở, Tiếc quan ân lần lữa gieo qua”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Âm Cung", "definition": "Ābhāsvara-vimāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Âm Thiên", "definition": "Trời Quang-âm - Abhas-vara): là tầng trời cao nhất của cõi trời Nhị-thiền, thuộc cõi Sắc. Thiên chúng ở cõi trời này không còn dùng âm thanh, khi muốn nói thì từ miệng phát ra ánh sáng trong sạch (tức ánh sáng do tâm định mà có) để truyền ý cho nhau biết. Thân tướng họ cao lớn tốt đẹp, tự nhiên có ánh sáng. Họ lấy niềm vui làm thức ăn, luôn an trú trong an lạc, có thần thông, sống đến tám đại kiếp. Khi tai nạn lửa thiêu hủy đến cõi Sơ-thiền, tất cả chúng sinh ở hạ giới đều tụ tập hết về ở cõi trời này, đợi cho đến sau khi thế giới hình thành trở lại. Đến buổi đầu của kiếp Thành, mây phát khởi từ cõi trời này, đổ mưa lớn xuống để tạo nên thế giới, từ cõi trời Sơ-thiền cho đến Địa-ngục. Khi thế giới đã làm thành, các thiên chúng ở cõi trời này, phước đức đã gần hết, dần dần hạ sinh. Đây chỉ nói về thời kì hỏa tai mà thôi. Nếu ở thời kì thủy tai và phong tai thì cõi trời này cũng bị hủy diệt. Lúc đó thì phải từ cõi trời cao hơn nữa, nổi mây đổ mưa, sáng tạo thế giới. Kinh Tăng Nhất A Hàm và luận Câu Xá đều nói rằng, con người ở thế giới Ta-bà này, buổi ban sơ, chính là thiên chúng từ cõi trời Quang-âm hạ giáng, bị mất thần túc, không trở về được, nên đã ở lại, trở thành lớp người đầu tiên ở thế gian.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quang Âm Thiên Cõi", "definition": "Ābhassaraloka (P), Realm of the Radiant Gods.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quang Đài Hiện Độ", "definition": "Trong đài vàng hiện ra Tịnh Độ. Quang đài là đài vàng do hào quang của Phật hóa hiện ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Đãng", "definition": "光蕩. Thưa trống sáng sủa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Đại", "definition": "光大. Sáng sủa rộng lớn Chỉ việc làm ngay thẳng, không ẩn giấu gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Đầu Tử", "definition": "光頭子. Người đầu láng bóng, chỉ ông sư (vì đầu cạo nhẵn bóng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Đế Phốc Đầu", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quang Định", "definition": "(光定, Kōjō, 779-858): vị tăng của Thiên Thai Tông Nhật Bản, sống dưới thời đại Bình An, xuất thân vùng Y Dư (伊予, Iyo, thuộc Ehime-ken [愛媛縣]), họ là Chí (贄). Ông sớm mất cha mẹ, sau vào trong núi sâu tự tu trai giới một mình. Theo lời khuyên của vị tăng Cần Giác (勤覺), ông lên kinh đô Kyoto, và năm 808 thì làm đệ tử của Tối Trừng. Năm 810, ông xuất gia và 2 năm sau thì thọ giới Cụ Túc ở Đông Đại Tự (東大寺, Tōdai-ji). Vào năm 814, ông ngao du vùng Nam Đô, luận tranh với Nghĩa Diên (義延, Gien) của Diên Lịch Tự (延曆寺, Enryaku-ji) và nêu cao tông nghĩa của mình. Ông đóng vai trò rất lớn trong việc lãnh đạo giáo đoàn sau khi Tối Trừng qua đời. Vào năm 838, ông được giao cho làm chức Truyền Đăng Pháp Sư và đến năm 854 thì được cử làm chức Biệt Đương (別當, Bettō, chức Tăng Quan thống lãnh tăng chúng và quản lý mọi việc ở các chùa lớn) của Diên Lịch Tự, cho nên ông thông xưng là Biệt Đương Đại Sư (別當大師). Trước tác của ông có Truyền Thuật Nhất Tâm Giới Văn (傳述一心戒文).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quang Độ", "definition": "光度. Mức mạnh yếu của ánh sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quang Đức", "definition": "Light Virtue", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Quang Ảnh", "definition": "光 影. Bóng sáng, dụ chỉ vật hư huyễn chẳng thật. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Ảnh Lý Hoạt Kế", "definition": "光 影 裏 活 計. Chỉ cho hành vi, ngôn ngữ, tình thức hư vọng. Tiết Dục vương Đoan Dụ Thiền Sư trong NĐHN q. 19 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quang Ảnh Môn Đầu", "definition": "光 影 門 頭. Sự lý hư huyễn chẳng thật. Thư đáp Trịnh Côn Nham Trung thừa trong HSLNMDT q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quanh Co", "definition": "Vellita (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quanh Quẩn", "definition": "Bhamati (bham + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quantum", "definition": "Quantity, amount", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quantum physics", "definition": "Vật lý lượng tử", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quash", "definition": "Tuyên bố hết hiệu lực; huỷ bỏ, bát bỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quay", "definition": "Āvaṭṭati (ā + vaṭṭ + a), vivaṭṭeti (vi + vaṭṭ + e), vivaṭṭana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quay Lại", "definition": "Apagacchati (apa + gam + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quay Tròn", "definition": "Parivattaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quay Về Phía Sau", "definition": "Paṭivattiya (tính từ), paṭivatteti (paṭi + vat + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quay Xung Quanh", "definition": "Āvijjhati (ā + vidh + ya), āvijjhana (trung), vaṭṭati (vaṭṭ + a), vaṭṭana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quán Thủ", "definition": "(貫首, Kansu hay Kanzu): tiếng kính xưng các vị trú trì các ngôi chùa tổ hay đại tự của các tông phái", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quản Nguyên Đạo Chơn", "definition": "(菅原道眞, Sugawara Michizane, 845-903): còn gọi là Quản Công (菅公, Kankō) hay Quản Thừa Tướng, nhà quý tộc, học giả sống đầu thời Bình An, con của Thị Thiện (是善). Ông đã từng làm việc cho Vũ Đa Thiên Hoàng (宇多天皇), được tín nhiệm, và trải qua các chức như Văn Chương Bác Sĩ, Tạng Nhân Đầu, Tham Nghị, v.v. Vào năm 894, ông được cử làm sứ thần sang nhà Đường, nhưng ông lại kiến nghị phế bỏ việc ấy. Đến thời Đề Hồ Thiên Hoàng (醍醐天皇), ông làm chức Hữu Đại Thần, nhưng vào năm 901 ông bị lưu đày đến Thái Tể Phủ do lời sàm ngôn của Đằng Nguyên Thời Bình (藤原時平), và qua đời tại đó. Chính ông biên tập ra bộ Loại Tụ Quốc Sử (類聚國史), cùng tham gia soạn bộ Tam Đại Thật Lục (三代實錄). Thi văn của ông được thâu tập vào trong Quản Gia Văn Thảo (菅家文草), Quản Gia Hậu Tập (菅家後集). Chính vì sau khi ông qua đời có nảy sinh ra nhiều chuyện quái dị, nên vong linh của ông được tế nơi Bắc Dã Thiên Mãn Cung (北野天滿宮), về sau ông được tôn sùng như là vị thần của học vấn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Que Cứt Khô", "definition": "Càn thỉ quyết 乾屎橛. Đời Đường, thiền sư Tuyên Giám (782-865) ở thiền viện Đức-sơn, Lãng-châu, một hôm lên giảng đường nói: “Ta ở nơi đây, Phật cũng không, pháp cũng không, Đạt Ma là lão mọi hôi hám, Bồ-tát Mười-địa là kẻ gánh phân, Đẳng-giác và Diệu-giác là phàm phu phá giới, bồ đề niết bàn là cây cột buộc lừa, mười hai phần giáo là sổ ghi tên người chết, là giấy lau ghẻ, Phật là lão mọi chùi nhà xí.” Mặt khác, có vị tăng hỏi thiền sư Văn Yển (864-946) ở núi Vân-môn, Thiều-châu rằng: “Phật là thế nào?” Sư đáp: “Que Cứt Khô.” Sư cũng từng nói: “Thích Ca lúc mới sinh, một tay chỉ trời, một tay chỉ đất, đi quanh bảy bước, mắt ngó bốn phương, nói rằng trên trời dưới trời chỉ riêng ta là tôn quí nhất, lão tăng này lúc đó nếu thấy, một bổng đánh chết đem cho chó ăn, may ra thiên hạ thái bình.” Những lời trên đều nhằm thức tỉnh người đời: phàm hễ có hình tướng thì đều là hư vọng; dù là kinh điển, tượng Phật, hoặc thánh, hoặc hiền, đã rơi vào hình tích thì đều thuộc trong vòng sinh diệt, hoàn toàn không phải là đạo như thật chân thường.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quell", "definition": "Dập tắt (Quell all greed, jealousy and ignorance = dặp tắt tham, sân, đố kỵ và si mê)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quen", "definition": "Santhava (nam), paricaya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quen Thuộc", "definition": "Paguṇa (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quench", "definition": "Đáp ứng (Unquenchable = không thể thỏa mãn)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Querulous", "definition": "Hay than phiền, hay càu nhàu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Qui", "definition": "(Rùa). Nakka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Qui Bất Thận Ngôn", "definition": "Rùa không giữ gìn lời nói, ví dụ phàm phu ngu si thường vì không thận trọng lời nói nên gặp tai họa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Gia Ổn Tọa", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Kính Tự", "definition": "Cũng gọi Qui Kính Văn, Qui Kính Kệ. Chỉ cho phần văn từ bày tỏ lòng qui y kính lễ Tam Bảo Thường đặt ở đầu Kinh, Luật, Luận trong 3 tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Mao Thố Giác", "definition": "Lông rùa sừng thỏ. Rùa vốn không có lông, thỏ cũng chẳng có sừng, nhưng vì rùa bơi trong nước, rong rêu bám vào mình rùa, người đời nhìn vào nhận lầm rong rêu là lông rùa, cũng như nhận lầm 2 cái tai thỏ dỏng lên là sừng thỏ. Bởi thế các kinh luận thường dùng từ ngữ “lông rùa sừng thỏ” để ví dụ những sự vật chỉ có tên chứ không có thực, hoặc vật hoàn toàn không có trong thực tế; cũng tức là phàm phu, vì vọng chấp mà nhận lầm có thực ngã, thực pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Mênh Tận Thập Phương Vô Ngại Quang Như Lai", "definition": "Tận Thập Phương Vô Ngại Quang Như Lai là 1 trong các đức hiệu của Phật A Di Đà. Vì ánh sáng của Phật A Di Đà chiếu soi khắp các quốc độ trong 10 phương mà không bị ngăn ngại, nên đức ánh sáng ấy của Ngài được gọi là Tận Thập Phương Vô Ngại Quang. Ý nói ánh sáng của Đức Phật A Di Đà không bị người và pháp làm chướng ngại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Mạng", "definition": "Xem Nam Mô.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Mạng Hiệp Chưởng", "definition": "Prāṇama (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Mệnh Bình Đẳng Chư Phật", "definition": "Namaḥ Samanta Buddhānām (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Mệnh Hợp Chưởng", "definition": "Phạm: Praịàma", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Mệnh Tam Bảo", "definition": "Xem Quy Mạng Tam Bảo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Mệnh Đính Lễ.", "definition": "Cũng gọi Qui Mệnh Lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Nguyên", "definition": "Cũng gọi Qui Hóa, Qui Chân, Qui Tịch, Qui Bản, Qui Không, Qui Khứ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Ngưỡng", "definition": "Bhakti (S), Surrender to.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Ngưỡng Du Già", "definition": "Bhakti-yogā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Ngưỡng Luận", "definition": "Bhakti-śāstras (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Ngưỡng Tông", "definition": "Tông Qui Ngưỡng : là một trong “năm nhà bảy tông” của Thiền Tông Trung-quốc, thuộc pháp hệ của ngài Nam Nhạc Hoài Nhượng. Tông này do hai ngài Qui Sơn Linh Hựu (771-853) và Ngưỡng Sơn Tuệ Tịch (807-883) làm tổ khai sáng, và lấy hai chữ “Qui” và “Ngưỡng” ghép lại làm tên. Ngài Linh Hựu (đệ tử đắc pháp của thiền sư Bách Trượng Hoài Hải) hoằng dương thiền pháp ở núi Qui-sơn (huyện Trường-sa, tỉnh Hồ-nam); đệ tử của ngài là Tuệ Tịch kế thừa tông phong, hoằng dương thiền pháp tại núi Ngưỡng-sơn (huyện Nghi-xuân, tỉnh Giang-tây). Tông này rất hưng thịnh trong khoảng cuối thời Đường sang thời Ngũ-đại, tính ra chừng 150 năm, đến đời Tống thì dần dần mai một; cuối cùng thì nhập vào tông Lâm Tế.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Qui Ngưỡng Đạo", "definition": "Bhakti mārga (S), The path of Bhakta.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Nội Cúng Dường", "definition": "Cũng gọi Nhập Nội Cúng Dường. Phụng thỉnh cúng dường Phật, Bồ Tát trong cung đình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Sơn", "definition": "Cũng gọi Qui Tự, Qui Viện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Sơn Cảnh Sách", "definition": "Gọi đủ: Qui Sơn Đại Viên Thiền Sư Cảnh Sách.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Sơn Linh Hựu", "definition": "(771-853): là vị Sơ-tổ của tông Qui Ngưỡng, một trong “năm nhà bảy tông” của Thiền Tông Trung-quốc. Ngài họ Triệu, pháp danh Linh Hựu, quê ở huyện Hà-phố, tỉnh Phúc-kiến; xuất gia từ lúc15 tuổi. Sau khi thọ đại giới, ngài đi các nơi cầu học với nhiều bậc cao đức, đến năm 23 tuổi thì đến Giang-tây tham yết thiền sư Bách Trượng Hoài Hải, trở thành vị đệ tử thượng thủ và kế thừa pháp hệ của Bách Trượng. Khoảng năm 50 tuổi, ngài lên ở núi Qui-sơn tại Đàm-châu (tỉnh Hồ-nam), dân chúng trong vùng cảm mộ cao đức của ngài, bèn cùng nhau đóng góp xây chùa, được vua ban sắc đặt tên là chùa Đồng-khánh. Từ đó chùa trở thành một đạo tràng nổi tiếng, tứ chúng vân tập tu học đông đảo, cả các quan trong triều đình cũng thường đến hỏi đạo. Trong thời gian xảy ra pháp nạn Hội-xương (841-846), ngài ẩn lánh trong đám dân thương buôn. Khi Phật giáo được phục hoạt (từ  năm 847), đồ chúng lại thỉnh ngài trở về chùa cũ. Ngài cư trú ở núi Qui-sơn cả thảy 40 năm, được người đời xưng là Qui Sơn Linh Hựu. Ngài thị tịch vào năm 853 (dưới triều vua Đường Tuyên-tông), thế thọ 83 tuổi, thụy hiệu là Đại Viên thiền sư.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Qui Sơn Linh Hựu Thiền Sư Ngữ Lục", "definition": "Gọi đủ: Đàm Châu Qui Sơn Linh Hựu Thiền Sư Ngữ Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Sơn Tam Chủng Sinh", "definition": "Ba thứ cơ pháp do ngài Qui Sơn Linh Hựu đặt ra để dắt dẫn người học chứng được Đại Viên Kính Trí mà đạt đến cảnh giới tự tại vô ngại.Ba thứ cơ pháp ấy là.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Sơn Tông", "definition": "Igyō-shū (J)Kuei-yang tsung (C), Igyo-shu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Trình Tường Tham", "definition": "Xoay ánh sáng chiếu rọi trở vào để tham cứu mày mặt xưa nay của chính mình. Đây là yếu cơ của sự tu hành tinh tiến sau khi đã triệt ngộ để giữ gìn Phật đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tàng Lục", "definition": "Rùa giấu 6 chi (đầu, đuôi và 4 chân) vào trong mai.Cứ theo Kinh Pháp Cú Thí Dụ quyển 1: Thuở xưa, có 1 đạo nhân tu đạo dưới gốc cây bên sông, nhưng trong 12 năm mà vẫn chưa trừ được vọng niệm, 6 căn tham nhiễm không dừng, khó có thể vào đạo, Đức Phật liền hóa làm vị sa môn đến độ cho đạo nhân này, Ngài dùng hình ảnh con rùa thu rút đầu, đuôi và 4 chân giấu vào trong mai để bảo vệ mệnh sống, ví dụ cho chúng sinh thu nhiếp 6 căn: Mắt, tai, mũi, lưỡi, thân ý không để cho 6 trần: Sắc, thanh, hương, vị, xúc, pháp bên ngoài làm nguy hại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tính", "definition": "Trở về chân tính, nghĩa là thu nhiếp tất cả sự tướng hữu vi đưa về chân như thực tính.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tông Trí Thường", "definition": "Kishō Chijō (J), Kisu Chijo (J), Wei tsung Chih Chang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Tông Trảm Xà Nhân Duyên", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tông Tự", "definition": "Chùa ở chân núi nam Lô Sơn, huyện Tinh Tử, tỉnh Giang Tây, Trung Quốc. Ngôi chùa này do Hữu Tướng quân Vương Hi Chi phá bỏ nhà cũ của mình để xây cất chùa vào năm Hàm Khang thứ 6 (340) đời Đông Tấn, cúng dường Tam Tạng Phật Đà Da Xá. Khoảng Năm Nguyên Hòa (806-820) đời Đường, Thiền Sư Trí Thường lại xây dựng thêm. Các văn nhân như Bạch Lạc Thiên, Vương Bột... cũng thường đến hỏi đạo. Về sau, chùa trở thành Thiền Viện. Năm Thái Bình Hưng Quốc thứ 9 (984) đời Tống, ngài Đạo Thuyên làm Trụ Trì, đạo, tục qui tụ rất đông, môn phong phát đạt. Sau, các ngài Khắc Văn, Chính Hiền, Đàm Hoa, Tuệ Nam... nối nhau trụ trì, chùa trở thành một Đại đạo tràng của Thiền gia. Hiện nay, các kiến trúc trong chùa như Đại Hùng Bảo Điện, Tì Lô Điện, Thiên Vương Điện... vẫn còn đầy đủ. Sân chùa có đài lư hương kiểu đời Tống, trên đỉnh núi phía sau chùa tương truyền có tháp Xá Lợi do ngài Phật Đà Da Xá kiến tạo, cảnh trí rất thanh thoát. [X. Lương Cao Tăng Truyện Q.2; Tống Cao Tăng Truyện Q.17; Cảnh Đức Truyền Đăng Lục Q.7, 20, 23, 26; Cổ Kim Đồ Thư Tập Thành Phương Chức điển thứ 870; Sơn Xuyên điển thứ 138].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tư", "definition": "(Cưu Tư). Phạm: Kucìna.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tục", "definition": "Người xuất gia không phạm tội lỗi mà tự nguyện trở về với đời sống thế tục, gọi là Qui tục, còn người vì phạm giới cấm mà bị đuổi về đời thì gọi Hoàn tục. Tuy nhiên, qui tục vàhoàn tục cũng có khi bị dùng lẫn lộn. [X. môn Tội Trách trong Thiền Lâm Tượng Khí Tiên]. (xt. Hoàn Tục).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Tự", "definition": "(862-936).Cao tăng Trung Quốc sống vào cuối đời Đường đầu thời Ngũ Đại, người ở Thọ xuân, (huyện Thọ, tỉnh An Huy), họ Mi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Qui Y", "definition": "Xem Nam Mô, Xem Quy Y.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Qui Ước", "definition": "Xem Thế Tục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quibble", "definition": "Ý kiến phản đối, chỉ trích", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quiescence", "definition": "Become quiet = sự yên lặng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quintessence", "definition": "Tinh chất, tinh túy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quirk", "definition": "Thói quen, trường hợp ngẫu nhiên (Quirky - lắm mưu mô, giỏi ngụy biện)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Quy", "definition": "𠁴. Như chữ Quy 龜.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Bản", "definition": "龜板. Vỏ rùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Bốc", "definition": "龜卜. Bói toán bằng vỏ rùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Bối", "definition": "龜背. Cong (như hình mui rùa).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Bổn", "definition": "Bổn là gốc. Trở về cái gốc. Ý nói trở về mầm giác (trí tuệ Bát Nhã vốn có đầy đủ ở trong mình).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Canh", "definition": "歸耕. Trở về cày ruộng, chỉ sự từ quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Chân", "definition": "歸真. Trở về với con người thật của mình Tiếng nhà Phật, chỉ sự chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Chính", "definition": "歸政. Trả lại quyền trị nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Chơn", "definition": "(歸眞): quay trở về với chân như bản tánh, trả lại trạng thái xưa nay, tức Niết Bàn (s: nirvāṇa, p: nibbāna, 涅槃); cho nên đức Phật cũng như chư Tổ sư viên tịch cũng gọi là quy chơn. Về sau, từ này cũng được dùng phổ cập cho các cao tăng, tu sĩ Phật Giáo khi qua đời; đồng nghĩa với quy tịch (歸寂). Như trong Thích Thị Yếu Lãm (釋氏要覽, Taishō Vol. 54, No. 2127) quyển Hạ, phần Tống Chung (送終), giải thích rõ rằng: “Thích thị tử, vị Niết Bàn, viên tịch, quy chơn, quy tịch, diệt độ, thiên hóa, thuận thế, giai nhất nghĩa dã; tùy tiện xưng chi, cái dị tục dã (釋氏死、謂涅槃、圓寂、歸眞、歸寂、滅度、遷化、順世、皆一義也、隨便稱之、蓋異俗也, dòng họ Thích [tu sĩ] qua đời, gọi là Niết Bàn, viên tịch, quy chơn, quy tịch, diệt độ, thiên hóa, thuận thế, đều cùng một nghĩa cả; tùy tiện mà gọi, vì khác với thế tục vậy).” Trong Tứ Giáo Nghi (四敎義, Taishō Vol. 46, No. 1929) quyển 1 cũng cho biết rằng: “Phù đạo tuyệt nhị đồ, tất cánh giả thường lạc, pháp duy nhất vị, tịch diệt giả quy chơn (夫道絕二途、畢竟者常樂、法唯一味、寂滅者歸眞, phàm đạo dứt hai đường, rốt cùng là thường lạc, pháp chỉ một vị, vắng lặng là về chơn).” Trong bài Đông Đô Phú (東都賦) của Ban Cố (班固, 32-92) nhà Hán có câu: “Toại linh hải nội khí mạt nhi phản bổn, bối ngụy nhi quy chơn (遂令海內棄末而反本、背僞而歸眞, bèn khiến cho trong nước bỏ ngọn mà tìm nguồn, dứt dối mà về chơn).” Hay trong Nam Nhạc Tổng Thắng Tập (南嶽總勝集, Taishō Vol. 51, No. 2097) quyển Hạ, phần Lương Song Tập Tổ (梁雙襲祖), lại có đoạn: “Hốt nhất nhật vị môn nhân viết: 'Ngô tương nhập thất chi hậu, nhược hữu thiên khí dị thường, tốc lai báo ngô.' Lạp nhật trung ngọ tứ khí trừng thanh, đệ tử báo chi, nhi sách mộc dục phần hương, tịch nhiên quy chơn (忽一日謂門人曰、吾將入室之後、若有天氣異常、速來報吾、翌日中午四氣澄清、弟子報之、而索沐浴焚香、寂然歸眞, Một hôm nọ, Tổ chợt bảo với môn nhân rằng: 'Sau khi vào trong thất rồi, nếu có khí trời khác thường, mau đến báo cho ta biết.' Vào giữa trưa hôm sau, bốn khí lắng trong, đệ tử báo cho ngài biết, Tổ bèn nhờ tắm rửa, xông hương, rồi lẳng lặng ra đi).” Trong bài Bảo Nguyệt Đại Sư Tháp Minh (寶月大師塔銘) của Tô Thức (蘇軾, 1037-1101) nhà Tống có câu: “Oánh nhiên Ma Ni, quy chơn thử độ (瑩然摩尼、歸眞於土, suốt trong Ma Ni, quy chơn cõi này).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Công", "definition": "歸功. Kể công lao của người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Cước", "definition": "龜脚. Một loại cây súng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Cầu", "definition": "規求. Tham lam, hay tìm kiếm lợi lộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Cốt", "definition": "歸骨. Đem xác người chết về chôn ở quê nhà.歹: Ngạt: Xương tàn, xương người chết lâu năm Tên một bộ chữ Trung Hoa, tức bộ Ngạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Củ", "definition": "規矩. Cái thước tròn và cái thước vuông của người thợ mộc. Chỉ phép tắc phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Cữu", "definition": "歸咎. Đổ lỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Doanh", "definition": "嫢盈. Giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Dương Hòa Thượng", "definition": "龜 洋 和 尚. Thiền tăng Vô Liễu đời Đường sau khi tham vấn Mã Tổ Đạo Nhất được pháp, kết am tranh ẩn tu ở núi Quy Dương, người đời gọi là Quy Dương Hòa Thượng. X. Vô Liễu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Gia", "definition": "龜家. Người làm mai mối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Gia Bãi Vấn Trình", "definition": "歸 家 罷 問 呈. Người đã về đến nhà thì không còn việc hỏi thăm đường sá nữa. Thiền Tông mượn từ này để chỉ một khi ngộ được tự tâm thì mọi việc dừng ngay lập tức, không còn câu nệ vào ngôn ngữ tri giải, các giai vị tu hành. Ngoạn Châu Ngâm của Đan Hà Hòa Thượng trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Gián", "definition": "規諫. Khuyên can.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hiểu", "definition": "歸 曉. Thiền đời Tống, sư đến núi Hàm Châu thờ Thiền Sư Thẩm Triết làm thầy rồi nối pháp ngài, làm truyền nhân của tông Tào Động. Sư ở viện Diên Khánh tại Tương Châu (nay là huyện Tương Phàn, tỉnh Hồ Bắc). Có vị tăng hỏi: Thế nào là cảnh Phong Sơn? Sư đáp: Hãy xem cho cẩn thận. Tăng hỏi tiếp: Thế nào là người trong cảnh? Sư đáp: Biết chăng? Thụy hiệu: Huệ Quảng Đại Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Hoàn", "definition": "歸還. Trở về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hoá", "definition": "歸化. Thay đổi lòng dạ mà xin theo về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hoạch", "definition": "規畫. Bàn định trù tính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hàng", "definition": "歸降. Chịu thua và xin theo về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hành Củ Bộ", "definition": "規行矩步. Đi theo cái thước tròn, bước theo cái thước vuông, ý nói hành động theo khuôn phép.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hóa", "definition": "龜貨. Đồ vật quý, đồng bạc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hưu", "definition": "歸休. Thôi việc về nhà. Ta thường nói: Về hưu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Hồi", "definition": "歸囘. Quay về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Kì", "definition": "歸期. Ngày trở về (nói về người đi xa) Ngày về nhà chồng (nói bề con gái).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Kính", "definition": "歸 敬. Quy y tôn kính. Tiết Long Tường Sĩ Khuê Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Linh", "definition": "龜齡. Sống lâu, tuổi thọ cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Liệu", "definition": "規料. Tính toán xếp đặt công việc. Đoạn trường tân thanh có câu: “Hãy về tạm phó giam ngoài. Dặn nàng quy liệu trong đôi ba ngày”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Luật", "definition": "規律. Phép tắc phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Lão", "definition": "歸老. Trở về nghĩ ngơi tuổi già, chỉ sự từ quan, hoặc về hưu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Lộ", "definition": "歸路. Đường về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Mao", "definition": "(龜毛): lông rùa. Cũng như sừng thỏ, lông rùa là vật không có thật, vì trời sinh con rùa không bao giờ mọc lông. Đại Trí Độ Luận (大智度論, Taishō Vol. 25, No. 1509) quyển 12 khẳng định rằng: “Hựu như thố giác, quy mao, diệc đản hữu danh nhi vô thật (又如兔角、龜毛、亦但有名而無實, lại như sừng thỏ, lông rùa, cũng chỉ có tên mà không thật).” Trong Ma Ha Chỉ Quán (摩訶止觀, Taishō Vol. 46, No. 1911) quyển 10 dạy rằng: “Nhân ngã như quy mao thố giác bất khả đắc (人我如龜毛兔角不可得, ta và người cũng như lông rùa sừng thỏ, không thể có được).” Hay trong Sở Thạch Phạn Kì Thiền Sư Ngữ Lục (楚石梵琦禪師語錄, 卍Tục Tạng Kinh Vol. 71, No. 1420) lại có câu: “Thiết ngưu bối thượng quát quy mao, thạch nữ yêu biên tài thố giác (鐵牛背上括龜毛、石女腰邊裁兔角, trên lưng trâu sắt tìm lông rùa, bên hông gái đá cắt sừng thỏ).” Hoặc trong Cẩm Giang Thiền Đăng (錦江禪燈, 卍Tục Tạng Kinh Vol. 85, No. 1590) quyển 12, phần Thượng Thư Huyễn Am Hồ Cư Sĩ (尚書幻菴胡居士), cũng có câu: “Thố giác trượng thiêu Hương Thủy hải, quy mao thằng phược Nga Mi sơn (兔角杖挑香水海、龜毛繩縛蛾眉山, gậy sừng thỏ khuấy biển Hương Thủy, thừng lông rùa cột núi Nga Mi).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Mao Thố Giác", "definition": "龜 毛 兔 角. Gọi tắt: Quy Mao. Lông rùa sừng thỏ là những vật chỉ có trên tên gọi. Thiền Tông thường dùng từ này để chỉ muôn vật đều hư huyễn không thật. Tiết Nghệ Ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Mô", "definition": "規模. Thước và khôn, chỉ phép tắc khuôn mẫu phải theo Chỉ cái kích thước, khuôn khổ thực hiện. Td: Đại quy mô (khuôn khổ rộng lớn), “Quy mô cũng rắp hỗn đồng”. (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Mạc", "definition": "規 摸. Noi theo, học tập. Tiết Hoàng Long Nam Thiền Sư trong TLTBT q. 22 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Mạng", "definition": "Xem Nam Mô.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Mạng Tam Bảo", "definition": "Namo-Ratna-trayāya (S), Namo Ratnatrayaya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Nghi", "definition": "規儀. Phép tắc lề lối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Nguyên", "definition": "Trở về nguồn gốc.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Nguyên Trực Chỉ", "definition": "Nhan đề bộ sách Phật rất có giá trị, nguyên văn chữ Hán, gồm nhiều bài khuyến tu, đốc tín của các bậc Thượng tọa, Đại đức ngày xưa soạn, cũng có các bài văn thâm trầm, thanh nhã của các vua quan ngày trước, thông Nho, giỏi Lão và một Phật viết.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Nguyên Trực Chỉ Tập", "definition": "(歸元直指集, Kigenjikishishū): 4 quyển, trước tác của Thiên Y Tông Bổn (天衣宗本, ?-?) nhà Minh, san hành vào năm thứ 32 (1553) niên hiệu Gia Tĩnh (嘉靖), trùng san vào năm thứ 4 (1570) niên hiệu Càn Long (乾隆) bản 2 quyển có lời tựa của Lộc Viên Cư Sĩ Vạn Biểu (鹿園居士萬表), là tập thâu lục 97 thiên gồm những thuyết xưa nay liên quan đến tư tưởng Thiền Tịnh Nhất Trí. Cuối quyển 2 có Tây Phương Bách Vịnh (西方百詠), cuối quyển 4 có Sơn Cư Bách Vịnh (山居百詠).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Nguyên Tự", "definition": "歸 元 寺. Đầu phía tây phố Thúy Vi, khu Hán Dương, thành phố Vũ Hán, tỉnh Hồ Bắc, Trung Quốc. Là một trong bốn đại tùng lâm ở Vũ Hán. Niên hiệu Thuận Trị thứ 15 (1658) đời Thanh Thiền Sư Đức Minh đời thứ 31 tông Tào Động lần lượt khởi công xây dựng Đại hùng bảo điện, Thiền đường, Khách đường, Trai đường đặt tên “Quy Nguyên Thiền Tự”, tên chùa lấy từ kinh Lăng Nghiêm: “Quy nguyên vô nhị lộ, phương tiện hữu đa môn”, tức là ý nghĩa phản bản hoàn nguyên, vạn pháp quy nhất. Niên hiệu Khang Hy thứ 3 (1664) cất thêm Tổ đường, Vi Đà điện, Phương trượng thất. Niên hiệu Khang Hy thứ 8 (1669) cất Lão trượng các, Chung cổ lâu. Niên hiệu Khang Hy thứ 13 (1674) xây thêm Quán Âm đường,Vân thủy đường, Nội ngoại liêu xá, Liêu viện, Tam Tổ tháp viện và Sơn môn. Niên hiệu Quang Tự thứ 9 (1883) khởi công, trải qua 9 năm mới xây xong La hán đường. Do chiến tranh nên chùa nhiều lần hủy nhiều lần xây. Kiến trúc hiện còn là nhờ được lần lượt xây dựng lại vào niên hiệu Đồng Trị thứ 3 (1864) đời Thanh, Quang Tự thứ 21 (1895) và đầu năm Dân Quốc. Trong chùa có những kiến trúc như Vi Đà điện, Đại hùng bảo điện, Thiên vương điện, Địa Tạng Vương điện, La hán đường, Tàng kinh các, Đại sĩ các. Đặc biệt có Thúy vi phong, Tiểu đình, Hoa đàn, bố cục nghiêm cẩn, thiết kế khéo léo; tuy là chùa Phật nhưng có đủ những gì đặc sắc của viên lâm. Trong chùa do vân tường phân cách làm ba viện Bắc viện, Trung viện, Nam viện. Mỗi viện đều có đình viện đặc sắc. Đại hùng bảo điện ở Trung viện thờ tượng Phật Thích Ca, hai bên là A Nan và Ca Diếp, phía sau là Quán Âm hải đảo. Trước tượng Phật là tấm mành phủ lên bàn thờ khắc họa những nhân vật trong Tây Du Ký như Đường Tăng, Tôn Ngộ Không, Trư Bát Giới, Sa Hòa Thượng. Tàng kinh các ở Bắc viện cao khoảng 25m, 2 tầng, 5 gian, phía trước có hành lang, cột tròn to lớn cao tới đấu củng, mái cong bốn lớp, bốn con phụng hướng về phía mặt trời sơn son thếp vàng rực rỡ. Ngoại trừ cất giữ Đại tạng kinh, còn cất giấu rất nhiều văn vật trân quý khác. La hán đường ở Nam viện bày ra hình chữ “Điền”, nội thất trưng bày 500 tượng La hán hiện đủ mọi dáng vẻ khởi phục tọa ngọa, hỉ nộ ai lạc, phong cách sống động, kỹ thuật điêu khắc cực kỳ tinh xảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Ngưỡng", "definition": "Adhigamāniya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Ngưỡng Tông", "definition": "Xem Qui Sơn Tông", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Ngục", "definition": "歸獄. Đổ tội cho người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Nhơn", "definition": "歸仁. Quay về với điều nhân đức Tên một tỉnh ở Trung phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Ninh", "definition": "歸寧. Con cái đã có chồng về nhà thăm cha mẹ. Đoạn trường tân thanh có câu: “Roi câu cừa gióng dăm trường, Xe hương nàng cũng thuận đường quy ninh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Nạp", "definition": "歸納. Một phương pháp suy luận, căng cứ vào những trường hợp riêng mà đi tới kết luận chung (Induction, danh từ Triết học).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Pháp", "definition": "Quy y giáo pháp do Phật dạy.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Phạm", "definition": "規範. Thước và khuôn, chỉ phép tắc khuôn mẫu phải theo Có tính cách khuôn phép bó buộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Phật", "definition": "皈佛. Trở về với Phật, ý nói tu theo Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Phụ", "definition": "歸附. Theo về để xin nương tựa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Phục", "definition": "歸服. Vâng chịu mà nghe theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Quan", "definition": "歸官. Bị tịch thu để xung vào của công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy San", "definition": "潙山. Tên Tên núi, thuộc tỉnh Hồ Nam..", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Sơn", "definition": "潙 山. 1. Còn gọi: Đại Quy Sơn. Núi nằm cách Tây thành 70km thuộc huyện Ninh Hương, tỉnh Hồ Nam, Trung Quốc. Là một nhánh trong dãy Hành Sơn, là đầu nguồn của sông Qui. Trên núi phần lớn là đất bằng. Nguồn sông rất nhiều nước, từ xưa đến nay, người xuất gia canh tác ở đây, nên có tên là La Hán điền (Ruộng La Hán). Tổ tông Quy Ngưỡng là Thiền Sư Linh Hựu hoằng dương thiền phong tại núi này nên người đời gọi Ngài là Quy Sơn Linh Hựu. Trên núi có chùa Mật ấn, chùa Đồng Khánh, am Liên Hoa. 2. Còn gọi: Tiểu Quy Sơn. Núi nằm ở phía đông huyện Lễ Lăng tỉnh Hồ Nam, Trung Quốc. Trên núi có chùa Tiểu Quy Sơn, do Thiền Sư Đại Duyên lập nên vào đời Đường.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Sơn Cảnh Sách", "definition": "潙 山 警 策. Gọi đủ: Quy Sơn Đại Viên Thiền Sư Cảnh Sách. Ngữ Lục, 1 quyển, do Quy Sơn Linh Hựu soạn vào đời Đường, được xếp vào Đại Chính Tạng tập 47.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Sơn Linh Hựu", "definition": "(潙山靈祐, Izan Reiyū, 771-853): họ là Triệu (趙), xuất thân vùng Trường Khê (長溪), Phúc Châu (福州, Tỉnh Phúc Kiến), vì ông sống ở Quy Sơn (潙山) nên được gọi là Quy Sơn Linh Hựu. Ông cùng với đệ tử Ngưỡng Sơn Huệ Tịch (仰山慧寂) cử xướng Thiền phong rộng rãi, pháp hệ của họ được gọi là Quy Ngưỡng Tông (潙仰宗) và Linh Hựu là vị tổ của tông này. Năm lên 15 tuổi, ông xuất gia, học kinh luật ở Long Hưng Tự (龍興寺) vùng Hàng Châu (杭州, thuộc Tỉnh Triết Giang), rồi đến nhập môn với Bách Trượng Hoài Hải (百丈懷海) ở Hồng Châu (洪州, Tỉnh Giang Tây) và kế thừa dòng pháp của vị này. Cùng đến tham học với ông lúc bấy giờ có Hoàng Bá Hy Vận (黃檗希運), cả hai đã làm chấn động Thiền giới thời nhà Đường. Sau Linh Hựu đến dừng chân trú tại Đại Quy Sơn (大潙山), nỗ lực cử xướng tông phong của mình và tạo được nhiều bậc long tượng xuất chúng. Đệ tử đắc pháp của ông có đến 41 người, đặc biệt trong đó Ngưỡng Sơn Huệ Tịch là nhân vật xuất sắc nhất. Bên cạnh đó còn có Hương Nghiêm Trí Nhàn (香嚴智閑), Diên Khánh Pháp Đoan (延慶法端), Kính Sơn Hồng Nhân (徑山洪諲), Linh Vân Chí Cần (靈雲志勤), Vương Kính Sơ Thường Thị (王敬初常侍), v.v. Ông thị tịch vào ngày mồng 9 tháng giêng năm thứ 7 niên hiệu Đại Trung (大中), hưởng thọ 83 tuổi đời và 64 hạ lạp, được ban cho thụy hiệu là Đại Viên Thiền Sư (大圓禪師). Trước tác của ông có Quy Sơn Cảnh Sách (潙山警策) 1 quyển, Đàm Châu Quy Sơn Linh Hựu Thiền Sư Ngữ Lục (潭州潙山靈祐禪師語錄) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Sơn Linh Hựu", "definition": "Xem Qui Sơn Linh Hựu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Sơn Linh Hựu Thiền Sư Ngữ Lục", "definition": "潙 山 靈 祐 禪 師 語 錄. Gọi đủ: Đàm Châu Quy Sơn Linh Hựu Thiền Sư Ngữ Lục. Còn gọi: Đại Viên Thiền Sư Ngữ Lục. Ngữ Lục, 1 quyển, do Quy Sơn Linh Hựu soạn vào đời Đường, các vị Ngộ Phong Viên Tín, Quách Ngưng Chi biên tập vào đời Minh, được xếp vào Đại Chính Tạng tập 47. Nội dung gồm: Hành trạng, Thị chúng, Pháp môn luận cứu của Quy Sơn Linh Hựu cho đến hơn 60 điều đối thoại về Thiền Tông của sư với các vị: Bách Trượng Hoài Hải, Tư Mã Đầu Đà, Đặng ẩn Phong, Vân Nham, Đạo Ngô, Đức Sơn, Thạch Sương, Ngưỡng Sơn, Hương Nghiêm và lược ghi về lúc thị tịch của sư Linh Hựu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Sơn Thiên Hoàng", "definition": "(龜山天皇, Kameyama Tennō, tại vị 1259-1274): vị Thiên Hoàng sống giữa thời Liêm Thương, vị Hoàng Tử của Hậu Tha Nga Thiên Hoàng (後嵯峨天皇, Gosaga Tennō, tại vị 1242-1246), tên là Hằng Nhân (恒仁, Tsunehito), vị Thiên Hoàng tại vị trong thời gian đại quân Mông Cổ xâm chiếm Nhật.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Sư", "definition": "Nương tựa vào nhà sư, vào chư Tăng, hay là vào một tăng sĩ là thầy dạy của mình.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Sương", "definition": "Kuśana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Tang", "definition": "歸喪. Trở về để lo việc ma chay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Thuận", "definition": "歸順. Vâng phục mà theo về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Thuỷ", "definition": "潙水. Tên sông, thuộc tỉnh Hồ Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Thú", "definition": "歸首. Nhận tội. Tự khai ra lỗi lầm của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Thằng", "definition": "規 繩. Phép tắc, quy củ. Tiết Dương Kỳ Phương Hội Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Tiên", "definition": "歸仙. Về cõi tiên, ý nói chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Trang", "definition": "歸莊. Về. Truyện Hoa Tiên có câu: “Sinh vừa vâng thấy tin bay, Tạ từ cậu thị sắp bày quy trang”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Trình", "definition": "規程. Khuôn khổ và thứ tự phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Trình Tường Tham", "definition": "歸 程 祥 參. Hồi quang phản chiếu để tham cứu bản lai diện mục của chính mình. Đây là quá trình tu hành tinh tấn sau khi đại ngộ để gánh vác yếu cơ của Phật giáo. Phổ Khuyến Tọa Thiền Nghi (Đại 82, 2 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Trượng", "definition": "歸 仗. Quy y. “Minh Chân Tụng” trong Phạm Kỳ Ngữ Lục q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Trảo", "definition": "龜爪. Người làm mai mối, như Quy gia, Quy đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Trọng", "definition": "歸 重. Tôn sùng, kính trọng. Tiết Thiên Đồng Đàm Hoa Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Trừ", "definition": "歸除. Phép làm toán chia bằng bài toán của người Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tàng Lục", "definition": "龜藏六 (Pháp Cú Thí Dụ Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quy Táng", "definition": "歸葬. Đem xác người chết về quê để chôn cất. Như Quy cốt 歸骨.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tánh (Tính)", "definition": "Trở về với bản tính của mình.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Tâm", "definition": "歸心. Lòng muốn theo người nào Lòng nhớ quê hương, muốn trơ về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tây", "definition": "歸西. Đi về phương tây Tiếng nhà Phật chỉ sự chết, tức là về nước Phật ở phương tây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tín", "definition": "歸 信. Thiền tăng đời Tống, ban đầu học Nho, giỏi thơ văn. Sư nối pháp thiền sư Thanh Phong Truyền Sở, trụ chùa Tịnh chúng ở Ích Châu (nay là Thành Đô, Tứ Xuyên).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Tòng", "definition": "龜從. Nguồn gốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tôn", "definition": "龜孫. Như Quy tử 龜子.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tông Chí Chi", "definition": "Kuei tsung Chih chieh (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Tông Nghĩa Nhu", "definition": "(歸宗義柔, Kisu Gijū, khoảng giữa thế kỷ thứ 10): nhân vật sống dưới thời nhà Tống, vị tăng của Pháp Nhãn Tông, pháp tử của Pháp Nhãn Văn Ích (法眼文益). Ông làm trú trì đời thứ 13 của Quy Tông Tự (歸宗寺) ở Lô Sơn (廬山, Huyện Cửu Giang) thuộc Tỉnh Giang Tây (江西省).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Tông Trí Thường", "definition": "(歸宗智常, Kiso Chijō, ?-?): vị tăng sống dưới thời nhà Đường, ông theo tham học với Mã Tổ Đạo Nhất (馬祖道一) và kế thừa dòng pháp của vị này, sau đó đến trú tại Quy Tông Tự (歸宗寺) trên Lô Sơn (廬山) và chuyên tâm giáo hóa chúng đạo tục. Sau khi viên tịch, ông được ban cho thụy hiệu là Chí Chơn Thiền Sư (至眞禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quy Tông Tự", "definition": "歸 宗 寺. Chùa ở phía nam chân núi Lô Sơn, huyện Tinh Tử, tỉnh Giang Tây, Trung Quốc. Niên hiệu Hàm Khang thứ 6 (340) đời Đông Tấn Hữu tướng quân Vương Nghĩa sửa nhà cũ của mình thành chùa để ngài Tam tạng Phật Đà Da Xá ở. Khoảng niên hiệu Nguyên Hòa (806-820) đời Đường, ngài Trí Thường xây dựng lại lần nữa. Các văn nhân như: Bạch Cư Dị, Lý Bột cũng từng đến đây hỏi đạo; từ đó về sau nó trở thành thiền viện. Niên hiệu Thái Bình Hưng Quốc thứ 9 (984), ngài Đạo Thuyên trụ trì chùa này, là đời thứ 12. Đạo tục tụ hội về, môn phong hưng thạnh. Về sau có các sư: Khắc Văn, Chính Hiền, Đàm Hoa, Huệ Nam trụ trì khiến cho chùa này trở thành đại đạo tràng của Thiền Tông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Tông Đạo Thuyên", "definition": "Kuei tsung Tao chuan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Túc", "definition": "歸宿. Gom lại, tóm lại Phần gom tóm, kết thúc bài văn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tăng", "definition": "Quy y Tăng, nương tựa vào các Tăng sĩ có học có đức như là những bậc đạo sư tâm linh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Tư", "definition": "S. Kucha. Tên một nước Phật giáo ở Trung Á, vào thời Trung Cổ. Nay thuộc Tân Cương (Trung Quốc).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Tắc", "definition": "規則. Khuôn khổ lề lố phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tỉnh", "definition": "歸省. Con gái có chồng, ở xa về thăm cha mẹ như Quy ninh 歸寧. Truyện Hoa Tiên có câu: “Cẩm hoàn một lá hồng kì, Lương thì quy thỉnh Diêu thì hoàn hôn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tịch", "definition": "歸寂. Chết, tiếng nhà Phật, chỉ dùng cho các tăng sĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tịch Thiền Sư", "definition": "歸 寂 禪 師. Thụy hiệu của Thiền tăng Trí Chân, sống vào đời Đường. X. Trí Chân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quy Tội", "definition": "歸罪. Đổ lỗi cho người khác Như Quy cữu 歸咎.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tụ", "definition": "歸聚. Gom nhóm về một nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Tục", "definition": "Tăng sĩ hoàn tục, trở về với cuộc sống thế tục.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quy Tử", "definition": "龜子. Lời mắng (“Con nhà đĩ”).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Vị", "definition": "歸位. Trở về chỗ ngồi Trở về ngôi thứ địa vị thực sự của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Xác", "definition": "龜殼. Vỏ rùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Y", "definition": "Skyabs (T), Saraṇagāmāna (P), Kyabdro (T), Saraṇa (P), Take a refuge in.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Điền", "definition": "歸田. Trở về làm ruộng, chỉ sự từ quan. Như Quy canh 歸耕.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Đầu", "definition": "龜頭. Người làm mai mối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Định", "definition": "規定. Đặt ra để làm phép tắc noi theo Theo phép tắc mà đặt ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quy Ước", "definition": "Xem Thế Tục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quy Ước Thiền Đường", "definition": "Tên sách, nói về quy tắc tổ chức thiền viện, tu viện Phật giáo, tác giả là thiền sư Việt Nam, Minh giác Kỳ Thương (1682-1744).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quynh", "definition": "冂. Vùng đất cực xa ở xung quanh kinh đô Tên một bộ chữ Trung Hoa, tức bộ Quynh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quynh Môn", "definition": "扃門. Chỉ chung cổng ngõ Cài cửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên", "definition": "娟. Vẻ đẹp đẽ của đàn bà. Td: Thuyền quyên (người đàn bà đẹp, cũng đọc là Thiền quyên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Ai", "definition": "涓埃. Dòng nước nhỏ và hạt bụi nhỏ, chỉ sự nhỏ nhặt, bé nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Cát", "definition": "涓吉. Chọn ngày tốt “Mệnh quan quyên cát cập kì đăng quan” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Danh", "definition": "捐名. Bỏ tiền mua tiếng tăm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Giảm", "definition": "蠲減. Bỏ bớt đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Khu", "definition": "捐軀. Bỏ mình. Liều chết hi sinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Kim", "definition": "捐金. Thâu góp tiền bạc Tiền bạc thâu góp được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Lệ", "definition": "捐例. Lề lối xưa, bỏ tiền ra mua chức tước của nhà nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Miễn", "definition": "蠲免. Bỏ đi, không bắt làm nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Mệnh", "definition": "捐命. Bỏ sự sống. Như Quyên khu 捐軀.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Ngân", "definition": "捐銀. Như Quyên kim 捐金.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Nhân", "definition": "鋗人. Người bề tôi theo hầu vua khi vua đi ra ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Phi Nhu Động", "definition": "Chỉ cho loài sinh vật rất nhỏ bé. Quyên phi: Chỉ cho loài trùng nhỏ bay đi trên không như ruồi muỗi; Nhu động: Chỉ cho loài trùng nhỏ có dáng ngọ ngoạy như dòi bọ...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyên Phẫn", "definition": "悁忿. Buồn bực giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Quan", "definition": "捐官. Bỏ tiền mua chức tước, ông quan nhờ bỏ tiền ra mà có chức tước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Quyên", "definition": "悁悁. Lo lắng Giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Sinh", "definition": "捐生. Bỏ sự sống, ý nói tự tử. Đoạn trường tân thanh có câu: “Giận duyên tủi phận bời bời, cầm dao nàng đã toan bài quyên sinh” Cũng có nghĩa là liều chết hi sinh. Văn tế Vũ Tính và Ngô Tùng Châu của Đặng Đức Siêu có câu: “Đấng anh hùng vì nước quyên sinh, điên bái chẳng sai lòng tiết nghĩa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Thân", "definition": "捐身. Như Quyên khu 捐軀.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Trích", "definition": "涓滴. Giọt nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Trần", "definition": "捐塵. Bỏ cõi đời, chỉ sự chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Trợ", "definition": "捐助. Gom góp tiền bạc mà giúp đở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Tác", "definition": "Phạm: Pàza. Pàli: Pàsa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyên Tô", "definition": "蠲租. Miễn thuế. Không đánh thuế nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Tố", "definition": "絹素. Lụa dệt bằng tơ sống. Cũng nói: Tố quyên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Vong", "definition": "捐忘. Bỏ quên. Quên hẳn mất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên Độc", "definition": "身毒. Tên thời xưa, chỉ nước Ấn Độ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyên ấp", "definition": "悁邑. Buồn giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến", "definition": "圳. Ngòi nước chảy trong đồng ruộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Cấp", "definition": "悁急. Nóng nảy gấp rút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Cố", "definition": "眷顧. Tưởng nhớ tới. Bài văn tế nha phiến có câu: “Nghĩa giao tất dễ quên tình quyến cố”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Dụ", "definition": "眷誘. Dỗ dành rủ rê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Giới", "definition": "狷介. Thận trọng giữ gìn, không giao thiệp cẩu thả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Luyến", "definition": "眷戀. Yêu mến không nỡ rời. “Lời đâu quyến luyến thanh tâm” (Hoa Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Niệm", "definition": "眷念. Nhớ tới, nghĩ tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Phẫn", "definition": "狷忿. Nóng nảy bực tức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyến Rũ", "definition": "Āvaṭṭana (trung), āvaṭṭeti (ā + vatt + e), līlā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quyến Thuộc", "definition": "Xem Phụ tùy.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quyến Thuộc Bát Nhã", "definition": "Lục Độ Vạn Hạnh tương ứng với diệu tuệ, trợ lực phát ra Quán Chiếu Bát Nhã, 1 trong 5 loại Bát Nhã.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyến Thuộc Công Đức", "definition": "Một trong 17 thứ làm đẹp cõi nước thuộc 29 loại trang nghiêm Tịnh Độ Cực Lạc. Các Thánh chúng Vãng Sinh Tịnh Độ Cực Lạc là quyến thuộc của Đức Phật A Di Đà, đều từ hoa Chính Giác của Ngài hóa sinh, bình đẳng như nhau, không có hơn kém; cõi nước có đầy đủ những công đức trang nghiêm này, gọi là Quyến thuộc công đức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyến Thuộc Diệu", "definition": "Diệu thứ 9 trong Tích Môn Thập Diệu của Kinh Pháp Hoa do Tông Thiên Thai lập ra. Tức chỉ cho những người trong các kiếp quá khứ từng đã thụ trì giáo pháp của Như Lai, nay đến hỗ trợ Như Lai trong việc giáo hóa. Những quyến thuộc này của Như Lai được chia làm 5 loại đều chẳng thể nghĩ bàn, nên gọi là Quyến Thuộc Diệu:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyến Thuộc Như Lai", "definition": "Tathāgatas' Family.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quyến Thuộc Vô Minh Trụ Địa", "definition": "Chỉ cho các phiền não ngành ngọn (chi mạt). Nhóm từ này được sử dụng trong Luận Ma Ha Diễn quyển 4.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyến Thuộc Địa Ngục", "definition": "Tám địa ngục nóng căn bản, mỗi địa ngục có 16 địa ngục nhỏ phụ thuộc. Sau khi chúng sinh chịu các khổ báo ở địa ngục căn bản xong, được đưa đến các địa ngục quyến thuộc để chịu hết những khổ báo còn lại.Có 128 địa ngục quyến thuộc, nếu thêm các địa ngục căn bản(8 địa ngục nóng) nữa thì tất cả có 136 địa ngục (136 nại lạc ca).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyết", "definition": "Nirnaya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quyết Chiến", "definition": "決戰. Nhất định đánh nhau, không thể thôi Đánh nhau dữ dội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Chí", "definition": "決志. Nhất định không thay đổi ý định. Ca dao có câu: “Làm trai quyết chí tu thân, công danh chớ vội nợ nần chớ lo”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Liễu", "definition": "決 了. Dứt trừ nghi hoặc, hiểu rõ thiền pháp. Tiết “Bản Tịnh truyện” trong TCTT q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quyết Liệt", "definition": "決烈. Dứt khoát, mạnh mẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Minh", "definition": "厥明. Ngày mai. Ngày hôm sau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Mục", "definition": "抉目. Móc mắt. Một hình phạt tàn khóc thời cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Nghi", "definition": "決疑. Xét đoán dứt khoát được điều ngờ vực.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Nghị", "definition": "決議. Cho ý kiến dứt khoát về một việc được đem ra bàn bạc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Ngục", "definition": "決獄. Xét định một vụ án.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Nhiên", "definition": "決然. Nhất định như vậy, không thể khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Thư Hùng", "definition": "決雌雄. Nhất định so tài hơn kém rõ rệt như trống với mái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Thắng", "definition": "決勝. Nhất định phải hơn, không chịu thua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Toán", "definition": "決算. Tính các con số một cách dứt khoát, rõ rệt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Trạch", "definition": "Phạm: Nairvedhika.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyết Tuyển", "definition": "決選. Lựa chọn vừa đủ số. Số người chọn được vừa đúng với số người đang cần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Tuyệt", "definition": "決絶. Cắt đứt liên hệ một cách dứt khoát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Tâm", "definition": "Patthāna (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quyết Tử", "definition": "決死. Nhất định chết. Liều chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Vĩ", "definition": "厥尾. Cụt đuôi. Đuôi ngắn có một màu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Vọng", "definition": "觖望. Trông ngóng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Yếu", "definition": "訣要. Việc trọng đại bí mật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Án", "definition": "決案. Xét việc để định tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Ý Ba La Mật", "definition": "Aditthana pāramitā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quyết Đao", "definition": "決刀. Con dao cực sắc bén Lưỡi đao dùng để chém kẻ tử tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Đoán", "definition": "決斷. Xét việc một cách dứt khoát, nhất định. Đoạn trường tân thanh có câu: “Thấy lời quyết đoán hẳn hoi, đành lòng nàng cũng sẽ nguôi nguôi dần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Đấu", "definition": "決鬥. Nhất định so tài hơn kém Tục lệ Tây phương thời xưa, các nhà quý phái có sự xích mích, cảm thấy có sự xấu hổ, thì thách nhau so gươm, người thắng là người rửa được nhục, phục hồi được danh dự (Duel) Phạm Quỳnh, trong bài Danh dự luận, đăng trên Nam Phong tạp chí năm 1919, có viết: “Người nào xử một việc bất nhã, làm một điều phi danh dự, hay là bị cái nhục mà không rửa được sạch, thời bằng bối coi là người mất giá, phải mang tiếng xấu một đời, nhân đó có cái tục quyết đấu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyết Định", "definition": "Niscaya (S), Samcetana (S), Decision.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quyết Định Nghiệp", "definition": "Phạm: Vinizcit-Karman. Gọi tắt: Định Nghiệp", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyết Định Thuyết", "definition": "決定說", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Quyết Định Thành Tựu Chân Ngôn", "definition": "Chỉ cho Chân Ngôn trong Mật Giáo được sử dụng để biểu thị sự quyết định thành tựu các việc. Chân Ngôn ấy là: Án (oô, qui mệnh) phạ nhật la dã (Vajràya, Kim Cương) sa phạ hạ (svàhà, thành tựu).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyết Định Tâm", "definition": "Chỉ cho tâm quyết đoán, an định, không lay động. Tổng kết các kinh luận, đại khái có 4 nghĩa sau đây:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyết Định Tạng Luận", "definition": "Vinirnita-piṭāka śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quyết Định Vãng Sanh Tập", "definition": "(決定徃生集, Kejjōōjōshū): 2 quyển, do vị Tăng Tam Luận Tông Trân Hải (珍海, Chinkai, 1091-1152) soạn; là thư tịch trích dẫn những đoạn văn xưng tán các kinh điển Tịnh Độ như Quán Vô Lượng Thọ Kinh (觀無量壽經) cũng như Khởi Tín Luận (起信論), v.v., tất quyết định vãng sanh.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quyết Định Vãng Sinh Tập", "definition": "Tác phẩm, 2 quyển, do ngài Trân Hải, vị tăng thuộc Tông Tam Luận Nhật Bản soạn; được thu vào Đại Chính Tạng tập 84.Nội dung sách này trình bày ý nghĩa hành giả niệm Phật quyết định vãng sinh, gồm 3 Đại cương: Giáo Văn, Đạo Lí và Tín Tâm. Phần Giáo văn dẫn thuyết trong Kinh Quán Vô Lượng Thọ, Kinh Xưng Tán Tịnh Độ và Luận Khởi Tín, cho rằng đã quyết định thì không do dự nữa, đã nói “tức sinh” thì chẳng phải biệt thời ý. Phần Đạo Lí thì cho rằng chúng sinh có phần xuất li, chư Phật có công dắt dẫn; người phàm phu nếu nguyện vãng sinh thì được vãng sinh, đó là lẽ thường nhân nhỏ quả lớn, trong ngoài duyên khởi.Phần Tín Tâm thì trong Tín Tâm quyết định có mở ra 3 thứ: Quả Quyết Định, Nhân Quyết Định và Duyên Quyết Định. Sau đó lại chia 3 quyết định này làm 10 môn là: Y Báo Quyết Định, Chính Quả Quyết Định, Thăng Đạo Quyết Định, Chủng Tử Quyết Định, Tu Nhân Quyết Định, Trừ Chướng Quyết Định, Sự Duyên Quyết Định, Hoằng Thệ Quyết Định, Nhiếp Thủ Quyết Định và Viên Mãn Quyết Định. Trong 10 môn này, thì 3 môn đầu là quả, 3 môn kế là nhân, 3 môn kế nữa là duyên, môn sau cùng là thích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyết Định Vãng Sinh Tập Quyết Định Thành Phật Tập", "definition": "Tác phẩm, 4 quyển, do sư Du lạc thuộc Tông Tịnh Độ Nhật Bản soạn, ấn hành vào năm Chính Đức thứ 2 (1712).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền", "definition": "埢. Quyền viên 埢垣: Vẻ tròn. Tròn trịa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền - Thật", "definition": "“Quyền” và “thật” là hai thuật ngữ Phật học đối nhau. “Quyền” nghĩa là phương tiện chỉ dùng trong nhất thời, tùy theo từng trường hợp, từng hoàn cảnh, từng đối tượng mà nói năng, hành động, xử sự cho được thích nghi, không cứ phải chấp nê theo một khuôn thức cứng ngắc, nhất định nào cả. “Thật” nghĩa là chân thật, chắc chắn, rốt ráo cùng cực, vĩnh viễn không thay đổi. Từ hai thuật ngữ đối nhau này, trong Phật học đã phát sinh ra nhiều thuật ngữ liên hệ, như: quyền giáo, thật giáo; quyền trí, thật trí; quyền quả, thật quả; v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quyền Biến", "definition": "權變. Tạm thay đổi đường lối cho phù hợp với sự việc xảy ra, với hoàn cảnh mới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Bính", "definition": "權柄. Sức mạnh nằm trong tay để làm việc, bắt người khác theo mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Bổng", "definition": "拳棒. Tay và gậy, chỉ môn võ đánh bằng tay và bằng gậy, chỉ chung võ thuật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Chế", "definition": "權制. Dùng sức mạnh mà ngăn chặn đè nén.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Cơ", "definition": "Đối lại: Thực Cơ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Cước", "definition": "拳脚. Tay và chân Môn võ dùng tay và chân Nắm đấm và cú đá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Cốt", "definition": "權骨. Xương gò má.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Cục", "definition": "蜷局. Cong lại, uốn cong, không duỗi, không thẳng ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Dũng", "definition": "拳勇. Mạnh mẽ và giỏi võ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Giả", "definition": "Đối lại: Chân Thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Hiện", "definition": "I.Quyền Hiện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Hiện Tạo", "definition": "Cũng gọi Thạch Gian Tạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Hoạnh", "definition": "權橫. Ỷ thế lực mà làm ngang ngược.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Hành", "definition": "Issariya (trung), satti (nữ), vasībhāva (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quyền Hóa", "definition": "I.Quyền Hóa. Phạm: Avatàra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Hóa Thực Hóa", "definition": "Quyền hóa là sự giáo hóa bằng phương tiện giả tạm; Thực hóa là sự giáo hóa bằng Nhất Thừa Chân Thực. Nghĩa là sự giáo hóa của Đức Phật có Quyền pháp và Thực pháp khác nhau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Hạn", "definition": "權限. Cái ranh giới trong khi làm việc, không được vượt qua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Lược", "definition": "權略. Sự tính toán sắp đặt để đối phó với hoàn cảnh bất thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Lợi", "definition": "權利. Điều được có, được làm và được đòi hỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Lực", "definition": "權力. Sức mạnh tinh thần khiến người khác phải nghe theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Môn", "definition": "權門. Nhà có thế lực địa vị. Cung oán ngâm khúc có câu: “Mùi quyền môn thắm gắt nên phai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Mưu", "definition": "權謀. Như Quyền lực 權力.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Nghi", "definition": "權宜. Xem xét hoàn cảnh, tình hình mà đối phó cho thích hợp. “Quyền nghi hết sức lo lường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Nhiếp", "definition": "權攝. Tạm thời thay thế người khác để làm công việc của người đó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Năng", "definition": "Có sách Phật gọi là phép thần thông, mà tu sĩ Phật giáo thành tựu được nhờ tu thiền định. Trong sách Phật, thường nói tới những quyền năng như thấy xa, bấ chấp những chướn ngại (H. Thiên nhãn thông), nghe xa và nghe được những âm thanh cực nhỏ mà tai người bình thường không nghe được (H. thiên nhĩ thông); đi nhanh như bay, và bay bổng như chim cũng được (H. Thần túc thông). Đạo Phật vốn cho rằng, những quyền năng đó không có gì đặc biệt cả, bất cứ ai, kể cả những người không phải là Phật tử, nếu thực hiện tu định tâm, cũng sẽ thành tựu được những quyền năng như vậy. Các bậc tu hành đắc đạo, tu thiền định lâu năm thường có đủ những quyền năng như vậy, và cả những quyền năng khác nữa, nghĩa là họ không còn bị chi phối bởi những quy luật sinh-vật lý nữa, nhưng họ thường tránh không phô bày những quyền năng đó ra, sợ quần chúng bị mê hoặc. Những Phật tử tu theo Mật tông thường chú trong đến những quyền năng đó. Cũng có sách Phật gọi Phật giáo Mật tông là Phật giáo quyền năng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quyền Phỉ", "definition": "拳匪. Tên một tổ chức đời Thanh (1900), chuyên luyện môn võ tay không, nỗi lên đánh người ngoại quốc, tức Nghĩa hoà đoàn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Quyền", "definition": "惓惓. Lòng dạ thành thật, cầu trọng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Quyệt", "definition": "權譎. Xảo trá, giỏi thay đổi theo thời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Quý", "definition": "權貴. Cao sang có thế lực địa vị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Sâm", "definition": "拳參. Tên một loài cây, rễ xoắn lại như nắm tay, dùng làm vị thuốc bắc (một thứ sâm).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Sư", "definition": "拳師. Người giỏi môn võ tay không Oâng thầy dạy môn võ tay không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Sở Hữu", "definition": "Anvāvisati (anu + a + vis + a), āyatta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quyền Sử", "definition": "權使. Dùng thế lực địa vị của mình mà sai khiến người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Tam Cương", "definition": "Đối lại: Chính Tam Cương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thuật", "definition": "拳術. Môn võ đánh bằng tay Ngày nay còn chỉ môn quyền Anh (Boxe).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Thần", "definition": "權臣. Người bề tôi có thế lực: “Nghe ai mưu khử quyền thần” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Thật", "definition": "(權寔): quyền nghĩa là quyền nghi, chỉ cho phương tiện cần thiết nhất thời; thật là chân thật không dối, sự chân thật tột cùng vĩnh viễn không thay đổi. Quyền thật còn gọi là chân giả. Như trong Thiền Tông Tụng Cổ Liên Châu Thông Tập (禪宗頌古聯珠通集, CBETA No. 1295) quyển 25 có câu: “Đốn tiệm thiên viên, quyền thật không hữu, đinh tủy thiết thiệt, hà mục hải khẩu (頓漸偏圓、權寔空有、釘觜鐵舌、河目海口, đốn tiệm méo tròn, quyền thật không có, mỏ đinh lưỡi sắt, mắt sông miệng biển).” Hay như trong Đại Thừa Bản Sanh Tâm Địa Quán Kinh Thiển Chú (大乘本生心地觀經淺註, CBETA No. 367) cũng có câu: “Dĩ thuyết pháp chi công, trang nghiêm tự tánh, quyền thật tự tại, cố tôn vi vương (以說法之功、莊嚴自性、權寔自在、故尊爲王, lấy công đức thuyết pháp, trang nghiêm tự tánh, quyền thật tự tại, nên tôn xưng là vua).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quyền Thế", "definition": "權勢. Có địa vị lớn và sức mạnh: “Chớ khoe quyền thế chớ cười hàn vi” (Phan Trần).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Thừa Thực Quả", "definition": "Thừa phương tiện và quả chân thực, do Tông Chân Ngôn Nhật Bản chủ trương. Tông Chân Ngôn lập ra thuyết Thập Trụtâm, 9 trụ tâm đầu là Quyền thừa, trụ tâm thứ 10 là Thực quả. Tông Chân Ngôn cho rằng các Tông Duy Thức, Tam Luận, Hoa Nghiêm, Thiên Thai...là Quyền thừa (giáo pháp phương tiện), Phật của các tông này đều là Quyền Phật của nhân vị (còn ở địa vị tu nhân), chứ chưa phải là Chân Phật, chỉ có Pháp Thân Phật của Trụ Tâm thứ 10 mới là Phật quả chân thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực", "definition": "Quyền cũng gọi Thiện Quyền, Quyền Phương Tiện, Thiện Quyền Phương Tiện, Giả, Quyền Giả, nghĩa là cái phương tiện tạm bợ được đặt ra trong nhất thời, dùng xong thì bỏ; Thực cũng gọi là Chân, Chân thực, nghĩa là cái chân thực rốt ráo không hư dối, vĩnh viễn không thay đổi.Cả 2 được ghép chung gọi là Quyền thực, Chân giả. Từ đó có những cặp dụng ngữ đối nhau như Quyền Giáo và Thực Giáo, Quyền Trí và Thực Trí, Quyền Nhân và Thực Nhân, Quyền Quả và Thực Quả, Quyền Hóa và Thực Hóa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực Bất Nhị Môn", "definition": "Tông Thiên Thai cho rằng các pháp quyền và thực dung thông nhau, bình đẳng không hai, là 1 trong Thập Bất Nhị Môn. Pháp Hoa Huyền Nghĩa Thích Tiêm quyển 14 (Đại 33, 919 hạ) nói: “Quyền Thực Bất Nhị Môn, nghĩa là trí tuệ rộng lớn bình đẳng, thường chiếu rọi khắp pháp giới, cũng do lí tính 9 quyền 1 thực (tức 9 cõi từ Bồ Tát đến địa ngục là quyền, chỉ có 1 cõi Phật là thực), thực ở trong 9 cõi, quyền cũng lại như thế. Quyền thực thầm hợp nhau, trăm cõi một niệm không thể tách rời, nhậm vận thường nhiên”. Nghĩa là về mặt lí tính thì tâm phàm phu vốn đầy đủ 9 quyền 1 thực, tức là “thực” của cõi Phật có đầy đủ “quyền” của 9 cõi mà “quyền” của 9 cõi cũng đầy đủ “thực” của cõi Phật.Do đó, quyền và thực bình đẳng, trăm cõi dung nhiếp, hòa nhập vào nhau, hoàn toàn trong 1 niệm cần yếu này, cho nên, khi quán xét một niệm mà chiếu soi cảnh nhiệm mầu của 3 nghìn thế giới thì có thể thành tựu tu quán sơ tâm, đây là yếu chỉ của pháp môn “Quán Tâm” của Tông Thiên Thai.[X. Pháp Hoa Huyền Nghĩa Q.7; Thập Bất Nhị Môn Chỉ Yếu Sao Q.hạ]. (xt. Thập Bất Nhị Môn).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực Chỉ Quán", "definition": "Chỉ cho Tam Quyền Chỉ Quán và Nhất Thực Chỉ Quán của Tông Thiên Thai.Tam Quyền Chỉ Quán là Chỉ Quán Thiên lệch như Tam Tạng Quán, Thông Quán và Biệt Quán trong 4 thời (Hoa Nghiêm, A Hàm, Phương Đẳng, Bát Nhã) 3 giáo (Tạng, Thông, Biệt) do Đức Phật nói trước thời Pháp Hoa; còn Nhất Thực Chỉ Quán tức là Chỉ Quán viên đốn mà Đức Phật đã nói trong thời Pháp Hoa. Đứng về phương diện quan hệ giữa Tam Quyền Chỉ Quán và Nhất Thực Chỉ Quán mà nói, thìpháp quán đầu là “khai”, pháp quán sau là “hiển”, theo ý Tông Thiên Thai, vì muốn hiển bày (hiển) Nhất Thực Chỉ Quán nên Đức Phật mở ra (khai) Tam Quyền Chỉ Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực Nhị Giáo", "definition": "Từ gọi chung Quyền Giáo và Thực Giáo được ghép lại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực Nhị Trí", "definition": "Cũng gọi Quyền Thực Nhị Tuệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực Tứ Cú", "definition": "Bốn câu phân biệt do Tông Thiên Thai lập ra để nói rõ về quyền thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Thực Đồng Thể Dị Thể", "definition": "Tông Thiên Thai cho rằng Quyền Giáo và Thực Giáo là bình đẳng không hai, gọi là", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Tích", "definition": "Thân quyền hóa thùy tích do chư Phật thị hiện. Nghĩa là chư Phật vốn đã thành Phật từ rất nhiều kiếp lâu xa về trước, nhưng muốn hóa độ chúng sinh mà thị hiện thân thùy tích; như 8 tướng thành đạo của Đức Phật Thích Ca. Quyền là đối với Thực, Tích là đối với Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Tước", "definition": "權爵. Chỉ chung thế lực và địa vị. Nhị Độ Mai có câu: “Tuy quyền tước lớn mà phong độ hèn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyền Điền Lôi Phủ", "definition": "(1846-1934). Cao tăng Nhật Bản, thuộc Tông Chân Ngôn, người huyện Tân Tích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyền Đại Thừa", "definition": "Đối lại: Thực Đại Thừa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyển", "definition": "劵. Mệt nhọc Ngừng lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Luyến", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyển Nang Nhi Khứ", "definition": "捲囊而去. Cuốn gói mà đi, ý nói bỏ nhà ra đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Nhi Hoài Chi", "definition": "捲而懷之. Cuộn lại mà giấu trong lòng, ý nói giấu tài không chịu ra làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Sách", "definition": "Potthaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quyển Thiệt", "definition": "捲舌. Cuộn lưỡi lại. Không nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Thư", "definition": "捲舒. Cuộn lại và mở ra Chỉ hành động tự do.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Thư Tại Ngã", "definition": "捲舒在我. Cuốn mở tự mình, ý nói hành động tự do theo ý mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Thổ Trùng Lai", "definition": "捲土重來. Cuộn đất mà trở lại, ý nói thu xếp tất cả vật dụng cốn liếng mà làm lại một lần nữa để được thành công. Bài phú Hỏng thi của Trần Tế Xương có câu: “Ngẫm đến câu quyển thổ trùng lai, nói ra ngậm ngọng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Trục", "definition": "卷軸. Sách vở giấy tờ (Thời xưa thường cuốn lại, nên mới gọi là Trục).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Tâm Thái", "definition": "捲心菜. Loại rau mà trong ruột nó cuộn lại, tức cải bắp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Tử Bản", "definition": "Bản sách cuốn tròn, tức là viết chữ trên 1 tờ giấy dài rồi cuốn lại thành hình ống tròn, 1 trong những hình thức đóng sách ở đời xưa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quyển Xích", "definition": "捲尺. Cái thước cuộn, khi đo mới kéo ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyển Địa Bì", "definition": "捲地皮. Cuộn tóc lại cho đẹp Búi tóc lại cho gọn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyện", "definition": "倦. Mệt mỏi Chán chường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyện Cần", "definition": "倦勤. Chán sợ cảnh cực nhọc vất vả Còn chỉ việc ở ngôi vị cao mà xin cáo quan Kinh thơ; Lão kì quyện vu cần (Lớn tuổi chán ghét chuyện mệt mỏi)”Quyện cần rồi lại xuất gia” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyện Du", "definition": "倦遊. Chán cuộc vui chơi Cũng chỉ sự làm quan phương xa nhớ nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyện Phi Điểu", "definition": "倦飛鳥. Con chim bay mỏi. Chỉ người làm quan phương xa nhớ nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quyệt", "definition": "撅. Xuyên thủng. Xuyên vào Các âm khác là Quệ, Quyết. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá", "definition": "过. Một lối viết giản dị của chữ Quá 過.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Bán", "definition": "過半. Hơn nửa. Trên một nửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Bộ", "definition": "過步. Bước hơn lên một chút nữa. Ghé bước. Tiếng trịnh trọng mời người khác tới nhà mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Bội", "definition": "過倍. Hơn gấp đôi. Gấp hơn hai lần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Cố", "definition": "過故. Đã đi qua mà thành người xưa, ý nói đã chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Diệt Tịnh Địa", "definition": "Xem Càn Huệ Địa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quá Dự", "definition": "過譽. Khen ngợi vượt sự thật, quá đáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Giang", "definition": "過江. Qua sông. Vượt sông Ta còn hiểu là đi nhờ xe cộ của người khác trong một đoạn đường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Hiên Vị Lai Nghiệp Báo Trí Lực", "definition": "Cũng gọi Nghiệp Dị Thục Trí Lực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Hoạn Đoạn", "definition": "Cũng gọi: Tình hữu đoạn. Đối lại: Công Đức Đoạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Hoạt", "definition": "過活. Làm ăn để sống qua ngày. Kiếm ăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Hạn", "definition": "過限. Vượt khỏi mức ấn định, lúc ấn định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Hải Hòa Thượng", "definition": "Tức là ngài Giám Chân, vị cao tăng Trung Quốc sống vào đời Đường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khách", "definition": "過客. Người qua đường. Người đi đường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Khích", "definition": "過激. Mạnh mẽ quá độ, vượt hẳn mức thường. Đáng lẽ đọc Quá kích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Khắc", "definition": "過刻. Nghiêm ngặt quá đáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Khứ", "definition": "Attita (P), Atikkanta (P), Atikranta (S), Atita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quá Khứ Hiện Tại Nhân Quả Kinh", "definition": "Cũng gọi Quá Hiện Tại Nhân Quả Kinh, Nhân Quả Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khứ Hiện Tại Nhân Quả Kinh Hội Quyển", "definition": "Cũng gọi Hội Nhân Quả Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khứ Thất Phật", "definition": "Sept bouddhas du passé 阿彌陀經", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Quá Khứ Trang Nghiêm Kiếp", "definition": "Kiếp có 3 loại: Đại Kiếp, Trung Kiếp, Tiểu Kiếp. Đại Kiếp của hiện tại gọi là Hiền Kiếp; Đại Kiếp của quá khứ gọi là Trang Nghiêm Kiếp và Đại Kiếp của vị lai gọi là Tinh Tú Kiếp. Trong mỗi kiếp đều có 1.000 vị Phật ra đời.[X. Kinh Trường A Hàm Q.1; Kinh Khởi Nhân Bản Q.9].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khứ Trang Nghiêm Kiếp Thiên Phật Danh Kinh", "definition": "Cũng gọi Tập Chư Phật Công Đức Sơn Kinh, Trang Nghiêm Kiếp Thiên Phật Danh Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khứ Trướng", "definition": "Cũng gọi Linh Bạ, Điểm Quỉ Bạ. Tiếng dùng của Phật Giáo Nhật Bản. Chỉ cho quyển sổ ghi tên người chết, tức ghi pháp danh, ngày, tháng, năm sinh và mất của người quá cố để lưu giữ trong chùa viện. Trong Phật đường của mỗi gia đình cũng có đặt bài vị ghi tên, tuổi của những người thân thuộc đã qua đời.Thời Tông của Nhật Bản gọi loại sổ này là “Vãng cổ quá khứ trướng”, từ vị Tổ thứ 2 là ngài Chân Giáo (1237-1319) cho đến nay, các Tổ Sư nhiều đời đều mang bên mình danh sách pháp danh của tín đồ tăng tục đã qua đời trong giáo đoàn để hồi hướng hàng ngày. Nói chung, Quá khứ trướng là tư liệu trọng yếu cho việc nghiên cứu Phật Giáo Nhật Bản đương thời.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khứ Trần Điểm Kiếp", "definition": "Kiếp chấm (điểm) bụi (trần) quá khứ, ví dụ sự lâu xa đã qua. Trong Phẩm Hóa Thành Dụ của Kinh Pháp Hoa có nhóm từ “Tam Thiên Trần Điểm Kiếp” (Kiếp chấm bụi 3 nghìn), nghĩa là đem 3 nghìn Đại Thiên Thế giới mài thành mực, rồi cứ đi qua 1.000 quốc độ lại rỏ xuống 1 chấm mực nhỏ như hạt bụi, cho đến khi hết số mực đó; lại nghiền nát tất cả quốc độ đã trải qua thành bụi nhỏ, cứ 1 hạt bụi nhỏ như thế tính là 1 kiếp. Đó là ví dụ nói lên thời gian từ khi Đức Phật Đại Thông Trí Thắng nhập diệt đến nay cũng lâu xa như thế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Khứ Tạng", "definition": "Atita kośa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quá Kiều", "definition": "過橋. Qua cầu. Td: Quá kiều chiết kiều (qua cầu rồi bẻ gẫy cầu, chỉ sự vô ơn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Kì", "definition": "過期. Vượt khỏi thời hạn đã định. Trễ hẹn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Kế", "definition": "過繼. Nuôi con nuôi, để làm kẻ thừa kế của mình Người con nuôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Lượng", "definition": "過量. Vượt khỏi cái số, cái phần đã định. Nhiều quá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Lố", "definition": "Atikkamati (ati + kam + a), atikkhama (nam), bhiyyo", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quá Lự", "definition": "過慮. Lo nghĩ quá đáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Môn", "definition": "過門. Đi qua cửa nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Mạn", "definition": "Atimāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quá Mộc Kiều", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Mục", "definition": "過目. Đi qua mắt, ý nói nhìn qua, đọc qua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Ngọ Bất Thực", "definition": "Cũng gọi Trì Ngọ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Nhanh", "definition": "Atikhippaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quá Niên", "definition": "過年. Đã qua cái tuổi trẻ trung, chỉ người đứng tuổi. Đoạn trường tân thanh có câu: “Quá niên trạc ngoại tứ tuần, hình dung chải chuốt áo quần bảnh bao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Nệ", "definition": "過泥. Chấp nhất quá đáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Phòng", "definition": "過房. Qua nhà người khác, chỉ sự làm con nuôi người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Phòng Tử", "definition": "過房子. Con nuôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Phạm", "definition": "過犯. Đã từng làm điều tội lỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Phận", "definition": "過分. Vượt ra ngoài cái phần của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Quan", "definition": "過關. Đi qua cửa ải. Đoạn trường tân thanh có câu: “Quá quan này khúc Chiêu Quân, nửa phần luyến chúa nửa phần tư gia”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Sơn Pháo", "definition": "過山礮. Súng lớn bắn qua núi. Súng cối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Thất", "definition": "過失. Điều lầm lỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Thặng", "definition": "過剩. Thừa ra, hơn cả số đã định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Thế", "definition": "過世. Qua đời. Chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Thủ", "definition": "過手. Qua tay. Trao cho người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Triêu Tịch", "definition": "過 朝 夕. Sống. Tiết Linh Tuyền Quy Nhân Thiền Sư trong NĐHN q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quá Trình", "definition": "過程. Con đường đã đi qua Chỉ chung những việc đã trải qua, đã làm được từ trước tới nay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Tưởng", "definition": "過奬. Khen ngợi quá đáng. Quá khen. Tiếng dùng để nói khi được người khác khen ngợi (dùng nhiều trong bạch thoại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Vãng", "definition": "過往. Đã đi qua. Đã qua Chết. Cũng như: Quá cố.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Vấn", "definition": "過問. Hỏi han việc đã qua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Vị Vô Thể", "definition": "Pháp quá khứ, vị lai đều không có thực thể, chỉ có pháp hiện tại mới có thực thể. Đây là chủ trương của Duy Thức Đại Thừa. Còn Tát Bà Đa Bộ (tức Thuyết Nhất Thiết Hữu Bộ) của Tiểu Thừa thì lập thuyết “Tam Thế Thực Hữu”, cho rằng 3 đời quá khứ, hiện tại, vị lai là có thực, là hằng hữu; đối lại, Duy Thức Đại Thừa lập thuyết “Quá vị vô thể” để phá thuyết của Tát Bà Đa Bộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Xưng", "definition": "過稱. Như Quá dự 過譽, Quá tưởng 過奬.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá ngọ tỉnh lai tuyết mãn thuyền.", "definition": "Muôn dặm sông dài, muôn dặm trời,", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quá Đáng", "definition": "過當. Vượt qua sự thích hợp, vượt ra ngoài cả sự vừa phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Đường", "definition": "Cũng gọi Thướng Đường, Phó Đường. Chư tăng lên nhà trai dùng cơm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Độ", "definition": "過度. Vượt mức bình thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quá Độ Nhân Đạo Kinh", "definition": "Gọi đủ: Phật thuyết A Di Đà Tam Da Tam Phật Tát Lâu Phật Đàn Quá Độ Nhân Đạo Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quá Ư", "definition": "過於. Hơn. Nhiều hơn Vượt mức thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quách", "definition": "唬. Tiếng chim kêu, gáy Một âm khác là Hao. Xem Hao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quách Am Sư Viễn", "definition": "(郭 庵 師 遠, Kakuan Shion, khoảng thế kỷ 11-12): vị tăng của Phái Dương Kì thuộc Lâm Tông Trung Quốc, hiệu là Quách Am (郭 庵), xuất thân Hợp Xuyên (合 川, Tỉnh Cam Túc), họ Lỗ (魯). Ông kế thừa dòng pháp của Đại Tùy Nguyên Tĩnh (大隨元靜) và trú tại Lương Sơn (梁山) thuộc Phủ Thường Đức (常德 府, Tỉnh Hồ Nam). Tác phẩm Thập Ngưu Đồ Tụng (十牛圖頌) do ông thêm vào 10 bài tụng cho bản Mục Ngưu Đồ (牧牛圖) của Thanh Cư Hạo Thăng (清居晧昇), rất thịnh hành trong Thiền lâm Trung Quốc, Nhật Bản, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quách Bằng", "definition": "郭 朋 (1920-1990). Học giả Phật giáo hiện đại, người Đường Hà, Hà Nam, Trung Quốc. Thuở bé vì nghèo khó mà làm tăng, về sau lớn lên đi theo cách mạng. Sau giải phóng (1-10- 1949) ông nhậm chức Phó bí thư Hiệp hội Phật Giáo Trung Quốc, Phó giáo sư viện Nghiên cứu sinh thuộc viện Khoa học Xã hội Trung Quốc, Nghiên cứu viên Sở Nghiên cứu Tôn giáo Thế giới thuộc viện Khoa học Xã hội Trung Quốc. Nhiều năm theo đuổi nghiên cứu lịch sử tư tưởng Phật giáo Trung Quốc, ông siêng năng nghiên cứu học thuật thành tựu nổi bật; trong giới học thuật gọi ông là “Chàng Ba liều mạng”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quách Lạc", "definition": "廓 落. Rỗng lặng. Như Tịnh Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quách Lịnh Công", "definition": "(郭令公, 697-781): tên của vị danh tướng dưới thời vua Túc Tông nhà Đường, hiệu là Trung Võ (忠武), người đã từng dẹp yên vụ loạn An Sử (安史). Do vì ông được phong làm Phần Dương Công (汾陽公) nên được gọi là Quách Phần Dương (郭汾陽), bên cạnh đó ông còn làm chức Trung Thư Lịnh (中書令) nên cũng được gọi là Quách Lịnh Công.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quách Ma", "definition": "Kakuan (J), Kuoan (C), Kakuan (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quách Nhiên", "definition": "廓 然. Rỗng rang. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quách Thị", "definition": "廓 巿. Thành thị. Quách: vùng ngoại thành. Tiết Tăng Xán trong TĐT q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quách Thị Song Phu", "definition": "Hai chân Phật thị hiện thò ra ngoài kim quan.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quách Triệt", "definition": "廓 徹. Rỗng lặng thấu suốt. Tiết Nghệ ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quách Tượng", "definition": "Guo Xiang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quách Tử Nghi Phú", "definition": "唬子儀賦. Tên một bài phú bằng chữ Nôm của Nguyễn Hữu Chỉnh, danh sĩ thời Lê mạt. Quách Tử Nghi là danh tướng đời Đường (697-781). Nguyễn Hữu Chỉnh có ý so sánh mình với Quách Tử Nghi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái", "definition": "儈. Kẻ đứng môi giới trong việc buôn bán để ăn huê hồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Dạng", "definition": "怪樣. Hình dạng lạ lùng, không thấy bao giờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Dị", "definition": "怪異. Lạ lùng khác thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Kiệt", "definition": "怪傑. Người tài giỏi lạ thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Ngôn", "definition": "怪言. Lời nói lạ lùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Ngại", "definition": "𦊱礙. Cản trở, ngăn chặn. Như Trở ngại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Phệ", "definition": "卦筮. Gieo quẻ để bói toán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Quái", "definition": "夬夬. Chắc chắn, không còn nghi ngờ gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Sai", "definition": "怪 差. Quái gở, lạ lùng. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quái Thoại", "definition": "怪話. Như Quái ngôn 怪言.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Thạch", "definition": "怪石. Hòn đá có hình dáng lạ lùng Cũng chỉ loại đá đẹp gần như ngọc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Ti", "definition": "Cũng gọi Phù Ti.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quái Triệu", "definition": "怪兆. Điềm lạ, báo trước việc lạ xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Vật", "definition": "怪物. Loài thú lạ lùng đáng sợ Vật ít thấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Vị", "definition": "怪味. Đồ ăn lạ lùng, ít thấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quái Đản", "definition": "怪誕. Lạ lùng, không có thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán", "definition": "Tì-bát-xá-na – vipasyana: nghĩa là dùng trí tuệ để quán sát các sự lí. Khi tâm đã đình chỉ (chỉ) mọi suy nghĩ để chỉ chuyên chú vào một sự lí, hành giả hãy dùng trí tuệ để quán sát (quán) sự lí ấy.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quán Bất Tư Nghị Cảnh", "definition": "Cũng gọi Quán Bất Khả Tư Nghị Cảnh, Phân Biệt Bất Tư Nghị Cảnh, Thiện Thức Bất Tư Nghị Cảnh, Tín Giải Chính Nhân Duyên, Tín Chính Nhân Duyên, Thiện Thức Bất Tư Nghị Nhân Duyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Bất Tịnh", "definition": "Quán thân không trong sạch, nhờ đó mà gạt bỏ được lòng tham sắc. Phép quán này rất được coi trọng trong cõi Dục giới là nơi chúng sinh còn có lòng dục, nhất là sắc dục, dâm dục. Nam hay nữ đều dễ say mê đắm sắc đẹp của người khác giới tính. “Ta không thấy một sắc nào khác, này các Tỷ kheo, xâm chiếm và ngự trị tâm người đàn ông, như sắc người đàn bà… Ta không thấy một sắc nào khác, này các Tỷ kheo, xâm chiếm và ngự trị tâm người đàn bà như sắc người đàn ông.” (Tăng Chi I, tr 9-10).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quán Chiếu", "definition": "Xem Quán.Xem Minh Sát Tuệ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Châu", "definition": "貫珠. Hạt ngọc trai xâu thành chuỗi Chỉ âm thanh êm tai (như chuỗi ngọc rung động, các hạt ngọc va chạm vào nhau).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Chí", "definition": "觀 志 (910-970). Thiền tăng đời Ngũ Đại, họ Tống, tự An Nhiên, người Hồng Châu (nay là Nam Xương, Giang Tây) Trung Quốc. Sư nối pháp thiền sư Đồng An Đạo Phi, làm truyền nhân tông Tào Động đời thứ 4, trụ viện Đồng An ở kiến Xương (nay là Nam Thành, Giang Tây)", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quán Chỉ", "definition": "貫址. Nơi quê hương gốc gác của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Các", "definition": "館閣. Nhà cao lớn Chỉ tòa Hàn lâm của triều đình xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Cốc", "definition": "館榖. Ăn nhờ ở đậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Di Lặc Thượng Sanh Đâu Suất Thiên Kinh", "definition": "Xem Di Lặc Thượng Sanh Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Doanh", "definition": "貫盈. Đầy chuỗi, đầy xâu. Chỉ tội ác nhiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Dược Vương Dược Thượng Nhị Bồ Tát Kinh", "definition": "Phạm: Bhaiwajya-ràja Bhaiwajya samudgata bodhisattva sùtra. Cũng gọi Quán Dược Vương Dược Thượng Bồ Tát Kinh, Dược Vương Dược Thượng Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Dịch", "definition": "館驛. Nhà trạm bên đường để ghé nghỉ chân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Giác", "definition": "丱 角. Còn gọi: A Giác 阿 角. Đứa bé con, đầu để chỏm như hai cái sừng. Chương Đại Đồng Đầu Tử Thiền Sư trong CĐTĐL q. 15 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quán Giả", "definition": "冠者. Người được đội mũ, tức thanh niên 20 tuổi. Tục lệ Trung Hoa thời xưa, con trai nhà quyền quý tới 20 tuổi thì được làm lễ đội mũ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Hiền", "definition": "(觀賢, Kangen, 854-925): vị tăng của Chơn Ngôn Tông Nhật Bản, sống vào giữa thời Bình An, Tự Trưởng đời thứ 9 của Đông Tự, Tọa Chủ đời thứ 4 của Cao Dã Sơn, húy là Quán Hiền (觀賢), tên lúc nhỏ là A Cổ Ma Lữ (阿古麻呂); thường gọi là Bát Nhã Tự Tăng Chánh (般若寺僧正). Ông theo Thánh Bảo (聖寶) lên kinh đô, rồi năm 872 thì xuất gia thọ giới với Chơn Nhã (眞雅), đến năm 895 thì thọ phép Quán Đảnh với Thánh Bảo ở Đông Tự. Năm 900, ông làm chức Biệt Đương của Nhân Hòa Tự (仁和寺, Ninna-ji), rồi sáng lập ra Bát Nhã Tự (般若寺, Hannya-ji) ở vùng Sơn Thành (山城, Yamashiro). Đến năm 909, ông làm Tự Trưởng của Đông Tự, rồi năm sau thì làm Quyền Thiếu Tăng Đô, năm 916 thì làm Quyền Đại Tăng Đô, năm 918 làm Kiểm Hiệu của Đông Đại Tự (東大寺, Tōdai-ji), năm 919 làm Tọa Chủ của Đề Hồ Tự (醍醐寺, Daigo-ji), và sau được bổ nhiệm làm Tọa Chủ của Cao Dã Sơn. Cũng vào năm 919, ông thâu hồi lại được bộ Tam Thập Thiếp Sách Tử (三十帖册子) của Không Hải và đem nạp vào Tàng Kinh Các của Đông Tự. Ông được xem như là vị Tổ đời thứ 12 của Chơn Ngôn Tông. Trước tác của ông để lại có rất nhiều như Đại Nhật Kinh Sớ Sao (大日經疏抄) 4 quyển, Tam Thập Thiếp Sách Tử Khám Văn (三十帖册子勘文), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quán Hành", "definition": "慣行. Làm theo thói quen.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Hành Ngũ Phẩm Vị", "definition": "Chỉ cho “Quán hành tức” trong sáu hành vị (Lục Tức) của Bồ Tát Viên Giáo do Tông Thiên Thai lập ra. Đây là giai vị đã biết danh tự mà khởi quán hành, tâm quán sáng láng, lí và tuệ ứng hợp nhau, có khả năng thành tựu 5 Phẩm công đức: Tùy Hỉ Phẩm, Độc Tụng Phẩm, Thuyết Pháp Phẩm, Kiêm Hành Lục Độ và Chính Hành Lục Độ. Quán hành tức tương đương với Ngũ Phẩm Đệ Tử Vị trong 8 vị, nên được ghép chung lại mà gọi là Quán Hành Ngũ Phẩm Vị. (xt. Lục Tức).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Hư Không Tạng Bồ Tát Kinh", "definition": "Kuan Hsu-k'ung-tsang p'u-sa hui (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Hưu", "definition": "(832-912).Cao tăng Trung Quốc sống vào cuối đời Đường đầu thời Ngũ Đại, người Lan khê, Vụ Châu (Kim Hoa, Chiết Giang), họ Khương, tự Đức ẩn, Đức viễn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Khái", "definition": "灌溉. Tưới nước vào ruộng đất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Khê", "definition": "Kuan chi (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Khê Chí Nhàn", "definition": "(灌溪志閑, Kankei Shikan, ?-895): vị tăng của Lâm Tế Tông Trung Quốc, người vùng Quán Đào (館陶), Ngụy Phủ (魏府, Tỉnh Hà Bắc), họ là Sử (史). Hồi nhỏ ông theo xuất gia với Bá Nham (柏巖), sau kế thừa dòng pháp của Lâm Tế Nghĩa Huyền (臨濟義玄). Ông đã từng sống tại vùng Quán Khê (灌溪), Trường Sa (長 沙, Tỉnh Hồ Nam). Ông thị tịch vào ngày 29 tháng 5 năm thứ 2 niên hiệu Càn Ninh (乾寧) nhà Đường.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quán Kinh", "definition": "Xem Kinh Quán Vô Lượng Thọ Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Kinh Lục Duyên", "definition": "Sáu nhân duyên Đức Phật nói kinh Quán Vô Lượng Thọ. Thuyết này được căn cứ vào Tự Phần Nghĩa trong Quán Kinh Sớ của ngài Thiện Đạo mà lập ra. Sáu nhân duyên ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Kinh Mạn Đồ La", "definition": "Biến tướng Tịnh Độ được vẽ theo nội dung của Kinh Quán Vô Lượng Thọ. Trong Tịnh Độ Giáo của Nhật Bản thì Quán Kinh Mạn Đồ La là chỉ cho Đương Ma Mạn Đồ La, Trí Quang Mạn Đồ La (thời đại Nại Lương) và Thanh Hải Mạn Đồ La (giữa thời kì Bình An) được gọi chung là Tịnh Độ Tam Mạn Đồ La, là tranh vẽ biến tướng Tịnh Độ nổi tiếng về mĩ thuật của Tịnh Độ Giáo Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Kinh Nghĩa Sớ", "definition": "Commentary on the Contemplation Sūtra.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Kinh Nghĩa Sớ Chính Quán Kí", "definition": "Cũng gọi Quán Vô Lượng Thọ Kinh Nghĩa Sớ Chính Quán Kí, Linh Chi Quán Vô Lượng Thọ Kinh Nghĩa Sớ Chính Quán Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Kinh Ngũ Phần", "definition": "Chỉ cho 5 đoạn khoa tiết do ngài Thiện Đạo đời Đường chia ra để giải thích Kinh Quán Vô Lượng Thọ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Kinh Sớ", "definition": "(觀經疏, Kangyōsho): tên gọi tắt của Quán Vô Lượng Thọ Kinh Sớ (觀無量壽經疏, Kammuryōjukyōsho), 4 quyển, là bộ sách của Thiện Đạo (善導, 613-681) Trung Quốc, chú thích về Quán Vô Lượng Thọ Kinh (觀無量壽經), một trong ba bộ kinh trọng yếu của Tịnh Độ Giáo. Nó được phân làm 4 thiếp, nên được gọi là Quán Kinh Tứ Thiếp Sớ (觀經四帖疏), gọi tắt là Tứ Thiếp Sớ (四帖疏). Tại Trung Quốc, sách chú thích này không được quảng bá rộng rãi cho lắm; tuy nhiên, tại Nhật Bản, Pháp Nhiên (法然, Hōnen), Tổ khai sáng Tịnh Độ Tông, là người đầu tiên có duyên với bộ Sớ này; xem nó như là bậc thầy với quan niệm “thiên y Thiện Đạo (偏依善導, nương hẳn về phía Thiện Đạo)”. Sau này, Thân Loan (親鸞, Shinran), Tổ sư khai sáng Tịnh Độ Chơn Tông, cũng xem như là “Thiện Đạo độc minh Phật chánh ý (善導獨明佛正意, chỉ một mình Thiện Đạo làm sáng tỏ chánh ý của Phật)” và đã ca tụng bộ Sớ này trong bài Chánh Tín Niệm Phật Kệ (正信念佛偈) của ông. Như vậy, thư tịch này đã tạo ảnh hưởng rất to lớn trong việc hình thành tư tưởng Tịnh Độ của Nhật Bản. Bộ này chia làm 4 quyển: (01) Quyển 1: Quán Kinh Huyền Nghĩa Phần (觀經玄義分), thuật rõ ý nghĩa của Quán Vô Lượng Thọ Kinh, đầu tiên có bài kệ tụng Quy Tam Bảo Kệ (歸三寶偈), rồi chia thành 7 phần để giải thích rõ cách nhìn đối với kinh điển. (02) Quyển 2: Quán Kinh Tự Phần Nghĩa (觀經序分義), chú thích về phần tựa của kinh. (03) Quyển 3: Quán Kinh Chánh Tông Phần Định Thiện Nghĩa (觀經正宗分定善義), chú thích về Định Thiện Thập Tam Quán (定善十三觀) trong phần Chánh Tông. (04) Quyển 4: Quán Kinh Chánh Tông Phần Tán Thiện Nghĩa (觀經正宗分散善義), chú thích các phần Đắc Ích (得益), Lưu Thông (流通), Kì Xà (耆闍) trong phần Chánh Tông và thêm phần Bạt Hậu", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quán Kinh Sớ quyển 1 của ngài Thiện Đạo (Đại 37, 249 hạ) nói: “Muốn thành Phật, cần phải tu đầy đủ muôn hạnh mới thành tựu, há chỉ nương vào một hạnh (nhất hạnh)niệm Phật mà mong thành Phật được ư?”.", "definition": "II.Nhất Hạnh (683-727).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Luyện Huân Tu", "definition": "Từ ngữ gọi chung Quán Thiền, Luyện Thiền, Huân Thiền và Tu Thiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Lạp", "definition": "Quán là tắm Phật; Lạp chỉ cho ngày mãn hạ An Cư. Ngày mãn hạ 15 tháng 7 âm lịch hàng năm cử hành nghi thức tắm Phật, gọi là Quán Lạp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Mộc", "definition": "灌 沐. Rót nước thơm để tắm Phật. Như Tịnh Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quán Ngư", "definition": "貫魚. Cá xâu thành xâu Chỉ thứ tự trước sau như xâu cá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Nhân Duyên", "definition": "Một trong các phép quán của đạo Phật. Nhờ quán thấy tất cả các pháp đều do nhân duyên sinh, cho nên thâm hiểu mọi sự vật là vô thường, vô ngã, nhờ vậy tâm không còn tham đắm, được giải thoát.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quán Niệm Hơi Thở", "definition": "Ānāprānasmṛti (S), Ānāpānasati (P), Mindfullness of In- and Out-breathing, Mindfulness of breathing.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Niệm Niệm Phật", "definition": "Chuyên tâm lắng ý niệm Phật. Tức quán xét tưởng niệm tướng hảo, ánh sáng của thân Phật và thực tướng Pháp Thân, dùng miệng xưng danh niệm Phật. Cách niệm Phật này phải dứt tâm tán loạn, đoạn trừ vọng niệm, quán niệm tướng hảo của Phật... nên gọi là Quán niệm niệm Phật, thông thường chỉ cho tưởng niệm Phật A Di Đà. Niệm Phật nói trong 6 niệm, 10 niệm đều thuộc Quán niệm niệm Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Niệm Pháp Môn", "definition": "Cũng gọi Quán Niệm A Di Đà Phật Tướng Hải Tam Muội Công Đức Pháp Môn, Quán Niệm A Di Đà Tập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Pháp", "definition": "Phương pháp quán tưởng chân lí, là pháp môn thực hành phổ thông của Phật Giáo. Những dụng ngữ đồng loại có: Quán, Tu Quán, Quán Niệm, Quán Tưởng, Quán Hành, Quán Sát, Quán Môn... gọi chung là Quán Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Hương Thang", "definition": "Nước thơm hơi nóng dùng để tắm tượng Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Hội", "definition": "Hội tắm Phật. Tức là pháp hội tắm gội tượng Phật được cử hành vào ngày mồng 8 tháng 4 hàng năm (ngày Đức Phật Thích Ca Mâu Ni Đản Sinh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Kệ", "definition": "Cũng gọi Dục Phật Kệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Tam Muội", "definition": "Gọi tắt: Quán Phật. Nhất Tâm quán tưởng tướng hảo và công đức của thân Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Tam Muội Hải Kinh", "definition": "Phạm: Buddha-dhyànasamàdhisàgara- sùtra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Tam Muội Hải Kinh Lục Thí", "definition": "Sáu thí dụ để ví dụ cho công đức thù thắng của tam muội Niệm Phật nói trong Kinh Quán Phật Tam Muội Hải.Sáu thí dụ ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phật Tam Muội Kinh", "definition": "Buddha-dhyāna-samādhiśāgāra Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Phật Vi Tông", "definition": "Pháp môn quán Phật do ngài Thiện Đạo đời Đường phán lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phổ Hiền Bồ Tát Hành Pháp Kinh", "definition": "Cũng gọi Xuất Thâm Công Đức Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Phục", "definition": "(?-?).Cao tăng Trung Quốc sống vào đời Tống, hiệu Tiếu Am. Sư trụ ở chùa Hoa Nghiêm tại Tì Lăng. Sư cùng với các vị Đạo Đình, Sư Hội, Hi Địch được gọi chung là Hoa Nghiêm Tứ Đại Gia.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Quân", "definition": "冠軍. Người đứng đầu, người giỏi hơn hết Vị tướng chỉ huy một đoàn binh lính đông đảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Quần", "definition": "冠群. Đứng đầu đám đông. Giỏi vượt lên trên mọi người. Như: Siêu quần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Sanh", "definition": "館甥. Cho ở rể Làm nhà cho con rể ở Người ở gửi rể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Sát", "definition": "Đồng nghĩa: Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sát Chính Hành", "definition": "Đối lại: Quán Sát Tạp Hành. Một lòng chuyên niệm quán tưởng Y báo và Chính báo trang nghiêm ở cõi Cực Lạc của Đức Phật A Di Đà, gọi là Quán Sát Chính Hành, 1 trong 5 Chính Hành vãng sinh Cực Lạc do Tông Tịnh Độ lập ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sát Chư Pháp Hành Kinh", "definition": "Kinh, 4 quyển, do ngài Xà Na Quật Đa dịch vào đời Tùy, được thu vào Đại Chính Tạng tập 15.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sát Môn", "definition": "Pháp môn dùng trí tuệ quán sát công đức trang nghiêm của cõi Tịnh Độ, công đức thành tựu sự nghiệp tự lợi lợi tha của Đức Phật A Di Đà và công đức trang nghiêm của các Bồ Tát ở cõi ấy, 1 trong 5 Niệm môn do Tông Tịnh Độ lập ra. (xt. Ngũ Niệm Môn).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sát Nghĩa Thiền", "definition": "Thiền Định biết rõ lí “Nhân Vô Ngã”, xa lìa mọi sự tạo tác và ý niệm phân biệt mình và người, tùy thuận quán sát nghĩa “Pháp Vô Ngã”, là 1 trong 4 loại Thiền được nêu trong Phẩm Tập Nhất Thiết Pháp của Kinh Đại Thừa Nhập Lăng Già quyển 3.(xt. Tứ Chủng Thiền).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sát Pháp Nhẫn", "definition": "Quán xét lí sâu xa của tất cả pháp không sinh không diệt, an nhiên nhẫn chịu, trong tâm vắng lặng chẳng động, là 1 trong 2 loại nhẫn của Bồ Tát tu hành. [X. Kinh Bồ Tát Địa Trì Q.5; Đại Minh Tam Tạng Pháp Số Q.5]. (xt. Nhị Nhẫn).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sát Tha Tâm Thần Túc", "definition": "Xem Chiên Niệm Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Sở Duyên Duyên Luận", "definition": "Āamba-naparīkśā śāstra (S), Ālambanaprtyaya dhyāna śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Sở Duyên Duyên Luận Thích", "definition": "Cũng gọi Quán Sở Duyên Luận Thích, Quán Sở Duyên Thích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Sứ Tự", "definition": "館 使 寺. Chùa nằm giữa phố Quán Sứ, Hà Nội, Việt Nam, mang biển số nhà 73. Cả khu vực này là đất thôn An Tập xưa. Tại đây, thời đầu đời Lê (thế kỷ XV) có lập một khu nhà gọi là Quán Sứ để tiếp đón sứ thần các nước Lão Qua, Chiêm Thành… khi họ tới Thăng Long. Vì họ đều theo đạo Phật nên một ngôi chùa được dựng ở cạnh Quán Sứ để tiện cho các sứ thần dó tụng niệm cúng bái. Về sau, nhà Quán Sứ bỏ đi nhưng ngôi chùa được giữ lại. Hiện nay trong chùa còn nhiều bia đá, đáng chú ý là bia do Lê Duy Trung soạn năm 1842 có đoạn ghi: “… Chùa Quán Sứ ở phía nam thành. Vị sư đến xin ta (tức Lê Duy Trung) bài văn bia nói rằng: Chùa ở thôn An Tập, huyện Thọ Xương, tiền đường thờ Phật, hậu đường thờ Lý Quốc Sư…”", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quán Tam Ma Địa Đoạn Hành Thành Tựu Thần Túc", "definition": "Xem Quán định.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tha Tâm", "definition": "Xem Chiên Niệm Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thân", "definition": "Kāyanupassana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thân Ngủ Chủng Bất Tịnh", "definition": "觀身五種不凈 (Tích Huyền Ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quán Thông", "definition": "貫通. Hiểu biết suốt hết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Thất", "definition": "Nơi thiết lập đàn tràng bí mật, dùng những đạo cụ đặc biệt để cử hành nghi thức quán đính, chủ yếu chỉ cho đạo tràng quán đính Truyền pháp của Thai Mật (Mật Giáo do Tông Thiên Thai Nhật Bản truyền) Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thần Túc", "definition": "Vīmaṃsā-samādhi (S), (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế", "definition": "冠世. Trùm đời. Giỏi hơn hết mọi người ở đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Thế Âm", "definition": "Xem Quán Thế Âm Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Bồ Tát", "definition": "Tchenrezig (T), Guan Shr Yin (C), Avalokiteshvara (S), Avalokitecvara (S), Avaloki-teśvara (S), Chenrezi (T), Chenresi (T), Kwan Seum Bosal (K), Great Compassionate One, Mahākaruna (S); Kouan Yin (C); Kouan-non (J); Lokecvara (S), Avalokitesvara (S); Guan Yin, Guan Shr Yin (C), Byakue-Kannon (J), Kwan Um (K), Quán Tự Tại, Từ tâm bất sát, Quán Tự Tại Bồ Tát, Quan Âm, Quán thế Âm, Quan Thế Kwan Seum Bosal (K) Âm; A Na Bà Lâu Cát Để Du, A Lê Gia Bà Lâu Cát, A Phạ Lư Tích Để Thấp Phạt La, A Bà Lư Cát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Bồ Tát Bí Mật Tạng Như Ý Luân Đà La Ni Thần Chú Kinh", "definition": "Gọi tắt: Quán Thế Âm Bồ Tát Bí Mật Tạng Thần Chú Kinh, Như Ý Luân Đà La Ni Thần Chú Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thế Âm Bồ Tát Như Ý Ma Ni Đà La Ni Kinh", "definition": "Xem Như Ý Ma Ni Đà La Ni Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Bồ Tát Phổ Môn Phẩm", "definition": "Phạm: Samantamukhaparivarto nàmàvalokitezvara-vikurvaịa-nirdeza", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thế Âm Bồ Tát Thọ Ký Kinh", "definition": "Avalokiteśvara-bodhisattva-mahāsthama-prāpta-bodhisattva-vyākaraṅa Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Bồ Tát Thụ Kí Kinh", "definition": "Phạm: Avalokitezvara-bodhisattvamahàsthàma-pràpta-bodhisattvavỳakaraịa- sùtra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thế Âm Bồ Tát Đắc Đại Thế Chí Thọ Ký Kinh", "definition": "Avalokiteśvara-bodhisattva-mahā-sthāma-prāpta-bodhisattva-vyākaraṅa-Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Kinh", "definition": "Xem Quán Thế Âm Phổ Môn Phẩm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Phổ Môn Phẩm", "definition": "Samantamukhaparivarto-nāmavalokiteśvara-vikurvana-nirdeśa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Quán Kinh", "definition": "Kuan-shih-yin kuan ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Thế Âm Tín Ngưỡng", "definition": "Chỉ cho tín ngưỡng tông giáo lấy Bồ Tát Quán Thế Âm làm đối tượng thờ phụng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thế Âm Ứng Nghiêm Kí", "definition": "Tác phẩm, 1 quyển, được thu vào “Lục Cổ Dật Quán Thế Âm Ứng Nghiệm Kí Đích Nghiên Cứu” do ông Mục Điền Đế Lượng soạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thụ", "definition": "Quán cây Bồ Đề. Đức Thế Tôn sau khi thành đạo, rời tòa Kim Cương mà quán cây Bồ Đề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Thủ", "definition": "Cũng gọi Quán Chủ, Quản Chủ. Tiếng dùng của Phật Giáo Nhật Bản. Quán là quê quán; Thủ là đầu, trước hết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Triệt", "definition": "Parinna (S), Full understanding.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Trí", "definition": "Tức là chánh trí quán chiếu thấy rõ chân tướng của vạn pháp.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quán Tuyệt", "definition": "冠絶. Vượt lên trên hết. Giỏi hơn hết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Tuế", "definition": "(丱歲): thưở bé, tuổi nhỏ. Quán (丱) có nghĩa là bện tóc làm hai múi hai bên, nên quán tuế (丱歲) là tuổi bện tóc thành hai múi, tuổi để tóc chỏm. Như vậy, tuổi đồng sấn (童齔) còn trẻ nhỏ hơn quán tuế vài tuổi. Như trong bài Hậu Chu Minh Uy Tướng Quân Lương Công Thần Đạo Bi (後周明威將軍梁公神道碑) của thi sĩ Dương Quýnh (楊炯, 650-695) nhà Đường có câu: “Quán tuế đằng phương, thiều niên siêu ái (丱歲騰芳、髫年超靄, tuổi nhỏ hiển đạt, lớn lên siêu quần).” Trong Ngự Tuyển Ngữ Lục (御選語錄, 卍 Tục Tạng Kinh Vol. 68, No. 1319) có đoạn rằng: “Sư, Vĩnh Gia nhân, tánh Đới thị; quán tuế xuất gia, biến thám Tam Tạng, tinh Thiên Thai Chỉ Quán viên diệu pháp môn (師、永嘉人也、姓戴氏、丱歲出家、遍探三藏、精天台止觀圓妙法門, sư người vùng Vĩnh Gia, họ là Đới; tuổi nhỏ xuất gia, tìm khắp Tam Tạng, tinh thông pháp môn mầu nhiệm tròn đầy của Thiên Thai Chỉ Quán).” Hơn nữa, trong Tục Đăng Chánh Thống (續燈正統, 卍 Tục Tạng Kinh Vol. 84, No. 1583) quyển 32 cũng có đoạn: “Trường Sa Phủ Quy Sơn Ngũ Phong Như Học Thiền Sư, Lâm Đồng Nhậm thị tử, quán tuế thất hỗ, tùng Ngũ Đài Thiên Tề trĩ phát, viên cụ ư Trừng Luật Sư (長沙府溈山五峰如學禪師、臨潼任氏子、丱歲失怙、從五臺天齊薙髮、圓具於澄律師, Thiền Sư Như Học ở Quy Sơn Ngũ Phong, Phủ Trường Sa, con nhà họ Nhậm ở Lâm Đồng, tuổi nhỏ đã mất cha, xuống tóc xuất gia với Thiên Tề ở Ngũ Đài Sơn, thọ Cụ Túc giới với Trừng Luật Sư).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quán Tác", "definition": "Cũng gọi Nội Đàn, Tâm Đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm", "definition": "Quán Chiếu tâm mình để thấy rõ bản tính của tâm. Đặc biệt Tông Thiên Thai hay dùng từ “Quán Tâm”, như Nhất Tâm Tam Quán, Nhất Niệm Tam Thiên... đều là những dụng ngữ có liên quan đến quán tâm. Tu “Nhất Tâm Tam Quán” tức là đối với một niệm vọng tâm của chính mình, cùng lúc phải quán nó là Giả, là Không, là Trung. Đối tượng của sự quán sát là Tâm, Phật và Chúng Sinh, trong đó, tự quán tâm mình là dễ dàng nhất và cũng là quan trọng nhất. Bởi vì Tâm là gốc rễ của muôn vật, mà cũng là cội nguồn của mê vọng, cho nên cần phải quán xét bản tính của tâm mình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Bản Tôn Sao", "definition": "Gọi đủ: Như Lai Diệt Hậu Ngũ Ngũ Bách Tuế Thủy Quán Tâm Bản Tôn Sao.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Giác Mộng Sao", "definition": "Gọi tắt: Giác Mộng Sao.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Huyền Xu", "definition": "Tác phẩm, 1 quyển, do ngài Vĩnh Minh Diên Thọ (904-975) soạn vào đời Tống, được thu vào Vạn Tục Tạng tập 114.Trong sách này, ngài Diên Thọ đã đứng trên lập trường của Thiền Tông mà bàn về huyền chỉ quán tâm của Phật Giáo, cho rằng nếu người ta muốn thoát khỏi sự trói buộc của các trần cảnh, chấm dứt phân biệt, thực hành đầy đủ 6 Ba La Mật: Bố thí, trì giới..., hộ trì chính pháp, hiểu rõ pháp tướng, thấu suốt 4 đế, làu thông Tam Tạng, hàng phục 4 ma, biện biệt nhơ sạch...thìtất cả đều phải do pháp quán tâm mới thành tựu được. Nếu không quán tâm thì hết thảy đều hỗn loạn điên đảo, như 96 thứ ngoại đạo sai lầm. Cuối quyển có phụ thêm bài kệ biền ngẫu theo thể văn tứ lục (4 chữ, 6 chữ), nguyện sinh Duy Tâm Tịnh Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Luận", "definition": "I.Quán Tâm Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Luận Sớ", "definition": "Tác phẩm, 5 quyển, do ngài Quán Đính giảng vào đời Tùy, ngài Trí Việt soạn tập, được thu vào Đại Chính Tạng tập 46.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Nhị Bách Vấn", "definition": "Gọi đủ: Pháp Trí Di Biên Quán Tâm Nhị Bách Vấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Thích", "definition": "Một trong 4 phương thức giải thích mà Đại Sư Trí Khải Tông Thiên Thai sử dụng để giải thích câu văn Kinh Pháp Hoa. Tức là lấy pháp nghĩa do Đức Như Lai nói làmđối cảnh để quán tâm, nhờ quán xét tâm mình một cách sâu rộng mà vào được diệu lí thực tướng, gọi là Quán Tâm Thích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Thích Hoa Nghiêm Kinh Đề", "definition": "Dùng Nhất Tâm Pháp Giới để giải thích đề Kinh Hoa Nghiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Thích Hoa Nghiêm Kinh Đề Thất Tự", "definition": "觀心釋華嚴經題七字 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quán Tâm Thực Pháp", "definition": "Cũng gọi Quán Thực Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tâm Tụng Kinh Pháp Kí", "definition": "Cũng gọi Quán Tâm Tụng Kinh Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tính", "definition": "慣性. Cái nết quen đi rồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Tương Thuộc Luận", "definition": "Saṃbandha-pariksa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tưởng", "definition": "Là tập trung tâm niệm vào một đối tượng, nhằm diệt trừ vọng niệm. Ở trong pháp môn tu Tịnh Độ, quán tưởng là một trong bốn cách niệm Phật, gọi là “quán tưởng niệm Phật”; tức là nhất tâm quán tưởng thân tướng tốt đẹp viên mãn của đức Phật A Di Đà. Cho đến khi quán tưởng thuần thục thì chánh định hiện tiền.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quán Tưởng Danh Hiệu Phật", "definition": "Buddha remembrance.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tưởng Hình Ảnh", "definition": "Utpattikrama (S), Visualization stage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tưởng Niệm Phật", "definition": "Ngồi ngay thẳng, chuyên tâm chính niệm quán tưởng tướng hảo trang nghiêm của thân Phật, là 1 trong 4 cách niệm Phật được nói trong Phổ Hiền Hành Nguyện Phẩm Sớ Sao của ngài Tông Mật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Tượng", "definition": "Tức là chiêm ngưỡng hình tượng chư Phật và Bồ-tát. Ở trong pháp môn tu Tịnh Độ, quán tượng là một trong bốn cách niệm Phật, gọi là “quán tượng niệm Phật”, tức là, mắt chiêm ngưỡng hình tượng của Phật A Di Đà, miệng xưng niệm danh hiệu Phật A Di Đà, thì tâm không tán loạn, bản tính Di Đà từ đó mà hiển hiện. Cứ như thế, niệm niệm không gián đoạn, tâm ý thuần nhất, không có gì xen lộn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quán Tượng Niệm Phật", "definition": "Vừa chiêm ngưỡng tượng Phật, vừa niệm danh hiệu Phật, nhớ tới những công đức của Phật. Ở Việt Nam, những người tu theo pháp môn Tịnh Độ, đều thường quán sát, chiêm ngưỡng tượng Phật A Di Đà và niệm danh hiệu Phật A Di Đà.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quán Tẩy", "definition": "灌洗. Đổ nước mà rửa. Rửa ráy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Tập", "definition": "慣習. Thói quen Quen đi Cũng nói: Tập quán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Tổng Tướng Luận Tụng", "definition": "Sarva-lakṣaṇadhyāna-śāstra-kārikā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Từ", "definition": "冠詞. Chữ đứng trước danh từ, còn gọi là Mạo từ (Article). Cũng đọc: Quan từ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Từ Bi", "definition": "Là một trong các phép quán của đạo Phật nhằm đoạn trừ lòng sân giận. Đó là phép quán, thấy tất cả chúng sinh đều giống như mình không khác, do đó, phải có lòng từ, lòng bi đối với mọi chúng sinh, dù là người hay một sinh vật nào khác.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quán Tử Thi", "definition": "Sīvathikā (S), Aśubha-bhāvanā (S), Meditation on dead body.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tự Tại", "definition": "Xem Bồ Tát Quán Thế Âm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tự Tại Bồ Tát", "definition": "Xem Quán Thế Âm Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tự Tại Bồ Tát Như Ý Luân Du Già", "definition": "Avalokiteśvara-cintamāṇi-bodhisattva-yogādharma-mahārtha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tự Tại Bồ Tát Như Ý Luân Du Già Niệm Tụng Pháp", "definition": "Xem Quán Tự Tại Bồ Tát Như Ý Luân Du Già.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Tự Tại Vương Như Lai", "definition": "Tên gọi khác của Đức Phật A Di Đà ở phương Tây, là 1 trong 5 Đức Phật của Mật Giáo, mật hiệu là Thanh Tịnh Kim Cương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Viên", "definition": "觀 圓 (cuối thế kỷ XIII đầu thế kỷ XIV). Thiền tăng đời Trần, hiệu Quán Viên ở chùa Đông Sơn, giới hạnh thanh tịnh, tuệ giải tròn đầy, mấy mươi năm mà không xuống núi. Gặp lúc vua Trần Anh Tông (1293-1314) đau mắt đã hơn tháng, chữa trị không hiệu quả, ngày đêm đau nhức. Bỗng vua nằm mộng thấy một vị sư lấy tay xoa vào mắt. Vua hỏi sư từ đâu đến và tên gì? Sư đáp: “Tôi là Quán Viên, đến cứu mắt vua”. Tỉnh mộng, mắt liền hết đau, qua vài ngày mắt vua khỏi hẳn. Vua cho người tìm hỏi trong giới tăng sỉ, quả có người tên Quán Viên ở chùa Đông Sơn. Nhà vua sai người mời đến, rõ ràng là vị sư đã thấy trong mộng. Vua rất lấy làm lạ, phong chức Quốc sư, ban thưởng rất hậu. Sư đều đem phân phát hết không để lại một đồng nào, vẫn mặc y vá trở về núi, dường như chẳng quan tâm. Từ đó về sau, sư đi vân du khắp núi sông châu huyện làng mạc, nếu ở đâu có miếu thờ thần không chính đáng, làm hại dân, đều bị sư quở trách đuổi đi, dẹp phá miếu đền. Còn những vị thần lớn phần nhiều xin quy y thụ giới với sư, được sư dạy phải bảo vệ dân chúng và giảm bớt việc đòi cúng kiến sinh vật. Không rõ sư tịch lúc nào, ở đâu và thuộc hệ phái nào. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quán Vô Lượng Thọ Kinh", "definition": "Amitāyurdhyāna-Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Vô Lượng Thọ Kinh Nghĩa Sớ", "definition": "I.Quán Vô Lượng Thọ Kinh Nghĩa Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Lượng Thọ Kinh Sớ", "definition": "I.Quán Vô Lượng Thọ Kinh Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Lượng Thọ Phật Kinh", "definition": "Kuan Wu-liang-shou-fo ching (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Vô Lượng Thọ Phật Kinh Nghĩa Sớ", "definition": "Cũng gọi Quán Vô Lượng Thọ Kinh Nghĩa Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Lượng Thọ Phật Kinh Sớ", "definition": "I.Quán Vô Lượng Thọ Phật Kinh Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Lượng Thọ Phật Kinh Sớ Diệu Tông Sao", "definition": "Cũng gọi Quán Vô Lượng Thọ Kinh Sớ Diệu Tông Sao, Quán Kinh Sớ Diệu Tông Sao, Quán Kinh Diệu Tông Sao, Diệu Tông Sao. Tác phẩm, 6 quyển, do ngài Tứ Minh Tri Lễ soạn vào đời Tống, được đưa vào Đại Chính Tạng tập 37.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Lượng Thọ Phật Kinh Đồ Tụng", "definition": "Cũng gọi Quán Vô Lượng Thọ Phật Kinh Phụ Đồ Tụng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Lượng Thọ Phật Kinh Ước Luận", "definition": "Tác phẩm, 1 quyển, do cư sĩ Bành Tế Thanh soạn vào đời Thanh, được thu vào Vạn Tục Tạng tập 33.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Vô Thường", "definition": "Quán thấy tất cả các pháp, mọi sự vật đều biến đổi vô thường, do đó mà đoạn trừ lòng tham đắm, tâm được giải thoát, tự do và tự tại, siêng năng tinh tấn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quán Vực", "definition": "灌域. Vùng đất mà con sông chảy qua (vùng được tưới bằng nước sông).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Xuyến", "definition": "貫穿. Thông suốt hết Ta còn hiểu là một tay làm hết mọi việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Xá", "definition": "館舍. Nhà trọ. Truyện Lục Vân Tiên có câu: “Tìm nơi quán xá tiện đường nghỉ ngơi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quán Xét", "definition": "Anucināti (anu + ci + nā), anuvicināti (anu + vi + ci + nā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quán niệm là quán tưởng Phật thân, Phật Pháp; khẩu niệm là dùng miệng xưng danh hiệu của Phật; tâm niệm là dùng tâm tưởng nhớ Phật và Bồ Tát. [X. Luận Câu Xá Q.4; Luận Đại Thừa Quảng Ngũ Uẩn]. (xt. Thập Niệm).", "definition": "III.Niệm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Huyền Nghĩa", "definition": "Cũng gọi Biệt Hành Huyền Nghĩa, Biệt Hành Huyền, Quán Âm Huyền, Quán Âm Kinh Huyền Nghĩa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Huyền Nghĩa Kí", "definition": "Cũng gọi Quán Thế Âm Bồ Tát Phổ Môn Phẩm Huyền Nghĩa Kí, Quán Âm Biệt Hành Huyền Kí, Biệt Hành Huyền Nghĩa Kí, Biệt Hành Huyền Kí, Quán Âm Kinh Huyền Nghĩa Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Kinh", "definition": "Xem Quán Thế Âm Phổ Môn Phẩm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Âm Kinh Trì Nghiêm Kí", "definition": "Cũng gọi Quán Thế Âm Trì Nghiệm Kí, Quán Âm Trì Nghiệm Kí, Quán Thế Âm Kinh Chú Trì Nghiệm Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Mạn Đồ La Bát Đại Bồ Tát", "definition": "Tám vị Bồ Tát Đại Quán Tự Tại nói trong Kinh Thiên Quang Nhãn Quán Tự Tại Bồ Tát Bí Mật Pháp. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Nghĩa Sớ", "definition": "Cũng gọi Phổ Môn Phẩm Sớ, Biệt Hành Nghĩa Sớ, Quán Âm Kinh Sớ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Nghĩa Sớ Kí", "definition": "Cũng gọi Quán Âm Kinh Nghĩa Sớ Kí, Quán Âm Biệt Hành Sớ Kí, Biệt Hành Nghĩa Sớ Kí, Biệt Hành Sớ Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Phổ Hiền Đà La Ni Kinh", "definition": "Cũng gọi Thanh Tịnh Quán Thế Âm Bồ Tát Phổ Hiền Đà La Ni Kinh, Thanh Tịnh Quán Thế Âm Phổ Hiền Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Sám Pháp", "definition": "Cũng gọi Thỉnh Quán Thế Âm Sám Pháp, Thỉnh Quán Thế Âm Bồ Tát Tiêu Phục Độc Hại Đà La Ni Tam Muội Nghi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Tiêm", "definition": "Những cái thẻ bằng tre đặt ở trước tượng", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Tố", "definition": "Trì Trai Quán Âm. Tập tục địa phương ở huyện Ngô tỉnh Giang Tô, Trung Quốc, từ ngày mồng 1 tháng 2 âm lịch bắt đầu trì trai, đến ngày 19 là ngày Đản Sinh của Bồ Tát Quán Âm thì chấm dứt, gọi là Quán Âm Tố. Lại trì trai trong thời gian từ ngày mồng 9 tháng 6 âm lịch đến ngày 19 là ngày Bồ Tát Quán Thế Âm thành đạo, cũng gọi là Quán Âm Tố.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Từ Lâm Tập", "definition": "Tác phẩm, 3 quyển, do ngài Hoằng Tán biên tập vào năm Khang Hi 7 (1668) đời Thanh, được thu vào Vạn Tục Tạng tập 149.Nội dung sách này do biên tập những kinh điển và sự tích cảm ứng có liên quan đến tín ngưỡng Quán Thế Âm mà thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Âm Viên Thông Tam Chân Thực", "definition": "Ba thứ chân thực về Nhĩ Căn Viên Thông của Bồ Tát Quán Thế Âm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính", "definition": "I.Quán Đính.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Bộ", "definition": "I.Quán Đính Bộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Gia Hạnh", "definition": "Cũng gọi Nhập Đàn Gia Hạnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Hộ Ma", "definition": "Pháp tu đốt các phẩm vật cúng dường như hương hoa, nhũ mộc... để cầu tiêu trừ tai họa, chướng nạn của hành giả thụ pháp Quán Đính trong Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Kinh", "definition": "Phạm: Mahàbhiweka-mantra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Phan", "definition": "Gọi tắt: Quán Đính.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Tam Muội", "definition": "Một trong 108 tam muội.Tam Muội (Phạm: Samàdhi) là trạng thái vắng lặng khi tâm an trụ ở 1 cảnh. Người vào được tam muội này thì thấy khắp tất cả các tam muội khác, như đứng trên đỉnh núi thấy toàn thể cảnh vật. [X. Kinh Đại Phẩm Bát Nhã Q.27; Luận Đại Trí Độ Q.47].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Tam Muội Da", "definition": "Tam Muội Da nghĩa là thệ nguyện trọng yếu. Trong Mật Giáo, khi cử hành pháp Quán Đính, hành giả phát thệ nguyện trọng yếu, kiên cố, gọi là Tam Muội Da. Tức căn cứ vào tác pháp gọi là Quán Đính; còn căn cứ vào tâm người nhận quán đính thì gọi là Tam Muội Da, tên gọi tuy khác, nhưng thể tính thì là một.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Đàn", "definition": "Cũng gọi Mật Đàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Đàn Mạn Đồ La", "definition": "Tức Mạn Đồ La 12 Đại thánh được dùng trong đàn Chính Giác của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đính Ấn Minh", "definition": "Chỉ cho ấn khế (ấn) và Chân Ngôn (minh) mà vị A Xà Lê trao cho hành giả khi cử hành các pháp quán đính: Truyền Pháp, Kết Duyên, Du Kì... trong Tông Chân Ngôn Nhật Bản. Trong đó, ấn của quán đính Truyền pháp thông thường dùng ấn Vô Sở Bất Chí và ấn Ngũ cổ. Ấn Vô Sở Bất Chí có mở, đóng khác nhau; ấn Ngũ cổ thì có trong, ngoài bất đồng. Chân Ngôn cũng có nhiều loại: Ngũ Tự Minh (Chân Ngôn 5 chữ), Nhất Tự Minh... Còn ấn minh của 2 bộ Kim Cương và Thai Tạng thì có các loại: Hai ấn 2 minh; 1 ấn 2 minh; 1 ấn 1 minh... [X. Bí Mật Trang Nghiêm Truyền Pháp Quán Đính Nhất Dị Nghĩa; Quán Đính Truyền Thụ Bí Lục Q.thượng].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quán Đĩnh", "definition": "Xem Quán Đảnh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Đảnh", "definition": "“Quán Đảnh” nghĩa là dùng nước rưới trên đầu; đó là một nghi lễ được tổ chức trang trọng để thăng tiến một người (đã được chọn lựa) lên một địa vị nhất định; hay nói chính xác hơn, quán đảnh là lễ “rưới nước”, một nghi thức quan trọng của Mật Giáo, trong đó, một vị a-xà-lê sẽ “truyền thọ” cho một Phật tử để người này trở thành một tín đồ chính thức của Mật Giáo. Thật ra, lễ quán đảnh đã từng được dùng ở triều đình các vua chúa Ấn-độ thời cổ, tiếng Phạn gọi là “abhisekha”. Nghi thức này là phần quan trọng nhất trong lễ đăng quang của vua và lễ lập thái tử. Khi cử hành nghi thức này, một vị đạo sĩ Bà-la-môn danh tiếng, đạo cao đức trọng – thường là vị quốc sư của triều đình – sẽ dùng nước lấy từ bốn biển, rưới lên đầu vua hay thái tử để chúc phúc; đối với vua thì có ý nghĩa rằng, kể từ lúc ấy, ông đã được công nhận là vị chúa tể của cả thần dân; đối với vị thái tử thì có ý nghĩa rằng, kể từ lúc ấy, ông đã được công nhận là người thừa kế chính thức để sẽ trở thành vị chúa tể của thần dân. Tương tự như thế, trong Mật Giáo, người tín đồ khi thọ nhận lễ quán đảnh, cũng được thừa nhận sẽ trở thành một vị chủ tể của một thế giới tâm linh, tức là một đức Phật. Trong lễ quán đảnh này, vị a-xà-lê dùng nước từ năm bình (tượng trưng cho năm trí của Phật) rưới lên đầu của đệ tử, biểu thị ý nghĩa rằng, đó là người thừa kế địa vị Phật-đà.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quán Đảnh Bồ Tát.", "definition": "Xem Quán Đảnh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Đảnh Tam Muội", "definition": "Vilokita-murdha-samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quán Đỉnh", "definition": "Quán: rưới; đỉnh: đầu. Lễ tôn giáo rưới nước lành lên đầu. Ngày xưa, ở Ấn Độ, khi một nhà vua mới lên ngôi, người ta tổ chức nghi lễ quán đỉnh long trọng. Trong buổi lễ, vị đứng đầu Tăng chúng trong nước làm phép lành rưới nước của bốn biển lên đầu nhà vua mới. Trong Tăng chúng, ở một số nước Phật giáo khi làm lễ truyền giới, truyền pháp, người ta cũng theo nghi thức vị sư trưởng rưới nước lành lên đầu người mới được thọ giới.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quán Định", "definition": "Vismamsa-samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quáng", "definition": "廣. Ngang. Nằm ngay 15 cỗ xe gọi là một Quáng Các âm khác là Quáng, Khoát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát", "definition": "刮. Đẽo gọt. Nạo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Cốt Chi Ngôn", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quát Lâu", "definition": "蛞螻. Con ve sầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Ngôn", "definition": "括言. Nói bao gồm cho gọn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Phát", "definition": "括髮. Cột tóc lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Thiệt", "definition": "刮舌. Nạo lưỡi cho sạch Đồ để nạo lưỡi cho sạch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Thâu", "definition": "括收. Thu gồm lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Toát", "definition": "括撮. Thâu tóm lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Tử", "definition": "聒子. Con nòng nọc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quát Đốc Thành Gia", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân", "definition": "𠁈. Như chữ Quân 君.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Binh", "definition": "軍兵. Chỉ chung lính tráng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Bình", "definition": "均平. Ngang nhau, bằng nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Bị", "definition": "軍備. Sửa soạn xếp đặt đầy đủ cho binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Chính", "definition": "軍政. Việc tổ chức và điều hành quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Chế", "definition": "軍制. Luật lệ về cách tổ chức binh đội trong một quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Chủ", "definition": "君主. Ông vua Có vua đừng đầu trong nước. Chỉ quốc gia theo chế độ vua chúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Công", "definition": "軍功. Việc tốt lập được trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Công Bội Tinh", "definition": "軍功佩星. Ngôi sao đeo để chứng tỏ có công lao với binh đội. Một thứ huy chương quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Cơ", "definition": "軍機. Việc trọng yếu trong hoạt động của binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Cảng", "definition": "軍港. Cửa sông cửa biển dành riêng cho việc chuyển vận binh lính võ khí quân nhu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Cảnh", "definition": "軍警. Xem xét răn dạy binh lính Người duy trì kỉ luật của binh lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Cổ", "definition": "軍鼓. Cái trồng dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Danh", "definition": "Cũng gọi Khanh Danh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Dinh", "definition": "軍營. Nơi trú đóng của binh đội. Cũng đọc Quân doanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Dung", "definition": "軍容. Bộ dạng, vẻ bề ngoài của binh đội. Td: Quân dung chỉnh túc (vẻ bề ngoài của một toán quân rất ngay ngắn nghiêm trang, cho biết toán quân đó có kĩ luật, chiến đấu giỏi). “Đồ hiếu sự vẻ quân dung”. (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Dân", "definition": "君民. Vua và mọi người trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Dịch", "definition": "軍役. Việc trong binh đội Chỉ việc phục vụ trong binh đội, một nhiệm vụ của nam công dân một nước dân chủ Việc chiến tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Dụng", "definition": "軍用. Chỉ chung những vật dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Giới", "definition": "軍械. Đồ dùng để đánh nhau, giết hại kẻ địch, dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hiến", "definition": "軍憲. Luật lệ dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hiệu", "definition": "軍校. Chức quan võ cấp dưới. Hạ sĩ quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Huyền", "definition": "袀玄. Quần áo toàn một màu đen.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hướng", "definition": "軍餉. Đồ ăn để nuôi binh đội Việc nuôi ăn binh lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hạm", "definition": "軍艦. Tàu chiến. Chỉ chung tàu thuyền dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hịch", "definition": "軍檄. Bài văn kêu gọi toàn thể binh đội đánh giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hỏa", "definition": "軍火. Chỉ chung đạn dược chất nổ dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Hồi Vô Lệnh", "definition": "軍囘毋令. Binh đội đánh trận thua chạy về thì không còn ai nghe ai, lộn xộn không còn phép tắc gì. Chỉ tình trạng rối loạn, lộn xộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Khu", "definition": "軍區. Vùng đất được ấn định ranh giới rõ ràng để dễ điều hành binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Khí", "definition": "軍器. Như Quân giới 軍械.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Kê", "definition": "軍雞. Gà chọi. Gà dùng để đá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Kì", "definition": "軍旗. Cờ của binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Kỉ", "definition": "軍紀. Phép tắc luật lệ của binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Lao", "definition": "軍牢. Nhà giam người phục vụ binh đội mà có tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Luật", "definition": "軍律. Phép tắc gắt gao dùng trong binh đội. Td: Thiết quân luật (lập ra phép tắc gắt gao, buộc dân chúng phải triệt để tuân theo, như là áp dụng trong binhđội, để đối phó với tình trạng nguy hiểm của quốc gia).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Lính", "definition": "Camū (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quân Lược", "definition": "軍略. Mưu mô dùng trong việc chiến tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Lễ", "definition": "軍禮. Những cách thức bề ngoài, được ấn định dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Lệnh", "definition": "軍令. Điều sai phái của cấp trên mà cấp dưới trong binh đội phải triệt để tuân theo. Đoạn trường tân thanh có câu: “Đã lòng tri quá thời nên, Truyền quân lệnh xuống trướng tiền tha ngay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Môn", "definition": "軍門. Cửa vào nơi đóng binh Chỉ cửa vào nơi vị võ tướng đặt bản doanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Mưu", "definition": "軍謀. Như Quân lược 軍略.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Na Hoa", "definition": "Quân na, Phạm: Kunda.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Nhu", "definition": "軍需. Đồ cần dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Nhân", "definition": "軍人. Người phục vụ trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Như", "definition": "( 923-973).Cao tăng người nước Cao Li, thuộc Tông Hoa Nghiêm, người ở Kinh nhạc, Hoàng Châu, họ Biên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Như Đại Sư Hoa Nghiêm Học Toàn Thư", "definition": "Toàn thư, do Đại sư Quân Như người Cao Li soạn, ông Kim Tri Kiến biên tập và chú thích, do Hội Xuất Bản thuộc viện Nghiên Cứu Phật Giáo Truyền Thống Đại Hàn ấn hành vào năm 1977.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Nhạc", "definition": "軍樂. Âm thanh hùng mạnh dùng trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Noa Lợi", "definition": "Xem Quân Đồ Lợi Minh Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quân Phiệt", "definition": "軍閥. Người ỷ thế binh đội mà cai trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phong", "definition": "軍鋒. Vẽ mạnh mẽ của binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Pháp", "definition": "軍法. Phép tắc luật lệ trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phân", "definition": "均分. Chia đều, phần nào cũng bằng nhau, không phần nào lớn hơn phần nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phí", "definition": "軍費. Sự tiêu dùng tiền bạc của cái cho binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phù", "definition": "軍符. Dấu hiệu để làm tin trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phú", "definition": "均富. Chia của cải đồng đều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phạm", "definition": "軍犯. Người phục vụ trong binh đội mà gây tội lỗi, bị trừng phạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phục", "definition": "軍服. Quần áo riêng dành cho binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Phủ", "definition": "軍府. Nơi vị võ tướng đóng bản doanh Cơ quan làm việc của binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Quan", "definition": "軍官. Người chỉ huy trong binh đội. Quan võ. Đoạn trường tân thanh có câu: “Xôn xao tơ trúc hội đồng quân quan”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Quốc", "definition": "軍國. Việc binh và việc nước, tức là những việc trọng đại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sĩ", "definition": "軍士. Binh lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sư", "definition": "軍師. Người bàn mưu tính kế trong binh đội, coi như ông thầy của binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sư Phụ", "definition": "君師父. Vua, thầy học và cha đẻ, ba bậc người phải tôn kính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sản", "definition": "均產. Của cải phân chia đồng đều, không ai hơn ai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Số", "definition": "軍數. Mức nhiều ít của binh lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sở", "definition": "軍所. Như Quân dinh 軍營.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sử", "definition": "軍史. Sách ghi chép việc thành lập, diễn tiến và hoạt động của binh đội qua các thời đại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Sự", "definition": "軍事. Việc thuộc về binh đội. Việc chiến tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Thân", "definition": "君親. Vua và cha mẹ, hai hạng người phải phụng sự thờ kính. Hát nói của Nguyễn Công Trứ có câu: “Nặng nề thay hai chữ quân thân, Đạo vi tử vi thần đâu có nhẹ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Thù", "definition": "Paccatthika (nam), paccāmitta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quân Thư", "definition": "軍書. Giấy tờ trong binh đội Thư từ liên lạc với binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Thần", "definition": "君臣. Vua và bề tôi Nghĩa vua tôi Quân thần 君臣: Vua tôi. Trong phép làm thuốc. “Vị chi sẵn đặt quân thần” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Thần Ngũ Vị", "definition": "Năm vị vua tôi, do Thiền Sư Tào Sơn Bản Tịch dựa theo thuyết Ngũ Vị của ngài", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Thế", "definition": "均勢. Sức mạnh ngang nhau. Thế lực đồng đều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Thực", "definition": "軍食. Việc nuôi ăn binh đội Đồ ăn dùng cho binh đội. Như: Quân lương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Trang", "definition": "軍裝. Chỉ chung các vật dụng thường ngày của người lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Trung", "definition": "軍中. Ở trong binh đội Cơ sở, doanh trại binh đội. Đoạn trường tân thanh có câu: “Quân trung gươm lớn dáo dài, Vệ trong thị lập cơ ngoài song phi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Trung Từ Mệnh Tập", "definition": "軍中詞命集. Tên một tập giấy tờ mệnh lệnh của Nguyễn Trãi, lúc chống quân Minh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Trà Lợi", "definition": "Xem Quân Đồ Lợi Minh Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quân Trì", "definition": "Xem Thủy Bình.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quân Trưởng", "definition": "軍長. Người chỉ huy trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Tá", "definition": "軍佐. Người dân sự nhưng làm việc trong binh đội, coi như giúp đỡ binh đội, không phải đánh trận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Tư", "definition": "軍資. Như Quân nhu 軍需.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Tịch", "definition": "軍籍. Sổ sách ghi chép tên tuổi của những người phục vụ trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Tử", "definition": "君子. Người có tài đức. Đoạn trường tân thanh có câu: “Tiếng Kiều nghe lọt bên kia, Ơn lòng quân tử sá gì của rơi”. Quân tử 君子: Danh từ dùng xưng tụng người học trò chính chắn. “Trước xe quân tử tạm ngồi”. (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Tử Hoa", "definition": "君子花. Một tên chỉ hoa sen, vì hoa sen được coi là loài hoa quân tử, gần bùn mà chẳng hôi tanh mùi bùn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Vương", "definition": "君王. Ông vua. Cung oáng ngâm khúc có câu: “Vẻ vưu vật trăm chiều chải chuốt, Lòng quân vương chi chút trên tay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Vương Tí Lạc", "definition": "Cánh tay nhà vua rơi.Đây là sự tích về ông vua bức hại Tôn Giả Sư Tử, vị Tổ thứ 24 của Thiền Tông Ấn Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Y", "definition": "軍醫. Việc chữa trị bệnh tật, thương tích trong binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Điền", "definition": "畇田. Chia ruộng đất đồng đều cho dân. Chữ Quân cũng viết 均.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Đoàn", "definition": "軍團. Một toán binh lính đông đảo Tên một đơn vị quân đội, ở trên cấp Sư đoàn, bao gồm nhiều Sư đoàn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Đạo", "definition": "君道. Đường ối cư xử mà một vị vua phải theo. Tức đạo làm vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Đẳng", "definition": "均等. bằng nhau, ngang bằng nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Địch", "definition": "Paṭiyodha (nam), sattu (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quân Đồ", "definition": "Phạm: Kuịđa, hoặc Agnìkuịđa. Hán dịch: Hỏa Lô.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Đồ Bát Thán", "definition": "Kundapadhaniyaka (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quân Đồ Lị", "definition": "Xem Thủy Bình.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quân Đồ Lợi Minh Vương", "definition": "Kuṇdali-rāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quân Đồ Lợi Minh Vương Pháp", "definition": "Quân Đồi Lợi, Phạm: Kuịđalì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quân Đội", "definition": "軍隊. Toán binh lính Chỉ chung binh lính của một quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quân Ước", "definition": "軍約. Pháp tắc luật lệ định sẵn trong quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quây Quanh", "definition": "Bhamati (bham + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Què", "definition": "Khañja (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quét", "definition": "Sammajjati (saṃ + maji + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quét Dọn", "definition": "Puñchati (puñch + a), majjanā (nữ), sammajjati (saṃ + majj + a), sammajjati (saṃ + mṛj)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quét Đi", "definition": "Parikassati (pari + kas + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quê Mùa", "definition": "Jānapada (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quên", "definition": "Muyhati (muh + ya), mussati (mus + ya), vissarati (vi + sar + a), sammuyhati (saṃ + muh + ya), sammuyhana (trung), saṃsīdati (saṃ + sad + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quên Lảng", "definition": "Pamussati (pa + mus + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quí", "definition": "Phạm: Apatràpya. Đối lại: Vô Quí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quí Kỉ Đẳng Phật", "definition": "Cho mình quí bằng Phật, lời quở trách kẻ bàn suông về tâm tính, vì hiểu câu “Sinh Phật nhất như” là chúng sinh và Phật như nhau, nên kẻ ấy sinh tâm cao mạn, cho mình là quí. Đứng về phương diện lí mà nói tuy chúng sinh và Phật nhất như, nhưng đứng về mặt nhân quả mê ngộ mà nhìn, thì giữa chúng sinh và Phật còn cách xa nhau lắm. Nghĩa là Phật đã giác ngộ mà chúng sinh vẫn còn mê muội, vậy nếu một mực cho mình đã bằng với Phật thì sẽ sinh tâm kiêu ngạo và lơ là với việc thực tu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quí Ngự Độc Kinh.", "definition": "Cũng gọi Niên Ngự Độc Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quí Sơ Lễ", "definition": "Lễ đầu mùa. Trong Thiền Lâm, vào ngày đầu của mỗi mùa như: Mồng 1 tháng 1, mồng 1 tháng 4, mồng 1 tháng 7 và mồng 1 tháng 10, vị Trụ Trì đi tuần xem xét các nhà, khi đến nhà tọa thiền thì lạy 3 lạy sát đất, rồi đi quanh nhà 1 vòng, gọi là Quí Sơ Lễ. [X.Niên Trung Hành Sự trong Xương Thụ Lâm Thanh Qui Q.hạ].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quí Sương Vương Triều", "definition": "Phạm: Kwàịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quí Tộc", "definition": "Chế độ quí tộc của Ấn Độ bắt đầu khoảng 1.000 năm trước Tây lịch, khi giống dân Aryan từ vùng Ngũ Hà (Punjab) dần dần di chuyển về hướng đông, đến mãi sông Jumna và khoảng giữa sông Hằng, chiếm lấy vùng đất đồng bằng và mầu mỡ (tức vùng trung tâm kinh tế, chính trị của Ấn Độ). Sau khi cuộc tiến chiếm kết thúc, người Aryan thiết lập 1 chế độ xã hội, tự xưng mình là Bà La Môn, tức giai cấp cao nhất, còn dân địa phương bị chinh phục thì phải làm nô lệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quý", "definition": "Apatrapya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quý Báu", "definition": "Ucca (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quý Canh", "definition": "貴庚. Tuổi tác của ngài (tiếng tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Chức", "definition": "貴職. Tiếng gọi ông quan, hoặc người kia làm việc chánh phủ, với ý tôn xưng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Cán", "definition": "貴幹. Việc làm của ngài (tiếng tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Danh", "definition": "Nāma (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quý Giá", "definition": "貴價. Có giá trị cao Rất đáng trọng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hiển", "definition": "貴顯. Cao sang vẻ vang, chỉ người đậu đạt, có chức vị cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hoá", "definition": "貴貨. Vật có giá trị Ta còn hiểu là đáng yêu thích, đáng xem làm trọng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Huynh", "definition": "貴兄. Người anh của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hãn", "definition": "愧汗. Hổ thẹn mà đổ mồ hôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hương", "definition": "貴鄉. Làng quê của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hạ", "definition": "季夏. Cuối mùa hè, tức tháng sáu âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hồ", "definition": "貴乎. Đáng quý ở chỗ. Ca dao có câu: “Mồ cha có đứa sợ đòn, Quý hồ kiếm d0ược chồng dòn thì thôi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Hữu", "definition": "貴友. Ông bạn của ngài (lời tôn xưng) Người bạn quý, giúp đỡ nhiều cho mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Khách", "definition": "貴客. Người cao sang tới nhà mình, tới cửa tiệm của mình. Đoạn trường tân thanh có câu: “Về đây nước trước bẻ hoa, Vương tôn quý khách ắt là đua nhau” Tiếng người bán hàng tôn xưng người tới mua hàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Kim", "definition": "貴金. Thứ kim loại quý (vàng bạc…).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Môn", "definition": "貴門. Gia đình cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Nguyệt", "definition": "季月. Tháng cuối mùa. Tháng thứ ba trong mỗi mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Ngụ", "definition": "貴寓. Nơi ở của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Nhân", "definition": "貴人. Người cao sang. Ca dao có câu: “Cái là sen rủ cái củ sen chìm, Bao nhiêu quý vật lại tìm quý nhân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Nhất", "definition": "Pakaṭṭha (tính từ) Uttama (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quý Noãn", "definition": "愧赧. Hổ thẹn mà bừng đỏ mặt lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Nương", "definition": "貴娘. Tiếng gọi người đàn bà con gái, với ý tôn xưng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Nữ", "definition": "季女. Con gái út Đứa con gái còn nhỏ Người con gái trẻn tuổi. Như: Thiếu nữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Phi", "definition": "貴妃. Vợ thứ của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Phái", "definition": "貴派. Dòng họ cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Phụ", "definition": "季父. Người chú ít tuổi nhất, chú út, tức em trai út của cha mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Phủ", "definition": "貴府. Tiếng gọi nhà ở hoặc chỗ làm việc của người khác, với ý tôn xưng..", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Quan", "definition": "貴官. Ông quan cao sang Tiếng gọi ông quan với ý tôn xưng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Quyên", "definition": "季絹. Thứ lụa nhỏ sợi, mặt mịn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Quán", "definition": "貴貫. Quê hương của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Quốc", "definition": "貴國. Đất nước của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý San", "definition": "季刊. Loại báo xuất bản ba tháng một kì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Sĩ", "definition": "貴士. Nhà nho học rộng, đậu cao, làm quan to.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Thu", "definition": "季秋. Tháng cuối cùng của mùa thu, tức tháng chín âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Thích", "definition": "貴戚. Họ ngoại của nhà vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Thế", "definition": "季世. Cuối đời, lúc đã suy vi Đời cuối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Tiện", "definition": "貴賤. Sang và hèn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Trọng", "definition": "貴重. Cho là cao cả đáng kính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Tính", "definition": "貴姓. Họ của ngài, tên họ của ngài (dùng làm lời tôn xưng khi hỏi tên họ người khác). “Xin tường quý tính đại danh được nhờ” (Nhi độ mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Tướng", "definition": "貴相. Dáng dấp cử chỉ bên ngoài cho biết cuộc đời sang cả của một người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Tần", "definition": "貴嬪. Một loại vợ thứ của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Tộc", "definition": "貴族. Dòng họ cao sang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Tử", "definition": "季子. Con trai thứ Con trai út.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Vật", "definition": "貴物. Đồ có giá trị cao. Ca dao có câu: “Cái lá sen rủ, cái củ sen chìm, Bao nhiêu quý vật đi tìm quý nhân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Xuân", "definition": "季春. Tháng cuối cùng của mùa xuân, tức tháng ba âm lịch..", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Đàm Tông Lặc", "definition": "(季潭宗泐, Kitan Sōroku, 1318-1391): vị tăng của Lâm Tế Tông Trung Quốc, tự là Quý Đàm (季潭), còn gọi là Toàn Thất (全室), xuất thân Đài Châu (台州, Tỉnh Triết Giang), họ Châu (周). Năm 8 tuổi, ông đến tham học với Tiếu Ẩn Đại Hân (笑隱大訢) và kế thừa dòng pháp của vị này. Đến khoảng cuối thời nhà Nguyên, ông vào ẩn cư trong Kính Sơn (徑山). Cho đến năm đầu (1368) niên hiệu Hồng Võ (洪武), ông làm trú trì Trung Thiên Trúc Tự (中天竺寺) ở Hàng Châu (杭州). Sau đó, vâng chiếu nhà vua, ông đến trú tại Thiên Giới Tự (天界寺) ở Kim Lăng (金陵), rồi đến năm thứ 10 (1377) cùng niên hiệu trên, ông đi sứ sang Tây Vức (西域). Vào ngày mồng 10 tháng 9 năm thứ 24 niên hiệu Hồng Võ, ông thị tịch, hưởng thọ 74 tuổi. Trước tác của ông có Toàn Thất Ngoại Tập (全室外集) 9 quyển. Ông cũng có mối quan hệ với Nhật Bản như đã từng soạn lời tựa cho bản Không Hoa Tập (空華集) của Nghĩa Đường Châu Tín (義堂周信, 1325-1388) hay Viên Thông Đại Ứng Quốc Sư Ngữ Lục (圓通大應國師語錄) của Nam Phố Thiệu Minh (南浦紹明, 1235-1308).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quý Đông", "definition": "季冬. Cuối mùa đông, tức tháng chạp âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Đệ", "definition": "貴弟. Em trai của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Địa", "definition": "貴地. Quê quán của ngài (lời tôn xưng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quý Đồ", "definition": "貴 圖. Còn gọi: Quý Yêu. Hi vọng, mưu cầu. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quý Đức", "definition": "貴德. Cao sang và có nết lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quýnh", "definition": "冏. Sáng sủa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quýnh Quýnh", "definition": "炯炯. Sáng rực Vẻ không yên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quýnh Vô Độc Thoát", "definition": "迥 無 獨 脫. Không có một chút ý niệm trần tục nào, riêng tự siêu thoát. Thản nhiên giải thoát. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quýnh Xuất", "definition": "迥 出. Triệt để siêu thoát. Tiết Tĩnh Cư Hòa Thượng trong TĐT q. ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quăng", "definition": "𠫔. Như chữ Quăng 肱.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quăng Cốt", "definition": "肱骨. Xương bắp tay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quăng Xuống", "definition": "Avakkhipati (ava + khip + a), avakkhippana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quăng Đi", "definition": "Dhunāti (dhu + nā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quạ", "definition": "Dhaṅka (nam), kāka (nam), ariṭṭha (nam), pakkhabilāla (nam), vāyasa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quạ Cái", "definition": "Kākī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quạ Đen", "definition": "Kākola (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quạt", "definition": "Vidhūpana (trung), vidhupeti (vi + dhūp + e), vījeti (vij + e), vījana (trung), sandhamati (saṃ + dham + a), opuṇāti (ova + pu + nā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quả", "definition": "Phala (P), Fruits of kamma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả A La Hán", "definition": "Fruit of Arhatship", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Quả Báo", "definition": "Karmic retribution.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Báu", "definition": "Xem Dị Thục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Bất Địch Chúng", "definition": "寡不敵衆. Ít người không thể chống lại số đông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Cau", "definition": "Pūga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quả Chứng", "definition": "Fruition.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Cư", "definition": "寡居. Ở goá. Ở vậy, không lấy chồng khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Cảm", "definition": "果敢. Tính tình dứt khoát, dám làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Cực Pháp Thân", "definition": "Đồng nghĩa: Pháp Tính Thân. Đối lại: Ứng hóa Pháp Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Dục", "definition": "寡慾. Ít ham muốn. Bỏ bớt lòng ham muốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Hải", "definition": "Biển quả, ví dụ trí tuệ, công đức của Phật sâu rộng như biển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Hậu Phương Tiện", "definition": "Phương tiện độ sinh sau khi chứng quả. Chư Phật đã chứng quả rồi, nhưng vì mục đích cứu độ chúng sinh, nên lại thị hiện tướng tu nhân cảm quả để làm pháp môn phương tiện. [X. Pháp Hoa Văn Cú Q.9].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Hợp", "definition": "寡合. Ít hợp với người khác. Chỉ người thanh cao, thẳng thắn, không giống người thường nên ít hợp với ai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Kiến", "definition": "寡見. Thấy ít. Chỉ sự hiểu biết ít ỏi. Thường dùng làm lời tự khiêm nhường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Kiếp", "definition": "果刼. Cái đời sống đang chịu, là cái kiếp cực của những việc làm trong kiếp trước. Đoạn trường tân thanh có câu: “Âu đành quả kiếp nhân duyên, cùng người một hội một thuyền đâu xa” Kinh Phật: Dục tri tiền thế nhân, kim sanh thụ giả thị, dục tri lại thế quả, kim sanh tác giả thị (chỉ xem những điều mình được hưởng thụ bây giờ là ta có thể biết cái nhân duyên của đời trước, và kiếp này ăn ở như thế nào chính là kết quả dành cho kiếp sau vậy).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Liêm", "definition": "寡廉. Ít trong sạch thẳng thắn. Chỉ sự không biết xấu hổ. Thường nói: Quả liêm thiểu sỉ (ít liêm sỉ, không biết xấu hổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Lực", "definition": "Chỉ cho lực dụng của quả vị Phật. Như Thập Lực, Tứ Vô Sở Úy, Thập Bát Bất Cộng Pháp... đều thuộc về Quả Lực. Ở nhân vị có hạnh nguyện thù thắng, nên ở quả vị cũng có lực dụng vi diệu. Nếu hạnh nguyện siêu việt thì lực dụng cũng theo đó mà siêu việt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Mãn Chuyển", "definition": "Cũng gọi Quả Viên Mãn Chuyển, Viên Mãn Chuyển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Môn", "definition": "Pháp môn tự nội chứng của chư Phật, cũng tức là pháp môn của quả vị Như Lai.Đây là cảnh giới mà hàng Bồ Tát ở địa vị tu nhân không thể thấy và hiểu được, chỉ có những bậc đã chứng chính giác mới có thể rõ biết. [X. Đại Nhật Kinh Sớ Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Nghị", "definition": "果毅. Tính tình cứng cỏi, dứt khoát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Ngôn", "definition": "寡言. Ít lời, ít nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Ngịch Lưu", "definition": "Xem Tu Đà Hườn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Nhiên", "definition": "果然. Thật đúng như vậy. Đoạn trường tân thanh có câu: “Này này sự đã quả nhiên, thôi đà cướp sống chồng min đi rồi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Nhân", "definition": "寡人. Người ít đức Tiếng tự xưng khiêm nhường của vua, tự cho mình là người ít đức Người ở goá Người cô thế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Nhập Lưu", "definition": "Xem Tu Đà Hườn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Năng Biến", "definition": "Phala-pariṇāma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Nữ", "definition": "寡女. Con gái ở một mình, không có chồng. Gái già.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Pháp", "definition": "Pháp bảo (trong Tam Bảo) được chia làn bốn pháp: giáo pháp, lí pháp, hành pháp, và quả pháp; gọi là “bốn pháp bảo” (tứ pháp bảo). “Giáo pháp” là những lời dạy của chư Phật ba đời; “lí pháp” là nghĩa lí được giảng giải từ giáo pháp; “hành pháp” là y theo lí pháp mà tu hành các pháp môn giới, định, tuệ, v.v... để gây nhân; “quả pháp” là chứng quả niết bàn tịch tịnh khi đã tu nhân viên mãn. Chư Phật ba đời y theo bốn pháp này mà tu hành, đoạn sạch phiền não, chứng quả vô thượng bồ đề. Chư Phật cũng dùng bốn pháp này để dắt dẫn chúng sinh tu hành, thoát li sinh tử, đến bờ giải thoát. Vậy, những quả vị mà hành giả tu chứng như A-la-hán, Bích-chi Phật, Thập-tín, Thập-trụ, v.v... đều là quả pháp.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quả Phúc", "definition": "果腹. No bụng “Hãy tu vẹn quả phúc nầy” (Phan Tràn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Phật", "definition": "Buddhahood", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Quả Phụ", "definition": "寡婦. Đàn bà goá chồng Đàn bà ở một mình, không lấy chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Quyết", "definition": "果决. Như Quả nghị 果毅.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Quyết Định Và Quả Không Quyết Định", "definition": "Theo định luật Nhân Quả, hễ tạo Nhân thì phải nhận Quả. Nhưng nhân quả là một qui luật tự nhiên rất sinh động và phức tạp, không đơn giản như chúng ta thường nói “trồng dưa được dưa; trồng đậu được đậu”. Mà ngay như trong cái đơn giản “trồng dưa được dưa” ấy, cũng vẫn là một quá trình nhân quả phức tạp, chứ không đơn giản tí nào. Đâu phải chỉ cần gieo nhân là chắc chắn có kết quả? Mà từ lúc gieo nhân còn phải có bao nhiêu trợ duyên, duyên thuận, duyên nghịch, duyên tăng, duyên giảm, bao nhiêu biến đổi..., cho tới lúc thọ quả; thậm chí, có thể có quả mà cũng có thể không có quả, hoặc lúc gieo nhân thì cái nhân rất tốt, nhưng đến lúc có quả thì cái quả lại rất xấu, v.v... vô cùng phức tạp! Bởi vậy, khi gieo nhân mà chắc chắn có quả, thì cái quả ấy được gọi là “quyết định quả” (quả quyết định); và khi gieo nhân mà kết quả không chắc chắn đến, thì cái kết quả ấy được gọi là “bất quyết định quả” (quả không quyết định). Chữ “quyết định” có nghĩa là nhất định, chắc chắn phải như vậy, không thể thay đổi; “bất quyết định” có nghĩa là không nhất định, không chắc chắn phải như vậy, có thể thay đổi. Những nghiệp nhân (thiện hay ác) chắc chắn sẽ chiêu cảm quả báo (lạc hay khổ) nhất định, gọi là “định nghiệp”; những nghiệp nhân không chắc chắn sẽ chiêu cảm quả báo gọi là “bất định nghiệp”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quả Quả", "definition": "Chỉ cho quả của Quả Vị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Sanh Y", "definition": "Upādhi-vepakka (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quả Tang", "definition": "果贓. Thật đúng sự việc đang xảy ra, có bằng cớ hẳn hoi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Thật", "definition": "菓實. Trái cây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Thức", "definition": "寡識. Sự hiểu biết ít ỏi, nhỏ bé.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Thực", "definition": "果實. Đúng sự thật xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Toan", "definition": "果酸. Chất chua trong trái cây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Trung Thuyết Nhân", "definition": "Phạm: Kàraịe kàryopacàra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Tình", "definition": "果情. Thật lòng, không gian dối. Truyện Trê Cóc có câu: “Quả tình nào có hồ nghi, ra điều bán dạ lâm trì khó coi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Tần Bà", "definition": "Bimba fruit", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Quả Viên", "definition": "菓園. Vườn trồng cây ăn trái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Đen", "definition": "(Khổ Não). Kaṇhavipāka", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quả Đoán", "definition": "寡斷. Ít dứt khoát về công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Đoạn", "definition": "Đoạn trừ quả khổ sinh tử, 1 trong 2 loại giải thoát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Đầu", "definition": "寡頭. Chỉ cái thể chế chính trị do một ít người, hoặc một người nắm quyền (Oligarchie).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quả Đầu Vô Nhân", "definition": "Đồng nghĩa: Hữu Giáo Vô Nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Địa", "definition": "Tức quả vị, là địa vị đạt được do công phu tu nhân. Nếu tu Bồ-tát thừa thì quả địa là Diệu-giác, hay Phật quả; nếu tu Duyên-giác thừa thì quả địa là Bích-chi Phật; nếu tu Thanh-văn thừa thì quả địa là A-la-hán v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quả Địa Cầu", "definition": "Jagati (nữ), guḷa (trung), chamā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quả Địa Vạn Đức", "definition": "Đối lại: Nhân Vị Vạn Hạnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quả Đức", "definition": "Tức là công đức của quả vị chứng đạt được do sự tu tập; như quả vị niết bàn có bốn đức là thường, lạc, ngã và tịnh. Từ này cũng dùng để chỉ cho công đức vô lượng của quả vị Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quải", "definition": "𠁥. Cái sừng của con dê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Bát", "definition": "Đồng nghĩa: Quải Đáp, Quải Đơn. Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Bát Nang", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Bình Bôi", "definition": "掛 瓶 杯. Chỉ cho tăng nhân hành cước dừng lại nghỉ ngơi một nơi nào đó. Bình bôi là đồ đựng thức ăn nước uống của tăng nhân hành cước. Tiết Đầu Tử Nghĩa Thanh Thiền Sư trong NĐHN q. 14 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quải Chân", "definition": "Chỉ cho nơi treo bức tượng của vị tôn túc đã thị tịch.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Danh", "definition": "掛名. Đeo cái tiếng tăm hão huyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Dương Đầu - Mại Cẩu Nhục", "definition": "掛 羊 頭 賣 狗 肉. Treo đầu dê bán thịt chó. Theo Nội Thiên Tạp Hạ trong Án Tử Xuân Thu: Treo đầu trâu ở cửa mà bán thịt ngựa ở bên trong. Đời sau đổi “Ngưu đầu” thành “Dương đầu”, đổi “Mã nhục” thành “Cẩu nhục” rồi viết thành “Quải dương đầu, mại cẩu nhục” để ví với hành vi lừa đảo lấy giả làm thật, trong ngoài không thống nhất. Vô Môn Quan (Đại 48, 293 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quải Giác", "definition": "𠁥角. Đường hẻm chật hẹp và quanh co (như sừng dê).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Giác Linh Dương Bất Kiến Tung", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Hoài", "definition": "掛懷. Đeo bên lòng, canh cánh bên lòng, không quên được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Kiếm", "definition": "掛劍. Treo gươm lên, không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Lạc", "definition": "Cũng gọi Quải Tử, Quải La, Lạc Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Nhân Thần Xỉ", "definition": "掛 人 唇 齒. Bị người nghị luận. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quải Quan", "definition": "掛冠. Treo mũ, ý nói từ chức Vương Mãn giết Tử Vũ, Phùng Manh nói rằng: Thế là rối loạn tam cương mất rồi, nếu không bỏ mà đi thì thế nào họa cũng sẽ lây đến, liền cởi mũ treo ở cửa thành phía đông, đem gia thuộc, giông buồm đi mất. “Thoát đà cởi áo quải quan lách mình” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Thần Vẫn", "definition": "挂 唇 吻. Liên quan tới ngôn từ giảng thuyết. “Nghệ Ngôn” trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quải Thần Xỉ", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Tích", "definition": "Kashaku (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quải Tử", "definition": "掛 子. Áo mặc ngoài. Tiết Quốc Hoan Văn Củ Thiền Sư trong NĐHN q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quải Xỉ", "definition": "掛齒. Giắt răng Kẹp vào răng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quải Đáp", "definition": "Cũng gọi Quải Đơn, Quải Đáp Đơn, Quải Tích, Quải Bát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quải Đơn", "definition": "挂 單. Quải là ở đậu, đơn là đơn vị. Tất cả vật dụng của tòng lâm thuộc về một vị tăng là 1 đơn vị. ở đậu một ngày thì làm chủ tòng lâm một ngày. ở đậu 10 năm thì làm chủ tòng lâm 10 năm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quản", "definition": "斡. Đứng đầu nhận lĩnh một việc Một âm là Oát. Xem Oát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Ca", "definition": "管歌. Người coi sóc việc đàn hát và trông nom đám con hát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Chủ Bát", "definition": "(? - ?).Danh tăng Trung Quốc sống vào đời Nguyên. Sư từng giữ chức Tăng Lục phủ Tùng Giang, tỉnh Giang Tô, được ban hiệu Quảng Phúc Đại Sư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quản Cơ", "definition": "管奇. Một chức quan võ nhỏ, hàm chánh tứ phẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Cố", "definition": "管顧. Coi sóc trông nom.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Gia", "definition": "管家. Người đầy tớ thân tín, đứng đầu các gia nhân để coi sóc công việc trong nhà. Đoạn trường tân thanh có câu: “Quản gia có một mụ nào, Thấy người thấy nết ra vào thì thương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Giáo", "definition": "管教. Chăm sóc dạy dỗ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Huyền", "definition": "管絃. Ống sáo và dây đàn, chỉ tiếng đàn sáo. Đoạn trường tân thanh có câu: “Kiệu hoa đâu đã đến ngoài, Quản huyền đâu đã giục người sinh li”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Huyền Giảng", "definition": "Thổi sáo (quản), gảy đàn (huyền) để cúng dường Phật. Phong tục này đã có từ xưa ở Ấn Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quản Hạt", "definition": "管轄. Trông coi mọi việc trong vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Khuy", "definition": "管窺. Nhòm qua ống, chỉ kiến thức nhỏ hẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Khố", "definition": "管庫. Người coi kho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Kiến", "definition": "管見. Thấy trong ống, chỉ kiến thức nhỏ hẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Lãnh", "definition": "(管領, Kanrei): tên gọi một chức quan dưới thời đại Thất Đinh (室町, Muromachi), bổ tá cho Tướng Quân và tổng quản toàn bộ chính vụ của chính quyền Mạc Phủ, tương đương với người chấp quyền của chính quyền Mạc Phủ Liêm Thương. Ban đầu chức quan này được gọi là Chấp Sự (執事).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quản Lí", "definition": "管理. Trông nom sắp đặt công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Lý", "definition": "Voharati (vi + ava + har + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quản Mao Phú Đỉnh", "definition": "管 茆 覆 頂. Chỉ cho tăng nhân trụ trì tự viện. Chương Nham Tuấn Thiền Sư trong CĐTĐL q. 15 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quản Pháp Thành", "definition": "(? - ?).Nhà tông giáo học và dịch kinh người Tây Tạng, sống vào đời Đường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quản Quân", "definition": "管軍. Trông nom việc binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Sự", "definition": "管事. Trông nom công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Thuộc Tăng Ni", "definition": "Chế độ quản lí tăng ni của triều đình Trung Quốc đời xưa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quản Thúc", "definition": "管束. Coi giữ, không cho phép tự do.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Thống", "definition": "管統. Đứng đầu coi sóc công việc một cùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Trị", "definition": "管治. Coi sóc sắp xếp công việc cho êm đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Trọng", "definition": "管仲. Xem Quản tử 管子.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Tượng", "definition": "管象. Người giữ voi. Ca dao có câu: “Trèo lên trái núi mà coi, Kìa bà quản tượng cưỡi voi cầm cồng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Tử", "definition": "管子. Tên bộ sách của Quản Trọng, chính trị gia lừng danh thời Xuân Thu, từng giúp Tề Hoàng Công dựng nghiệp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Đạo", "definition": "管道. Ông quan đứng đầu một địa phương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Đốc", "definition": "管督. Coi sóc sai khiến công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quản Độc Mộc", "definition": "Ống sáo bằng thứ gỗ độc hại, là 1 trong những vật cầm tay của đồng nữ Thường Cù Lê. Có thuyết cho rằng Quản Độc Mộc là khúc gỗ hình 4 góc; có thuyết nói dùng thứ gỗ làm thành vật có hình dạng cái ống sáo; có thuyết cho rằng Quản Độc Mộc không phảilà 1 khúc gỗ mà do nhiều khúc gỗ có chất độc hại bó lại thành một. Thướng cù lê là hóa thân của Bồ Tát Quán Tự Tại, trụ ở núi Hương Túy; Ngài lấy việc tiêu phục các thứ độc hại làm bản thệ, không để cho các loài rồng độc, rắn độc xâm hại chúng sinh. (xt. Nhương Ngu Lí Đồng Nữ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng", "definition": "廣. Ngôi nhà thật lớn To lớn Rộng Chỉ mặt trăng. Đoạn trường tân thanh có câu: “Thân sao nhiều nỗi bất bằng, Liều như cung Quảng ả Hằng nghĩ sao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Bác", "definition": "Rộng rãi. Học vấn quảng bác là học rộng. Vd, Phương Quảng, chỉ loại Kinh Phật, có ý nghĩa đặc biệt thâm sâu, rộng lớn. Là những Kinh Đại thừa, như các Kinh Lăng Nghiêm, Lăng Già, Duy Ma Cật v.v…", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quảng Bác Nghiêm Tịnh Bất Thoái Chuyển Luân Kinh", "definition": "Cũng gọi Quảng Bác Nghiêm Tịnh Kinh, Quảng Bác Nghiêm Tịnh Bất Thoái Chuyển Kinh, Bất Thoái Chuyển Pháp Luân Kinh, Bất Thoái Chuyển Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Bác Thân Như Lai", "definition": "Vipulakāya-Tathāgata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Bác Tiên Nhân", "definition": "Vyaśa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Bách Luận", "definition": "Śata-ṣāstra vaipulya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Bách Luận Bản", "definition": "Śataśāstravaipulya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Bách Luận Bổn", "definition": "Catuḥśataka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Bách Luận Thích Luận", "definition": "Cũng gọi Đại Thừa Quảng Bách Luận Thích Luận, Quảng Bách Luận, Quảng Bách Luận Thích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Bình", "definition": "廣平. Tên tỉnh ở phía Bắc Trung phần Việt Nam Rông rãi bằng phẳng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Chiếu", "definition": "廣 照. Thiền tăng đời Tống, tên Huệ Giác, người Tây Lạc, Trung Quốc. Lúc sư còn tuổi trẻ, cha sư làm Thái thú Hành Dương, bị bệnh mất tại đây. Sư phò linh cữu từ Hành Dương về Tây Lạc, qua Lễ châu (huyện Lễ, Hồ Nam) nghỉ đêm tại Dược Sơn Cổ Tự, bèn xuất gia tại đây. Sư du phương tham học đắc pháp nơi Thiền Sư Phần Dương Thiện Chiêu. Về sau trụ núi Lang Nha, Trừ Châu (huyện Trừ, An Huy), chấn hưng tông phong Lâm Tế, người đời gọi là", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Chiếu Thiền Sư", "definition": "廣 照 禪 師. Hiệu của Thiền tăng ứng Phu, sống vào đời Tống. X. ứng Phu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Cáo", "definition": "廣吿. Nói rộng ra cho mọi người cùng biết Làm cho mọi người biết đến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Diễn", "definition": "廣衍. Giăng rộng ra Nói rộng ra cho người khác hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Dã", "definition": "廣野. Cánh đồng rộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Giao", "definition": "廣交. Quen biết rộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Giám Anh", "definition": "Kuang chien Ying (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Giáo", "definition": "Giáo pháp rộng rãi đầy đủ. Lời dạy của Đức Phật về giới luật được chia làm Quảng Giáo và Lược Giáo. Khoảng 12 năm đầu, sau khi Đức Phật thành đạo, Đại Chúng đều thanh tịnh, không có ai phạm lỗi, nên Đức Phật chưa chế giới, Ngài chỉ dạy: “Chớ làm các điều ác”... Hành pháp răn dạy các đệ tử như vậy, gọi là Lược Giáo, cũng gọi là Lược Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Hiệp", "definition": "廣狹. Rộng và hẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Hiệp Tự Tại Vô Ngại Môn", "definition": "Cũng gọi: Chư Tạng Thuần Tạp Cụ Đức Môn (cách gọi của Cổ Thập Huyền Môn). Môn thứ 2 trong Tân Thập Huyền Môn của Tông Hoa Nghiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Hoằng Minh Tập", "definition": "Tác phẩm, 30 quyển, do Luật Sư Đạo Tuyên (596-667) soạn vào niên hiệu Lân Đức năm đầu (644) đời Đường, được thu vào Đại Chính Tạng tập 52.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Huệ Nguyên Liên", "definition": "(廣 慧 元 漣 [ 蓮 hay 璉 ], Kōe Genren, 951-1036): vị tăng của Lâm Tế Tông Trung Quốc, xuất thân Huyện Tấn Giang (晋江縣), Phủ Tuyền Châu (泉州府), Tỉnh Phúc Kiến (福建省), họ là Trần (陳). Năm lên 15 tuổi, ông đến xuất gia tại Báo Cúc Viện (報劬院), sau đi khắp nơi tham vấn hơn 50 vị lão túc, và cuối cùng đại ngộ với Thủ Sơn Tỉnh Niệm (首 山 省 念). Vào năm đầu (1004) niên hiệu Cảnh Đức (景德), ông đến trú tại Quảng Huệ Viện (廣慧院) thuộc vùng Nhữ Châu (汝州). Chính trong thời gian nầy, Vương Tham Chính Thư (王參政書), Hứa Lang Trung Thức (許郎中式), Thị Lang Dương Ức (侍郎楊億), v.v., có đến tham học với ông. Vào ngày 26 tháng 9 năm thứ 3 niên hiệu Cảnh Hựu (景祐), ông thị tịch, hưởng thọ 86 tuổi, và được ban cho thụy hiệu là Chơn Tuệ Thiền Sư (眞慧禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quảng Huệ Thiền Sư", "definition": "廣 慧 禪 師. Hiệu của Thiền tăng Đức Huy, sống vào đời Nguyên. X. Đức Huy.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Hàn", "definition": "廣寒. Nơi rộng và lạnh, chỉ cung trăng Quảng hàn cung: Cung quảng, cung trăng. “Của đâu trêu ghẹo chi ai, Ấy người cung quảng, hay người đài Dương” (Nhị Độ Mai). Cổ thi: Do thắng hằng Nga bất giá nhân Dạ da cô miên Quảng hàn điện (Hơn chị Hằng Nga chẳng lấy chồng, Quảng hàn lạnh lẽo chịu phòng không). Câu thơ này nói về Ngưu Lang, Chức Nữ tuy mỗi năm chỉ gặp nhau một lần nhưng vẫn hơn Hằng Nga suốt đời một mình lạnh lẽo Rằm tháng 8, lúc Đường minh Hoàng lên chơi cung trăng có tấm biển đề mấy chữ: “Quảng hàn thanh hư chi phủ”. Nên dùng chữ Quảng hàn (Hoặc Cung quản, Điện Quảng hàn) để chỉ mặt trăng. “Liều như Cung Quảng ả hằng nghĩ sao” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Hàn Cung", "definition": "(廣寒宮): trong tác phẩm Long Thành Lục (龍城錄), phần Minh Hoàng Mộng Du Quảng Hàn Cung (明皇夢游廣寒宮), của Liễu Tông Nguyên (柳宗元, 773-819) nhà Đường cho biết rằng tương truyền vào ngày Rằm tháng 8, khi vua Huyền Tông (玄宗, tại vị 712-756) nhà Đường ngao du trên mặt trăng, chợt thấy một cung phủ lớn, có tấm bảng ghi là: “quảng hàn thanh hư chi phủ (廣寒清虛之府, phủ lạnh lẽo trống không).” Về sau, người ta gọi cung tiên trên mặt trăng là Quảng Hàn Cung. Như trong bài thơ Túc Thủy Đình (宿水亭) của Bảo Dung (鮑溶, ?-?) nhà Đường có câu: “Dạ thâm tinh nguyệt bạn Phù Dung, như tại Quảng Hàn Cung lí túc (夜深星月伴芙蓉、如在廣寒宮裏宿, trăng sao đêm nữa bạn hoa sen, như ở Cung Quảng Hàn tá túc).” Hay trong tác phẩm Liêu Trai Chí Dị (聊齋志异), chương Bạch Vu Ngọc (白于玉), của Bồ Tùng Linh (蒲松齡, 1640-1715) nhà Thanh, lại có đoạn: “Đồng đạo nhập Quảng Hàn Cung, nội dĩ thủy tinh vi giai, hành nhân như tại kính trung (童導入廣寒宮、內以水晶爲階、行人如在鏡中, đồng đạo vào Cung Quảng Hàn, bên trong lấy thủy tinh làm bực thềm, người đi như ở trong kính).” Hoặc trong Thiền Tông Tạp Hải Độc (禪宗雜毒海, 卍Tục Tạng Kinh Vol. 65, No. 1278) quyển 8, phần Sơn Cư (山居), lại có bài thơ rằng: “Thảo đường thu tợ Quảng Hàn Cung, kim sắc hoa khai bích ngọc tùng, tọa cửu bất tri phàm cốt hoán, thiên hương thanh tán nguyệt minh trung (草堂秋似廣寒宮、金色花開碧玉叢、坐久不知凡骨換、天香清散月明中, nhà tranh thu tựa Quảng Hàn Cung, hoa nở sắc vàng ngọc biếc tùng, chẳng biết ngồi lâu phàm cốt đổi, hương trời tỏa ngát trăng sáng trong).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quảng Hóa Tự", "definition": "廣 化 寺. Nằm trên sườn núi Phụng Hoàng (còn gọi Nam Sơn) cách thành phố Phủ Điền, tỉnh Phúc Kiến, Trung Quốc 3km về phía nam. Cùng với Phúc Châu Cổ Sơn Dũng Tự, Tuyền Châu Khai Nguyên Tự, Hạ Môn Nam Phổ Đà Tự gọi chung là “Bốn đại thiền lâm ở Phúc Kiến”. Nguyên là nơi dạy học của anh em nhà Trịnh Lộ. Niên hiệu Vĩnh Định thứ 2 (558) đời Trần Nam Triều, đổi làm Kim Tiên Thiền viện. Niên hiệu Cảnh Vân thứ 2 (711) đời Đường, tăng chùa tên Chí Ngạn theo lệnh vua tiến cung giảng Tứ phần luật, vua ban tên “Linh Nham Tự”, Liễu Công Quyền viết biển. Niên hiệu Thái Bình Hưng Quốc thứ 1 (976) đời Tống, do tăng Linh Thưởng và Thiền Sư Quy Dương Vô Liễu xây dựng lại, đổi tên là “Quảng Hóa Tự”. Chùa vào hai đời Tống Minh rất là hưng thịnh, toàn chùa gồm có 10 đại viện, tiểu am trực thuộc viện 120 tòa. Cổ tự sau khi trải qua ngàn năm sương gió phần lớn đã sụp đổ. Những kiến trúc hiện còn được xây cất lại y theo cũ vào khoảng niên hiệu Quang Tự (1875-1908) đời Thanh, lại đem chùa Tiểu Nam Sơn với chùa Pháp Hải nhập lại. Trên tuyến trục giữa theo thứ tự có Sơn môn, Đại hùng bảo điện, Pháp đường, Tàng kinh lâu; hai bên có Chung cổ lâu, Thiền phòng, Phương trượng thất, Khách phòng. Trước Đại hùng bảo điện có 2 tòa thạch kinh kiến tạo vào niên hiệu Trị Bình thứ 2 (1065) đời Tống, cao khoảng 3m điêu khắc “Phật Đỉnh Tôn Thắng đà la ni kinh chú”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Học Thụ Nghĩa", "definition": "(廣學竪義, Kōgakuryūgi): gọi chung là Thụ Nghĩa (竪義, ryūgi), còn gọi là Lập Nghĩa (立義), từ dùng cho các vị tăng nêu ra những kiến giải của mình về kinh điển trong các pháp hội thuyết giảng. Những vị tăng học thức trãi qua một thời gian lâu dài nghiên cứu giáo lý Phật Giáo, được gọi là Thụ Giả (竪者, người đứng trên kiến giải của mình để đối đáp những chất vấn của người khác). Thông qua mấy lần đối đáp thông suốt các chất vấn của những bậc học tượng nổi danh trong pháp hội, hội đồng sẽ quyết đinh chọn ra người có kiến thức uyên bác về Phật Giáo để làm học tượng sau này. Ở vùng Nam Đô thì nó được gọi là Nghiên Học Thụ Nghĩa (研學竪義, Kengakuryūgi) và Bắc Lãnh là Quảng Học Thụ Nghĩa; cả hai đều là các tổ chức học vấn nổi tiếng đương thời.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quảng Hựu Tự", "definition": "Cũng gọi Bạch Tháp Tự. Chùa ở phía ngoài cửa Tây, thành Liêu Dương, Liêu Ninh, được sáng lập vào đời Kim (1115-1234).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Khoát", "definition": "廣闊. Rông rãi. Ta vẫn nói trại thành Khoảng khoát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Khánh Thiền Tự", "definition": "廣 慶 禪 寺. Vua Tống Lý Tông ban cho chùa Phi Lai bảng hiệu Quảng Khánh thiền tự. X. Phi Lai tự", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Long Tự", "definition": "(廣隆寺, Kōryū-ji): ngôi chùa trung tâm của Phái Ngự Thất (御室派) thuộc Chơn Ngôn Tông, hiện tọa lạc tại Sakyō-ku (右京區), Kyōto-to (京都市), Kyōto-fu (京都府); còn gọi là Phong Cang Tự (蜂岡寺), Thái Tần Tự (太秦寺), Tần Tự (秦寺), Tần Công Tự (秦公寺), Cát Dã Tự (葛野寺); hiệu núi là Phong Cang Sơn (蜂岡山). Ở vùng này, vào thời đại Ứng Thần Thiên Hoàng (應神天皇), con cháu của vua Tần Thủy Hoàng cũng như những người di dân từ Vương Quốc Bách Tế (百濟, Kudara) bên Triều Tiên sang đã làm cho hưng thạnh sản nghiệp, và đây cũng là nơi di thực nền văn minh từ vùng Đại Lục Trung Hoa vậy. Trong số những người dân đến đây có người hậu duệ của nhà họ Tần là Tần Hà Thắng (秦河勝). Tương truyền vị này nhân để an trí tượng Phật mà được Thánh Đức Thái Tử (聖德太子, Shōtōku Taishi) ban tặng vào năm 604, cũng như các tượng Phật do hai nước Tân La (新羅) và Nhậm Na (任那) ban tặng, đã tạo lập nên ngôi chùa này nơi vùng đất nhà họ Tần. Sau đó, vào năm 810 và 1150 thì chùa bị cháy tan tành, nhưng cũng đã được tái kiến lại mấy lần. Chùa này vốn là chùa của dòng họ Tần, là ngôi chùa tối cổ ở vùng Kinh Đô Kyoto, là một trong bảy ngôi chùa có liên quan đến hành trạng của Thái Tử, bên cạnh Pháp Long Tự (法隆寺, Hōryū-ji), Tứ Thiên Vương Tự (四天王寺, Shitennō-ji). Quần thể kiến trúc hiện tại có Giảng Đường là kiến trúc được tái kiến dưới thời Bình An. Trong tòa nhà này ở chính giữa thờ tượng ngồi A Di Đà Phật bằng gỗ, bên phải có tượng Địa Tạng Bồ Tát, bên trái có tượng Hư Không Tạng Bồ Tát (虛空藏菩薩), phía đằng sau hai bên phải trái lại có an trí hai tượng Bất Không Quyên Sách Quan Âm (不空羂索觀音), Thiên Thủ Quan Âm (千手觀音). Còn Chánh Điện Quế Cung Viện (桂宮院) là kiến trúc ảnh hưởng phong trào tín ngưỡng Thái Tử vào thời Liêm Thương, được xây dựng dưới hình thức Mộng Điện, nhà hình tròn bát giác. Trong điện thờ tượng ngồi bán già Như Ý Luân Quan Âm (如意輪觀音) bằng gỗ. Thượng Cung Vương Viện Thái Tử Điện (上宮王院太子殿) lại là Chánh Điện chính của chùa, thờ tượng Thánh Đức Thái Tử ngồi bán già. Linh Bảo Điện (靈寶殿) là nơi tàng trữ những vật báu của chùa ngang tầm cỡ quốc bảo. Bảo vật của chùa có tượng Bồ Tát Di Lặc ngồi bán già, bằng gỗ; tượng ngồi A Di Đà Như Lai, bằng gỗ; tượng đứng Bất Không Quyên Sách Quan Âm, bằng gỗ; tượng đứng Thiên Thủ Quan Âm, bằng gỗ; tượng đứng Thập Nhị Thần Tướng, bằng gỗ; Chánh Điện Quế Cung Viện, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quảng Luật", "definition": "Cũng gọi Quảng Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Lược Bản Tôn", "definition": "Chỉ cho hình thức thờ phụng Bản Tôn của Tông Nhật Liên, Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Lược Tương Nhập", "definition": "Môn Quảng và môn lược tức là nhau, hòa vào nhau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Lược Yếu", "definition": "Từ gọi chung Quảng, Lược, Yếu, 1 trong những phương pháp giải thích rõ các điểm cốt yếu của kinh luận. Đề cập đến toàn bộ gọi là Quảng, rút gọn 1 phần gọi là Lược, trích ra những chỗ chủ chốt gọi là Yếu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Lợi Thiền Tự", "definition": "廣 利 禪 寺.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Lợi Tự", "definition": "Kōri-ji (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Lục", "definition": "廣 錄. Trong Ngữ Lục, đem các pháp ngữ của Tổ sư ghi chép lại tỉ mỉ thì gọi là Quảng Lục. Chẳng hạn như: Mã Tổ Đạo Nhất Thiền Sư Quảng Lục, Vân Môn Khuông Chân Thiền Sư Quảng Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Lục Độ Hạnh", "definition": "廣六度行 (Thành Cụ Quang Minh Định Ý Kinh, cũng có tên là Lục Đức Hạnh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quảng Mạc", "definition": "廣漠. Mênh mông rộng lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Mục Thiên", "definition": "Phạm: Virùpàkwa. Pàli: Virùpakkha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Mục Thiên Vương", "definition": "Virūpakśa (S), Virupakkha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Nam", "definition": "廣南. Tên một tỉnh ở trung phần Việt Nam, phía nam cố đô Huế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Nghiêm", "definition": "廣 嚴 (1121-1190). Thiền tăng đời Lý, thuộc dòng Vô Ngôn Thông đời thứ 11. Sư họ Nguyễn, quê huyện Đan Phượng, mồ côi từ thuở bé, theo học Phật pháp với người cậu là thầy Bảo Nhạc. Sau khi thầy Nhạc qua đời, sư đi hành cước bốn phương, viếng khắp các thiền hội. Nghe thiền sư Trí Thiền giáo hóa ở chùa Phúc Thánh hạt Điển Lãnh, sư liền đến đây tham vấn. Một hôm nhân nghe Trí Thiền giảng Ngữ Lục của ngài Tuyết Đậu, đến chỗ Đạo Ngô và Tiệm Nguyên đến nhà người điếu tang đối đáp về vấn đề sinh tử, sư có sở đắc liền hỏi và được Trí Thiền ấn chứng, nối pháp ngài. Đến ngày 15 tháng 2 năm Canh Tuất, nhằm niên hiệu Thiên Tư Gia Thụy thứ 5 (1190), sư sắp tịch liền nói kệ:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Nghiêm Thành", "definition": "Vaiśālī (S), Vesāli (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Nghiêm Tự", "definition": "廣 嚴 寺. Còn gọi: Chùa Tiên Lữ, chùa Trăm Gian. Chùa nằm trên ngọn đồi thuộc núi Tiên Lữ (Lã Sơn), nay thuộc xã Tiên Phương, huyện Hoài Đức, ngoại thành Hà Nội, Việt Nam. Chùa được xây dựng vào thế kỷ XII, đã qua nhiều lần tu sửa. Nay chùa gồm 3 cụm kiến trúc. Cụm thứ nhất gồm 4 cột trụ, hai quán là nơi đánh cờ người vào những ngày hội và nhà giá ngự là nơi đặt kiệu thánh. Trèo qua trăm bậc gạch xây là tới cụm thứ hai gồm có tòa gác chuông hai tầng tám mái. Tại đây có treo quả chuông đúc năm 1794. Qua gác chuông leo 25 bậc đá xanh đến sân trên có kê một sập đá, lại leo 9 bậc đá nữa thì đến cụm thứ ba. Đó là chùa chính gồm Bái đường, tòa thiêu hương và thượng điện. Hai bên là hai dãy hành lang. Trong cùng là nhà Tổ. Giữa lại có lầu trống, bên trong treo một trống lớn và một khánh đồng đúc năm 1749. Chùa có cả thảy 153 pho tượng hầu hết bằng gỗ sơn thếp. Đặc biệt có một pho mây đan bọc vải sơn, tương truyền là tượng bó cốt của một cao tăng đã tu ở đây: nhà sư Nguyễn Lữ, sống vào đầu thế kỷ XV.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Nghĩa", "definition": "廣義. Cái ý rộng. Nói rộng cái ý ra Tên một tỉnh ở trung phần Việt Nam, ta vẫn đọc trại là Quảng ngãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Ngạch", "definition": "Phẩm “Phạm Hạnh” trong Kinh Đại Bát Niết Bàn có ghi: Nước Ba-la-nại có người đồ tể tên Quảng Ngạch, mỗi ngày giết cả trăm, cả ngàn con dê. Một hôm ông gặp tôn giả Xá Lợi Phất, được tôn giả giáo hóa, thọ giới bát quan trai một ngày đêm; sau khi chết được sinh lên cõi trời, làm con trai của thiên vương Tì Sa Môn. Sách Tục Truyền Đăng Lục, q. 28, mục “Đông Sơn Giác Thiền Sư” cũng chép: Quảng Ngạch chính là một tên giết người không gớm tay; nhưng khi đã ném con dao đồ tể xuống thì lập tức thành Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quảng Phiếm", "definition": "廣泛. Trôi nổi mênh mông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Phá Kinh", "definition": "Vaidalya-Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Phá Luận", "definition": "Vaidalyaprakaraṇa (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Pháp Thiền Sư", "definition": "廣 法 禪 師. Hiệu của Thiền tăng Bằng Ngạn, sống vào đời Ngũ Đại. X. Bằng Ngạn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Phúc Tự", "definition": "廣 福 寺. X. Thường Châu Thiên Ninh Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Phúc Đàm Chương", "definition": "Kuang fu Tan chang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Phổ", "definition": "Núi Vepulla (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Quả Thiên", "definition": "Vṛhatphala (S), Bṛhatphala (S), Vehapphala (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Sanh Phật Đảnh", "definition": "Xem Đại Chuyển Luân Phật Đảnh. Xem Cao Phật Đảnh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Tham", "definition": "Đối lại: Độc Tham.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Thắng Tự", "definition": "Chùa ở phía nam Hoắc Sơn, huyện Triệu Thành, tỉnh Sơn Tây, Trung Quốc, tương truyền được sáng lập vào khoảng năm Kiến Hòa (147-149) đời Hậu Hán, nhưng không có bằng chứng xác thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Trung Thuyết Lược", "definition": "Đối lại: Lược Trung Thuyết Quảng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Trí", "definition": "廣智. Mở rộng sự hiểu biết Sự hiểu biết rông rãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Trí Bất Không", "definition": "Amoghavajro (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Trường Thiệt Tướng", "definition": "Phạm: Prabhùta-jihvatà, hoặc Prabhùta-tanu-jihvatà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Trị", "definition": "廣治. Tên một tỉnh ở bắc Trung phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Tu", "definition": "Quảng Tu (771-843). Cao tăng Trung Quốc, sống vào đời Đường, người Hạ Côn, Đông Dương (Chiết Giang), họ Lưu, là Tổ thứ 11, (có thuyết nói thứ 10) của Tông Thiên Thai, người đời gọi là Chí Hành Tôn Giả.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Tuệ Thanh Văn.", "definition": "Cũng gọi Quảng Huệ Thanh Văn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Tín", "definition": "廣信. Tên một tỉnh ở trung phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Tế Thiền Sư Tháp Đình", "definition": "廣 濟 禪 師 塔 亭. Tháp nằm trong điện tháp chùa Tam Bình, huyện Bình Hòa, tỉnh Phúc Kiến, Trung Quốc. Trong khám đá thờ tượng ngồi xếp bằng của thiền sư Quảng Tế (hiệu của Thiền tăng Nghĩa Trung đời Đường), hai bên là tượng Thị giả Phục Hổ đứng hầu. Tương truyền hài cốt của Nghĩa Trung được chôn dưới khám này.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Tế Tự", "definition": "廣 濟 寺. ở cửa đông Đại Nhai trong PhụThành Môn, khu Tây Thành, thành phố Bắc Kinh, Trung Quốc. Đời Kim là Tây Lưu Thôn Tự của Trung bộ Bắc Giao, đời Nguyên cải tạo và xây dựng lại gọi là “Báo Ân Hồng Tế Tự”. Niên hiệu Thái Tổ thứ 16 (1221) đời Nguyên, Thiền Sư nổi tiếng Vạn Tùng Hành Tú vào ở chùa này. Năm thứ 19 (1224) Hành Tú thể theo lời thỉnh của Gia Luật Sở Tài trước tác “Thung Dung Lục”. Đệ tử nối pháp của Hành Tú là Lâm Tuyền Tùng Luân kế tục ở chùa này. Sau bị binh lửa chùa chiền hủy sạch. Niên hiệu Thiên Thuận (1457-1464) đời Minh, Hòa Thượng Phổ Huệ cùng đệ tử Viên Hồng quyên tiền xây dựng lại. Niên hiệu Thành Hóa thứ 2 (1466) ban tên “Hoằng Từ Quảng Tế Tự”, năm thứ 20 (1484) xây xong. Niên hiệu Vạn Lịch thứ 11 (1583) đời Minh, Khang Hy thứ 38 (1699) đời Thanh, năm 1924 đều có tu sửa thêm. Năm 1952, 1972 từng có hai lần tu sửa lớn. Chùa quay lưng về hướng bắc mặt nhìn về hướng nam, diện tích 35 ha. Kiến trúc chủ yếu trên tuyến trục giữa có Sơn môn, Thiên vương điện, Đại hùng bảo điện, Viên thông điện, Đa Bảo điện, Tàng kinh các. Trong Tây lộ viện có giới đàn 3 tầng xây bằng đá cẩm thạch. Tàng kinh các chứa kinh thư Phật giáo hơn 10 vạn quyển và hơn 3 vạn tấm thác bản thạch kinh chùa Vân Cư, Phòng Sơn. Trong chùa còn cất giấu kỹ pho tượng đồng Di Lặc đúc vào đời Minh, đỉnh đồng bát bảo đúc vào đời Thanh. Hiện là trụ sở của “Trung Quốc Phật Giáo Hiệp Hội”, “Trung Quốc Phật Học nghiên Cứu Sở”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Tế Đại Sư", "definition": "廣 濟 大 師. Thụy hiệu của Thiền tăng Tồn Tương, sống vào đời Đường. X. Tồn Tương.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Tọa", "definition": "廣坐. Chỗ rộng, đông người ngồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Uyên", "definition": "廣淵. Sân rộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Văn", "definition": "Quảng Văn (1189-1263). Thiền Sư Trung Quốc, sống vào đời Nam Tống, người huyện Hầu quan, Phúc Châu (Phúc Kiến), họ Lâm, hiệu là Yết Khê, đệ tử đời thứ 18 của phái Thiền Nam Nhạc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Yên", "definition": "廣安. Tên một tỉnh ở Bắc phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Ích", "definition": "廣益. Rộng thêm mối lợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Đăng Lục", "definition": "Cũng gọi Thiên Thánh Quảng Đăng Lục, Thiền Tông Quảng Đăng Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Đơn", "definition": "廣 單. Giường rộng mà dài của thiền đường, mỗi giường có thể nằm mấy chục người. Diện tích mỗi chỗ nằm của 1 người là: 2m x 0,8m = 1,6㎡", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quảng Đại", "definition": "廣大. Rộng lớn. “Nào lòng quảng đại nào lòng từ bi” (Phan Trần).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Đại Chuyển", "definition": "Chuyển vị thứ 6 trong 6 thứ chuyển vị, là tiếng dùng biểu thị quả vị tột cùng của Đại Thừa. Nghĩa là chứng được cảnh giới chân như, dứt bặt mê ngộ đối đãi, đi vào viên chuyển tự tại.Tông Duy Thức tùy theo giai vị chứng được mà chia quả “chuyển y” làm 6 thứ, gọi là Lục Chủng Chuyển Y. Chuyển Y nghĩa là chuyển bỏ chỗ y chỉ thấp để chứng được quả vị cao.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Đại Hành", "definition": "Tạng: Rgya-chen-spyod-pa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Đại Hội", "definition": "Một trong 17 danh hiệu của Đức Phật A Di Đà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Đại Phát Nguyện Tụng", "definition": "Mahāprani-dhānotpāda gāthā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quảng Đại Trí", "definition": "Trí tuệ của Phật rộng lớn không thể tính lường, là trí kiến tối thắng vô thượng, cho nên gọi trí của Phật là Quảng Đại Trí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quảng Đức", "definition": "廣德. Nết lớn Ơn lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quảng Ấn", "definition": "Quảng Ấn (1566-1636). Cao tăng Trung Quốc, thuộc Tông Lâm Tế, sống vào đời Minh, người ở Gia Thiện, Tuy Lí (huyện Gia Hưng, tỉnh Chiết Giang), họ Chu, tự Văn Cốc, biệt hiệu Chưởng Thạch.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quấn", "definition": "捃. Thâu góp lượm lặt. Như chữ Quấn 𢹲.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quấn Chung Quanh", "definition": "Vinandhati (vi + nandh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quấn Lại", "definition": "Nandhati (nadh + m + a), nayhati (nah + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quấn Thập Giáo", "definition": "Từ ngữ do Tông Thiên Thai sử dụng để chỉ cho giáo pháp của Kinh Niết Bàn.Quấn thập nghĩa là lượm lặt những bông lúa rơi rớt trong lúc gặt hái.Tông Thiên Thai dùng việc này để ví dụ cho giáo pháp Kinh Niết Bàn là giáo pháp nhặt nhạnh, thu gom những căn cơ mà hội Pháp Hoa còn bỏ sót. Vì trong hội Pháp Hoa Đức Phật tuyên giảng giáo pháp Nhất Thừa, lúc ấy có những chúng sinh chưa đủ năng lực lãnh nhận nên tự rút lui khỏi pháp hội, hoặc dời đến phương khác để chờ đến hội Niết Bàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quấn Đa", "definition": "Phạm: Kunta. Pàli: Kuntha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quất", "definition": "劀. Lấy dao khoét chỗ thịt hư thối ở nhọt đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quất Hoàng", "definition": "潏湟. Nước chảy xiết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quất Phu Nhân Niệm Trì Phật", "definition": "Tượng Phật trì niệm do Quất Phu Nhân, mẹ của Hoàng hậu Quang Minh, người Nhật Bản tạo. Tức chỉ cho tượng A Di Đà Tam Tôn thờ trong Niệm Trì Phật Trù Tử (khám thờ Phật) đặt tại Kim Đường chùa Pháp Long. Trù tử này cao 2,63m, cửa ở 4 mặt có vẽ các bức tranh. Niệm Trì Phật tức là tượng A Di Đà Tam Tôn bằng đồng giát vàng, tòa ngồi làao sen khắc nổi.Sau lưng tượng Phật có bức bình phong do 3 mảnh ghép lại, phía trên là người trời được khắc nổi, các chuỗi anh lạc rất đẹp. Trên miệng 3 pho tượng như mỉm cười, kĩ thuật đúc tạo cực kì tinh vi, là tác phẩm tiêu biểu cho thời kì đầu Thiên Bình (Bạch Phượng) ở Nhật Bản. Tượng Bản Tôn cao 33,3 cm, tượng 2 vị Bồ Tát đứng hầu 2 bên cao 26,9 cm. [X. Nhật Bản Quốc Bảo Toàn Tập 47; Nhật Bản Công Nghệ Sử Khái Luận].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quấy", "definition": "Duṭṭhu (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quấy Nhiễu", "definition": "Vikkhobheti (vi + khubh + e), vikkhobhana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quấy Rầy", "definition": "Ābādheti (ā + badh + e), nibandha (trung), nibandhati (ni + bandh + a), bādhaka (tính từ), viheṭhaka (tính từ), upatāpeti (upa + tap + e), heṭheti (heth + e), viheṭheti (vi + hīd)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quấy Rối", "definition": "Bādhaka (tính từ), bādheti (badh + e), matthati (matth +a), cakita (tính từ), heṭheti (heth + e), vikkhobheti (vi + khubh + e), vikkhobhana (trung), saṅkopa (nam), santasati (saṃ + tas + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quấy Động", "definition": "Saṅkhubhati (saṃ + khubh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quần", "definition": "Gaṇa (P), Flock.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quần Anh", "definition": "羣英. Người tài giỏi nhóm họp lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Chúng", "definition": "羣衆. Chỉ chung cho mọi người trong xã hội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Cơ", "definition": "群 機. Chỉ cho rất nhiều hạng người tham vấn thiền pháp. Như Tịnh Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quần Cư", "definition": "羣居. Họp lại mà ở đông đảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Hiền Phú Tập", "definition": "羣賢賦集. Tên một tập Phú bằng chữ Hán, do Hoàng Sằn Phu, Danh sĩ đời Lê sưu tập, tựa viết năm 1457 của Nguyễn Thiên Túng, gồm các bài phú của các danh sĩ Trần mạt Lê sơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Hoá", "definition": "羣化. Trở thành giống với người trong bọn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Hôn", "definition": "羣婚. Tục lệ lấy vợ lấy chồng thới cổ, trong đó, tất cả con trai trong bộ lạc này lấy tất cả con cái trong bộ lạc kia làm vợ, và ngược lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Hùng", "definition": "羣雄. Chỉ chung những người tài giỏi hơn đời, đang cùng nhau làm việc gì Chỉ chung những nước lớn mạnh đang tranh chấp với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Học", "definition": "羣學. Một tên chỉ môn Xã hội học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Hồ", "definition": "羣狐. Bầy chồn cáo. Chỉ bọn tiểu nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Lê", "definition": "羣黎. Chỉ chung dân chúng trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Lập", "definition": "羣立. Đứng thành bầy. Đứng đông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Manh", "definition": "Xem Quần Sanh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quần Nghị", "definition": "羣議. Tụ họp bàn bạc Lời bàn bạc của đám đông, của nhiều người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Ngôn", "definition": "羣言. Lời nói của nhiều người. Dư luận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Phi", "definition": "羣飛. Bay từng đàn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Phong", "definition": "羣峰. Dãy núi. Nhiều trái núi gần nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Phân", "definition": "羣分. Chia ra thành từng bầy khác nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Phương", "definition": "羣芳. Chỉ chung các loài hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Quý", "definition": "羣季. Chỉ chung những người anh em của mình. Như: Chư đệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Sanh", "definition": "Bahu-jana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quần Sinh", "definition": "羣生. Chỉ chung các vật có sự sống Chỉ loài người Hán thơ: Âm dương điều nhi phong võ thì; quần sinh hoà nhi vạn vật thực (Âm dương điều hòa thì mưa gió phải thời, quần sinh hòa thì vạn vật sinh sôi nảy nở). “Huống chi vật mọn quần sinh” (Trinh Tử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tam Tụ Ngũ", "definition": "羣三聚五. Túm năm tụm ba.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Thoa", "definition": "裙釵. Cái quần và vật cài tóc, là vật dụng của đàn bà. Chỉ đàn bà con gái. “Khách quần thoa mà để lạnh lùng” (Cung oán).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Thư Khảo Biện", "definition": "羣書考辦. Tên một cuốn sách khảo cứu viết bằng chữ Hán văn của Lê Quý Đôn, học giả đời Lê, nội dung bàn xét về các sách vở, bài tựa của các tác giả đề năm 1757, cùng với một học giả Trung Hoa là Chu Bội Liên và Hồng Khải Hi, sứ thần Cao li đề năm 1761.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Thần", "definition": "Rājaparisā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quần Tiểu", "definition": "羣小. Bầy trẻ con Bọn người nhỏ nhen thấp kém (tiểu nhân).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tâm", "definition": "羣心. Lòng dạ chung của đám đông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tình", "definition": "羣情. Như Quần tâm 羣心.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tính", "definition": "羣性. Tính chất sống chung thành xã hội (Sociabilité).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tòng", "definition": "羣從. Chỉ chung con em cháu trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tập", "definition": "羣集. Tụ họp đông đảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Tụ", "definition": "羣聚. Như Quần tập 羣集.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Áo", "definition": "Cela (trung), nivāsana (trung), vattha (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quần Đoàn", "definition": "羣團. Họp lại thành nhóm có tổ chức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quần Đảo", "definition": "羣島. Vùng có nhiều đám đất nổi lên ngoài biển.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn", "definition": "僒. Như chữ Quẫn 窘.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn Bách", "definition": "窘迫. Khốn khổ gấp rút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn Bộ", "definition": "窘步. Đi gấp rút. Rảo bước Bước chân cứ ríu lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn Bức", "definition": "窘逼. Như Quẫn bách 窘迫.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn Cùng", "definition": "窘窮. Khốn khổ, không biết xoay trở ra sao. Cũng nói: Cùng quẫn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn Cấp", "definition": "窘急. Như Quẫn bách 窘迫.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quẫn Trí", "definition": "窘智. Khốn đốn rối loạn, không biết tính toán gì nên làm bậy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận", "definition": "捃. Lấy tay nhặt lên Lượm nhặt thu góp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Chủ", "definition": "郡主. Danh hiệu chỉ con gái của các bậc Vương, họ hàng với vua. Ta thường đọc Quận chúa. Truyện Lục Vân Tiên có câu: “Sắc phong quận chúa hiển vinh cho nàng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Công", "definition": "郡公. Tên một tước hiệu thời xưa, vua ban cho công thần hoặc thân thích, ở dưới tước Công. Tục ngữ: Thứ nhất quận công, thứ nhì không lều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Huyện", "definition": "郡縣. Hai đơn vị hành chánh trong nước. Chỉ chung lĩnh thổ đất nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Mã", "definition": "郡馬. Danh hiệu chỉ người chồng của Quận chúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Phò Mã", "definition": "郡駙馬. Như Quận mã 郡馬.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Quan", "definition": "郡官. Viên chức đứng đầu một quận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Trưởng", "definition": "郡長. Viên chức hàng chánh đứng đầu một quận ngày nay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quận Tướng", "definition": "郡將. Như Quận quan 郡官.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật", "definition": "倔. Cứng cỏi. Mạnh mẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật Cư Bộ", "definition": "Xem Kê Dẫn Bộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quật Cường", "definition": "倔强. Cứng cỏi mạnh mẽ, không chịu phục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật Khởi", "definition": "倔起. Vùng dậy mạnh mẽ, không chịu phục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật Lỗi Tử", "definition": "窟儡子. Pho tượng gỗ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật Nội Quật Ngoại", "definition": "Trong hang động ngoài hang động. Cứ theo Đại Đường Tây Vực Kí quyển 9 và Tông Luân Luận Thuật Kí, thì từ phía tây nam vườn trúc Ca Lan Đà tại nước Ma Yết Đà, đi về phía bắc núi Nam Sơn 5 đến 6 dặm, có 1 hang động lớn, là nơi mà, sau khi Đức Phật nhập diệt, Tôn Giả Đại Ca Diếp đã kết tập 3 tạng Kinh, Luật, Luận, gọi là Quật nội kết tập (cuộc kết tập trong hang). Cùng lúc đó, cách nơi hang động này hơn 20 dặm, ngài Bà Sư Bà đứng đầu số Đại Chúng còn lại kết tập 5 tạng (3 tạng Kinh, Luật, Luận cộng thêm Tạp tập tạng và Cấm Chú Tạng), gọi là Quật Ngoại Kết Tập (cuộc kết tập ngoài hang). (xt.. Kết Tập).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quật Quỷ", "definition": "誳詭. lạ lùng, dị thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật Vật", "definition": "崛岉. Vượt cao lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quật Đa", "definition": "Xem Cúc Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quật Đa Tam Tạng", "definition": "窟 多 三 藏 (680 -?). Thiền tăng đời Đường, người Thiên Trúc (nay là ấn Độ). Sư xuất gia từ thuở bé. Do nằm mộng thấy Sư tổ Trí Dược Tam Tạng dạy phải đem cây Bồ Đề đến chùa Bảo Lâm ở Thiều Châu trồng nơi pháp hội của Nhục thân Bồ Tát. Sư bèn vượt biển Nam Hải vào Thiều Dương tìm chùa Bảo Lâm vào niên hiệu Đại Túc thứ 1 (701). Sau khi hỏi thăm thấy quả đúng như lời Sư tổ nói, nên sư trồng cây Bồ Đề trong khuôn viên chùa Bảo Lâm. Sư thờ Lục Tổ Huệ Năng làm Thầy, dưới lời dạy của Tổ liền khế ngộ, thuộc Thiền Tông Nam tông đời thứ 2.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quật-ngoại Kết Tập", "definition": "Cuộc kết tập “quật-ngoại” . “Quật-ngoại” là một nơi ở bên ngoài hang Thất-diệp. Cuộc kết tập kinh điển lần đầu tiên với sự tham dự của 500 vị A-la-hán, do tôn giả Đại Ca Diếp chủ trì, đã được cử hành ở phía bên trong hang Thất-diệp; và cùng lúc đó, ở phía bên ngoài hang, một số rất đông chư vị tì kheo khác, cũng cử hành một cuộc kết tập khác. Theo sách Phật Giáo Sử của Thitananathera (Phật giáo Nam Tông) thì chính tôn giả Phú Lâu Na (Purna) đã chủ trì cuộc kết tập ở phía bên ngoài hang Thất-diệp này. Nguyên vì tôn giả về trễ, không kịp dự đại hội kết tập do tôn giả Đại Ca Diếp chủ trì. Khi cuộc kết tập đã kết thúc, tôn giả mới về tới; và vì bất đồng quan điểm với tôn giả Đại Ca Diếp về một số điều nhỏ nhặt trong giới luật, tôn giả đã cử hành cuộc kết tập riêng. Nhưng theo Phật Quang Đại Từ Điển và một số tài liệu khác thì tôn giả Bà Sư Ba (Vaspa – một trong năm vị đệ tử thánh tăng đầu tiên của đức Phật trong nhóm Kiều Trần Như) đã là vị thượng thủ chủ trì cuộc kết tập “quật ngoại” này; vì vậy, tôn giả Bà Sư Ba đã được coi là vị thỉ tổ của Đại Chúng Bộ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quắc", "definition": "嘓. Nhiều lời. Nói nhiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quắc Quắc", "definition": "嘓嘓. Nói nhiều. Nói sa sả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quắc Thước", "definition": "矍鑠. Tuổi già mà còn nhanh nhẹn mạnh mẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quặc", "definition": "戄. Sợ hãi hoảng hốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quặc Bổ", "definition": "攫捕. Bắt lấy. Cầm nắm lấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quặc Bộ", "definition": "躩步. Vừa đi vừa nhảy lên. Nhảy chân sáo Rảo bước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quặc Sưu", "definition": "蠼螋. Tên một thứ sâu ở nơi ẩm thấp, mình đen chân vàng, sáu chân, đầu đuôi tẽ ra (Anisolabia Maritima).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế", "definition": "劌. Đâm chém Dùng vật bén nhọn gây thương tích cho người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Biên", "definition": "桂邊. Vỏ cây quế, đẻo ở những chỗ thừa ra. Loại quế vụn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Chi", "definition": "桂枝. canh cây quế Vỏ quế lấy ở cành cây quế, dùng làm vị thuốc. Thơ Hồ Xuân Hương có câu: “Ngọt bùi thiếp nhớ mùi cam thảo, Cay đắng chàng ơi vị quế chi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Cung", "definition": "桂宮. Cung quế, tức cung trăng. Tục truyền trên cung trăng có cây quế ý nói: Được nơi đẹp đẽ. Xưa Hán vũ Đế (140-87 tr.t.l.) có làm một cái cung gọi là Quế cung cho nàng Trương Lệ Hoa ở. Cửa tròn như mặt trăng, lộng kiếng. Sân sau dựng một bức tuờng vôi, tô phấn trắng, giữa sân trồng một cây quế, có ý xây dựng theo như lời tục truyền trên cung trăng. “Chàng dầu cung quế xuyên dương, Thiếp theo hai chữ tao khương cho bằng” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Hoa", "definition": "桂花. Hoa của cây quế Cũng chỉ mặt trăng, tương truyền trên mặt trăng có cây quế lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Hoè", "definition": "桂槐. Cây quế và cây hoè, hai loài cây quý thường được trồng ở nhà quan. Chỉ nhà quyền quý. Cũng chỉ con cái đông đảo và hiển đạt. Đoạn trường tân thanh có câu: “Thừa gia chẳng hết nàng Vân, Một cây cù mộc một sân quế hoè”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Luân", "definition": "桂輪. Một tên chỉ mặt trăng, tương truyền trên mặt trăng có cây quế lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Lâm Đoạn Nhai Thạch Phật", "definition": "Quần thể hang đá khắc tượng Phật ở Quế Lâm, phía bắc tỉnh Quảng Tây, xưa nay nổi tiếng là nơi núi sông đẹp nhất Trung Quốc. Vùng này núi non chót vót, trùng điệp, hang động liên tiếp, rộng lớn. Bờ tây sông Li có núi Điệp Thái, núi Phục Ba, ngọn Độc Tú, núi Li Sơn; vùng núi tây bắc có ngọn Quán Âm, ngọn Thạch Ngư, ngọn Tây Phong, núi Lão Quân; bờ đông sông Li thì có núi Nguyệt Nha, núi Thất Tinh...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quế Nguyệt", "definition": "桂月. Một tên chỉ tháng tám âm lịch, vì trong tháng này có tiết Trung thu, trăng sáng đẹp, mà tương truyền trên mặt trăng có cây quế lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Phách", "definition": "桂魄. Chỉ ánh trăng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Sâm", "definition": "桂 琛 (867-928). Thiền tăng đời Ngũ Đại, họ Lý, người Thường Sơn (Chiết Giang), Trung Quốc. Sớm có chí xuất trần, sư theo Đại sư Vô Tuớng chùa Vạn Thế cạo tóc thụ giới, chuyên học Tỳ ni, biết trì giới không phải đạo giải thoát bèn chuyển sang du phương, tham phỏng các sư Nam tông. Ban đầu, yết kiến Tuyết Phong Nghĩa Tồn thưa hỏi thiền yếu, song chưa được gì. Lại đến Phúc Châu sư tham kiến Huyền Sa Sư Bị, một lời thốt ra tiêu sạch nghi hoặc. Quan Mục ở Chương Châu xây cất viện Địa Tạng tại núi Phương Thạch phía Tây thành Mân (Phúc Kiến) thỉnh Quế Sâm diễn pháp. Sư trụ nơi đây 18 năm, học đồ hơn 200 người. Về sau dời qua viện La Hán ở Chương Châu (Chương Phổ, Phúc Kiến) xiển dương Thiền Tông, tăng lữ nam bắc tụ hội, người khế cơ khai ngộ nhiều vô kể, người đời gọi sư là “La hán Quế Sâm”. Thụy là “Chân ứng Thiền Sư”. Đệ tử nối pháp có Văn Ích, Hồng Tiến, Hưu Phục, Thiệu Tu, Thủ An v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quế Sơn", "definition": "桂山. Hiệu của vua Nguyễn Khuyến, danh sĩ đời Nguyễn, vị Tam nguyên làng Yên đổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Sơn Thi Tập", "definition": "桂山詩集. Tên tập thơ chữ Hán của Nguyễn Khuyến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Thâm", "definition": "Kuei-Ch'en (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quế Điện", "definition": "(桂殿): có ba nghĩa khác nhau.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quế Đuờng Thi Tập", "definition": "桂堂詩集. Tên tập thơ chữ Hán của Lê Quý Đôn, dưới mõi bài thơ đều có lời chú thích của tác giả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Đường", "definition": "桂堂. Hiệu của vua Lê Quý Đôn, học giả lừng danh đời Lê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Đường Văn Tập", "definition": "桂堂文集. Tên một tập văn xuôi bằng chữ Hán của Lê Quý Đôn, gồm 4 quyển.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Đố", "definition": "桂蠹. Một tên gọi con cà cuống, là thư côn trùng có thứ nước mực thơm, dùng làm đồ gia vị. Gọi vậy vì con cà cuống như con sâu mọt ở cây quế nên mới có thứ nước thơm đến thế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quế Ảnh", "definition": "(桂影): chỉ bóng mặt trăng, ánh trăng. Theo Dậu Dương Tạp Trở (酉陽雜俎) quyển 1, chương Thiên Chỉ (天咫) của tiểu thuyết gia Đoàn Thành Thức (段成式, 803-863) nhà Đường cho biết rằng tương truyền trên mặt trăng có một cây Nguyệt Quế (月桂) cao 500 trượng. Dưới thời nhà Hán có một người tên là Ngô Cương (吳剛), say mê về tiên đạo mà không lo chuyên tâm học tập; vì vậy Thiên Đế nổi giận, đem chàng ta giam tại cung trăng, bắt chàng phải chặt cây quế và bảo rằng nếu như chặt đỗ cây quế đó thì có thể lấy được thuốc tiên. Ngô Cương bắt đầu chặt cây quế, nhưng sau khi chặt xong một nhát đao thì vết chặt tự nhiên liền lại. Ngày qua ngày, chàng trai tận lực đốn cây quế, nhưng không thành. Cho nên, Ngô Cương vẫn còn làm công việc này, vì cây quế vẫn chưa ngã và người đời sau thấy hình tượng chàng thanh niên kia chặt cây quế không ngừng nghỉ. Vì vậy, hình ảnh cây quế luôn gắn liền với mặt trăng qua một số từ ngữ như quế phách (桂魄), quế điện (桂殿), quế nguyệt (桂月), v.v. Như trong bài thơ Sơn Trung Dạ Tọa Ký Cố Lí Hữu Sinh (山中夜坐寄故里友生) của Lý Hàm Dụng (李咸用, ?-?) nhà Đường có câu: “Trùng thanh xúc xúc thôi hương mộng, quế ảnh cao cao quải lữ tình (蟲聲促促催鄉夢、桂影高高掛旅情, tiếng trùng thúc giục cố hương mộng, ánh trăng cao vút chở tình xa).” Trong bài từ Chúc Anh Đài Cận (祝英台近) của Lưu Cơ (劉基, 1311-1375) nhà Minh có đoạn: “Thúy yên thu, châu lộ hạ, tinh Hán cọng tiêu sái, quế ảnh bồi hồi, bạch tuyết xán diêm ngõa (翠煙收、珠露下、星漢共瀟灑、桂影徘徊、白雪粲簷瓦, khói biếc thu, sương châu rụng, ông sao cùng thong thả, bóng trăng bồi hồi, tuyết trắng cười ngói mái nhà).” Trong Sách Pháp Hiệu Nghĩa Biện Phúng Tụng Văn (索法號義辯諷誦文, Taishō Vol. 85, No. 2857) có câu: “Liên hoa ái nhi quế ảnh trầm huy, phương thọ điêu nhi lan tư bãi úc (蓮花靉而桂影沈暉、芳樹彫而蘭姿罷郁, hoa sen tối mà ánh trăng thầm sáng, cây thơm tàn mà dáng lan rực rỡ).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quệ", "definition": "撅. Vén áo lên. Xắn lên Các âm khác là Quyết, Quyệt. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỉ", "definition": "Phạm: Preta. Pàli: Peta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Biện", "definition": "Biện luận một cách kỳ quái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Biện Bà La Môn", "definition": "Tên của 1 Bà La Môn ngoại đạo ở Ấn Độ đời xưa, có tài biện luận khéo léo, sau bị ngài Mã Minh hàng phục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Biện Luận", "definition": "(Pàli: Amara-vikkepika).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Bố Mộc", "definition": "Loại cây làm cho quỉ phải sợ hãi, tức chỉ cho cây liễu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Hào Thần Khấp", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Kiến", "definition": "Cái thấy của quỉ, tức chỉ cho Tà Kiến. Vọng kiến cho rằng không có nhân quả, ở đời chẳng có nguyên nhân nào mang lại kết quả, mà cũng chẳng có kết quả nào từ nguyên nhân sinh ra, bởi thế cái ác không đáng sợ, mà điều thiện cũngchẳngđáng ham. Kiến chấp sai lầm này là loại Kiến Chấp tà khúc nhất trong các Tà Kiến, cho nên gọi làQuỉ kiến. [X. Luận Thành Duy Thức Q.6; Luận Câu Xá Q.19]. (xt. Ngũ Kiến).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ La Sát", "definition": "Rakshasa demons", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Quỉ Lục", "definition": "Quyển sách do quỉ thần ghi chép. Theo Kinh Kim Cương Đính quyển 12, trong điện của vua Diêm La có 1 quyển sách để ghi chép những tội lỗi mà người đời đã phạm phải.Quyển sách này là do quỉ thần ở dưới đất chiếu theo những tội ác mà người đời đã tạo để ghi chép rồi tâu lên, cuối cùng, vua Diêm La căn cứ vào đó để quyết định các hình phạt nặng hay nhẹ đối với các tội nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Miếu", "definition": "Miếu thờ thần Quỉ Tử Mẫu. Thần Quỉ Tử Mẫu tức là Ha Lợi Đế Mẫu, là thần bảo hộ sự sinh nở và trẻ thơ được bình an, cho nên ở Ấn Độ từ xưa đã có tập tục lập miếu cúng thần này, nhưng ngày nay ít thấy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Môn", "definition": "Cửa quỉ ra vào.Xưa nay trong dân gian tương truyền rằng cửa quỉ ra vào là ở góc đông bắc của nhà ở hay thành quách, cho nên dân gian thường kiêng cữ hướng góc đông bắc. [X. Pháp Uyển Châu Lâm Q.6; Loại Tụ Danh Vật Khảo Q.338].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Nhãn Tình", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Nhập Tràng", "definition": "Chamanda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quỉ Niệm Ngũ Xứ", "definition": "Quỉ dính vào 5 chỗ. Nghĩa là quỉ có thể dính chặt vào tứ chi và đầu của người, nhưng cuối cùng không thể tiêu diệt được sức tinh tiến của người.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Nạn", "definition": "Tai nạn do quỉ thần gây ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Quật Lí", "definition": "Cũng gọi Giả Giải Thoát Khanh. Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Thành", "definition": "Tên gọi khác của thành Càn Thát Bà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Thần", "definition": "Loại chúng sinh có uy lực đáng sợ, thường biến hóa một cách tự tại, được chia làm 2 loại thiện và ác. Nếu che chở cho thế gian, hoặc giữ gìn, bảo vệ Phật Pháp, như Đại Phạm Thiên Vương, Tam Thập Tam Thiên Vương, Tứ Thiên Vương, Viêm Ma Vương, Nan Đà Long Vương, Bạt Nan Đà Long Vương... thì đều là quỉ thần thiện; nếu như La Sát... thì là quỉ thần ác. Còn Dạ Xoa thì thuộc cả 2 loại thiện và ác. Trong Phật Giáo thì quỉ thần thông thường là chỉ cho 6 bộ quỉ thần: Càn Thát Bà, Dạ Xoa, A Tu La, Ca Lâu La, Khẩn Na La và Ma Hầu La Già.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Tiên Cố Thi", "definition": "Quỉ đánh vào xác chết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Tử Mẫu", "definition": "Xem Ha Lỵ Đế.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quỉ Tử Mẫu Kinh", "definition": "Gọi đủ: Phật Thuyết Quỉ Tử Mẫu Kinh. Kinh, 1 quyển, không rõ dịch giả, được thu vào Đại Chính Tạng tập 21.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Tử Mẫu Thần", "definition": "Phạm: Hàrìtì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quỉ Vấn Mục Liên Kinh", "definition": "Kinh, 1 quyển, do ngài An Thế Cao dịch vào đời Hậu Hán, được thu vào Đại Chính Tạng tập 17.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quị Bái", "definition": "Một trong các cách lễ bái ở Ấn Độ. Lúc Đức Phật còn tại thế, người trong nước gặp Bà La Môn thì quì lạy, gặp sa môn thì kính lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quị Lô", "definition": "Quì trước lư hương để niệm hương, thông thường được thực hành vào các dịp Thánh Tiết, quốc kị, hoặc ngày kị Tổ Sư. Trong điều Thánh Tiết, chương Chúc Li trong Sắc Tu Bách Trượng Thanh Qui quyển thượng có ghi rõ tác pháp Quị Lô, tức lúc cử hành pháp hội thì Lưỡng Tự chia ra 2 ban đứng đối diện nhau, vị Trụ Trì liền đến quì, phía sau vị Trụ Trì là vị Tri Khách quì dâng cái lư hương cầm tay (tức lư hương có cán), rồi đến vị Thị Giả quì dâng hộp hương. Đợi đến khi vị Duy Na bạch Phật tuyên sớ xong, thì vị Tri Khách lại quì để tiếp lấy lư hương, sau đó vị Trụ Trì mới thu tọa cụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc", "definition": "𡈑. Như chữ Quốc 國.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Binh", "definition": "國兵. Quân đội của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Bính", "definition": "國柄. Quyền đều khiển một nước. “Mừng đà quốc bính, quyền đương” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Bản", "definition": "國本. Cái gốc gác, nền tảng của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Bảo", "definition": "國寶. Vật quý của nước nhà Báu nước, ví người con trai có tài hạnh cao siêu. “giầy giun báu nước, hương trời sánh nhau” (Hoa Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Bộ", "definition": "國步. Bước đi của một nước, chỉ vận mạng của một nước. Vận nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Ca", "definition": "國歌. Bài hát được lựa chọn để tượng trưng cho tinh thần của một nước, được hát lên trong các dịp lễ chung của qiần chúng, hoặc của các cơ quan chính quyền, quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Chủ", "definition": "國主. Người đứng đầu một nước, chỉ ông vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Công", "definition": "國公. Tước hiệu cao nhất triều đình ban cho ban cho các đại công thần. Cũng gọi tắt là tước Công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Cố", "definition": "國故. Việc thay đổi lớn lao trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Cữu", "definition": "國舅. Cha vợ của vua “Muốn thăm Quốc cựu (cữu) sợ Tôn Quyền phục binh” (Câu hát) Anh em trai của Hoàng hậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Duy", "definition": "國維. Cách tổ chức và luật lệ của một nước, coi như giềng mối giữ vững nước đó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Duệ", "definition": "國裔. Dòng dõi con cháu nhà vua Chỉ dân tộc một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Dân", "definition": "國民. Chỉ chung mọi người trong nước. Thơ Tản Đà có câu: “Ta có thơ mừng khắp quốc dân, Trước biết ái quốc sau hợp quần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Dân Đảng", "definition": "國民黨. Tên một đảng chính trị Trung Hoa, Do Tôn Dật Tiên thành lập, đã hoàn thành cuộc cách mạng Tân Hợi, 1911, khai sáng nền Dân quốc Trung Hoa Tên một đảng chính trị tại Việt Nam, còn gọi là Việt Nam Quốc dân đảng, do Nguyễn Thái Học đứng đầu, từng chủ xướng cuộc khởi nghĩa chống Pháp ở Yên bái năm 1930. Việc bất thành, Nguyễn Thái Học và các đồng chí người Pháp bị hành quyết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Dịch Nhất Thiết Kinh", "definition": "Chỉ cho bộ Phật Điển Tùng Thư gồm 255 quyển được soạn thuật hoặc phiên dịch thành tiếng Nhật Bản, do nhà xuất bản Đại Đông ấn hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Dụng", "definition": "國用. Tiền bạc chỉ dùng vào việc nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Gia", "definition": "國家. Một nước, gồm lĩnh thổ, dân chúnh và chính quyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Gia Chủ Nghĩa", "definition": "國家主義. Chỉ chung mọi tư tưởng và đường lối đem lại lợi ích chung cho đất nước dân tộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Giao", "definition": "國交. Sự qua lại liên hệ giữa nước này và nước khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Giáo", "definition": "國教. Tông giáo được nhìn nhận là của chung nhân dân cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hiến", "definition": "國憲. Luật lệ của đất nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hiệu", "definition": "國號. Tên gọi của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hoa", "definition": "國花. Thứ hoa được nhìn nhận là tiêu biểu cho cả một nước. Td: Hoa mai của Trung Hoa, hoa Anh đào của Nhật….", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Huy", "definition": "國徽. Dấu hiệu riêng, tượng trưng của một nước Cũng như Quốc kì 國旗.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hóa", "definition": "國貨. Hàng chế tạo trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Húy", "definition": "國諱. Tên một vị vua đang tại vị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hương", "definition": "國香. Thứ hoa thơm, tiêu biểu cho cả một nước Chỉ người con gái cực đẹp. Cũng như Quốc sắc 國色.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Họa", "definition": "國禍. Tai vạ cho cả một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hồn", "definition": "國魂. Tinh thần cao quý đặc biệt dân tộc qua nhiều thời đại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hội", "definition": "國會. Cơ quan lập pháp, quy tụ các đại diện của các dân tộc trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hữu", "definition": "國有. Tài sản của chung trong nước, do chính phủ quản trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Hữu Hoá", "definition": "國有化. Biến tài sản của tư nhân thành tải sản chung của cả nước, do chính phủ quản trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Khánh", "definition": "國慶. Dịp vui mừng chung của cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Khí", "definition": "國氣. Người tài giỏi, coi như đồ dùng phục vụ cho cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Khố", "definition": "國庫. Kho chứa nhiều tiền hoặc hàng hoá do nhà nước quản trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Khố Khoán", "definition": "國庫券. Tấm giấy chứng nhận có gửi tiền vào kho nhà nước. Cũng gọi là Công khố phiếu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Kì", "definition": "國旗. Lá cờ tượng trưng cho một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Kế", "definition": "國計. Công việc làm giàu cho nước, tức việc kinh tế của quốc gia Đường lối, chính sách của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Lập", "definition": "國立. Do nhà nước làm ra và quản trị. Cũng như: Công lập.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Mạch", "definition": "國脉. Chỉ chung mọi sinh hoạt trong nước, coi như huyết mạch duy trì sự sống của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Mẫu", "definition": "國母. Bà mẹ của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Mệnh", "definition": "國命. Lệnh do nhà nước ban ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Ngoại", "definition": "國外. Ở ngoài nước. Ở nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Ngữ", "definition": "國語. Tiếng nói chung cho cả nước Thứ tiếng Quan thoại, còn gọi là tiếng Bắc kinh, tiếng Phổ thông, được dùn trong các trường học Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Nhạc", "definition": "國樂. Loại âm nhạc được dùng trong các lễ lớn trong nước Ngày nay còn được hiểu là nền âm nhạc cổ điển thuần tuý của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Nhất", "definition": "國 一 (330). Hiệu của Thiền tăng Pháp Khâm tông Ngưu Đầu đời Đường. X. Pháp Khâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quốc Nạn", "definition": "國難. Việc không may xảy tới chung cho cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Nội", "definition": "國内. Ở trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Phong", "definition": "國風. Nếp sống tốt đẹp có từ lâu đời của một nước Tên một thiên trong kinh Thi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Pháp", "definition": "國法. Phép tắc luật lệ của một nước. “Ông rằng: Lệ đặt bao giờ, Ấy là quốc pháp hay là phủ quy” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Phân Tự", "definition": "Những chùa viện do Thiên Hoàng Thánh Vũ (724-749) của Nhật Bản ban sắc xây dựng ở 69 nơi trên toàn quốc. Các chùa tăng đặt tên là Kim Quang Minh Tứ Thiên Vương Hộ Quốc, còn các chùa ni thì có hiệu là Pháp Hoa diệt tội.Chùa tăng gọi chung là Quốc Phân Tự, chùa ni gọi chung là Quốc Phân Ni Tự. Các chùa viện này đều chung 1 lí tưởng là “Chính Giáo Nhất Trí” (Chính trị và tông giáo là một), cầu nguyện chư Phật gia hộ để tiêu trừ tai họa, tăng trưởng phúc đức. Quốc Phân Tự là phỏng theo Khai Nguyên tự của Trung Quốc do vua Huyền Tông thiết lập vào đời Đường. Trong các Quốc Phân Tự thì lấy Đông Đại Tự làm Tổng Quốc Phân Tự, còn Pháp Hoa tự ở Nại Lương là Tổng Quốc Phân Ni Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Phí", "definition": "國費. Tiền bạc của cải chi dùng vào việc nước. Như Quốc dụng 國用.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Phòng", "definition": "國防. Việc gìn giữ đất nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Phú", "definition": "國富. Sự giàu có của một nước Của cải chung trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Phụ", "definition": "國父. Nhân vật có công lớn với nước, được dân chúng kính trọng như cha.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Quang", "definition": "國光. Sự vẻ vang của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Quyền", "definition": "國權. Chủ quyền của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sĩ", "definition": "國士. Người học giỏi, danh tiếng trong nước. Người tài giỏi trong nước. Đoạn trường tân thanh có câu: “Từ rằng quốc sĩ xưa nay, Chọn người tri kỉ một ngày được chăng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sư", "definition": "Kokushi (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quốc Sư Tam Hoán", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Sư Tháp Dạng", "definition": "Cũng gọi Trung Quốc Sư Vô Phùng Tháp, Túc Tông Thỉnh Tháp Dạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Sư Thủy Oản", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Sản", "definition": "國產. ChỈ chung tất cả những vật làm ra trong cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sắc", "definition": "國色. Vẻ đẹp nhất nước. Chỉ người con gái cực đẹp. Đoạn trường tân thanh có câu: “Người quốc sắc kẻ thiên tài, Tình trong như đã mặt ngoài còn e”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sắc Thiên Hương", "definition": "國色天香. Vẻ đẹp của nước, mùi thơm của trời, tức sắc nước hương trời, chỉ người con gái đẹp tuyêt trần Một tên chỉ loài hoa Mẫu đơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sứ", "definition": "國使. Viên chức thay mặt cho cả nước để ra nước ngoài lo việc. Nay gọi là Đại sứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sử", "definition": "國史. Sách chép việc xảy ra trong một nước, trải qua nhiều thời đại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sử Quán", "definition": "國史館. Cơ quan có nhiệm vụ biên soạn tu sửa sách vở về lịch sử. Nguyễn Công Trứ đã từng giữ chức Biên tu tại Quốc sử quán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sự", "definition": "國事. Việc nước Việc trọng đại, liên hệ tới cả nước Việc chính trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Sự Phạm", "definition": "國事犯. Như Chính trị phạm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tang", "definition": "國喪. Chỉ cái chết của vua Chỉ cái chết của một danh nhân trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thanh Bách Lục", "definition": "Tác phẩm, 4 quyển, do ngài Quán Đính biên soạn vào đời Tùy, được thu vào Đại Chính Tạng tập 46.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Thanh Tự", "definition": "Chùa ở chân núi phía nam ngọn Phật Lũng, núi Thiên Thai, phía bắc huyện Thiên Thai, tỉnh Chiết Giang, Trung Quốc là nơi phát tích của Tông Thiên Thai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Thanh Tự Tháp", "definition": "國 清 寺 塔 (331). ở phía đông chùa Quốc Thanh, núi Thiên Thai, tỉnh Chiết Giang, Trung Quốc. Được xây dựng vào đời Tùy, niên hiệu Kiến Viêm thứ 3 (1129) đời Tống được xây lại trên nền tháp đời Tùy. Tháp gạch 6 mặt, 9 tầng, cao 59,3m theo kiểu lâu các. Trong tháp rỗng ruột, kết cấu bằng gạch gỗ, phần mái gỗ đã bị lửa thiêu hủy, hiện chỉ còn phần vách bằng gạch bày ra màu vàng nâu, trên vách có nhiều tượng Phật khắc nổi sinh động như sống, vô cùng tinh xảo đẹp đẽ. Cả tháp tạo dáng thanh tú mạnh mẽ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quốc Thuật", "definition": "國術. Tài khôn khéo trong việc trị nước Nền võ nghệ riêng của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thuế", "definition": "國稅. Tiền nạp cho nhà nước để dùng vào việc ích lợi chung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thích", "definition": "國戚. Họ hàng về bên mẹ và bên vợ của vua Tấn thơ Vương khải truyện: Khải kí thế tộc quốc thích, tánh phục hào xỉ (Vương phải vốn quốc thích đời này qua đời kia, lại thêm tánh hào phóng xa xỉ) “Hoàng thân quốc thích gian nguy” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thù", "definition": "國讐. Mối thù chung của cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thần", "definition": "國神. Vị anh hùng chết đi, được cả nước thờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thế", "definition": "國勢. Cái chỗ đứng của nước nhà, cái đường hướng mạnh yếu của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thể", "definition": "國體. Mặt mũi, tiếng tăm của cả nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thị", "definition": "國是. Đường lối chung của cả nước, được cả nước cho là phải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Thống", "definition": "Tên 1 chức quan tăng ở thời Đông Ngụy thuộc Bắc triều, Trung Quốc. Theo Tăng chế qui định, chức quan này có thẩm quyền xử trị các tăng ni phạm tội giết người và các tội khác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Thủ", "definition": "國手. Người giỏi trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Trái", "definition": "國債. Món nợ nhà nước đã vay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Trụ", "definition": "國柱. Chỉ nhân vật quan trọng, coi như trụ cột chống đỡ nước nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tuý", "definition": "國粹. Cái hay cái đẹp của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Táng", "definition": "國葬. Được chôn cất linh đình, do nhà nước đứng ra lo liệu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tính", "definition": "國姓. Họ của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tặc", "definition": "國賊. Kẻ hại nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tế", "definition": "國際. Việc giao thiệp và mối liên hệ giữa hai hay nhiều nước Ngày nay chỉ chung tất cả nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tế Công Pháp", "definition": "國際公法. Luật lệ chung mà mọi quốc gia đều nhìn nhận để tuân theo trong việc đối xử, giao thiệp với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tế Mậu Dịch", "definition": "國際貿易. Việc buôn bán trao đổi giữa nước này với nước khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tế Tư Pháp", "definition": "國際私法. Chỉ chung những luật lệ ấn định mối liên hệ giữa người dân nước này với người dân nước khác với tư cách riêng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tế Địa Vị", "definition": "國際地位. Chỗ đứng của một nước trên thế giới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tệ", "definition": "國幣. Tiền bạc dùng trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tỉ", "definition": "國壐. Cái ấn của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tịch", "definition": "國籍. Sổ sách ghi chép về người trong nước Sự được ghi chép trong sổ dân nước nào, cho biết người nào là dân nước đó (Nationalité).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tộc", "definition": "國族. Cũng như Dân tộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tử", "definition": "國子. Con cháu các quan, được nhìn nhận như con của đất nước, được triều đình chăm sóc học hành Ngày nay còn được hiểu là con cái của những người đã hi sinh cho nước, được chính phủ giúp đỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tử Giám", "definition": "國子監. Trường học lập ợ kinh đô xưa, dành cho con cái các quan và những học trò xuất sắc trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tử Tư Nghiệp", "definition": "國子司業. Tên quan chức đứng đầu các vị học quan, dạy tại Quốc tử giám, tương tự như chức Giám học ngày nay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Tử Tế Tửu", "definition": "國子祭酒. Tên chức quan thời xưa, đứng đầu Quốc tử giám, tức là vị hiệu trưởng của ngôi trường Đại học này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Uy", "definition": "國威. Cái oai, vẻ bề ngoài của một nước, khiến các nước nể nang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Văn", "definition": "國文. Thứ chữ viết của một nước Chỉ chung nền văn học của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Vương", "definition": "國王. Vị vua đứng đầu một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Vương Ngũ Chủng Khả Ái Lạc Pháp", "definition": "國王五種可愛樂法 (Phật Vị Ưu Điền Vương Thuyết Vương Pháp Chính Luận Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quốc Vương Ngũ Chủng Khả Ái Nhạo Pháp", "definition": "Năm pháp đáng ưa thích của ông vua một nước.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Vận", "definition": "國運. Như Quốc bộ 國步. “Gửi nay quốc vận đương truân” (Hạnh Thục ca).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Vụ", "definition": "國務. Công việc trong nước. Việc nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Vụ Khanh", "definition": "國務卿. Chức vụ điều khiển một bộ trong chính phủ Trung Hoa Dân quốc, lúc mới thành lập Chức vụ thời đệ nhị Cộng hoà tại Việt Nam, ngang với Tổng Bộ trưởng, nhưng không giữ bộ nào, mà được giao riêng từng công việc, coi như người giúp việc cho Tổng thống. Td: Quốc vụ khanh đặc trách Văn hoá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Âm", "definition": "國音. Tiếng nói nước nhà, tiếng nói của dân nước mình Chữ viết, đọc lên thành tiếng nước mình. Như: Quốc ngữ. Td: Niên hiệu Hồng đức đời Lê Thánh Tông có tập thơ bằng chữ Nôm nhan đề là Hồng Đức Quốc âm thi tập.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Điển", "definition": "國典. Phép tắc chỉ luật lệ chung của một nước Chỉ chung các sách vở ghi chép việc tổ chức của một nước Cuộc lễ lớn của một nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Đô", "definition": "國都. Nơi vua đặt triều đình Nơi đặt chính phủ của một nước. Như: Thủ đô.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Định", "definition": "國定. Do nhà cầm quyền trong nước đặt ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Đố", "definition": "國蠹. Con mọt nước, chỉ kẻ hại dân hại nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quốc Độ", "definition": "Kṣetra (S), Khetta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quốc Độ A Du Đà", "definition": "Ayodhyā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Quốc Độ Dơ Nhớp", "definition": "Uế độ: chỉ cho thế giới Ta-bà của chúng ta. Kinh A Di Đà nói thế giới Ta-bà này có 5 thứ dơ nhớp (ngũ trược) là: kiếp dơ nhớp (kiếp trược), thấy biết dơ nhớp (kiến trược), phiền não dơ nhớp (phiền não trược), chúng sinh dơ nhớp (chúng sinh trược), và đời sống dơ nhớp (mạng trược). Chữ “dơ nhớp” (uế, trược) ở đây không nằm trong ý nghĩa dơ sạch thường dùng như tay chân dơ nhớp, áo quần dơ dáy, bàn ghế đầy bụi dơ, v.v..., mà có nghĩa là xấu xa (trong cả ba nghiệp thân, khẩu, ý), đầy dẫy dục vọng, tà kiến, sai lầm, ác độc, oán thù, phiền muộn, đau khổ, tội lỗi, v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Quốc Độ Hải Thế Giới Hải", "definition": "Chỉ cho cõi nước của Phật. Kinh Hoa Nghiêm chia cõi nước Phật làm 2 loại là Quốc Độ Hải và Thế Giới Hải.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Độ Thân", "definition": "Phạm: Kwetra-kàya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quốc Độ Thế Gian", "definition": "Cũng gọi Khí Thế Gian, Trụ Xứ Thế Gian. Một trong 3 loại thế gian. Chúng Sinh trong 10 pháp giới đều tùy y báo của mình mà có 10 chỗ cư trú khác nhau. Thân năng y của chúng sinh có 10 loại bất đồng, nên quốc độ sở y cũng đều khác nhau, vì thế gọi là Quốc Độ Thế Gian. [X. Luận Đại Trí Độ Q.47; Ma Ha Chỉ Quán Q.5 thượng]. (xt. Tam Thế Gian).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Quở Phạt", "definition": "Niggaha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quở Trách", "definition": "Vigarahati (vi + garah + a), nigganhati (ni + gah + ṇhā), nindati (nind + a), sānuvajja (tính từ), sāvajja (tính từ), paribhāsa (nam), ovadati (ova + vad + a), tajjaniya (tính từ), kaṭikkosati (paṭi + kus + a), paṭicodeti (paṭi + cud + e), avaṇṇa (trung), codeti (cud + e), apavadati (apa + vad + a), apavāda (nam), akkosati (ā + kus + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quỳ", "definition": "夔. Tên một loại thú lạ, hình dáng như con trâu, nhưng không có sừng và chỉ có một chân Tên người, bề tôi của vua Thuấn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳ Hướng", "definition": "葵向. Xoay về hướng mặt trời như bông hoa quỳ. Chỉ lòng trung thành hướng về người nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳ Khuynh", "definition": "葵傾. Nghiêng về phía mặt trời. Nghĩa bóng như Quỳ hướng 葵向.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳ Phiến", "definition": "葵扇. Cái quạt làm bằng lá cây quỳ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳ Tâm", "definition": "(葵心): tấm lòng trong sạch hướng về ánh sáng mặt trời, tâm tận trung và cung kính đối với nhà vua hay người bề trên. Quỳ (葵) là một loại rau hướng về bốn phương mà nở hoa; như Sở Quỳ (楚葵) là loại rau cần, Phù Quỳ (鳬葵) là rau nhút, Nhật Hướng Quỳ (日向葵) là hoa hướng dương, v.v. Cho nên quỳ tâm còn có nghĩa là tâm chí thành, chí kính hướng về đấng tối cao. Trong bài thơ Hữu Tửu (有酒) của Nguyên Chẩn (元稹, 779-831) nhà Đường có câu: “Quỳ tâm khuynh hề hà hướng, tùng ảnh trực nhi thục minh (葵心傾兮何向、松影直而孰明, Lòng thành nghiêng chừ nào hướng, tùng bóng thẳng mà sáng đâu ?).” Hay trong bài Phụng Hòa Trần Hiền Lương (奉和陳賢良) của Tô Thức (蘇軾, 1037-1101) nhà Tống cũng có câu: “Vọng cùng hải biểu thiên hoàn viễn, khuynh tận quỳ tâm nhật du cao, thân ngoại phù danh hưu tỏa tỏa, mộng trung quy tư dĩ thao thao (望窮海表天還遠、傾盡葵心日愈高、身外浮名休琐琐，梦中归思已滔滔。身外浮名休瑣瑣、夢中歸思已滔滔, Trông cùng biển cả trời xa thẳm, nghiêng tận lòng thành trời lên cao, thân thoát huyễn danh thôi bôn tẩu, mộng trong về ngẫm thôi lao đao).” Hoặc trong bài Đào Hoa Phiến (桃花扇) của Khổng Thượng Nhiệm (孔尚任, 1648-1718) nhà Thanh có câu: “Bồ kiếm hà tu thức, quỳ tâm vị khẳng sai (蒲劍何須試、葵心未肯差, Kiếm cỏ làm sao thử, lòng thành đâu biết sai).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quỳnh", "definition": "惸. Xem các từ ngữ Quỳnh độc 惸獨, Quỳnh quỳnh 惸惸.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Bôi", "definition": "瓊杯. Chén bằng ngọc quỳnh, tức chén rượu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Dao", "definition": "瓊瑶. Ngọc quỳnh ngọc dao, hai thứ ngọc quý và đẹp. Chỉ sự quý giá cao đẹp. Đoạn trường tân thanh có câu: “Một vùng như thể cây quỳnh cành dao” 王演如瓊林瑶樹 Vương Diễn như quỳnh lâm dao thụ: Người Vương Diễn đẹp như cây ngọc dao trong rừng ngọc quỳnh. Đây nói một người rất đẹp. “Một vùng như thể cây quỳnh cành dao” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Diên", "definition": "瓊筵. Bữa tiệc nhiều món ngon quý. “Quỳnh diên dê béo rượu nồng” (Tầm nguyên tđ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Hoa", "definition": "瓊花. Tên một thứ ngọc quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Lâm Tự", "definition": "瓊 林 寺. Chùa ở chân núi Quỳnh Lâm, nay thuộc xã Đông Triều, huyện Đông Triều, tỉnh Quảng Ninh, Việt Nam. Đây là một trong những ngôi chùa lớn nổi tiếng bậc nhất ở thời Trần. Chùa có viện (tức Quỳnh Lâm Viện) là nhà giảng kinh, và am gọi là am Bích Động, nơi Pháp Loa đọc sách và đón tiếp tăng hữu. Tăng đồ các nơi trong nước đến chùa Quỳnh Lâm theo học. Chùa cũng nhận được sự cúng dường rất lớn của nhiều người trong hoàng tộc… Ruộng chùa Quỳnh Lâm có đến 1. 000 mẫu, tá điền đông đến 1. 000 người. Những năm cuối thế kỷ XIII đầu thế kỷ XIV, cùng với chùa Vân Yên ở Yên Tử, chùa Báo Ân ở Siêu Loại, chùa này vào thời điểm Thiền Sư Pháp Loa trụ trì, là một trong ba trung tâm lớn nhất của giáo hội Trúc Lâm thời Trần. Trần Nhân Tông sau khi đã xuất gia từng đến thuyết pháp ở đây. Sau khi Pháp Loa mất (1336) chùa này vẫn được ngưỡng mộ vì là nơi lưu dấu các vị Tổ của thiền phái Trúc Lâm. Chùa đã qua vài lần bị phá hủy và kiến thiết lại. Vào thời Thiệu Trị (1840- 1847) chùa bị một bọn thổ hào đốt trụi chính điện và tiền đường, tương truyền chỉ có pho tượng Trần Nhân Tông là không cháy. Theo: DTLSVHVN do Ngô Đức Thọ chủ biên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quỳnh Lâu", "definition": "瓊樓. Lầu xây bằng ngọc quỳnh, tức cung điện trên mặt trăng, chỉ cung trăng. “Ra vào kim khuyết quỳnh lầu” (Bích Câu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Lưu Tiết Phụ Truyện", "definition": "瓊瑠節婦傳. Tên một cuốn sách chữ Nôm của Phạm Đình Toái, danh sĩ đời Thiệu Trị, nội dung kể sự tích những người đàn bà tiết hạnh ở huyện Quỳnh lưu tỉnh Nghệ An. Xem tiểu truyện tác giả ở vần Toái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Mao", "definition": "藑茅. Tên một loài cỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Quỳnh", "definition": "惸惸. Lòng dạ lo lắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Tư", "definition": "瓊姿. Dáng dấp cử chỉ đẹp đẽ thanh cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Tương", "definition": "瓊醬. Nước ngọc quỳnh, chỉ rượu quý. Đoạn trường tân thanh có câu: “Chén hà sánh giọng quỳnh tương, giải là hương lộn bình gương bóng lồng” Nhất âm quỳnh tương bách cảm sinh 一飲瓊醬百感生 (Đường thi)", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Uyển Cửu Ca", "definition": "瓊苑九歌. Chín bài hát trong vườn quỳnh, tên một tập thi ca bằng chữ Hán của Lê Thánh Tông và 28 văn thần trong Hội Tao đàn Nhị thập bát tú.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỳnh Độc", "definition": "惸獨. Cô đơn một mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỵ", "definition": "卼. Hơn. Thắng (trái với thua).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỵ Bái", "definition": "跪拜. Quỳ lạy,.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỵ Lụy", "definition": "跪累. Hạ thấp mình xuống để làm vừa lòng người khác hầu đem lợi cho mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỵ Tạ", "definition": "跪謝. Quỳ gối để tỏ lòng biết ơn, hoặc để xin tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ", "definition": "傀. Xem Quỷ lỗi 傀儡 Một âm là khôi. Xem Khôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Biện", "definition": "詭辯. Lí luận khôn ngoan dối trá Lí luận lạ lùng quái dị, không hiểu nổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Bí", "definition": "詭秘. Dối trá khó hiểu, đáng nghi ngờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Bệnh", "definition": "Các loại bệnh người mắc, nhưng do loài quỷ gây ra.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quỷ Cái", "definition": "Yakkhinī (nữ), yakkhī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Quỷ Công", "definition": "鬼工. Việc khéo léo, giỏi giang, người thường khó lòng làm nỗi (ý nói chỉ có ma quỷ mới làm nỗi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Cốc Tử", "definition": "鬼谷子. Tên một học giả, một nhà hùng biện, một nhà chính trị lừng danh thời Xuân Thu, thầy học của hai nhà du thuyết là Tô Tài và Trương Nghi. Đời sau thường nhận làm Quỷ Cốc Tử là tổ sư của nghề bối toán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Hào Thần Khấp", "definition": "鬼 號 神 泣. Thần khóc quỷ gào. Hình dung dáng vẻ mừng giận, buồn vui đến cực điểm giống như sự gào khóc của quỷ thần. Tắc 59, Bích Nham Lục (Đại 48, 192 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quỷ Khuất Lý Tử Thiền Hòa Tử", "definition": "鬼 屈 裏 子 禪 和 子. Thiền sinh bị quỷ ám. Quỷ khuất lý tử: Trong lòng bị quỷ ám. Thiền hòa tử: Thiền sinh, người tu học theo đạo Thiền. Đây là thuật ngữ để chỉ cho những người có tâm hắc ám, nhiều thiên kiến. Tông Lâm Tế ở Nhật Bản thường sử dụng thuật ngữ này để trách mắng các vị Thiền tăng nhiều ngã mạn cống cao. Sư Bạch ẩn Huệ Hạc đến tham vấn Thiền Sư Lão Ông ở chùa Chính Thọ Am. Thiền Sư vừa thấy Bạch ẩn vào cửa liền nói: Thiền sinh bị quỷ ám.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quỷ Khốc", "definition": "鬼哭. Ma phải khóc, chỉ sự việc xảy ra ghê gớm lắm. Thường nói: Thần kinh quỷ khốc (Thần phải sợ, ma phải khốc).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Kế", "definition": "詭計. Sự bàn tính sắp đặt rất khôn ngoan dối, không ai biết được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Lý Tử Đan", "definition": "(鬼理死丹): xem Cát Lợi Chi Đan (吉利支丹) Christão [tiếng Bồ Đào Nha]): ban đầu từ này được viết là Cát Lợi Chi Đan (吉利支丹); nhưng sau khi Thiên Chúa Giáo bị cấm đoán thì được viết là Quỷ Lý Tử Đan (鬼理死丹) hay Thiết Tử Đan (切死丹), v.v. Hơn nữa, từ thời Tướng Quân Đức Xuyên Cương Cát (德川綱吉, Tokugawa Tsunayoshi) trở đi, để tránh tên húy chữ “Cát (吉)” của ông, người ta viết thành Thiết Chi Đan (切支丹). Đây là tên gọi chỉ cho Thiên Chúa Giáo vốn do giáo sĩ Francisco de Zabiel truyền vào Nhật năm 1549 (Thiên Văn [天文] 18), hay tên gọi của tín đồ đạo ấy; còn được gọi là Tông Thiết Chi Đan (切支丹宗), Tông Nam Man (南蠻宗)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Quỷ Lỗi", "definition": "傀儡. Pho tượng gỗ Không có chủ trương nhất định, ai nói sao nghe vậy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Nhãn Tình", "definition": "鬼 眼 睛. Con mắt quỷ quái. Tỷ dụ cho cái thấy chẳng chân chính, hoặc kiến giải nông cạn, không có chút giá trị. Phần giáp chú trong tắc 5, Bích Nham Lục (Đại 48, 144 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quỷ Nhị Sanh", "definition": "鬼二生 (Câu Xá Thích Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quỷ Phần Cửu Loại", "definition": "鬼分九類 (A Tì Đạt Ma Thuận Chánh Lý Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Quỷ Quyệt", "definition": "詭譎. Khôn ngoan dối trá, giỏi lừa gạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Quái", "definition": "詭怪. Rất lạ lùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Quật Lý", "definition": "鬼 窟 裏. Còn gọi: Giả Giải Thoát Khanh. Trong hang quỷ, là chỗ rất âm u, tỷ dụ cho cảnh giới vướng mắc trong tình thức nên mê mờ chẳng thấy được chân lý. Chỉ cho trạng thái ngoan không mà thiền giả chấp trước cho là cảnh giới ngộ. Từ đó bị vướng mắc chẳng thông trở thành tà kiến. Tắc 1, Bích Nham Lục (Đại 48, 141 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quỷ Sứ", "definition": "鬼使. Loài ma, giữ chân sai bảo ở âm ty. “Ấy rằng quỷ sứ hay rằng hồ binh” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Sử", "definition": "鬼使. Bị ma sai khiến, ý nói không tự chủ được, làm xong mà không hiểu tại sao mình làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Thoại", "definition": "鬼話. Lời nói vô căn cứ, không đáng tin.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Thuật", "definition": "鬼術. Cái tài khéo giả dối, không có thật, giống như tài của ma.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Thú", "definition": "鬼 趣. Còn gọi: Quỉ Quật. Chỉ cho tình thức ý tưởng. Tiết Đầu Tử Nghĩa Thanh trong NĐHN q. 14 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Quỷ Thần", "definition": "鬼神. Ma thường, và hồn người chết thiêng được thờ cúng. Đoạn trường tân thanh có câu: “Mai sau dầu đến thế nào, Kìa gương nhật nguyệt nọ dao quỷ thần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Thị", "definition": "鬼市. Chợ họp ban đêm, người đi chợ như những bóng ma, khiến chợ như chợ ma.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Thủ", "definition": "鬼手. Tay ma, ý nói tay lạnh ngắt Cũng chỉ bàn tay của kẻ cắp, như tay ma tay quỷ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Tùy", "definition": "詭隨. Nhắm mắt mà theo, không suy nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Tử", "definition": "鬼子. Thằng quỷ, tiếng dùng để chửi mắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Ám", "definition": "詭暗. Dối trá mờ ám.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Đói", "definition": "A; hungry ghost; H. Ngạ quỷ. Thường được mô tả như loài quỷ có miệng bốc lửa, với cổ họng nhỏ như kim, miệng hôi thối, luôn bị cái đói dày vò.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quỷ Đạo", "definition": "詭道. Đường lối gian trá lừa gạt Còn chỉ phép dùng binh, vì dùng binh thì không ngại gian dối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỷ Đặc", "definition": "詭特. Lạ lùng quái dị, không giống cái gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ", "definition": "厬. Nước cạn khô. Hết nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Bần Lương", "definition": "饋貧糧. Chỉ sự cần thiết của học vấn, cũng như đồ ăn đem cho người nghèo vậy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Hiến", "definition": "饋獻. Dâng đồ cúng tế Tặng biếu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Khắc", "definition": "晷刻. Thời gian. Thì giờ. Như: Thời khắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Mô", "definition": "軌模. Phép tắc khuôn mẫu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Nhân", "definition": "饋人. Người giữ việc cung cấp ăn uống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Thực", "definition": "饋食. Lễ cúng cơm mới cho trời đất tổ tiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Trì", "definition": "Giữ gìn khuôn phép. Từ Pháp (S. Dharma) được định nghĩa là quỹ trì. Ý nói mỗi pháp (sự vật) đều có khuôn phép hay thuộc tính của nó, khiến có thể dựa vào khuôn phép hay thuộc tính đó mà biết nó, phân biệt nó với những cái khác. Vd, cái bàn có khuôn phép hay thuộc tính cái bàn, khiến chúng ta khi thấy nó, biết ngay đấy là cái bàn. Trì là gìn giữ. Cái bàn phải giữ được thuộc tính cái bàn, nếu không thì sẽ không nhận biết được nó với các sự vật khác.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Quỹ Tuế", "definition": "餽歲. Lễ cúng cuối năm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Tắc", "definition": "軌則. Lề lối cách thức phải theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Tịch", "definition": "揆席. Người nắm trọn quyền điều hành quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Đạo", "definition": "軌道. Đường đi của các hành tinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Quỹ Độ", "definition": "揆度. Đo lường, ước lượng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ra Hầu La", "definition": "Xem La Hầu La.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ra Khỏi", "definition": "Niyyāti (ni + ya + a), niyyāma (trung), virahita (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ra Khỏi Ba Cõi", "definition": "Transcend the threefold world", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Ra Lệnh", "definition": "Āṇāpeti (ā + nā + āpe), niyoga (nam), niyojana (trung), paṇeti (pa + ni + e), samādisati (saṃ + ā + dis + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ra Sức", "definition": "Vāyamati (vi + ā + yam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ra Trải Giường", "definition": "Mañcattharaṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ra Đát Nẵng Mô Nại Ra Hạ Đát Đa", "definition": "Xem Bảo Ấn Thủ Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rackety", "definition": "Om sòm, ầm ỉ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Raga", "definition": "Dục ái. Tham ái.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Rage", "definition": "Sân hận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rahula", "definition": "Buddha’s son (La-Hầu-La)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rajagaha", "definition": "Vương-Xá, kinh đô xứ Ma-Kiệt-Đà (Magatha)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rakkhita", "definition": "Rakkhita (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ramakrishna", "definition": "Ramakriṣna.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ramanamaharshi", "definition": "Ramanamahārshi.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ramanuja", "definition": "Ramanuja.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ramification", "definition": "Branched structure = cấu trúc phân nhánh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rampant", "definition": "Chồm lên, hung hăng, hùng hổ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rancor", "definition": "Hiềm thù, thù oán", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rangjung Dorje", "definition": "Rangjung Dorje (S), 1284-1339 C.E..", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rangton Phái", "definition": "Rangton School.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ranh Giới", "definition": "Avadhi (nam), mariyādā (nữ), odhi (nam), pariccheda (nam), parimāṇa (trung), pariyanta (nam), sīmā (nữ), velā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ranh Mãnh", "definition": "Vāla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rapacious", "definition": "Tham lam, keo kiệt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rapt", "definition": "Mê ly, sung sướng vô ngần", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ratanattaya", "definition": "Ba ngôi báu, tam bảo.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Ratiocination", "definition": "Sự suy luận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rau Cải", "definition": "Sāka (nam)(trung), harita (trung), ḍākaṃ (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rau Cỏ", "definition": "Bhūtagāma (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Raucous", "definition": "Giọng khàn khàn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ravage", "definition": "Tàn phá", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ravenous", "definition": "Ăn ngấu nghiến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Realm", "definition": "Kingdom, sphere, domain =vương quốc, lãnh vực, địa hạt, giới", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rebuked", "definition": "Bị khiển trách, quở trách", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rebuttal", "definition": "Bác bỏ, tố cáo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recalcitrant", "definition": "Hay cãi lại, hay chống lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recapitulation", "definition": "Restate briefly = tóm tắt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recede", "definition": "Lùi lại, rút xuống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recension", "definition": "Duyệt lại, xem xét lại một văn kiện", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reciprocity", "definition": "Mutual exchange = sự trao đổi hỗ tương", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recite", "definition": "Đọc kinh (Recite sutra = tụng kinh)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reckon", "definition": "Tính, đếm, liệt kê", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reclamation", "definition": "Khai phá đất", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recluse", "definition": "Nhà tu khổ hạnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recoil", "definition": "Giật lại, bật lên, dội lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recondite", "definition": "Khó hiểu, tối nghiã", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reconnoitre", "definition": "Trinh sát, do thám, thăm dò vị trí địch", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rectify", "definition": "Sửa cho thẳng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rectilinear", "definition": "Thẳng, phẳng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Recur", "definition": "Trở lại vấn đề (Recurrent - Tái diễn đều đặn)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Redolent", "definition": "Thơm phức, sực mùi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Redound", "definition": "Góp phần vào", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Redress", "definition": "Sửa sai, uốn nắn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reeling", "definition": "Xỏ dây qua ròng rọc, cuốn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Refectory", "definition": "Phòng ăn, nhà ăn ở trường học hay tu viện", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Refraction", "definition": "Khúc xạ, độ khúc xạ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Refrain", "definition": "Điệp khúc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Refuge", "definition": "Trú ẩn, nương náu, nương tựa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Refute", "definition": "Prove to be false by argument = bác bỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Regal", "definition": "Thuộc vua chúa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Regalia", "definition": "Biểu chương, y phục của vua", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Regent", "definition": "Quan nhiếp chính", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Regicide", "definition": "Kẻ phạm tội giết vua, kẻ dự mưu giết vua", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Regression", "definition": "Thoái bộ, ngược dòng, hồi quy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reification", "definition": "Process or result of reifying = vật chất hóa, cụ thể hóa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reincarnation", "definition": "Sự tái sinh trong một thể xác mới – ‘has been an enduring belief for thousands of years and is part of almost every modern culture. It was once a part of Christianity, until it was eradicated in 325 AD by the Roman Emperor Constan- tine at the council of Nicaea in an effort to unite various feuding factions of his empire.’ Is the cycle of necessity, also known as the will of birth or rebirth. The word comes from the Latin for incarnate, which means “to make flesh”. Reincarnation is the metaphysical principle that the human soul goes through many incarna- tions in flesh to gradually perfect itself. The Sanskrit word samsara has been translated as reincarnation or rebirth, transmigration, reemergence, regeneration, renewal are all words in relation to reincarnation.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rejoice", "definition": "Làm cho vui mừng, hoan hỉ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rejuvenate", "definition": "Làm trẻ lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rekindle", "definition": "Kích thích, làm phấn chấn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Relegate", "definition": "To send into exile = lưu vong (Relegated = bị loại bỏ)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Relentless", "definition": "Tàn nhẫn, không thương xót", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Relevant", "definition": "Thích đáng, thích hợp (Relevance - sự thích hợp)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Relic", "definition": "The Buddha’s cremated remains = xá lợi (relic stupa = tháp xá lợi)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Relinquish", "definition": "Từ bỏ, thôi không làm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reliquary", "definition": "Hộp/nơi để thành tích của người sùng đạo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Relished", "definition": "Hương vị, mùi vị (Relish - đồ gia vị)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reminiscent", "definition": "Hồi tưởng, gợi lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Remonstrate", "definition": "Phản kháng, phản đối", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Renunciation", "definition": "Từ bỏ, không nhận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reo Hò", "definition": "Ugghoseti (u +ghus + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Repent", "definition": "Ăn năn, hối lỗi (Repentance = sự hối lỗi)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Repercussion", "definition": "Reflection = reverberation = sự dội lại, phản chiếu, phản xạ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Replete", "definition": "No nê, đầy đủ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reprobate", "definition": "Người bị chúa đày xuống địa ngục, người tội lỗi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Repudiate", "definition": "Từ chối, thoái thác", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Repugnant", "definition": "Đáng ghét, gây ra cảm xúc phản kháng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Repulsion", "definition": "Sự kinh tởm, lợm giọng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Repulsive", "definition": "Ghê tởm, đáng ghét", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resemble", "definition": "Giống, tương tự", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resentment", "definition": "Bitterness, envy = oán giận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resilient", "definition": "Đàn hồi, co giản", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Respite", "definition": "Hoản thi hành bản án, thời gian trì hoản", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resplendent", "definition": "Chói lọi, rực rỡ, lộng lẫy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resurgence", "definition": "Rising again into life = hồi sinh, sống lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resurrect", "definition": "Làm sống lại, phục hồi lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Resuscitate", "definition": "Làm cho tỉnh lại, làm rõ nét lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reticent", "definition": "Kín đáo, tính trầm lặng, ít nói", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Retinue", "definition": "Group of retainers or attendants = đoàn tuỳ tùng của vua chúa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Retort", "definition": "Trả đủa, trả miếng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revamp", "definition": "Revise, renovate = tân trang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revell", "definition": "Tham dự cuộc vui, người dự cuộc chè rượu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revelry", "definition": "Merry-making, fun = vui chơi, ăn chơi chè chén", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reverberating", "definition": "Reflecting = dội lại, phản chiếu, phản xạ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revere", "definition": "Tôn kính, sùng kính", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reverend", "definition": "Tỳ kheo, tăng sĩ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reverentially", "definition": "Tỏ vẻ tôn kính", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Reveting", "definition": "Mối ghép đinh tán", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revile", "definition": "Chửi rủa, mắng nhiềc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revivification", "definition": "To give a new life, reliving a past event = hồi sinh, làm sống lại", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Revulsion", "definition": "Khiếp sợ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rhetoric", "definition": "Hùng biện", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rhubarb", "definition": "Cây đại hoàng, cây xi cuống lá màu đỏ nấu lên ăn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rhyme", "definition": "Vần, từ gieo vần cho một từ khác", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rift", "definition": "Đường nứt, kẻ hở", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rind", "definition": "Vỏ trái cây", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rinpoche", "definition": "Vajrayana master = pháp sư Kim Cang Thừa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ripped", "definition": "Being under the influence of alcohol or drugs", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ripple", "definition": "Gợn sóng lăng tang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Risibility", "definition": "Tính hay cười", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Riêng Biệt", "definition": "Odissaka (tính từ), niddhāraṇa (trung), pacceka (tính từ), asādhāraṇa (tính từ), āveṇika (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Roi", "definition": "Daṇḍaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Roi Da", "definition": "Kasā (nữ), varattā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rong Rêu", "definition": "Sevāla (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rotund", "definition": "Giọng nói oang oang, phục phịch, mập mạp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rouse", "definition": "Kèn đánh thức (trong trại lính)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ru Dỗ", "definition": "Lāleti (lal + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rubric", "definition": "Heading in red letters = đề mục", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rucksack", "definition": "Túi đeo vai, ba lô", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rudiment", "definition": "Nguyên lý cơ bản, sơ đẳng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rui", "definition": "Gopānasī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Run Rẩy", "definition": "Saṅkampati (saṃ + kamp + a), pakampati (pa + kamp + e), pariphadati (pari + pland + a), satāsa (nam), tasa (tính từ), vikampati (vi + kamp + a), vikampana (trung), vipphurati (vi + phur + a), vedhati (vidh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Run Sợ", "definition": "Satāsasī (tính từ), tāsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Run Động", "definition": "Tasa (tính từ), tasati (tas + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rung", "definition": "One of the crossed-pieces of a ladder = bậc thang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Rung Chuyển", "definition": "Parisappanā (nữ), vedhati (vidh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rung Rinh", "definition": "Pakampati (pa + kamp + e), pacālaka (tính từ), kampati (kamp + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rung Rẩy", "definition": "Phandati (phad + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rung Động", "definition": "Vikampati (vi + kamp + a), vikampana (trung), vipphurati (vi + phur + a), saṅkampati (saṃ + kamp + a), saṅkopa (nam), pavedhati (pa + vedh + a), phandana (trung), pharaṇa (trung), iñjati (iñ + a), iñjana (trung), iñjanā (nữ), cañcala (tính từ), cala (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rupa", "definition": "Sắc, vật chất", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Ruth", "definition": "Lòng thương, lòng trắc ẩn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ruthlessly", "definition": "Tàn nhẫn, độc ác", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ruồi", "definition": "ḍaṃsa (nam), makkhikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ruộng", "definition": "Khetta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ruộng Muối", "definition": "Lonī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ruộng Phúc", "definition": "Tu sĩ xuất gia, sống nếp sống tu hành trong sạch là ruộng phúc đối với dân chúng cung kính, trọng đãi cúng dường họ. Nếu ai cúng dường cho họ thì được phúc lớn. Vì vậy mà áo của tu sĩ mặc gọi là phúc điền y (áo ruộng phúc). Có người giải thích là vì áo của tu sĩ Phật giáo Nam tông thường làm bằng rất nhiều mảnh khâu lại, trông giống như các mảnh ruộng, cho nên có tên gọi áo phúc điền.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Ruột", "definition": "Udara (trung), kucchi (nam) (nữ), jaṭhara (nam) (trung), miñja (trung), anta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ruột Già", "definition": "Vaccamagga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ràng Buộc", "definition": "Sārajjati (saṃ + raj + ya), yoga (nam), vinibandha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ràng Buộc Của Người Thế Tục", "definition": "Gihībandhana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rành Mạch", "definition": "Catura (tính từ), kovida (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rành Rẽ", "definition": "Samuggaṇhati (saṃ + u + gah + ṇhā), paguṇa (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rào Lại", "definition": "Parikkhepa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rào Quanh", "definition": "Parikkhipati (pari + khip + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rác Rến", "definition": "Saṅkāra (nam), vikata (trung), kacavara (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rái Cá", "definition": "Udda (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rán Sức", "definition": "Padhāna (tính từ), payatana (trung), parakkama (nam), parisakati (pari + sakk + a), uyyāma (nam), yoga (nam), abhippasāreti (abhi + pa + sad + e), yatati (yat + a), yatana (trung), vāyamati (vi + a+ yam + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Ráng", "definition": "絳. Màu đỏ thẳm. Bản dịch Chinh phụ ngâm khúc có câu: “Áo chàng đỏ tựa ráng pha, ngựa chàng sắc trắng như là tuyết in”. Ta cũng còn hiểu là đám mây nhiều màu sắc đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ráng Hà", "definition": "絳河. Một tên chỉ sông Ngân hà trên trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ráng Thanh", "definition": "絳青. Màu sắc đỏ xanh pha trộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ráng Thuỷ", "definition": "絳水. Tên sông, thuộc tỉnh Sơn Tây, Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Râu", "definition": "Massu (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Râu Mép", "definition": "Dāṭhikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rãnh", "definition": "Niddhamana (trung), parikhā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rên Rỉ", "definition": "Nitthunāti (ni + thu + nā), paridevati (pari + dev + a), thūnāti (thu + nā), vippalapati (vi + pa + lap + a), vilāpa (nam), akkandati (ā + kand + a), akkandana (trung), anutthunāti (anu + thu + nā), anutthunana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rìu", "definition": "Kuṭhārī (nữ), tacchanī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rõ Ràng", "definition": "Visada (tính từ), nidassana (trung), paccakkha (tính từ), suvisada (tính từ), uttāna (tính từ), uttānaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rõ Rệt", "definition": "Vibhāveti (vi + bhū + a), sandīpeti (saṃ + dip + e), sandīpana (trung), paridīpeti (pari + dīp + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rùa", "definition": "Kacchapa (nam) kumma (nam), nakka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rùa Cứu Mạng", "definition": "(Truyền thuyết Trung-quốc). Mao Bảo thuở còn hàn vi, từng mua một con rùa rồi thả cho đi. Sau làm tướng, bại trận, nhảy xuống nước thoát thân, bèn cảm thấy có vật gì đỡ dưới chân, đưa thẳng sang bờ bên kia. Ông nhìn lại thì hóa ra là con rùa mà mình đã phóng sinh ngày trước.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Rùa Mù", "definition": "Ảnh dụ nói lên sự khó khăn vô cùng của những chúng sinh hiện đang phải sống ở các cõi ác như địa ngục, quỷ đói và súc sinh, mà lại được tái sinh lên các cõi lành, cõi thiện như cõi Người và cõi Trời. Cũng như một con rùa mù, mỗi trăm năm mới nổi lên trên mặt biển một lần, và cố gắng chui đầu vào một lỗ tròn của một thanh gỗ trôi giữa biển khơi, thanh gỗ đó bị gió và sóng không ngừng làm cho trôi dạt khi thì về phía Nam, khi thì về phía Bắc, phía Đông, phía Tây. Làm người mà sống ác, bất thiện phải đọa xuống các cõi khổ mà muốn vươn trở lại lên các cõi thiện, cõi lành cũng khó khăn như con rùa mùa giữa biển khơi.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Rút Lui", "definition": "Paṭisaṃharati (paṭi + saṃ + har + a), paṭikassati (paṭi + kas + a), paṭikkamana (trung), paṭilīyati (paṭi + lī + ya), paccāgacchati (pati + ā + gam + a), paccosakkati (pati + ava + sakk + a), osakkati (ova + sakk + a) osakkanā (nữ), ubbhāra (nam), abbūhati (ā + vi + ūh + a), akavaḍḍhati (ava + kaḍḍh + a), akavaḍḍhana (trung), , avakassati (ava + kass + a), avakassana (trung), abbūhati (ā + vi + ūh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rút Ngắn", "definition": "Saṃpiṇḍeti (saṃ + piṇḍ + e), saṃhāra (nam), saṅkhipati (saṃ + khip + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rút Ra", "definition": "Abbhukkirati (abhi + u + kir + a), abbhukkiraṇa (trung), nīhareti (ni + har + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rājadhamma", "definition": "Mười vương pháp, đức độ của một vị vua.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Rājakulavaḍḍhana", "definition": ".", "source": "Tu-Dien-Danh-Tu-Rieng-Pali-Chon-Quan-Tran-Ngoc-Loi-Dich"}
{"term": "Rājasaṅgahavatthu", "definition": "Bốn nhiếp pháp của vị vua, bốn pháp của vị vua thu phục nhân tâm", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Răng", "definition": "Danta (nam), dasana (trung), danta (trung), lapanaja (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Răng Nanh", "definition": "Dāṭhā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rūpa", "definition": "Hai loại sắc pháp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Rơi", "definition": "Patati (pat + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rơi Vào", "definition": "Okkamati (ova + kam + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rơi Xuống", "definition": "Patati (pat + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rơm", "definition": "Pala (S), Straw.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rưới Nước", "definition": "Osiñcati (ova + sic + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rượu", "definition": "Surā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rượu Nho", "definition": "Muddikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rượu Nếp", "definition": "Chang (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rượu Vang", "definition": "Madhu (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rạch", "definition": "Āpagā (nữ) Saritā (nữ), savantī (nữ), nadī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rạng Danh", "definition": "Pakāseti (pa + kās + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rạng Đông", "definition": "Aruṇa (nam), paccūsakāla (nam), pabhāta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rạp Hát", "definition": "Naccaṭṭhāṇa (trung), raṅga (nam), saṅghāta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải", "definition": "Abhikirati (abhi + kir + a), attharati (ā + thar + a), attharaṇa (trung), vikirati ( vi + kir + a), vikaraṇa (trung), vitthāreti (vi + dhar + e), vitthāra (nam), vippakirati (vi + pa + kir + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Dài", "definition": "Pasārana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Khắp Nơi", "definition": "Parisiñcati (pari + sic + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Lên", "definition": "Abbhukkirati (abhi + u + kir + a), abbhukkiraṇa (trung), āsiñcati (ā + sic + ṃ + a), parisiñcati (pari + sic + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Nước", "definition": "Abhisaiñcati (abhi + sic + ṃ + a), abhiseka (nam), abhisecana (trung), siñcati (sic + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Nước Thơm", "definition": "Anuvāseti (anu + vas + e), anuvāsana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Ra", "definition": "Pakirati (pa + kir + a), pattharati (pa + thar + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Rác", "definition": "Vidhupeti (vi + dhūp + e), viyūhati (vi + ūh + a), viyūhana (trung), okirati (uva + kir + a), ajjhokirati (adhi + ava + kir + a), ākirati (ā + kir +a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rải Đầy", "definition": "Samākula (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rầy La", "definition": "Vigarahati (vi + garah + a), niggaha (nam), apavadati (apa + vad + a), apavāda (nam), akkosati (ā + kus + a), akkosa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rận", "definition": "Ūkā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắc", "definition": "Abhikirati (abhi + kir + a), vippakirati (vi + pa + kir + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắn", "definition": "Ahi (nam), alagadda (nam), pannaga (nam), pādūdana (nam), dujivha (nam), pannaga (nam), pādūdana (nam), bhujaga (nam), bhujaṅga (nam), bhujaṅgama (nam), bhogī (nam), sappa (nam), uraga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắn Con", "definition": "Sappotaka (n)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắn Hổ Mang", "definition": "Nāga (nam), phaṇī (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắn Hổ Đất", "definition": "Kaṇhasappa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắn Lục", "definition": "Gonasa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rắn Độc", "definition": "Āsīvisa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rể", "definition": "Dhītupati (nam), jāmātu (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rễ", "definition": "Mūla (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rỉ", "definition": "Paggharati (pa + ghar + a), paggharaṇa (trung), abhisandati (abhi + sand + a), abhisandana (trung), abhisanda (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rọi Sáng", "definition": "Obhāseti (ava + bhāṣ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rối Loạn", "definition": "Āluḷeti (ā + luḷ + e), āloḷa (nam), vikkhipati (vi + khip + a), vikkhipana (trung), vikkhepa (nam), vyākula (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rối Rắm", "definition": "Jaṭā (nữ), jāla (trung), āveṭhana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rối Trí", "definition": "Sammuyhati (saṃ + muh + ya), sammuyhana (trung), pamuyhati (pa + muh + ya), aññavihita (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rống", "definition": "Abhigajjati (abhi + gad + ya), gajjati (gajj + a) gajjanā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rống Lên", "definition": "Unnadati (u + nad + a), virava (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rốt Ráo", "definition": "Ultimate, Consistency", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Rốt Ráo Rõ Biết Hết", "definition": "The highest perfection of knowledge, Thoroughly enlightened", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Rồ Dại", "definition": "Bāla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rồng", "definition": "Long. Người ta cho rằng, Rồng là loài quỉ (hoặc loài thú) hình rắn, sống dưới nước, có thần lực làm mây làm mưa. Trong kinh điển Phật giáo, rồng được liệt vào một trong tám bộ chúng (trời, rồng, dạ-xoa, càn-thát-bà, a-tu-la, ca-lâu-la, khẩn-na-la, ma-hầu-la-già), tức các vị thần đã qui hướng về với đức Phật, phát nguyện luôn luôn ở quốc độ của chư Phật để thủ hộ Phật pháp. Đứng đầu các rồng được gọi là “long vương”, hoặc “long thần”. Trong kinh cũng nói rằng, long vương thuộc về loài súc sinh, là quả báo của những người ngu si và sân hận. Long vương được phân làm hai giống: pháp hạnh và phi pháp hạnh. Long vương “pháp hạnh” tánh ít sân hận, thường nhớ tới phước đức của mình mà khởi lòng lành, tùy thuận pháp hạnh, giúp cho thế gian mưa thuận gió hòa, được mùa ngũ cốc. Long vương “phi pháp hạnh” thường làm các việc bất thiện, không kính trọng Tam Bảo, không tùy thuận pháp hạnh, khởi tâm ác làm mưa gió trái mùa, gây hư hại ngũ cốc ở thế gian. Trong thần thoại Ấn-độ, rồng (Phạn ngữ: naga) là rắn được thần cách hóa. Đó là vị thần đuôi rắn mặt người, sống ở dưới lòng đất, hay ở long cung (dưới đáy biển). Lại nữa, từ cổ xưa cho đến bây giờ, Ấn-độ có một chủng tộc gọi là “Naga”, không thuộc giống người Aryans, hiện sống rải rác ở các vùng Đông Bắc Ấn-độ và Tây Bắc Miến-điện, rất sùng bái rồng rắn; lại đều qui hướng về Phật giáo. Ở Trung-quốc vào thời cổ, người ta cũng từng có tín ngưỡng về rồng. Đó là loài động vật có vẩy dài, khoảng tiết xuân phân thì bay lên trời, tiết thu phân thì vào lòng đất. Loài có vẩy thì gọi là “giao long”; loài có cánh thì gọi là “ứng long”; có sừng thì gọi là “cầu long”, không có sừng thì gọi là “li long”; không bay được lên trời thì gọi là “bàn long”. Người Trung-quốc tin rằng, rồng có sức làm mây làm mưa, giúp đỡ người đời, nên liệt nó vào một trong bốn giống vật linh thiêng (tứ linh: long, lân, qui, phụng); lại được ví cho thiên tử, cho nên đã có các từ: long nhan, long thể, long bào, long tòa, long sàng, v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Rồng Chúa", "definition": "Mahoraga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rồng Thật", "definition": "(眞龍, shinryū, chơn long): nghĩa là con rồng thật sự chứ không phải rồng được vẽ trên giấy hay điêu khắc. Tích sợ rồng này căn cứ vào câu chuyện Diệp Công Hiếu Long (葉公好龍, Diệp Công Thích Rồng) được thuật lại trong tác phẩm Tân Tự (新序), phần Tạp Sự (雜事) 5 của Lưu Hướng (劉向, 77-5 ttl.) nhà Hán như sau: “Diệp Công Tử Cao hiếu long, câu dĩ tả long, tạc dĩ tả long, ốc thất điêu văn dĩ tả long; ư thị thiên long văn nhi hạ chi, khuy đầu ư dũ, thi vĩ ư đường; Diệp Công kiến chi, khí nhi hoàn tẩu, thất kỳ hồn phách, ngũ sắc vô chủ; thị Diệp Công phi hiếu long dã (葉公子高好龍、鉤以寫龍、鑿以寫龍、屋室雕文以寫龍、於是天龍聞而下之、窺頭於牖、施尾於堂、葉公見之、棄而還走、失其魂魄、五色無主、是葉公非好龍也, Diệp Công Tử Cao rất thích rồng, trên móc câu vẽ hình rồng, nơi cái đục vẽ hình rồng, các điêu trong phòng nhà đều vẽ hình rồng; nhân đó rồng trên trời nghe mà giáng xuống, thò đầu vào cửa sổ, vòng đuôi quanh nhà; Diệp Công thấy vậy, bỏ mà chạy trốn, mất cả hồn phách, chẳng còn tự chủ; đó chẳng phải là Diệp Công thích rồng).” Diệp Công tức là vị quan Đại Phu nước Sở dưới thời Tam Quốc, tên là Tử Cao (子高); ông được phong làm quan xứ Diệp, nay thuộc Diệp Huyện (葉縣), Hà Nam (河南); nên có tên là Diệp Công. Đây là câu chuyện nói về người thấy rồng thật thì sợ, mà lại yêu thích rồng giả.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Rổ", "definition": "Pacchi (nữ), piṭaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rỗng Không", "definition": "Tuccha (tính từ), suñña (tính từ), mogha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rộng", "definition": "Puthula (tính từ), uru (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rộng Lớn", "definition": "Olārika (tính từ), vipula (tính từ), visāla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rộng Rãi", "definition": "Brahanta (tính từ), vadaññu (tính từ), vadaññutā (nữ), vipula (tính từ), visāla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rớt", "definition": "Nipāteti (ni + pat + e), pakirati (pa + kir + a), palujjati (pa + luj + ya), pāteti (pat + e), bhassati (bhas + ya ), panna (tính từ), papatana (trung), sampāta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rớt Ra", "definition": "Hāni (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rớt Xuống", "definition": "Nipatati (ni + pat + a), nipāta (nam), patati (pat + a), pavatta (tính từ), abhinipatati (abhi + ni + pat + a), abhinipāta (nam), abhinipātana (trung), avakirati (vaa + kir + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rớt Đi", "definition": "Cavati (cu + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rờ Mó", "definition": "Chupati (chup + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rờ Voi", "definition": "(摸象, mozō, mô tượng): thí dụ nói về việc câu nệ vào ngôn ngữ văn tự của kinh điển, luận thư Phật Giáo mà không biết được toàn thể của Phật đạo. Câu chuyện “hạt tử mô tượng (瞎子摸象, người mù rờ voi)” này được thuật lại rất rõ trong các kinh như Đại Bát Niết Bàn Kinh (大般涅槃經) 32, Thú Điểu Phẩm (獸鳥品) của Trường A Hàm Kinh (長阿含經) 19, Nghĩa Túc Kinh (義足經) quyển Hạ, v.v. Như trong Lăng Nghiêm Kinh Chứng Sớ Quảng Giải (楞嚴經證疏廣解, CBETA No. 288) có đoạn rằng: “Hữu chư manh nhân, quần thủ mô tượng, kỳ mô tỷ giả vân tượng như ky; kỳ mô dịch giả vân tượng như trụ; kỳ mô vĩ giả vân tượng như trửu, kỳ mô phục giả vân tượng như thạch, nãi chí mô nhãn tắc vân như cổ phong thác, mô nhĩ tắc vân như đảo thùy diệp, mô đề tắc vân như phú địa bôi (有諸盲人、群手摸象、其摸鼻者云象如箕、其摸股者云象如柱、其摸尾者云象如帚、其摸腹者云象如石、乃至摸眼則云如鼓風橐、摸耳則云如倒垂葉、摸蹄則云如覆地杯, có các người mù lấy tay rờ voi, người rờ lỗ mũi thì bảo con voi giống như cái nia; người rờ bắp đùi thì bảo con voi giống như cột nhà; người rờ đuôi thì bảo con voi giống như cái chổi; người rờ bụng thì bảo con voi giống như tảng đá; cho đến người rờ con mắt thì bảo giống như ông bễ thổi gió; rờ lỗ tai thì bảo giống như lá rũ xuống; rờ móng chân thì bảo giống như cái bát úp xuống).” Hay như trong Tông Giám Pháp Lâm (宗鑑法林, CBETA No. 1297) quyển 33, có câu: “Mô tượng manh nhân thuyết dị đoan, hô ngưu hoán mã các ban ban (摸象盲人說異端。呼牛喚馬各般般, rờ voi người mù nói khác nhau, bảo trâu luận ngựa thảy oang oang).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Rời Bỏ", "definition": "Vijahati (vi + hā + a), virājeti (vi + rāj + e), ujjhati (ujjh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rời Khỏi", "definition": "Nikkhamati (ni + kam + a), niyyāti (ni + ya + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rời Ra", "definition": "Bheda (nam), bhedana (trung), lujjati (luj + ya), pakirati (pa + kir + a), pakirati (pa + kir + a), paccatta (tính từ), pavivitta (tính từ), vidāraṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rời Rạc", "definition": "Pakiṇṇaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rời Xa", "definition": "Vippayoga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rời Đi", "definition": "Nikkhamati (nis + kram), jahati, jahāti (hā + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rợn Tóc Gáy", "definition": "Lomahaṭṭha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rụt Rè", "definition": "Līnatā (nữ), līnatta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rủa", "definition": "Sapati (sap + a), sapatha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rủi Ro", "definition": "Nirupaddava (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rừng", "definition": "Arañña (trung), aṭavi (nữ), arañña (trung), dāya (nam), kānana (trung), vana (trung), vipina (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rừng Chư Thiên", "definition": "Devavana (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rừng Hạnh Phúc", "definition": "Subhaga (P)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rừng Khổ Hạnh", "definition": "Tapovana : là nơi đức Thích Ca Mâu Ni từng tu khổ hạnh trước khi thành Phật. Khu rừng này nằm trong thôn ngày xưa gọi là Ưu-lâu-tần-loa, của nước Ma-kiệt-đà; nay là phía Đông của thôn Mucilinda, cách xứ Phật-đà-già-da của nước Ấn-độ hơn 500m về hướng Nam.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Rừng Lân Cận", "definition": "Upavana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rừng Mù U", "definition": "Nāgavana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rừng Rú", "definition": "Kantāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rừng Rậm", "definition": "Pagumba (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rừng Sa La Song Thụ", "definition": "Sālavana (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Rừng Thiền", "definition": "H. Thiền lâm. Phật học bao la bát ngát như rừng, ba Tạng Kinh điển nhiều vô cùng cho nên ví như rừng. Lại có nghĩa cảnh chùa tĩnh mịch, trong rừng vắng, vì vậy gọi cảnh chùa là Thiền lâm hay rừng Thiền. “Xin người đã bạch gót đầu, Rừng Thiền xin chớ những màu yến oanh.” (Phan Trần)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Rừng Tre", "definition": "Veṇuvana (trung), veḷuvana (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rửa", "definition": "Vikkhāleti (vi + khāl + e), khāleti (khaḷ + e), dhovati (dhov + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rửa Mặt", "definition": "Mukhadhovana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rửa Ruột", "definition": "Vireceti (vi + rec + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rửa Tội", "definition": "Abhisaiñcati (abhi + sic + ṃ + a), abhiseka (nam), abhisecana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Rực Rỡ", "definition": "Sukka (tính từ), vibhūti (nữ), virājati (vi + raj + a), sobhā (nữ), sobhati (subh + a), samujjala (tính từ), sassirīka (tính từ), siri (nữ), sirī (nữ), pabhassara (tính từ), nippasha (tính từ), juti (nữ), jutindhara (tính từ), jutimantu (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "S.II.4;S.IV.256;Vbh.135.", "definition": "Tám sự vô minh, sự không hiểu biết điều đáng hiểu biết, sự không liễu tri thực tính pháp", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "S.III.97.", "definition": "Ba tri kiến, thuộc tà kiến", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "S.IV. 231.", "definition": "Năm cảm thọ, cảm giác của tâm khi xúc cảnh", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "S.IV.232; Vism. 461", "definition": "Sáu thọ, cảm giác sanh từ xúc", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "S.V.121", "definition": "Sáu pháp cần được đoạn trừ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "S.V.61; A.V.13;Vbh.377", "definition": "(Saṃyojana, saññojana) theo vi diệu pháp.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sa", "definition": "娑. Dáng uốn éo múa lượn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Bà", "definition": "娑婆. Phiên âm tiếng Phạn, có nghĩa là chịu đựng mọi khổ não.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Bà Bà", "definition": "Sahassakkha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Bà Ha", "definition": "娑婆訶. Phiên âm tiếng Phạn, tiếng dùng để tụng niệm hoặc dùng cuối câu thần chú của Ấn Độ thời cổ (Svaha).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Bà Thế Giới", "definition": "娑婆世界. Tiếng nhà Phật, chỉ cõi sống trong đó chúng sinh chịu đựng khổ não.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Bà Tức Tịch Quang", "definition": "Thế giới Sa Bà đầy dẫy gạch ngói gai gốc này chính là cõi Tịch Quang Chân Thường Cứu Cánh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Bố", "definition": "砂布. Vải nhám, trên mặt có gắn những mảnh cực nhỏ như thuỷ tinh, dùng để đánh bóng đồ vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Ca Bà La Sơn", "definition": "Sa Ca Bà La, Phạm: Cakravàđa-parvata. Cũng gọi Chước Ca La Sơn. Hán dịch: Thiết Vi Sơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Chỉ", "definition": "砂紙. Giấy nhám.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Chỉ Đa Thành", "definition": "Sa Chỉ Đa, Phạm; Pàli: Sàketa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Di", "definition": "Sramaneraka: dịch ra Hán ngữ là “tức từ”, nghĩa là dứt các điều ác, làm các điều lành; cũng dịch là “cần sách”, nghĩa là siêng năng tu tập theo sự sách lệ của đại chúng. Đó là danh từ dùng chỉ chung cho các vị xuất gia phái nam thọ trì mười giới; phái nữ thì gọi là sa-di-ni (sramanerika).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sa Di Giới", "definition": "Cũng gọi Cần Sách Luật Nghi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Di Hát Thực", "definition": "Gọi tắt: Sa Hát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Di Ni", "definition": "Sramaṇerika (S), Novice nun, Sāmaṇeri (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Di Tam Danh", "definition": "沙弥三名 (Phiên Dịch Danh Nghĩa )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sa Di Thập Giới", "definition": "沙彌十戒 (Phiên Dịch Danh Nghĩa và Sa Di Thập Giới Pháp)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sa Duy Đức Lợi", "definition": "I.Sa Duy Đức Lợi.Phạm: Savitf.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Dà La", "definition": "Ta Kiệt La , Sagara", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sa Dà Đà", "definition": "Svagata", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sa Dục", "definition": "砂浴. Tắm trong cát, tức vùi mình trong cát, nói về loài chim đà điểu, khi gặp nguy hiểm chỉ biết vùi đầu trong cát Chỉ hành động ngu xuẩn hèn nhát, chỉ mong tránh được tai hoạ trước mắt mà không cần biết tới vạ lớn sau lưng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Già Đà", "definition": "Phạm: Svàgata. Pàli: Sàgata.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Giới", "definition": "Hàm ý là thế giới nhiều như cát sông Hằng, tức chỉ cho thế giới Phật nhiều vô lượng vô số.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Hữu", "definition": "Xem đường đi.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Khả Đế", "definition": "Sakti (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Kim", "definition": "沙金. Hạt vàng cực nhỏ lẫn lộn trong cát sông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Kiệt La", "definition": "Xem Biển.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Kiệt La Long Vương", "definition": "Śāgāra-nāgarāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Kê", "definition": "莎雞. Tên một loài châu chấu, thân mình và cánh có vằn có đốm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Kế", "definition": "Sa là cỏ gấu; Kế là cả búi tóc. Nghĩa là dùng cỏ gấu để kết thành búi tóc. Đây vốn là phong tục tập quán của những người nô bộc ở Ấn Độ đời xưa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Ba", "definition": "(1259-1314): là một vị tăng dịch kinh ở triều đại nhà Minh. Tương truyền, ngài là người ở Hà-tây (Trung-quốc), nhưng cũng có thuyết nói ngài là người Tây-vức. Ngài xuất gia với đế sư Bát Tư Ba (xem mục “Phát Tư Ba”) từ lúc nhỏ, tu tập các pháp quán đảnh; về sau lại theo học giáo pháp đại tiểu thừa với Trước Lật Xích thượng sư (?-?). Ngài thông hiểu Tạng văn và nhiều thứ văn tự khác, được đế sư Bát Tư Ba tiến dẫn lên vua Nguyên Thế-tổ, được vua ủy nhiệm phiên dịch các kinh điển hiển, mật trước nay chưa được truyền vào Trung-quốc. Vua ban hiệu cho ngài là Đại Biện Quảng Trí. Thời bấy giờ, đạo phong của tăng lữ xuống thấp tồi tệ, vua Nguyên Thế-tổ rất lo lắng, bèn cử ngài làm Thích giáo đô tổng thống ở các xứ Giang, Triết (Giang-tô và Triết-giang) để chấn chỉnh các tệ hại của tăng lữ vùng Giang-nam. Từ sau khi ngài đến nơi nhậm chức, các chuyện phiền toái đều trừ khử, các tự viện được an định. Quan sát tình hình các tỉnh Phúc-kiến, Quảng-đông, ngài nhận thấy giáo đồ thường bị khổ sở về nỗi quan sự nhũng nhiễu, bèn tâu lên vua bãi chức tổng thống ở các lộ, rồi tự mình rút lui về ẩn cư ở Lũng-sơn, tỉnh Thiểm-tây. Năm 1314, một hôm ngài tĩnh tọa trước Phật mà viên tịch, thế thọ 56 tuổi. Những dịch phẩm của ngài hiện còn gồm có: Dược Sư Lưu Li Quang Vương Thất Phật Bản Nguyện Công Đức Kinh Niệm Tụng Nghi Quĩ, Dược Sư Lưu Li Quang Vương Thất Phật Bản Nguyện Công Đức Kinh Niệm Tụng Nghi Quĩ Cúng Dường Pháp, Hoại Tướng Kim Cương Đà La Ni Kinh, Phật Đỉnh Đại Bạch Tản Đà La Ni Kinh, Văn Thù Bồ Tát Tối Thắng Chân Thật Danh Nghĩa Kinh, Chướng Sở Tri Luận (trước tác của ngài Bát Tư Ba).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sa La Ca Lân Đề", "definition": "Sarasa-karanda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa La Ca Lân Để", "definition": "Xem Sa La Ca Lân Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa La Cấp Da", "definition": "(?-?). Phạm: Sàlagupta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Di Tụ Lạc", "definition": "Sa La di, Phạm: Sàrathì. Hán dịch: Điều Ngự Thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Ha", "definition": "(?-?). Phạm: Saraha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Hoa", "definition": "I.Sa La Hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Lâm", "definition": "Xem Sa La Song Thụ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa La Sa Điển Ca Lân Đề", "definition": "Xem Sa La Ca Lân Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa La Sa Điểu", "definition": "Sa La Sa, Phạm: Sàrasa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Song Thọ", "definition": "Sa la: Sâla là tiếng Phạn, dịch nghĩa: Kiên cố. Sa la song Vô Lượng Thọ Kinh là cặp cây Sa la mọc trong rừng toàn là cây Sa la. Ông A Nan giăng võng giữa cặp cây ấy đặng cho Phật Thích Ca nằm nghỉ trước khi ngài vào Niết Bàn. Xem: Ta la song thọ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sa La Song Thụ", "definition": "Sāla (S), (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa La Thất Phạt Để Tiết", "definition": "Phạm: Sarasvatì pùja.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Thọ Vương", "definition": "Salendrarāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa La Thụ", "definition": "Bosquet de shala 娑羅樹 śāla", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Sa La Thụ Vương", "definition": "Tên khác của Khai Phu Hoa Vương Như Lai (Phạm: Saôkusumitaràja-tathàgata) ngồi ở phía nam trong viện Trung Đài Bát Diệp của Mạn Đồ La Thai Tạng Giới Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa La Thụ Vương Phật", "definition": "Sa La Thụ Vương, Phạm: Zàlendraràja. Cũng gọi: Sa La Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Lê", "definition": "沙藜. Loại trái lê, ăn sạo sạo như cát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Lậu", "definition": "沙漏. Dụng cụ lọc nước bằng cát, cho nước nhỏ từng giọt qua cát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Lịch", "definition": "砂礰. Hòn sạn hòn sỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Ma Phê Đà", "definition": "Phạm, Pàli: Sàma-veda.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Ma Phệ Đà", "definition": "Sama-veda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Ma Tha", "definition": "Là Thiền Quán Cực Tịnh, quán các pháp đều không như gương soi các tướng. Xem Chỉ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Ma Đế", "definition": "Xem Chánh Lượng Bộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Môn", "definition": "Sramana . Từ thời Phật tại thế, danh xưng “sa-môn” đã được dùng để chỉ chung cho tất cả những người xuất gia tu hành, trong đạo Phật hay ở các đạo khác. Đặc biệt, sa môn trong đạo Phật phải là những vị cạo bỏ râu tóc, sống độc thân, xa gia đình, không nhà cửa ruộng vườn, không tài sản riêng tư, đi xin ăn, chuyên cần tu tập mọi pháp lành, không làm các điều ác, dứt sạch phiền não, phát huy trí tuệ, chứng nhập giải thoát niết bàn. Bốn quả vị mà một vị sa-môn có thể chứng đạt là Tu-đà-hoàn, Tư-đà-hàm, A-na-hàm và A-la-hán.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sa Môn Bất Kính Vương Giả Luận", "definition": "Gọi tắt: Bất Kính Vương Giả Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Môn Cồ Đàm", "definition": "Samaṇa Gotama (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Môn Giả Hiệu", "definition": "Samaṇakuttaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sa Môn Quả", "definition": "Tên một bộ Kinh trong tập Trường Bộ Kinh (Digha Nikaya) giới thiệu khá đầy đủ quan điểm của sáu phái triết học, thịnh hành ở Ấn Độ, vào thời Phật Thích Ca ra đời. Hán dịch là Lục sư ngoại đạo:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sa Môn Quả Kinh", "definition": "Bản kinh thứ 27 trong Kinh Trường A Hàm, do các ngài Phật Đà Da Xá và Trúc Phật Niệm cùng dịch vào năm Hoằng Thủy 14 (412) đời Hậu Tần, được thu vào Đại Chính Tạng tập 1.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Môn Thọ Thực Ngũ Quán", "definition": "沙門受食五觀 (Đại Tạng Nhất Lăm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sa Mạc", "definition": "沙漠. Vùng mênh mông toàn cát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Mạo", "definition": "紗帽. Thứ mũ lụa mỏng, người quyền quý thời xưa thường đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Mộc", "definition": "沙木. Tên một loài cây thuộc giống thông, thường trồng ở sa mạc, để giữ cho cát khỏi bay mù khi có gió mạnh, tránh cơn bão cát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Na Lị Ca", "definition": "Samagrika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Nang", "definition": "沙囊. Bao cát, vật dụng trong quân đội, xưa dùng để lấp sông cho lính vượt sông, nay dùng để ngăn đạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Ngư", "definition": "沙魚. Tên một loài cá da sờ vào cào lạo xạo như cát, ta gọi là cá nhám, loại cá này đẻ con.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Nhân", "definition": "砂仁. Tên một thứ hạt cây, giống như sạn sỏi, dùng làm vị thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Nhãn", "definition": "砂眼. Bệnh đau mắt hột, trong mắt như có sạn, cộm lên ngứa ngáy khó chịu (Tiachome).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Sàng", "definition": "砂牀. Thứ đá từ đó người ta lấy ra được Chu sa, dùng làm vị thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Sâm", "definition": "沙參. Tên một thứ cây, rễ dùnglàm thuốc, gần giống như nhân sâm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Thạch Tập", "definition": "Shaseki-shū (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Thải", "definition": "沙汰. Gạn lọc cặn bã, chọn lấy cái tốt, bỏ cái xấu Ngày nay ta còn hiểu là bỏ đi không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Thải Tăng Ni", "definition": "Sa thải có nghĩa là đãi lọc, gạn lọc. Sa thải tăng ni nghĩa là bắt buộc 1 số tăng ni hoàn tục để chỉnh đốn lại tổ chức tăng ni trong giáo đoàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Thất Ni Hà", "definition": "Sa thất ni, Phạm: Sarpinì; Pàli: Sappinì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Thổ", "definition": "沙土. Đất có lẫn cát, không trồng trọt được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Trung Thủ Du", "definition": "沙 中 取 油. Lấy dầu trong cát, tỷ dụ hành vi không căn cứ vào sự thực, luống công vô ích. Minh Chân Tụng trong Phạm Kỳ Ngữ Lục q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sa Trùng", "definition": "沙蟲. Tên loài sâu nhỏ dưới nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Trường", "definition": "沙場. Bãi cát Chỉ vùng đất quân lính đôi bên đánh nhau. Truyện Nhị Độ Mai có câu: “Người về cố quốc kẻ đi sa trường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Trần", "definition": "沙塵. Cát bụi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Tuyền", "definition": "沙泉. Suối nước trong vùng cát, có nhiều cát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Tì Ca La", "definition": "Kapila: là tên một ông tiên thời cổ Ấn-độ, được coi là vị tổ của phái Số Luận. Ông chuyên tu khổ hạnh, thờ phụng Phạm Thiên mà được thần chú gọi là “Tiên Phạm Thiên”. Đó là một loại tà thuật làm cho người khác bị mê muội, không còn tỉnh táo, tự chủ được. Đây là một trong các chú thuật ác độc mà đức Thế Tôn từng cấm chư đệ tử thọ trì; vì ai thọ trì các loại chú này, đều sẽ phải đọa vào ba đường dữ. Theo pháp sư Viên Anh, trong sách Đại Phật Đảnh Thủ Lăng Nghiêm Kinh Giảng Nghĩa, Sa Tì Ca La dịch ra Hán ngữ là “hoàng phát”, hay “kim đầu” (tóc vàng), thuộc phái ngoại đạo tu khổ hạnh. Ông đã truyền thần chú Tiên Phạm Thiên cho bà Ma Đăng Già. Khi con gái của bà (Bát Kiết Đề, hay nàng Ma Đăng Già) vừa trông thấy tôn giả A Nan, tướng hảo trang nghiêm, liền sinh tâm ái nhiễm. Vì năm trăm năm trước trong thời quá khứ, nàng đã cùng với A Nan từng là vợ chồng, cho nên bây giờ, tập khí ái dục chưa mất, nên vừa thấy A Nan, tâm liền mừng vui, muốn được A Nan làm chồng; bèn nhờ mẹ giúp. Ban đầu, bà thấy tôn giả là người xuất gia, đã cắt đứt ái dục, nên bà không chấp thuận; nhưng nàng nài nỉ quá, bà thương con, bất đắc dĩ phải chiều ý nàng. Bà bèn dùng thần chú Tiên Phạm Thiên (do Sa Tì Ca La truyền cho), làm cho tôn giả bị mê hoặc, cứ như ngây dại, không còn tỉnh táo nữa. Đức Phật đã kịp thời bảo Bồ Tát Văn Thù đem thần chú Lăng Nghiêm đến hóa giải chú thuật, cứu tôn giả A Nan thoát khỏi dâm nạn; và nhờ có túc duyên, nàng Ma Đăng Già cũng được theo tôn giả A Nan về gặp Phật, được Phật khai thị, liền chứng quả Bất-hoàn, rồi phát tâm xuất gia.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sa Tì Đát La", "definition": "Phạm: Zakuntalà. Gọi đủ: Abhijĩànazakuntalam.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Tử", "definition": "痧子. Mụn sởi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Uyển", "definition": "Emanuel Edouard Chavannes, 1865-1918 Học giả Đông Phương Học người Pháp. Năm 1889, ông ở công sứ quán Pháp tại Bắc Kinh, Trung Quốc, chuyên nghiên cứu về học thuật. Sau, ông trở về Pháp. Năm 1893, ông làm Giáo sư Đại Học công lập Pháp Quốc, năm 1902 được suy cử làm hội viên viện Học Sĩ. Từ năm 1903 về sau, ông tự lực biên tập tạp chí Đông Phương Học Nghệ Thông Báo (Toung pao). Khoảng năm 1895 đến năm 1905, ông ấn hành “Sử Kí Dịch Chú” (Les Mémoires Historiques de Se-ma-Ta’ien), 5 quyển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Xa Quốc", "definition": "Cũng gọi Cứ Sa Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Xưởng", "definition": "紗廠. Nhà máy dệt lụa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Yết Đà", "definition": "Xem Thiện Lai.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Đa Bà Ha Vương", "definition": "Xem Dẫn Chánh Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Đa Cát Lí", "definition": "Phạm: Zata-giri.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sa Đa Kỳ Lý", "definition": "Xem Oai Thần.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sa Điệt", "definition": "蹉跌. Sảy chân, trượt chân Chỉ lỗi lầm ngoài ý muốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Đà", "definition": "蹉跎. Trượt chân, sảy chân Uổng phí thời giờ. Truyện Hoa Tiên có câu: “Vừa mừng cá nhảy đợt ba, lại thêm chinh tiểu sa đà hành biên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Đường", "definition": "砂糖. Loại đường mía hạt rất to.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Để Hoàng Kim", "definition": "沙底黃金. Hạt vàng dưới đáy cát, chỉ người thanh cao ở lẫn với phường thô tục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sa Độ", "definition": "Phạm: Sàdhu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sabhāvadhamma", "definition": "Hai pháp thực tính.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sacca", "definition": "Hai sự thật.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saccanama", "definition": "Saccanama (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sacchikā-tabbā dhammā", "definition": "Tám pháp cần tác chứng.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sacchikātab-bā dhammā", "definition": "Ba pháp cần tác chứng.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sacchikātabadhammo", "definition": "Một pháp cần tác chứng.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sacchikātabbā dhammā", "definition": "Hai pháp cần tác chứng.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sacerdotal", "definition": "Tăng lữ, giáo chức", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sacramental", "definition": "Lễ ban thánh thế", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sacred dogma", "definition": "Thánh đế", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sacrilegious", "definition": "Phạm thượng, xúc phạm thần thánh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sacrosanct", "definition": "Quan trọng đến nỗi không thể thay đổi được", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sacrum", "definition": "(giải phẫu) xương cùng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Saddha", "definition": "Đức tin", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Saddhamma", "definition": "Ba diệu pháp, ba tinh hoa của chánh pháp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saddhammasammosā", "definition": "Hai nhân hỗn loạn chánh pháp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saddhammaṭhiti", "definition": "Hai nhân chánh pháp vững trú.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saddhaṭhāna", "definition": "Ba sự kiện biết người có lòng tin.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saddhā", "definition": "Bốn loại niềm tin.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saddhānisaṃsa", "definition": "Năm lợi ích của đức tin.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sadhana", "definition": "The practice and instructions given when taking on a commitment associated with a meditational deity (deity = vị thần, vị thánh)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sadism", "definition": "Tính tàn bạo, tính ác dâm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Saffron", "definition": "Cây nghệ tây", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sagga", "definition": "Sáu thiên giới, 6 cõi trời dục giới, cõi của các chư thiên hưởng phước", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sahagata", "definition": "Đi kèm với. Phối hợp với.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sai", "definition": "倩. Mượn. Thờ Cháu rể Một âm khác là Thiến. Xem Thiến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Biệt", "definition": "Vivesa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sai Biệt Cực Thành", "definition": "Tiếng dùng trong Nhân Minh. Cũng gọi Xứng Pháp, Năng Biệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sai Bài", "definition": "差 排. Sai khiến, điều khiển. Như Tịnh Ngữ Lục q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sai Dị", "definition": "差異. Khác nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Dịch", "definition": "差役. Người làm việc nặng nhọc ở phủ quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Khiến", "definition": "Mārāpana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sai Khiển", "definition": "差遣. Buộc người khác làm theo lệnh mình. Ta thường đọc trại thành Sai khiến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai La Ba Ni", "definition": "Phạm: Zara-parịì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sai Lầm", "definition": "Vitatha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sai Lợi Ni Ca Thụ", "definition": "Sai Lợi Ni Ca, Phạm: Kwiriịika. Hán dịch: Nghiên Chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sai Ma", "definition": "Phạm: Zamà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sai Ma Liên Hoa Tiên", "definition": "Tên vị Tỉ Khưu Ni ở thời đại Đức Phật còn tại thế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sai Ngoa", "definition": "差訛. Không đúng sự thật. Truyện Trê Cóc có câu: “Quan truyền bắt cóc ra tra, sao bay đơn kiện sai ngoa làm vầy”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Nha", "definition": "差衙. Viên chức cấp nhỏ ở phủ quan, để quan sai bảo việc vặt. Đoạn trường tân thanh có câu: “Hàn huyên chưa kịp dãi đề, sai nha đã thấy bốn bề xôn xao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Nhân", "definition": "差人. Như Sai dịch 差役 Như Sai nha 差衙.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Nhẫn", "definition": "猜忍. Chỉ tính tình hay nghi ngờ và độc ác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Phái", "definition": "差派. Ra lệnh cho cấp dưới đi lo công việc ở một nơi khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Suất", "definition": "差率. Con số chênh lệch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Thác", "definition": "差錯. Lầm lẫn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Trì", "definition": "偨池. So le, không đều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Trĩ", "definition": "偨傂. Như Sai trì 偨池.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Áp", "definition": "差押. Danh từ pháp luật, chỉ sự tịch thu tài sản của người thiếu nợ để đem bán, trả tiền cho chủ nợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Điểm", "definition": "差點. Chỗ khác nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Đường", "definition": "Uppatha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sai Đẳng", "definition": "差等. Thứ bậc cao thấp khác nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sai Định", "definition": "I.Sai Định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sakadagami", "definition": "Tư Đà Hàm. Nhất Lai. Tham ái và sân hận của vị có quả thánh thứ hai đã yếu kém nên chỉ còn tái sinh một lần.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sakadāgāmipuggala", "definition": "Năm hạng thánh Tư-đà-hàm, cũng gọi là thánh Nhất lai", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sakka", "definition": "The most Northerly Republic of Sakka where Gotama was born.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sakya", "definition": "The history of Sakya, one of the four major schools of Tibetan Buddhism, is firmly rooted in Tibet's rich mythology. The leaders of Sakya are and have always been from a single aristocratic clan, the Khon. It's said that the first Khon was born after his father defeated a vampire and married the vampire's wife - phái Tát-Ca", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sakyapa", "definition": "Sakyapa Sa-skya-pa (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Salinity", "definition": "Độ mặn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Salla", "definition": "Năm mũi tên, năm thứ phiền não làm đau khổ như bị tên bắn xuyên thủng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sally", "definition": "Cuộc tấn công đột ngột, vây phá", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Salvagery", "definition": "Hành vi tàn bạo, độc ác", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Salvation", "definition": "Cứu rổi linh hồn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Salvific", "definition": "Có tác dụng cứu vớt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sam", "definition": "幓. Cái giải cờ, tua cờ Một âm khác là Sâm. Xem Sâm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sam Di", "definition": "芟夷. Cắt cỏ. Phạt cỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sam Tử", "definition": "衫子. Áo cánh của đàn bà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Samadhi", "definition": "Định. Trạng thái của tâm trụ trên một đối tượng duy nhất. Có ba loại Định: Chuẩn bị (Parikamma), cận định (upacara) và định (jhana hay appana). Chi thứ sáu trong Thất Giác Chi.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samajīvīdhamma", "definition": "Bốn pháp làm duyên xứng đôi chồng vợ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Samanera", "definition": "Sa di", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samaneri", "definition": "Sa di ni", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samantabhadra", "definition": "“All around Goodness”, is the famous divine bodhisattva (Sanskrit) of the “Flower Garland Sutra”, the Samantabhadra who has developed the Inter-penetrating Samadhi so high that he can multiply all his good actions infinitely throughout his micro and macrocosms, for example consciously bowing in miniature subatomic bodies in subatomic uni- verses to subatomic Buddhas at the moment he bows in the ordinary universe to the Buddha before him…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Samantabhadra sutra", "definition": "Kinh Phổ Hiền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Samatha", "definition": "Ba loại tịnh chỉ, pháp vắng lặng, diệt tắt", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Samatha bhavana", "definition": "Thiền vắng lặng. Hành thiền theo bốn mươi đề mục nhằm mục đích đạt được tâm vắng lặng. Bình an do chế ngự được một số phiền não và chướng ngại.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samatha jhana", "definition": "Nhập Định. Tâm hoàn toàn an trú trong một đề mục duy nhất. ở trong tình trạng hoàn toàn an tịnh, tĩnh lặng, tâm thấm nhập vào đề mục.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sambodhi", "definition": "Tam bồ đề", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sambojjhanga", "definition": "Thất giác chi. Bảy yếu tố giác ngộ. Bảy nhân sinh quả bồ đề gồm: Chánh niệm (sati), Trạch pháp (dhamma vicaya), Tinh tấn (viriya), Hỉ (piti), Thư thái (passaddhi), Định (samadhi) và Xả (upekkha).", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samma Sambuddha", "definition": "Teacher of the Supreme Enlightenment, later", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Samma vaca", "definition": "Chánh ngữ. Lời nói chân chánh: lời nói thành thật, lời nói đem lại sự đoàn kết, lời nói dịu dàng, lời nói hữu ích.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samma-ditthi", "definition": "Chánh kiến. Kiến thức chân chánh.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samma-kammanta", "definition": "Chánh nghiệp. Hành động chân chánh: Không sát sanh, không trộm cắp, không tà hạnh.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samma-sambuddha", "definition": "Tam miệu tam bồ đề. Chánh đẳng chánh giác, tự mình ngộ lấy không thầy chỉ dạy.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sammasana-nana", "definition": "Tư duy trí. Tuệ thấy rõ: vô thường, khổ não, vô ngã. Đạt tuệ này, thiền sinh thấy rõ sự tan rã, sự biến mất một cách nhanh chóng của đối tượng. Với sự thấy rõ này, thiền sinh kinh nghiệm trực tiếp rằng tất cả mọi vật đều vô thường, bất toại nguyện và không có tự ngã. Được gọi là \"liễu tri\" vì thiền sinh tự mình thấy rõ chân lý căn bản.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sammā diṭṭhipaccaya)", "definition": "Hai duyên sanh chánh kiến, và duyên sanh tà kiến (Micchā diṭṭhipaccaya", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Samodhānadhamma", "definition": "Năm duyên hợp thọ ký độc giác.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sampadā", "definition": "Sampadāguṇa, Bốn sự thành tựu, điều kiện cho kết quả ngay hiện tại việc bố thí", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sampajañña", "definition": "Bốn sự tỉnh giác, sự nhận thức, sự hiểu biết thấu đáo", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sampajjanna", "definition": "Giác tỉnh. Biết mình. Hiểu biết sáng suốt.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samparāyikatthasaṃvattanikadhamma", "definition": "Bốn pháp dẫn đến lợi ích tương lai.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sampatti", "definition": "Ba sự thành tựu, nói theo nghĩa đen là tài sản hay lợi đắc", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Samsara", "definition": "Cycle of births and deaths = wheel of life = vòng sinh tử luân hồi Sanskrit, Is a state of existence characterized by endless cycles of life, death and rebirth. The term also refers to our ordinary state of day-today existence, which is characterized by suffering. All beings remain in this state, propelled by karmic imprints from past actions and negative “delusory” state of mind, until one removes all negative tendencies of mind and achieves a state of Liberation. (His Holiness The Dalai Lama and Howard C. Cutler, M.D. in their book ‘The Art of Happiness’)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Samudaya", "definition": "Chân lý về nguyên nhân của sự khổ. Dục ái (kamatanha), hữu ái (bhavatanha) và vô hữu ái (vibhavatanha).", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samudaya dhamma", "definition": "Pháp duyên sinh.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samutti sacca", "definition": "Tục đế. Sự thật thế tình. Ngược với chân đế: sự thật tuyệt đối. Tục đế dính mắc quan niệm, vào danh từ như cho rằng có tôi, anh, chị, ghế, bàn, sông, núi ... Chân đế nhìn đúng bản chất của sự vật nên không có tôi, anh, chị, ghế, bàn, sông, núi ... mà chỉ có vật chất và tinh thần thuần túy hay danh và sắc hoặc thân và tâm", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Samyak sambodhi", "definition": "Tam miệu tam bồ đề, chánh đẳng chánh giác", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Samādhi", "definition": "Hai loại định.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Samādhibhāvanā", "definition": "Bốn sự tu tiến định.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "San", "definition": "Desa (S),Mātsara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "San Bản", "definition": "舢舨. Chiếc thuyền nhỏ Loại tàu nhỏ của Hải quân, tuần tiểu chiến đấu trong sông ngòi. Nay ta gọi là Giang đính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San Hành", "definition": "刊行. In ra và đem đi khắp nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San Hô", "definition": "珊瑚. Thứ động vật ở biển, kết lại với nhau như đá. San hô rất quý và đắt tiền, thường dùng làm đồ trang trí (Corail, Corallium).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San Kỳ Đại Tháp", "definition": "Sanchi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "San Nhuận", "definition": "删潤. Sửa sang tô điểm cho đúng và hay đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San San", "definition": "姗姗. Uốn éo uyển chuyển. Nói dáng đi của đàn bà con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San Tham", "definition": "Matsarā-rāga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "San Thập", "definition": "删拾. Sửa sang lại, bỏ cái thừa, lựa cái cần,.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San Tiếu", "definition": "姗笑. Cười chê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "San Xà Dạ Tì La Chi Tử", "definition": "San Xà Dạ tì la chi, Phạm: Saĩjayavairaỉì. Pàli: Sanjaya-velaỉỉhi; Tử, Phạm:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "San Đà Na", "definition": "Phạm: Santàna.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "San Đâu Xuất Đà", "definition": "Saṃtushita-devarāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "San Đề Lam Quốc", "definition": "San Đề Lam, Phạm: Saịđilya. Tên một cõi nước ở đời quá khứ, nơi Đức Phật A Di Đà và Đức Phật Thích Ca phát tâm bồ đề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "San Định", "definition": "Một trong chín vị pháp sư thuộc hội đồng phiên dịch ở Trung-quốc thời xưa (xem mục “Dịch Kinh”), giữ việc cắt bỏ những lời rườm rà để ổn định ý nghĩa của câu văn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sanctified", "definition": "Được thăng hoa (Sanctify – thánh hóa, làm cho ai trở thành thánh)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sanctity", "definition": "Thần thánh, thiêng liêng, sự thánh thiện (Sanctification = thánh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sanctum", "definition": "Nơi thiêng liêng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sang", "definition": "刅. Dùng vật bền nhọn làm bị thương người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sang Di", "definition": "瘡痍. Vết thương Chỉ cuộc sống lầm than của dân chúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sang Hận", "definition": "愴恨. Buồn giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sang Môn", "definition": "Những cái lỗ hổng rỉ ra chất nhớp nhúa trong thân người, tức chỉ cho mắt, tai, mũi, miệng, 2 đường đại tiện, tiểu tiện là 6 sang môn; nếu tính tai, mắt, mũi là 2 thì thành 9 lỗ, gọi là Cửu Sang Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sang Trắc", "definition": "愴惻. Thương xót buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sang Trọng", "definition": "Maṅgala (tính từ), pakaṭṭha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sang Vị", "definition": "瘡痏. Vết sẹo do mụn nhọt, hoặc vết thương để lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sang Đoạt", "definition": "Lumpati (lup + ṃ + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sang Độc", "definition": "瘡毒. Mụn lở Chất mụn ở mụn nhọt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sang đầu đời Thanh, có Nhất minh soạn “Hội tâm nội tập” cũng đề xướng thuyết “Tam Giáo dung hội”. Nhưng thời kì này, các tông giáo đều rơi vào tình trạng trầm trệ, mất sinh khí và suy vi, không còn thế lực gì đáng nói.[X. Hoằng Minh Tập, Lương Cao Tăng Truyện Q.7; thiên Qui chính trong Quảng Hoằng Minh Tập; Đường hộ pháp sa môn Pháp Lâm biệt truyện Q.thượng; Thích Thị Lục Thiếp Q.8; Âu Dương Tu ngoại truyện].", "definition": "II.Tam Giáo Luận Hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sangha", "definition": "Tăng già. Chúng. Cộng đồng tu sĩ Phật giáo gồm những nhà sư ăn mặc theo Phật, tu trì Giới (227 giới), Định, Huệ.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sanguine", "definition": "Lạc quan, đầy hy vọng, tin tưởng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sanh", "definition": "Jāti (S), Birth, Saṃbhāvati (P), bhava (S, P), Spring from, Becoming, Prabhāva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Báo", "definition": "Tạo nhân trong đời này, có quả báo trong đời tiếp sau. Biệt Hai người đang còn sống mà phải chia ly. Còn nếu một trong hai người chết, thì gọi là tử biệt.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Báo Nghiệp", "definition": "Upapadya-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Chi", "definition": "S. Linga, anga-jata; A. The male organ, penis. Dương vật. Sinh thực khí, cơ quan sinh dục của đàn ông.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Chân Như", "definition": "Xem Lưu Chuyển Chân Như.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Chủ", "definition": "Xem Đại Tiên. Pajṃpati (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Chủ Thần", "definition": "Xem Ba Xà Ba Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Công Tứ Luân", "definition": "生公四輪 (Hoa Nghiêm Kinh Tuỳ Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sanh Diệt", "definition": "Utpāda-nirodha (S), Uppāda-nirodha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Giá Môn Đình", "definition": "撐 架 門 庭. Chỉ cho việc chống đỡ môn đình Thiền Tông. Như Tịnh Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sanh Hóa", "definition": "Cg, Hóa sinh. Một hình thức sinh, là biến hóa mà sinh ra, không phải là từ thai sinh ra, hay từ trứng sinh ra, cũng không phải từ trong chỗ ẩm ướt mà sinh ra.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Hỷ Tâm", "definition": "Hasituppada-citta (S), Rootless mirth-producing mind.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Không", "definition": "Có sinh ra, nhưng không rỗng, không có thực thể. Tất cả chúng sinh, tất cả các pháp, tuy có hiện tượng sinh ra, nhưng chúng sinh cũng như mọi pháp đều không có ngã, không có thực thể. Khởi Sinh ra và khởi lên.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Khởi", "definition": "Uppāda (P), Rising, Arising, Jāta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Khởi Chân Thật", "definition": "Xem Lưu Chuyển Chân Như.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Kinh", "definition": "Kinh Bổn sinh kể lại các truyện tiền sinh của Phật, và các đệ tử lớn của Phật. do Dharmapala dịch ra chữ Hán vào đầu thế kỷ III Tl (5 cuốn). ,", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Linh", "definition": "Chúng sinh có tâm thức (loài hữu tình).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Liễu", "definition": "檉柳. Tên một loại cây lá nhỏ, mọc khít, mùa hạ nở hoa năm cánh nhiều màu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sanh Làm Ngạ Quỷ", "definition": "Petayoni (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sanh Lên", "definition": "Samuṭṭhāpeti (saṃ + u + thā + āpe), samudaya (nam),uppajjati (u + pad + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sanh Lực", "definition": "Xem Khí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Manh", "definition": "Manh là mù. Sinh ra đã bị mù.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Môn Trụ Hộ", "definition": "撐 門 拄 戶. Chống cửa đỡ nhà, ý nói chống đỡ môn đình Thiền Tông. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sanh Nhân", "definition": "Janana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Nhương", "definition": "搶攘. Rối loạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sanh Nhẫn", "definition": "Nhẫn là nhẫn nhục. Chịu đựng mọi bức bách, phiền não do chúng sinh khác gây ra cho mình. Trái với pháp nhẫn là chịu đựng những bức bách phiền nhiễu do hoàn cảnh tự nhiên gây ra, như nóng lạnh, bão, gió v.v…", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Niệm Xứ Bồ Tát", "definition": "Xem Ức Niệm Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Pháp", "definition": "Prasava-dharma (S), Prasavadharnim (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Phật Giả Danh", "definition": "Chúng sinh hay Phật đều là giả danh, sở dĩ có phân biệt và gọi như vậy, chỉ là do quy ước với thế giới hiện tượng. Các cuộc sống, các đời sống nối tiếp nhau, không ngừng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Phật Nhất Như", "definition": "Chúng sinh và chư Phật là giống nhau, cùng một thể. Cg, Sinh Phật nhất thể, sinh Phật bất nhị (chúng sinh và Phật không phải là hai). Ý nói tất cả chúng sinh đều có Phật tính, cho nên đều có khả năng thành Phật trong tương lai.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Phụ", "definition": "傖父. Ông già quê mùa thấp hèn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sanh Quán", "definition": "甥館. Nhà con rể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sanh Ra", "definition": "Nibbattati (ni + vat + a), nibbattana (trung), pavasati (pa + su + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sanh Sanh Điểu", "definition": "Xem Cộng Mạng Điểu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Thiên", "definition": "Sinh lên cõi Trời. Thú Thú là đường hay cõi. Là các cõi sống.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Thiên Trụ Địa", "definition": "撐 天 拄 地. Chọc trời chống đất, hình dung việc chống đỡ môn đình của Thiền Tông. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sanh Thân", "definition": "Thân sinh diệt. Như nói, sinh thân của Phật Thích Ca, khác với pháp thân của Phật là bất sinh diệt.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Trụ Dị Diệt", "definition": "Bốn khâu trong quá trình diễn biến của bất cứ pháp hữu vi nào: sinh ra, an trú, biến dị và tiêu diệt.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tịnh Độ Bát Pháp", "definition": "Sanh Tịnh Độ bát pháp là tám pháp tu hành được sanh về cõi Tịnh Độ. Duy ma cư sĩ đáp câu hỏi của Chúng Hương Bồ Tát trong nước Chúng Hương: “ Ở cõi này thành tựu tám pháp được sanh nơi cõi Tịnh Độ ” đó là: Làm lợi ích cho chúng sanh mà chẳng mong đáp đền, thay thế cho chúng sanh chịu mọi bề khổ não, những công đức của mình làm ra, đem bố thí cho họ hết thảy. Tâm bình đẳng đối với chúng sanh, khiêm nhường cung kính Có chư Bồ Tát cung kính coi như Phật. Lúc nghe Kinh rồi hoặc chưa nghe, không sanh tâm nghi hoặc gì hết. Chẳng trái nghịch với bậc Thinh văn. Kẻ khác cúng dường mình chẳng ganh ghét, ở mình không cống cao, không mưu lợi lấy mình, mà ở trong đó điều phục cái tâm của họ. Thường xét điều lỗi của mình, chẳng tranh chỗ kém của kẻ khác. Thường đem một tấm lòng cầu các công đức.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tịnh Độ Ngũ Bất Thối", "definition": "生淨土五不退 (Tịnh Độ Thập Nghi Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sanh Tử", "definition": "(生死): vấn đề sanh tử (sống chết) được xem như vô cùng trọng đại đối với con người. Phật Giáo chia sanh tử của chúng sanh làm 2 loại: Phần Đoạn Sanh Tử và Biến Dị Sanh Tử (變異生死). Phần Đoạn Sanh Tử, còn gọi là Phần Đoạn Tử (分段死), Hữu Vi Sanh Tử (有爲生死), đối xưng với Biến Dị Sanh Tử, tức chỉ chúng sanh mỗi đời quả báo chiêu cảm không giống nhau, cho nên hình tướng, thọ mạng cũng khác nhau; đó được gọi là Phần Đoạn Thân (分段身). Sau khi thọ thân này, tất phải có một lần kết thúc sinh mạng, vì vậy có tên là Phần Đoạn Sanh Tử. Biến Dị Sanh Tử, hay Vô Vi Sanh Tử (無為生死), Bất Tư Nghì Biến Dị Tử (不思議變易死), Biến Dị Tử (變易死), tức chỉ sự sanh tử của các bậc thánh trong Ba Thừa như A La Hán (阿羅漢), Bích Chi Phật (辟支佛), Bồ Tát (菩薩), v.v., do vì bi nguyện cứu độ chúng sanh mà trở lại cõi đời này. Trong kinh điển Phật Giáo có rất nhiều ví dụ về sanh tử. Như Câu Xá Luận (俱舍論) ví sanh tử như bùn: “Sanh tử nê giả, do bỉ sanh tử, thị chư chúng sanh trầm nịch xứ cố, nan khả xuất cố, sở dĩ thí nê (生死泥者、由彼生死、是諸眾生沉溺處故、難可出故、所以譬泥, bùn sanh tử là do sanh tử ấy, là nơi chúng sanh bị chìm đắm, khó có thể ra được, vì vậy mới ví như bùn).” Thành Duy Thức Luận (成唯識論) thì ví như đêm dài: “Vị đắc chơn giác, hằng xử mộng trung, cố Phật thuyết vi sanh tử trường dạ (未得眞覺、恆處夢中、故佛說爲生死長夜, chưa được chánh giác, thường ở trong mộng, cho nên Phật dạy sanh tử là đêm dài).” Trong Phật Sở Hành Tán (佛所行讚) lại cho sanh tử là biển cả: “Đương thừa trí tuệ chu, siêu độ sanh tử hải (當乘智慧舟、超度生死海, phải lên thuyền trí tuệ, vượt qua biển sanh tử).” Hay Vô Lượng Thọ Kinh (無量壽經) thì xem sanh tử như là đám mây mù: “Huệ nhật chiếu thế gian, tiêu trừ sanh tử vân (慧日照世間、消除生死雲, trời tuệ chiếu thế gian, tiêu trừ mây sanh tử).” Trong khi đó, Đại Trí Độ Luận (大智度論) ví sanh tử là bánh xe: “Sanh tử luân tải nhân, chư phiền não kiết sử, đại lực tự tại chuyển, vô nhân năng cấm chỉ (生死輪載人、諸煩惱結使、大力自在轉、無人能禁止, xe sanh tử chở người, các phiền não kiết sử, lực lớn tùy ý chuyển, chẳng ai ngăn cấm được).” Hoặc Vãng Sanh Luận Chú (徃生論註) lại ví dụ sanh tử là khu vườn: “Thị ứng hóa thân, hồi nhập sanh tử viên, phiền não lâm trung du hí thần thông (示應化身，迴入生死園、煩惱林中遊戲神通, hiện thân ứng hóa, trở lại vào vườn sanh tử, thần thông rong chơi trong rừng phiền não).” Tại bảo tháp của Tổ Giác Tiên (覺先, 1880-1936), người khai sơn Chùa Trúc Lâm tại Huế và cũng là vị sáng lập Hội An Nam Phật Học Trung Việt, có câu đối: “Tàng bách niên sanh tử, quy nhất lộ Niết Bàn (藏百年生死、歸一路涅槃, ẩn trăm năm sống chết, về một đường Niết Bàn).” Tại Lâm Dương Tự (林陽寺) thuộc Phúc Châu (福州) có câu đối rằng: “Chúc khứ phạn lai mạc bả quang âm già diện mục, chung minh bảng hưởng thường tương sanh tử quải tâm đầu (粥去飯來莫把光陰遮面目、鐘鳴板響常將生死掛心頭, cháo đi cơm đến chớ để tháng ngày chơ mặt mũi, chuông ngân bảng vọng thường đem sanh tử mang trong tâm).” Thiền Sư Giới Không (界空, ?-?) của Việt Nam có một bài thơ về sanh tử rằng: “Ngã hữu nhất sự kỳ đặc, phi thanh huỳnh xích bạch hắc, thiên hạ tại gia xuất gia, thân sanh ố tử vi tặc, bất tri sanh tử dị lộ, sanh tử chỉ thị thất đắc, nhược ngôn sanh tử dị đồ, trám khước Thích Ca Di Lặc, nhược tri sanh tử sanh tử, phương hội lão tăng xứ nặc, nhữ đẳng hậu học môn nhân, mạc nhận bàn tinh quỹ tắc (我有一事希特、非青黃赤白黑、天下在家出家、親生惡死爲賊、不知生死異路、生死衹爲失得、若言生死異塗、賺卻釋迦彌勒、若知生死生死、方會老僧處匿、汝等後學門人、莫認盤星軌則, ta có một việc kỳ đặc, chẳng xanh vàng đỏ trắng hắc, trên đời tại gia xuất gia, thích sống ghét chết là giặc, chẳng biết sống chết hai nẻo, sống chết chỉ là được mất, nếu bảo sống chết khác đường, lừa cả Thích Ca Di Lặc, nếu biết sống chết sống chết, mới biết lão tăng chốn nào, các người môn nhân hậu học, chớ lầm khuôn mẫu phép tắc).” Hay Tuệ Trung Thượng Sĩ (慧中上士, 1230-1291) cũng có nhận định về sanh tử như sau: “Tâm chi sanh hề sanh tử sanh, tâm chi diệt hề sanh tử diệt, sanh tử nguyên lai tự tánh không, thử huyễn hóa thân diệc đương diệt (心之生兮生死生、心之滅兮生死滅、生死元來自性空、此幻化身亦當滅, tâm mà sanh chừ sống chết sanh, tâm mà diệt chừ sống chết diệt, sống chết nguyên lai tự tánh không, thân huyễn hóa này cũng phải diệt).” Câu “phần đoạn sanh tử quả nhân (分斷生死果因、盡滅冤恩煩惱)” có nghĩa là đoạn trừ từng phần nhân và quả của sanh tử, nhờ vậy mới có thể diệt tận mọi oán ân, phiền não.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sanh Tử Giã", "definition": "Giã là hoang vu. Sinh tử như rừng hoang vu, lạc vào đấy khó ra.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Giải Thoát", "definition": "Giải thoát khỏi sanh tử.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Hà", "definition": "River of birth-and-death.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Tử Luân", "definition": "Luân là bánh xe. Sinh tử giống như bánh xe, quay vòng mãi không ngừng. [tr.581]", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Luân Hồi", "definition": "Quay đi quay lại trong vòng sống chết.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Lưu", "definition": "Lưu là giòng chảy. Sinh tử ví như dòng chảy, lôi kéo chúng sinh quay vòng không thoát ra được.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Ngạn", "definition": "Ngạn là bờ. Sinh tử bờ, đối lập với bờ Niết Bàn bất tử.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Trường", "definition": "Dạ Sanh tử là đêm dài. Từ ví dụ. Sinh tử như đêm dài.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Tế", "definition": "Tế là cõi. Cõi sinh tử, đối lập với cõi Niết Bàn bất tử.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Uyên", "definition": "Uyên là vực thẳm. Từ ví dụ. Sanh tử giống như vực thẳm, chúng sinh rơi vào trong đó, khó lòng thoát ra.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Tử Vân", "definition": "Vân là mây. Từ ví dụ. Sinh tử giống như đám mây, bao bọc chúng sinh khiến khó thoát ra được.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Xúc", "definition": "撐 觸. Dính mắc. Tiết Hương Nghiêm Hòa Thượng trong TĐT q. 5 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sanh Y", "definition": "Y là chỗ dựa, điểm nương tựa. Mọi nhân duyên làm chỗ nương tựa cho tái sinh. Tham ái là sinh y. bởi vì có tham ái, mới có thủ (chấp thủ). Và để có cái mà chấp thủ, và để giữ vững không chịu buông những cái chấp thủ, cho nên phải tạo nghiệp. Tạo nghiệp chính là hữu. Do có hữu mà có sinh và già chết. Do có ái, thủ, và hữu mà có tái sinh. Đó là thuyết 12 nhân duyên (x. 12 nhân duyên).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh Đắc", "definition": "Upapatti-pratilambhika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sanh Đẻ", "definition": "Sañjāyati (saṃ + jan + ya), nibbattana (trung), vijāyati (vi + jan + ya), vijāyana (trung), janeti (jan + e), nibbattaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sanh Đồ", "definition": "Đồ là đường. Đồng nghĩa với sanh thú (x. sanh thú). Sanh đồ là cõi sống.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sanh, Lão, Bệnh, Tử", "definition": "Sinh, già, bệnh, chết là bốn nỗi khổ không tránh được của mọi người.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sankhara", "definition": "Hành. Trong thập nhị nhân duyên thì hành có nghĩa là tác ý. Trong ngũ uẩn thì hành chỉ cho năm mươi tâm sở. Hành còn có nghĩa là danh sắc hay các pháp có điều kiện, chẳng hạn như câu: Các pháp hành đều vô thường, hãy tinh tấn, chớ phóng dật. Chữ hành ở đây có nghĩa là các pháp có điều kiện hay danh sắc", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sankhara paramattha dhamma", "definition": "Chân lý tuyệt đối về các pháp có điều kiện. Hiện tượng danh sắc hay thân tâm được trực tiếp thấy rõ, không xuyên qua tư duy hay khái niệm.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sankharupekkhanana", "definition": "Tuệ xả. Có tâm xả thọ đối với tất cả mọi pháp (duyên sinh). Một trong những tuệ giác cao nhất trong thiền minh sát. Một trạng thái quân bình nội tâm tinh tế không bị ảnh hưởng bởi các cảm thọ vui khổ", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sanna", "definition": "Tưởng: tri giác, ý niệm, quan kiến, trí nhớ.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sanskrit", "definition": "The language of the original Aryan Tribesmen, was superseded (được thay thế) by local dialects and became in comprehensible to everybody but the Brahmins (members of the Indian priestly class).", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Santi sukha", "definition": "Tịnh lạc: hạnh phúc tịch tịnh. Một từ để chỉ kinh nghiệm Niết bàn.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Santosa", "definition": "Ba sự tri túc, sự bằng lòng với những gì đã có, sự biết đủ trong bốn món vật dụng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sao", "definition": "吵. Tiếng người nói ồn ào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Bạo", "definition": "抄暴. Dùng sức mạnh mà chiếm đoạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Bản", "definition": "抄本. Tầm giấy chép tay, bản chép tay Bản chép lại y như bảnh chánh, không phải là bản chánh. Ta cũng gọi là Bản sao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Chế", "definition": "炒製. Rang lên rồi trộn lẫn, công việc của người đông y sĩ, việc làm thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Chổi", "definition": "Dhūmaketu (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sao Công", "definition": "梢公. Người cầm lái thuyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Gia", "definition": "抄家. Tịch thu tài sản trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Già Đả Tỏa", "definition": "敲 枷 打 鎖. Phá bỏ gông cùm. Thiền Tông dùng từ này để chỉ cho việc phá bỏ gông cùm “ngoan không đoạn diệt”. Chương Mật Am Hàm Kiệt trong Tục Truyền Đăng Lục q. 34 (Đại 51, 704 trung) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sao Hôm", "definition": "Kuja (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sao Khinh", "definition": "訬輕. Nhẹ nhàng nhanh nhẹn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Không Tác Hưởng - Kích Mộc Vô Thinh", "definition": "敲 空 作 響 擊 木 無 聲. Gõ vào hư không phát ra âm thanh, đánh lên bảng gỗ không có tiếng động. Đây là cách nói kỳ đặc của thiền sư: Trong cái nhìn của người ngộ đạo không có sự đối đãi giữa có tiếng và không tiếng, có tiếng cũng tức là không tiếng, không tiếng cũng tức là có tiếng. Vân Môn Quảng Lục q. trung, ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sao Kinh", "definition": "Cũng gọi Biệt Kinh Sao, Sao Bản, Biệt Sao Kinh Điển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sao La Hầu", "definition": "Xem La Hầu Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sao Lược", "definition": "抄掠. Cướp bóc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Môn Ngõa Tử", "definition": "敲 門 瓦 子. Miếng ngói dùng để gõ cửa, cửa mở rồi thì ném bỏ nó đi; dụ chỉ cho lời nói chữ nghĩa dùng để khải phát việc ngộ đạo, sau khi lãnh ngộ thì không nên câu nệ vào lời nói chữ nghĩa nữa. Bài tựa của Thiền Sư Huệ Khai trong Vô Môn Quan:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sao Náo", "definition": "吵閙. Ồn ào tiếng người cãi cọ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Phiếu", "definition": "鈔票. Tờ giấy bạc. Tiền giấy ngày nay, do ngân hàng quốc gia phát ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Sao", "definition": "梢梢. Nhỏ bé Buông dài xuống, rủ xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Sàng Thụ Phất", "definition": "敲 床 竪 拂. Gõ vào pháp tòa, dựng đứng phất tử, đều là động tác thị cơ hoặc ứng cơ của thiền sư thường dùng, chỉ chung cho thiền cơ tác lược. Mật Am Ngữ Lục ghi: “朝 說 暮 說。展 演 河 沙 句 義。不 是 衲 僧 分 上 事。行 棒 行 喝。敲 床 豎 拂。揚 眉 瞬 目。不 是 衲 僧 分 上 事。", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sao Trấn", "definition": "Xem Thổ Tinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sao Tuế", "definition": "Xem Bột Lợi Cáp Tư Phạ Đế.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sao Tư", "definition": "鈔胥. Viên chức hạng thấp, giữ việc ghi chép viết lách. Thư kí tại công sở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Tả", "definition": "抄寫. Chép lại, viết lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Tẩm", "definition": "炒浸. Rang lên và rưới rượu, công việc chế thuốc của ngành đông y.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Tập", "definition": "抄襲. Chép văn người khác mà nhận làm của mình, coi như cướp đoạt của người ta. Như: Đạo văn Đem quân đánh úp địch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Tử", "definition": "梢子. Người đẩy thuyền. Người chân sào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Vân", "definition": "捎雲. Có hình dạng như mây trên trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sao Xướng", "definition": "敲 唱. Gia phong của tông Tào Động. Sao: Người học gõ cửa thất của thiền sư để thưa hỏi về đạo lý. Xướng: Thiền Sư trả lời để tiếp dẫn họ. Chỗ hỏi đáp của Thầy và trò liên tục không thưa hở, gọi là Sao xướng cụ hành. Đây là 1 trong 3 loại cương yếu của Động Sơn Lương Giới. Tông Môn Thập Cử Luận (Vạn Tục 110, 440 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sapling", "definition": "Cây non (Sapling Grove = vườn cây non)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sapper", "definition": "Military specialist on field fortification work = công binh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sappuri-sapaññatti", "definition": "Ba ước lệ bậc chân nhân, hạnh kiểm mà bậc chân nhân tán thành", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sappurisadhamma", "definition": "Tám pháp của bậc chân nhân, pháp của bậc chánh nhân quân tử.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sappurisadāna", "definition": "Tám cách bố thí của bậc chân nhân.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sappurisadānavipāka", "definition": "Năm kết quả bố thí của bậc chân nhân.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sappāya) cho vị hành giả tiến tu thiền định", "definition": "Bảy điều kiện thích hợp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saraha", "definition": "Saraha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sarcastic", "definition": "Chế nhạo, mỉa mai, châm biếm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sarcophagus", "definition": "Limestone used for coffins", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sariputa", "definition": "Xá-Lợi-Phất: Trong pháp hội, mở đầu bài thuyết pháp, đức Phật nói: “Này ông Xá-Lợi-Phất…”. Trong bao nhiêu bồ-tát, trưởng lão, tỳ kheo, thiên long bát bộ, vô lượng chư thiên đại chúng, đức Phật đã gọi một mình tôn giả Xá-Lợi-Phất! Như vậy hẳn là đức Phật rất quý mến đại đệ tử ấy! Mà quả thật, khi tôn giả Xá-Lợi-Phất khai triển tư tưởng cô đọng của đức Phật mà rồi sau đó có người thưa hỏi thì đức Phật trả lời: “Nếu các ông hỏi ta thì ta cũng sẽ giải thích như Xá-Lợi-Phất”. Không có lời khen ngợi nào cho bằng! Đức Phật có mười đại đệ tử, trong đó Ngài Xá-Lợi-Phất được coi là trí huệ bậc nhất, bậc đạo hạnh đệ nhất!", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sariputa and Moggallana", "definition": "(Xá Lợi Phất và Mục Kiền Liên)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sariputta", "definition": "Xá lợi phất. Một trong hai đại đệ tử của Phật, có trí tuệ bậc nhất.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sarnath", "definition": "Deer park where Buddha preached his first sermon to his first five disciples right after he attained enlightenment…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sartorial", "definition": "Thợ may, may mặc, quần áo đàn ông", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sarvastivada", "definition": "Also known as Sarvastivadin school. A major early Buddhist school that broke away from the Sthaviravada (Pali Theravada) school.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sash", "definition": "Khăn quàng vai", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Satchel", "definition": "Cặp, túi đeo vai", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sati", "definition": "Chánh niệm. Ghi nhớ đúng đắn. Chi thứ nhất trong thất giác chi.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Satipatthana", "definition": "Tứ niệm xứ: Bốn căn bản hay bốn lãnh vực của chánh niệm (ghi nhớ): niệm thân, niệm thọ, niệm tâm và niệm pháp.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Satipatthana Sutta", "definition": "Kinh Tứ niệm xứ. Một bài kinh trong đó Đức Phật chỉ dạy cách thực hành chánh niệm.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Satiric", "definition": "Châm biếm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Satthā", "definition": "Năm hạng Đạo Sư, các bậc thầy lãnh đạo môn phái, hạng thầy phàm phu", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Satyagraha", "definition": "Non-violent - loosely translated as \"insistence on truth\" (satya 'truth'; agraha 'insistence') or \"soul force\" or \"truth force,\" is a particular philosophy and practice within the broader overall category generally known as nonviolent resistance or civil resistance. The term \"satyagraha\" was coined and developed by Mahatma Gandhi. He deployed satyagraha in the Indian independence movement and also during his earlier struggles in South Africa for Indian rights. Satyagraha theory influenced Nelson", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sau Công Nguyên", "definition": "C.E.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sau Cùng", "definition": "Pacchima (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sau Này", "definition": "Āyatiṃ (trạng từ), pacchā (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sau Rốt", "definition": "Pacchima (tính từ), carima (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sau hết, Luận Thành Thực quyển 1 cho rằng, Kì Dạ (Kệ) có hai loại là Già Đà và Lộ già. Lộ già lại chia ra hai thứ: Thuận phiền não, Bất thuận phiền não, mà cho Già Đà trong 12 thể tài kinh là thuộc loại Bất thuận phiền não. [X. Luận Hiển Dương Thánh Giáo Q.6, Q.12; Luận Thuận Chính Lí Q.44; Luận Du Già Sư Địa Q.25, Q.81; luận Đại thứa a tì đạt ma tập Q.6; Đại Thừa Nghĩa Chương Q.1; Huyền Ứng Âm Nghĩa Q.24]. (xt. Thập Nhị Bộ Kinh, Kệ).", "definition": "II.Già Đà.Gọi đủ: A Già Đà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sau khi thọ thực, Bồ-Tát thấy trong mình khỏe mạnh phi thường, trọn ngày đó, Bồ-Tát ngồi trên bờ sông tham thiền quán tướng. Chiều lại, Ngài đến cội Bồ-đề kế cận, ngồi xoay mặt về hướng Đông và nhất nguyện không lìa khỏi nơi ấy trước khi đắc đạo quả. Chính dưới cội Bồ-đề này, Bồ-Tát Siddhartha chiến thắng vẻ vang trận giặc cuối cùng hết sức khó khăn...", "definition": "Bồ-tát - dịch từ chữ Pali bodhisattva, phiên âm là bồ-đề tát-đoá, gọi ngắn là bồ-tát. Nghĩa là giác hữu tình, còn gọi là đại-sĩ.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sau khi Đức Phật nhập diệt, Bồ Tát Mạn Thù Thất Lợi ra đời tại Ấn Độ, tuyên dương giáo nghĩa Đại Thừa. Trong Thai Tạng Giới của Mật Giáo, Ngài thị hiện hình đồng tử, gọi là Mạn Thù Đồng Tử, Mạn Thù Thất Lợi Đồng Tử (Phạm: Maĩjuzrì Kumàrabhùta). [X. Đại Tì Lô Giá Na kinh Đại Nghi Quĩ Q.trung]. (xt. Văn Thù Bồ Tát).", "definition": "II.Mạn Thù (1884-1918).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sau Đó", "definition": "Āyatiṃ (trạng từ), pacchā (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sau Đức Thế Tôn thành đạo, khi chuyển pháp luân lần đầu tiên tại vườn Lộc Dã, Bà Đề là một trong các đệ tử lớn được đạo. Về Chủng Tính của Bà Đề thì có nhiều thuyết khác nhau, Kinh Phương Quảng Đại Trang Nghiêm quyển 6, bảo sư là hậu duệ của vị đại thần trong thành Ca Tì La. Trung A Hàm quyển 8 Kinh Thị Giả, Luật Tứ Phần quyển 4, nói sư là con vua Bạt Đề giòng họ Thích. Luận Đại Tì Bà Sa quyển 182, Đại Đường Tây Vực Kí quyển 7, trong mục Bà la nê tư quốc, bảo sư thuộc một họ với Đức Thế Tôn. (xt. Bạt Đề).", "definition": "II - Bà Đề. Phạm: vana. Còn gọi là Bà Na, Phọc Ni. Dịch ý là lâm (rừng). [X. Hoa Nghiêm Kinh Thám Huyền Kí Q.19; Phạm Ngữ Tạp Danh].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sau đó, sư trở về Thọ Châu.", "definition": "2. Thiền tăng đời Đường, tham vấn Quy Tông Trí Thường. Một đêm kia, sư chợt la lên: Tôi đại ngộ rồi. Trí Thường nghe nói liền hỏi sư. Sư đáp: Sư cô vốn là người nữ. Về sau, sư ở chùa Pháp Hoa, núi Ngũ Đài, tự xưng là “Đại Thiền Phật”. Kệ thị tịch:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sau, ngài Khuy Cơ giải thích rằng: Tướng Phần do khác loại sinh ra là Tính Cảnh, Tướng Phần do cùng loại sinh ra là Độc Ảnh Cảnh và Tướng Phần do cả 2 cùng loại và khác loại sinh ra là Đới Chất Cảnh. [X.Thành Duy Thức Luận Chưởng Trung Xu Yếu Q.thượng, phần cuối; Đại Thừa Pháp Uyển Nghĩa Lâm Chương Q.4, phần cuối; Bách Pháp Vấn Đáp Sao Q.2].", "definition": "II.Tam Loại Cảnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Saunter", "definition": "Đi tản bộ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Savanna", "definition": "Hoang mạc, thảo nguyên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Savant", "definition": "Người học vấn rộng, nhà bác học", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Savvy", "definition": "Hiểu biết", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Say Mê", "definition": "Mada (nam), madana (trung), muyhati (muh + ya), palobhana (trung), sammucchati (saṃ + mus + ya), sammuyhati (saṃ + muh + ya), sammuyhana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Say Đắm", "definition": "Rāgaratta (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Say Đắm Tình Dục", "definition": "Mada (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sayadaw", "definition": "Đại sư. Một danh từ của người Miến Điện để tôn xưng một thiền sư hay một vị trụ trì.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sañcetanā", "definition": "Cetanā,  sáu tư, sự suy nghĩ cảnh, suy tư trên đối tượng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saññā", "definition": "Sáu tưởng, sự nhớ biết cảnh, sự nhận ra đối tượng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṃvara", "definition": "Năm pháp thu thúc, sự phòng hộ, sự ngăn ngừa", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṃvejanīyaṭṭhāna", "definition": "Bốn chỗ động tâm, bốn nơi thánh tính khiến cho rung động tâm, khởi sanh lòng tịnh tín, phát tâm thiện dễ dàng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṃvāsā", "definition": "Bốn sự chung sống gia đình.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṃyojana", "definition": "Saññojana, Mười kiết sử. theo kinh tạng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅ-ghaphāsuvihāra", "definition": "Năm pháp tăng chúng lạc trú.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅga", "definition": "Năm cố chấp, năm thứ phiền não hệ lụy tin thần", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅgaha", "definition": "Hai pháp nhiếp, pháp thu phục, pháp tế độ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅgahavatthu", "definition": "Bốn nhiếp pháp, bốn pháp nhiếp phục nhân tâm, bốn pháp cảm hóa người khác", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅghaguṇa", "definition": "Chín ân đức tăng, đức cao quí của tăng chúng", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅkhatalakkhaṇa", "definition": "Ba hữu vi tướng, trạng thái của pháp hữu vi", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Saṅkhāra", "definition": "Ba hành, nói theo pháp thực tính tạo tác", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Scabbard", "definition": "Bao kiếm, bao dao gâm, bao lưỡi lê", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scant", "definition": "Ít ỏi, hiếm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scapegoat", "definition": "Vật tế thần", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scarab", "definition": "Con bọ hung, đồ trang sức hình bọ hung ở Ai Cập", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scepticism", "definition": "Chủ nghiã hoài nghi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Schism", "definition": "Ly giáo, sự phân ly", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Schismatic", "definition": "Phạm tội ly giáo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Schizophrenic", "definition": "Psychotic disorder = chứng bịnh loạn thần kinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Schrewd", "definition": "Thông minh, khôn ngoan", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Schrilly", "definition": "Nhức óc, chói tai", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scimitar", "definition": "Thanh mã tấu, thanh đại đao", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scion", "definition": "Chồi giống, mầm; con ông cháu cha", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scold", "definition": "Rầy la, quở trách", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scorned", "definition": "Bị khinh bỉ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scoundrel", "definition": "Đồ vô lại, tên côn đồ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scramble", "definition": "Bò, trườn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scree", "definition": "Đá vụn, đá nhỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scribble", "definition": "Chữ viết nguệch ngoạc, cẩu thả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scrounging", "definition": "Biển lận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scruple", "definition": "Lưỡng lự, đắn đo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scrupulous", "definition": "Cực kỳ cẩn thận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scrutinize", "definition": "Examine closely = nghiên cứu kỹ lưởng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Scurried", "definition": "Hối hả, chạy nhốn nháo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Seafarer", "definition": "Thuỷ thủ, người đi biển", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Secular", "definition": "Generation, age = trăm năm một lần, trường kỳ, muôn thuở", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sedentary", "definition": "Được thực hiện lúc đang ngồi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sediment", "definition": "Cặn, chất lắng xuống đáy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Seer", "definition": "Nhà tiên tri", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Seethe", "definition": "Sôi lên, sủi bọt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Segregation", "definition": "Sự tách riêng, sự phân biệt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sekkha", "definition": "Bảy hạng hữu học.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Self", "definition": "According to Indian Buddhist philosopher Dharmakirti: self is the ruler or master of the body and mind.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Self-esteem", "definition": "Lòng tự phụ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Self-immolation", "definition": "Set self on fire = tự thiêu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Self-transmission", "definition": "Is a contemplative practice through which advanced yogis and yoginis can voluntarily leave their bodies by ejecting their subtlest consciousness out of the top of their heads and transmitting it into a Buddha verse, or pure land reality where love, compassion, bliss and wisdom are the dominant energies of life…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Selfhood", "definition": "Tính ích kỷ, tính chỉ nghĩ đến minh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Selfsame", "definition": "Giống hệt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Semantic", "definition": "To signify, mean = nghiã cuả từ, chữ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Semen", "definition": "Tinh dịch", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Semitism", "definition": "Thành viên chủng tộc Do Thái", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sen", "definition": "Hoa tượng trương cho đức hạnh trong sáng của Phật. Ngày xưa, để biểu trưng sự kiện Phật ra đời, các họa sỹ vẽ một hoa sen, cũng như để biểu trưng sự kiện Phật thành đạo, họ vẽ một gốc cây Bồ đề. “Như hoa sen tinh khiết đáng nhìn, Sinh từ bùn mà không dính bùn, Ta không bị ô nhiễm vì cuộc đời, Vì thế, này Bà-la-môn! Ta là Phật.” (Tăng Chi II, 39)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sen Chín Tầng", "definition": "Theo các Kinh sách của pháp môn Tịnh độ, người được vãng sinh ở cõi Cực Lạc phương Tây của Phật A Di Đà, được sinh ra không phải từ bụng mẹ, mà là từ trong hoa sen. Hoa sen có ba tầng: thượng, trung, hạ. Mỗi tầng như vậy lại chia làm ba cấp, tổng cộng có chín tầng sen. Tùy theo công phu tu hành mà người vãng sinh sẽ sinh ra một trong chín tầng sen.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sen Trắng", "definition": "Puṇḍarīka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sen Đỏ", "definition": "Kokanada (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Senile", "definition": "Lão suy, già yếu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sentient", "definition": "Perceive, feel, conscious of sense, impression", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sentient being", "definition": "Any living being with consciousness that is not free from gross and subtle ignorance.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sentient beings", "definition": "Including human beings = chúng sinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Septuagenarian", "definition": "Thọ bảy mươi (70-79 tuổi)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sepulchre", "definition": "Ngôi mộ cổ, mộ bằng đá", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sequester", "definition": "Để riêng ra, cô lập; ẩn dật, hẻo lánh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Serene", "definition": "Clear; serenity = clarity = cloudlessness = equanimity = tĩnh lặng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Serf", "definition": "Nông nô, thân trâu ngựa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sevitabbamitta", "definition": "Ba đức tính người bạn đáng thân cận.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Seyyā", "definition": "Bốn thế nằm.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Shakyamuni", "definition": "Phật Thích Ca Mâu Ni - Shakyamuni – Definition: He is also commonly known as Shakyamuni or Sakyamuni \"The sage of the Shakya clan\" and as the Tathagata \"thus-come-one\" or \"thus-gone-one\". According to tradition, Siddhartha Gautama was a Prince, and a member of the Kshatriya warrior caste. His father Suddhodana was the King of the Sakya people, and ruled in the capital of Kapilavatsu, today within the border of Nepal.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sham", "definition": "Giả bộ, giả vờ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shanghata", "definition": "Xem Chúng Hiệp Địa Ngục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Shangri-la", "definition": "Ultimate heaven = nơi tưởng tượng vô cùng hạnh phúc Shangri-la - The mythical paradise in James Hilton’s novel Lost Horizon appears to be based on the genuine ancient Tibetan myth of Shambala. It’s said to lie to the North of Tibet, it’s a kingdom surrounded by high snowy peaks with, at it center, a huge city dominated by the king’s palace. The kings of Shambala are also priests, who are said to have received teaching directly from the Buddha. It is in Shambala that the final battle will take place between the force of good and evil, religion and atheism (Thuyết Vô Thần)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shantideva", "definition": "A well known 8th century Buddhist teacher who wrote the great Mahayana classic Guide to the Bodhisattva’s way of life.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shawl", "definition": "Khăn choàng của phụ nữ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sheath", "definition": "Bao, vỏ gươm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sheer", "definition": "Đúng là, chỉ là, tuyệt đối", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shimmer", "definition": "Áng sáng lờ mờ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shipwright", "definition": "Thợ đóng tàu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shisheng", "definition": "(Chinese), (Shi = literati; sheng = businessmen) Giới Sĩ, Thương", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shiver", "definition": "Rùng mình vì sợ hãi, vì lạnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shred", "definition": "Mảnh vụn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shrewd", "definition": "Khôn ngoan, thông minh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shriek", "definition": "Tiếng la inh ỏi, tiếng hét inh ỏi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shrivering", "definition": "Shatter, break into many pieces", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shroud", "definition": "Vải liệm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shuddering", "definition": "Rùng mình, sợ hãi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shun", "definition": "Tránh, lảng xa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shunyata", "definition": "Emptiness, meaning the absence of any abiding essence in things or in contents of the mind = Không", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shush", "definition": "Im lặng, im đi!", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Shùnyatà (Sanskrit): Emptiness, voidness.", "definition": "A feature of Mahayana Buddhism and its unique doctrine Emp- tiness (shunyata). The teaching can be seen as an extension of the teaching of “not self” (anatman) found in early Buddhism. Emptiness specially means the denial of “intrinsic existence” with all phenomena. If something possessed intrinsic existence, it is argued, it would exist independently of something else. However the Buddha claimed that all things are “dependently originated”, everything arises from, and depends on, something else – and hence are “empty” of intrinsic existence. What we call a table, for example, is only a “mind projected” form. The deluded mind (bản tâm mê mờ) manifests (biểu lộ) an indepen- dent existence for the table which in reality it does not possess. This deep probing (phát hiện sự thật) led Mahayana Buddhists to posit (thừa nhận) two distinct levels of “truth”: “convention- al truth” (the table is an independent entity (thực thể độc lập)) and “ultimate truth” (the table has no independent existence) with a correct understanding (prajnya) of the nature of pheno- mena, such as that possessed by a Buddha, one ceased to grasp (níu kéo) after conventional truth.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Si", "definition": "Moha (S), Mogha (P), Stupidty, Delusion.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Si Bỉ", "definition": "嗤鄙. Chê cười khinh khi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Chủng", "definition": "癡種. Đầu óc ngu đần gia truyền. Giống giòng ngu đần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Cuồng Lưỡng Đầu Tẩu", "definition": "痴 狂 兩 頭 走. Kẻ si mê chấp trước hai bên. Thiền Tông cho rằng vạn pháp nhất như, sự vật không có hai đầu phân biệt và đối lập. Văn Ích Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Si Hoặc", "definition": "Si mê, nghi hoặc.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Si Hàn", "definition": "摛翰. Làm văn. Viết văn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Kiên", "definition": "鴟肩. Vai so, vai nhô cao như vai chim cú.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Li", "definition": "灑離. Rõ ràng, phân minh Không dứt Cũng nói Si si.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Mê", "definition": "Ajānana (trung), aññāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Si Mê:", "definition": "Ngu, mê muội, không thấy sự vật như thật. “Với ai bị si mê, Chúng sinh đi ác thú…” (Kinh Phật Thuyết Như Vậy, 414) Phàm Si mê phàm tục. Võng Võng là lưới. Si mê ví như cái lưới, vây bọc con người, không cho thấy chân lý.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Si Mạn", "definition": "Si mê và ngạo mạn", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Si Mị Võng Lượng.", "definition": "Si Mị và Võng Lượng đều là tên quỉ thần, yêu quái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Si Mục", "definition": "鴟目. Mắc cú Chi cặp mắt soi bói, mắt cú vọ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Ngai", "definition": "癡呆. Ngu dốt đần độn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Ngoan", "definition": "癡頑. Ngu đần, cứng đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Ngốc Đại Huệ", "definition": "Chigotsu Daie (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Si Nhi Bất Uý Hổ", "definition": "癡而不畏虎. Ngu nên không sợ cọp, vì không biết con cọp là con gì. Cũng như ta có thành ngữ: “Điếc không sợ súng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Nhân", "definition": "癡人. Kẻ ngu đần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Nhân Diện Tiền - Bất Đắc Thuyết Mộng", "definition": "癡 人 面 前 不 得 説 夢. Trước kẻ còn mơ, không nên nói mộng. Tiết Đông Thiền Tư Nhạc Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Si Nhân Si Phúc", "definition": "癡人癡福. Kẻ đần độn lại được hưởng điều may mắn tốt lành. Cũng như ta có câu: “Ngu si hưởng thái bình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Nhân Thuyết Mộng", "definition": "癡人說夢. Kẻ ngu đần nói chuyện chiêm bao, chỉ người nói năng không ra nghĩa lí gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Phược", "definition": "Moha-bandhana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Si Thiền", "definition": "I.Si Thiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Si Thủy", "definition": "Đối lại: Trí Thủy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Si Tiếu", "definition": "癡笑. Cười ngất. Cười đến không biết gì Cười một cách đần độn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Trì", "definition": "柴池. So le, không đều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Tuyệt Đạo Xung", "definition": "(癡絶道沖, Chizetsu Dōchū, 1169-1250): vị tăng của Lâm Tế Tông Trung Quốc, tự là Si Tuyệt (癡絶), xuất thân Trường Giang (長江), Võ Tín (武信, Tỉnh Tứ Xuyên), họ là Tuân (荀, hay Cẩu [苟]). Ông đến tham học với Tùng Nguyên Sùng Nhạc (松源崇岳) ở Tiến Phước Tự (薦福寺) và làm Thủ Tòa, rồi sau đó khế ngộ huyền chỉ của Tào Nguyên Đạo Sanh (曹源道生). Sau một thời gian đi tham vấn khắp chốn tùng lâm, vào năm thứ 12 (1219) niên hiệu Gia Định (嘉定), ông bắt đầu tuyên thuyết Thiền phong của mình ở Thiên Ninh Tự (天寧寺) vùng Gia Hưng (嘉興, Tỉnh Triết Giang), rồi lại chuyển sang Tương Sơn (蔣 山). Đến năm thứ 3 (1239) niên hiệu Gia Hy (嘉 熙), ông lên Tuyết Phong Sơn (雪 峰 山) ở Phúc Châu (福 州, Tỉnh Phúc Kiến), rồi sau chuyển đến Thiên Đồng Sơn (天童山) vùng Tứ Minh (四明, Tỉnh Triết Giang). Vào năm thứ 4 (1244) niên hiệu Thuần Hựu (淳祐), ông đến trú trì Linh Ẩn Tự (靈隠寺) ở Hàng Châu (杭州, Tỉnh Triết Giang). Đến năm thứ 9 cùng năm nầy, Kinh Triệu Duẫn (京兆尹) quy y theo ông, cho nên ông khai sáng ra Pháp Hoa Tự (法華寺) ở vùng Ngô Hưng (呉興, Tỉnh Triết Giang). Cùng năm đó, ông đến trú tại Kính Sơn (徑山) thuộc vùng Lâm An (臨安, Tỉnh Triết Giang). Vào ngày 13 tháng 5 năm thứ 10 niên hiệu Thuần Hựu (淳祐), ông thị tịch, hưởng thọ 82 tuổi đời và 61 hạ lạp. Ông có để lại bộ Si Tuyệt Đạo Xung Thiền Sư Ngữ Lục (癡絶道沖禪師 語錄) 2 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Si Tình", "definition": "癡情. Mê mẩn vì lòng yêu trai gái Lòng yêu sau đắm, không còn biết gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Tưởng", "definition": "癡想. Nghĩ ngợi vô ích, ngu dại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Vưu", "definition": "蚩尤. Tên người thời thượng cổ Trung hoa, nổi loạn, bị vua Hoàng Đế giẹp tan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Ái", "definition": "Thương yêu đến si mê.", "source": "Tu Dien Phat Hoc Tong Hop - Doan Trung Con - Tu Thong - Nguyen Lien - Duc Tri"}
{"term": "Si Ái:", "definition": "Thương yêu đến si mê.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Si Ám", "definition": "Si mê mờ tối.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Si Đề", "definition": "嗤詆. Chê cười và làm nhục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Định", "definition": "癡定. Tiếng nhà Phật, chỉ sự yên lặng đầu óc đến độ như không còn biết gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Si Độc", "definition": "Si mê ví như thuốc độc.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Si Độn Không Tính", "definition": "Chidon Kūshō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sidari", "definition": "Sidari (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siddhartha", "definition": "The Buddha (563 – 483 BC) His Life in Short", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Siddhis", "definition": "The collective unconscious that it is at this level that extrasensory powers operate. Such powers, whether involving telepathy (receipt of other people’s thoughts), clairvoyance (receipt of infor- mation about the environment) or precognition (receipt of inform- ation about the future), do not function through normal conscious channels…Laboratory research, in addition to the spontaneous experiences of everyday life, indicates the existence of these extra- sensory powers, but tell us little about the process involved or how to train them (i.e. walking on water, flying, invisibility…).", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Siddhis magic power", "definition": "Nhận thức thần thông - are spiritual, magical, paranormal, or supernatural powers acquired through sadhana (spiritual practices), such as meditation and yoga. People who have attained this state are formally known as siddhas.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sieve", "definition": "Cái sang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sift", "definition": "Giần, sang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sigālakapitā Thera", "definition": ") Thera. Ông làm gia chủ ở Sāvatthi có con là Singālaka. Về sau, ông xuất gia và được Phật cho đề tài thiền về bộ xương mà ông tinh tấn tu tập trong rừng Bhesakalāvana trên núi Suṃsumāra. Tậi đây có vị thần cây giáo thuyết ông (1). Ông đắc quả A la hán.", "source": "Tu-Dien-Danh-Tu-Rieng-Pali-Chon-Quan-Tran-Ngoc-Loi-Dich"}
{"term": "Sikkhā", "definition": "Ba học pháp, cũng thường gọi là tam học (Tisikkhā), pháp nền tảng tu tập để tăng tiến, để đạt đến níp-bàn", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sikkhāpadapaññatti atthavasa", "definition": "Mười mục đích của việc chế định học giới.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sila", "definition": "Giới. Đức hạnh.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Silashin", "definition": "Tu nữ Miến Điện, giữ tám hay mười giới, Mặc y phục vàng, hồng hay nâu.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Silānisansa", "definition": "Năm lợi ích của sự trì giới.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Similitude", "definition": "Giống, tương tự, đồng dạng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sinew", "definition": "Bắp thịt, gân guốc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sinh", "definition": "牲. Loài vật nuôi trong nhà để giết thịt Giết thịt Bị giết để đạt tới mục đích gì. Td: Hi sinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Ban Niết Bàn", "definition": "Phạm: Upapadya-parinirvàyin. Gọi tắt: Sinh Ban.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Biến", "definition": "Xem Nhân Năng Biến.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sinh Báo", "definition": "Đời này tạo các nghiệp thiện, ác, đời sau chịu báo khổ, vui.Một trong 3 báo. (xt. Tam Báo).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Bình", "definition": "生平. Cuộc đời, cuộc sống của mình từ trước tới nay. Ta cũng thường nói Bình sinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Chi", "definition": "I.Sinh Chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Chủ", "definition": "Phạm: Prajàpati.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Công Tứ Luân", "definition": "Chỉ cho thuyết Tứ Luân do ngài Trúc Đạo Sinh lập vào thời Đông Tấn. Luân có nghĩa phá diệt, có năng lực phá diệt hoặc nghiệp của chúng sinh để vượt ra ngoài 3 cõi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Cơ", "definition": "生機. Dịp may, dịp tốt để làm việc mà sống. Quả dưa đỏ của Nguyễn Trọng Thuật nó câu: “Trước còn tự dè xẻn cả cái sinh cơ, rồi hèn yếu dần đi, đến tê liệt cả tộc loại”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Cầm", "definition": "生擒. Bắt sống quân địch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Diện", "definition": "生面. Lạ mắt. Kẻ lạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Diệt", "definition": "Cũng gọi: Khởi diệt. Đồng nghĩa: Sinh tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Diệt Diệt Dĩ", "definition": "Sinh diệt diệt rồi.Nghĩa là đã xa lìa thế giới vô thường sinh diệt, đạt đến Niết Bàn vắng lặng không sinh không diệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Diệt Khứ Lai", "definition": "Sinh diệt đi đến. Chỉ cho Như Lai Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Diệt Khứ Lai Nhất Dị Đoạn Thường", "definition": "Tông Tam Luận lập thuyết “Bát Bất Trung Đạo” và cho đó là yếu chỉ tột cùng. Bát bất là: Bất Sinh bất diệt, bất khứ bất lai, bất nhất bất dị, bất đoạn bất thường. Ngược lại là: Sinh diệt, khứ lai, nhất dị, đoạn thường, gọi là “Bát Mê”. Nếu phá trừ được Bát mê này thì đạt đến trung đạo. (xt. Bát Bất Trung Đạo).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Diệt Nhị Quán", "definition": "Chỉ cho Sinh Quán và Diệt Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Diệt Quán", "definition": "Tên khác của Tích Không Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Diệt Tứ Đế", "definition": "Một trong 4 loại Tứ Đế do Đại Sư Trí Khải Tông Thiên Thai thành lập. Đây là nói về 3 tạng giáo, chủ trương nhân duyên sinh diệt là có thật, cho rằng3 đế Khổ, Tập và Đạo nương nơi nhân duyên mà thực có sinh diệt. Diệt Đế cũng được xem là pháp diệt có thật. Tức là Tứ Đế được thành lập trên quan điểm thực sinh thực diệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Duyên", "definition": "生 緣. Quê quán. Chương Ngũ Tổ Diễn Thiền Sư", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sinh Dân", "definition": "生民. Chỉ chung mọi người trong nước. Như Nhân dân, Dân chúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Dưỡng", "definition": "生養. Đẻ con và nuôi con. Chỉ công ơn cha mẹ Thơ Tản Đà có câu: “Nào những ai, cù lao báo đức, sinh dưỡng đền ơn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Dục", "definition": "生育. Đẻ ra và nuôi lớn Thuộc về việc sanh đẻ. Td: Cơ quan sinh dục (bộ phận trong thân thể liên quan đến việc sanh đẻ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Giả Tất Diệt", "definition": "Có sinh ắt có diệt, nói lên nghĩa vô thường củatướngthế gian. Đây là điểm xuất phát của chân lí nhân sinh tột cùng trong Phật Giáo. [X. Kinh Đại Bát Niết Bàn Q.2 (bản Bắc); Kinh Vô Thường; Kinh Vị Sinh Oan].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Hoá", "definition": "生化. Sống và thay đổi đi, tức sống và chết. Tiếng của đạo Lão. Đạo Lão cho rằng chết là sự thay đổi (hoá) mà thôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Hoạt", "definition": "生活. Sống (trái với chết) Làm việc để sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Hòa Hợp Tịnh", "definition": "Amathitakappa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sinh Khoáng", "definition": "生壙. Ngôi mộ làm sẵn lúc còn sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Khách", "definition": "生客. Khách lạ, người lạ mặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Khí", "definition": "Prāṇa (S), Vital energy bindu (T), Pāṇa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sinh Không", "definition": "Xem Nhân Vô Ngã.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sinh Không Tam Muội", "definition": "Chỉ cho thiền định quán tưởng chúng sinh là do 5 uẩn giả hòa hợp mà thành, không có ngã thể cố định bất biến.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Khương", "definition": "生薑. Gừng sống (không sao, nướng lên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Khẩu", "definition": "牲口. Con vật nuôi trong nhà để giết thịt (trâu, bò, dê, lợn..).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Khổ", "definition": "Chữ “sinh” không phải chỉ có nghĩa là sinh ra đời, mà còn có nghĩa là đời sống. Vì vậy, từ “sinh khổ” cũng còn được hiểu là những đau khổ mà con người phải gánh chịu trong cuộc tranh đấu để sống còn trong suốt cuộc đời. Sự làm lụng vất vả, gian nan, nguy hiểm; những suy nghĩ, lo toan, phiền muộn; những áp bức, tra tấn, hành hạ, lăng nhục, chém giết, tù ngục, v.v...; tất cả những nỗi bi thảm, đau khổ cùng cực đó đều là “sinh khổ”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sinh Khởi", "definition": "Chỉ cho Năng Sinh và Sở Sinh. Năng sinh là cái sinh ra, gọi là Nhân; Sở Sinh là cái được sinh ra, gọi là Quả.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Khởi Bản Mạt", "definition": "Gốc ngọn của sự sinh khởi.Tức chỉ cho nguyên nhân căn bản và kết quả diễn thành sự vật sinh khởi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Khởi Nhân", "definition": "Cũng gọi Sinh Nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Kí", "definition": "生寄. Sống gửi. Chỉ sự tạm bợ của cuộc đời. Td: Sinh kí tử quy (sống gửi thác về). Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “Cho hay sinh là kí mà tử là quy Mới biết mệnh ấy yểu mà danh ấy thọ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Kế", "definition": "生計. Đường lối kiếm sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Kế Bất Chính", "definition": "Người tu hành mưu sinh bằng các phương kế sau đây đều bị coi là bất chính: 1) Bày ra các trò trá ngụy như tịch cốc, đắc đạo, thần thông v.v... để được nhiều người tín ngưỡng. 2) Tự khoe học vấn cao và công đức lớn. 3) Xem tướng tốt xấu. 4) Lớn tiếng ra oai, nói năng khoác lác. 5) Nói mình được nhiều người cúng dường để khích động lòng người. Mục đích của năm sự việc trên đây đều vì thủ lợi để nuôi sống mình, cho nên gọi là năm loại sinh kế bất chính.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sinh Li", "definition": "生離. Còn sống mà phải chia lìa. Đoạn trường tân thanh có câu: “Đau lòng tử biệt sinh li, thân còn chẳng tiếc tiếc gì đến duyên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Linh", "definition": "生靈. Chỉ chung mọi người trong nước. Như Sinh dân 生民.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Luận", "definition": "Phạm: Utpàda-vàdin.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Lão Bệnh Tử", "definition": "Cũng gọi Tứ tướng, Tứ khổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Lí", "definition": "生理. Đường lối làm việc kiếm sống Cái lẽ duy trì và chi phối sự sống của sinh vật Ta còn hiểu theo nghĩa hẹp là việc ăn nằm giữa nam nữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Lí Học", "definition": "生理學. Môn học về các hiện tượng sinh hoạt của sinh vật (Phistologic) Ta còn hiểu theo nghĩa hẹp là môn học về những liên quan nam nữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Lòng Hi Hữu", "definition": "Entering a frame of mind seldom experienced", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sinh Lản", "definition": "生產. Đẻ con (nói về đàn bà) Làm nảy nở thêm nhiều ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Lộ", "definition": "生路. Con đường sống, đem lại sự sống (trái với tử lộ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Lợi", "definition": "生利. Đem lại điều có ích Đẻ ra tiền lời, của cải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Manh", "definition": "Người mù bẩm sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Manh Xiển Đề", "definition": "Cũng gọi Sinh Manh Nhất Xiển Đề. Ví dụ người Nhất Xiển Đề (Phạm: Icchantika) là sinh manh. Sinh manh chỉ cho người sinh ra đã mù; Xiển Đề chỉ cho kẻ đã dứt hết tất cả căn lành và không thể thành Phật. Người không tin Phật Pháp, cũng như kẻ sinh manh không tin rằng trên thế gian này còn có ánh sáng, bởi thế Nhất Xiển Đề không thể phát tâm cũng giống như người sinh manh không thể chữa lành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Minh", "definition": "生明. Chỉ thời gian từ đầu tháng tới giữa tháng âm lịch, mặt trăng cứ sáng dần lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Mệnh", "definition": "生命. Cuộc sống. Đời sống. Mạng sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Mệnh Hình", "definition": "生命刑. Sự trừng phạt bắt phải chết. Như: Tử hình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Nghi", "definition": "生疑. Trở nên ngờ vực. Đâm ra ngờ vực. Đoạn trường tân thanh có câu: “Vả đây đường sá xa xôi, mà ta bất động nữa người sinh nghi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Nghiệp", "definition": "生業. Việc làm để sống Nghề chưa rành, chưa thuần thục (giống như đồ ăn còn sống).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Nhai", "definition": "生涯. Cách kiếm ăn. Như Sinh kế Ta còn hiểu là làm việc để sống. “Bốn mùa mặt nước sinh nhai” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Nhân", "definition": "生人. Người sống Người lạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Nhân Bản Nguyện", "definition": "Cũng gọi Sinh Nhân Nguyện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Như Trước Sam - Tử Đồng Thoát Khố", "definition": "生 如 著 衫 死 同 脫 袴. Sinh ra như mặc áo, chết đi tợ cởi quần; ý bảo xem việc sống chết rất là bình thường. Đây là một cách biểu hiện của người lãnh ngộ thiền pháp, siêu thoát sinh tử. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sinh Nhất Thiết Chi Phần Ấn", "definition": "Thủ ấn gia trì vào tứ chi (2 tay, 2 chân) ngũ thể (trán, 2 khuỷu tay, 2 đầu gối) của đệ tử khi tu pháp Quán Đính trong Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Nhật", "definition": "生日. Ngày đẻ, ngày chào đời. Đoạn trường tân thanh có câu: “Ngày vừa sinh nhật ngoại gia, trên hai đường dưới nữa là hai em”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Nhật Đại Hội", "definition": "Ngày lễ Đản Sinh của Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Nhục", "definition": "生肉. Thịt sống (chưa nấu nướng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Niệm Xứ Bồ Tát", "definition": "Sinh niệm xứ, Phạm: Smritisajàtya. Cũng gọi Ức Niệm Bồ Tát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phiên", "definition": "生番. Giống người chưa được khai hoá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Phách", "definition": "生魄. Khoảng thời gian từ giữa tháng đến cuối tháng âm lịch, mặt trăng ngày càng tối đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Pháp", "definition": "Phạm: Prasava-dharma, Prasavadharmìn. Cũng gọi Nhân Pháp, Ngã Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Pháp Nhị Không", "definition": "Cũng gọi Ngã Pháp Nhị Không, Nhân Pháp Nhị Không, Nhân Pháp Nhị Vô Ngã. Gọi tắt: Nhị Không, Nhị Vô Ngã.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Pháp Nhị Thân", "definition": "Chỉ cho Sinh Thân và Pháp Thân. Tiểu Thừa chủ trương thân đức Phật sinh trong cung vua là Sinh Thân, còn các công đức vô lậu có được từ giới định tuệ là Pháp Thân. Đại Thừa thì cho rằng chân thân lí và trí ngầm hợp là Pháp Thân, thân Ứng hóa tùy cơ hiện sinh là Sinh Thân; tức trong 3 thân thì Pháp Thân và Báo Thân hợp chung lại là Pháp Thân, còn Ứng Thân là Sinh Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phạn", "definition": "Trước khi ăn, dành ra chút ít cơm (phạn) để bố thí cho chúng sinh. Vì rải cơm bố thí cho quỉ thần nơi đồng trống nên cũng gọi là Tán Phạn. Đối tượng cúng thí thông thường là chim Đại bàng cánh vàng, chúng quỉ thần ngoài đồng trống, mẹ con quỉ La Sát... Nếu cúng dường Tam Bảo, Minh Vương Bất Động và thần Quỉ Tử Mẫu thì gọi là Tam Phạn (hay Tam bả). Lại vì có hàm ý là bày thức ăn ra để cúng thí chúng sinh, nên cũng gọi là Xuất Thực, Xuất Sinh, Sinh Thực, Chúng Sinh Thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phần", "definition": "生墳. Ngôi mộ làm sẵn từ lúc còn sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Phật", "definition": "I.Sinh Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phật Bất Tăng Bất Giảm", "definition": "Chỉ cho Sinh Phật Nhất Như, tức chúng sinh trong pháp giới tuy thành Phật mà cõi chúng sinh không giảm, cõi Phật cũng không tăng. Hoặc bảo cõi chúng sinh và cõi Phật đều là vô lượng vô biên; vì cõi chúng sinh vô biên, nên chúng sinh thành Phật mà cõi chúng sinh không giảm; vì cõi Phật vô biên, nên chúng sinh vào cõi Phật mà cõi Phật không tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phật Giả Danh", "definition": "Chúng Sinh và Phật đều là tên giả. Tức đứng về phương diện tục đế mê tình mà nóithìlà giả danh, còn đứng về phương diện chân đế giác ngộ mà nói thì là chân như bình đẳng, chẳng có chúng sinh cũng không có Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phật Nhất Như", "definition": "Cũng gọi Mê Ngộ Bất Nhị, Sinh Phật Bất Nhị, Sinh Phật Bình Đẳng, Phật Phàm Nhất Thể, Phàm Thánh Bất Nhị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Phật còn chỉ cho các bậc cao tăng, danh tăng, thiện thức... được mọi người tôn kính như Phậtgiáng thế.", "definition": "II.Sinh Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Quá Tương Tự Quá Loại", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Ra", "definition": "Jāyati (jan + ya), uppajjati (ud + pad), jāta (3)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sinh Sinh", "definition": "生生. Cứ nảy thêm mãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Sinh Thế Thế", "definition": "Cũng gọi Thế Thế Sinh Sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Sinh Tướng", "definition": "Chỉ cho pháp làm cho “Tướng sinh” sinh khởi, cùng với 3 tướng Trụ Trụ, Dị Dị, Diệt Diệt, đều là Tùy Tướng hoặc Tiểu Tướng của 4 tướng, đối lại với tướng sinh trong 4 tướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Sát", "definition": "牲殺. Làm thịt súc vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Súc", "definition": "牲畜. Loại vật nuôi trong nhà. Cũng nói: Súc sinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Sơ", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Sản", "definition": "Sañjāyati (saṃ + jan + ya), nibbattana (trung), vijāyati (vi + jan + ya), vijāyana (trung), janeti (jan + e), nibbattaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sinh Sản Phí", "definition": "生產費. Số tiền tiêu dùng vào việc sinh đẻ của đàn bà. Cũng gọi là Sản phí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Sắc", "definition": "生色. Làm nảy ra vẻ đẹp Vẻ đẹp sống động, thu hút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Sự", "definition": "生事. Gây việc. Tạo ra việc đáng tiếc. Tựa ngữ: Sinh sự thì sự sinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thiên", "definition": "Sinh lên cõi trời.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Thiên Nhân", "definition": "Chỉ cho nghiệp nhân sinh lên cõi trời.Thích Thị Yếu Lãm quyển trung dẫn lời kinh Nghiệp báo sai biệt (Đại 54, 291 thượng) nói: “Tu đủ 10 điều thiện tăng thượng được sinh lên tầng trời Tán Địa của cõi Dục; nếu tu 10 điều thiện hữu lậu, nhờ tương ứng với định, được sinh lên trời cõi Sắc; nếu tu lìa sắc, xa lìa thân, khẩu, nhờ tương ứng với định, được sinh lên cõi Vô Sắc”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Thiên Tất Đàn", "definition": "Phạm: Siddhànta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Thiết", "definition": "生鐵. Sắt sống, quặng đất. Sắt chưa luyện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thành", "definition": "生成. Đẻ ra và nuôi lớn gây dựng cho. Chỉ công ơn cha mẹ Đoạn trường tân thanh có câu: “Để lời thệ hải minh sơn, làm con truớc phải đền ơn sinh thành”. Thiên sinh chi, địa thành chi 天生之, 地成之 (Kinh Dịch). Trời sinh ra có hình đất làm ra thành hình. Ta coi công đức cha mẹ như trời đất, cho nên gọi là sinh thành. “Làm con trước phải đền ơn sinh thành” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thân", "definition": "Bồ-tát sinh thân. Nhục Thân của Phật thì gọi là “sinh thân”, tức là cái thân do chư Phật tùy hạnh nguyện mà ứng hiện trong các loài để cứu độ chúng sinh; đối lại với “sinh thân” là “pháp thân”. Các vị Bồ-tát khi đã tiến lên cấp Mười-địa, chứng nhập pháp tính, hóa độ tự tại thì gọi là “Bồ-tát sinh thân”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sinh Thân Cúng", "definition": "Pháp Hội được cử hành để cúng dường xá lợi nhục thân của Đức Thế Tôn. Trong Mật Giáo, đối với Đức Phật hoặc Tổ Sư tiên đức quán tưởng Sinh Thân mà cúng dường, cũng gọi là Sinh Thân Cúng. (xt. Sinh Thân).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Thú", "definition": "生趣. Niềm vui thích trong cuộc sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thọ", "definition": "生 受. Bị giày vò. Tiết Bảo Phong Duy Chiếu Thiền Sư trong NĐHN q. 14 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sinh Thời", "definition": "生時. Lúc còn sống. Cũng như Sinh tiền 生前 (nói về người đã chết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thủ", "definition": "生手. Bàn tay còn vụng, chưa thạo việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thực", "definition": "生殖. Đẻ thêm ra, nảy nở nhiều thêm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thực Dục", "definition": "生殖慾. Lòng ham muốn về sự sinh đẻ, tức sự ham muốn ăn nằm với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Thực Khí", "definition": "生殖器. Bộ phận của cơ thể, dùng để sinh đẻ, duy trì giòng giống (chỉ chung dương vật của phái nam và âm hộ của phái nữ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tiền", "definition": "生前. Lúc trước, khi còn sống (nói về người đã chết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Trí", "definition": "生知. Biết sẵn. Không học mà mà biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Trưởng", "definition": "生長. Được đẻ ra và lớn lên. Thơ Tản Đà có câu: “Nào những ai, sinh trưởng nơi khuê các, khuya sớm phận nữ nhi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tài", "definition": "生財. Làm ra của cải, tạo ra tiền lời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tân", "definition": "Bến sông sinh tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tình", "definition": "生情. Trong lòng nảy sinh tình cảm mới, khi đứng trước ngoại cảnh. Td: Đối cảnh sinh tình Nảy lòng. Đem lòng. Truyện Trê Cóc có câu: “Trê kia là đứa gian manh, bắt con mà lại sinh tình sai ngoa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tính", "definition": "生性. Đẻ ra cái nết. Tục ngữ: Cha sinh con trời sinh tính Nết trời cho từ lúc lọt lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tô Kinh", "definition": "Chỉ cho các kinh của thời Phương Đẳng trong 5 thời giáo do Tông Thiên Thai thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tô Sát Nhân", "definition": "Ngài Trí Khải Tông Thiên Thai chia giáo pháp của Đức Phật nói trong 1 đời làm 5 thời: Hoa Nghiêm, Lộc Uyển, Phương Đẳng, Bát Nhã, Pháp Hoa Niết Bàn và phối hợp 5 thời này với 5 vị: Sữa, lạc, sinh tô, thục tô và đề hồ. Trong đó, vị sinh tô phối hợp với thời Phương Đẳng, tức sinh tô được ví dụ như giáo pháp Phương Đẳng Đại Thừa. Nghĩa là trong các kiếp quá khứ đã từng được nghe giáo nghĩa Đại Thừa, ví như bị trúng độc; nay lại được nghe những giáo pháp Phật đã nói ngày trước mà tỉnhngộ, ví dụ chất độc phát sinh tác dụng, đến nỗi chết người.Tức là các vị Bồ Tát của thời Phương Đẳng, nghe giáo pháp Đại Thừa mà thấy được tính Phật, tất cả phiền não kết hoặc trong vô lượng kiếp bỗng nhiên dứt hết, vào ĐạiNiết Bàn, như người chết đi vừa sống lại (Đại tử nhất phiên).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tôn Quí Gia Nguyện", "definition": "Nguyện được sinh vào nhà tôn quí. Chỉ cho nguyện thứ 43 trong 48 điều nguyện của Đức Phật A Di Đà. Tức hành giả niệm danh hiệu Phật A Di Đà, sau khi mệnh chung được sinh vào nhà tôn quí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tĩnh Lự", "definition": "Tĩnh lự, Phạm: Dhyàna. Pàli: Jhàna.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tướng", "definition": "Phạm: Pàli: Jàti.Gọi tắt: Sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tượng", "definition": "Vàng và bạc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tịnh Độ Bát Pháp", "definition": "Tám pháp làm nhân sinh về Tịnh Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tồn", "definition": "生存. Sống còn. Không bị tiêu diệt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tồn Cạnh Tranh", "definition": "生存競爭. Đua chen giành giựt để được sống còn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tụ", "definition": "生聚. Đông đảo thêm lên và gom lại một chỗ (nói về dân chúng trong nước).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tức", "definition": "生息. Như Sinh lợi 生利.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tức Vô Sinh", "definition": "Sinh chính là vô sinh, không hai không khác. Đây là giáolí được nói trong các bộ Bát Nhã và cũng là ý nghĩa tột cùng của Tông Tam Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Từ", "definition": "生祠. Đền thờ người đang còn sống, nhưng có sự nghiệp lớn lao, giúp ích cho nhiều người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tử", "definition": "生死. Sống và chết. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “Niềm tôn thân dù sinh tử chớ nề..” Chỉ mối ràng buộc chặt chẽ, sống chết có nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Tử Dã", "definition": "Cánh đồng sinh tử, ví dụ sự sống chết rộng lớn, bát ngát, bao la.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Giải Thoát", "definition": "Cởi bỏ được sự trói buộc của sinh tử mà vào cảnh giới Niết Bàn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Hải", "definition": "Biển sống chết. Chúng Sinh chìm đắm trong cõi mê sinh tử, quay vòng không cùng, giống như biển cả mông mênh không bờ bến, nên gọi là Sinh Tử Hải.Phật Sở Hành Tán quyển 3 (Đại 4, 22 trung) nói: “Nên dong thuyền trí tuệ, vượt qua biển sinh tử”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Lao Quan", "definition": "Tiếng dùng trong Thiền Lâm. Chỉ cho cửa ải sinh tử luân hồi đóng chặt, khó vượt qua.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Lưu", "definition": "Dòng sống chết. Vì sinh tử có năng lực cuốn trôi chúng sinh như dòng nước, cho nên gọi là Sinh tử lưu. Kinh Vô Lượng Thọ quyển hạ (Đại 12, 273 trung) nói: “Giả sử lửa cháy khắp thế giới, cũng cần phải nghe pháp, sẽ được thành Phật đạo, rộng độ sinh tử lưu”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Ngạn", "definition": "Bờ sống chết. Chỉ cho chúng sinh còn bị chìm đắm trong biển sinh tử luân hồi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Nhục Thân", "definition": "Nhục thân sống chết, 1 trong 2 loại thân của Bồ Tát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Nê", "definition": "Vũng bùn sống chết. Nghĩa là chúng sinh chìm đắm trong sinh tử, như ở trong vũng bùn lầy nên dùng bùn để ví dụ. Luận Câu Xá quyển 1 (Đại 29, 1 thượng) nói: “Sinh tử nê, có nghĩa sinh tử là nơi chúng sinh bị chìm ngụp, khó ngoi ra được, cho nên dùng bùn (nê) để ví dụ”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Phược", "definition": "Sống chết trói buộc. Các thứ phiền não sinh tử như tham, sân, si... trói buộc chúng sinh không được tự tại, cũng như lưới rập trói buộc người, cho nên gọi là Sinh tử phược.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Sự Đại", "definition": "Sống chết việc lớn. Nghĩa là vấn đề sinh tử rất là trọng Đại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Trường Dạ", "definition": "Đêm dài sống chết.Nghĩa là chúng sinh chìm đắm trong cái khổ sinh tử như đêm dài tối tăm. Sinh tử như giấc mộng, đang còn trong mộng thì không biết đó là mộng, đến khi tỉnh dậy mới nhớ lại những cảnh trong mộng là hư ảo.Chúng Sinh luân hồi trong sinh tử cũng như giấc mộng, cho nên dùng đêm dài để ví dụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Tức Niết Bàn", "definition": "Sinh tử và Niết Bàn tương tức không hai.Sinh tử là quả khổ của cõi mê, Niết Bàn là quả chứng của cõi ngộ. Nhóm từ này thường đi đôi với nhóm từ “Phiền não tức Bồ Đề”, trực tiếp chỉ cho giáo nghĩa của Phật Giáo Đại Thừa. Duy có điều đối với nghĩa của chữ “Tức” thì các giáo phái nói mỗi khác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Uyên", "definition": "Vực sống chết. Vì sinh tử khiến cho người ta chìm đắm nên dùng cái vực để ví dụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Viên", "definition": "Khu vườn sống chết. Cõi sinh tử là nơi phàm phu thích dạo chơi, cũng là chỗ Bồ Tát du hóa, giống như 1 khu vườn, cho nên gọi là Sinh Tử Viên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Tử Vân", "definition": "Mây sống chết. Mây được dùng để ví dụ sự tối tăm của sinh tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Viên", "definition": "生員. Người học trò theo học bậc cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Vô Sắc", "definition": "Đối lại:Định Vô Sắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Vật", "definition": "生物. Chỉ chung những vật có sự sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Vật Học", "definition": "生物學. Ngành nghiên cứu về mọi vật có sự sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Xỉ", "definition": "生齒. Mọc răng (nói về trẻ con) Cũng chỉ dân số gia tăng. Td: Sinh xỉ nhật phồn (số người sinh sôi nảy nở ngày một nhiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Xứ Tháp", "definition": "Ngôi tháp ở trong vườn Lâm Tì Ni (Phạm: Lumbinì), nơi Đức Phật giáng sinh, 1 trong 8 tòa linh tháp của Ấn Độ. (xt. Bát Đại Linh Tháp).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Y", "definition": "生依 upādi", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Sinh Điền", "definition": "Ruộng sinh tử. Chỉ cho 3 cõi: Dục, Sắc và Vô Sắc. Tức chúng sinh sống chết vòng quanh trong 3 cõi, như cây lúa cấy rồi gặt, gặt xong lại cấy, quay vòng không dứt. Nam Hải Kí Qui Nội Pháp Truyện quyển 2 (Đại 54, 215 thượng) nói: “Loài chúng sinh coi việc ăn mặc là quan trọng nhất, nó như gông cùm, khống chế cả sinh điền”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Đắc Thiện", "definition": "Đối lại: Gia Hành Thiện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Đắc Tuệ", "definition": "Chỉ cho trí tuệ có được cùng 1 lượt khi sinh ra, là 1 trong 4 tuệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Đắc Định", "definition": "Đối lại: Tu Đắc Định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sinh Địa", "definition": "生地. Vùng đất sống (trái với Tử địa) Vùng đất hoang, chưa khai khẩn Tên một vị thuốc bắc, tức củ của cây Địa hoàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Đồ", "definition": "生徒. Người học trò Đời Lê, người thi đậu kì thi Hương, gọi là Sinh đồ, tới đời Nguyễn mới gọi là Tú tài (đậu khoa thi Hương, nhưng ở dưới bậc Cử nhân, không được làm quan). Ca dao có câu: “Kinh đô cũng có người rồ, Man di cũng có Sinh đồ Trạng nguyên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinh Động", "definition": "生動. Có sự sống, không im lìm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sinister", "definition": "Điều xấu, độc ác, đầy sát khí", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Siêm", "definition": "怗. Xem Siêm sế 怗懘 Một âm khác là Thiếp. Xem Thiếp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêm Sế", "definition": "怗懘. Vẻ bất hòa Âm thanh không hợp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siên", "definition": "梴. Cây gỗ dài Vẻ dài của thân cây, cành cây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêng Năng", "definition": "Vāyamati (vi + a+ yam + a), īhā (nữ), payatana (trung), parakkama (nam), ussāha (nam), ussuka (tính từ), ussukka (trung), ussahati (u + sah +a), ussukkati (u + suk + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Siêu", "definition": "弨. Cây cung Cánh cung bật thẳng ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Bát Đề Hồ", "definition": "Tiếng dùng của Tông Thiên Thai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Bạt", "definition": "超拔. Vượt hẳn xung quanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Bảo", "definition": "Siêu Bảo (1635-1709)", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Chứng", "definition": "超 證. Vượt khỏi giai vị thứ tự thông thường, trực tiếp lãnh ngộ. Tiết Nghệ Ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Chứng Đại Sư", "definition": "超 證 大 師. Hiệu của Thiền tăng Tùng Yểm đời Ngũ Đại. X. Tùng Yểm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Cách", "definition": "超格. Vượt khỏi lệ thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Dật", "definition": "超逸. Thanh cao, vượt khỏi sự tầm thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Giác Đại Sư", "definition": "超覺 大 師. Thụy hiệu của Thiền tăng Huệ Lăng đời Ngũ Đại. X. Huệ Lăng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Giới", "definition": "Vikramaśīla (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Giới Tự", "definition": "Phạm: Vikramazìla.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Huyện", "definition": "Siêu Loại nổi tiếng vì ở đây vào thời Sĩ Nhiếp, có thành Luy Lâu là một trung tâm Phật giáo rất lớn không những của Giao Châu, mà của cả châu Á [tr.599] (Đông Á). Trong huyện, tập trung nhiều chùa lớn, đến nay vẫn còn. (Vd, các chùa Pháp Vân, chùa Bút Tháp v…) Siêu Loại là sinh quán của Ỷ Lan phu nhân, vợ vua Lý Thánh Tôn, mẹ Lý Nhân Tôn. Bà Ỷ Lan, do lòng sùng đạo Phật và nếp sống nhân hậu, được nhân dân thời bấy giờ tôn gọi là Quan Âm nữ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Siêu Hình", "definition": "超形. Vượt lên trên hình thể thông thường, không còn hình thể nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Loại", "definition": "超類. Vượt lên trên thứ cùng loài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Luân", "definition": "超倫. Như Siêu loại 超類.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Nghệ", "definition": "超 詣. Trình độ rất cao. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Ngộ", "definition": "超 悟. Vượt khỏi giai vị thứ lớp thông thường, trực tiếp lãnh ngộ. Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Nhiên", "definition": "Lokottara (S), Supramandane Lokuttara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Nhân", "definition": "Uttari-manussa (P), Superman.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Nhân Loại", "definition": "超人類. Vượt khỏi loài người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Nhạc", "definition": "超 樂 (1642-1702). Thiền tăng đời Thanh, họ Trần, người Hải Diêm (nay thuộc Chiết Giang) Trung Quốc. Sư nối pháp thiền sư Thiết Chu Hành Hải, làm truyền nhân tông Lâm Tế, trụ trì chùa Giang Thiên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Nhật Vương", "definition": "Vikramāditya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Phàm", "definition": "超凡. Vượt lên trên sự tầm thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Phương", "definition": "超 方. 1. Vượt ngoài phép tắc thông thường, phần lớn chỉ cho tầm nhìn, lòng can đảm và trí hiểu biết của bậc triệt ngộ. Như Tịnh Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Phật Việt Tổ", "definition": "Cũng gọi Sát tổ sát Phật. Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Quá", "definition": "超過. Vượt qua Quá mức thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Quần", "definition": "超羣. Vượt khỏi những người xung quanh. “Thật là xuất ngoại siêu quần chẳng qua” (Hoa điểu tranh năng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Quốc Gia", "definition": "超國家. Vượt lên trên ý niệm quốc gia. Nói về chủ nghĩa không phân biệt quốc gia nữa Ngày nay còn chỉ quốc gia cực lớn mạnh, văn minh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Quỹ", "definition": "超 揆. Pháp danh của Thiền tăng Văn Quả đời Thanh. X. Văn Quả.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Sinh", "definition": "超生. Tiếng là Phật, chỉ sự vượt ra được khỏi vòng sống chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Sinh Tịnh Độ", "definition": "Tịnh độ là cõi Phật, cõi đất trong sạch. Tuy rằng trong vũ trụ có nhiều cõi Phật, nhưng cõi Phật được sách Phật nói đến nhiều nhất là cõi Cực Lạc phương Tây của đức Phật A Di Đà. Ở Trung Hoa và Nhật Bản, một tông phái Phật giáo thịnh hành nhất là tông Tịnh Độ, phép tu căn bản là niệm danh hiệu Phật A Di Đà, để cầu được sau khi chết vãng sinh về cõi Cực Lạc của Phật A Di Đà (x. A Di Đà). Cầu siêu sinh Tịnh Độ là cầu vãng sinh về cõi Cực Lạc của Phật A Di Đà. Ở Việt Nam, gia đình có người chết, thường mời các nhà sư đến niệm Phật, tụng Kinh “A Di Đà” để cầu cho người chết được siêu sinh Tịnh Độ. “Nhờ phép Phật siêu sinh Tịnh Độ.” (Nam Hải Quan Thế Âm) “Lôi thôi bồng trẻ dắt già, Có khôn thiêng nhẽ, lại mà nghe kinh, Nhờ phép Phật siêu sinh Tịnh độ.” (Vô danh) Siêu Thăng Vượt khỏi, lên cao. “Siêu thăng thoát cả một nhà.” (Quan Âm Thị Kính) “Chí lớn nên Phật tổ siêu thăng, Lòng nguyện độ chúng sinh trầm nịch.” (Chân Nguyên – Thiền Tịch Phú) Siêu Thế Siêu việt thế gian, thế tục.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Siêu Siêu", "definition": "怊怊. Bốn bề mênh mông xa tít.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Thiên", "definition": "超遷. Làm quan mà thăng lên cấp rất mau, dời đổi chức vụ mỗi lúc một cao. Như Siêu thăng 超升.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Thoát", "definition": "超脫. Vượt ra khỏi, không còn bị ràng buộc gì nữa Ta còn hiểu là vượt ra khỏi mọi ràng buộc ở đời. Chỉ sự ẩn Tiếng nhà Phật, có nghĩa là vượt ra ngoài vòng sinh tử luân hồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Thăng", "definition": "超升. Bay bổng lên trời. Tiếng của đạo sĩ Tiếng nhà Phật, chỉ linh hồn người chết được giải thoát Làm quan mà được lên cấp rất mau, vượt hẳn những người đồng cấp trước kia. Truyện Hoa Tiên có câu: “Buồm quan một lá giòng sâu, siêu thăng thoắt đã đứng đầu Nam nha”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Thường", "definition": "超常. Như Siêu phàm 超凡.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Thần", "definition": "Atidesa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Thế", "definition": "Lokuttara (P), Supramundane.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Thế Gian Trí", "definition": "Jñānam-laukottarataman (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Thế Gian Tán", "definition": "Lokatitastava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Thế Nguyên", "definition": "Chỉ cho 48 nguyện của Đức Phật A Di Đà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Thế Pháp", "definition": "Lokuttara dhammas (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Thế Trí", "definition": "Lokuttara citta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Thế Đạo", "definition": "Lokuttaramagga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siêu Tich", "definition": "超迹. Vượt ra khỏi dấu vết tầm thường Cũng chỉ sự ở ẩn, không còn thấy mặt ở đời nữa. Cũng như: Tuyệt tích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Trác", "definition": "超卓. Như Siêu tuyệt 超絶.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Trí", "definition": "超 智 (1610-1674). Thiền tăng đời Thanh, họ Hồ, hiệu Kỳ Nhiên, người Thành Đô, Trung Quốc. Xuất gia lúc 9 tuổi tại chùa Trung Phong, sư từng tham kiến các bậc tôn túc: Chúc Gia Am ấn Tâm, Thiên Đồng Mật Vân Viên Ngộ, Phá Sơn Hải Minh, Tượng Nhai Tính Diên v. v… Sau yết kiến Lộc Môn núi Sơn Đãng đắc pháp làm truyền nhân tông Lâm Tế. Lần lượt trụ trì các chùa Linh Huệ, Song Trì, Bạch Thủy, Hoàng Long. Tác phẩm có: Kỳ Nhiên Trí Thiền Sư Ngữ Lục 2 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Trướng", "definition": "怊悵. Buồn giận trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Trần", "definition": "超塵. Vượt ra khỏi bụi bặm. Như Siêu thoát 超脫 Vượt hẳn lên trên người đời. Cũng như Tuyệt trần 絶塵.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Tuyệt", "definition": "超絶. Vượt cao hẳn lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Tình Ly Kiến", "definition": "超 情 離 見. Vượt khỏi tình thức, thoát ly tri kiến. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Tông", "definition": "超 宗. Hiệu của Thiền tăng Huệ Phương đời Tống. X. Huệ Phương.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Tông Dị Mục", "definition": "超 宗 異 目. Pháp nhãn phi thường, vượt khỏi khuôn phép của tông môn. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Tông Nhãn", "definition": "超 宗 眼. Pháp nhãn vượt khỏi cách thức thông thường của Tông môn. Tiết Tông Thừa Yếu Nghĩa trong Duy Tắc Ngữ Lục q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Tông Việt Cách", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Tục", "definition": "超俗. Vượt lên trên khỏi sự tầm thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Tự Nhiên", "definition": "超自然. Vượt ra ngoài cả tự nhiên (surnaturel).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Việt", "definition": "超越. Vượt cao hẳn lên trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Việt Chứng", "definition": "Cũng gọi Siêu Chứng, Siêu Quả. Đối lại: Thứ Đệ Chứng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Việt Sinh Tử", "definition": "超 越 生 死. Đạo Phật cho rằng chúng sinh hữu tình đều ở trong biển khổ luân hồi sinh tử. Nhà thiền đem việc thoát khỏi sinh tử một cách triệt để làm mục đích tu tập và gọi đó là “siêu việt sinh tử”. Tiết Hòa Sơn Huệ Phương Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Siêu Việt Tam Muội", "definition": "Chỉ cho tam muội mà Phật và Bồ Tát chứng nhập, có năng lực vượt qua các cõi trên dưới và tùy ý xuất nhập. Đây là cảnh giới cao nhất trong các loại Quán Thiền, Luyện Thiền, Huân Thiền và Tu Thiền do Tông Thiên Thai nói, vì thế nên gọi là Đính thiền. Trong các pháp môn, Tam Muội này có năng lực xuất nhập tự tại, cho nên được gọi là Tự tại định, hoặc gọi là Siêu thiền, Siêu việt thiền, Siêu việt đẳng chí... Về thứ lớp cạn, sâu của thiền định được sắp xếp là: Tứ Thiền, Tứ Vô Sắc, và Diệt Tận Định. Phàm khi xuất, nhập thiền định đều phải tuần tự theo thứ lớp này, đó là phép tắc chung. Như người tâm tán loạn không thể trực tiếp nhập định Tứ Vô Sắc, mà trước phải nhập định Sơ Thiền, rồi tuần tự vào Đệ Tứ Thiền, sau đó mới vào định đầu tiên của Tứ Vô Sắc. Cũng thế, khi xuất định cũng không được xuất trực tiếp, mà phải tuần tự theo thứ lớp ngược mà xuất. Đây là pháp của Thanh Văn. Nhưng đối với Phật và Bồ Tát đã tu chứng đến địa vị cao sâu thì không phải theo thứ tự xuất, nhập này, mà có thể từ tâm tán loạn vượt ngay vào định Diệt Tận và, ngược lại, cũng có thể từ Diệt Tận Định vượt ngay ra tâm tán loạn. Pháp tam muội siêu nhập, siêu xuất này, gọi là Siêu Việt Tam Muội.[X. Luận Đại Trí Độ Q.81].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Vĩnh", "definition": "(?-?).Cao tăng Trung Quốc thuộc Tông Lâm Tế, sống vào cuối đời Minh, người Huề lí, tỉnh Chiết Giang, họ Diêu, hiệu Tễ Luân. Thủa nhỏ, sư theo Nho Học, lớn lên, gặp lúc binh biến vào cuối những năm Sùng Trinh, mấy lần chết đi sống lại nên sư lạnh nhạt với công danh, đến khi được đọc Kim Túc Dung Ngữ Lục thì sư lập chí xuất tục. Mùa hạ năm Thuận Trị thứ 7 (1650), sư lễ ngài Thâm Vân Quả ở Gia Hưng xin xuất gia. Mùa thu năm ấy sư tham yết ngài Bách Ngu Tịnh Tư, sau đó, sư lần lượt đi tham bái các danh lam thắng tích như núi Thiên Đồng, chùa Báo Ân, chùa Kim Túc, Kính Sơn... Mùa xuân năm Thuận Trị thứ 9 (1652), sư tham vấn ngài An Điền Tĩnh ở Phúc Nguyên và được ấn khả. Sau, sư trụ ở chùa Thánh cảm tại Tây Sơn, Bắc Kinh, sau đó, sư lần lượt đi hoằng hóa tại các vùng Bình Hồ thuộc Chiết Giang Thượng Hải, Gia Hưng, Thiểm Tây...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Đao", "definition": "超刀. Cây đao quý, vượt hẳn các cây đao tầm thường Chỉ cây Long đao của Quan Trường, danh tướng thời Tam Quốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Đẳng", "definition": "超等. Vượt lên trên bậc thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siêu Định", "definition": "Vượt qua giai đoạn trung gian mà vào 1 thứ thiền định cao hơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Siêu Độ", "definition": "超度. Vượt quá mức thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siếp", "definition": "霎. Mưa nhỏ Tiếng mưa tí tách Khoảnh khắc. Thời gian rất ngắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siếp Siếp", "definition": "霎霎. Tí tách. Tiếng nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siếu", "definition": "捎. Đánh nhẹ. Vỗ nhẹ Đem vật gì tới tặng biếu người nào Các âm khác là Sao, Tiêu. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siểm", "definition": "㚒. Trộm cắp vật gì. Cũng đọc Thiểm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siểm Khúc", "definition": "Vanka (S), Kuhana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Siểm Kiêu", "definition": "諂驕. Nói tắt của thành ngữ Siểm thượng kiêu hạ, nghĩa là nịnh hót với người trên và lên mặt với kẻ dưới, chỉ tư cách xấu xa của kẻ tiểu nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siểm Mị", "definition": "諂媚. Nịnh hót người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siểm Nịnh", "definition": "諂佞. Như Siểm mị 諂媚.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siểm Tiếu", "definition": "諂笑. Cười nịnh người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siểm Trá", "definition": "諂詐. Giả dối để nịnh hót người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siển", "definition": "嘽. Nói chậm Một âm là Than. Xem Than.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siển Hoãn", "definition": "嘽緩. Thong thả. Chậm chạp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siệp", "definition": "詀. Nói nhỏ. Nói thầm Các âm khác là Chiêm, Điêm. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Siệp Nhiếp", "definition": "詀讘. Kề tai nói thầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Skew", "definition": "Nghiêng, xiên, lệch", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Skittish", "definition": "Bất kham, khó điều khiển", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slander", "definition": "Vu khống, vu cáo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slant", "definition": "Xiên, nghiêng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slate", "definition": "Đá phiến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sleuth", "definition": "Chó săn đánh hơi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slipshod", "definition": "Bất cẩn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slit", "definition": "Đường vạch, khe hở", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sliver", "definition": "Mảnh vụn, mảnh bom, mảnh đạn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slough", "definition": "Vũng bùn, đầm lầy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slovenliness", "definition": "Tính lười biếng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sluggish", "definition": "Chậm chạp, không nhanh nhẹn, không hoạt bát", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sluice", "definition": "Cửa cống, lượng nước ở cửa cống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slumbering", "definition": "Ngủ say", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Slut", "definition": "Người đàn bà bẩn thỉu, dâm đảng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Smack", "definition": "Vị thoang thoảng, mùi dìu dịu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Smugly", "definition": "Thiển cận tự mãn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Snatch", "definition": "Vồ lấy, nắm lấy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Snifter", "definition": "Hớp rượu, cốc nhỏ để uống rượu mạnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Snippet", "definition": "Mảnh vụn cắt ra", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Snobbery", "definition": "Tính trưởng giả, học làm sang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Snobbish", "definition": "Kẻ hợm hỉnh, có thái độ trưởng giả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "So Lường", "definition": "Reckon or fathom", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "So Sánh", "definition": "Nidassana (trung), samāneti (saṃ + ā + ni + a), tuleti (tul + e), upameti (upa + mā + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Soa", "definition": "蓑. Cái áo tơi để che mưa thời xưa, làm bằng lá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soa Y", "definition": "蓑衣. Áo tơi. Td: Soa y nhược lạp (áo tơi nón lá, vật dụng của nhà nông thời xưa để che mưa nắng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soan", "definition": "閂. Thanh gỗ ngang để cài cửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soang", "definition": "肛. Hậu môn (Lỗ đít, anus). Cũng đọc Cang, hoặc Giang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soang Môn", "definition": "肛門. Lỗ đít. Như: Hậu môn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sober", "definition": "Điều độ, đúng mức, không say sưa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sobhaṇakaranadhamma", "definition": "Hai pháp làm xinh đẹp.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sobhita", "definition": "Sobhita (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sodomy", "definition": "Sự giao hợp giữa đàn ông với nhau", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Soi", "definition": "Abhitudati (abhi + tud + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Soi Lỗ", "definition": "Chiddita (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Soi Sáng", "definition": "Obhāseti (ava + bhāṣ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sojourn", "definition": "Tạm trú, lưu lại tạm thời", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Solace", "definition": "Console = relief = an ủi, khuây khoả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Solstice", "definition": "Điểm tương ứng mặt trời ở xa xích đạo (Điểm tương ứng xuân,", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Some time after her son Rahula became a novice monk, Yasodhara also entered the Order of Monks and Nuns and within time attained Arahantship. She was ordained as Bhikkhuni included among the five hundred ladies following Mahapajapati Gotami to establish Bhikkhuni Order. She died at 78, two years before Buddha's Parinibbana or Parinirvana…", "definition": "Công Chúa Da-Du Đà-La - Yasodhara", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Somnambulistic", "definition": "Sleep-walk = mộng du", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sona Thera", "definition": "Tên một vị tỳ khưu ni. Bị con cái ruồng bỏ Sona vào chùa tu và đắc quả.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Song", "definition": "双. Lối viết giản dị của chữ Song 雙.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Bào", "definition": "雙胞. Đẻ sinh đôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Diệp Cơ", "definition": "雙葉機. Loại máy bay có hai lớp cánh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Hành", "definition": "雙行. Đi đôi với nhau, ngang nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Hồ", "definition": "窗糊. Cửa sổ có dán giấy thời xưa. Đoạn trường tân thanh có câu: “Song hồ nửa khép cánh mây”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Hồn", "definition": "雙魂. Nấm mồ chôn chung hai vợ chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Kiếm", "definition": "雙劍. Một cặp gươm. Hai thanh gươm giống nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Linh", "definition": "葱靈. Tên một loại xe nhỏ, nhẹ, có mui thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Loan", "definition": "雙鸞. Cái kiệu do hai người khiêng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Luận", "definition": "Yamaka (P), Book of Pairs.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Song Lập", "definition": "雙立. Đứng thành một đôi một cặp liền nhau. Td: Biệt thự song lập.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Mã", "definition": "雙馬. Một cặp ngựa Xe do hai ngựa kéo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Nhãn Kính", "definition": "雙眼鏡. Kính có hai tròng mắt, tức cái ống nhòm, dùng để nhìn rõ vật ở xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Nhập", "definition": "Yuganaddha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Song Nhập Thứ Đệ", "definition": "Yuganaddha-krama (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Song Phi", "definition": "雙飛. Chim bay thành cặp Chỉ thế đá cả hai chân một lượt Bày ra thành hai hàng. Đoạn trường tân thanh có câu: “Quân trung gươm lớn dáo dài, vệ trong thị lập cơ ngoài song phi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Phong Tự", "definition": "雙 峰 寺. ở dưới núi Song Phong, phía tây huyện Nhũ Nguyên (khu tự trị dân tộc Dao), tỉnh Quảng Đông, Trung Quốc. Còn gọi “Hưng Phúc Viện”. Khoảng niên hiệu Thái Bình Hưng Quốc (976-983) đời Tống, Thiền Sư Cánh Khâm (Huệ Chân Quảng Ngộ) sáng lập. Sau được ban cho tấm biển “Song Phong Sơn Hưng Phúc Thiền Tự”. Niên hiệu Nguyên Hựu thứ 2 (1087) Lương Thành trung tu. Đầu những năm Hồng Vũ (1368-1398) đời Minh, Liễu Yết xây cất lại. Niên hiệu Thành Hóa thứ 5 (1469) Tổ Quan Thủ Giới trùng tu. Niên hiệu Chính Đức thứ 1 (1506) Thái Tiến trùng tu. Niên hiệu Gia Tỉnh thứ 22 (1543) Trinh Khải trùng tu. Niên hiệu Khang Hy thứ 22 (1683) đời Thanh trùng tu một lần nữa.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Song Phương", "definition": "雙方. Hai mặt. Hai phía Có cả hai bên cùng thoả thuận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Quan", "definition": "Là một phương pháp hành văn, nói hay viết một câu gồm có hai ý trái ngược nhau, như: không sinh không diệt; không đến không đi; không trái không phải; cũng có cũng không; cũng tốt cũng xấu; v.v..., rất thường thấy trong các kinh luận đại thừa. Trong quyển Từ Điển Hán Việt Hiện Đại do Nguyễn Kim Thản chủ biên, từ “song quan” này được giải nghĩa là “chơi chữ”, không đúng lắm. Chơi chữ là nói một chữ mà hàm hai hoặc nhiều ý nghĩa, ai muốn hiểu sao cũng được. Ví dụ câu nói: “Anh ăn kẹo nhiều quá!”. Trong câu nói này có chữ “kẹo”, có nghĩa là viên kẹo, mà cũng có nghĩa là keo kiệt. Cho nên, thay vì nói thẳng là “Anh keo kiệt quá!”, thì lại nói “xéo” đi: “Anh ăn kẹo nhiều quá!”; đó gọi là “chơi chữ”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Song Quyển Kinh", "definition": "Cũng gọi Lưỡng Quyển Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Song Sa", "definition": "窗紗. Cửa sổ che lụa mỏng. Chỉ phòng đàn bà con gái. Đoạn trường tân thanh có câu: “Song sa vò võ phương trời, nay hoàng hôn đã lại mai hôn hoàng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Sinh", "definition": "雙生. Đẻ sinh đôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Song", "definition": "雙雙. Đi sóng đôi Sóng đôi với nhau. Đoạn trường tân thanh có câu: “Vừng trăng vằng vặc giữa trời, đinh ninh hai miệng một lời song song”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Sí", "definition": "雙翅. Loài côn trùng có hai cánh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Thai", "definition": "雙胎. Đẻ sinh đôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Tháp Tự", "definition": "Chùa ở góc đông nam nội thành huyện Ngô, tỉnh Giang Tô, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Song Thân", "definition": "雙親. Hai người sinh ra mình, tức cha mẹ. Đoạn trường tân thanh có câu: “Rồi sau sinh sự thế nào, truy nguyên chẳng khỏi luỵ vào song thân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Thê", "definition": "雙棲. Chim trống chim mái đậu thành cặp. Chỉ vợ chồng khắng khít không rời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Thất", "definition": "雙七. Ngày mồng 7 tháng 7 âm lịch, tương truyền là ngày hàng năm Ngưu Lang và Chức Nữ được gặp nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Thất Lục Bát", "definition": "雙七六八. Tên một thể văn vần của Việt Nam, cứ hai câu 7 chữ lại tới một câu 6 chữ, rồi một câu 8 chữ. Thể này còn gọi là thể Ngâm, các Ngâm khúc đều viết theo thể này (Bản dịch Chinh phụ ngâm khúc, Cung oán ngâm khúc).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Thập", "definition": "雙十. Ngày 10 tháng 10, kỉ niệm cách mệnh Trung Hoa, khai sáng nền Trung Hoa Dân quốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Tiễn Tề Xuyên", "definition": "雙箭齊穿. Bắn một phát mà cả hai mủi tên cùng cắm vào đích. Ý nói một công đôi việc, nhất cử lưỡng tiện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Toàn", "definition": "雙全. Trọn vẹn cả hai bên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Trì", "definition": "Yugarjidhara (S), Yugaṃdhara (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Song Tuyền Sư Khoan", "definition": "(雙泉師寛, Sōsen Shikan, ?-?): nhân vật sống vào thời nhà Tống, vị tăng của Vân Môn Tông. Ông kế thừa dòng pháp của Vân Môn Văn Yển (雲門文 偃), rồi đến sống tại Song Tuyền Tự (雙泉寺) thuộc Tùy Châu (隨州, Tỉnh Hồ Bắc). Ông được ban cho hiệu là Minh Giáo Thiền Sư (明教禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Song Tâm", "definition": "雙心. Chỉ cây súng hai lòng. Văn tế sĩ dân lục tỉnh của Nguyễn Đình Chiểu có câu: “Các bậc sĩ nông công cổ, liều mang tai với súng song tâm”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song song với chính điện là điện Văn Thù, được xây cất vào năm Thiên hội 15 (1137) đời Kim, cũng là 1 kiến trúc rất xưa. Bên ngoài chính điện có 1 cột đá được khắc chạm rất tinh vi, trên khắc mấy chữ “Đường Đại Trung thập nhất niên” (Năm Đại Trung 11 đời Đường). Ngoài ra còn có những di vật văn hóa quí giá chạm trỗ trên đá rất đẹp đẽtỉ mỉ như tháp mộ, thạch kinh chàng…... Tượng Phật trong chính điện là tác phẩm đời Đường, tuy đã trải qua nhiều đời được sửa sang lại, màu sắc không còn được như cũ, nhưng tạo hình thì vẫn còn giữ được phong cách đời Đường, có thể sánh ngang với những tượng được đắp vào đời Đường ở Đôn Hoàng.", "definition": "II.Phật Quang Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Song Đao", "definition": "雙刀. Một cặp dao. Hai cây đao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Đăng", "definition": "雙登. Hai anh em cùng đậu trong một khoa thi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Đường", "definition": "雙堂. Chỉ cha và mẹ (Thông đường và Huyền đường).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Song Ẩm", "definition": "雙飲. Hai người ngồi uống trà, uống rượu với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sonority", "definition": "Âm thanh kêu vang; gây ấn tượng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sop", "definition": "Mẫu bánh mì cho vào súp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sophisticated", "definition": "Tinh vi, phức tạp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sorata", "definition": "Sorata (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sotapanna", "definition": "Tu đà huờn, nhập lưu: đắc quả thánh thứ nhất, kinh nghiệm Niết bàn lần đầu tiên, dứt trừ ba dây trói buộc: thân kiến, hoài nghi, giới cấm thủ. Vì các phiền não đã yếu nên vị tu đà huờn không bị tái sinh vào bốn cõi dữ. Còn gọi là thất lai vì vị tu đà huờn chỉ còn tái sinh tối đa bẩy kiếp.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sotāpanna", "definition": "Ba bậc Dự lưu, ba hạng Thánh Tu-đà-huờn", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Soul", "definition": "Self-consciousness (Our entire essence = toàn thể bản chất chúng ta) The spiritual part of humans as distinct from the physical part.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Soái", "definition": "嘬. Cắn. Dùng răng mà cắn Vẻ dữ dội, mạnh mẽ Ta có người đọc Toát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soái Binh", "definition": "嘬兵. Đem quân nổi dậy mạnh mẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soán", "definition": "篡. Làm phản mà cướp đoạt. Cũng đọc Thoán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soán Nghịch", "definition": "篡逆. Làm phản mà cướp ngôi vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soán Vị", "definition": "篡位. Làm phản mà cướp ngôi vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soán Đoạt", "definition": "篡奪. Cướp lấy. Thường dùng đề chỉ hành động làm phản cướp ngôi vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soát", "definition": "選. Kim soát 金選: Danh từ đo trọng lượng vàng bạc thời cổ, có nghĩa là nặng hơn nửa lạng Các âm khác Toán, Tuyến, Tuyển. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soḷasañāṇa", "definition": "Mười sáu trí, hay tuệ Minh Sát (Vipassanāñāṇa)", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Soạn", "definition": "僎. Bày biện cho đủ. Dọn ra đầy đủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Giả", "definition": "撰者. Người viết ra một bài văn, một cuốn sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Hiệu", "definition": "Tên họ của người soạn thuật được ghi ở đầu sách Phật; ngoài tên họ ra còn ghi địa danh, tên chùa. Có khi chính mình ghi, cũng có khi do người khác ghi.Nói một cách đại khái, những sách do Ấn Độ thì ghi tên họ hoặc pháp danh trước chữ “tạo” hoặc chữ “thư”; các sách do Trung Quốc soạn thì ghi tên họ hoặc pháp danh trước chữ “thuật”, chữ “tập”, chữ “soạn”. Thuật, tập, soạn là truyền thuật lại thuyết của người xưa, chứ không phải mình sáng tác, cũng không thêm ý mới.Nếu do thầy thuyết giảng, do đệ tử ghi thuật lại, cũng gọi là Soạn Hiệu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Soạn Kịch", "definition": "撰劇. Đặt ra, viết ra một tuồng hát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Lục", "definition": "撰錄. Góp nhặt biên chép.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Thuật", "definition": "撰述. Viết thành sách. Như: Trước thuật 著述, Trước tác 著作.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Thảo", "definition": "Ganthana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Soạn Tu", "definition": "撰修. Sửa chữa biên chép lại một cuốn sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Tập", "definition": "撰集. Gom góp tài liệu mà viết thành cuốn sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạn Định", "definition": "撰定. Sắp đặt các tài liệu để làm thành cuốn sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Soạt", "definition": "䥷. Con dao lớn có cán dài dùng để phạt cỏ. Dao phạt cỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Spate", "definition": "Sự dồn lên nhanh, đột ngột", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spatiotemporal", "definition": "Have both spatial (không gian ) and temporal (thời gian) qualities", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spatula", "definition": "Dao bay để trộn hồ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spectrographic", "definition": "Máy chụp hình quang phổ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spellbind", "definition": "Làm mê đi như bị bỏ bùa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spew", "definition": "Nôn mửa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spiel", "definition": "Bài diễn văn, bài thanh minh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spigot", "definition": "Nút thùng rượu, đầu vòi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spindle", "definition": "Mọc thẳng lên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spirit", "definition": "Is the ethereal counterpart of the physical body", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spitefulness", "definition": "Tính hằn học, đầy thù hận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spittle", "definition": "Saliva = nước bọt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Splinter", "definition": "Mảnh vụn của gỗ, đá", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Splotch", "definition": "Vết bẩn; dấu của mực, sơn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spontaneity", "definition": "Tính chất tự phát, tự sinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spontaneous", "definition": "Proceeding from natural feeling = tự ý, tự phát", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sporadic", "definition": "Scattered, irregular = rời rạc, lác đác; không thường xuyên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sprawl", "definition": "Nằm ườn ra, tư thế uể oải", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spurious", "definition": "Sai, không xác thực, giả mạo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Spurn", "definition": "Bát bỏ, từ chối, hất hủi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squabble", "definition": "Cãi nhau ầm ỉ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squall", "definition": "Cơn gió mạnh đột ngột, cơn bão bất ngờ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squalor", "definition": "State of being filthy = bẩn thỉu, dơ dái, tục tĩu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squander", "definition": "Lãng phí (tiền của, thì giờ)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squeaky", "definition": "Chuột kêu chít chít, tiếng cọt kẹt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squeal", "definition": "Tiếng kêu ré lên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squeamish", "definition": "Dễ phẫn nộ, dễ buồn bực", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squelch", "definition": "Sự giẫm nát", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squiggly", "definition": "Chữ nguệch ngoạc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Squirm", "definition": "Đi ngoằn ngoèo, bò ngoằn ngoèo (rắn)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sramana", "definition": "Wanderer = kẻ lang thang", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Staff", "definition": "Gậy, ba toong", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Staggar", "definition": "Bước lảo đảo, loạng choạng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Staggering", "definition": "Gây sửng sốt, làm kinh ngạc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stalwart", "definition": "Người khỏe mạnh, người vạm vở", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stamina", "definition": "Sự chịu đựng, khả năng chịu đựng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stance", "definition": "Tư thế, thế đứng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stanza", "definition": "Division of poem", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stargazing", "definition": "Ngắm trăng sao, chiêm tinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Starker", "definition": "Khoả thân", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stash", "definition": "Giấu, cất, để nơi an toàn", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Status quo", "definition": "Nguyên trạng, hiện trạng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Staunch", "definition": "Strongly built, faithful = vững chắc, kín mít, tốt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stave", "definition": "Gỗ cong để đóng thuyền", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Steadfast", "definition": "Kiên định, không giao động (steady = vững chắc)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Steeplechaser", "definition": "Người cỡi ngựa đua vượt rào", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stela", "definition": "Tấm bia", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stellar", "definition": "Thuộc về tinh tú", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stemming", "definition": "Nhồi, nhét cho đầy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Steppe", "definition": "Vùng thảo nguyên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stereotypical", "definition": "Bản in, khuôn mẫu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stern", "definition": "Nghiêm nghị", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sternum", "definition": "Xương ức", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stifling", "definition": "Ngột ngạt khó thở", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stigma", "definition": "Điều sỉ nhục, vết nhơ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stipulation", "definition": "Điều quy định, điều kiện", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stoicism", "definition": "Chủ nghiã chấp nhận nghịch cảnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stolid", "definition": "Dửng dưng, lảnh đạm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stout", "definition": "Quả quyết, dũng cảm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Straddle", "definition": "Giang chân, tư thế cưỡi ngựa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Strafe", "definition": "To rake with fire at close range (Army troops) = sự bắn phá, oanh tạc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Straggle", "definition": "Đi không theo hàng lối", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Strand", "definition": "Bờ biển, bờ sông", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stratagem", "definition": "Mưu mẹo, mưu kế để lừa ai", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stratification", "definition": "Các tầng trong địa chất", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stream-enter", "definition": "Person who joins the Sangha on the spot - nhập dòng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Strenuously", "definition": "Tích cực, hăng hái", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Strident", "definition": "Giọng nói lanh lảnh, chói tai", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Strife", "definition": "Xung đột, bất hòa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stringent", "definition": "Nghiêm ngặt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stumble", "definition": "Vấp, trượt chân", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stunned", "definition": "Bị sửng sốt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stupefy", "definition": "Làm cho ngớ ngẩn, u mê đần độn; Stupefaction - tình trạng u mê", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stupendous", "definition": "Lạ lùng, kỳ diệu", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stupor", "definition": "Sự ngẩn ngơ, trạng thái kinh ngạc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Stuttering", "definition": "Nói lắp bắp", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Su", "definition": "毹. Tấm thảm trải trên đất. Cũng gọi là Cù su 氍毹.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suavity", "definition": "Tính khéo léo, tính ngọt ngào", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subconscious", "definition": "Existing in the mind, but not immediately available to cons- ciousness…the mental activities just below the threshold of consciousness (thần thức, A-laị-da thức).", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subconscious Images", "definition": "From the metaphysical (siêu hình) perspective, the subconscious mind is the seat of memory. Everything we have experienced in life is recorded in the subconscious. It is like the vast hard drive on a computer that record not only experiences and memories, but patterns of behavior as well. It also has recorded experiences of past life as we carry the same subconscious mind from incarnation to incarnation.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subconscious mind", "definition": "Forms the bridge between the conscious and supercon- (tiềm thức) cious mind (Siêu thức)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subhadda", "definition": "Một tu sĩ ngoại đạo trở thành người học trò cuối cùng của Đức Phật. Subhadda trở thành một vị tỳ kheo Phật giáo trước khi Phật nhập Niết bàn độ vài tiếng đồng hồ.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Subjugate", "definition": "Bring under control and governance = chinh phục, nô dịch hoá", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sublime", "definition": "Hùng vĩ, uy nghi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subservient", "definition": "Phụ thuộc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subsist", "definition": "Sự tồn tại, sự sinh sống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Substantiate", "definition": "Chứng minh (Substance = chất liệu, vật chất)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Substratum", "definition": "Mống, nền, lớp dưới", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subterfuge", "definition": "Lẫn tránh để khỏi bị khiển trách", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subtle", "definition": "Tinh tế, vi diệu (subtlety = tuyệt diệu, vi diệu)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subtlest", "definition": "Delicate, elusive, difficult to understand or perceive", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Subverted", "definition": "Lật đổ, phá vỡ, phá hoại (Subvert - lật đổ chính phủ)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sucarita", "definition": "Ba thiện hạnh, sở hành tốt, hành vi thiện", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sucaritāni-saṃsa", "definition": "Bốn quả báo thiện hành.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sucaritānisaṃsa", "definition": "Năm lợi ích của thiện hạnh.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Succinct", "definition": "Concise = ngắn gọn, súc tích", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Succour", "definition": "Sự cứu giúp, viện trợ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Succulent", "definition": "Ngon, bổ (thịt, trái cây)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Succumb", "definition": "Thua, không chống nổi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Suchness", "definition": "An epithet (tên gọi có ý nghiã) for emptiness, which refers to the way things really are.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sudassan", "definition": "Sudassan (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sudatha", "definition": "Sudatha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Suddhi", "definition": "Hai sự thanh tịnh.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Suddhodana", "definition": "Gotama’s father, a member of the Sangha, the regular Assembly of aristocrats (người qúy tộc, thành viên trong nhóm cai trị) which governed the Sakyan Clansmen and their family (Vua Tịnh Phạn, cha của Thái tử Tất-Đạt-Đa)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Suddhodana and Mahamaya named their son Siddhartha", "definition": "“He who accomplishes.” Brahmin priests predicted the boy would become either a “world turning” monarch – a chakravartin – or a Buddha, an awakened one.” One priest said that if Siddhartha saw four things – a sick man, an old man, a dead man, and a monk – then he would renounce worldly existence for the holy life.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Suffusing", "definition": "Spread over = lan ra, tràn ra", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Suhadamitta", "definition": "Bốn hạng chân bằng hữu, hạng bạn chân tình, bạn tốt", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sujata", "definition": "Tu-sà-đa - Sujata, a maiden who, in Gautama Buddha's life, offered the Buddha a bowl of milk rice before he gave up the path of asceticism following six years of extreme austerities… The Golden Bowl", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sukha", "definition": "Lạc, hoan hỉ, cảm giác vui vẻ. Chi thứ tư trong tầng thiền định thứ nhất.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Sullied", "definition": "Bị ô nhục", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sum Hợp", "definition": "Paṭisandhāna (trung), paṭisandhi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sum Điền Ngộ Do", "definition": "(森田悟由, Morita Goyō, 1834-1915): vị tăng của Tào Động Tông Nhật Bản, sống dưới thời đại Minh Trị, vị trú trì đời thứ 64 của Vĩnh Bình Tự, vị Quản Trưởng của Tào Động Tông, đạo hiệu là Đại Hưu (大休), hiệu Lục Trạm (六湛), Không Hoa (空華), nhụ là Tánh Hải Từ Thuyền Quốc Sư (性海慈船國師), xuất thân vùng Vĩ Trương (尾張, Owari). Năm 1841, ông theo xuất gia với Long Sơn Thái Môn (龍山泰門) ở Long Quang Viện (龍光院) vùng Danh Cổ Ốc (名古屋, Nagoya), Vĩ Trương, đến năm 1860 thì kế thừa dòng pháp của vị pháp huynh là Bạch Long (白龍). Ông đã từng sống qua vài nơi như Long Đức Tự (龍德寺), Thiên Long Viện (天龍院), Thiên Đức Viện (天德院) ở Kim Trạch (金澤, Kanazawa), rồi Tổng Trì Tự (總持寺, Sōji-ji), và năm 1888 ông hoàn thành bản Động Thượng Hành Trì Quỹ Phạm (洞上行持軌範). Vào năm 1891, ông làm Quán Thủ Vĩnh Bình Tự. Trong khoảng thời gian nầy ông đã nổ lực giải quyết êm xuôi cuộc phân ly giữa hai chùa Vĩnh Bình Tự và Tổng Trì Tự. Đến năm 1895, ông được cử làm Quản Trưởng Tào Động Tông. Trước tác của ông có Sư Nhũ (獅乳), Động Thượng Hóa Đạo Yếu Nghĩa (洞上化道要義), Thiền Giới Pháp Thoại (禪戒法話), Phật Giới Lược Nghĩa (佛戒略義), Ngộ Do Thiền Sư Pháp Thoại Tập (悟由禪師法話集), Đại Hưu Ngộ Do Thiền Sư Quảng Lục (大休悟由禪師廣錄).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sumangala", "definition": "Sumangala (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sumedha", "definition": "tên một vị ẩn sĩ giữ hạnh bồ tát để trở thành một vị Phật toàn giác. Đây là vị bồ tát tiền thân Phật Thích Ca.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Summon", "definition": "Gọi đến, mời đến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sumptuous", "definition": "Xa xỉ, lộng lẫy", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sundara", "definition": "Sundara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sung", "definition": "𠑽. Như chữ Sung 充.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Bị", "definition": "充備. Đầy đủ không thiếu xót gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Chức", "definition": "充職. Đưa vào việc làm nào còn thiếu người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Công", "definition": "充公. Cho vào của chung, ý nói tịch thu tài sản của kẻ phạm tội mà cho vào quỹ nhà nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Cơ", "definition": "充飢. Ăn vào cho khỏi đói, cho qua cơn đói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Dật", "definition": "充溢. Đầy đủ tràn trề.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Dụ", "definition": "充裕. Đầy đủ dư thừa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Huyết", "definition": "充血. Bệnh ứ máu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Khuyết", "definition": "充缺. Lấp vào chỗ thiếu xót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Mãn", "definition": "充滿. Đầy đủ. Nhiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Nhai", "definition": "充街. Đầy đường chỉ người vô dụng, vật vô giá trị. Thường nói sung nhai điền hạng (đầy đường lấp ngõ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Phân", "definition": "充分. Đầy đủ các phần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Quân", "definition": "充軍. Cho vào lính, nói về hình phạt đầy làm lính thú ở biên giới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Sướng", "definition": "充暢. Đầy đủ thích ý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Số", "definition": "充數. Thêm vào cho đủ số ấn định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Thiệm", "definition": "充贍. Như Sung túc 充足.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Trường", "definition": "充腸. Cho vào ruột, ý nói tạm cho qua cơn đói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Túc", "definition": "充足. Đầy đủ, không thiếu thốn gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Tắc", "definition": "充塞. Lấp đầy Đầy dẫy, nhiều lắm, chỗ nào cũng có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sung Điền", "definition": "充填. Thêm vào, lấp vào chỗ trống cho đủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Supatitthita", "definition": "Supatitthita (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Superconscious", "definition": "Siêu thức", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Superficial", "definition": "Bề mặt, bề ngoài", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Superimpose", "definition": "Đặt lên trên cùng, chồng lên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Supine", "definition": "Tư thế nằm ngửa, lật ngửa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Supplant", "definition": "Thay đổi, lật đổ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Supraorbital", "definition": "Situated or occurring above the orbit of the eye = trên ổ mắt", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Suprasensory", "definition": "Siêu giác quan", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Surmise", "definition": "Phỏng đoán, ước đoán", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Surreptitiously", "definition": "Lén lúc, gian lận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Surrey", "definition": "Xe ngựa hai chỗ ngồi", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Surrogate", "definition": "Người đại diện tôn giáo, đại diện giám mục", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sustenance", "definition": "Trợ giúp, phương tiện sinh sống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sutava", "definition": "Sutava (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sutra", "definition": "The teachings or scriptures of Buddha Shakyamuni", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sutta", "definition": "Kinh. Ghi lại những lời giảng của Đức Phật. Tạng thứ hai trong Tam Tạng Pali.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Suy", "definition": "推. Dùng tay mà đẩy tới trước. Cũng đọc Thôi Trừ bỏ Từ chối Dời đổi lựa chọn Tiến cử người tài Tìm tòi Từ điều này mà nghĩ ngợi để biết ra điều kia. Đoạn trường tân thanh có câu: “Cứ trong mộng triệu mà suy, phận con thôi có ra gì mà sau”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Ba", "definition": "推波. Đẩy sóng. Sóng đã lớn mã còn đẩy thêm, ý nói đã không giải quyết được lại còn làm hỏng việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Bại", "definition": "衰敗. Sa sút hư hỏng đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Bộ", "definition": "推步. Tính toán về ngày giờ và hiện tượng thiên văn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Chuyển", "definition": "推轉. Dời đổi, thay đổi. Ta vẫn nói trại là Suy suyển.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Công Qui Bản", "definition": "Đưa công về gốc. Tức đưa cái đức của nghiệp dụng về cái thể căn bản của nó. Đại Nhật Kinh Nghĩa Thích Diễn Mật Sao quyển 2 (Vạn Tục 37, 17 thượng) nói: “Như nghi thức nói pháp của hết thảy chư Phật đều do nơi Ứng Thân (...), nhưng đưa công về gốc thì chính là Pháp Thân nói”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Suy Cầu", "definition": "推求. Tìm tòi, tìm hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Cổ Thiên Hoàng", "definition": "(推古天皇, Suiko Tennō, tại vị 592-628): vị Thiên Hoàng sống vào khoảng cuối thế kỷ thứ 6 và đầu thế kỷ thứ 7, vị nữ đế đầu tiên của Nhật, người con gái thứ 3 của Khâm Minh Thiên Hoàng (欽明天皇, Kimmei Tennō, tại vị 539-571), mẹ là Kiên Diêm Viện (堅塩媛, Kitashihime, con gái của Tô Ngã Đạo Mục [曽我稻目, Soga-no-iname]), Hoàng Hậu của Mẫn Đạt Thiên Hoàng (敏達天皇, Bidatsu Tennō, tại vị 572-585), tên là Phong Ngự Thực Xuy Ốc Cự (豐御食炊屋姫, Toyomikeka Shikiyahime), hay còn gọi là Hoàng nữ Ngạch Điền Bộ (額田部, Nukatabe). Sau khi Sùng Tuấn Thiên Hoàng (崇峻天皇, Sushun Tennō, tại vị 587-592) bị ám sát, bà lên ngôi kế vị ở Phong Phố Cung (豐浦宮) của nước Đại Hòa (大和, Yamato), về sau dời về Tiểu Khẩn Điền Cung (小墾田宮). Bà giao cho Thánh Đức Thái Tử (聖德太子, Shōtoku Taishi, 574-622) làm Nhiếp Chính và cho thi hành chính sách quan vị 12 cấp và hiến pháp 17 điều", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Suy Cử", "definition": "推舉. Nâng người khác lên địa vị cao hơn, cho xứng đáng với tài đức của người đó. Cất nhắc lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Di", "definition": "推移. Dời đổi. Thay đổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Diễn", "definition": "推演. Từ điều đã biết mà tìm ra được điều chưa biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Giải", "definition": "推解. Nói tắt của thành ngữ “Suy thực giải y” (đem đồ ăn của mình cho người khác ăn, cở áo của mình cho người khác mặt), chỉ sự nhường cơm xẻ áo, giúp đỡ tận tình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Gẫm", "definition": "Pounder", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Suy Hủ", "definition": "衰朽. Sa sút hư nát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Luận", "definition": "推論. Từ điều đã biết mà bàn rộng về điều chưa biết, hoặc bàn rộng để hiểu rõ hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Lão", "definition": "衰老. Già yếu dần đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Lí", "definition": "推理. Như Suy luận 推論.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Lường", "definition": "Mull", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Suy Lường Phân Biệt", "definition": "Pondering or analysis", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Suy Lạc", "definition": "衰落. Sa sút rời rụng. Chỉ sự thất bại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Nghĩ", "definition": "Anucināti (anu + ci + nā), anucināti (anu + ci + nā), anuvicināti (anu + vi + ci + nā), avekkhati (ava + ikkh + a), cintaka, cintanaka (tính từ), manana (trung), pakappeti (pa + kapp + e), paccavakkhati (pati + ava + ikkh + a), parivitakka (nam), parivīmaṃsati (pari + vi + mas + ṃ + a), takketi (takk + e), vicāreti (vi + car + e), vikappa (nam), vīmaṃsati (mān + sa), sañceteti (saṃ + cet + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Nghĩ Chín Chắn", "definition": "Anupekkhati (anu + upa + ikkh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Nguyên", "definition": "推原. Tìm tòi cho tới ngọn nguồn sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Nhược", "definition": "衰弱. Yếu đuối Hèn kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Niên", "definition": "衰年. Tuổi già yếu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Phận", "definition": "推分. Giữ yên đời sống sẵn có của mình. Cũng như: An phận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Phục", "definition": "推服. Kính nể quý trọng người tài đức như: Khâm phục, Bội phục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Quan", "definition": "Tên 1 chức quan ở đời Đường, thuộc dưới quyền Tiết Độ Sứ và Quan Sát Sứ, tức là chức Quận Tá ở đời Tống, chuyên xem xét và quyết định các việc phải trái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Suy Quảng", "definition": "推廣. Tìm tòi nghĩ ngợi rộng ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Ra", "definition": "Abhisañceteti (abhi + saṃ + cit + e), abhisañcetajita (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Sơn Bại Thuỷ", "definition": "衰山敗水. Núi mòn sông nát, chỉ cảnh đất nước tan nát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Sụp", "definition": "Vyasana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Thoái", "definition": "推退. Rút lui Từ chối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Thác", "definition": "推託. Từ chối. Không nhận. Như: Thoái thác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Thế", "definition": "衰世. Thời buổi sa sút, kém cỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Thể", "definition": "衰體. Thân xác yếu đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Thịnh", "definition": "衰盛. Sa sút và hưng thịnh. Chỉ sự thay đổi ở đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Toán", "definition": "推算. Nghĩ ngợi tính toán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Trọng", "definition": "推重. Đề cao và kính mến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Tâm", "definition": "推心. Từ lòng mình mà nghĩ được lòng người, chỉ sự đối xử hết lòng với người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Tính", "definition": "Parivitakka (nam), vikappa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Tôn", "definition": "推尊. Đưa lên cao. Đề cao người nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Tư", "definition": "推思. Nghĩ ngợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Tướng", "definition": "Khi người cõi trời sắp chết thì hiện ra 5 tướng suy báo trước. Đó là: Áo nhuốm bụi, tràng hoa héo úa, nách ra mồ hôi, mình có mùi hôi hám và không thích ngồi chỗ cũ, gọi là Thiên Nhân Ngũ Suy. [X. Luận Câu Xá Q.10].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Suy Tưởng", "definition": "推奬. Đề cao mà khen thưởng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Tầm", "definition": "Vitakketi (vi + tak + e), vitakka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Tệ", "definition": "衰弊. Sa sút dở xấu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Tổn", "definition": "衰損. Sa sút hao hụt đi. Sút kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Uỷ", "definition": "推諉. Từ chối. Như Suy thác 推託.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Vi", "definition": "衰微. Sa sút kém cỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Vấn", "definition": "推問. Tìm tòi hỏi han.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Vận", "definition": "衰運. Lúc sa sút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Xét", "definition": "Paṭisañcikkhati (paṭi + saṃ + cikkh + a), parituleti (pari + tul + e), sallakkheti (saṃ + lakkh + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Yếu", "definition": "Jara (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Suy Ân", "definition": "推恩. Từ điều mình thích, mà nghĩ tới điều người khác thích mà làm ơn cho họ. Chỉ người có lòng nhân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Ông", "definition": "衰翁. Người già Lời người già tự xưng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Đoán", "definition": "推斷. Từ điều đã biết mà quyết chắc về những điều chưa biết, chưa xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Đảo", "definition": "推倒. Đánh đổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Đốn", "definition": "衰頓. Như Suy đồi 衰頹.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suy Đồi", "definition": "衰頹. Sa sút đổ nát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suyễn", "definition": "喘. Hơi thở mạnh Bệnh kéo đờm khó thở, phải cố gắn mới thở được Nói nhỏ. Nói thì thào, như hơi thở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suyễn Tức", "definition": "喘息. Hơi thở mạnh. Hơi thở nặng nhọc Bệnh hen, khó thở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suyễn Yết", "definition": "喘咽. Nghẹt cổ, khó thở Tức nghẹn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suzerainty", "definition": "Superior feudal lord, overlord (Suzerain = quyền bá chủ)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Suân Tích", "definition": "皴 皵. Da dẻ thô ráp, sần sùi. Phần Dương Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Suý", "definition": "衰. Giết chết Các âm khác là Suy, Thoa, Thôi. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất", "definition": "𠻜. Uống từng ngụm nhỏ. Hớp từng hớp nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Chức", "definition": "率職. Cứ theo phần việc của mình mà làm cho hết sức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Giáo", "definition": "帥教. Tuân theo lời dạy bảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Lĩnh", "definition": "率領. Nhận lấy mà cai quản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Lược", "definition": "率略. Qua loa sơ sót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Lữ", "definition": "率旅. Đem quân đội ra đánh giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Nhiên", "definition": "率然. Nhẹ nhàng mau lẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Sư", "definition": "帥師. Cai quản binh đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Thổ", "definition": "率土. Chỉ toàn bộ lĩnh thổ đất nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Tiên", "definition": "率先. Trước hết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Tiền", "definition": "Cũng gọi Suất Tài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Suất Tính", "definition": "帥性. Tuân theo cái tính tự nhiên. Hát nói của Nguyên Công Trứ có câu: “Chữ kiến tính cũng là xuất tính, trong ống dòm đổ tiếng hư vô”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suất Đô Bà", "definition": "Phạm: Stùpa. Pàli: Thùpa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Suất Đội", "definition": "率隊. Chức quan võ nhỏ, trông coi một toán lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Suỷ", "definition": "挅. Như chữ Suỷ 揣.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Svelte", "definition": "Mảnh dẻ, thon thả, hấp dẫn, mảnh mai", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Swaddle", "definition": "Wrap = quấn bằng tả, bọc tả", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Swaggering", "definition": "Nghênh ngang, vênh váo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Swat", "definition": "Cú đập mạnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sway", "definition": "Đu đưa, lắc lư", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Swoop", "definition": "Cuộc đột kích, nhào xuống", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sycophantic", "definition": "Nịnh hót, bợ đỡ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Symbiosis", "definition": "Sự cộng sinh giữa hai loài, hai cơ thể", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Symbiotic", "definition": "Cộng sinh trong sinh vật học", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Symposium", "definition": "Social gathering at which there’s free interchange of ideas.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Synaptic", "definition": "The point at which a nervous impulse passes from one neuron to another = sự tiếp hợp trong sự phân chia tế bào", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Synchronicity", "definition": "The coincidental occurrence of events (psychic events)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Synchronistic", "definition": "Thuộc tính đồng bộ, đồng thời", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Syncopate", "definition": "Rút ngắn bằng cách bỏ chữ cái", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Syncretic", "definition": "Cố gắng thống nhất các trường phái khác nhau", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Syndrome", "definition": "Hội chứng của căn bệnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Synergistic", "definition": "Hợp lực", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Synonymous", "definition": "Đồng nghiã, cùng nghiã", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Synthesis", "definition": "Tổng hợp, các yếu tố", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sài", "definition": "儕. Bọn. Bầy. Td: Ngô sài (bọn ta, chúng ta).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Côn", "definition": "柴棍. Phiên âm của Sài Gòn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Hồ", "definition": "柴胡. Tên một vị thuốc bắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Kinh", "definition": "柴荆. Cành củi và cây gai, chỉ nhà nghèo, cổng ngõ làm bằng cành củi và cây gai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Lang", "definition": "豺狼. Loài chó sói Chỉ kẻ độc ác. “Rằng sao quân tử ra lòng Sài Lang” (Trinh Thử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Lang Đương Đạo", "definition": "豺狼當道. Chó sói đứng giữa đường. Chỉ kẻ tham tàn độc ác cầm quyền trị nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Môn", "definition": "柴門. Cửa làm bằng cành củi. Chỉ nhà nghèo Sài môn: Cửa sài, xếp củi làm cửa. “Cửa Sài vừa ngỏ then hoa, gia đồng vào gửi thư nhà mới sang” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sài Phi Vô Xu Cơ", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sài Thạch Dã Nhân", "definition": "柴 石 野 人. Hiệu của thiền tăng Pháp Viễn đời Tống. X. Pháp Viễn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sài Đầu", "definition": "Chức vụ coi việc củi đóm trong tùng lâm, chức này dưới chức Phạn đầu. Nhiệm vụ chủ yếu của vị Sài Đầu là vào núi lấy củi về cho Đại Chúng sử dụng. [X. Cảnh Đức Truyền Đăng Lục Q.20; môn Chức Vị trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sàm", "definition": "儳. Không chỉnh tề, ngay ngắn Một âm là Sảm, xem Sảm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Báng", "definition": "讒謗. Dèm pha chê bai người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Diên", "definition": "饞涎. Thèm ăn mà nhỏ nước rãi, ứa nước miếng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Dục", "definition": "毚欲. Ham muốn tham lam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Gián", "definition": "讒間. Dèm chê để cho hai bên xa cách nhau. “Buông lời sàm gián, quên bài tôn thân” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Hiểm", "definition": "巉嶮. Dáng núi cao ngất hiểm trở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Hàng Đoạt Thị", "definition": "攙 行 奪 巿. Cướp giật thị trường. Như Tịnh Ngữ Lục q. thượng:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sàm Hãm", "definition": "讒陷. Dèm chê để làm hại người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Hủy", "definition": "讒毁. Như sàm báng 讒謗.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Khẩu", "definition": "讒口. Miện lưỡi, dèm pha người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Ngôn", "definition": "儳言. Lời nói không đứng đắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Nham", "definition": "儳巖. Không chỉnh tề ngay ngắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Siểm", "definition": "讒諂. Dèm chê người khác và nịnh hót người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Sàm", "definition": "巉巉. Cao ngất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Thương", "definition": "欃槍. Một tên chỉ sao chổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Thạch", "definition": "鑱石. Hòn đá đầu rất nhọn, thời cổ dùng để trị bệnh theo phép châm cứu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Tiên", "definition": "攙 先. Vượt lên trước. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sàm Tạp", "definition": "儳雜. Lẫn lộn, lộn xộn. Không thứ tự ngay ngắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Tật", "definition": "讒疾. Dèm chê người khác vì ghen ghét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Vi", "definition": "毚微. Nhỏ nhặt, nhỏ nhít.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Vu", "definition": "讒誣. Đặt điều để dèm chê người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàm Đoạt", "definition": "攙 奪. Tranh đoạt, cướp giật. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sàm Đạo", "definition": "儳道. Đường tắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn", "definition": "僝. Dùng lời thậm tệ mà mắng chửi Một âm là Sạn. Xem Sạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn Nhan", "definition": "孱顏. Không đều nhau Dáng cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn Nhược", "definition": "孱弱. Nhỏ bé yếu đuối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn Phu", "definition": "孱夫. Người yếu đuối Kẻ khiếp nhược.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn Sàn", "definition": "潺潺. Chảy xuôi Rì rào (nước chảy).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn Đầu", "definition": "孱頭. Hèn kém xấu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàn Đập Lúa", "definition": "Khala (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sàn Đề", "definition": "Xem Nhẫn nhục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sàn Đề Ba La Mật", "definition": "Xem Nhẫn Nhục Ba La Mật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sàng", "definition": "床. Một lối viết của chữ Sàng 牀.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàng Lịch", "definition": "Sàng là cái giường kê trong nhà Tăng;", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sàng Nhục", "definition": "牀褥. Giường và nệm. Chỗ nằm, cũng như Sàng đệ 牀第.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàng Sắt", "definition": "牀蝨. Con rệp (hay ẩn núp ở kẻ giường).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàng Tiền Bồ Bặc", "definition": "牀前匍匐. Bò trước giường người khác, ý nói quỵ luỵ xin xỏ người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàng Đầu", "definition": "牀頭. Đầu giường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàng Đầu Kim Tận", "definition": "牀頭金盡. Ở, đầu giường đã hết tiền bạc. Chỉ của cải hết sạch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sàng Đệ", "definition": "牀第. Giường và gối. Chỗ nằm ngủ. Td: Sàng đệ chi ngôn (lời nói ở nơi giường gối, tức lời nói riêng tư).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào", "definition": "巢. Tổ chim Làm tổ – Nơi ẩn náu của bọn bất lương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Cư", "definition": "巢居. Ở trong tổ Làm tổ mà ở Làm nhà nhỏ trên cây mà ở, để tránh thú dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Do", "definition": "巢由. Sào Phủ và Hứa Do, hai bậc hiền thời cổ Trung Hoa, không ham công danh, địa vị, vua Nghiêu nhường ngôi cho mà không nhận. “Làn nước chảy, nọ dòng, nọ bên, mặc chí Sào Do” (Tụng Tây hồ phú).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Huyệt", "definition": "巢穴. Tổ chim và hang thú Chỉ nơi ẩn náu của bọn bất lương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Hứa", "definition": "巢許. Xem Sào Do 巢由.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Nam", "definition": "巢南. Làm tổ ở hướng nam, do câu Việt điểu sào nam chi (chim Việt làm tổ trên cành cây hướng nam), chỉ long dạ hướng về tổ quốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Phủ", "definition": "巢父. Hiện của một bậc hiền đời Đào Đường, vua Nghiêu nhường ngôi cho mà không nhận, làm lều trên cây mà ở (Sào Phủ nghĩa là người ở tổ) Sào Phủ, Hứa Do: Hai cao sĩ đời Nghiêu, Thuấn, Vua Nghiêu nghe tiếng Do hiền, xin nhường ngôi cho, nhưng Do không chịu nhận. Đến sau vua Thuấn lại nói chuyện nhường ngôi, bèn bỏ đi, xuống một con sông gần đó để rửa tay, có ý trút bỏ điều danh lợi vừa nghe. Xảy gặp Sào Phủ, Sào Phủ hỏi: Do đi đâu mà lật đật. Do thuật chuyện Phủ đang dẫn trâu xuống sông cho uống nước bèn dắt trâu đi mà rằng: “Uống nước con sông này e bẩn trâu của tôi đi”. Quán rằng: “Nghiêu, Thuấn thuở xưa, khó nghăn Sào Phủ, khôn ngừa Hứa Do” (Lục Vân Tiên).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sào Tuyệt", "definition": "剿 絕. Chỉ cho việc trừ sạch tình niệm trần tục, trừ hết vọng tâm phân biệt đối lập. Tiết Bảo Phúc Hòa Thượng trong TĐT q. 11 ghi: “僧 舉：「盤 山 云：光 鏡 俱 亡、復 是 何 物？洞 山 云：光 鏡 未 亡、復 是 何 物？」 據 二 彼 商 量、盡 未 得 剿 絕。師 拈 問 其 僧：作 摩 生 道 得 剿 絕？僧 云：還 解 怪 笑 得 麼？師 云：非 常 怪 笑 得。學 人 却 問：和 尚 如 何 道 得 剿 絕 去？師 云：兩 手 扶 犂 水 過 膝。", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sào Xa", "definition": "巢車. Tên một thứ xe dùng trong quân đội thời cổ, trên xe đựng cột cao, đầu cột là cái chòi nhỏ, lính leo lên đó để quan sát tình hình quân địch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sá", "definition": "仛. Người thiếu nữ Kiêu ngạo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sá Dị", "definition": "詫異. Ngạc nhiên, lấy làm lạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sá Sá", "definition": "咤咤. Tiếng xuýt xoa vì chịu lạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sá Tử", "definition": "耍子. Vui chơi Cuộc vui Dùng trong Bạch thoại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sá Xoa", "definition": "咤叉. Hai tay chà vào nhau, ý xun xoe.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sác", "definition": "塙. Đất rất cứng, không đào được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sác Kí", "definition": "戳記. Ghi lại. Vẽ lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sác Tàng", "definition": "Trứng chim. Từ ngữ này được dùng để ví dụ con người bị phiền não vô minh trói buộc, che lấp, giống như con chim con bị bọc trong lớp vỏ trứng (Sác tàng: Bị giấu trong trứng) vậy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sác Tập Lực", "definition": "Cũng gọi Quán Tập Lực, Tập Lực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách", "definition": "𠂥. Như chữ Sách 冊, 册.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Bồ Tát", "definition": "Gọi đủ: Kim Cương Sách Bồ Tát (Phạm: Vajra-pàza).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Chân", "definition": "策 眞 (?-979). Thiền tăng đời Ngũ Đại, họ Ngụy, người Tào Châu (Đào Tây, Đông Định), Trung Quốc. Lúc đầu tên Huệ Siêu, yết kiến Thiền Sư Thanh Lương Văn Ích, hỏi: “Thế nào là Phật?” Văn Ích đáp: “Ông là Huệ Siêu!” Sách Chân do đây ngộ nhập, nối pháp làm truyền nhân tông Pháp Nhãn. Sư trụ trì chùa Quy Tông núi Lô Sơn, có vị tăng hỏi: “Thế nào cảnh Quy Tông?” Sư đáp: “Ông thấy gì?” Tăng hỏi lại: “Thế nào là người trong cảnh?” Sư đáp: “Hãy bước ra!” Về sư dời sang các chùa Phụng Tiên, Báo Ân v. v… Được ban hiệu “Pháp Thí Thiền Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sách Danh", "definition": "策名. Tên tuổi được ghi trong giấy tờ triều đình. Chỉ sự làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Dẫn", "definition": "Đem nội dung của các kinh luận biên thành mục lục để dễ kiểm tra, như Đại Trí Độ Luận Loại Tụ Tiêu Mục, Tông Kính Lục Yếu Nghĩa Điều Mục, Pháp Hoa Huyền Luận Tiêu Mục v.v... tức đem những mục trọng yếu nêu ở trên sách.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Dục Vấn Hòa", "definition": "Tiếng dùng trong giới luật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Ha", "definition": "Phạm: Sahà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Luận", "definition": "策論. Bài văn giải nghĩa và bàn bạc về một tư tưởng trong sách cổ. Một bài văn trong chế độ khoa cử thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Lược", "definition": "策略. Mưu kế. Sự tính toán sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Lập", "definition": "册立. Lệ đời Thanh, vua lập Hoàng hậu gọi là Sách lập (dựng nên theo lệnh vua).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Lệ", "definition": "策勵. Thúc giục, khuyến khích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Miễn", "definition": "策勉. Thúc giục cố gắng. Như: Sách lệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Mệnh", "definition": "册命. Lênh vua phong chức tước cho quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Nhiễu", "definition": "索擾. Đòi hỏi thứ này thứ kia, làm phiền người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Phong", "definition": "册封. Lệnh vua ban chức tước cho người nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Phát A Xà Lê", "definition": "Cũng gọi Sách Phát Sư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Phạn Tiền", "definition": "索 飯 錢. Sau khi chết bị Diêm Vương đòi tiền cơm, chỉ cho một phen hành cước tham học, không thu được kết quả gì, chỉ toi cơm của thí chủ. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sách Phủ", "definition": "册府. Nơi cất giữ giấy tờ sách vở của triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Sách", "definition": "摵摵. Gió thổi cây cối xào xạc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Súc", "definition": "彳亍. Bước chân trái lên, rồi lại bước chân phải lên, ý nói bước đi. Ghép hai chữ này lại thì thành chữ Hành 行: Có nghĩa là bước đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Sĩ", "definition": "策士. Người giỏi, có mưu lược Đem nghĩa sách mà hỏi học trò đi thi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Thoại", "definition": "Cũng gọi Sách Ngữ, Điếu Ngữ, Điếu Thoại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Thí", "definition": "策試. Đem nghĩa sách, dùng thể văn sách mà cho học trò đi thi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Thủ", "definition": "索取. Đòi lấy về làm của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Trái", "definition": "索債. Đòi nợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Trượng", "definition": "策杖. Chống gậy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Tuyến", "definition": "策線. Danh từ quân sự, chỉ con đường quan trọng, từ đóng quân của mình đến đóng quân của địch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Tử", "definition": "策 子. Quyển sách. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sách Tử Bản", "definition": "Bản sách đóng, 1 trong các hình thức đóng sách ở Trung Quốc thịnh hành vào đời Tống, những bản kinh Phật đào được ở Đôn Hoàng hầu hết là loại Sách Tử Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Văn", "definition": "册文. Thể văn dùng vào việc viết lệnh vua Thể văn dùng để bề tôi tâu việc lên vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Vấn", "definition": "策問. Đem nghĩa sách ra hỏi học trò đi thi Đầu bài văn sách của chế độ khoa cử xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách chú thích Luận Nhiếp Đại Thừa của ngài Vô Trước.", "definition": "I.Nhiếp Đại Thừa Luận Thích. Phạm: Mahàyàna-saôgraha-bhàwya. Tác phẩm, do ngài Thế Thân soạn, có 3 bản Hán dịch:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách này là ngài Chỉ Nguyệt tham chiếu “Tào Sơn Bản Tịch Thiền Sư Ngữ Lục” do ngài Nghi Mặc Huyền Khế biên tập, lược bớt đi mà thành. Bên ngoài đề là Tào Sơn Đại Sư Ngữ Lục; còn bên trong thì đề là Phủ Châu Tào Sơn Nguyên Chứng Thiền Sư Ngữ Lục. (xt. Phủ Châu Tào Sơn Nguyên Chứng Thiền Sư Ngữ Lục).", "definition": "IV. Tào Sơn Lục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách Đá", "definition": "Phạm: Sattva. Pàli: Satta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sách ấy còn cho biết : “Trong mười tám bài pháp nói đến Tu-Đà Cấp Cô Độc ghi trong Tạng kinh, có mười bốn bài do đức Phật tùy cơ duyên tự nói ra, một bài Phật thuyết do Tu-Đà đặt câu hỏi, một bài khác Phật giảng sau khi nghe Tu-Đà thuật chuyện đã đối thoại với những đạo sĩ Bà-la-môn giáo. Và sau cùng là hai bài pháp do tôn giả A-Nan và trưởng lão Xá-Lỵ-Phất đến bên giường bệnh của Tu-Đà để nhắc nhở. Mười tám bài pháp này chứng tỏ rằng trong kho tàng Phật giáo, hẳn đã có một phần quan trọng dành riêng cho người cư sĩ hay Phật tử tại gia, khi họ muốn đạt đến thánh quả mà không cần sống trong Giáo Hội!”", "definition": "Kiết hạ là an cư trong ba tháng mưa, từ rằm tháng 6 đến 16 tháng 9. Trong 45 năm, đức Phật kiết hạ tại Kỳ-Viên 19 mùa.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sách ẩn", "definition": "索隱. Tìm tòi những điều kín đáo, khó hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sách Ứng", "definition": "策應. Danh từ quân sự, chỉ sự liên lạc giúp đỡ giữa các cánh quân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái", "definition": "差. Bệnh giảm. Khỏi bệnh Các âm khác là Sai, Si. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Bịnh Bất Giả Lô Đà Dược", "definition": "瘥 病 不 假 驢 駝 藥. Trị bệnh không nhờ đến thuốc Lô Đà, ý nói thuốc trị bệnh chỉ cần dùng một lượng nhỏ liền có hiệu quả. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sái Giờ", "definition": "(Quá Ngọ). Vikāla (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sái Lạc", "definition": "灑落. Vẻ nhàn hạ thảnh thơi, không bị ràng buộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Lệ", "definition": "灑淚. Chảy nước mắt. Đau lòng mà khóc. Văn tế Vũ Tính và Ngô Tùng Châu của Đặng Đức Siêu có câu: “Bóng tinh trung thấp thoáng dưới đèn, phong nghi cũ kẻ liêu bằng sái lệ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Lệ Vũ", "definition": "灑淚雨. Mưa nhỏ lệ, tức mưa Ngâu vào tháng 7 âm lịch, coi như nước mắt của Ngưu lang và Chức nữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Quấy", "definition": "Micchatta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sái Sái Lạc Lạc", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sái Thoát", "definition": "灑脫. Thảnh thơi, không bị ràng buộc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Thư", "definition": "曬書. Phơi sách ra nắng cho khỏi ẩm mốc Cũng chỉ dáng điệu nằm vườn lười biếng. Sách Thế thuyết chép rằng, ngày 7 tháng 7 âm lịch, Quách Long nằm phơi bụng dưới nắng, có người hỏi thì họ Quách đáp rằng: “Ta phơi sách” (ý nói sách vở chứa hết trong bụng, phơi bụng tức phơi sách).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Thủy Kị", "definition": "Cũng gọi Hiếu Lực Kị, Quang Hỉ Kị. Cứ theo điều Truy kị danh số thường đệtrong Chư Hồi Hướng Thanh Qui quyển 4 thì Sái thủy kị là chỉ cho tuần thất thứ 3 (ngày thứ 21) của người chết. Vào ngày này, thân nhân của người chết thường tụng kinh lễ sám, làm phúc tu thiện, bố thí cúng dường để hồi hướng nguyện cầu cho vong linh của người quá cố được Vãng Sinh Tịnh Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sái Tảo", "definition": "灑掃. Rảy nước mắt mà quét cho khỏi bụi Chỉ công việc đàn bà trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sái Tịnh", "definition": "Cũng gọi Sái Thủy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sái Y", "definition": "衩衣. Áo xẻ tà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sám", "definition": "Jñānabhadrā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sám Chủ", "definition": "Từ tôn xưng ngài Tuân Thức, vị cao tăng chùa Linh Sơn Thiên Trúc ở Hàng Châu, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sám Hối", "definition": "Nguyên có nghĩa là ăn năn tội lỗi và cầu mong tha thứ. Chữ “sám”, nói đủ là “sám-ma”, dịch âm từ chữ Phạn “ksama”, có nghĩa là là thỉnh cầu tha thứ. Chữ “hối” là chữ Hán, có nghĩa là ăn năn, hối hận và tự giải bày tội lỗi của mình đã tạo ra. Hợp hai chữ lại làm thành từ “sám hối”, là một thuật ngữ Phật học, có nghĩa là, tự biết ăn năn tội lỗi mình đã gây ra, và tự bày tỏ (phát lồ) tội lỗi ấy trước Phật, Bồ-tát, Sư trưởng, hay Đại chúng, để cầu xin tha thứ, tự hứa về sau không tái phạm tội. Mục đích của sự sám hối là để cho tội chướng tiêu trừ, thân tâm thanh tịnh. Từ thời Phật tại thế cho đến ngày nay, bất cứ nơi nào và lúc nào có sinh hoạt của Tăng đoàn Phật giáo, thì sám hối vẫn luôn luôn là một pháp tu vô cùng quan trọng của người đệ tử Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sám Hối Ngũ Pháp", "definition": "懺悔五法 (Viên Giác Lược Sớ Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sám Hối Văn", "definition": "Chỉ cho bài văn được đọc khi sám hối diệt tội.Có nhiều loại dài, ngắn khác nhau, trong đó, nổi tiếng nhất là bài kệ trong Phẩm Phổ Hiền Hành Nguyện của kinh Hoa Nghiêm quyển 40 như sau (Đại 10, 847 thượng):", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sám Lễ", "definition": "懺禮. Việc cúng vái để thú tội cùng thần linh sửa đổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sám Ma", "definition": "I.Sám Ma. Phạm: Kwama.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sám Ma Y", "definition": "Áo làm bằng cỏ ksama. Áo len.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sám Nghi", "definition": "A. rules for confession. Nghi thức sám hối.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sám Pháp", "definition": "懺法. Tiếng nhà Phật, chỉ nghi lễ thú tội và xin sửa đổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sám Trừ", "definition": "Sám hối để đoạn trừ, rửa sạch mọi tội lỗi.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sám Tội", "definition": "懺罪. Nhận điều lỗi mình đã làm và xin sửa đổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sán", "definition": "燀. Khó khăn Các âm khác là Đạn, Xiền. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sán Khí", "definition": "疝氣. Bệnh sưng hòn dái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng", "definition": "刱. Như hai chữ Sáng 剙, 創.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Chói", "definition": "Āphassara (tính từ), pajjalana (trung), sassirīka (tính từ), sobhaga (trung), tejavantu (tính từ), vibhāti (vi + bhā + a), virājati (vi + raj + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Chế", "definition": "創制. Khởi đầu làm ra. Tạo ra trước tiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Cơ", "definition": "創基. Tạo dựng nên sự nghiệp làm nền tảng về sau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Cử", "definition": "創舉. Việc làm, hành động có lần đầu tiên, từ trước chưa hề có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Khởi", "definition": "創起. Bắt đầu dựng nên. Tạo ra trước tiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Kiến", "definition": "創見. Điều nghĩ ngợi tự mình phát khởi ra trước hết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Lạng", "definition": "Bhāsura (tính từ), yasa (nam), juṇha (tính từ), juti (nữ), teja (nam) (trung), pakāsa (nam), patāpa (nam), pabhāsa (nam), ujjala (tính từ), vibhūti (nữ), virocati (vi + ruc + a), visuddhi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Lập", "definition": "創立. Khởi đầu dựng lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Nghiệp", "definition": "創業. Gây dựng cơ đồ lớn lao Mở đầu một triều đại (nói về vị vua đầu tiên của triều đại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Nghiệp Thùy Thống", "definition": "創業垂統. Dựng nên cơ đồ để truyền lại cho các đời sau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Quá", "definition": "Suvisada (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Rực", "definition": "Sajotibhūta (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Suốt", "definition": "Bujjanaka (tính từ), medhā (nữ), jāgariya (trung), nipaka (tính từ), paññavantu (tính từ), paṇḍita (tính từ), dhona (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Sớm", "definition": "Paccūsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Thiết", "definition": "創設. Như sáng lập 創立.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Thế", "definition": "創世. Tạo dựng cõi đời, tạo dựng vũ trụ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Thế Chủ", "definition": "Chỉ cho vị thần linh được xem là đấng sáng tạo ra trời đất, muôn vật và loài người.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sáng Thế Kí", "definition": "創世記. tên bộ sách đầu tiên trong kinh Cựu ước của Cơ đốc giáo, chép việc đức Chúa trời tạo dựng vũ trụ và muôn loài muôn vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Trí", "definition": "Vibhāvi (tính từ), dhīra (tính từ), cāturiya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Tác", "definition": "Viracayati (vi + rac + ya), racayati (rac + aya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáng Tạo", "definition": "創造. Làm ra nghĩ ra, không dựa vào những cái đã có sẵn. “Tiếc cơ đồ gây dựng giang sơn, hoài sự nghiệp tổ tông sáng tạo” (Sãi vãi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáng Tỏ", "definition": "Niggumba (tính từ), paridīpaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáo", "definition": "套. Chỗ đất quanh co Môt bộ đồ vật Cái khuôn Khuôn mẫu có sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Binh", "definition": "哨兵. Nơi đóng quân ở xa Lính đóng đồn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Bôi", "definition": "套杯. Chén uống rượu thành một bộ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Ngữ", "definition": "套語. Lời nói, câu văn theo khuôn mẫu có sẵn, ý tưởng trống rỗng, không thành that, không óc gì mới mẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Sáo", "definition": "哨哨. Nói nhiều, lắm miệng Tiếng xì xào nho nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Sở", "definition": "哨所. Nơi đóng binh ở xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Thám", "definition": "哨探. Lính có nhiệm vụ dò xét bên địch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Tập", "definition": "套襲. Rập theo khuôn mẫu có sẵn, bắt chước người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáo Tử", "definition": "哨子. Cái còi của cảnh sát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáp", "definition": "㒊. Không kịp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáp Dĩ", "definition": "帹㒾. Cái mặt nạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáp Huyết", "definition": "歃血. Uống máu ăn thề. Một hình thức giao kết thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáp Nhập", "definition": "插入. Gom vào làm một. Ta vẫn quen đọc Sát nhập là vô nghĩa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sáp Ong", "definition": "Madhusittha (trung), sitthaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sáp Đơn", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sáp Đạp", "definition": "㒊譶. Nói quá nhanh, tiếng nọ đè tiếng kia, người nghe không kịp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát", "definition": "Kśa (S), Ksha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Bút", "definition": "煞筆. Phần kết luận của bài văn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Chiếu", "definition": "察照. Xem xét, rọi sáng cho rõ sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Cáp Nhĩ", "definition": "察哈爾. Tên một tỉnh ở đông bắc bộ Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Cứu", "definition": "察咎. Xét điều lầm lỗi của người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Cử", "definition": "察舉. Xét kĩ mà lựa chọn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Hoạt Lâm Thời", "definition": "剎 活 臨 時. Tùy thời cứu sống hoặc giết chết. Căn cứ vào thời cơ cụ thể mà vận dụng cơ phong: Hoặc chặt đứt vọng tưởng phân biệt (sát), hoặc làm sống lại chân tính linh giác (hoạt). Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sát Hoạt Lệnh", "definition": "剎 活 令. Lệnh tha giết. Chỉ cho cơ phong chặt đứt vọng niệm phân biệt và làm sống lại chân tính. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sát Hạch", "definition": "察核. Xem xét và hỏi cho biết trình độ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Hại", "definition": "Atipāteti (ati + pat + e), atipāta (nam), maraṇacetanā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sát Hại Tưởng", "definition": "Vihiṃsa-saṃjñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Hải", "definition": "刹海. Chỉ đất đai, ruộng đất Cũng chỉ biển và đất liền, dưới nước và trên bộ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Khuẩn Tế", "definition": "殺菌劑. Thuốc giết vi trùng Thuốc tiêu độc, ngăn ngừa làm độc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Khán", "definition": "察看. Coi xét kĩ lưỡng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Khí", "definition": "殺氣. Vẻ chém giết hiện ra bên ngoài. Đoạn trường tân thanh có câu: “Quan quân truy sát đuổi dài, hằm hàm sát khí ngất trời ai đang”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Khảo", "definition": "察考. Xem xét tìm tòi. Cũng nói: Khảo sát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Lược", "definition": "殺掠. Giết người cướp của.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Lục", "definition": "殺戮. Chém giết. Giết chóc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Lỵ", "definition": "Kṣatriya (S), Khattiya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Na", "definition": "Kṣaṇa (S), Khanika (P), Setsuna (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Na Sinh Diệt", "definition": "Chỉ cho sự sinh khởi và diệt vong trong 1 sát na.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Na Vô Thường", "definition": "Đối lại: Nhất kì vô thường. Sự vô thường trong 1 sát na.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Na Đẳng Khởi", "definition": "Tatkṣaṣa-Samutthana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Na Định", "definition": "Khanika-samādhi (P), Kṣanika-samādhi (S), Kṣaṇabhaṅga (S), Khaṇabhaṅa (P), Momentary concentration.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Nghiệm", "definition": "察驗. Xem xét kĩ càng coi có thật đúng hay không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Nghiệp", "definition": "Nghiệp sát sinh. Sinh Giết hại chúng sinh, loài hữu tình. Lòng từ bi của Phật tử không phải chỉ là thương người, mà còn thương yêu tất cả mọi loài hữu tình. Giới sát sinh là giới luật hàng đầu mà Phật tử phải gìn giữ, đặc biệt là Phật tử xuất gia.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sát Nghị", "definition": "議議. Xem xét mà quyết định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Ngôn", "definition": "察言. Xem xét lời nói mà biết được lòng ngừơi. Cũng nói: Sát ngôn quan sắc (xét lời nói, nhìn vẻ mặt, mà rõ được lòng người).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Nhân", "definition": "殺人. Giết người. Td: Sát nhân giả tử (kẻ giết người thì phải chết để đền tội).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Nhân Bất Trác Nhãn", "definition": "剎 人 不 眨 眼. Giết người không chớp mắt, giết người mà không run sợ, chỉ cho người có tư cách cứng cỏi. Thiền Tông mượn cụm từ này để chỉ cho bậc Thầy đã kiến tính tiếp hóa người học bằng thủ đoạn rất khốc liệt, chẳng hề nương tay hay vị nể. Tắc 4, Bích Nham Lục (Đại 48, 144 trung) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sát Nhân Bất Trát Nhãn", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Nhân Đao - Hoạt Nhân Kiếm", "definition": "剎 人 刀 活 人 劍. Đao giết người, kiếm cứu người. Cơ xảo của chư Tổ tiếp dẫn hậu học có cao thấp. Thấp là tiểu cơ tiểu dụng, nghĩa là chỉ biết dùng Đao giết người. Cao là đại cơ đại dụng, vừa khéo dùng Đao giết người vừa khéo dùng Kiếm cứu người. Phần Thùy Thị, tắc 12, Bích Nham Lục (Đại 48, 152 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sát Nhân Đao Hoạt Nhân Kiếm", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Nội", "definition": "殺内. Dứt bỏ lòng dạ xấu xa bên trong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Phong Cảnh", "definition": "殺風景. Ý nói đang vui mà mất vui vì một chuyện buồn, trái ý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Phu", "definition": "殺夫. Giết chồng Kẻ giết người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Phí", "definition": "煞費. Rất uổng, rất hao tốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Phạt", "definition": "殺伐. Đánh giết quân giặc Ta còn hiểu là dùng cờ bạc để bóc lột lẫn nhau không thương xót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Phật Sát Tổ", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Phỏng", "definition": "察訪. Xem xét dọ hỏi để biết rõ sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Quỉ", "definition": "Chỉ cho sự vô thường giống như quỉ giết người.Bởi lí vô thường khiến mọi người đã sinh ra thì không kể giàu nghèo sang hèn đều phải chết, không ai tránh khỏi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Sanh", "definition": "Ghāteti (han + e) ghāta (nam) ghātana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sát Sanh Giới", "definition": "Prāṇātipāta (S), Pāṇavadha (P), Pāṇatipāta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Sinh", "definition": "殺生. Giết chết những vật có sự sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Sinh Giới", "definition": "Sát sinh, Phạm: Pràịàtipàta hoặc Pràịàtighàta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Sát", "definition": "察察. Xem xét phân biệt rõ ràng Vẻ thanh khiết trong sạch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Sắc", "definition": "察色. Xem xét nét mặt mà biết lòng người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Thanh", "definition": "Cách đánh chuông, trống báo hiệu sắp chấm dứt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Thân", "definition": "殺身. Tự giết mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Thân Thành Nhân", "definition": "殺身成仁. Hi sinh mạng sống của mình để làm được điều nhân nghĩa. “Heo đặng câu sát thân thành nhân” (Lục súc tranh công).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Thương", "definition": "殺傷. Giết người và làm hại tới thân thể người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Thử", "definition": "殺鼠. Giết chuột. Td: Sát thử tễ (thuốc diệt chuột).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Tinh", "definition": "煞星. Sao xấu. Vì sao ảnh hưởng xấu tới vận số của một người. Như: Hung tinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Trùng", "definition": "殺蟲. Giết chết loài sinh vật cực nhỏ hại người. Giết vi trùng. Td: Sát trùng tễ (thuốc sát trùng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Trần", "definition": "Cõi bụi.Ví dụ số lượng cõi nước rất nhiều, không thể đếm được, như nói vô số quốc độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Trụ", "definition": "Cũng gọi Sát Can, Sát Can Sát.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Tặc", "definition": "Giết giặc. Bậc Thánh A la hán đã đoạn tận mọi phiền não, cho nên có danh hiệu là sát tặc. Giặc ở đây chỉ phiền não.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sát Tử", "definition": "察子. Người dò xét sự việc. Như: Thám tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Viện", "definition": "察院. Tên một cơ quan thuộc ngự Sử đài đời Đường, xét việc làm của các quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Vấn", "definition": "察問. Xét hỏi để biết rõ sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát hải trừng trừng dạ mạn thu..", "definition": "Bảo người tu Tịnh độ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sát Đế Lợi", "definition": "Śastriya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sát Đế Lỵ", "definition": "S. Khastrya. Sách dịch Trung Quốc phiên âm từ khastrya chữ Sanskrit, để chỉ đẳng cấp vương tướng là một trong bốn đẳng cấp của xã hội Ấn Độ cổ đại. Ba đẳng cấp kia là là đẳng cấp Bà-la-môn, đứng đầu mọi đẳng cấp khác và gồm những tu sĩ, giáo sĩ trông nom việc tế lễ. Đẳng cấp Vệ xá (S. Vaisya) là đẳng cấp những người làm nghề buôn bán. Đẳng cấp Thủ đà la(S. Sudra) là đẳng cấp của nông dân. Ngoài 4 đẳng cấp trên, còn có lớp người cùng khổ nhất, tức là tiện dân, làm các nghề hạ tiện nhất trong xã hội. Ấn Độ gọi những người này là Parias hay là Chandala.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sát Địch", "definition": "殺敵. Giết giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sát Độ", "definition": "Phạm: Kwetra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sát Độ Tự Tại", "definition": "Cũng gọi Tịnh Độ Tự Tại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sáu Ba La Mật", "definition": "Gồm Đàn Na (Bố Thí), Thi La (Trì Giới), Xiển Đề (Nhẫn Nhục) Tỳ Lê Da (Tinh Tấn), Thiền Na (Thiền Định) Bát Nhã (Trí Huệ), cũng gọi là Lục Độ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Bản Chất", "definition": "(Dhātu), Sáu Giới", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Cá Tính", "definition": "(Carita, cariyā), khuynh hướng nội tâm cá biệt của mỗi chúng sanh.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Cái Khó", "definition": "H. Lục nan Sáu chuyện may, khó gặp ở trong đời:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Cõi Luân Hồi", "definition": "Rikdruk (T), Six realms of Samsar, Six worlds of existence.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Cõi Trời Dục Giới", "definition": "Theo đạo Phật, cõi người không phải là cõi sống cao cấp nhất mà trên cõi người còn có các cõi Trời, ở đấy chúng sinh sống thọ mạng lâu dài hơn, hạnh phúc hơn, có nhiều quyền năng hơn loài người rất nhiều. Chúng sinh ở đấy có tên chung là loài Trời. Loài Trời cũng có nhiều cấp: Cấp thấp nhất là các cõi Trời còn có lòng tham dục, cho nên gọi là dục giới. Cấp trung bình là các cõi Trời không còn có lòng tham dục nữa, cho nên gọi là các cõi trời Sắc giới. Cấp cao hơn cả là những cõi trời Vô Sắc giới, ở đây, chúng sinh không những không có lòng dục, mà không có cả sắc thân nữa, mà chỉ là tinh thần thuần túy. Riêng Dục giới có sáu cõi Trời tất cả, cho nên có hợp từ Lục dục Thiên, nghĩa là sáu cõi Trời thuộc Dục giới. Cụ thể là, theo từ ngữ dịch âm hoặc nghĩa của các bản dịch Hán:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Căn", "definition": "H. Lục căn. Sáu quan năng (tức mắt, tai, mũi, lưỡi, thân, ý). Thông qua sáu căn này, con người nhận thức thế giới khách quan. Căn: gốc, rễ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Căn Nguyên Tạo Nghiệp", "definition": "(Kammanidāna).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Cảnh Trời", "definition": "Xem Lục Dục Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Cửa Suy Vong", "definition": "(Apāyamukha), ngõ đi dẫn đến tai hại và tiêu hao tài sản.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Giác Quan", "definition": "Six sense-organs.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Giặc", "definition": "H. Lục tặc. Đạo Phật xem sáu giác quan (mắt, tai, mũi, lưỡi, thân, ý) như là sáu tên giặc ở trong mình. Vì chúng thường xuyên đưa màu sắc, hình sắc, âm thanh, hương vị và ý niệm, hình ảnh tưởng tượng vào quấy rối thân tâm của người tu hành. Sách Phật giáo có câu hộ trì căn môn, nghĩa là giữ gìn, chăm sóc căn môn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Giới Nghiệp Xứ", "definition": "(Dhātukammaṭṭhāna), đề mục về sáu bản chất, sáu yếu tố để tuệ quán ghi nhận.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Gốc Luận Tranh", "definition": "(Vivādamūla) nguyên nhân sanh ra tranh luận.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Hòa", "definition": "H. Lục hòa. Chúng tăng trong chùa chiền, tu viện phải thực hành lục hòa:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Kỳ Kết Tập Kinh Điển", "definition": "(Dhammasaṅgīti).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Loài Gia Súc", "definition": "Six kinds of domestic animals.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Môn", "definition": "(Dvāra) sáu cửa ngõ tiếp xúc (sáu ngoại xứ).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Mươi Hai Kiến Chấp", "definition": "Tứ cú x ngũ uẩn = 20; 20 x tam thế = 60; 60 + hữu vô = 62.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Ngoại Xứ", "definition": "(Bāhirāyatana).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Nhân", "definition": "Thuyết nhân quả của Nhất thiết hữu Bộ phân biệt có sáu nhân:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Nhập", "definition": "H. Lục nhập. Một chi trong 12 nhân duyên. Sáu nhập là sáu cảm quan (mắt, tai, mũi, lưỡi, thân v.v… ) là nơi ngoại trần (sắc, thanh, hương v.v…) xâm nhập vào trong nội thân chúng ta. Sáu nhập duyên xúc là có sáu nhập mới có sự tiếp xúc với ngoại cảnh từ đó nảy sinh ra cảm thụ, thèm muốn, rồi nắm lấy vơ vét vào cho mình, gây ra nghiệp ác. Sách Phật cũng gọi sáu nhập là sáu y, là nơi nương tựa để phát khởi các sự hay biết của mắt (nhãn thức), của tai (nhĩ thức) v.v…", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Nẻo", "definition": "Six realms of existence", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sáu Pháp Cần Biến Tri", "definition": "(Pariññeyyā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Cần Sanh Khởi", "definition": "(Uppādetabbā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Cần Thắng Tri", "definition": "(Abhiññeyyā-dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Cần Tu Tập", "definition": "(Bhāvetabbā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Cần Tác Chứng", "definition": "(Sacchikātabbā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Cần Được Đoạn Trừ", "definition": "(Pahātabbā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Khó Thể Nhập", "definition": "(Duppaṭivij-jhā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Thuộc Phần Hạ Liệt", "definition": "(Hānabhāgiyā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Thuộc Phần Thù Thắng", "definition": "(Visesabhāgiyā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Thối Quá", "definition": "(Parihāniyā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Thối Quá Khác", "definition": "(Parihāniyā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Pháp Đa Tác Dụng", "definition": "(Bahukārā dhammā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Phép Thần Thông", "definition": "S. Abhijna (Lục thông). Phép thần thông chỉ là một thứ năng lực tâm-sinh lý đặc biệt mà những người lâu năm tu điều thân và điều tâm, thành tựu được. Những người này có thể là thuộc đạo Phật hay những đạo giáo khác, miễn là họ có thầy giỏi hướng dẫn và chịu khổ luyện thân và tâm, thì nhất định sẽ thành tựu được những quyền năng đặc biệt mà người bình thường không có được. Đạo Phật không xem phép thần thông là cứu cánh của sự nghiệp tu học, cứu cánh là giác ngộ và giải thoát, chứ không phải là phép thần thông. Những phép thần thông là kết quả tất nhiên đạt tới trong quá trình tu học. Vd, người tu đạo Phật, chứng quả A la hán, thì có được sáu phép thần thông:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Phương", "definition": "Đông, Tây, Nam, Bắc và trên, dưới. Nếu là mười phương thì thêm: Đông Nam, Tây Nam, Đông Bắc, Tây Bắc. Hán dịch lục phương. Kinh “Lễ sáu phương” là một bài Kinh rất quan trọng trong Trường Bộ Kinh tập VI, trang 181-193 của Kinh tạng Pali. Đầu đề trong kinh tạng Pali là Singalovadasutta. Nội dung Kinh nói về sáu mối quan hệ xã hội mà Phật tử phải gìn giữ tốt đẹp và đúng pháp. Đó là các mối quan hệ:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Phương Hướng", "definition": "(Disā), sáu hướng ám chỉ sáu hạng người mình phải đối xử tốt theo bổn phận.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Phương Pháp Tu Tập Thần Bí Của Ngài Naropa", "definition": "Gồm:", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Thiên Giới", "definition": "(Sagga), 6 cõi trời dục giới, cõi của các chư thiên hưởng phước.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Thọ", "definition": "(Vedanā), cảm giác sanh từ xúc.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Thời", "definition": "Sinh hoạt ở chùa chiền, thiền viện thường chia làm sáu thời: ban ngày chia ra ba buổi sớm bình minh, buổi trưa và buổi chiều hoàng hôn. Ban đêm chia ra đầu đêm, nửa đêm và cuối đêm. Người xuất gia trong sáu thời đó có công việc làm nhất định, hoặc lên khóa lễ, hoặc ngồi thiền, hoặc đọc kinh sách, làm các công việc chấp tác trong chùa và tu viện, tùy theo thời khóa biểu và sự phân công. Vua Trần Thái Tông là tác giả tập “Nghi thức sám hối của sáu thời” được in lại trong cuốn “Khóa Hư Lục” của vua. Đó là phép sám hối lỗi lầm của sáu căn trong sáu thời, mỗi thời sám hối một căn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Thứ Chấn Động", "definition": "Chia làm ba:", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sáu Thức", "definition": "(Viññāṇa), sáu loại tâm thức.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Trần", "definition": "Sáu ngoại cảnh, đối tượng tiếp xúc và nhận thức của sáu căn (mắt, tai, mũi, lưỡi, thân, ý) và sáu thức (nhãn thức, nhĩ thức, tỵ thức, thiệt thức, thân thức và ý thức). Trần là bụi, có khả năng làm nhơ bẩn thân tâm. Nếu không biết giữ gìn, phòng hộ thì sáu trần khi tiếp xúc với thân tâm con người, có thể làm cho con người tham đắm, vướng mắc, theo đuổi, tạo ra các nghiệp. Sáu trần, theo thứ tự là:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Trở Ngại Việc Tu Quán Tứ Niệm Xứ", "definition": "(Anupassanābhabbā).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Tư", "definition": "(Sañcetanā, cetanā) sự suy nghĩ cảnh, suy tư trên đối tượng.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Tưởng", "definition": "(Saññā), sự nhớ biết cảnh, sự nhận ra đối tượng.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Tội Nghiêm Trọng", "definition": "(Abhiṭhāna).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Vật", "definition": "(Vatthu), sáu chỗ trú của thức.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Vị", "definition": "Tông Pháp Tướng trong đạo Phật phân tích tỉ mỉ mọi pháp (sự vật) trong thế giới. Vị trần, mộtt trong sáu trần (x. Trần) là vị nếm, được phân tích thành sáu là các vị: đắng, chua, ngọt, cay, nhạt, mặn. Kinh Niết Bàn ví sáu đạo lý được thuyết minh trong Kinh với sáu vị nếm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Xúc", "definition": "(Phassa, samphassa), sự chạm cảnh, sự đối chiếu, sự gặp gỡ giữa căn - cảnh - thức.", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Xứ", "definition": "H. Lục xứ .Nghĩa là tương đương với sáu nhập (lục nhập). Là sáu căn năng của người, ứng với sáu trần. Là những nơi ngoại cảnh (tức sáu trần) xâm nhập vào thân tâm chúng ta. Sáu xứ (cũng là sáu nhập hay sáu căn năng) là: Mắt, tai, mũi, lưỡi, thân (tiếp xúc với những đối tượng sờ mó được)và cuối cùng là ý căn, tương đương với từ ngữ khoa học hệ thần kinh. Những chữ Hán chỉ sáu xứ là nhãn, nhĩ, tỵ, thiệt, thân, ý. Kinh tạng Pali gọi là sáu xúc xứ (x. Trung Bộ Kinh III, bài Kinh “Giới Phân Biệt”)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Ân Đức Pháp", "definition": "(Dhammaguṇa), Đức Tính Của Giáo Pháp", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Sáu Điệu Rung Động", "definition": "Tremble and shake in six different ways", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sáu Đô Thành Lớn", "definition": "Kinh sách Phật thường nhắc tới sáu đô thành lớn. Nguyên trong thời Phật Thích Ca còn tại thế, Ấn Độ chia làm 16 nước, trong đó có sáu đô thành lớn, Phật thường hay lui tới thuyết pháp, kết nạp học trò. Trong sáu đô thành lớn đó có 4 thành phố được nhắc tên nhiều hơn cả là Thành Vệ Xá, thành Vaisali, thành Ba la nại (nay gọi là Bénares), và thành Vương xá.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Đường", "definition": "H. Lục đạo, lục thú. Đạo là đường. Thú là nơi hướng tới. Chúng sinh khi chưa thoát khỏi vòng sống chết luân hồi, thường phải tái sinh vào một trong sáu cõi (Cg, sáu đường).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Đại", "definition": "S. Mahabhutas; H. Lục đại Sáu chất lớn, có phổ biến trong vũ trụ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sáu Độ", "definition": "H. Lục độ Độ: Đi qua. Sáu hạnh lớn của các vị Bồ Tát, nếu thực hành trọn vẹn, đầy đủ, sẽ có công dụng đưa chúng sinh từ bờ mê đến bờ giác, từ bờ khổ đến bờ an lạc, cho nên gọi sáu hạnh lớn đó là sáu độ (lục độ). Sáu hạnh lớn đó là:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sâm", "definition": "參. Tên một vì sao trong Nhị thập bát tú. Xem Sâm thương Tên một thứ cây, rễ dùng làm vị thuốc rất quý. Ta cũng gọi là Sâm. Td: Nhân sâm Không đều nhau. Xem Sâm si Các âm khác là Tam, Tảm, Tham, Xam. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Dâm", "definition": "滲淫. Ngấm ướt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Hoành", "definition": "參橫. Sao Sâm ngang trời, chỉ đêm khuya.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Hà", "definition": "森河. Một tên chỉ sông Seine của Pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm La", "definition": "摻羅. Nhiều lắm, dẫy đầy. Như: La Liệt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm La Vạn Tượng", "definition": "Muôn tượng la liệt trong vũ trụ giống như trong rừng cây cối mọc um tùm. Trong Phật Giáo, Sâm La Vạn Tượng đặc biệt chỉ cho thế giới hiện tượng tương đối với bản thể, vì tính chất thiên sai vạn biệt của thế giới hiện tượng, cho nên sâm la vạn tượng là 1 khái niệm đối lại với vạn pháp nhất như của bản thể.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sâm Li", "definition": "襂纚. Dáng áo quần lượt thượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Liệt", "definition": "摻列. Đông, nhiều, thành từng hàng. Như Sâm la 摻羅.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Lâm", "definition": "森林. Rừng cây rậm rạp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Lâm Học", "definition": "森林學. Ngành khảo cứu về các nguồn lợi của rừng và khai thác lâm sản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Lâm Thư", "definition": "Xem A Luyện Nhã.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sâm Lậu", "definition": "滲漏. Thấm từng chút Chỉ bước đi hoặc việc làm chậm chạp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Lệ", "definition": "棽麗. Rủ xuống và đong đưa qua lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Nghiêm", "definition": "森嚴. Kín đáo khó khăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Si", "definition": "參差. So le không đều, cũng đọc là Sâm sai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Sâm", "definition": "森森. Vẻ rậm rạp tối tăm Dáng quần áo dài lượt thượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Sảng", "definition": "槮爽. Vẻ rậm rạp tươi tốt của cây cối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sâm Thương", "definition": "參商. Tên hai vì sao, tức sao hôm va sao mai, cứ sao này mọc thì sao kia lặn, không gặp nhau bao giờ. Chỉ sự cách xa. Bản dịch Chinh phụ ngâm khúc có câu: “Xưa kia hình ảnh chẳng rời, bây giờ nỡ để cách vời Sâm Thương” Sâm và Thương ta gọi lần là sao hôm và sao mai, nhưng sao hôm và sao mai là kim tinh, một hành tinh đi ở trong quỹ đạo trái đất. Theo sách Tả truyện của Tàu nói vua Cao tân thị đời thượng cổ có hai người con tên là Át Bá và Thực Trầm hay đánh nhau, vua đày Át Bá đi ở Thương khâu chủ sao Thần tức là sao Tâm, bởi vậy gọi sao Thần là sao Thương, và đày Thực Trầm đi ở Đại hạ chủ sao Sâm. Khi sao Sâm ở đông thì sao Thương ở tây, không bao giờ gặp nhau. Người đời sau gọi anh em không hoà mục là Sâm Thương. “Sâm Thương chẳng vẹn chữ tòng, tại ai, há dám phụ lòng cố nhân” (Kiều ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân", "definition": "Dosa (S), Dveṣa (S), Dosa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Cấu", "definition": "嗔詬. Giận dữ mắng chửi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân Hận", "definition": "Abhisajjati (abhi + sad + ya), abhisajjana (trung), dosa (nam), sārambha (nam), vera (trung), vyāpāda (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sân Hỏa", "definition": "Lửa sân. Khi sân giận, lòng như bốc lửa.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sân Khuể", "definition": "Solère anger 瞋恚 pratigha", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Sân Khuể Cái", "definition": "Phạm: Pàli: Vyàpàda-nìrvaraịa. Sân khuể là sự nóng giận; Cái là cái lọng, cái nắp, che đậy; là tên gọi khác của phiền não. Nghĩa là sự nóng giận ví như cái lọng, cái nắp che lấp tâm tính, cản trở thiền định nên gọi là Sân khuể cái, là 1 trong Ngũ Cái.[X. Luận Đại Tì Bà Sa Q.38; Luận Câu Xá Q.21]. (xt. Ngũ Cái).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sân Khuể Hỏa", "definition": "Lửa nóng giận. Sự giận tức ví như ngọn lửa, có khả năng thiêu đốt tất cả công đức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sân Khuể Tam Chủng Phát Tướng", "definition": "嗔恚三種發相 (Thích Thiền Ba La Mật Thứ Đệ Pháp Môn)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sân Kim", "definition": "嚫金. Tiền của bố thí cho tăng sĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân Kết", "definition": "Xem Não hại.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Mục", "definition": "瞋目. Trợn mắt, trừng mắt giận dữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân Nghễ", "definition": "嗔睨. Lườm nguýt giận ghét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân Nhuế", "definition": "Vyāpāda (S), Ill-will Anger.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Nhuế Cái", "definition": "Pratigha-āvaraṇa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Nhuế Tưởng", "definition": "Vyāpāda-saṃjñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Nhà", "definition": "Ajira (trung), gehaṅgaga (trung),gharājira (trung), caccara (trung), aṅgaṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sân Phược", "definition": "Dveṣa-bandhana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Si", "definition": "嗔癡. Giận dữ và say mê Giận dữ mất khôn. Đoạn trường tân thanh có câu: “Liệu năn nỉ, chớ sân si thiệt đời”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân Sân", "definition": "侁侁. Đông đảo. Chen chúc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sân Thượng", "definition": "Ākāsatala (trung), mahātala (trung), vedikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sân Trước", "definition": "Paghaṇa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sân Tâm", "definition": "Dosa-mūla-citta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sân Tâm Bất Thụ Hối Giới", "definition": "Cũng gọi Sân Bất Thụ Hối Giới, Sân Bất Thụ Tạ Giới, Cố Sân Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sân Tẩu Hống Địa", "definition": "瞋 瞍 吼 地. Phùng mang trợn mắt. Tục ngữ đời Tống, nghĩa là sự giận dữ như lửa cháy mạnh. Sân: nóng giận, Tẩu: trợn mắt, Hống: kêu rống, Địa: trợ từ ngữ vĩ. Chính Pháp Nhãn Tạng q. 1 của Đại Huệ Tông Cảo (Vạn Tục 118, 2 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sân Đẩu Hậu Địa", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sân Đập Lúa", "definition": "Khalamaṇḍala (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sân Độc", "definition": "Lòng giận như thuốc độc, làm hại chính bản thân con người sân giận.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sâu", "definition": "Anuttāna (tính từ) Kimi (nam), pāṇaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sâu Bướm", "definition": "Lomasapāṇaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sâu Mầu", "definition": "Profound and abstruse", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sâu Thẳm", "definition": "Gambhīra (tính từ) gādha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sâu Xa", "definition": "Gambhīra (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sãi Vãi", "definition": "Tác phẩm của Nguyễn Cư Trinh theo thể phú, ghi chép lại cuộc đàm thoại giữa một ông Sãi (ông sư) và một bà Vãi (bà sư). Tác phẩm dùng rất nhiều điển tích nhằm mục đích lấy chuyện đời xưa, giáo dục người đời này. Ông sãi tỏ ra học thức uyên bác, lý luận vững trãi. Tác phẩm gồm những câu dài ngắn, không nhất định khoảng 340 câu tất cả.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Séance", "definition": "A group procedure requiring a medium who communicates with the spirit world.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Sét Đánh", "definition": "Meghanāde (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sí", "definition": "啻. Chỉ có Bất sí 不啻: Chẳng những. Không chỉ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sí Di La", "definition": "Một loại áo ca sa. Áo này được may bằng lông cánh chím. [X. Tứ Phần Luật Khai Tông Kí Q.6]. (xt. Ca Sa).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sí Do La", "definition": "Phạm: Keyùra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sí Xá Khâm Bà La", "definition": "Phạm: Kezakambala.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sí Đầu Mạt", "definition": "S. Kurkutarana. Thành Sí đầu Mạt là nơi Phật Di Lặc sẽ hạ sinh, theo Kinh Phật Thuyết Di Lặc Thành Phật Kinh, bản dịch của Cưu Ma La Thập. Cũng có sách dịch là Kê Đầu, như bản dịch của Trúc Pháp Hộ. Sí đầu Mạt còn là tên tu viện nổi tiếng do vua A Dục (Ấn Độ) xây dựng tại thành phố Pataliputra. Tu viện này sau bị Pusiyamitra phá hủy trong cuộc đàn áp Phật giáo năm 187 TCN.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sính", "definition": "俜. Sai khiến Người thay mặt vua ở nơi xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Biện", "definition": "逞辯. Thích tranh luận cãi cọ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Bộ", "definition": "騁步. Bước mau. Rảo bước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Chí", "definition": "逞志. Thích ý. Vui thích trong lòng mà lộ ra ngoài. Như: Khoái chí.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Cường", "definition": "逞强. Thích sức mạnh, hay cậy sức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Dụng", "definition": "聘用. Đem lễ vật mời người hiền tài ra đề dùng vào việc nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Hiền", "definition": "聘賢. Đem lễ vật tới mời người có đức độ tài năng ra giúp nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Hoài", "definition": "騁懷. Cởi mở lòng dạ, thoả lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Hung", "definition": "逞凶. Thích làm những việc dữ dằn độc ác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Hội", "definition": "娉會. Người vợ mới làm đám hỏi, chưa cưới, tức vị hôn thê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Khẩu", "definition": "逞口. Thích dùng miệng lưỡi để tranh luận. Như Sính biện 逞辯.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Kim", "definition": "聘金. Số tiền mà nhà trai nộp cho nhà gái trong lễ hỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Lễ", "definition": "聘禮. Việc tổ chức đám hỏi Vật đem tới nhà gái trong đám hỏi Vật đem tới nhà người hiền tài để mời ra giúp nước Tặng vật dùng vào việc thăm viếng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Mệnh", "definition": "聘命. Tờ giấy giao ước làm giữa nhà trai và nhà gái trong đám hỏi, để sau này không bên nào thay đổi việc nhân duyên được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Mục", "definition": "騁目. Đưa mắt nhìn bốn phía cực xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Nghi", "definition": "聘儀. Lễ hỏi vợ Chỉ chung tiền bạc và vật dụng mà nhà trai phải nạp cho nhà gái trong lễ hỏi. Cũng như Sính lễ 聘禮. Đoạn trường tân thanh có câu: “Rằng mua ngọc đến Lam kiều, sính nghi xin dạy bao nhiêu cho tường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Nguyện", "definition": "逞願. Thoả lòng mong ước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Nhân Ngã", "definition": "逞 人 我. Còn gọi: Tranh Nhân Ngã. Tỏ rõ sức mạnh. Vĩnh Gia Chứng Đạo Ca ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sính Năng", "definition": "騁能. Phô trương được hết sự tài giỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Quân", "definition": "聘君. Người có tài đức, được triều đình đem lễ vật tới mời ra giúp nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Thê", "definition": "聘妻. Người vợ mới làm lễ hỏi, chưa cưới, tức vị hôn thê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Tuấn", "definition": "逞 俊. Trổ tài. Huệ Nam Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sính Tâm", "definition": "逞心. Vừa lòng, hài lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Túc", "definition": "騁足. Thả sức chạy thật mau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Vấn", "definition": "聘問. Hỏi vợ Hỏi han thăm viếng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Vọng", "definition": "騁望. Rong ruổi khắp nơi mà xem ngắm Đưa mắt trông xa thật xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sính Ác", "definition": "逞惡. Hay làm, thích làm việc xấu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sò", "definition": "Sambuka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sóc", "definition": "揱. Nhỏ bé. Nhỏ nhặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Biên", "definition": "朔邊. Ranh giới phía bắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Bắc", "definition": "朔北. Vùng đất phía bắc Hướng bắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Cảnh", "definition": "朔境. Vùng đất phía bắc. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “Trời Giản phố vận ra Sóc cảnh, trải bao phen gian hiểm mới có ngày nay” (Sóc cảnh đây chỉ đất Bắc hà).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Hối", "definition": "朔晦. Ngày đầu tháng và cuối tháng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Khí", "definition": "朔氣. Thời tiết trong thời gian đầu tháng âm lịch Thời tiết ở phía bắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Mạc", "definition": "朔漠. Vùng rộng lớn có cát ở phía bắc Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Nguyệt", "definition": "朔月. Ngày mồng một âm lịch. Ngày đầu tháng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Nhật", "definition": "朔日. Ngày mồng một, đầu tháng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Phong", "definition": "朔風. Gió thổi từ hướng bắc. Gió bấc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Phương", "definition": "朔方. Hướng Bắc Vùng đất phía bắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Thiều", "definition": "箾韶. Tên điệu nhạc đời vua Thuấn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Thực", "definition": "朔食. Bữa ăn ngon, thịnh soạn trong ngày mồng một đầu tháng âm lịch, phong tục cổ Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóc Vọng", "definition": "朔望. Ngày mồng một và ngày rằm âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sóng", "definition": "Taraṅga (nam), ummi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sóng Sông Hằng", "definition": "Gaṅgālaharī (S), Wave of the Ganges.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sóng To", "definition": "Ullola (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sóng Điện", "definition": "Ūmi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sót", "definition": "Virādheti (vi + radh + e), sāvasesa (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sô", "definition": "𠣧. Như chữ Sô 芻.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Cảo", "definition": "芻稿. Cỏ và rơm Chỉ sự thấp kém, không giá trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Cẩu", "definition": "芻狗. Con chó bện bằng rơm. Thứ đồ chơi vô giá trị. Chỉ muôn vật ở đời (theo quan niệm của Lão tử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Ha", "definition": "Xem Ta Bà Ha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sô Hống", "definition": "騶哄. Lính cưỡi ngựa đi trước, la hét giẹp đường cho quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Kị", "definition": "騶騎. Người cưỡi ngựa. Lính cưỡi ngựa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Lương", "definition": "芻糧. Cỏ cho ngựa và đồ ăn cho binh lính. Chỉ chung lương thực dùng trong quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Lạp Ngư Tiều", "definition": "芻獵漁樵. Cắt cỏ, đi săn, đánh cá, kiếm củi, công việc làm của người ở ẩn. Chỉ sự ở ẩn. Xem thí dụ ở chữ Sô 芻.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Ma", "definition": "Phạm: Kwuma.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sô Mục", "definition": "芻牧. Chăn súc vật và cắt cỏ cho súc vật ăn. Chỉ việc chăn nuôi súc vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Nghị", "definition": "芻議. Lời bàn bạc quê mùa kém cỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Ngu", "definition": "(騶虞, sūgu):", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sô Ngôn", "definition": "芻言. Lời nói quê mùa vụng về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Tòng", "definition": "騶從. Lính cưỡi ngựa đi theo hộ vệ cho quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Tốt", "definition": "騶卒. Như Sô tòng 騶從 Cũng chỉ lính trong phủ quan, làm các công việc lặt vặt do quan sai bảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Vị", "definition": "芻胃. Dạ dày của loài thú vật nhai lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sô Xướng", "definition": "騶唱. Như Sô hống 騶哄 Lính cưỡi ngựa đi rao truyền mệnh lệnh của quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sôi Tim", "definition": "Pheṇuddehakaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sông", "definition": "Āpagā (nữ) Saritā (nữ), savantī (nữ), nadī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sông A Trí La Phạt Để", "definition": "Aciravati (P, S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sông Bạt Đề", "definition": "Ajitavati: là một trong hai con sông nhỏ ở Ấn-độ, nhưng do có thánh tích của Phật mà được nổi tiếng.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sông Diêm Phù", "definition": "Jambū River.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sông Hằng", "definition": "Ganga: là một con sông lớn ở Ấn-độ, cát sông rất nhiều và nhỏ mịn. Mỗi khi đức Phật dùng thuật ngữ “hằng hà sa” (cát sông Hằng) trong lúc nói pháp, đều là để tỉ dụ cho con số nhiều nhất. Sông Hằng phát nguyên từ cao nguyên Tây-tạng, ở độ cao 4.200m, chảy theo hướng Đông-Nam, trải dài 800km, đến xứ Bengal của Đông Ấn-độ thì hợp lưu với sông Brahmaputra, rồi chảy ra biển Ấn-độ, tổng cộng chiều dài khoảng 2.700 km. Vùng đất chạy dài dọc theo hai bên bờ sông, khoảng 1.500 km, có vô số đền miếu, được xem là vùng đất thần thánh của dân Ấn, tín đồ của các đạo giáo thường đến đây lễ bái cầu nguyện. Tục gọi sông này là sông Phúc-đức, và cho rằng tắm ở sông này sẽ được tiêu trừ tội cấu; phong tục giành nhau nhảy xuống sông tắm, vẫn còn giữ đến ngày nay. Vùng thượng lưu sông Hằng là trung tâm văn minh của Ấn-độ thời thái cổ, được gọi là văn minh Phệ Đà. Sau đó, đến thời đại Áo Nghĩa Thư (trước khi đức Phật ra đời) thì trung tâm văn minh Ấn-độ dời xuống vùng trung lưu. Đến thời Phật giáo xuất hiện với đức giáo chủ là Phật Thích Ca Mâu Ni, thì vùng đất trải rộng ở cả hai bên bờ sông Hằng đã trở thành khu vực hoạt động hành đạo trọng yếu của đức Phật và giáo đoàn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sông Lớn", "definition": "Sindhu (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sông Ni liên", "definition": "Neranjara : tức là sông Ni-liên-thiền, một chi lưu của sông Hằng, là dấu tích nơi đức Phật đã từng tắm rửa trước khi thành đạo. Sông Ni-liên phát nguyên từ vùng Bengal, chảy hướng lên phương Bắc, đến xứ Phật-đà-già-da (Buddha Gaya – thuộc địa phận nước Ma-kiệt-đà) thì nhập chung với sông Mạc-hãn-na (Mohana), rồi tiếp tục chảy đến phía Đông thành phố Patna thì đổ vào sông Hằng.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sùng", "definition": "崇. Cao như núi. Cao Cao quý Cho là cao quý, lấy làm kính trọng lắm Ưa chuộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Bi", "definition": "崇碑. Dựa bia cao, chỉ sự ghi nhớ công đức của bậc anh hùng. Thường nói: Sùng bi vĩ tượng (dựng bia cao, đắp tượng lớn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Binh", "definition": "崇兵. Ưa chuộng việc chiến tranh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Bái", "definition": "Xem Lễ bái.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sùng Chiếu", "definition": "崇 照 (?-1342). Thiền tăng đời Nguyên, họ Đoạn, người Phổ Ninh (nay thuộc Vân Nam), Trung Quốc. Sư nối pháp thiền sư Trung Phong Minh Bản, làm truyền nhân tông Lâm Tế, trụ trì chùa Bàn Long trên núi Bàn Long tại Vân Nam.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Do", "definition": "崇蕕. Coi trọng thứ cỏ do, là thứ cỏ hôi, ý nói vua dùng kẻ không có tài đức. Chiến Tụng Tây hồ phú của Phạm Thái có câu: “Khóm do nọ hẳn đến ngày thì cắt, kẻ muốn tình chung mà rửa sạch, bỗng buông tuồng gian ác lại sùng do”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Dụ", "definition": "崇 㭲 (1304-1378). Thiền tăng đầu đời Minh cuối đời Nguyên, họ Trần, tự Ước Chi, người Tỳ Lăng (Thường Châu, Giang Tô), Trung Quốc. Năm 16 tuổi, sư vào viện Thọ Xương theo Đông Lâm Hiểu Công xuất gia, cầu thụ giới cụ túc. Sau lên núi Song Kính yết kiến Tịch Chiếu Đoan Công xin làm thị giả. Đến núi Thiên Mục tham vấn Phật Huệ Nghĩa Công. Đến chùa Trung Thiên Trúc, Quảng Trí Hân Công vừa gặp đã kính trọng sư, ngôn ngữ khế hợp bèn được ấn chứng. Nhậm chức Duy Na, chẳng bao lâu lên chức Chủ Tạng thất, y chỉ hơn muời năm được trọn đạo pháp của Hân Công. Đời Nguyên, niên hiệu Chí Thuận thứ 2 (1331), sư ra trụ trì Quang Hiếu Thiền Tự ở Thái Bình (An Huy) rồi sang Sùng Thắng Thiền Tự ở Cửu Giang (Giang Tây). Đời Minh, niên hiệu Hồng Vũ thứ 1 (1368) sư sang trụ Sùng Thắng Thiền tự ở Cửu Giang (Giang Tây). Đời Minh, niên hiệu Hồng Vũ thứ 1 (1368) sư sang trụ chùa A Dục Vương ở Tứ Minh; Hồng Vũ thứ 5 (1372) sư đến Kinh Sư hiến kệ đẹp lòng vua, vua ngợi khen ban thưởng trọng hậu. Tác phẩm: Tam Hội Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Giác Tự Thiết Tháp", "definition": "崇 覺 寺 鐵 塔. Tục gọi: Tế Ninh Thiết Tháp. Nằm trong khuôn viên chùa Thiết Tháp, thành phố Tế Ninh, tỉnh Sơn Đông, Trung Quốc. Sùng Giác tự còn gọi “Thích Ca Thiền Tự”, xây dựng vào niên hiệu Hoàng Kiến thứ 1 (560) đời Bắc Tề. Tháp xây vào niên hiệu Sùng Ninh thứ 4 (1105) đời Tống, ban đầu 7 tầng. Niên hiệu Vạn Lịch thứ 9 (1581) đời Minh xây thêm 9 tầng. Hình bát giác cao 23,8m. Tòa nền xây gạch xanh, bốn mặt mở ra cửa cuốn hình vuông, trong tâm thất tháp hiện còn “Thiên thủ Phật tạo tượng” đời Tống, bia “ký tháp sự” niên hiệu Quang Tự thứ 7 (1881) đời Thanh. Mỗi tầng do ba phần lan can tòa bằng, thân tháp, mái cong hợp lại mà thành. Tòa bằng, mái cong đều dùng đấu củng ngẩng cao nâng đỡ. Bốn mặt của mỗi tầng mở ra cửa hình chữ nhật, đặc biệt bên ngoài bốn mặt thiết kế khám thờ 2 tượng Phật. Vách tháp tầng 1, tầng 2 có đúc minh ký: “Đại Tống Sùng Ninh ất Dậu Thường Thị Hoàn Phu Từ Vĩnh An Nguyện Cẩn Chú”. Tầng đỉnh bát giác có treo phong linh, lắp đặt sát tòa hoa sen bằng đồng, tháp sát bình báu bằng vàng ròng. Tháp này mô phỏng kiến trúc gỗ đặc điểm nặng nề, tạo dáng mỹ quan.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Huyền Thự", "definition": "Chỉ cho cơ quan trung ương thống lãnh tăng ni, đạo sĩ ở đầu đời Đường, trách nhiệm như những tăng quan nắm giữ giấy tờ sổ sách và trông coi các việc trai đàn... Đầu tiên cơ quan này được đặt dưới quyền Hồng Lô Tự. Về sau, quyền hạn dần dần thu hẹp, không còn độc lập nữa mà phải chịu lệ thuộc dưới sự điều khiển của các quan thế tục. [X. Đường Thư Bách Quan Chí 38].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sùng Huệ", "definition": "崇 慧. 1. Thiền tăng đời Đường (?-779), họ Trần, nối pháp Thiền Sư Trí Oai, thuộc tông Ngưu Đầu đời thứ 6. Khoảng niên hiệu Càn Nguyên (758-759) sư khai sơn núi Thiên Trụ. 2 Thiền tăng đời Đường, họ Chương, người Hàng Châu, Trung Quốc. Sư nối pháp Thiền Sư Kính Sơn Pháp Khâm, thuộc tông Ngưu Đầu đời thứ 8, trụ chùa Chương Tín, sư là “Cân Tử Sơn Hàng Ma Thiền Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Hư Danh", "definition": "崇虚名. Chuộng cái tiếng tăm hão huyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Kính", "definition": "崇敬. Rất tôn trọng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Lâu", "definition": "崇樓. Toà nhà lầu cao Chỉ nhà quyền quý. Thường nói: Sùng lâu kiệt các (lầu cao gác lớn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Lệ", "definition": "崇麗. Cao lớn đẹp đẽ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Mộ", "definition": "Saddhā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sùng Nhai", "definition": "崇崖. Sườn núi cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Nhân Đại Sư", "definition": "崇 因 大 師. Hiệu của Thiền tăng Thanh Hộ đời Ngũ Đại. X. Thanh Hộ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Nhạc", "definition": "崇 岳 (1132-1202). Thiền tăng đời Tống, họ Ngô, hiệu Tùng Nguyên, người Long Tuyền, Xử châu (Chiết Giang), Trung Quốc. Thuở nhỏ sư có chí xuất gia, 23 tuổi mới thọ ngũ giới làm Sa Di, lần lượt tham kiến các bậc tôn túc trong thiền lâm như: Yết Linh Thạch Diệu. Đại Huệ Tông Cảo, ứng Am Đàm Hoa v. v… Niên hiệu Long Hưng thứ 2 (1164) sư được độ nơi Tinh xá Bạch Liên ở Tây Hồ, đi du phương tham học với các thiền sư ở Giang Nam, Chiết Giang. Sau sư tham kiến Thiền Sư Mật Am Hàm Kiệt, nghe tăng hỏi câu “Chẳng phải tâm, chẳng phải Phật, chẳng phải vật”, sư hoát nhiên đại ngộ, nối pháp làm truyền nhân phái Dương Kỳ tông Lâm Tế. Sư lần lượt trụ chùa Báo Ân Quang Hiếu, các thiền viện Thật Tế, Tiến Phúc, Trí Độ, Vân Nham hoằng hóa cực thịnh. Niên hiệu Khánh Nguyên thứ 3 (1197) sư trụ trì chùa Linh ẩn và khai sáng chùa Hiển Thân Báo Từ. Đệ tử Thiện Khai, Quang Mục vì sư biên tập Tùng Nguyên Hòa Thượng Ngữ Lục 2 quyển. Lục Du soạn tháp minh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Ninh Thanh Quy", "definition": "(崇寧清規): xem Thiền Uyển Thanh Quy(禪苑清規, Zennenshingi) (禪苑清規, Zennenshingi): 10 quyển, do Tông Trách (宗賾, ?-?) ở Trường Lô (長蘆) soạn, bản san hành đề năm thứ 2 (1103) niên hiệu Sùng Ninh (崇寧). Bách Trượng Hoài Hải (百丈懷海, 749-814) lần đầu tiên chế ra quy cũ Thiền môn qua bộ Bách Trượng Thanh Quy (百丈清規), nhưng bộ này bị tán thất và đến thời Huy Tông (徽宗, tại vị 1100-1125) nhà Tống thì không còn thấy bóng dáng nó nữa. Thấy vậy, Tông Trách rất cảm hoài, nên mới đi tìm lại những dấu vết về cách thức hành pháp vốn hiện tại đang còn hành trì tại các ngôi chùa xưa lúc bấy giờ, rồi ông biên tập lại thành bản quy định về quy cũ Thiền môn. Vì bản này được hình thành vào năm thứ 2 niên hiệu Sùng Ninh nhà Tống, nên còn được gọi là Sùng Ninh Thanh Quy (崇寧清規). Trong các bản Thanh Quy hiện tồn thì đây được xem như là bản xưa nhất, có thể giúp chúng ta hồi tưởng lại những quy cũ ngày xưa thời Bách Trượng như thế nào, và trở thành bản chuẩn cứ cho các bản Thanh Quy sau này ra đời. Bản này giải thích rất rõ từng chi tiết về hành vi của vị Thiền tăng, các chức vụ, cũng như tác pháp oai nghi tế hạnh hằng ngày. Trong đó còn có những đoạn văn như Quy Kính Văn (龜敬文), Tọa Thiền Nghi (坐禪儀), Tự Cảnh Văn (自警文), v.v. Vào năm thứ 2 (1202) niên hiệu Gia Thái (嘉泰), Ngu Tường (虞翔) cho tái san hành; đến năm thứ 2 (1254) niên hiệu Bảo Hựu (寶祐), Bản Cao Lệ (高麗本, Triều Tiên) bắt đầu xuất hiện. Tại Nhật Bản, có Bản Ngũ Sơn (五山本) được san hành dưới thời Nam Bắc Triều (1336-1392), bản ghi năm thứ 6 (1709) niên hiệu Bảo Vĩnh (寶永), bản ghi năm thứ 8 (1796) niên hiệu Khoan Chính (寛政); và tả bản của Kim Trạch Văn Khố (金澤文庫, Kanazawa-bunko) thuộc giữa thời Liêm Thương (鎌倉, Kamakura, 1185-1333).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sùng Phúc Tự", "definition": "Chùa ở Trường An, tỉnh Thiểm Tây, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sùng Phúc Tự Chí", "definition": "崇 福 寺 志. Chí, 4 quyển, do Chu Văn Tảo soạn vào đời Thanh, Thích Chân Nguyên hiệu đính, được xếp vào Trung Quốc Phật Tự Sử Chí Vựng San tập 1. Chùa Sùng Phúc là 1 trong những Tổ đình của tông Lâm Tế. Niên hiệu Gia Khánh thứ 6 (1801) đời Thanh, Chu Văn Tảo bắt đầu soạn “Sùng Phúc Tự Chí”, chia ra lịch trình thay đổi và phát triển của tự vũ, trụ trì tam môn, và còn được sự hiệu đính của Thích Chân Nguyên. Niên hiệu Quang Tự thứ 7 (188l), Tiền Đường Đinh Bính cho in lại, phía sau phụ “Trùng Kiến Sùng Phúc Tự Bi ký”. Quyển chí này từ niên hiệu Gia Khánh trở về trước, phần văn hiến của chùa Sùng Phúc đều được sưu tập đầy đủ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Phước Tự", "definition": "(崇福寺, Sūfuku-ji): ngôi tự viện cổ tọa lạc tại Ōtsu-shi (大津市), Shiga-ken (滋賀縣), hiện tại là ngôi chùa hoang phế. Tương truyền năm 668, sau khi dời đô về kinh đô Đại Tân (大津, Ōtsu), Thiên Trí Thiên Hoàng (天智天皇, Tenchi Tennō) đã xây dựng ngôi chùa này trong ngọn núi phía Tây Bắc cung thành, tôn thờ tượng Di Lặc Bồ Tát nơi đây. Chùa rất hưng thạnh cho đến thời đại Bình An, về sau thì trải qua nhiều lần bị hỏa hoạn rồi dẫn đến tình trạng hoang phế. Vào năm 1230, chùa phụ thuộc vào Viên Thành Tự (園城寺, Onjō-ji), rồi sau đó thì bị phế tuyệt luôn", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sùng Phạm", "definition": "崇 梵 (1004-1087). Thiền tăng đời cuối Lê đầu Lý, thuộc dòng Tỳ Ni Đa Lưu Chi, đời thứ 11. Sư họ Mâu, dáng vẻ mạnh mẽ to lớn, hai trái tai thòng đến vai. Xuất gia xong, sư đến tham vấn với ngài Vô Ngại ở Hương Thành. Sau khi được tâm ấn, sư dạo khắp nước Thiên Trúc để cầu học hỏi sâu rộng. Mãn chín năm sư trở về nước, gồm thông giới định. Về sau, sư thuyết giảng Phật pháp tại chùa Pháp Vân làng Cổ Châu, Long Biên. Học trò các nơi tụ về rất đông. Hoàng đế Lê Đại Hành nhiều phen thỉnh sư vào cung để thưa hỏi huyền chỉ. Vua lấy lễ đãi sư rất trọng hậu. Đến năm Quảng Hựu thứ 3 triều Lý (1087) nhằm năm Đinh Mão, sư viên tịch, thọ 84 tuổi. Vua Lý Nhân Tông có làm bài kệ truy tặng sư:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Phụng", "definition": "崇奉. Coi trọng, thờ kính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Sơn", "definition": "崇山. Ngọn núi cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Thao", "definition": "崇 瑫. Thiền tăng đời Minh, tên đời là Triệu Dữu, tự Hoán Chi, hiệu Đại Dữu, người Ngô Giang (nay thuộc Giang Tô) Trung Quốc. Sư nối pháp thiền sư Linh Nham Kế, trụ trì chùa Thiên Thai Quốc Thanh, mọi người gọi sư là Đại Dữu Hòa Thượng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sùng Thượng", "definition": "崇尚. Quý trọng ưa chuộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Trọng", "definition": "崇重. Coi làm cao quý đáng kính lắm. Cũng như: Tôn trọng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Tuấn Thiên Hoàng", "definition": "(崇峻天皇, Sushun Tennō, tại vị 587-592): vị Thiên Hoàng sống vào cuối thế kỷ thứ 6, con của Khâm Minh Thiên Hoàng (欽明天皇, Kimmei Tennō), tên là Bạc Lại Bộ (泊瀬部), nơi vua ở là Sài Thản Cung (柴坦宮) thuộc Thương Thê (倉梯, Kurahashi) thuộc nước Đại Hòa (大和, Yamato). Ông rất phẩn uất vì sự chuyên quyền của tay Đại Thần Tô Ngã Mã Tử (蘇我馬子, Soga-no-Umako) và định tìm cách hạ bệ tên này, nhưng ngược lại cuối cùng lại bị Tô Ngã ám sát.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sùng Tín", "definition": "崇信. Coi là cao quý và hết lòng tin tưởng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Văn", "definition": "崇文. Tôn trọng văn hoá Ham chuộng văn chương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sùng Đạo", "definition": "Saddha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sùng Đức", "definition": "崇徳. Quý chuộng nết tốt Coi trọng người có nết tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc", "definition": "𠬀. Như chữ Súc 畜.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Chủ", "definition": "畜主. Người nuôi thú vật trong nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Chủng", "definition": "蓄種. Cất chứa hạt giống, để chờ gieo hạt Chỉ sự giữ gìn tài đức để chờ dịp dùng tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Dưỡng", "definition": "畜養. Chăn nuôi thú vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Hận", "definition": "蓄恨. Chứa điều giận ghét trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Lự", "definition": "蓄慮. Chứa điều nghĩ ngợi, ý nói suy nghĩ sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Lực", "definition": "畜力. Chứa sẵn sức mạnh để chờ dùng vào việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Miêu Phòng Thử", "definition": "畜猫防鼠. Nuôi mèo để ngừa chuột, ý nói luyện tập quân lính để phòng khi giặc tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Miệng", "definition": "Mukhadhovana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Súc Mễ", "definition": "畜米. Chứa gạo để dành khi cần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Mục", "definition": "畜牧. Chăn nuôi thú vật. Cũng nói: Mục súc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Nang", "definition": "縮囊. Cái túi cứ co rút lại, chỉ sự dần dần nghèo khổ đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Ngãi", "definition": "蓄艾. Lá ngải phơi khô, cất dành để chứa bệnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Nhuệ", "definition": "蓄鋭. Giữ gìn sự mạnh mẽ hăng hái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Oán", "definition": "蓄怨. Giữ niềm thù giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Rửa", "definition": "Pakkhāleti (pa + khal + e), vikkhāleti (vi + khāl + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Súc Sanh", "definition": "Tiracchāna (P), Tiraścīna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Súc Sanh Đạo", "definition": "Tiryayoni-gati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Súc Sinh", "definition": "Là tiếng dịch ý từ Phạn ngữ “tiryanc”. Súc-sinh (hay Bàng-sinh) là một trong sáu nẻo luân hồi, chỉ cho tất cả các loài động vật như thú rừng, gia súc, chim muông, rắn rít, cá tôm, côn trùng v.v... Từ “súc sinh” nguyên được dùng để chỉ cho các loài vật được người ta nuôi trong nhà, chủ yếu là gia súc (trâu, bò, ngựa, chó, dê v.v...) và gia cầm (chim, gà, ngỗng, v.v...). Vì vậy, các nhà tân dịch đã dùng từ “bàng sinh” để dịch Phạn ngữ “tiryanc”, chỉ tổng quát cho tất cả các loài động vật. “Bàng sinh” nghĩa là các sinh vật đi mình ngang (khác với loài người là đi mình thẳng đứng). Tuy nhiên, vì thói quen lâu đời, từ “súc sinh” vẫn được dùng nhiều, và thịnh hành cho tới ngày nay. Một cách tổng quát, súc sinh có thể chia làm ba loại: loại bay trên không; loại đi, bò trên hay dưới mặt đất; và loại bơi lội trong nước. Hoặc bốn loại: loại sinh ra từ bào thai (thai sinh); loại sinh ra từ trứng (noãn sinh); loại sinh ra từ nơi ẩm thấp (thấp sinh); loại sinh ra từ sự biến hóa từ hình thức này sang hình thức khác (hóa sinh). Hoặc chia chi tiết hơn: loại nhiều chân; loại bốn chân; loại hai chân; loại không có chân; loại có lông; loại có sừng; loại có vảy; loại da trơn; loại có mai; loại có vỏ; loại bò sát; v.v... Có loại sinh hoạt ban ngày; có loại sinh hoạt ban đêm; có loại sinh hoạt cả ban ngày lẫn ban đêm. Đặc tính của các loài súc sinh là không có trí sáng suốt và hay giết hại, ăn thịt lẫn nhau; các loài yếu kém luôn luôn bị các loài mạnh bạo, hung dữ ăn thịt. Các loài gia súc thì thường bị con người đánh đập, hành hạ và ăn thịt. Các loài thú rừng, tôm cá v.v... còn bị con người giết hại để ăn thịt, hoặc lấy lông, da, sừng v.v... để làm các thứ vật dụng. Đó là những nỗi thống khổ cùng cực của thế giới Súc-sinh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Súc Sinh Giới", "definition": "Chỉ cho thế giới của loài súc sinh, 1 trong 10 giới do tông Thiên Thai lập ra. Các loài sinh sống trong thế giới này là những chúng sinh ngu si, do kiếp trước tạo nghiệp ác mà chuyển sinh đến. (xt. Thập Giới, Súc Sinh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Súc Sinh Hữu", "definition": "Quả báo của loài súc sinh là có thật, 1 trong 7 Hữu được nói đến trong Trường A Hàm Thập Báo Pháp Kinh quyển thượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Súc Sinh Nhân", "definition": "Nghiệp nhân dẫn sinh vào đường súc sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Súc Sinh Thú", "definition": "Thú là con đường, cũng có nghĩa là cõi. Cõi sống của loài súc sinh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Súc Sinh Thực Thời", "definition": "Chỉ cho thời gian ăn uống của loài súc sinh, 1 trong 4 thời ăn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Súc Sinh Đạo", "definition": "Cũng gọi Súc Sinh Thú.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Súc Súc", "definition": "縮縮. Vẻ thẹn thùng, hổ thẹn (co rúm người lại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Sản", "definition": "畜產. Đồ vật làm ra được nhờ nghề chăn nuôi thú vật (chẳng hạn sữ bò, lông cừu…).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Sắc", "definition": "Akkha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Súc Thái", "definition": "蓄菜. Loại rau phơi khô để dành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Thủ", "definition": "縮手. Rụt tay lại Không ngó ngàng gì tới nữa Không dính dấp, can thiệp tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Tích", "definition": "蓄積. Cất chứa Chứa đựng nhiều tư tưởng, ý nghĩa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Tụ", "definition": "蓄聚. Gom chứa cất giữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Tửu", "definition": "縮酒. Lọc bỏ bã rượu để có rượu trong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Tỵ Nhân Duyên", "definition": "搐 鼻 因 緣. Công án vặn mũi. Công án này được thấy nơi chương Hoài Hải, đời thứ 3 dưới Đại Giám trong CTTNL q. 1 như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Súc Vật", "definition": "Paśu (S), Animals Pasu (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Súc Y Tiết Thực", "definition": "蓄衣節食. Cất dành quần áo và giảm bớt ăn uống để dành dụm. Chỉ sự tiết kiệm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Điện Trì", "definition": "蓄電池. Ao chứa điện, tức bình điện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Đầu", "definition": "縮頭. Rụt đầu lại, vẻ sở hãi. Thường nói Súc đầu súc não (hay dùng trong Bạch thoại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súc Địa", "definition": "縮地. Rút đất lại cho gần, nói về phép tiên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súng", "definition": "銃. Cái lỗ ở cái rìu, chỗ để tra cán rìu vào Dụng cụ để bắn đạn. Ta cũng gọi là cây súng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súy", "definition": "帥. Người đứng đầu quân đội. Td: Nguyên suý Cũng đọc Soái Một âm khác là Suất. Xem Suất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súy Kì", "definition": "帥旗. Lá cờ hiệu của vị tướng đứng đầu quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súy Lệnh", "definition": "帥令. Điều mà vị tướng đứng đầu quân đội buộc cấp dưới phải thi hành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Súy Phủ", "definition": "帥府. Nơi làm việc của vị tướng đứng đầu quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sāmaññalakkhaṇa", "definition": "Ba tướng phổ thông, trạng thái chi phối pháp hữu vi", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Sāsana", "definition": "Hai loại giáo lý, lời giảng dạy của Đức Phật", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Săn", "definition": "(Thú). Anvesati (anu + es + a), anvesana (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Săn Sóc", "definition": "Paṭijaggati (paṭi + jag + a), paricaraṇa (trung), paricarati (pari + car + a), paricāraṇa (nữ), upaṭṭhahati, upaṭṭhāti (upa + ṭhā + a), ārakkhā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sĩ", "definition": "仕. Người học trò Người làm quan Xem xét sự việc Tên người, tứ Ngô Thì Sĩ, 1726 – 1780, tự là Thế Lộc, Hiệu là Ngọ Phong, lại có hiệu là Nhị Thanh Cư sĩ người xã Tả Thanh oai, phủ Thanh oai, tỉnh Hà Đông, Bắc phần Việt Nam, đậu Tiến sĩ năm 1766, niên hiệu Cảnh hưng 27 đời Lê Hiển Tông, làm quan tới chức Đốc trấn Lạng sơn, tác phẩm Hán văn có Anh ngôn thi tập, Ngọ Phong văn tập, Nhị Thanh động tập, và nhiều bài trong Ngô gia văn phái Dùng như chữ Sĩ 士.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Binh", "definition": "士兵. Người lính trong quân đội. Cũng gọi là Binh sĩ. Cũng như Sĩ tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Dân", "definition": "士民. Người dân có đi học, có đức hạnh Chỉ chung mọi người trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Dụng Quả", "definition": "Puruṣakāra phala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sĩ Hoạn", "definition": "士宧. Việc làm quan Người làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Khi", "definition": "士氣. Vẻ ngay thẳng cứng cỏi của người có học Vẻ ngay thẳng cứng cỏi của nhà Nho. Thơ Trần Tế Xương có câu: “Sĩ khí rụt rè gà phải cáo, văn chương liều lĩnh đấm ăn xôi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Khuê", "definition": "Sĩ Khuê (1083-1146)", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sĩ Lầm", "definition": "士林. Giới đi học, có học Giới làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Lộ", "definition": "士路. Con đường học hành làm quan giúp nước. Bài Tụng Tây Hồ phú của Nguyễn Huy Lượng Có câu: “Chốn chiều đài xem cá nhả chim bay, thâu sĩ lộ nơi thông nơi trệ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Nhân", "definition": "士人. Người có học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Nữ", "definition": "士女. Con trai và con gái Chỉ người đẹp. Td: Sĩ nữ đồ (bức tranh vẽ người con gái đẹp).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Phu", "definition": "士夫. Người có học thức. Lớp người trí thức Người đàn ông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Quan", "definition": "士官. Cấp chỉ huy binh lính (Officier).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Quân Tử", "definition": "士君子. Người có học và có hạnh. Người trí thức thượng lưu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Thứ", "definition": "士庶. Chỉ chung dân chúng trong nước Người đi học và người thường dân. Thơ Trần Tế Xương có câu: “Vua quan sĩ thứ người trong nước, sao được cho ra cái giống người”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Tiến", "definition": "士進. Ra làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Tiết", "definition": "士節. Lòng ngay thẳng trong sạch của người có học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Tốt", "definition": "士卒. Người lính trong quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Tộc", "definition": "士族. Dòng dõi học hành làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Tử", "definition": "士子. Người học trò đi thi. Thơ Trần Tế Xương có câu: “Lôi thôi sĩ tử vai đeo lọ, âm oẹ quan trường miệng thét loa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sĩ Đàm", "definition": "士 曇 (1249-1306). Thiền tăng đời Nam Tống, họ Hoàng, tên Tử Đàm, hiệu Tây Giản, người xứ Tiên Cư, Chiết Giang, Trung Quốc. Nối pháp Thiền Sư Thạch Phàm Duy Diễn, đời thứ 22 hệ Nam Nhạc, đời thứ 5 tông Lâm Tế Nhật Bản. Trụ trì chùa Kiến Trường ở Nhật Bản.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sĩ Đạt Đa", "definition": "Xem Tất Đạt Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sĩ Đồ", "definition": "仕塗. Con đường làm quan. “Sĩ đồ chỉ để xa gần khác nhau” (Đại Nam Quốc Sử).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "SƠ SƠN", "definition": "I.Sơ Sơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ", "definition": "𠁉. Như chữ Sơ 初.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ A Hậu Đồ", "definition": "Chữ A ở đầu, chữ Đồ ở cuối, tức chỉ cho 2 chữ đầu và cuối trong 42 chữ của tiếng Phạm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Bí", "definition": "梳篦. Lược thưa để chải tóc, và lược dày để chải đầu bắt chí (chấy).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Bạc", "definition": "疏薄. Thưa và mỏng. Chỉ sự ít ỏi, kém cỏi. Truyền Hoàng Trừu có câu: “Tài sơ đức bạc biết nào có nên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Bất Gián Thân", "definition": "疏不間親. Người xa không làm ngăn cách được người gần, ý nó người thân cận thì đáng tin hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Bộ", "definition": "初步. Bước đầu (chuẩn bị cho các việc làm sau).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Chuyển Pháp Luân", "definition": "Lần thuyết pháp đầu tiên của Đức Phật sau khi xuất gia thành đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Chí", "definition": "初志. Cái ý muốn có từ ban đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Chính", "definition": "初政. Bắt đầu ra làm việc nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Cơ", "definition": "Cũng gọi Sơ Học, Sơ Tâm, Sơ Phát Tâm. Cơ, tức căn cơ, cơ loại; Sơ cơ chỉ cho người mới học đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Cảo", "definition": "初稿. Bản văn lúc đầu tiên, do chính tác giả viết ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Cấp", "definition": "初級. Bậc đầu tiên. Bậc thấp nhất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Dân", "definition": "初民. Người đời thượng cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Dã", "definition": "疏野. Vụng về quê mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Dạ", "definition": "Phạm: Prathama-yàma. Pàli: Paỉhama-yàma. Cũng gọi Sơ Canh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Dạ Kệ", "definition": "Kệ được tụng vào lúc đầu đêm. Vãng Sinh Lễ Tán Kệ của ngài Thiện Đạo ghi (Đại 47, 440 hạ): “Phiền não sâu không đáy Biển sinh tử không bờ Thuyền cứu vớt chưa có Làm sao vui ngủ yên?", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Giai", "definition": "初階. Như Sơ cảo 初稿.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Giang Vương", "definition": "Cũng gọi Sở Giang Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Hiến", "definition": "初獻. Tuần rượu cúng lần thứ nhất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Hoan Hỷ Địa", "definition": "Trong mười địa (cấp bậc) của Bồ Tát, thì địa đầu tiên gọi là Sơ hoan hỷ địa. Ở địa này, vị Bồ Tát cảm thấy hoan hỷ, vui vẻ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sơ Huyền", "definition": "初弦. Vành cung lúc đầu tháng, chỉ khoảng thời gian thượng tuần của tháng âm lịch, mặt trăng mới chỉ như cái vành cung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Hình", "definition": "初形. Lúc mới thành hình Cái hình thể lúc đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Hạ", "definition": "初夏. Lúc bắt đầu mùa hè, chỉ tháng 4 âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Học", "definition": "初學. Sự học lúc bắt đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Học Kí", "definition": "Tác phẩm, 1 quyển, do ngài Bản Nhiên Thanh Giác (1043-1121) soạn vào đời Tống, ngài Đạo An chú thích, ấn hành vào năm Hoàng Khánh thứ 2 (1313) đời vua Nhân Tông nhà Nguyên, được thu vào Vạn Tục Tạng tập 112.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Hốt", "definition": "疏忽. Lơ là, không cẩn thận, chú ý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Hội", "definition": "Chỉ cho hội thuyết phápđầu tiên của Đức Phật sau khi Ngài thành đạo, hoặc chỉ cho hội đầu tiên Phật giảng nói về 1 bộ kinh nào đó.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Khai", "definition": "初開. Mở đầu. Bắt đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Khoáng", "definition": "疏曠. Thưa thớt cách quãng, ý nói bỏ bê, không chuyên cần đến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Khoát", "definition": "疏闊. Lơ là, không thân thiết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Khảo", "definition": "初考. Xem xét lần đầu Quan chấm thi trong khoa thi Hương thời trước, chấm bài lần thứ nhất (sau đó sẽ có các quan khác chấm lần thứ nhì, là Phúc khảo). Thơ Trần Tế Xương có câu: “Sơ khảo khoa này bác Cử Nhu, thật là vừa dốt lại vừa ngu”. 初草: Sơ thảo: Bài văn viết ra lần đầu. Bản nháp Bàn luận sắp xếp tạm lúc đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Kim Hậu Thai", "definition": "Đối lại: Sơ Thai Hậu Kim.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Kính Tân Trang", "definition": "梳鏡新妝. Tên một cuốn truyện nôm của Phạm Thái, trong đó ông kể lại cuộc tình duyên trắc trở của ông với nàng Trương Quỳnh Như (soạn năm 1804).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Lược", "definition": "疏略. Qua loa. Tóm những nét chính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Lại", "definition": "疏懶. Bỏ bê công việc, chểnh mảng, chán nản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Lậu", "definition": "疏漏. Thưa, để lọt ra ý nói còn thiếu sót, có khuyết điểm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Lặc", "definition": "Phạm: Khàsa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Mê Hoặc", "definition": "Cũng gọi Bối Thượng Sử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Ngu", "definition": "初虞. Lễ tế yên vị lần thứ nhất sau khi chôn, một lễ trong tang lễ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Nguyệt", "definition": "初月. Mặt trăng thượng tuần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Nhật", "definition": "初日. Mặt trời mới mọc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Nhị Hồi Hỗ", "definition": "Chỉ cho cảnh giới “Thiên Trung Chí” trong thuyết Ngũ Vị của ngài Động Sơn. Ngài Động Sơn Lương Giới - Tổ khai sáng Tông Tào Động - chia quá trình tu hành làm 5 giai đoạn, gọi là Động Sơn Ngũ Vị, gồm: Chính Trung Thiên, Thiên Trung Chính, Chính Trung Lai, Thiên Trung Chí và Kiêm Trung Đáo. “Sơ Nhị” (Hai vị đầu) tức là Chính Trung Thiên và Thiên Trung Chính, ở 2 vị này, Chính Vị và Thiên vị đều hoàn toàn độc lập, đến giai đoạn thứ 4, tức Thiên Trung Chí, thì Chính Vị và Thiên vị mới hồi hỗ lẫn nhau, biểu thị từ diệu dụng sai biệt của hiện tượng giới mà thể ngộ hiện tượng và bản thể ngầm hợp với nhau, đạt đến cảnh giới vô niệm vô tưởng. [X. Bất Năng Ngữ Ngũ Vị Thuyết]. (xt. Ngũ Vị, Động Sơn Ngũ Vị).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Năng Biến", "definition": "Một tên gọi khác của Thức A lại Gia (x. A Lại gia).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sơ Pháp Minh Đạo", "definition": "Tạng: Chos-snaí-bai-sgo chossnaí- bai-tshul-dan-po.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Phòng", "definition": "疏防. Ngăn ngừa qua loa, không kĩ lưỡng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Phục", "definition": "初伏. Tuần thứ nhất trong kí nước lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Quả", "definition": "Śrota-apatti-phala (S), Śrotanni (S), Sotapanna (P), Quả Nhập Lưu, Quả Ngịch Lưu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơ Quả Hướng", "definition": "Chưa đạt được sơ quả, nhưng đang tới Sơ quả.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sơ Quả Nhị Nghĩa", "definition": "初果二義 (Tích Huyền Ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sơ Quả Tam Kết", "definition": "初果三結 (Tứ Giáo Nghi Tập Chú )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sơ Sinh", "definition": "初生. Mới lọt lòng mẹ Lúc mới có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Song", "definition": "疏窗. Cửa sổ có vài cái chấn song thưa thớt. Chỉ cảnh nhà nghèo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Suất", "definition": "疏率. Chểnh mảng, không cẩn thận, để ý. Truyện Hoàng Trừu có câu: “Sợ vì sơ suất, tội thì tru di”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Sơn Hữu Cú Vô Cú", "definition": "Cũng gọi Sơ Sơn Hữu Vô, Sơ Sơn Bố Đơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Sơn Khuông Nhân", "definition": "(疎山匡仁, Sozan Kyōnin, 837-909): vị tăng của Tào Động Tông Trung Quốc, còn gọi là Quang Nhân (光 仁), người vùng Cam Dương (淦 陽), Lô Lăng (廬陵, Tỉnh Giang Tây), họ Lý (李). Ông xuất gia lúc nhỏ, chuyên nghiên tầm kinh luật luận, đã từng tham vấn Hương Nghiêm Trí Nhàn (香嚴智閑), v.v., và cuối cùng kế thừa dòng pháp của Động Sơn Lương Giới (洞山良价). Sau đó, ông cũng có đến tham học với Quy Sơn Đại An (潙 山 大 安), và đến năm thứ 3 (883) niên hiệu Trung Hòa (中 和), ông bắt đầu khai mở đạo tràng thuyết pháp giáo hóa tại Sơ Sơn (疎山) vùng Lâm Xuyên (臨川), Phủ Châu (撫州, Tỉnh Giang Tây). Vào năm thứ 6 niên hiệu Thiên Hựu (天祐), ông thị tịch, hưởng thọ 73 tuổi.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơ Sơn Quang Nhân", "definition": "Sozan kōnin (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơ Sơn Đảo A", "definition": "Tên công án trong Thiền Tông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Sở Duyên Duyên", "definition": "Cảnh Sở Duyên Gián Tiếp . Trước hết là thuật ngữ “sở duyên duyên”. Danh từ này gồm hai danh từ “sở-duyên” và “duyên” nhập lại. Sở duyên là đối tượng của nhận thức; và duyên nghĩa là điều kiện. Duy Thức Học nói, nhận thức luôn luôn bao gồm chủ thể nhận thức và đối tượng nhận thức; nói cách khác, biết thì luôn luôn phải là biết cái gì, không thể biết suông. Nhận thức luôn luôn phải là nhận thức một đối tượng, cho nên, không có đối tượng thì không thể có nhận thức. Tóm lại, “sở duyên duyên” là cảnh sở duyên, là đối tượng của tác dụng nhận thức của tâm và tâm sở. Chữ “sơ” nghĩa là thưa thớt, xa lạ, không gần gũi; ở đây có nghĩa là gián tiếp. Theo tông Duy Thức, thể tánh của cảnh sở duyên (sở duyên duyên) có hai loại: gián tiếp (sơ) và trực tiếp (thân). Trong trường hợp cảnh sở duyên cùng với thức năng duyên xa cách nhau, thức năng duyên phải nương vào cảnh sở biến của thức năng biến khác của tự thân hoặc thức năng biến của người khác, lấy đó làm bản chất để duyên; như thế là duyên một cách gián tiếp, cho nên cảnh sở duyên đó được gọi là “Sơ Sở Duyên Duyên”. Ví dụ: Núi sông đất liền, trời trăng mây gió v.v... đều là cảnh sở biến của thức năng biến a-lại-da, nhãn thức nương vào đó và lấy đó làm bản chất để duyên (nhận thức, thấy biết). Trong trường hợp này, nói theo thuật ngữ Duy Thức Học, núi sông đất liền v.v... chính là “Sơ Sở Duyên Duyên” (cảnh sở duyên gián tiếp) của nhãn thức.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sơ Thiền", "definition": "Pathama-jhāna (P), Prathama-dhyāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơ Thiền Thiên", "definition": "Cõi trời Sơ-thiền. Các cõi trời Sắc giới, do tu định mà được quả báo, cho nên đều có tên chung là “Thiền” (Sơ-thiền, Nhị-thiền, Tam-thiền, Tứ-thiền). Cõi thấp nhất là Sơ-thiền. Chúng Sinh ở cõi trời này, tâm ý đã thanh tịnh, các lậu hoặc không còn khởi động, tự biết mình đã lìa khỏi các pháp ác của Dục giới, cảm sinh hỉ thọ và lạc thọ, cho nên gọi là “Li-sinh-hỉ-lạc địa”. Tuy nhiên, vì cõi trời này còn có hai hoạt động tâm lí “giác” (tức tâm sở “tầm”, là tác dụng phân biệt thô thiển của tâm) và “quán” (tức tâm sở “từ”, là tác dụng phân biệt vi tế của tâm), cho nên vẫn có các hoạt động thấy, nghe và xúc chạm; lại còn sinh khởi ngữ nghiệp. Cõi Sơ-thiền lại chia ra có ba cõi trời: 1) Thấp nhất là Phạm-chúng, cõi của thiên chúng do trời Đại Phạm sinh hóa và thống lĩnh; 2) Lên trên là Phạm-phụ, cõi của thiên chúng có nhiệm vụ hầu cận hai bên trời Đại Phạm; 3) Trên hết là Đại-phạm, cõi của trời Đại Phạm, thống lĩnh toàn thể thiên chúng cõi trời Sơ-thiền. Do vậy, Sơ-thiền thiên cũng được gọi là “Phạm thiên”; và trời Đại Phạm cũng được gọi là Phạm Thiên Vương, hay Phạm Vương. Theo Truyền thuyết cổ đại của Ấn-độ, ở kiếp đầu tiên, Phạm Vương từ cõi trời Quang-âm hạ sinh, và tạo ra vũ trụ vạn vật. Đạo Bà-la-môn tôn sùng trời Đại Phạm là chúa tể của vạn vật, là đấng sáng tạo thế giới, là nguyên lí tuyệt đối, duy nhất, độc tôn và thường trú.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sơ Thiền Thiên Định Ngũ Chi Công Đức", "definition": "初禪天定五支功德 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sơ Thu", "definition": "初秋. Thời gian đầu của mùa thu, tức tháng bảy âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Thân", "definition": "疏親. Xa và gần, nói về mối liên hệ giữa người này với người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Thô", "definition": "疏粗. Kém cỏi vụng về. Bài Tụng Tây hồ phú của Nguyễn Huy Lượng có câu: “Tôi nay: Hổ mình thiển lậu Dại trí sơ thô”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Thẩm", "definition": "初審. Xét xử lúc đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Thời Giáo", "definition": "Một khái niệm của Pháp Tướng tông (S. Dharmalaksana), chia quá trình hoằng pháp của Phật làm ba thời. Thời đầu, Phật giảng thuyết Bốn đến 12 nhân duyên, năm uẩn nhằm mục đích phá chấp ngã.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sơ Thứ", "definition": "初次. Lần đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Trung Hậu Thiện", "definition": "Từ ngữ khen ngợi kinh văn. Có 3 cách giải thích:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Tuyển", "definition": "初選. Lục chọn lần thứ nhất (để rồi sẽ còn lựa chọn lại lần nữa).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Tuần", "definition": "初旬. Khoảng thời gian mười ngày đầu tháng âm lịch. Cũng gọi là Thượng tuần Người thọ 60 tuổi. Cũng gọi là Lục tuần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Tâm", "definition": "Nava-yāna-samprasthita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơ Tăng Kỳ", "definition": "A tăng kỳ kiếp đầu. Tâm Mới bắt đầu phát tâm tu hành. Cũng nói Sơ phát tâm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sơ Tổ", "definition": "初祖. Ông tổ đầu tiên của dòng họ Ông tổ năm đời, tức Ông Sơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Tổ Am", "definition": "Am ở dưới ngọn Ngũ Nhũ, phía tây bắc chùa Thiếu Lâm, chân núi phía bắc núi Thiếu Thất, mạn bắc huyện Đăng Phong, tỉnh Hà Nam, Trung Quốc. Hiện chỉ còn 1 điện, 2 đình và gác Thiên Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Tổ Và Nhị Tổ Thiền Tông", "definition": "Do sự tích đức Phật “truyền tâm ấn” cho tôn giả Đại Ca Diếp trong pháp hội Linh-sơn, Thiền Tông bèn tôn ngài Đại Ca Diếp là vị tổ sư đầu tiên (sơ tổ) của Thiền Tông. Trước khi viên tịch, ngài Đại Ca Diếp đã truyền pháp tạng cho ngài A Nan thừa kế; do đó, ngài A Nan đã được tôn là vị tổ thứ nhì (nhị tổ) của Thiền Tông; lần lượt đến ngài Bồ Đề Đạt Ma là vị tổ thứ 28. Tất cả 28 vị tổ Thiền Tông đều ở Ấn-độ, nên Thiền Tông gọi là “Tây-thiên nhị thập bát tổ”. Khi ngài Bồ Đề Đạt Ma (vị tổ thứ 28 ở Ấn-độ) sang Trung-quốc (năm 520) thì trở thành vị tổ đầu tiên của Thiền Tông Trung-quốc – được gọi là “Đông-độ sơ tổ”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sơ Tự", "definition": "蔬食. Ăn rau. Ăn chay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Viễn", "definition": "疏遠. Có liên hệ xa, không thân thiết Lánh xa. Làm cho xa ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Xuân", "definition": "初春. Thời gian đầu tiên của mùa xuân, tức tháng giêng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Ý", "definition": "初意. Điều đã nghĩ từ lúc đầu. Ý sẵn có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Đàn", "definition": "Trong thủ tục thụ giới Cụ Túc, đầu tiên thụ giới Sa Di, kế đến thụ giới Tỉ Khưu, sau cùng thụ giới Bồ Tát. Trong đó, đầu tiên thụ giới Sa Di gọi là Sơ Đàn, sau đó, Tượng Đức Phật thuyết pháp lần đầu tiên theo thứ tự là Nhị Đàn, Tam Đàn. Chương Phạm Hạnh Hoàng Bá Thanh Qui quyển 5 (Đại 82, 770 trung) nói: “Hôm nay ở tại chùa... thuộc núi... phủ... tỉnh... kiến đàn Thuyết Giới, Sơ đàn vào ngày mồng 3 tháng... năm... truyền giới Sa Di, Nhị đàn vào ngày 6 tháng... năm... truyền giới Tỉ Khưu, Tam đàn vào ngày mồng 8 tháng... năm... truyền giới Bồ Tát”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơ Đông", "definition": "初冬. Lúc bắt đầu mùa đông, tức tháng 10 âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Đẳng", "definition": "初等. Hạng bắt đầu, hạng thấp nhất. Như Sơ cấp 初級.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Địa", "definition": "Xem Cực Hỷ Địa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơ Độ", "definition": "初度. Lúc bắt đầu Lúc chào đời Cái mức lúc đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơ Độ Ngũ Nhân", "definition": "初度五人 (Phiên Dịch Danh Nghĩa )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sơn", "definition": "山. Ngọn núi. Trái núi Ngôi mộ cao, to Tên một bộ chữ Trung Hoa, tức bộ Sơn Cũng đọc San.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Am Tạp Lục", "definition": "Tác phẩm, 2 quyển, do ngài Vô Uẩn soạn vào khoảng năm Hồng Vũ đời Minh, được thu vào Vạn Tục Tạng tập 148.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Biên Tập Học", "definition": "(1882-1944).Danh tăng Nhật Bản thuộc phái Đại Cốc Chân Tông, người huyện Sơn Hình. Sau khi tốt nghiệp Đại Học Chân Tông, sư đến Nam Dương quan sát tình hình các tôn giáo. Sau đó, sư du học Ấn Độ, Anh Quốc trong 4 năm. Khi trở về nước, sư lập Hiệp hội Văn hóa Phật Giáo làm cơ quan phổ biến tư tưởng Phật Giáo, vận động đào tạo nhân tài.Sư lần lượt giữ các chức Giáo sư Đại Học Đại Cốc Chân Tông, Thư viện trưởng...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Cao Thủy Trường", "definition": "山高水長. Núi cao sông dài, chỉ cảnh đẹp đất nước Cũng chỉ sự vững bền, như núi lúc nào cũng cao, sông lúc nào cũng dài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Chúng", "definition": "山衆. Chỉ chung các nhà tu ở núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Chủ", "definition": "Tức người chủ của một ngọn núi; đó là tiếng tôn xưng vị trụ trì của một ngôi chùa. Phần nhiều các tự viện xưa được xây cất trong chốn núi non, và lấy tên núi mà đặt tên, cho nên vị trụ trì được xưng là “sơn chủ”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sơn Cân", "definition": "Chỉ cho trọng lượng của núi Tu Di, ví dụ tuổi thọ vô lượng của Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Công", "definition": "山公. Ông ở núi, tức con khỉ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Cùng Thuỷ Tận", "definition": "山窮水盡. Nơi đầu núi cuối sông, chỉ nơi cực xa xôi, không còn nơi nào xa hơn nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Căn", "definition": "山根. Danh từ tướng số, chỉ phần sống mũi ở khoảng giữa hai mắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Cư", "definition": "山居. Ở trên núi Người vào núi ở ẩn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Cước", "definition": "山踋. Chân núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Cốc", "definition": "山谷. Hang núi Khe núi, khoảng giữa hai trái núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Cốc Tự", "definition": "山 谷 寺. X. Tam Tổ Tự", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sơn Danh", "definition": "(山名, Yamana): tên của một dòng họ thuộc hàng Chiến Quốc Đại Danh, một trong 4 dòng họ quan chức nổi tiếng của chính quyền Mạc Phủ Thất Đinh. Con của Tân Điền Nghĩa Trọng (新田義重, Nitta Yoshishige) là Nghĩa Phạm (義範, Yoshinori) đến sống ở vùng Sơn Danh, Thượng Châu và trở thành Tổ khai công của dòng họ này.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Danh Tông Toàn", "definition": "(山名宗全, Yamana Sōzen, 1404-1473): vị Võ Tướng sống vào khoảng giữa thời đại Thất Đinh; húy là Trì Phong (持豐); Tông Toàn (宗全) là tên sau khi xuất gia; biệt danh là Tiểu Thứ Lang (小次郎), Tông Toàn Nhập Đạo (宗全入道), Xích Nhập Đạo (赤入道); giới danh là Đạt Ma Viện Điện Tối Cao Tông Phong Đại Cư Sĩ (達碧院殿最高宗峰大居士); thân phụ là Sơn Danh Thời Hy (山名時煕, Yamana Tokihiro), thân mẫu là con gái của Võ Tướng Sơn Danh Sư Nghĩa (山名師義, Yamana Moroyoshi). Trong vụ Loạn Gia Cát ông được Xích Từng Mãn Hựu (赤松滿祐, Akamatsu Mitsusuke) mến mộ, cả gia tộc đến giữ chức quan Thủ Hộ của 8 tiểu quốc. Sau đó ông kết thân với Tế Xuyên Thắng Nguyên (細川勝元, Hosokawa Katsumoto), rồi nhân việc người vợ của Tướng Quân Túc Lợi Nghĩa Chính (足利義政, Ashikaga Yoshimasa) là Nhật Dã Phú Tử (日野富子, Hino Tomiko) tín nhiệm người con là Túc Lợi Nghĩa Thượng (足利義尚, Ashikaga Yoshihisa), ông sinh ra đối kháng với Tế Xuyên Thắng Nguyên và tạo nên vụ Loạn Ứng Nhân (應仁の亂). Trong khi chiến loạn thì ông chết giữa trận mạc.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Dân", "definition": "山民. Người sống ở vùng núi, vùng cao nguyên. Cũng chỉ người thiểu số sống ở rừng núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Dã", "definition": "山野. Núi và cánh đồng, chỉ nơi ở ẩn vắng vẻ êm đềm Chỉ sự vụng về quê kệch (như người sống ở núi, ở đồng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Dương", "definition": "山羊. Loài dê núi, leo núi cực giỏi, chạy rất nhanh, tên khoa học là (Capra Hirous).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Dược", "definition": "山藥. Vị thuốc hái ở trên núi Tên một vị thuốc Nam, còn gọi là Chánh hoài (ta gọi là Khoai mài).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Gia", "definition": "Chỉ cho sư chủ hoặc môn đồ của ngài trụ ở trong núi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Gia Học Sinh Thức", "definition": "Tác phẩm, 1 quyển, do ngài Tối Trừng, vị cao tăng Nhật Bản soạn, được thu vào Đại Chính Tạng tập 74.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Gia Nghĩa Uyển", "definition": "Tác phẩm, 2 quyển, do ngài Khả Quán (1092-1182) Tông Thiên Thai soạn vào đời Tống, được thu vào Vạn Tục Tạng tập 101.Mục đích sách này nói về phái Nam bình, môn hạ của ngài Tứ Minh Tri Lễ thuộc phái Sơn gia Tông Thiên Thai, đồng thời trình bày về nghĩa trọng yếu của Tông Thiên Thai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Gia Quán Tâm Dị Luận Quyết", "definition": "Tác phẩm, 2 quyển, do ngài Chân Điêu (?-1659) thuộc Tông Thiên Thai Nhật Bản soạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Gia Sơn Ngoại", "definition": "Chỉ cho Phái Sơn Gia và Phái Sơn Ngoại thuộc Tông Thiên Thai Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Gia Tự Dư Tập", "definition": "Tác phẩm, 3 quyển, do ngài Thiện Nguyệt (?-1241) thuộc Tông Thiên Thai soạn vào đời Tống, được thu vào Vạn Tục Tạng tập 101.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Hiệu", "definition": "Tên núi, thường được dùng để đặt cho tên chùa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Hà", "definition": "山河. Núi và sông, chỉ lĩnh thổ quốc gia. Đoạn trường tân thanh có câu: “Triều đình riêng một góc trời, gồm hai văn võ rạch đôi sơn hà” Cũng chỉ sự bền vững, vì núi không mòn, sông không cạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Hào", "definition": "山餚. Đồ ăn ngon của vùng núi, tức thịt rừng. Thường nói sơn hào hải vị (món thịt rừng và món cá biển).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Hình Trụ Trượng", "definition": "Chỉ cho nguyên hình cây gậy được chặt từ trong núi mà không đẽo gọt gì thêm. Bích Nham Lục tắc 18 (Đại 48, 158 thượng) ghi: “Ngài Tuyết Đậu nói rằng: Cây gậy nguyên hình được chặt từ trong núi (...) dưới cây không bóng hội họp cùng thuyền”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Hải", "definition": "山海. Nói tắc của “Sơn minh hải thệ” (hẹn non thề biển), chỉ lời thề hẹn. Thơ Tản Đà có câu: “Sơn hải hỡi ai người ước thệ, gió hiu trăng lạnh tiếng ve sầu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Hải Chi Công", "definition": "(山海之功): công ơn to lớn như núi và biển của cha mẹ. Tục ngữ Việt Nam có câu: “Công cha như núi Thái Sơn, nghĩa mẹ như nước trong nguồn chảy ra, một lòng thờ mẹ kính cha, cho tròn chữ hiếu mới là đạo con.” Trong bài tán dùng khi cúng lễ phát tang cũng có câu nói lên công đức trời biển của đấng sinh thành: “Hải đức thâm nan báo, sơn công đại mạc thù, linh tiền phi tố phục, ức niệm kỉ thời hưu (海德深難報、山功大莫酬、靈前披素服、憶念幾時休, đức biển sâu khó báo, công núi lớn sao đền, linh đài mang tang áo, thương nhớ bao giờ nguôi).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Hải Huệ Tự Tại Thông Vương", "definition": "Xem Sơn Hải Huệ Tự Tại Thông Vương Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Hải Huệ Tự Tại Thông Vương Như Lai", "definition": "Śāgāravaradharabuddhi-vikreditabhidjña (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Hải Không Thị", "definition": "Núi, biển, hư không, giữa chợ. Từ ngữ này hình dung sự vô thường bức bách, khiến người ta không thể lẩn tránh. Bởi vì vô thường (cái chết) đối với loài hữu tình như bóng theo hình, sức mạnh của nó mau chóng như thác đổ, gió bão, điện xẹt, dù có trốn vào núi rừng, xuống đáy biển, lên hư không hay giữa chợ cũng không thoát, vẫn bị nó bức bách và theo đuổi bén gót.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Hải Kinh", "definition": "(山海經): điển tịch tối cổ của Trung Quốc, gồm 18 quyển, tương truyền do Vũ Vương (禹王) nhà Chu và triều thần của vua là Bá Ích (伯益) trước tác, nhưng đúng ra là do người đời sau viết ra. Nội dung bộ sách này gồm các ký thuật về những phương diện thần thoại, địa lý, động vật, thực vật, khoáng sản, tôn giáo, cổ sử, y dược, dân tục, dân tộc cổ đại, v.v. Đây cũng được xem như là bộ sách Địa Lý được viết dưới dạng không tưởng, cho nên trong phần ký thuật về các nước ven Trung Quốc, có rất nhiều ký sự kỳ quái. Trong đó có phần chú thích của Quách Phác (郭璞, 276-324) nhà Đường. Nguyên lai Sơn Hải Kinh có đồ hình, gọi là Sơn Hải Đồ Kinh (山海圖經), từ thời Ngụy, Tấn thì bị thất truyền", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Hải Như Lai", "definition": "Cũng gọi Sơn Hải Tuệ Tự Tại Thông Vương Như Lai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Hải Tự Tại Thông Vương", "definition": "Mountain Sea Wisdom Unrestricted Power King", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sơn Hệ", "definition": "山系. Mạch núi, dãy núi Chỉ chung nhiều dãy núi trong một vùng cùng chạy theo một hướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Hồ", "definition": "山湖. Núi non và hồ nước, cảnh trí trong nhà quyền quý thời xưa. Đoạn trường tân thanh có câu: “Có cổ thụ có sơn hồ, cho nàng ra đó giữ chùa tụng kinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Khi Ám Trai", "definition": "(山崎闇齋, Yamazaki Ansai, 1618-1682): Nho gia sống vào khoảng đầu thời Giang Hộ; tên là Gia (嘉); tự Kính Nghĩa (敬義); thông xưng là Gia Hữu Vệ Môn (嘉右衛門); hiệu là Ám Trai (闇齋); Linh Xã hiệu là Thùy Gia Linh Xã (垂加靈社); xuất thân kinh đô Kyoto. Ông từng xuống tóc xuất gia ở Diệu Tâm Tự (妙心寺, Myōshin-ji), rồi chuyển đến vùng Thổ Tá (土佐, Tosa, thuộc Kōchi-ken [高知縣]), theo học với Cốc Thời Trung (谷時中) về Chu Tử Học thuộc Nam Học Phái. Sau đó, ông hoàn tục, trở về kinh đô và khai giảng giữa chợ vào năm 1655 (Minh Lịch [明曆] nguyên niên). Ông được nhóm Bảo Khoa Chánh Chi (保科正之, Hoshina Masayuki), Phiên chủ của Phiên Hội Tân (會津藩, Aizu-han), đãi ngộ trọng dụng. Rồi ông theo học Thần Đạo với Cát Xuyên Duy Túc (吉川惟足, Yoshikawa Koretari), và khai sáng ra thuyết Thùy Gia Thần Đạo (垂加神道) mang tính Thần Nho Nhất Trí (神儒一致). Môn đệ của ông có đến 6.000 người, trong đó có những nhân vật kiệt xuất như Tá Đằng Trực Phương (佐藤直方), Chánh Thân Đinh Công Thông (正親町公通), v.v., hình thành nên Khi Môn Học Phái (崎門學派). Trước tác chủ yếu của ông có Văn Hội Bút Lục (文會筆錄), Thùy Gia Văn Tập (垂加文集), Y Thế Thần Cung Nghi Thức Tự (伊勢神宮儀式序), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Khoa", "definition": "(山科, Yamashina): khu vực thộc phía Đông của Phố Kyoto, nơi ấy có lăng của Thiên Trí Thiên Hoàng (天智天皇, Tenchi Tennō), Sơn Khoa Biệt Viện (山科別院), v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Khê", "definition": "山溪. Núi và khe nước trên núi. Chỉ sự xa sôi cách trở Đoạn trường tân thanh có câu: “Liêu dương cách trở sơn khê, xuân đường kịp gọi sinh về hộ tang”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Kê", "definition": "山雞. Gà rừng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Kì", "definition": "Phạm: Zànti.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Lâm", "definition": "山林. Núi rừng Chỉ nơi ở ẩn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Lăng", "definition": "山陵. Phần mộ của vua chúa. Cũng như: Lăng tẩm Vùng núi, vùng cao nguyên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Lĩnh", "definition": "山嶺. Đỉnh núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Lộc", "definition": "山麓. Vùng chân núi. Như Sơn cước 山踋.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Lộc Tố Hành", "definition": "(山鹿素行, Yamaga Sokō, 1622-1685): Nho gia và là nhà binh pháp học, Tổ của Phái Cổ Học; sống vào khoảng đầu thời Giang Hộ; xuất thân vùng Hội Tân (會津, Aizu); tên là Cao Hựu (高祐), Nghĩa Củ (義矩); tự Tử Kính (子敬); thông xưng là Thậm Ngũ Hữu Vệ Môn (甚五右衛門); hiệu là Nhân Sơn (因山), Tố Hành (素行). Ông theo học Nho học với Lâm La Sơn (林羅山) và học về binh pháp học với Tiểu Phan Cảnh Hiến (小幡景憲, Obata Kagenori), Bắc Điều Thị Trường (北條氏長, Hōjō Ujinaga). Vì ông cho san hành bản Thánh Giáo Yếu Lục (聖敎要錄) với chủ trương phê phán Chu Tử Học và thay đổi theo tư tưởng của chư vị Thánh hiền cổ đại, vào năm 1666 (Khoan Văn [寛文] 6) thì bị lưu đày đến vùng Xích Tuệ (赤穗, Akō), Bá Ma (播磨, Harima). Đến năm 1675 (Diên Bảo [延寶] 3), ông được xá tội và trở về Giang Hộ. Ông là người thông hiểu về cổ điển cũng như Thần Đạo của Nhật Bản, đã lưu lại một số tác phẩm như Trung Triều Sự Thật (中朝事實) 2 quyển, Võ Gia Sự Kỷ (武家事紀) 58 quyển, v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sơn Man", "definition": "山蠻. Giống dân thiểu số bán khai, sống trên núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Minh", "definition": "山明. Núi sáng, chỉ cảnh đẹp thiên nhiên. Thường nói: Sơn minh thuỷ mị (núi sáng sông đẹp).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Môn", "definition": "Sammon (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Môn Kị Phật Điện", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Môn La Hán", "definition": "Tượng 16 vị hoặc 500 vị La Hán thờ trên lầu sơn môn để cầu các Ngài hộ trì sơn môn và làm cho chính pháp trụ lâu nơi thế gian.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Môn Sớ", "definition": "Bài văn sớ do vị Thư Kí làm được đọc trong lễ khuyến thỉnh (chúc mừng) vị Tân trụ trì nhập tự viện trong Thiền Tông. Văn Sớ cung thỉnh các vị Trụ Trì các sơn môn lân cận đến dự lễ, gọi là Chư Sơn Sớ; thiệp chúc mừng của các vị Trụ Trì chùa viện các nơi gửi đến vị Tân trụ trì, gọi là Giang Hồ Sớ; bài biểu do đồng môn dâng lên chúc mừng Tân trụ trì, gọi là Đồng Môn Sớ. [X. Phật Quang Quốc Sư Ngữ Lục Q.3; Thường Quang Quốc Sư Ngữ Lục Q.hạ; môn Văn Sớ trong Thiền Lâm Tượng Khí Tiên; điều Thỉnh Tân Trụ Trì trong Sắc Tu Bách Trượng Thanh Qui Q.3].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Môn Tam Đại Thiền Sư", "definition": "Chỉ cho 3 vị: Đô Tự, Duy Na và Thị Giả trong các Thiền Viện. Từ “Thiền Sư” ở đây chẳng phải là chức vị, mà chỉ được dùng để bày tỏ lòng tôn kính đối với các vị này. [X. môn Chức Vị trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Môn Tam Đại Thị Giả", "definition": "Chỉ cho 3 vị thị giả lớn: Thị Giả Đốt Hương, Thị Giả Thư Kí và Thị Giả Thỉnh Khách phụ tá vị Trụ Trì trong mọi hoạt động trong chùa viện. [X. môn Chức Vị trong Thiền Lâm Tượng Khí Tiên]. (xt. Tam Môn Tam Đại Thị Giả).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Mạch", "definition": "山脈. Hướng núi chạy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Nhân", "definition": "山人. Người cư ngụ tại vùng núi Người ở ẩn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Nhạc", "definition": "山嶽. Ngọn núi cao nhất trong dãy núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Nhạc Sùng Bái", "definition": "Thần cách hóa núi cao để sùng bái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Phong", "definition": "山風. Gió núi. Chỉ sự vất vả của người chiến sĩ. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành có câu: “Trước từng trải Xiêm la Cao miên về Gia định mới dần ra Khánh thuận, đã mấy buổi sơn phong hải lễ, trời Cao Quang soi tỏ tam kiên trinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Pháp", "definition": "Cũng gọi Sơn Qui.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Phục", "definition": "Cũng gọi Sơn Ngọa, Tu Nghiệm Giả, Nghiệm Giả, Hành Giả.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Quynh", "definition": "山扃. Cửa hang trên núi, chỉ cảnh đẹp trên núi. Hát nói của Dương Khuê có câu: “Lúc vào động ngắm sơn quynh thạch đắng, bút thần ngoan chưa khéo vẽ cho cùng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Quân", "definition": "山君. Vị thần núi. Như Sơn thần Một tên chỉ con cọp (coi như vua trên núi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Thanh", "definition": "山青. Núi thì xanh, chỉ cảnh đẹp thiên nhiên. Thường nói Sơn thanh thuỷ tú (núi xanh sông đẹp).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Thiệu Kỳ", "definition": "Tsu yin Chu ne (S), Chu ne, Chu shan Shao chi (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Thuỷ", "definition": "山水. Núi và sông, chỉ cảnh đẹp thiên nhiên. Tự tình khúc của Cao Bá Nhạ có câu: “Hay ra lại rạng cơ cừu. Hèn ra sơn thuỷ tiêu sần cũng khoan”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Thuỷ Hoạ", "definition": "山水畫. Bức tranh vẽ cảnh núi sông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Thần", "definition": "山神. Vị thần trên núi. Như Sơn quân 山君.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Thủy Bình Phong", "definition": "Bức bình phong có vẽ cảnh non nước đặt ở phía sau tòa A Xà Lê khi cử hành nghi thức Quán Đính hoặc tu pháp Cúng Dường Mạn Đồ La trong Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Thủy Nạp", "definition": "Y phục của Thiền Tăng Trung Quốc ở đời Tống, tức y phục có hoa văn được may bằng loại tơ lụa đắt tiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Tra Tử", "definition": "山查子. Quả bồ quân, dừng làm vị thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Trang", "definition": "山莊. Nông trại trên núi Nhà lớn trên núi, xung quanh có vườn rộng Cũng chỉ nghĩa địa, chỗ đất chôn người chết. Như: Nghĩa trang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Trà", "definition": "山茶. Tên một loài cây nhỏ, hoa có hai màu đỏ trắng rất đẹp (camelias).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Trân", "definition": "山珍. Món ăn quý của vùng núi, tức thịt rừng. Như: Sơn hào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Tây", "definition": "山西. Tên một tỉnh ở Bắc phần Việt nam. Thơ Tản Đà có câu: “Vùng đất Sơn Tây nẩy một ông, tuổi chửa bao nhiêu văn rất hùng” (Sơn Tây là quê hương của tác giả).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Tăng", "definition": "Sansō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Tướng Khích Bồ Tát", "definition": "Giryagrapra-mardirāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Viên", "definition": "山園. Phần mộ của vua chúa. Như: Sơn lăng 山陵.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Vương", "definition": "King of mountains, Giricakra-vartin (S), Girirāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Vương Quyền Hiện", "definition": "Cũng gọi Nhật Cát Quyền Hiện, Sơn Vương Thất Xã.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Xuyên", "definition": "山川. Núi và sông Cũng chỉ sự xa cách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Ông Mộng ẩn", "definition": "山 翁 夢 隱. Hiệu của thiền tăng Đạo Mân đời Thanh. X. Đạo Mân", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sơn Ông Đạo Mẫn", "definition": "(1596-1674).Cao tăng Trung Quốc, thuộc Tông Lâm Tế, sống vào cuối đời Minh đầu đời Thanh, người ở Triều Dương, Triều Châu (Quảng Đông), họ Lâm, tự Mộc Trần, hiệu Sơn Ông.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Đông", "definition": "Shantung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sơn Đầu", "definition": "I.Sơn Đầu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sơn Đẩu", "definition": "山斗. Gọi tắt của núi Thái Sơn và sao Bắc Đẩu, chỉ người có tiếng tăm, được chiêm ngưỡng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn Động", "definition": "山洞. Hang núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sơn đầu nhật xuất lộ nham phong.", "definition": "Xuân sặc sỡ, cỏ như nhung", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sơtriển", "definition": "Trong nghi thức lễ bái, khi lễ thì trải (triển) tọa cụ ra và lễ 3 lễ. Sơ triển là trải tọa cụ lễ 1 lễ đầu tiên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư", "definition": "phra (S), Monk (Thai), Bhikkhu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Bác", "definition": "Đàn ông xuất gia, tương đối lâu năm và đã làm lễ thụ 10 giới Sa di.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Bảo", "definition": "Bậc sư trưởng che chở cho đệ tử, chỉ dạy cho họ tu hành các pháp lành để không bị đọa vào đường ác, nên gọi là Sư Bảo. [X. Kinh Tăng Nhất A Hàm Q.14; Luận Đại Trí Độ Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Bị", "definition": "Xem Huyền sa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Chú", "definition": "Người mới cắt tóc xuất gia, thường gọi là sư chú, chú tiểu, hay chú điệu. Các chú tiểu thường làm các công việc vặt trong chùa, như quét dọn, thỉnh chuông, thắp hương và phục vụ các vị sư lớn tuổi. Mới vào chùa, sư chú thụ lễ Tam quy, ngũ giới.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Chất", "definition": "Tên 1 người Bà La Môn ở nước Xá Vệ vào thời Đức Phật tại thế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Chủ", "definition": "Cũng gọi Sư gia, Sư phụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Cô", "definition": "師姑. Người đàn bà đi tu tại chùa Phật. Bà vãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Cổ", "definition": "師古. Bắt chước học theo người xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Cụ", "definition": "Những vị Tỳ kheo, thông thường ngoài 50 tuổi, được gọi là sư cụ. Đôi khi cũng gọi là Thượng tọa hay Hòa thượng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Gia", "definition": "Chỉ cho bậc thầy có học vấn, đức hạnh, có khả năng hướng dẫn chúng tăng tu hành. Từ này cũng được dùng để gọi vị thầy tu Thiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Già", "definition": "Phụ nữ xuất gia lâu năm, đã thụ giới đầy đủ, gọi là Tỷ kheo ni hay sư già. Số giới đầy đủ của Tỷ kheo ni là 350 giới, trong khi số giới đầy đủ của Tăng chỉ là 250 giới.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Giới", "definition": "(?-?).Thiền Sư Trung Quốc, thuộc Tông Vân Môn, sống vào đời Tống. Sư nối pháp ngài Song Tuyền Sư Khoan, trụ ở Long Tượng Hải Hội, núi Ngũ Tổ tại Kì Châu (Hồ Bắc), phát huy tông phong.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Hiệu", "definition": "Cũng gọi Tứ Hiệu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Huynh", "definition": "師兄. Tiếng gọi người bạn học cùng thầy với mình Tiếng gọi người thầy tu đã tu trước mình. Đoạn trường tân thanh có câu: “Dạy đem pháp bảo sang hầu sư huynh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Huyền", "definition": "Dây đàn sư tử, tức dùng gân con sư tử làm dây đàn, khi gảy lên thì các loại đàn dây khác đều im bặt; dùng để ví dụ tâm bồ đề át hết những công đức nhỏ nhặt khác. [X. Kinh Tân Hoa Nghiêm Q.78].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Hình", "definition": "師型. Gương mẫu của ông thầy, để học trò và người đời bắt chước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Hạo", "definition": "師 浩. Thiền tăng đời Tống, tham vấn Thiền Sư Hoài Nhạc ở Báo Ân và đắc pháp. Sư trụ trì viện Diệu Tế, Hương Sơn thuộc Đàm Châu (nay là huyện Trường Sa tỉnh Hồ Nam). Hiệu: Truyền Tâm Đại Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Hống", "definition": "(獅吼): hay sư tử hống (獅子吼), là tiếng rống của con sư tử, tỷ dụ cho sự thuyết pháp của đức Phật hùng dũng như tiếng gầm của chúa tể sơn lâm làm chấn động cả vũ trụ, càn khôn. Như Thắng Man Kinh (s: Śrīmālā-siṁha-nāda-sūtra, 勝鬘經) còn có tên gọi khác là Thắng Man Sư Tử Hống Nhất Thừa Đại Phương Tiện Kinh (勝鬘師子吼一乘大方便經), Sư Tử Hống Kinh (師子吼 經), Thắng Man Sư Tử Hống Kinh (勝鬘師子吼經), Sư Tử Hống Phương Quảng Kinh (師子吼方廣經), Thắng Man Đại Phương Tiện Phương Quảng Kinh (勝鬘大方便方廣經), v.v. Trong Duy Ma Cật Kinh (s: Vimalakīrti-nideśa, 維摩詰經), Phẩm Phật Quốc (佛國品) có đoạn: “Sư tử hống vô úy âm dã, phàm sở ngôn thuyết bất úy quần tà dị học, dụ sư tử hống chúng thú hạ chi (獅子吼無畏音也、凡所言說不畏群邪異學、諭獅子吼眾獸下之, tiếng rống của con sư tử là âm thanh không sợ hãi, phàm giáo thuyết của ngài nói ra đều không sợ giáo học khác của chúng tà đạo, giống như tiếng rống của con sư tử làm cho các loài thú đều phải thần phục).” Ngoài ra, sư tử hống còn được dùng để ví cho âm thanh chửi mắng người khác của người vợ hung dữ. Trong dân gian vẫn thường dùng từ “Hà Đông Sư Hống (河東獅吼, tiếng rống của con sư tử Hà Đông)”, vốn phát xuất từ trong Dung Trai Tùy Bút (容齋隨筆) quyển 3, phần Trần Quý Thường (陳季常) của Hồng Mại (洪邁, 1123-1202) nhà Tống. Dưới thời Bắc Tống có một văn nhân tên Trần Quý Thường, tự xưng là Long Kheo Cư Sĩ (龍丘先生), thường vui vẻ tiếp đãi khách quý, thích giao du với các kỹ nữ; tuy nhiên, vợ ông họ Liễu, là người rất hung dữ, thường hay la rầy chồng. Có hôm nọ, người bạn thân là Tô Đông Pha (蘇東坡) khiêu khích Quý Thường đi chơi xuân. Bà vợ sợ chồng mình đi chơi với hàng kỹ nữ nên không cho phép ông ra bước khỏi nhà; tuy nhiên, họ Trần bảo đảm và hứa hẹn là nếu có kỹ nữ thì sẽ chịu hình phạt thích đáng; nhờ vậy bà họ Liễu mới chấp thuận. Về sau, bà biết được chồng có ăn chơi với các kỹ nữ, nên phạt đánh đòn. Quý Thường sợ bị đánh, tha thiết cầu xin tha tội và chịu quỳ phạt bên bờ hồ. Tô Đông Pha ghé thăm, chứng kiến sự tình như vậy, cảm thấy sỉ nhục cho đấng đại trượng phu nam tử, bèn quở trách bà họ Liễu; từ đó cả hai bên bắt đầu cãi vả nhau. Cuối cùng, bà biết được sự việc Đông Pha đã dụ dỗ chồng chơi với các kỹ nữ, rồi lại còn đến can thiệp vào chuyện riêng của gia đình mình; cho nên, bà tức giận lớn tiếng đuổi ông ra khỏi nhà. Nhân sự việc này, Tô Đông Pha có làm bài thơ rằng: “Long Kheo Cư Sĩ diệc khả lân, đàm không thuyết hữu dạ bất miên, hốt văn Hà Đông sư tử hống, trụ trượng lạc thủ tâm mang nhiên (龍丘居士亦可憐、談空說有夜不眠、忽聞河東獅子吼、柱杖落手心茫然, Long Kheo Cư Sĩ cũng đáng thương, đàm không luận có suốt đêm trường, chợt nghe Hà Đông sư tử rống, gậy chống buông tay tâm hoảng liền).” Bà họ Liễu vốn người Hà Đông (河東), cho nên Hà Đông sư tử (河東獅子) được dùng để ví cho bà. Về sau, Uông Đình Nột (汪廷訥) nhà Minh soạn tác phẩm Sư Hống Ký (獅吼記) cũng dựa trên bài thơ của Tô Đông Pha. Câu “cách phàm thành Thánh, tốc đăng sư hống chi lâm (革凡成聖、速登獅吼之林)” có nghĩa là khi đã chuyển hóa phàm tâm thành bậc Thánh thì sẽ mau chóng được lên khu rừng có tiếng rống thuyết pháp của sư tử.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sư Hộ", "definition": "師 護. Thiền tăng đời Ngũ Đại, người xứ Mân, nối pháp Quốc sư Đức Thiều ở Thiên Thai, thuộc tông Pháp Nhãn. Khi sư xuống núi hành hóa, chúa Nam Hán lễ sư làm thầy, sáng lập viện Quang Thánh ở Quảng Châu rồi thỉnh sư trụ trì, ban cho sư hiệu “Đại Nghĩa Thiền Sư”. Sư tịch vào khoảng niên hiệu Thái Bình Hưng Quốc (976-997) đời Tống.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Hội", "definition": "Sư Hội (1102-1166)", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Hữu", "definition": "師友. Thầy và bạn học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Khoan", "definition": "師 寬 (890-955). Thiền tăng đời cuối Đường đầu Ngũ Đại, họ Hà, người huyện Tùy, Hồ Bắc, Trung Quốc. Sư nối pháp thiền sư Văn Yển, thuộc tông Vân Môn đời thứ 2, trụ chùa Song Tuyền ở Hồ Bắc hoằng pháp. Có Ngữ Lục lưu hành ở đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Khổ Hạnh", "definition": "Ascetic monk.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Liêu Tập", "definition": "樗寮集. Tên một tác phẩm bằng chữ Hán của Nguyễn Trực, danh sĩ đời Lê Thánh Tông. Xem tiểu sử tác giả ở vần Trực.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Ma Úy", "definition": "Siṃhanada (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Mẫu", "definition": "師母. Bà thầy. Người đàn bà dạy mình học Tiếng học trò gọi người vợ của thầy mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Ngạn", "definition": "師 彥. Thiền tăng đời Ngũ Đại, họ Hứa, người xứ Mân Trung, Trung Quốc. Sư xuất gia từ bé, trì giới nghiêm cẩn, tham vấn Thiền Sư Nham Đầu Toàn Khoát và đắc pháp. Khi ra hoằng pháp sư trụ viện Thụy Nham ở Đan Khâu thuộc Thai Châu (nay là huyện Lâm Hải, tỉnh Chiết Giang). Sư oai đức nghiêm nghị, uốn nắn tăng ni, chẳng chịu để họ lầm lạc, nên Giang Biểu nói người hay điều phục đại chúng chỉ có Thụy Nham là bậc nhất. Thuỵ hiệu: Không Chiếu Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Nhan", "definition": "Jui-yen (C), Zuigan (J), Shih-yen (C), Jui-yen (C), Zuigan, Shigen (J)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Nãi", "definition": "師 鼐. Thiền tăng đời Ngũ Đại. Sư thờ Tuyết Phong Nghĩa Tồn làm thầy nương ở để tham thiền và có tỉnh ngộ. Sau đó nhận lời mời của Mân Vương, sư đến phó trai ở lầu Thanh Phong, ngồi đợi lâu sư ngước mắt nhìn, chợt thấy ánh nắng hoát nhiên đốn ngộ, có bài kệ như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Phạm", "definition": "師範. Khuông phép của bậc thầy, để học trò và người đời bắt chước Phép làm thầy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Phạm Học Hiệu", "definition": "師範學校. Trường học, đào tạo các ông thầy dạy học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Phạm Khoa", "definition": "師範科. Ngành học về cách làm thầy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Phụ", "definition": "Satthu (S), Upadhaya (S), Sastṛ (S), Satthar (P), Satthu (P), Master.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Sinh", "definition": "師生. Thầy học và học trò.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Sự", "definition": "師事. Đối xử với thầy học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Thuật", "definition": "師 述. Thiền tăng đời Ngũ Đại, nối pháp Quốc sư Đức Thiều ở Thiên Thai, thuộc tông Pháp Nhãn. Sư trụ Nghiêm Phong tại Phúc Châu. Có vị tăng hỏi: Thế nào là Văn Thù? Sư đáp: Chỗ đến rất rõ ràng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Thích", "definition": "Chỉ cho các trứ tác do các bậc sư gia đời sau soạn thuật, tức là các sách chú sớ, giải thích những kinh do Đức Phật nói và những luận do các Bồ Tát, La Hán tạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Thụ", "definition": "師授. Do ông thầy tự tay trao cho, chỉ cái học chân truyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Thừa", "definition": "師 承. Thầy truyền pháp cho đệ tử. Thiền Lâm Bảo Huấn q. 1 (Đại 48, 1018 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Tiến", "definition": "師 進. Thiền tăng đời Tống. Sư tham yết Thiền Sư Long Hoa Linh Chiếu và đắc pháp. Ban đầu, sư ở viện Lục Thông tại Thai Châu (nay là huyện Lâm Hải, tỉnh Chiết Giang), sau đó dời đến viện Thụy Nham, thiền tăng theo học rất đông. Môn đình nghiêm túc, là thiền viện đứng đầu các nơi vào thời ấy.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Truyền", "definition": "師傳. Điều thầy dạy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Trách", "definition": "師 賾 (1376-1432). Thiền tăng đời Minh, họ Chu, tự Hy Cổ, hiệu Giản Am, Phật Giám, người xứ Gia Hưng (nay thuộc tỉnh Chiết Giang) Trung Quốc. Năm 17 tuổi, sư theo ngài Thiên Vũ Tịnh Công ở chùa Vạn Thọ để xuất gia, hầu hạ ngài một thời gian, thường vào thất thưa hỏi nhưng cơ duyên phần lớn không hợp, nên sư đến tham vấn ngài Thời Am Phu Công ở chùa Linh ẩn tại Hàng Châu song khối nghi vẫn chưa vỡ. Ít lâu sau, sư đến Nam Kinh, lễ ngài Tuyết Hiên Thành; ngài vừa gặp sư liền biết là pháp khí nên bảo sư làm Tri tạng. Niên hiệu Kiến Văn thứ 2 (1400), sư ra hoằng pháp trụ chùa Sùng Phúc ở Hàng Châu. Niên hiệu Vĩnh Lạc thứ 4 (1406) sư mời các bậc cao tăng chứng minh cho việc sửa chữa Đại tạng. Năm 1417, sư vâng chiếu trụ trì chùa Trung Thiên Trúc. Công việc hoàn thành, sư được Vua ban cho y, tiền bạc, Phật tượng, vòng ngọc để trang trí cho kinh. Sau đó, sư dời đến chùa Tịnh Từ ở Hàng châu; đến nơi sư quyên góp để xây dựng điện La Hán, điện Viên Thông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Trí", "definition": "師 智. Thiền tăng đời Tống, tham vấn Thiền Sư Thanh Tủng ở Linh ẩn được ngộ, nối pháp Ngài, thuộc tông Pháp Nhãn. Sư trụ viện Báo Ân ở Xử Châu (nay là huyện Lệ Thủy, tỉnh Chiết Giang).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Trưởng", "definition": "Xem Sư phụ, Rinpoche (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tài", "definition": "樗材. Gỗ của cây Sư, mềm xốp mà hôi, không dùng vào việc gì được. Dùng làm lời khiêm nhường để nói về tài năng của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Tán", "definition": "樗散. Không dùng vào việc gì được, vô dụng ở đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Tôn", "definition": "Từ gọi đệ tử của hàng đồ đệ, tức là pháp tôn của thầy mình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tăng", "definition": "Chỉ cho vị tăng có đức hạnh xứng đáng làm thầy người.Ngoài ra, Sư tăng cũng là từ tôn xưng chúng tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tư", "definition": "Chỉ cho thầy và trò. Sư là bậc thầy dạy dỗ đệ tử, Tư là những giáo pháp (tư liệu) mà thầy truyền trao cho đệ tử, đồng thời cũng có nghĩa là đệ tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tư Huyết Mạch Truyện", "definition": "(師資血脈傳, Shishikechimyakuden): tác phẩm của Thần Hội (神會), có ghi lời tựa của Độc Cô Phái (獨孤沛) trong Bồ Đề Đạt Ma Nam Tông Định Thị Phi Luận (菩提達摩南宗定是非論). Nó tương đương với truyền ký của 6 đời từ Sơ Tổ Bồ Đề Đạt Ma (菩提達磨) cho đến Lục Tổ Huệ Năng (慧能) của thư tịch Đôn Hoàng bản Thần Hội Ngữ Lục (神會語錄). Ngoài ra, nó còn là tên gọi khác của Lịch Đại Pháp Bảo Ký (歷代法寳記). Trong phần chú giải đầu quyển của Lịch Đại Pháp Bảo Ký có đoạn rằng: “diệc danh Sư Tư Huyết Mạch Truyện, diệc danh Định Thị Phi Tồi Tà Hiển Chánh Phá Hoại Nhất Thiết Tâm Truyện, diệc danh Tối Thượng Thừa Đốn Ngộ Pháp Môn (亦名師資血脈傳、亦名定是非摧邪顯正破壞一切心傳、亦名最上乘頓悟法門沛, cũng có tên là Sư Tư Huyết Mạch Truyện, cũng có tên là Định Thị Phi Tồi Tà Hiển Chánh Phá Hoại Nhất Thiết Tâm Truyện, và cũng có tên là Tối Thượng Thừa Đốn Ngộ Pháp Môn).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sư Tư Thất Tổ Phương Tiên Ngũ Môn", "definition": "Tác phẩm, 1 quyển, phụ đề là: “Trích Cú Trừu Tâm Lục Chi Như Tả”. Đây là quyển sách viết tay hình lá bối, tìm thấy ở Đôn Hoàng, do 1 người Nhật Bản là Thốc thị Hựu tường cất giữ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tượng", "definition": "Thầy thợ. Bậc sư trưởng dạy dỗ đệ tử thành tựu Giới, Định, Tuệ, như người thợ giỏi làm thành các đồ hữu dụng, cho nên ví dụ sư trưởng như người thợ (tượng). Kinh Đại Bảo Tích quyển 112 (Đại 11, 638 trung) nói: “Thành tựu được vô lượng nghiệp phúc đức, thiền định, khéo điều hòa tâm thường trong trạng thái vắng lặng, đó là sư tượng”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tổ", "definition": "I.Sư Tổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử", "definition": "獅子. Tên loài thú dữ, gọi tắt là Sư 獅.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Tử Bồ Tát", "definition": "Xem Đạo Sư Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Bồ Đề", "definition": "Shishibodai (J), Siṃhabodhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Du Hí Tam Muội", "definition": "Phạm: Siôha-vikrìđita-samàdhi.Một trong 8 loại tam muội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Du Hý Tam Muội", "definition": "Siṃha-vikridita-Samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Giác", "definition": "Buddha-siṃha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Giác Vương", "definition": "Siṃhahanu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Giáp", "definition": "Siṃhasannaha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Giáp Vương", "definition": "Sư Tử Giáp, Phạm: Siôhahanu. Pàli: Sìha-hanu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Hiền", "definition": "Haribhadrā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Hương Bồ Tát", "definition": "Sư Tử Hương, Phạm: Siôha-gandha. Tên của Đức Phật A Di Đà (con trai thứ 7 củavuaVô Tránh Niệm) khi.Ngài tu hành đạo Bồ Tát ở đời quá khứ. Vị Bồ Tát này và bồ tát Quán Thế Âm đã cùng phát nguyện dưới tòa đức Bảo Tạng Như Lai mà được thụ kí thành Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Hống", "definition": "Tiếng Gầm Sư Tử.  Sư tử là vua của các loài thú, tiếng gầm của nó làm cho các loài thú đều khiếp sợ, khép nép. Phật là bậc chí tôn trong ba cõi. Pháp âm của Ngài làm tiêu tan mọi hí luận, tà kiến; chinh phục các tà ma ngoại đạo. Những ai có căn trí, dù cao hay thấp, khi nghe pháp âm của Ngài đều hưởng được lợi lạc, khởi tâm dũng mãnh, tinh tấn tu tập cho đến khi chứng đạt đạo quả giác ngộ. Bởi vậy, trong Phật pháp, “tiếng gầm sư tử” đã được dùng để ví dụ cho pháp âm của đức Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sư Tử Hống Bồ Tát", "definition": "Siṃhanadanadin (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Hống Dụ Thập Nhất Sự", "definition": "師子吼喻十一事 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sư Tử Hống Kinh", "definition": "Xem Thắng Man Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Khải", "definition": "Xem Ha Ly Bạt Ma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Ngoạ Pháp", "definition": "Cách nằm của Sư Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Nguyệt", "definition": "Lion Moon", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sư Tử Nhũ", "definition": "Sữa của Sư Tử. Ví dụ tâm bồ đề. Kinh Đại Phương Quảng Phật Hoa Nghiêm quyển 78 (Đại 10, 432 hạ) nói: “Ví như người đem các loài sữa của bò, dê... chứa đầy cả biển lớn, nhưng chỉ cần nhỏ vào đó 1 giọt sữa sư tử rơi thẳng qua mà không bị ngăn ngại.Bậc Đại Bồ Tát cũng lại như thế, đem sữa tâm bồ đề của Như Lai Sư Tử bỏ vào giữa biển lớn sữa nghiệp phiền não từ vô lượng kiếp thì sữa nghiệp kia đều tan diệt hết, sữa tâm bồ đề thẳng suốt qua mà không bị ngăn ngại”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Nhẫn", "definition": "Kṣāntisiṃha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Pháp Môn", "definition": "Chỉ cho pháp môn của chư Phật Bồ Tát giáo hóa chúng sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Phát", "definition": "Harikeśa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Phạt Y Tư Na Phạt Phái", "definition": "Śrīvaisnava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Phấn Chấn Tam Muội", "definition": "Siṃha-Vijrmbhit-Samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Phấn Tấn", "definition": "Sư Tử chồm lên nhanh chóng. Khi sư tử lấy sức chồm lên thì các căn của nó đều giãn ra và mở rộng, lông trên mình đều dựng đứng, uy thế mạnh mẽ nhanh nhẹn, cất tiếng gầm thét thìcác loài thú khác đều hoảng sợ và chạy trốn, làm cho uy thế của những sư tử con cũng tăng thêm. Bởi vậy, trong các kinh thường dùng Sư Tử Phấn Tấn để dụ cho sức uy thần lớn của Phật. [X. Phẩm Dũng Xuất trong Kinh Pháp Hoa; Phẩm Nhập Pháp Giới trong Kinh Hoa Nghiêm Q.45 (bản dịch cũ); Hoa Nghiêm Kinh Thám Huyền Kí Q.18]. (xt. Sư Tử Phấn Tấn Tam Muội).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Phấn Tấn Tam Muội", "definition": "Phạm: Siôha-vijfmbhita-samàdhi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Phật", "definition": "Siṃha-Buddha (S) , Lion Buddha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Quang", "definition": "Siṃha-rasmi (S), Siṃhaprabha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Quốc", "definition": "Nước Sư-tử : tức nước Tích-lan, một đảo quốc ở Ấn-độ dương, cách bán đảo Ấn-độ khoảng 32 cây số về hướng Đông-Nam, là một trong những căn cứ địa chủ yếu của Phật giáo Nam-truyền Thượng Tọa Bộ. Tích-lan, vốn tên tiếng Phạn là Simhala, dịch âm Hán Việt là Tăng-già-la, dịch ý là sư tử. Ngày xưa người Trung-quốc thường gọi đó là nước Sư-tử, cũng gọi là đảo Đồng-chưởng, hay đảo Lăng-già; người Âu-châu gọi là nước Ceylon (dịch âm Hán Việt là Tích-lan). Từ năm 1505 đến năm 1658, Tích-lan bị người Bồ-đào-nha đô hộ; rồi từ năm 1796 đến năm 1948, lại bị người Anh đô hộ. Tích-lan đã lấy lại nền độc lập vào năm 1948, và đến năm 1972 thì đổi tên thành Sri Lanka (dịch âm Hán Việt là Tư-lí-lan-ca).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sư Tử Quốc Đảo", "definition": "Xem Lăng Già Đảo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Thân Trung Trùng", "definition": "Gọi tắt: Sư trùng. Trùng trong thân sư tử trở lại ăn thịt sư tử; ví dụ hạng Tỉ Khưu xấu ác vào trong cửa Phật, trở lại phá hoại Phật Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Trụ", "definition": "S. Harivarman. Luận sư Ấn Độ, tác giả bộ “Thành Thực Luận” (S. Satyasiddhi sastra).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Tử Tòa", "definition": "Siṃha-sana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Tôn Giả", "definition": "S. Aryasimha. Cao Tăng Ấn Độ, dòng Bà-la-môn, sinh quán ở Trung Ấn, là Tổ thứ 23 của Phật giáo Ấn Độ, theo một truyền thuyết của Thiền tông Trung Hoa. Bồ Đề Đạt Ma là tổ 28.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Tử Tướng", "definition": "Lion Appearance", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sư Tử Tỳ Kheo", "definition": "Siṃha-bhiksu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Viện", "definition": "獅 子 院. ở ngọn Sư Tử núi Thiên Mục, phía tây tỉnh Chiết Giang, Trung Quốc. Niên hiệu Chí nguyên thứ 16 (1279) đời Nguyên Thiền Sư Cao Phong Nguyên Diệu sáng lập, ban đầu gọi “Sư Tử Viện”. Niên hiệu Diên Hựu thứ 5 (1318) đổi tên là “Sư Tử Chính Tông Tự”. Cuối đời Nguyên bị chiến tranh phá hủy. Sau khi xây cất lại chùa có rất nhiều tên “Khai Sơn Lão Điện”, “Thiền Nguyên Tự”, “Chính Tông Tự”. X. “Chính Tông Tự”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Tử Vô Úy Quan Âm", "definition": "Xem Mã Đầu Quan Âm Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Tử Vương", "definition": "Cũng gọi Sư Tử Thú Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử là chúa của trăm loài thú, cho nên trong các kinh, luận nó thường được dùng để ví dụ cho đức vô úy và tính vĩ đại của Đức Phật. Lại như tòa ngồi của Phật gọi là tòa Sư Tử, Phật nói pháp gọi là Sư Tử Hống.", "definition": "II.Sư Tử (?-259). Phạm, Pàli: Siôha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Tử Âm", "definition": "Lion Voice", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sư Tử Ý Bồ Tát", "definition": "Siṃhamati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sư Uẩn", "definition": "師 蘊 (?-973). Thiền tăng đời Ngũ Đại, người xứ Kim Hoa (nay thuộc tỉnh Chiết Giang (Trung Quốc). Sư tính tình thành thực, gặp việc phần nhiều nói thẳng không kiêng nể. Khoảng niên hiệu Long Đức (921-923) thời Hậu Lương, sư kết bạn với Thiền Sư Đức Thiều lần lượt đi đến các danh sơn thắng cảnh như: Thanh Lương, Thương Ngộ, Chúc Thánh v. v.. Sau đó, sư trụ chùa Bát Nhã ở núi Thiên Thai. Hễ gặp người thích hài hước thì sư gắn bó như keo sơn, nên số người gìn giữ oai nghi tế hạnh không chịu kết bạn với sư, trừ Đức Thiều là hiểu được sư. Niên hiệu Khai Bảo thứ 6 (973) đời Tống, sư không bệnh ngồi thị tịch, như vào thiền định.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Vũ", "definition": "Đồng nghĩa: Pháp Lạp, Hạ Lạp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư có các tác phẩm: Chúng Kinh Mục Lục, Tây Vực Chí, Văn Tập, Biệt Tập. [X. Tục Cao Tăng Truyện Q.2; Quảng Hoằng Minh Tập Q.4; Đại Đường Nội Điển Lục Q.5].", "definition": "II.Ngạn Tông(? - ?)", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư có các tác phẩm: Luận Thập Chủng Đại Thừa, Luận Thập Địa 2 quyển. [X. Tục Cao Tăng Truyện Q.9].", "definition": "II.Tăng Xán (?-606).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư có các tác phẩm: Trung Luận Huyền Nghĩa, 1 quyển, Tứ Tất Đàn Nghĩa, 1 quyển. [X. Thắng Man Bảo Quật Q.thượng, phần đầu; Trung Luận Tự Sớ (Cát Tạng); Tục Cao Tăng Truyện Q.7; Tam Luận Tổ Sư Truyện Tập Q.hạ].", "definition": "III.Pháp Lãng (?-?).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư có các tác phẩm: Tâm Kinh Tiểu Đàm, Tập Luật Thường Quĩ, Lễ Phật Phát Nguyện Nghi, Thủ Lăng Nghiêm Kinh Huyền Đàm, Kim Cương Bát Nhã Lược Đàm, Tử Trúc Lâm Chuyên Ngu Hòa Thượng Ngữ Lục 30 quyển. [X. Linh Phong Ngẫu Ích Đại Sư Tông Luận Q.8; Tân Tục Cao Tăng Truyện Q.8].", "definition": "II.Quán hành", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư có tác phẩm: Pháp Hoa Kinh Nghĩa Kí 8 quyển. [X. Tục Cao Tăng Truyện Q.5; Lịch Đại Tam Bảo Kỉ Q.11; Pháp Hoa Huyền Luận Q.1].", "definition": "II.Pháp Vân (1088-1158).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư trả lời: Chẳng ngồi trên lưng trâu!”.", "definition": "III.Mật Thất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư tịch ngày 20 tháng 7, tháp hiệu Quỳnh Trân. Theo: Thiền Sư Việt Nam, của HT. Thanh Từ.", "definition": "如 如. Chân thật tướng của vạn sự vạn vật bình đẳng không hai, gọi là như như. Đoạn Tế Tâm Yếu ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Âm", "definition": "師 陰. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư Trung Vân Cái Sơn. Khi ra hoằng pháp, sư trụ viện Đại Trí tại Hòa Sơn. Sư học rộng, tính tình giản dị trầm lặng; suốt ngày ngồi lặng lẽ, có ai thưa hỏi mới đáp và chỉ đáp vắn tắt vài lời mà thôi.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Ông", "definition": "Sa di ngoài 20 tuổi, nếu được thụ giới đầy đủ 250 giới gọi là sư ông, hay là Tỷ kheo (theo tiếng Phạn Bikhnu).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sư Úc", "definition": "師 郁. Thiền tăng đời Ngũ Đại, người xứ Tuyền Châu, tham vấn Thiền Sư Tuyết Phong Nghĩa Tồn và đắc pháp nơi Ngài. Sư ở viện Tây Hưng Trấn Hóa Độ tại Hàng Châu. Sư học rộng, giỏi thi ca, nổi tiếng khắp xa gần. Ngô Việt Vương tặng thự hiệu “Ngộ Chân Đại Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sư Đàn", "definition": "Từ ngữ gọi chung đàn việt (thí chủ) và sư tăng. Luận Thuyết Pháp Minh Nhãn nói: “Một ngày sư đàn, trăm kiếp kết duyên”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Đệ", "definition": "師第. Thầy và trò.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư Đồ", "definition": "師徒. Như Sư đệ 師第.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sư để lại các tác phẩm: Luận Quang Tam Ma Da (tức là Luận A Tì Đạt Ma Tạng Hiển Tông, 40 quyển, do ngài Huyền Trang dịch), Luận Tùy Thực (tức là luận Thuận Chính Lí, 80 quyển). [X. Câu Xá Luận Quang Kí Q.1; Đại Đường Tây Vực Kí Q.4; Nam Hải Kí Qui Nội Pháp Truyện Q.4].", "definition": "II.Tăng Già Bạt Đà La.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư để lại các tác phẩm: Nhiếp Đại Thừa Luận nghĩa sớ 8 quyển, Quán Vô Lượng Thọ Kinh Sớ 1 quyển, Niết Bàn Kinh Sớ, Duy Ma Kinh Sớ, Thắng Man kinh sớ... [X. Tục Cao Tăng Truyện Q.15; Quảng Hoằng Minh Tập Q.25; Khai Nguyên Thích Giáo Lục Q.8].", "definition": "II.Pháp Thường (752-839).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sư Ấn", "definition": "師 印. Sự ấn khả, chứng minh của thiền sư. Thiên Nhất Túc Giác Hòa Thượng trong TĐT q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sưng Lên", "definition": "Pīṇa (tính từ), uppakka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sưu", "definition": "叟. Xem Sưu sưu 叟叟 Một âm khác là Tẩu Xem Tẩu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Bổ", "definition": "蒐補. Cứ chiếu theo phần đóng góp mà thâu cho đủ Cũng có nghĩa là lọc bỏ đi bỏ cái xấu ra mà thêm cái tốt cho đủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Cầu", "definition": "搜求. Tìm kiếm. Tìm tòi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Dịch", "definition": "蒐役. Việc nặng nhọc mà dân chúng phải đóng góp bằng sức lực (đắp đê, làm đường..).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Không", "definition": "搜空. Tiếng trống đánh, ra hiệu đóng thành vào buổi tối. Cũng như: Thu không. Tự tình khúc của Cao Bá Nhạ có câu: “Chuông cổ tự điểm hồi rộn giục, trống quan thành vừa lúc Sưu không”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Kiểm", "definition": "搜檢. Tìm tòi tra xét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu La", "definition": "搜羅. Tìm tòi sắp xếp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Ngữ", "definition": "廋語. Lời nói kín đáo, cái ý ngầm kiếm ẩn bên trong. Cũng như: Ẩn ngữ. Td: A đổ vật (chỉ tiền bạc) là một thứ Sưu ngữ (tức Ẩn ngữ) Câu đố. Cũng như: Mê ngữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Nhuận", "definition": "蒐潤. Sửa sang lại cho văn chương cho hay, cho đúng. Như: Nhuận sắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Nã", "definition": "搜拿. Tìm bắt kẻ có tội. Cũng như: Tầm nã.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Sách", "definition": "搜索. Tìm tòi Tìm kiếm đòi hỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Sưu", "definition": "叟叟. Tiếng vo gạo sào sạo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Thuế", "definition": "蒐稅. Tiền bạc và sức lực mà dân chúng phải đóng góp để làm việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Thập", "definition": "蒐拾. Gom góp lượm lặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Tiết", "definition": "蒐節. Lược bỏ bớt đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Tra", "definition": "搜查. Tìm tòi xem xét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Trừ", "definition": "搜除. Tìm tòi và lược bỏ cái vô ích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Tầm", "definition": "搜尋. Tìm tòi. Tìm kiếm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Tập", "definition": "搜集. Tìm kiếm gom góp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Tỉnh", "definition": "蒐省. Như Sưu tiết 蒐節.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưu Từ", "definition": "廋辭. Như Sưu ngữ 廋語.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương", "definition": "凔. Lạnh lắm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Cư", "definition": "孀居. Để tang cho chồng Ở vậy thờ chồng, không tái giá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Giáng", "definition": "霜降. Sương xuống Tên thời tiết, vào khoảng các ngày 23, 24 tháng 10 dương lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Khuê", "definition": "孀閨. Phòng của đàn bà goá chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Liệt", "definition": "霜烈. Nghiêm khắc lạnh lùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Lộ", "definition": "霜露. Sương mù và sương đọng thành giọt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Lộ Chi Bệnh", "definition": "霜露之病. Bệnh cảm hàn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Mấn", "definition": "霜鬢. Tóc bạc trắng như sương. Chỉ tuổi già.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Nguyệt", "definition": "霜月. Một tên chỉ tháng bảy âm lịch, tháng đầu thu có nhiều sương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Nhận", "definition": "霜刃. Mũi gươm đao sáng loáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Phong", "definition": "霜風. Sương và gió. Chỉ nỗi gian nan vất vả. Bản dịch Chinh phụ ngâm khúc có câu: “Đã trắc trở đổi ngàn xà hổ, lại lạnh lùng như chỗ sương phong”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Phòng", "definition": "霜房. Như Sương khuê 霜閨.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Phụ", "definition": "孀婦. Người đàn bà có tang chồng Đàn bà goá chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Thê", "definition": "孀妻. Người đàn bà để tang chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Tuyết", "definition": "Mahikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sương Tín", "definition": "霜信. Tin sương. Sương xuống báo tin mùa thu tới Một tên chỉ loài chim nhạn. Chim nhạn bay, báo tin mùa thu tới và sương xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Uy", "definition": "霜威. Vẻ oai nghiêm lạnh lùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sương Vệ", "definition": "Gọi đủ: Giáp Môn Sương Vệ. Cũng gọi Sương Khúc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sương Đài", "definition": "霜臺. Tiếng chỉ các bậc Ngự sử đại phu thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sước", "definition": "㲋. Tên một loài thú, tương truyền loài thú này đầu thỏ chân hươu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sướng", "definition": "婸. Tính dâm đãng của đàn bà con gái Tôi. Ta (đại danh từ ngôi thứ nhất số ít).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sướng Hoài", "definition": "暢懷. Vui thích trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sướng Khoái", "definition": "暢快. Vui thích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sướng Lợi", "definition": "暢利. Thông suốt trôi chảy trong công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sướng Toại", "definition": "暢遂. Nói về cây cối nảy nở tươi tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sướng Uất", "definition": "暢蔚. Như Sướng toại 暢遂.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưởng", "definition": "惝. Lòng dạ chán nản, chẳng để ý tới gì. Cũng đọc Thảng, hoặc Thưởng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưởng Hoảng", "definition": "惝怳. Lòng dạ hay quên, chẳng nhớ được gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sưởng Mậu", "definition": "鬯茂. Nói về cây cối nảy nở tươi tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sạ", "definition": "乍. Tạm thời thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sạ Dung", "definition": "(?-195).Cư Sĩ Phật Giáo Trung Quốc, sống vào cuối đời Đông hán, người Đơn Dương (An Huy), tự Vĩ Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sạ Khả", "definition": "乍可. Chỉ có thể. Chỉ còn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sạch", "definition": "Sukka (tính từ), sodheti (sudh + e), pariyodāta (tính từ), mejjha (tính từ), nikkaddama (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sạch Sẽ", "definition": "Vimala (tính từ), visada (tính từ), suci (tính từ), suddha (tính từ), parisodhana (trung), odāta (tính từ), accha (tính từ), avadāta (tính từ), vodapeti (vi + u + dā + āpe), vodapana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sạn", "definition": "丳. Cái xiên để xiên thịt mà nướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sạn Phòng", "definition": "棧房. Nhà kho. Chỗ cất giữ hàng hoá Nhà trọ. Như: Khách sạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sạn Đơn", "definition": "棧單. Giấy chứng nhận gửi hàng hoá vào kho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sạn Đạo", "definition": "棧道. Đường đi trên các vùng núi non hiểm trở, dùng cây và gỗ gác lên, treo mà đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sải Tay", "definition": "Byāma (nam) Vyāma (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sảm", "definition": "儳. Cẩu thả Một âm là Sàm. Xem Sàm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảm Ngôn", "definition": "儳言. Lời nói sai lầm, thiếu suy nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản", "definition": "剗. Cắt cỏ Trừ diệt đi Trừ loạn, làm cho đất nước được yên ổn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Bà", "definition": "產婆. Cô mụ. Bà đỡ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Dục", "definition": "產育. Đẻ con và nuôi con.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Hậu", "definition": "產後. Sau khi sinh đẻ Chứng bệnh xảy tới sau khi sinh đẻ. Ta gọi là bệnh hậu sản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Khoa", "definition": "產科. Ngành đỡ đẻ và chữa trị các chứng bệnh về sinh đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Môn", "definition": "產門. Cửa mình đàn bà, cửa sinh đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Mẫu", "definition": "產母. Người đàn bà sinh đẻ, làm mẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Nghiệp", "definition": "產業. Của cải tạo ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Ngạch", "definition": "產額. Số lượng vật phẩm làm ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Phẩm", "definition": "產品. Thứ làm ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Phụ", "definition": "產婦. Đàn bà đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Thực", "definition": "產殖. Sinh đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Tiền", "definition": "產前. Thời gian có thai, trước khi sinh đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Tử Thiền", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sản Vật", "definition": "產物. Thứ làm ra được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sản Xuất", "definition": "產出. Làm ra. Tạo ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng", "definition": "倉. Thối chí, nản lòng Một âm khác là Thương. Xem Thương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Hoảng", "definition": "愴怳. Vẻ thối chí, nản lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Khoái", "definition": "爽快. Tỉnh táo vui vẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Khí", "definition": "爽氣. Vẻ trong sáng Bầu trời trong sáng, khí hậu mát mẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Khải", "definition": "爽塏. Sáng sủa rộng rãi. “Một vùng sảng khải đắp đồ ngưu miên” (Nhị Độ Mai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Lợi", "definition": "爽利. Vui thích nhẹ nhàng cao thượng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Ngôn", "definition": "爽言. Lời nói sai lầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Nhiên", "definition": "爽然. Vẻ thối chí, nản lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Nhược Nhật Tinh", "definition": "爽若日星. Sáng sủa như mặt trời và các vì sao. Chỉ lòng dạ và hành động ngay thẳng công khai của người quân tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Pháp", "definition": "爽法. Không theo đúng phép tắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảng Ước", "definition": "爽約. Không đúng hẹn. Sai hẹn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảnh", "definition": "倩. Chàng rể Mướn người làm thay mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảnh Sự", "definition": "廳事. Chỗ quan làm việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảnh Tai", "definition": "眚災. Việc có hại xảy tới thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảnh Đình", "definition": "廳亭. Ngôi nhà lớn Phủ quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảnh Đường", "definition": "廳堂. Ngôi nhà lớn Phủ quan, chỗ quan làm việc, Đoạn trường tân thanh có câu: “Dỡ đò lên trước sảnh đường, Khuyển Ưng hai đứa nộp nàng dâng công”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo", "definition": "㑿. Dài (trái với ngắn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Am", "definition": "稍諳. Biết hơi hơi, biết chút đỉnh. Td: Sảo am thế vụ (hiểu biết chút ít về việc đời, ý nói ít kinh nghiệm về cuộc đời).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Giảo", "definition": "搜攪. Quấy rối. Gây lộn xộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Khả", "definition": "稍可. Tạm được. Được hơi hơi Khá khá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Lễ", "definition": "稍禮. Lể mọn. Chỉ vật đem biếu người khác, nói với ý khiêm nhường Việc cung cấp ăn uống cho các tân khách của triều đình thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Sảo", "definition": "㑿㑿. Dài lê thê, thậm thượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Thông", "definition": "稍通. Hơi biết. Biết chút ít.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Thức", "definition": "稍識. Như Sảo thông 稍通.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Thực", "definition": "稍食. Chỉ lương bổng của quan lại thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sảo Tri", "definition": "稍知. Như Sảo thông 稍通.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm", "definition": "沁. Thấm vào. Ngấm ướt Múc lên Một âm là Thấm. Xem Thấm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Bộ", "definition": "讖步. Phép đoán biết trước chuyện sẽ xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Họa", "definition": "闖禍. Tai vạ thình lình xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Kí", "definition": "讖記. Sách chép lời đoán việc vị lai Sách vở về việc bói toán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Ngôn", "definition": "讖言. Lời đoán việc tương lai. Lời tiên tri. Ta cũng gọi Lời sấm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Ngữ", "definition": "讖語. Như Sấm ngôn 讖言.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Sét", "definition": "Zeus.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sấm Sự", "definition": "闖事. Việc không hay khi không xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Truyền", "definition": "讖傳. Lời tiên tri rằng Lời tiên tri từ lâu đời được truyền lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Tịch", "definition": "闖席. Vào dự tiệc nửa chừng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấm Vĩ", "definition": "讖緯. Chỉ chung các loại sách về bói toán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấn", "definition": "儭. Ở trong. Bên trong Tới. Gần sát Đem tiền của bố thí cho tăng sĩ Một âm là Thân. Xem Thân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấn Khẩu", "definition": "趁 口. Còn gọi: Sấn khẩu đầu, Sấn khẩu khoái. Đi theo sau người khác, lời nói có vẻ vội vàng, khinh suất. Tiết Phật Nhãn Viễn Thiền Sư trong GTPĐL q. 25 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sấn Kim", "definition": "Cũng gọi Sấn tài, Sấn tiền. Gồm có 3 nghĩa:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sấn Sam", "definition": "襯衫. Áo lót mình thời xưa Ngày nay còn chỉ cái áo sơ mi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấn Thuyền", "definition": "趁船. Ngồi thuyền, đi thuyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấn Tiền", "definition": "儭錢. Số tiền bố thí cho tăng sĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấn Trục Ngôn Chương", "definition": "趁 逐 言 章. Chấp trước vào chữ nghĩa thiên chương, tìm nghĩa giải trong ấy. Chương 14 liệu giản của Chí Công Hòa Thượng trong CĐTĐL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sấn Vật", "definition": "Đồng nghĩa: Sấn Tư.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sấn Y", "definition": "Cũng gọi Sấn Thân Y, Sấn Thể Y.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sấnthí", "definition": "Sấn, Phạm: Dakwiịà. Pàli: Dakkhiịà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sấp", "definition": "湁. Nước sôi lên. Nước sủi bọt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấp Tập", "definition": "湁潗. Nước sôi. Nước sủi bọt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sất", "definition": "叱. La lớn. Hét lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sất Sá", "definition": "叱咤. La hét giận dữ. Quát mắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sất Sất", "definition": "叱叱. Tiếng gọi gấp rút, rối rít Tiếng la hét. Như Sất sá 叱咤.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấu", "definition": "𤸃. Như chữ Sấu 瘦.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấu Cốt", "definition": "瘦骨. Vóc dáng gầy gò Vóc dáng thanh nhã. Td: Sấu cốt như mai (vóc dáng thanh nhã như cây mai) Mai cốt sấu nan chi 梅骨瘦難支 (Đường thi). Người gầy như cành mai, đứng không vững. “Xương mai tính đã rũ mòn” (Kiều).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấu Dung", "definition": "瘦容. Dáng mặt gầy guộc Dáng mặt buồn rầu phờ phạc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấu Nhược", "definition": "瘦弱. Gầy gò yếu đuối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấu Tiểu", "definition": "瘦小. Gầy gò nhỏ bé.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sấy Khô", "definition": "Ussussati (u + sus + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sầm", "definition": "岑. Trái núi nhỏ mà cao Bờ bến Họ người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầm Lâu", "definition": "岑樓. Đỉnh núi. Chóp núi Nhà lầu trên núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầm Lãnh", "definition": "岑嶺. Núi cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầm Sơn", "definition": "岑山. Tên một ngọn núi thuộc tỉnh Thanh hoá của Việt Nam Tên một cửa biển thuộc tỉnh Thanh hoá, nơi nghỉ mát có khí hậu rất tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầm Sầm", "definition": "岑岑. Cao chót vót Nhức nhối khó chịu (chẳng hạn nói về sự nhức đầu). Khó chịu, không vui.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầm Tịch", "definition": "岑寂. Cao và yên lặng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầm Uất", "definition": "岑蔚. Cao và rậm rạp, nói về những cánh rừng rậm trên núi Chỉ sự đông đảo, thịnh vượng. “Đường sá quanh co cảnh sầm uất” (Thơ cổ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu", "definition": "愁. Buồn rầu Lo buồn Buồn thảm. Đoạn trường tân thanh có câu: “Khúc đầu Tư Mã Phượng cầu, nghe ra như oán như sầu phải chăng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Bi", "definition": "愁悲. Buồn rầu. Hát nói của Nguyễn Công Trứ có câu “Khi hỉ nộ khi ái ố lúc sầu bi, chứa chi lắm một bầu nhân dục”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Cảm", "definition": "愁感. Điều buồn rầu thấy được trong lòng. Thấy buồn Mối buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Hoài", "definition": "愁懷. Lòng buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Hoạ", "definition": "愁畫. Bức tranh buồn Chỉ cảnh trời buồn, giống như một bức tranh buồn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Hải", "definition": "愁海. Biển buồn, chỉ nỗi buồn rộng lớn mênh mông như biển.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Hận", "definition": "愁恨. Buồn giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Khổ", "definition": "愁苦. Buồn rầu đau đớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Lâm", "definition": "愁霖. Mưa buồn, mưa dầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Lệ", "definition": "愁淚. Nước mắt buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Lộ", "definition": "愁露. Giọt sương buồn. Chỉ giọt nước mắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Mi", "definition": "愁眉. Gặp mày buồn. Chỉ nét mặt buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Muộn", "definition": "愁悶. Buồn phiền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Mộng", "definition": "愁夢. Giấc mơ buồn Buồn rầu mơ tưởng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Nhan", "definition": "愁顏. Vẻ mặt buồn rầu. Như Sầu mi 愁眉.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Não", "definition": "愁惱. Buồn rầu đau khổ. Bản dịch Chinh phụ ngâm khúc có câu: “Đâu xiết kể trăm sầu nghìn não, từ nữ công phụ xảo đều nguôi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Oán", "definition": "愁怨. Buồn giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Thi", "definition": "愁詩. Bài thơ buồn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Thiên", "definition": "愁天. Bầu trời buồn bã Chỉ nỗi buồn rộng lớn như cả bầu trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Thành", "definition": "愁城. Bức tường sầu, chỉ nỗi buồn to lớn vững chắc như bức thành. Hát nói của Nguyên Công Trứ có câu: “Dục phá sầu thành tu dụng tửu” (muốn đập vỡ bức tường sầu thì nên dùng rượu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Thê", "definition": "愁悽. Như Sầu thảm 愁慘.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Thảm", "definition": "愁慘. Buồn rầu lạnh lẽo. Đoạn trường tân thanh có câu: “Chàng rằng phổ ấy tay nào, xưa sao sầu thảm nay sao vui vầy”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Trường", "definition": "愁腸. Khúc ruột buồn, chỉ lòng buồn. “Khúc Sầu trường bối rối đường tơ” (Cung oán).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Ty", "definition": "愁絲. Tơ buồn. Chỉ lòng buồn rầu, rối loạn. Td: Sầu ty vạn lũ (tơ sầu vạn sợi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Tân", "definition": "愁辛. Buồn rầu cay đắng. Buồn khổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Tình", "definition": "愁情. Lòng buồn, mối buồn Mối buồn vì sự yêu đương trai gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Tố", "definition": "愁訴. Nói lên nỗi buồn của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Tứ", "definition": "愁思. Ý tưởng, ý nghĩ buồn rầu. Lòng buồn Đọc là Sầu tư, có nghĩa là buồn rầu nghĩ ngợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Tự", "definition": "愁緖. Đầu mối nỗi buồn,.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Vân", "definition": "愁雲. Áng mây buồn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sầu Âm", "definition": "愁音. Tiếng đàn, tiếng hát, giọng nói buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sẩm", "definition": "墋. Hòn sỏi, hòn sạn lẫn trong đồ ăn Không được sạch sẽ, lẫn đất cát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sẩm Xước", "definition": "踸踔. Vừa đi vừa nhảy Bất định. Không chắc chắn, nhất định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sẩn", "definition": "哂. Mỉm cười Chê cười.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sẩn Nạp", "definition": "哂納. Mỉm cười mà dâng nộp. Chỉ sự tặng biếu Chê cười mà nhận cho. Tiếng khiêm nhường, dùng để nói khi tặng biếu ai vật gì, ngỏ ý mong dù người đó có chê cười thì cũng xin nhận cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sẩn Tiếu", "definition": "哂笑. Mỉm cười tỏ ý chê bai. Chê cười.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sẩy Chân", "definition": "Khalati (khal + a), khalita (trung), pakkhalati (pa + khal + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sậu", "definition": "驟. Ngựa chạy nhanh Nhanh chóng Thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sậu Biến", "definition": "驟變. Thay đổi thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sậu Chí", "definition": "驟至. Xảy tới thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sậu Nhiên", "definition": "驟然. Thình lình. Bỗng dưng,.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sậu Vũ", "definition": "驟雨. Mưa rào. Trận mưa thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sậu Đắc", "definition": "驟得. Thình lình mà được. Bỗng dưng mà có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc", "definition": "Theo nghĩa rộng, chỉ cho toàn thể mọi loại vật chất tồn tại trong vũ trụ (có hình trạng, có biến đổi, hoại diệt); theo nghĩa hẹp, chỉ cho đối tượng của nhãn căn (tức tất cả những gì được trông thấy bằng mắt).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sắc Chiếu", "definition": "敕詔. Như sắc chỉ 敕旨.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Chỉ", "definition": "敕旨. Tờ giấy ghi lệnh vua Giấy ghi lệnh vua ban chức tước cho ngày nào, Đoạn trường tân thanh có câu: “Khâm ban sắc chỉ tới nơi rành rành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Cái", "definition": "Sắc là sắc trần, Cái là che lấp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Căn", "definition": "Vatthurūpa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Cảnh", "definition": "Rūpa-visaya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Cứu Cánh", "definition": "(trời), Akanishtha heaven", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sắc Cứu Cánh Thiên", "definition": "Akṣanirtha (S), Akaniṣṭha (S), Akanittha (P), Akanitthadeva (P), Highest Heaven of the world of form.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Cứu Kính Thiên", "definition": "S. Akahistha. Cõi Trời cao nhất của Sắc giới. Thọ mạng của chư Thiên ở cõi Trời Sắc giới cứu kính thiên là 16.000 kiếp, thọ mạng dài không thể tưởng tượng được nếu so với thọ mạng của loài người. Có những vị ở cõi người tu chứng quả Bất Lai, sau khi tịch sẽ sinh lên cõi Trời Sắc cứu kính thiên rồi nhập Niết Bàn ở đấy, không phải trở lại cõi Dục giới nữa nên gọi là Bất lai. Một tên gọi khác của cõi Trời này là Sắc đỉnh (cõi cao tột đỉnh của Sắc giới).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sắc Duy Đặc Lợi", "definition": "Savitṛ (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Dưỡng", "definition": "色養. Lấy nét mặt tươi tỉnh kính cẩn mà nuôi nấng cha mẹ (như vậy mới thật là hiếu).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Dục", "definition": "Chữ “sắc” ở đây được đặc biệt dùng để chỉ cho dung nhan, hình mạo đẹp đẽ, quyến rũ của nam nữ. “Sắc Dục” là một thuật ngữ Phật học, có nghĩa là tâm ham muốn tình ái giữa nam nữ. Bởi vậy, từ “sắc dục” cũng đồng nghĩa với các từ “ái dục”, “tình dục”, “dâm dục”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sắc Giác", "definition": "色覺. Sự nhận biết về màu và ánh sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Giới", "definition": "Rūpa-bhūmi (P), Rūpavacara (S), Rūpaloka (S, P), Rūpa-dhātu (S), zuk kham (T), Rūpa-brahma plane, World of form, Form realm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Giới Hệ", "definition": "Sự trói buộc bởi các pháp ở cõi Sắc. Luận Đại Tì Bà Sa quyển 52 (Đại 27, 271 hạ) nói: “Bị dục trói buộc nên gọi là Dục Giới Hệ; bị sắc trói buộc nên gọi là Sắc Giới Hệ, bị Vô Sắc trói buộc nên gọi là Vô Sắc Giới Hệ. Như trâu, ngựa bị buộc vào cây cọc hoặc gốc cột, gọi là Trụ Đẳng Hệ”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Giới Thiên", "definition": "Trời cõi Sắc . Cõi Sắc có bốn tầng trời do phước báo của công phu tu tập bốn thiền định căn bản, đoạn trừ phiền não mà phát sinh các công đức lành; cho nên cũng được gọi là “bốn cõi trời Thiền” (Tứ-Thiền thiên). “Thiền” là tiếng nói tắt của từ “thiền-na”, phiên âm từ Phạn ngữ “dhyana”, Hán ngữ dịch là “tĩnh lự”, nghĩa là: giữ tâm hoàn toàn tĩnh lặng để suy tìm chân lí, nhờ đó mà có được cái thấy như thật. Bốn cõi trời Thiền gồm có: cõi Sơ-thiền, cõi Nhị-thiền, cõi Tam-thiền và cõi Tứ-thiền. Bốn cõi này đã rời xa hẳn các loại cảm thọ của Dục giới, chỉ tương ưng với các loại quán tưởng và cảm thọ của Sắc giới mà thôi. Từ Sơ-thiền cho đến Tứ-thiền, các hoạt động tâm lí tuần tự phát triển, và hình thành cái thế giới tinh thần khác biệt nhau.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sắc Giới Thập Bát Thiên", "definition": "Mười tám tầng trời của cõi Sắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Hoang", "definition": "色荒. Buông thả theo vẻ đẹp đàn bà và những thói dâm ô.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Hoàng", "definition": "Sắc chỉ của Thiên Tử viết trên giấy màu vàng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Hữu", "definition": "Chỉ cho cõi Sắc, 1 trong 3 hữu: Dục Hữu, Sắc Hữu, Vô Sắc Hữu, đồng nghĩa với 3 cõi Dục, Sắc và Vô Sắc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Không", "definition": "(色空): sắc và không. Sắc (s, p: rūpa, 色) là cái mang tính vật chất. Không (s: śūnya, p: suñña, 空) là cái không có thật thể cố định. Trong Kinh Bát Nhã của Phật Giáo Đại Thừa đã phủ định triệt để hết thảy mọi cố định của các sự vật hiện tượng (sắc, pháp, v.v.) và chính Long Thọ (s: Nāgājruna, 龍樹) đã hoàn chỉnh và hình thành nên hệ thống lý luận triết học về Không này.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sắc Kim Cang Bồ Tát", "definition": "Rūpavajra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Kim Cương", "definition": "Phạm: Rùpa-vajra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Luật", "definition": "敕律. Văn kiện của tổng thống trong chế độ cộng hoà, ấn định về việc gì, văn kiện này có giá trị như một đạo luật do quốc hội biểu quyết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Lượng", "definition": "Trong kinh điển Phật Giáo, từ ngữ Sắc Lượng được dùng để chỉ chung cho các đơn vị của các loại vật chất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Lặc", "definition": "敕勒. Lá bùa, có ghi chữ nghĩa và vẽ dấu hiệu đuổi tà ma Tên một giống dân thiểu số Trung Hoa, dòng dõi Hung Nô thời cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Lệ", "definition": "勅厲. Khuyên răn thúc giục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Lệnh", "definition": "敕令. Giấy ghi điều vua sai làm. Văn kiện của tổng thống trong chế độ cộng hoà, ấn định về việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Manh", "definition": "色盲. Mù về màu, một bệnh vầ mắt, người mắc bệnh này không nhìn thấy màu gì ngoài hai màu đen trắng (Color Blindness).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Mê", "definition": "色迷. Say đắm vẻ đẹp đàn bà và thói dâm ô.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Mạng Căn", "definition": "Rūpa-jīvitindriyā (S), (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Mệnh", "definition": "敕命. Tờ giấy ghi lệnh ban thưởng của vua cho bề tôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Nan", "definition": "色難. Sự khó khăn ở vẻ mặt, nét mặt, trong việc cư xử với cha mẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Nghệ", "definition": "色藝. Chỉ vẻ đẹp của mặt và tài năng. Cũng như: Sắc tài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Phong", "definition": "敕封. Lệnh vua ban thưởng chức tước cho người nào. Nguyễn Khuyến có câu đối: “Bốn phẩm sắc phong hàm cụ lớn, nghìn năm danh giá của bà to”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Phu", "definition": "嗇夫. Người làm ruộng, người thợ gặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Pháp", "definition": "Là tất cả các pháp thuộc về vật chất; là từ ngữ được hiểu theo nghĩa rộng của chữ  “SẮC” (xem mục “Sắc”). Theo nghĩa này, “sắc” là chỉ chung cho các thứ vật chất, là những vật có hình trạng, có chiếm một khoảng không gian nhất định, làm chướng ngại cho nhau, và có tính chất thay đổi, tàn hoại. Những pháp mặc dù không có hình tướng, nhưng có thể nhận biết bằng năm giác quan (như âm thanh, mùi hương, v.v...), cũng thuộc về sắc pháp. Cả Hữu Bộ và tông Pháp Tướng đều phân tích sắc pháp gồm có 11 pháp, là: năm căn (nhãn, nhĩ, tị, thiệt, thân), năm cảnh (sắc, thanh, hương, vị, xúc), và vô biểu sắc.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sắc Phục", "definition": "色服. Quần áo có màu, nhiều màu Nay còn hiểu là quần áo riêng của một đoàn thể, mà kiểu và màu thống nhất. Như Đồng phục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Quang", "definition": "Cũng gọi Ngoại Quang, Thân Quang. Đối lại: Tâm Quang.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Sai Trụ Trì Viên", "definition": "Chỉ cho những chùa viện thuộc cấp cao nhất ở đời Tống, được triều đình đãi ngộ đặc biệt. Vị Trụ Trì của các chùa viện này do sắc chỉ của vua bổ nhiệm, khác hẳn với các chùa viện thông thường và chùa viện thập phương. Trong các tông phái, Thiền Tông chiếm số nhiều các chùa viện thuộc loại này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Sắc", "definition": "色色. Nhiều loại, nhiều thứ la liệt, đầy dẫy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Sở Duyên", "definition": "Rūparammāna (S), Visible object.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Sứ Niệm Hương", "definition": "Niệm hương cảm tạ vị Sắc Sứ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Sử Môn", "definition": "Chokushimon (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Thanh", "definition": "Shapes and sounds", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sắc Thái", "definition": "色彩. Màu. Màu sắc Rực rỡ, nhiều màu Vẻ riêng bề ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Thân", "definition": "Rūpakāya (S), zuk kyi ku (T), kāyas.Form body, zug ku (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Thân Viên Đức", "definition": "Đức viên mãn của sắc thân Như Lai, thuộc về Quả viên đức trong 3 Viên Đức. Cứ theo Luận Câu Xá quyển 27 thì sắc thân viên đức có 4:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Thư", "definition": "敕書. Tờ giấy ghi lời vua khuyên dụ bề tôi hoặc thần dân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Thần", "definition": "穡臣. Vị quan thời cổ, coi về nông nghiệp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Thụ", "definition": "敕授. Lệnh vua trao tước hiệu chức vị cho người nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Thụy", "definition": "Cũng gọi Sắc Thụy Hiệu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Tiếu", "definition": "色笑. Cười bằng nét mặt, tức nét mặt vui vẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Trang", "definition": "色莊. Vẻ nghiêm chỉnh ngoài mặt mà thôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Trí", "definition": "色智. Sự khoe khoang tài trí lộ ra vẻ mặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Trạch", "definition": "色澤. Có màu và bóng loáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Trần", "definition": "色塵. Tiếng nhà Phật, một trong Lục trần, chỉ sự dơ bẩn về hình dạng màu mè, cản trở việc tu đạo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Tu Bách Trượng Thanh Qui", "definition": "Gọi tắt: Sắc Tu Thanh Qui, Bách Trượng Thanh Qui.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Tướng", "definition": "Xem Sắc.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Tướng Độ", "definition": "Chỉ cho cõi nướcnươngở của sắc thân vi trần tướng hải của Như Lai, là 1 trong Ngũ Độ. Cõi này muôn đức thành tựu và trang nghiêm bằng vô số báu vật, rộng khắp không ngằn mé. [X. Đại Minh Tam Tạng Pháp Số Q.20]. (xt. Ngũ Độ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Tặng", "definition": "敕贈. Như Sắc phong 敕封.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Tố", "definition": "色素. Chất có màu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Tứ", "definition": "敕賜. Như Sắc phong 敕封, Sắc tặng 敕贈.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắc Tứ Từ Ân", "definition": "敕 賜 慈 恩. Chùa ở số 23 đường Tân Hóa, phường 14 Phú Lâm, Thành phố Hồ Chí Minh, Việt Nam. Chùa được dựng vào năm Gia Long thứ 1 (1802) tại thôn Hòa Hưng, huyện Bình Dương, tỉnh Gia Định (cũ) nay thuộc địa chỉ trên. Sau khi chùa xây xong, Hiếu Khang Hoàng hậu (họ Trương, mẹ Gia Long) cúng biển sơn. Năm 1821 vua Minh Mệnh ban biển tên chùa: Sắc tứ Từ Ân Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sắc Tức Thị Không", "definition": "Phạm: Rùpaô-zùnyatà hoặc Yad rùpaô sà zùnyatà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Uẩn", "definition": "Upadarūpa (P), Rūpa-khandha (P), Rūpa-skandha (S), Aggregate of form Rūpa-khandha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắc Uẩn Hữu Ngũ Chủng Tướng", "definition": "色蕴有五種相 (Hiển Dương Thánh Giáo Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sắc Vi", "definition": "Vi là cực nhỏ. Những phần tử cực nhỏ, kết hợp lại thành các dạng vật chất. Sách Phật thường dùng từ cực vi, cũng như hiện nay nói nguyên tử hay phân tử.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sắc Y", "definition": "Màu sắc của áo ca sa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sắc Ái", "definition": "Luyến ái cõi Sắc.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sắc Ái Kết", "definition": "Rūparāga (S), Desire for fine material existence.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sắp Xếp", "definition": "Vidhāna (trung), pakappanā (nữ), paccupaṭṭhāpeti (pati + upa + ṭhā + āpe), paññāpana (trung), paṭisāmeti (paṭi + saṃ + e), paṭiyādeti (paṭi + yat + e), racanā (nữ), vikappeti (vi + kapp + e), saṃvidahati (saṃ + vi + dhā + a), saṃvidahana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sắp Đặt", "definition": "Ajjhāsaya (nam), ajjhāsayatā (nữ), racayati (rac + aya), sampala (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sắt", "definition": "𠤋. Như chữ Sắt 虱, 蝨.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắt Cầm", "definition": "瑟琴. Tên hai loại đàn thời xưa, đàn sắt có 50 dây, đàn cầm có 7 dây. Bản dịch Chinh phụ ngâm khúc có câu: “Sắt cầm gượng gảy tiếng đàn, dây uyên kinh dứt phím loan ngại chùng” Tiếng đàn Sắt và tiếng đàn Cầm rất hoà hợp, do đó Sắt cầm còn chỉ sự thắm thiết hoà hợp giữa hai vợ chồng. Đoạn trường tân thanh có câu: “Ai ngờ lại họp một nhà, lọ là chăn gối mới ra sắt cầm”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắt Súc", "definition": "瑟縮. Dáng co ro Dáng sợ hãi, rịt rè.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sắt Sắt", "definition": "瑟瑟. Tiếng gió thổi, vẻ lạnh lẽo, buồn thảm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sằn Đề Ba La Mật", "definition": "Xem Kiên Nhẫn Ba La Mật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sằn Đề La", "definition": "Phạm: Waịđhilà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sằn Đề Tiên Nhân", "definition": "Phạm: Kwànti-vàdi-fwi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sằn Đề Đề Bà", "definition": "Śāntideva (S), Sằn Đề Đề Bà , Kṣānti-vadirsi (S), Kṣāntideva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sẵn Sàng", "definition": "Kalla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sặc Sỡ", "definition": "Sucitta (tính từ), sucittita (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sế", "definition": "傺. Ngừng. Thôi Sá sế 侘傺: Dáng bơ phờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sế Chửu", "definition": "掣肘. Nắm khuỷu tay người khác kéo lại mà gây sự.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sếu", "definition": "Baka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sếu Nâu", "definition": "Balākā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sỉ", "definition": "佁. Ngu dốt. Đần độn Một âm là Tỉ. Xem Tỉ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Chức", "definition": "裭職. Lột bỏ công việc và địa vị. Cũng như Cách chức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Cách", "definition": "恥革. Xấu hổ mà sửa đổi lỗi lầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Lí", "definition": "蹝履. Đi kéo lê dép trên đất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Mạ", "definition": "恥駡. Chửi mắng, làm nhục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Nhục", "definition": "恥辱. Xấu hổ, cảm thấy nhuốc nhơ. Đoạn trường tân thanh có câu: “Đã đày vào kiếp phong trần, sao cho sỉ nhục một lần mới thôi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Phách", "definition": "裭魄. Cướp mất hồn vía.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Sỉ", "definition": "𣺺𣺺. Ướt nhẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Tiếu", "definition": "恥笑. Chê cười, làm cho xấu hổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Tiểu Mộ Đại", "definition": "Hổ thẹn nhỏ, mến chuộng lớn. Nghĩa là khởi tâm hổ thẹn đối với sự nông cạn, yếu kém của Tiểu Thừa Giáo mà hâm mộ sự cao siêu, tôn quí của Đại Thừa Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sỉ Tâm", "definition": "恥心. Lòng xấu hổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sỉ Đoạt", "definition": "裭奪. Lột bỏ. Tước bỏ. Td: Sỉ đoạt công quyền (lột bỏ quyền công dân, một hình phạt trong chế độ dân chủ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sịu Mặt", "definition": "Scowl with knitted brows", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sọ", "definition": "Sīsakapāla (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sỏi", "definition": "Marumbā (nữ), silā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sỏi Nhỏ", "definition": "Sakkharā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Số", "definition": "數. Chữ dùng để đếm, tức con số Cuộc đời được trời sắp đặt trước. Ca dao có câu: “Số giàu lấy khó cũng giàu, số nghèo chín đụn mười trâu cũng nghèo” Một âm là Sổ. Xem Sổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số 1.", "definition": "II.Nhất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Số Hiệu", "definition": "數號. Dấu ghi ra dùng để đếm, tức con số.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Hệ", "definition": "數係. Điều dính dấp tới cuộc đời mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Học", "definition": "數學. Một ngành Toán học, nghiên cứu về các con số “Arithmélique”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Kiếp", "definition": "數刼. Như Số phận 數分.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Luận", "definition": "Cũng gọi Số Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Số Luận Học Phái", "definition": "Số Luận, Phạm: Saôkhya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Số Luận Kinh", "definition": "Saṃkhyā Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Số Luận Phái", "definition": "Sankha (P), Sāmkhyā (S), Sankha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Số Luận Sư", "definition": "S. Samkhya. Một giáo phái tồn tại ở Ấn Độ, trước công nguyên, trước khi Phật Thích Ca ra đời. Sách chữ Hán thường dịch âm là Tăng Khứ sư. Theo truyền thuyết, người sáng lập ra giáo phái này là Kapila, sống vào khoảng thế kỷ VI Tcn tại Ấn Độ. Cũng theo truyền thuyết, khi mới xuất gia cầu đạo, Phật Thích Ca đã từng theo học một luận sư thuộc giáo phái này, tên là Alara Kalama, nguyên là một đệ tử của Kapila. Alara cũng như Kapila chủ trương trong mỗi người đều có linh hồn tồn tại, gọi là atman. Nếu cởi bỏ được ràng buộc của thể xác thì (atman), linh hồn sẽ được tự do và giải thoát. Lập luận của giáo phái Samkhya không làm Phật Thích Ca thỏa mãn, về sau, Phật Thích Ca rời bỏ Alara đi tìm một luận sư khác.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Số Luận Tụng", "definition": "Xem Tăng Khư Tụng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Số Mã", "definition": "數碼. Như Số hiệu 數號.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Mạng", "definition": "Niyati (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Số Mệnh", "definition": "Niyati (S), Fate.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Số Mục", "definition": "數目. Con số Con số chỉ về sự nhiều ít của từng thứ, từng loại. Td: Số mục nhân đinh trong làng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Phận", "definition": "數分. Cuộc đời của mình được trời sắp đặt từ trước, coi như cái phần trời dành cho mình rồi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Thuật", "definition": "數術. Cái tài đoán biết được cuộc đời của người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Số Tức", "definition": "Phép đếm hơi hô hấp đặng làm cho dứt lòng tán loạn. Nhơn đó, nhà tu hành mới vào các phép Định cao. Cũng viết: Số tức quán. Ấy là phép thứ năm trong Ngũ đình tâm quán. Lại cũng viết: Số tức môn hay Số môn. Ấy là một trong Lục diệu môn. Số tức là một phép thuộc về Chánh niệm trong Bát chánh đạo. Cách tu như vầy: Ngồi kiết già xong, người tu hành chăm chú mà hít hơi vô, kế chăm chú mà thở hơi ra. Khi người hít vô dài hơi, người biết rằng mình hít vô dài hơi. Khi người chậm chậm mà thở hơi ra, người biết rằng mình chậm chậm mà thở hơi ra. Khi người hít vô vắn hơi, người biết rằng mình hít vô vắn hơi. Khi người thở hơi ra mau, người biết rằng mình thở hơi ra mau. Người vừa hít vô vừa niệm tưởng rằng: \"Trong khi tôi hít hơi vô, tôi lóng nghe tỏ rõ trong thân tôi\". Người vừa thở ra vừa niệm tưởng rằng: \"Trong khi tôi thở hơi ra, tôi lóng nghe tỏ rõ trong thân tôi\". Người vừa hít vô, vừa niệm tưởng rằng: \"Trong khi tôi hít vô, tôi làm cho hơi thở tôi trở nên yên tĩnh\". Người vừa thở ra, vừa niệm tưởng và luyện tập như vầy: \"Trong khi tôi thở hơi ra, tôi làm cho hơi thở tôi trở nên yên tĩnh\". Như vậy, người niệm tưởng về thân mình và thân người. Người nhận thấy cái thân hiệp lại cách nào và tan rã cách nào, thân mình cũng thế và thân người cũng thế. Người hiểu ra như vầy: ấy chỉ là những cái thân mà thôi. Nên người tự thối rằng: \"Đây là một cái thân, chớ không phải mạng sống, không phải đàn ông, đàn bà, không phải tôi, không phải ai\". Số tức: Sổ tức cũng viết theo Phạn: A na ba na, A na a ba na. Số tức quán cũng viết: A na ba na Niệm, A na ba na Tam Muội.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Số Tức Quán", "definition": "Samadhi du compter-du-souffle breath counting meditation 數息觀 ānāpāna-smṛti", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Sống", "definition": "Jīvati (jib + a), jīva (nam), jīvana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sống Chung", "definition": "Sannivasati (saṃ + ni + vas + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sống Do Vật Thực", "definition": "Āhāraṭṭikita (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sống Không Gia Đình", "definition": "Anagāriya (P), Homelessness.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sống Lại", "definition": "Sañjīvana (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sống Ở Miền Núi", "definition": "Giriśanta (S), Inhabiting in the mountains.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sốt Rét", "definition": "Kāyaḍāha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sốt Sắng", "definition": "Āyūhaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sồ", "definition": "雛. Con chim con mới nở Chỉ chung loài thú vật mới sinh Non nớt, bé nhỏ, thơ ấu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sồ Hình", "definition": "雛形. Vật mới được chế tạo sơ sài cho thành hình, mà chưa hoàn tất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sồ Nhi", "definition": "雛兒. Ấu thơ non nớt, chưa biết gì Đứa trẻ thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sồ Oanh", "definition": "雛鶯. Con chim oanh non, đang học hót. Chỉ đứa trẻ đang tập nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sồ Phượng", "definition": "雛鳳. Con chim phượng non, chỉ con cái nhà quyền quý, thơ ấu đã tỏ ra tài giỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sồ Ưng", "definition": "雛鷹. Con chim ưng non. Chỉ con nhà võ tướng, mới ra trận lần đầu mà tỏ ra tài giỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sổ", "definition": "數. Đếm. Đếm số Tính toán Vài ba. Mấy Một âm là Số. Xem Số.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sổ Châu", "definition": "數珠. Tràng hạt của tăng ni, dùng để lần đếm mà niệm phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sổ Tức", "definition": "Paranayama (S), Ānāpāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sổ Tức Quán", "definition": "Ānāpāna (S), Ānāpāna-smṛti (S), Breathing.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sớ", "definition": "Chữ “sớ” ở đây tức là “nghĩa sớ”, là tên gọi chung cho các công trình và sách vở liên quan đến việc chú giải Kinh Luật Luận. Bởi vì Ba Tạng thánh điển nghĩa lí sâu xa, nếu không giải thích thì người học rất khó hiểu rõ, cho nên cần phải chú thích, giải nghĩa để giúp cho người học dễ dàng thông suốt; như các tác phẩm Pháp Hoa Nghĩa Sớ, Tứ Phần Luật Sớ, A Tì Đạt Ma Câu Xá Luận Sớ v.v... Đôi khi lời “sớ” của người trước chưa được rõ ràng lắm, người sau lại giải thích thêm cho tinh tường hơn, thì sự chú giải cho những lời sớ như vậy, được gọi là “sao”; như các tác phẩm Hoa Nghiêm Kinh Sớ Sao, Tứ Phần Tì Kheo Ni Sao, Câu Xá Luận Tụng Sớ Sao, v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sớ Sao", "definition": "疏 抄; C: shūchāo; J: shoshō. Luận giải và chú thích của bản kinh văn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sớ Trần", "definition": "疏陳. Viết lời dâng vua để bày tỏ việc vì. Truyện Hoa Tiên có câu: “Diêu đường Dương nhạc hai thân, Viện lề thân cũng sớ trần minh nông”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sớ Từ", "definition": "疏詞. Lời tâu chép ra để dâng vua. Truyện Hoa Tiên có câu: “Gió thu gợi dạ tử phần, sớ từ lại lấy tỉnh thân làm lề”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sớ Tử", "definition": "Bài văn biểu bạch ca tụng Phật Tổ hoặc các bậc cao tăng Đại Đức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sớ Văn", "definition": "疏文. Lối viết lời tâu vua, có cách thức riêng, tức lối văn viết sớ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sớ nói: Đối với lãnh vực vật là tịch tĩnh, đối với trung tâm của nhất hư là động dụng.", "definition": "一如 (Thủ Lăng Nghiêm Tam Muội Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sớm Hơn Hết", "definition": "Puretaraṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sớm Nhất", "definition": "Pure (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sớm Quá", "definition": "Khippataraṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sờ Mó", "definition": "Āmasati (ā + mas + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sờ Tác Nhân", "definition": "Xem Năng Tác Nhân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở", "definition": "𠩄. Như chữ Sở 所.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Biêt Bất Cực Thành Quá", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Biến", "definition": "Là thuật ngữ Duy Thức Học, chỉ cho vạn pháp. Theo tông Duy Thức, vạn pháp là do thức biến hiện, cho nên vạn pháp được gọi là “sở biến”. Vạn pháp là do thức biến hiện, nhưng đồng thời chúng cũng là đối tượng nhận thức của thức (tức tâm và tâm sở), cho nên cũng được gọi là “sở duyên”. Vậy, “sở duyên” và “sở biến” đều là thuật ngữ Duy Thức Học dùng chỉ cho VẠN PHÁP, nhưng tùy trường hợp thích hợp mà gọi tên này hay tên kia.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sở Biệt", "definition": "Cũng gọi: Hữu Pháp (Phạm: Dharmin), Tiền Trần, Thể, Tự Tính.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Bị", "definition": "Cũng gọi Sở Bị Chi Duyên, Sở Bị Chi Cơ, Sở Vi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Chí", "definition": "所至. Nơi đã đi tới Mức học vấn đã đạt tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Cảm", "definition": "所感. Điều thấy trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Cầu", "definition": "所求. Cái mà mình tìm kiếm, mong mỏi. Đoạn trường tân thanh có câu: “Dù ai có lòng có sở cầu, tâm minh xin quyết nhau một lời”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Duyên", "definition": "Ārammaṇa (P), Preoccupation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Duyên - Sở Thủ", "definition": "Đây là chỉ cho cảnh. Khi thức duyên cảnh, thì cảnh được gọi là đối tượng “sở duyên” của thức. Thức duyên cảnh tức là thức nhận biết và bám lấy, nắm lấy, hay giữ lấy đối tượng, gọi là “thủ”; và trong trường hợp này, cảnh được gọi là đối tượng “sở thủ” của thức.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sở Duyên Duyên", "definition": "Ālambana pratyaya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Duyên Hữu Đối", "definition": "Đối nghĩa là ngăn chặn, chướng ngại.Sở Duyên Hữu Đối chỉ cho 6 thức và các tâm sở tương ứng bị cảnh Sở Duyên làm chướng ngại, không sinh khởi được ở những cảnh khác, là 1 trong 3 hữu đối.Sáu thức và các tâm sở chỉ có thể chuyển biến được đối với cảnh Sở Duyên của chính chúng, như nhãn thức chỉ có thể chuyển biến được đối với sắc cảnh, nhĩ thức chỉ có thể chuyển biến được đối với thanh cảnh, như thể thì tất nhiên chúng bị pháp Sở Duyên câu thúc, ngăn ngại, khiến không thể nào sinh khởi tác dụng đối với các trần cảnh khác được, như nhãn thức không thể sinh khởi tác dụng với các trần cảnh thanh, hương, vị... [X.Luận Đại Tì Bà Sa Q.76, 128; Luận Câu Xá Q.2; Câu Xá Luận Quang Kí Q.2; Câu Xá Luận Bảo Sớ Q.2]. (xt. Hữu Đối).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Duyên Phược", "definition": "I.Sở Duyên Phược.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Duyên Thọ", "definition": "Alamana-vedaniyata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Dĩ", "definition": "所以. Cái lẽ khiến cho Trong Bạch thoại có nghĩa là cho nên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Dục Trí Hoạn Kinh", "definition": "Kinh, 1 quyển, do ngài Trúc Pháp Hộ dịch vào đời Tây Tấn, được thu vào Đại Chính Tạng tập 17.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Dụng", "definition": "所用. Cái đem ra dùng. Hát nói của Nguyễn Công Trứ có câu: “Rồng mây khi gặp hội ưa duyên, đem quách cả sở tồn làm sở dụng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Hoài", "definition": "所懷. Điều mình tưởng nhớ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Huân", "definition": "楚 勛. Thiền tăng đời Tống. Sư đến Đại Long sơn thuộc Đảnh Châu (nay thuộc huyện Thường Đức, tỉnh Hồ Nam) thờ Thiền Sư Trí Hồng làm thầy và nối pháp ngài, kế tiếp trụ trì làm hưng thịnh tông phong.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sở Huân Tứ Nghĩa", "definition": "Bốn nghĩa sở huân, tức là 4 điều kiện sở huân do Tông Pháp Tướng lập ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Hành", "definition": "所行. Điều đem ra làm. Điều mình làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Hành Tạng", "definition": "Cariyataka (S), Cariya Pitaka (S), The Basket of Conduct.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Hóa", "definition": "Phạm: Vinìta.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Hướng", "definition": "所向. Cái phía mà mình đi tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Học", "definition": "所學. Điều đã học được. Sức học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Hữu", "definition": "所有. Cái mà mình có Thuộc về mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Hữu Chủ", "definition": "所有主. Người làm chủ cải của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Hữu Quyền", "definition": "所有權. Cái quyền được làm chủ tài sản của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Khanh", "definition": "楚卿. Tên một nhân vật đàn ông trong Đoạn trường tân thanh của Nguyễn Du, chuyên lừa gạt đàn bà con gái. Đoạn trường tân thanh có câu: “Nghĩ rằng cũng mạch thư hương, hỏi ra mới biết rằng Sở khanh” Về sau ta dùng để chỉ hạng đàn ông bạc tình, chuyên lừa gạt đàn bà con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Kiến", "definition": "所見. Cái mình thấy Cũng có nghĩa như Sở học 所學.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Kì", "definition": "所祈. Điều mình mong mỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Lưu Phật", "definition": "Niśyandabuddha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Lưu Sở Mục Nhiếp Phương Tiện", "definition": "Chỉ cho Sở Lưu Nghĩa, Sở Mục Nghĩa và Nhiếp Phương Tiện Nghĩa nói trong giáo học Đồng Giáo Nhất Thừa của Tông Hoa Nghiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Lượng", "definition": "Prameya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Lập", "definition": "Xem Thành Tựu Giả.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Lập Bất Khiển Quá", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Lập Pháp Bất Thành Quá", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Minh", "definition": "楚 明 (1085-1145). Thiền tăng đời Tống, họ Trương, người Quảng Châu, Quảng Đông, Trung Quốc. Sư nối pháp thiền sư Thiện Bổn, thuộc tông Vân Môn đời thứ 8, trụ trì chùa Tịnh Từ ở Lâm An (tại Hàng Châu, Chiết Giang).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sở Nam", "definition": "Sở Nam (813-888). Thiền Sư Trung Quốc sống vào đời Đường, người tỉnh Phúc Kiến, họ Trương. Thủa nhỏ, sư theo ngài Đàm Ái ở chùa Khai Nguyên. Sau khi cạo tóc, sư đến núi Ngũ Đài thụ giới Cụ Túc, học luật. Theo lời chỉ dạy của ngài Phù Dung Linh huấn, sư đến tham yết ngài Hoàng Bá Hi Vận, sau được nối pháp của ngài.Gặp pháp nạn Hội Xương, sư ở ẩn trong rừng. Về sau, nhận lời thỉnh của Tướng quốc Bùi Hưu, sư trụ ở chùa Báo Ân hơn 20 năm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Nguyện", "definition": "所願. Như Sở kì 所祈.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Nhân", "definition": "楚人. Người nước Sở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Qui", "definition": "Nơi quay về. Tịnh Độ Giáo lấy Đức Phật A Di Đà làm thể sở qui.Thuyết này có xuất xứ từ các mục Thượng Phẩm Thượng Sinh, Thượng Phẩm Trung Sinh... trong Quán Kinh Tán Thiện Nghĩa của ngài Thiện Đạo đời Đường. Trong Tịnh Độ Tông Yếu tập quyển 4, ngài Lương Trung, vị tăng người Nhật Bản, lấy Đức Di Đà làm sở qui, lấy cõi Cực Lạc làm sở cầu và lấy niệm Phật làm sở hành, 3 “sở” này có đủ trong nhất tâm. Còn trong Quán Kinh Tán Thiện Yếu Nghĩa Thích Quán Môn Nghĩa Sao quyển 4 thì ngài Chứng Không vị tăng người Nhật lấy Cực Lạc Tịnh Độ làm sở qui.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Quốc", "definition": "楚國. Nước Sở thời Chiến quốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Sở", "definition": "楚楚. Nói về cây cối mọc thành bụi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Thanh", "definition": "楚聲. Âm nhạc của người nước Sở, vừa bi ai lại vừa hùng tráng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Thuyên", "definition": "I.Sở Thuyên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Thân", "definition": "所親. Cái mà mình gần gụi Người gần gụi với mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Thích", "definition": "所適. Cái hợp của mình, mà mình yêu mến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Thạch", "definition": "(1296-1370): tức thiền sư Phạm Kì, họ Châu, tự Sở Thạch, quê huyện Ninh-ba, tỉnh Triết-giang, Trung-quốc. Tương truyền, thân mẫu của ngài, họ Trương, nằm mộng thấy mặt trời rớt xuống bụng mình, liền thụ thai và sinh ra ngài. Lại tương truyền, một hôm nọ lúc còn bé, thân mẫu mang ngài trong cái địu, có vị thần tăng đi ngang, rờ đầu ngài nói rằng: Đứa bé này sẽ là mặt trời của Phật pháp đây. Nhân đó mà còn có tiểu tự là Đàm Diệu. Từ tuổi ấu thơ, ngài đã biết danh hiệu đức Phật A Di Đà, mỗi buổi sáng sớm đều niệm mười biến, không bao giờ xao lãng. Lên 9 tuổi, ngài xuất gia; 16 tuổi thọ đại giới và tu học ở chùa Chiêu-khánh, Hàng-châu. Một hôm, nhân đọc kinh Thủ Lăng Nghiêm mà có chút ít tỉnh ngộ. Sau đó, ngài đến Kính-sơn tham yết thiền sư Nguyên Tẩu Hạnh Đoan (1254-1341), nhưng nhân duyên chưa hợp. Gặp lúc vua Nguyên Anh-tông (1321-1323) xuống chiếu tuyển người vào kinh chép Đại Tạng Kinh, ngài ứng tuyển. Một buổi chiều nọ, nhân nghe tiếng trống nổi lên ở tháp canh trên thành phía Tây, ngài bỗng nhiên đạt ngộ; liền trở về Kính-sơn, trình bài kệ kiến giải lên thiền sư Nguyên Tẩu, được ấn chứng, và trở thành đệ tử kế thừa của thiền sư – lúc đó ngài được 29 tuổi (1325). Sau đó, ngài lần lượt trú trì tại các chùa Phúc-trăn (Hải-diêm), Vĩnh-tộ (Thiên-ninh), Báo-quốc (Hàng-châu), Bản-giác (Gia-hưng). Năm 1347, vua Nguyên Thuận đế ban hiệu cho ngài là Phật Nhật Phổ Chiếu Tuệ Biện thiền sư. Năm 1357 ngài đổi về trú trì chùa Báo-ân. Hai năm sau, ngài về lại chùa Vĩnh-tộ, cất một ngôi nhà nhỏ ở mé Tây chùa, ẩn cư chuyên tu Tịnh Độ; tự hiệu là Tây Trai lão nhân. Năm đầu niên hiệu Hồng-võ (1368) đời vua Minh Thái-tổ (1368-1398), ngài vâng chiếu, ba lần thuyết pháp cho vua nghe. Năm 1370, nhân vua hỏi về việc quỉ thần, ngài đến chùa Thiên-giới, tham khảo kinh luận, viết thành sách, dự tính vào triều trình lên vua, thình lình cảm bịnh nhẹ, rồi viên tịch, thế thọ 75 tuổi. Trước tác của ngài có: Sở Thạch Phạm Kì Ngữ Lục, Tây Trai Tịnh Độ Thi, Thượng Sinh Kệ, Bắc Du Phụng Sơn Tây Trai, Thiên Thai Tam Thánh, v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sở Thạch Phạm Kì Thiền Sư Ngữ Lục", "definition": "Gọi đủ: Phật Nhật Phổ Chiếu Tuệ Biện", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Thạch Phạm Kỳ", "definition": "(楚 石 梵 琦, Soseki Bonki, 1296-1370): vị tăng của Phái Đại Huệ thuộc Lâm Tế Tông Trung Quốc, tự là Đàm Diệu (曇曜), Sở Thạch (楚石), hiệu Tây Trai Lão Nhân (西齋老人), sinh tháng 6 năm thứ 2 niên hiệu Nguyên Trinh (元貞), xuất thân Tượng Sơn (象 山), Minh Châu (明 州, Tỉnh Triết Giang), họ Chu (朱). Năm 9 tuổi, ông đến tham yết và xuất gia với Nột Ông Mô (訥翁模) ở Thiên Ninh Tự (天寧寺), Hải Diêm (海塩, Tỉnh Triết Giang). Hơn nữa, ông còn tham vấn Tấn Ông Tuân (晉翁洵) ở Sùng Ân Tự (崇恩寺) vùng Hồ Châu (湖州, Tỉnh Triết Giang). Năm 16 tuổi, ông thọ cụ túc giới ở Chiêu Khánh Tự (昭慶寺) vùng Hàng Châu (杭州, Tỉnh Triết Giang). Từ đó, ông lại đến tham yết một số danh tăng khác như Hư Cốc Hy Lăng (虛谷希陵) ở Kính Sơn (徑山), Vân Ngoại Vân Tụ (雲外雲岫) ở Thiên Đồng Sơn (天童山), Hối Cơ Nguyên Hy (晦機元熙) ở Tịnh Từ Tự (淨慈寺), v.v. Cuối cùng ông đến tham vấn Nguyên Tẩu Hành Đoan (元叟行端) ở Kính Sơn và kế thừa dòng pháp của vị nầy. Vào mùa đông năm đầu (1324) niên hiệu Thái Định (泰 定), thể theo lời thỉnh cầu ông đến trú trì Phước Trăn Tự (福臻) ở Hải Diêm, rồi đến ngày mồng 3 tháng 2 năm đầu (1328) niên hiệu Thiên Lịch (天曆) đến Thiên Ninh Vĩnh Tộ Tự (天寧永祚寺), ngày 25 tháng 7 năm đầu niên hiệu Chí Nguyên (至元) đến Đại Báo Quốc Tự (大報國寺) ở Lộ Phụng Sơn (路鳳山), Hàng Châu (杭州), và ngày mồng 8 tháng 8 năm thứ 4 (1344) niên hiệu Chí Chánh (至正) đến Bổn Giác Tự (本覺寺) ở Gia Hưng (嘉興, Tỉnh Triết Giang). Sau đó, ông nhận sắc chỉ được ban tặng hiệu Phật Nhật Phổ Chiếu Huệ Biện Thiền Sư (佛日普照慧辯禪師). Ngoài ra, vào ngày mồng 1 tháng 8 năm thứ 17 cùng niên hiệu trên, ông đến sống ở Báo Ân Quang Hiếu Tự (報恩光孝寺), rồi trở về lại Thiên Ninh Vĩnh Tộ Tự. Đến năm thứ 19 (1359) niên hiệu Chí Chánh, ông xây dựng một ngôi chùa ở phía tây Thiên Ninh Tự, đặt tên là Tây Trai Tự (西齋寺) và lui về ẩn cư. Sau đó, ông phụng chiếu khai đường thuyết pháp ở Tương Sơn Tự (蔣山寺), Kim Lăng (金陵). Ông có mối thâm giao với Tống Cảnh Liêm (宋景濂). Vào ngày 26 tháng 7 năm thứ 3 niên hiệu Hồng Võ (洪 武), ông thị tịch, hưởng thọ 75 tuổi đời và 63 hạ lạp. Ông có để lại một số trước tác như Tịnh Độ Thi (淨土詩), Từ Thị Thượng Sanh Kệ (慈氏上生偈), Bắc Du Tập (北 遊集), Phụng Sơn Tập (鳳 山集), Tây Trai Tập (西齋 集), Hòa Thiên Thai Tam Thánh Thi (和天台三聖詩), Vĩnh Minh Thọ Thiền Sư Sơn Cư Thi (永明壽禪 師山居詩), Đào Tiềm Thi (陶潛詩), Lâm Thông Thi (林通詩), v.v. Nhóm môn nhân Tổ Quang (祖光) của ông biên tập bộ Sở Thạch Phạm Kỳ Thiền Sư Ngữ Lục (楚石 梵 琦 禪 師 語 錄) 20 quyển, bên cạnh đó Chí Nhân (至 仁) soạn bản Sở Thạch Hòa Thượng Hành Trạng (楚 石 和 尚 行 狀). Tống Cảnh Liêm soạn văn Phật Nhật Phổ Chiếu Huệ Biện Thiền Sư Tháp Minh (佛日普照慧辯禪師塔銘).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Sở Thạch Phạm Kỳ Thiền Sư Ngữ Lục", "definition": "楚 石 梵 琦 禪 師 語 錄. Gọi đủ: Phật Nhật Phổ Chiếu Huệ Biện Sở Thạch Thiền Sư Ngữ Lục. Còn gọi: Sở Thạch Thiền Sư Ngữ Lục, Sở Thạch Lục. Ngữ Lục, 20 quyển, do Phạm Kỳ soạn vào đời Nguyên, các vị Tổ Quang, Đàm Thiệu, Lương Ngạn biên tập, được xếp vào Tục Tạng Kinh tập 124, trang 71. Nội dung bao gồm Ngữ Lục của sư Phạm Kỳ ở các chùa: Phúc Trăn, Thiên Ninh Vĩnh Tộ, Đại Báo Quốc, Bản Giác và các phần Bỉnh phất tiểu tham, Tụng cổ, Pháp ngữ, Tạp trước và phụ Hành trạng cùng với lời tựa, tháp minh do Tống Liêm soạn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sở Thị", "definition": "所恃. Điều cậy vào, cái để nương tựa vào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Tri Chướng", "definition": "Jñeyāvaraṇa (S), shes sgrib (T), Cognitive obscurations, Knowledge hindrance.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Tri Y", "definition": "Xem A Lại Da Thức.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Trường", "definition": "所長. Điều mà mình giỏi. Cái hay, cái giỏi của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Tuấn", "definition": "楚 俊 (1262-1336). Thiền tăng đời Nguyên, họ Hoàng, tự Minh Cực, người huyện Ngân (Chiết Giang), Trung Quốc. Tính nhàn nhã, không thích đùa giỡn. Năm 12 tuổi sư xuất gia với Trúc Song Hỉ chùa Linh Nghiêm; sau đó tham kiến Hoành Xuyên Như Hồng, sư siêng năng tham cứu ngày đêm không rảnh ăn ngủ. Sau nghe Hổ Nham Tịnh Phục giáo hóa hưng thạnh, sư bèn đến Lãnh Tuyền hầu hạ, có chỗ tỉnh ngộ. Sau đó ở pháp hội của Chỉ Hoằng Giám chùa Thiên Đồng, sư giữ chức Tạng chủ. Khi ra hoằng pháp, sư trụ trì chùa Phụng Thánh ở Kim Lăng (Nam Kinh), sau đó dời sang trụ chùa Thụy Nham, Phổ Từ, lại sang chùa Song Lâm. Chẳng bao lâu lần lượt đi du phương các chùa Kính Sơn, Linh ẩn, Thiên Đồng, Tịnh Từ, đều giữ chức Đệ nhất tòa. Niên hiệu Chí Thuận thứ 1 (1330) qua Nhật Bản, Đề Hồ Thiên Hoàng cho mời vào cung. Tấu đối đẹp lòng vua nên được ban hiệu “Phật Nhật Diễm Huệ Thiền Sư”. Xây dựng chùa Quảng Nghiêm để sư làm Tổ khai sơn. Sau đó phụng chiếu lần lượt trụ trì chùa Nam Thiền, Kiến Nhân, các nhân sĩ Nho học lẫn Phật học nghe danh tìm đến. Sau khi sư tịch, hài cốt được chia ra thờ phụng tại hai tháp Vân Trạch và Thiếu Lâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sở Tác", "definition": "I.Sở Tác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Tác Biện Địa", "definition": "Xem Dĩ Tác Địa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Tác Dĩ Biện - Sở Sự Dĩ Biện", "definition": "Việc cần làm đã làm xong : là một thuật ngữ Phật học dùng để chỉ cho các hành giả Thanh-văn thừa, khi đã hoàn toàn đoạn trừ mọi kiến tư hoặc của ba cõi, đắc quả A-la-hán, thoát li ba cõi và chứng nhập niết bàn, vĩnh viễn không còn trở lại trong ba cõi nữa. Đó là chỗ Thanh-văn thừa khác với Bồ-tát thừa. Các hành giả tu tập hạnh Bồ-tát đều phát nguyện đời đời cứu độ chúng sinh, nơi nào có chúng sinh là nơi đó có Bồ-tát, chừng nào còn chúng sinh thì chừng đó còn có Bồ-tát. Vì vậy mà công việc của Bồ-tát không bao giờ “làm xong”. Do đó, thuật ngữ trên không dùng để chỉ cho Bồ-tát.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sở Tác Tương Tự Quá Loại", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Tù", "definition": "楚囚. Người tù nước Sở, chỉ người tù có tiếng tăm, được kính trọng (do điển Chung Nghi người nước Sở, bị tù tại nước Tấn, nhưng vua Tấn kính trọng tài đức mà tha về).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Tước", "definition": "楚雀. Một tên gọi con chim Hoàng oanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Tại", "definition": "所在. Nơi hiện đang ở. Chỗ mình cư ngụ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Tạo Sắc", "definition": "Gọi tắt: Sở tạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Tồn", "definition": "所存. Cái còn lại. Cái mình hiện có. Chỉ tài năng của mình. Hát nói của Nguyễn Công Trứ có câu: “Rồng mây khi gặp hội ưu duyên, đem quách cả sở tồn làm sở dụng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Vi Lượng", "definition": "Cũng gọi Tiền Lượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Viên", "definition": "Sở Viên (986-1039). Thiền Sư Trung Quốc sống vào đời Tống, người ở Thanh Tương, Toàn Châu (huyện Quế Lâm, tỉnh Quảng Tây), họ Lí. Thủa nhỏ sư là 1 Nho Sinh, rắp tâm theo đuổi sự nghiệp Khoa Cử. Năm 22 tuổi, sư hồi tâm theo đạo Phật, xuất gia ở chùa Ẩn Tĩnh tại Tương Sơn. Không bao lâu, sư đến cửa Tương Miễn, kết bạn với ngài Thủ Chi Cốc Tuyền cùng vào Lạc Dương. Nghe tiếng tăm ngài Thiện Chiêu là bậc nhất trong thiên hạ, sư bèn đến Phần Châu, nương tựa ngài được 2 năm nhưng vẫn chưa được nghe pháp yếu. Mỗi lần thấy sư thì ngài Thiện Chiêu lại chửi mắng, hoặc chê bai các nơi, có dạy bảo điều gì cũng chỉ là việc tầm thường của thế tục. Một hôm, sư đến trách ngài, chưa dứt lời thì ngài nhìn chằm chằm vào sư mà mắng rằng (Đại 51, 482 thượng): “Ác tri thức này dám chê bai ta!” rồi giơ gậy lên đuổi.Sư định giải thích, ngài liền bụm miệng. Sư chợt Đại Ngộ, thưa rằng: “Thế mới biết đạo của Lâm Tế vượt ngoài thường tình”. Sư hầu hạ ngài Thiện Chiêu khoảng 12 năm (có thuyết nói 7 năm), lãnh hội hết yếu chỉ của ngài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Vương Anh", "definition": "Con của vua Quang Vũ Đế đời Đông Hán, Trung Quốc, là em của vua Hiếu Minh Đế. Theo chính sử của Trung Quốc thì ông là người đầu tiên tin theo Phật Giáo. Cứ theo Liệt Truyện thứ 32 trong Hậu Hán Thư thì lúc còn trẻ, Vương anh thích làm hiệp sĩ, giao du với các tôn khách, về già, ông lại thích học thuyết của Hoàng lão, thực hành trai giới cúng lễ theo Phật Giáo. Điều Thiên Trúc Quốc trong Liệt Truyện thứ 78 của Hậu Hán Thư nói: “Sở Vương Anh là người đầu tiên tin đạo thuật ấy (đạo Phật), nhân đó Trung Quốc có rất nhiều người thờ phụng đạo Phật”. Điều này đủ chứng tỏ nền Phật Giáo mà Sở Vương Anh tin thờ cũng chỉ thuộc loại phương thuật cúng tế. [X. Phật Tổ Thống Kỉ Q.35; Phật Tổ Lịch Đại Thông Tải Q.4; Thích Thị Kê Cổ Lược Q.1; Hậu Hán Kỉ Q.10].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Y", "definition": "Aśraya (S), Basis, Asaya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Y Bất Thành Quá", "definition": "Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sở Y Đế", "definition": "Xem Thật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Yêu", "definition": "楚腰. Cái lưng thon nhỏ của con gái nước sở. Sách Hàn Phi Tử chép rằng, Sở Linh Vương chỉ thích người con gái có cái lưng thật thon nhỏ, do đó trong nước, con gái rất nhiều người nhịn ăn để có được cái lưng thật nhỏ. Về sau chỉ cái lưng thon nhỏ của người con gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Đoạn", "definition": "Heya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sở Đoản", "definition": "所短. Điều yếu kém của mình. Chỗ yếu kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Đắc", "definition": "所得. Cái mình thâu được. Lợi lộc có được Điều học hỏi được. Sức học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sở Ước", "definition": "所約. Điều mong mỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sợ", "definition": "Santajjeti (sam + tajj + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợ Chết", "definition": "Maraṇabhaya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợ Hãi", "definition": "Bhaya (S), Fear.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sợ Kinh Khủng", "definition": "Mahabbhaya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợ Nghi", "definition": "Astonishment and doubt", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sợ Sệt", "definition": "Bhaya (trung), bhayaṅkana (tính từ), bhīti (nữ), bhīma (tính từ), bhīsana (tính từ), paṭibhaya (trung), santasati (saṃ + tas + a), satāsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợi Chỉ", "definition": "Tantu (nam), sutta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợi Dây", "definition": "Sutta (trung), tantu (nam), yotta (trung), rasmi (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợi Dây Ràng Buộc", "definition": "Bandha (S), Bondage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sợi Dây To", "definition": "Rajju (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sợi Len", "definition": "Uṇṇa (trung) uṇṇā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sụp Đổ", "definition": "Opāteti (ova + pat + e), vināsa (nam), paridhaṃsaka (tính từ), parihāni (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sủa", "definition": "Bhuṅkaroti (bhuṃ + kar + o), bhukkaraṇa (trung), bhuṅkāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sủi Bọt", "definition": "Pheṇuddehakaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sủng", "definition": "寵. Ở địa vị cao quý trong triều đình Yêu mến Ơn huệ Kiêu căng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Bạt", "definition": "寵拔. Yêu mến mà nâng đỡ cất nhắc công danh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Bộc", "definition": "寵僕. Kể đầy tớ được chủ thương yêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Cơ", "definition": "寵姬. Người hầu thiếp được yêu quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Hạnh", "definition": "寵幸. Được yêu quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Ngộ", "definition": "寵遇. Đối xử vất tất cả lòng yếu quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Nhi", "definition": "寵兒. Đứa con được quý mến, con cưng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Thiếp", "definition": "寵妾. Như Sủng cơ 寵姬.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Thần", "definition": "寵臣. Người bề tôi được vua yêu quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Tứ", "definition": "寵賜. Vua yêu mà ban cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủng Ái", "definition": "寵愛. Yêu quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủy", "definition": "揣. Đo lường Xem xét cân nhắc Các âm khác là Đoàn, Chùy. Xem các âm này.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủy Bản", "definition": "揣本. Xem xét tới tận nguồn gốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sủy Thực", "definition": "Phạm: Kavađiô-kàràhàra hoặc Kavalì-Kàràhàra. Pàli: Kabaliíkàràhàra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sủy Tận Gia Tư", "definition": "揣 盡 家 私. Dốc hết vốn liếng, tỷ dụ có bao nhiêu lời hay đem ra nói hết, rơi vào hình thức. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sứ", "definition": "使. Người do vua sai đi lọc việc ở nơi xa. Bản dịch Chinh phụ ngâm khúc có câu: “Sứ trời sớm giục đường mây, phép công là trọng niềm tay sá nào” Viên chức thay mặt triều đình hoặc chính phủ tới cư ngụ tại nước ngoài để lo việc ngoại giao. Ngày nay gọi là Đại sứ Vị thuốc phụ thuộc trong một đơn thuốc của ngành Đông y. Đông y tùy theo tầm quan trọng chánh phụ của các vị thuốc đối với một bệnh, mà phân các vị thuốc đó làm Quân, Thần, Tá, Sứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Bắc Quốc Ngữ Thi Tập", "definition": "使北國語詩集. Tên một tập thơ bằng chữ Nôm của Hoàng Sĩ Khải làm nhân dịp ông đi sứ Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Bộ", "definition": "使部. Chỉ chung một đoàn viên chức ngoại giao đi lo việc tại nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Giả", "definition": "Ceti (S), Cetaka (S); Duti (S); Duta (S), Dūtī (S), Messenger.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sứ Mệnh", "definition": "使命. Lệnh thiêng liêng sai phái, và phải làm cho tròn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Quán", "definition": "使館. Nơi làm việc của nhân viên ngoại giao tại nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Quân", "definition": "使君. Vị quan to thay mặt vua sang nước ngoài lo việc triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Thần", "definition": "使臣. Người bề tôi được vua sai đi lo việc ở nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Tinh", "definition": "使旌. Cây cờ hiệu của vị đại thần đi sứ nước ngoài Lá cờ của nước mình mà vị sứ thần đem theo khi tới nước ngoài lo việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Tiết", "definition": "使節. Vật tượng trưng cho sự đại diện của triều định quốc gia, mà vị sứ giả đem theo ra nước ngoài để tăng uy tín cho mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Trình", "definition": "使程. Con đường đi sứ nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Trình Khúc", "definition": "使程曲. Tên một tập thơ nôm của Hoàng Sĩ Khải, danh sĩ đời nhà Mạc, làm nhân dịp ông đi sứ Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Trình Tiện Lãm Khúc", "definition": "使程便覽曲. Tên một tập thơ bằng chữ Nôm của Lí Văn Phức, danh sĩ đời Nguyễn, làm nhân dịp ông đi sứ Trung Hoa vào năm 1841.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Tài", "definition": "使才. Sử giỏi giang của người lo việc ngoại giao ở nước ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Điệp", "definition": "使蝶. Con bướm trao tin. Chỉ thư từ tin tức trao đổi trai gái. Thành ngữ có câu: “Tin ong sứ điệp”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Đoàn", "definition": "使團. Chỉ chung các nhân viên ngoại giao các nước ngoài hiện nay đang trú ngụ tại nước mình. Ngày nay là Ngoại giao đoàn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sứ Đồ", "definition": "使徒. Tên những người theo Cơ đốc giáo thời xưa, coi như mỗi người là một sứ giả của chúa, sai đi rao giảng đạo Chúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức", "definition": "恜. Kính trọng. Cũng đọc Thức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Chung", "definition": "Nghĩa là chuẩn bị tốt đẹp cho giờ phút lâm chung, tức là niệm Phật hộ niệm để trợ giúp cho người hấp hối có chánh niệm rõ ràng, chờ Phật tiếp dẫn vãng sinh. Đoàn niệm Phật sức chung ở Đài-loan, ở Việt-nam gọi là ban hộ niệm.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sức Chí Nguyện", "definition": "Power of aspiration", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sức Chỉnh", "definition": "飭整. Sửa sang cho ngay ngắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Cung", "definition": "飭躬. Sửa trị thân mình. Cũng như: Tu thân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Khỏe", "definition": "Ārogya (trung), sokhya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sức Lệ", "definition": "飭厲. Thúc giục, khuyến khích.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Lệnh", "definition": "飭令. Lệnh quan trên sai xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Lực", "definition": "Java (nam), thāma (nam), parisama (nam), bala (trung), vikkama (nam), viriya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sức Mạnh", "definition": "Bala (trung), balī (tính từ), pabhāva (nam), satti (nữ), vega (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sức Mạnh Của Nhẫn Nại", "definition": "Khantibala (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sức Mạo", "definition": "飾貌. Làm vẻ mặt giả dối bề ngòai,.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Ngôn", "definition": "飾言. Lời nói ngoài miệng, không thành thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Ngụy", "definition": "飾偽. Dối trá, chỉ có bề ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Nhượng", "definition": "飾 讓. Cố tình khiêm nhường để tự làm nổi bật. Tiết Thanh Hóa Toàn Phô Thiền Sư trong NĐHN q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sức Nhạo Thuyết Biện", "definition": "Power to preach pleasingly and eloquently", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sức Nặng", "definition": "Bhāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sức Phi", "definition": "飾非. Che đậy bề ngoài để giấu điều xấu xa sai lầm của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Thuyết", "definition": "飾說. Ăn nói môi mép bề ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Từ", "definition": "飾辭. Lời nói để che đậy lỗi lầm của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sức Đại Thiện Tịch", "definition": "Power of great goodness and tranquility", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Sừ", "definition": "耡. Cái bừa Bừa đất Một âm là Trợ. Xem Trợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sừ Dửu", "definition": "鋤莠. Bừa hết cỏ, trừ cỏ. Ý nói trừ bỏ kẻ xấu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sừ Ác", "definition": "鋤惡. Diệt trừ điều xấu, kẻ xấu. Thường nói: Sừ ác vụ tận (trừ kẻ ác thì cần phải trừ cho thật hết).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sừng", "definition": "Visāṇa (trung), siṅga (trung), sūna (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sử", "definition": "Nghĩa là sai khiến, là một tên khác của phiền não. Phiền Não là những động lực thúc đẩy chúng sinh tạo nghiệp bất thiện, phải trôi lăn mãi trong luân hồi sinh tử, cho nên được gọi là “sử”. Phiền Não có rất nhiều thứ, nhưng có mười thứ được coi là gốc rễ, gọi là “mười sử” (thập sử, hay thập căn bản phiền não), gồm có: 1. Tham: thấy gì vừa ý thì ham muốn, cố chiếm đoạt. 2. Sân: gặp điều không vừa ý thì oán giận, căm ghét. 3. Si: lòng dạ tối tăm, không sáng suốt, không nhận chân được sự thật. 4. Mạn: kiêu mạn, tự cao, khinh người. 5. Nghi: nghi ngờ, dụ dự. 6. Thân kiến: cái thấy sai lầm về “ngã”, cho rằng thân này là thật có, thân này là ta, những cái kia thuộc về ta. 7. Biên Kiến: cái thấy cực đoan, hoặc cho rằng con người sau khi chết là mất hẳn, hoặc cho rằng con người sau khi chết sẽ về sống đời đời ở một nơi nào đó, như thiên đường hay hỏa ngục. 8. Tà kiến: cái thấy xuyên tạc, không đúng sự thật, không thấy được lí duyên sinh, luật nhân quả, cùng các tính chất vô thường, vô ngã v.v... của vạn vật, mà cho rằng có một vị thượng đế sáng tạo ra vạn vật, mọi họa phước đều do thượng đế ban phát, mọi sự việc đều do thượng đế an bài, v.v... 9. Kiến thủ kiến: khư khư ôm giữ những kiến thức sai lạc mà cứ cho là đúng, đã không cải thiện mà còn cố rao giảng rộng rãi, đôi khi còn tìm cách dụ hoặc hay ép buộc người khác phải nghe theo mình. 10. Giới cấm thủ kiến: cố chấp vào các giới cấm sai lầm, vô lí, hoặc giữ giới một cách mù quáng, không sáng suốt, không uyển chuyển, gây đau khổ cho mình và cho người. Năm loại phiền não bên trên (từ số 1 đến số 5), vì tính chất của chúng quá nặng nề, tinh vi, chồng chất từ nhiều đời trước, thân mạng vừa hình thành là đã có chúng kèm theo, rất khó đoạn trừ, cho nên thuật ngữ Phật học gọi chúng là “năm độn sử” (ngũ độn sử). Năm loại phiền não bên dưới (từ số 6 đến số 10), vì tính chất của chúng nhẹ nhàng hơn, mới mắc phải trong đời hiện tại do nghe theo tà sư, tà giáo, dễ đoạn trừ hơn, cho nên thuật ngữ Phật học gọi chúng là “năm lợi sử” (ngũ lợi sử).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sử Bút", "definition": "史筆. Cách thức chép sử Lối văn chép sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Bộ", "definition": "史部. Một pho sách chép việc xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Chú Pháp Kinh", "definition": "Kinh, 1 quyển, do ngài Bồ Đề Lưu Chi dịch vào đời Đường, được thu vào Đại Chính Tạng tập 21.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sử Cục", "definition": "史局. Cơ quan triều đình hoặc nhà nước, lo việc soạn chép lịch sử quốc gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Dân", "definition": "使民. Sai khiến người trong nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Dịch", "definition": "使役. Sai khiến vào việc nặng nhọc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Dụng", "definition": "使用. Khiến mà dùng. Đem dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Gia", "definition": "史家. Người biên chép lịch sử quốc gia Người nghiên cứu sâu rộng về lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Học", "definition": "史學. Ngành nghiên cứu về lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Kinh", "definition": "Sử là sách chép những việc đã qua theo các triều đại. Kinh là sách do các học giả hoặc các bậc chân tu biên soạn, làm khuôn phép cho mọi người noi theo. Sử Kinh hiểu theo nghĩa rộng là sách học của mọi người thời xưa. Không nên lầm với Kinh Phật ghi lại những lời Phật dạy. Trong “Hoa Tiên” có câu: “Sử Kinh lại gắng việc thường, Gấm hoa thêm cải, ngọc vàng thêm lau.” Sử Kinh ở đây dùng theo nghĩa rộng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Sử Kí", "definition": "史記. Sách ghi chép sự việc xảy ra trong nước qua các thời đại Việc chép sử Tên bộ sử của Tư Mã Thiên đời Hán, chép sử Trung Hoa từ đời Hoàng Đế tới đời Vũ đế nhà Hán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Kịch", "definition": "史劇. Vở tuồng diễn lại một sự tích lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Liệu", "definition": "史料. Chỉ chung các sách vở, các sự kiện, các bằng cớ, để căn cứ vào đó mà viết hoặc tìm hiểu về lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Luận", "definition": "史論. Lời bàn bạc về những sự kiện việc lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Lược", "definition": "史略. Sách chép qua loa những sự kiện chính của lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Lệnh", "definition": "使令. Sai khiến. Bắt làm theo ý mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Lợi Na Cách Lạp", "definition": "Phạm: Zrìnagara. Pàli: Sirìnagara.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sử Man Nhĩ Tháp Phái", "definition": "Smartha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sử Mục Nhĩ Đê Cập Nhiếp Na Khắc Nhĩ Đê", "definition": "Phạm: Smftijĩànakìrti.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sử Quan", "definition": "史官. Ông quan thời xưa, chuyên lo việc biên soạn lịch sử nước nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Quán", "definition": "史舘. Cơ quan của triều đình, lo việc biên soạn lịch sử. Nguyễn Công Trứ đời Nguyễn từng giữ chức Hành tẩu, và chức Biên tu tại Sử quán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Quân Tử", "definition": "史君子. Tên một vị thuốc bắc, là thứ cây có hoa vàng xanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Thản Nhân", "definition": "Stein, Sir Mark Aurel (1862-1943) Học giả khảo cổ học Đông Phương người Anh, gốc Hungary.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sử Thần", "definition": "史臣. Như Sử quan 史官.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Thặng", "definition": "史乘. Sách chép việc xảy ra trong quốc gia qua các thời đại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Thể", "definition": "史體. Lối chép sử, hình thức chép sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Thực", "definition": "史實. Việc có thật, xảy ra trong lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Tài", "definition": "史才. Sự giỏi giang về ngành sử học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Tích", "definition": "史跡. Việc cũ xảy ra trong lịch sử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sử Tích Xước", "definition": "(1876-1925), Học giả Phật Giáo Trung Quốc, người huyện Vạn, tỉnh Tứ Xuyên, tự Dụ Như, Nhất Như, Tĩnh Như. Ông tốt nghiệp Đại Học Đế Quốc ở Đông Kinh, Nhật Bản, tinh thông tiếng Anh và tiếng Nhật, kiến thức uyên bác, ông từng dạy ở các trường Đại Học tại kinh đô (Kyoto).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sử Văn Phụ Sơn", "definition": "使蚊負山. Sai con muỗi đội trái núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sửa Chữa", "definition": "Saṃvidahati (saṃ + vi + dhā + a), abhisaṅkkharoti (abhi + saṃ + kar + a), abhisaṅkhāra (nam), paṭisankharana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sửa Lại", "definition": "Paṭikara (tính từ), paṭikamma (trung), paṭikaroti (paṭi + kar + o)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sửa Sai", "definition": "Sodheti (sudh + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sửa Sang", "definition": "Paṭijaggati (paṭi + jag + a), paṭidadāti (paṭi + dā + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sửa Soạn", "definition": "Abhisaṅkkharoti (abhi + saṃ + kar + a), abhisaṅkhāra (nam), alaṅkaroti (alaṃ + kar + o), alaṅkaraṇa (trung), alaṅkāra (nam), kappeti (kapp + e), parivaccha (trung), paṭiyādeti (paṭi + yat + e), paṭiyādeti (paṭi + yat + e), paṭisankharoti (paṭi + saṃ + kar + a), payojana (trung), payojeti (pa + yuj + e), racayati (rac + aya), vidahati (vi + dhā + a), saṅkharoti (saṃ + kar + o), saṅkharana (trung), sajjeti (saj + e), sādheti (sadh + e), sampādeti (saṃ + pad + e), saṃvidahati (saṃ + vi + dhā + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sửa Áo Ngay Thẳng", "definition": "Arrange one's robe, to.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sửa Đổi", "definition": "Vikāra (nam), viparināmeti (vi + pari + nam + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sửu", "definition": "丑. Vị thứ nhì trong Thập nhị chi Trong Thập nhị thuộc, thì Sửu chỉ con trâu Tên chỉ giờ. Xem Sửu thời 丑時.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sửu Ky", "definition": "溲箕. Cái rá vo gạo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sửu Thời", "definition": "丑時. Giờ Sửu, tức khoảng từ 1 tới 3 giờ khuya.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sữa", "definition": "(Bò). Duddha (trung) Khīra (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sữa Chua", "definition": "Dadhi (trung), ghata (trung), sappi (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sữa Lỏng", "definition": "Navanīta (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sữa Mẹ", "definition": "Thañña (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sữa Đặc", "definition": "Dadhi (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sữa Đặc Có Kem", "definition": "Kummāsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sự", "definition": "事. Việc làm Nghề nghiệp Làm việc Tôn kính thờ phụng Chỉ chung các việc xảy ra. Cung oán ngâm khúc có câu: “Lò cừ nung nấu sự đời, bức tranh vân cẩu vẽ người tang thương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Biến", "definition": "事變. Việc xảy ra thình lình. Cũng như: Biến cố.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Bất Yếm Tế", "definition": "Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Chướng", "definition": "“Sự Chướng” nghĩa là chướng ngại về mặt “sự”, chỉ cho những thứ chướng ngại làm cho chúng sinh phải lăn lộn mãi trong sinh tử luân hồi. Đó là những phiền não tham, sân, si, v.v... làm cho chúng sinh mải tham đắm, chạy theo mặt hiện tượng của vạn pháp mà gây ra biết bao lỗi lầm, nghiệp báo nối tiếp kiếp này sang kiếp nọ, không thể nào giải thoát để sống an lạc trong cảnh niết bàn tịch tịnh. Sự Chướng tức là “phiền não chướng”, cũng tức là “tư hoặc” (hay tu hoặc), chỉ cho tham, sân, si, và mạn, 4 trong 6 loại phiền não căn bản.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sự Chấm Dứt Sinh Tử", "definition": "Bhavanirodha (S), Extinction of life-death circle.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Chủ", "definition": "事主. Người đứng đầu trong một việc, người có liên hệ tới một việc. Cũng như: Đương sự.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Cúng Dường", "definition": "Cũng gọi Sự cúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Cơ", "definition": "事機. Cái lúc xảy tới của mọi việc Cái dịp để làm một việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Cố", "definition": "事故. Nguyên nhân gây nên việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Do", "definition": "事由. Như Sự cố 事故.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Duyên", "definition": "事緣. Cái nguyên nhân gây nên việc. Truyện Trê Cóc có câu: “Muốn cho các việc được xong, phải tìm cho đến hỏi cùng sự duyên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Dữ Nguyên Vi", "definition": "Sự việc thực tế trái với ý muốn của mình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Giáo", "definition": "Trong 4 giáo Tạng, Thông, Biệt, Viên do Tông Thiên Thai thành lập, để phân biệt giữa “Sự Sai Biệt” và “Lí Chân Đế” nên gọi Tạng Giáo là Sự Giáo của giới nội (trong 3 cõi Dục, Sắc, Vô Sắc), Thông Giáo là Lí Giáo của giới nội; Biệt Giáo là Sự Giáo của giới ngoại (ngoài 3 cõi), Viên Giáo là Lí Giáo của giới ngoại.Trong đó, Sự Giáo của giới nội là phân tích và giải thích rõ sự tướng sai khác của các pháp sắc, tâm trong hiện thực; còn Sự Giáo của giới ngoại thì trước hết từ giới ngoại lại trở về hiện thực; tức đối với các loại sự tướng của hiện thực, đặt chúng vào vị trí chân thực tự tại để giải thích hằng sa vô lượng sự tướng. (xt. Hóa Pháp Tứ Giáo).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Giải Thoát", "definition": "Vimutti-kkhanda (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Hạng", "definition": "事項. Các loại công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Hỏa Bà La Môn", "definition": "Aggikabrahmāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Hỏa Loa Phái", "definition": "Aggikajatita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Hỏa Ngoại Đạo", "definition": "Ngoại đạo thờ lửa, 1 trong các phái ngoại đạo ở Ấn Độ đời xưa. Phái này thờ cúng các vị thần như Hỏa Thiên (Phạm: Agni, Pàli: Aggi)... và chấp lầm rằng cách thờ cúng này là nhân sinh lên cõi trời trong tương lai.Tín đồ của phái này gọi là Sự Hỏa Loa Phát (Pàli: Aggikajaỉila, tóc xoắn thờ lửa), hoặc Sự Hỏa Bà La Môn (Pàli: Aggikabràhmaịa). Bởi Sự Hỏa Ngoại Đạo cho rằng lửa là cái miệng của các trời, vì thế mới bỏ các vật cúng như thóc gạo, dầu bơ vào trong lửa để cúng dường các trời.Các trời được ăn rồi thì sẽ ban phúc cho con người.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Hộ Ma", "definition": "Cũng gọi Ngoại Hộ Ma.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Kiện", "definition": "Vastu (S), Vatthu (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Loại", "definition": "事類. Như Sự hạng 事項.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Luận", "definition": "Đối lại: Lí Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Lí", "definition": "事理. Cái lẽ thật của một việc. Truyện Trê Cóc câu: “Những tuồng loài vật biết gì, cũng còn sự lí tranh thi khéo là”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Lý", "definition": "Cũng gọi Lý Sự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Lý Bất Nhị", "definition": "Pháp Hữu Vi do nhân duyên sinh là Sự, pháp vô vi không sinh không diệt là Lí. Sự tuy theo duyên mà sinh, nhưng lí không sinh không diệt lúc nào cũng ở trong Sự; Lí tuy là chân như lặng lẽ bất động, tịch tĩnh vô vi, nhưng nếu không nhờ có Sự do nhân duyên sinh thì Lí không thể hiển bày được. Do đó, tức sự tức lí, tức lí tức sự, gọi là Sự Lí Bất Nhị. Vì Sự và Lí tuy vốn hoàn toàn khác nhau, vả lại có tính đối đãi, nhưng ngoài Sự ra thì không có Lí và, ngược lại, ngoài Lí, cũng không có Sự, cho nên Sự và Lí tự nhiên không thể tồn tại 1 cách độc lập được. Nếu nói theo tính thực tiễn thì Sự Lí Bất Nhị cũng có thể gọi là Sự Lí Vô Ngại.Các dụng ngữ như “Lí Sự bất nhị”, “Lí Sự mẫn nhiên” là biểu thị lí và sự bình đẳng không sai biệt, đều đồng nghĩa với Sự Lí Bất Nhị. [X. Hoa Nghiêm Pháp Giới Huyền Kính Q.thượng].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Lý Song Tu", "definition": "Cũng gọi Sự Lí Song Hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Lý Tam Thiên", "definition": "Cũng gọi Lưỡng Trùng Tam Thiên,Lưỡng Chủng Tam Thiên, Lý Cụ Tam Thiên Sự Dụng Tam Thiên, Lý Tạo Tam Thiên Biến Tạo Tam Thiên, Lý Tạo Tam Thiên Sự Tạo Tam Thiên, Tính Cụ Tam Thiên Tu Cụ Tam Thiên. Tông Thiên Thai Đem Lí Cụ Tam Thiên và Sự Tạo Tam Thiên hợp chung lại gọi là Sự Lý Tam Thiên.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Lý Vô Ngại Thập Môn", "definition": "事理無礙十門 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Sự Lược", "definition": "事略. Kể lại qua loa về một việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Mật Lý Mật", "definition": "Cũng gọi Sự Lí Câu Mật. Sự và Lý đều kín đáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Nghi", "definition": "事宜. Việc xảy ra. Diễn tiến của sự việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Nghiệp", "definition": "事業. Việc làm lớn lao, có ích cho nhiều người. Thơ Tản Đà có câu: “Sự nghiệp nghìn thu xa vút mắt, tài tình một gánh nặng hai vai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Nghiệp Anh Hùng", "definition": "Xem Thí dụ.Xem Kinh Thí Dụ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Nghiệp Nghiên Cứu", "definition": "Ganthadhura (S), Career of study.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Pháp Giới", "definition": "Đối lại: Lý Pháp Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Phân Biệt Thức", "definition": "Vastuprativikalpa-vijñāṇa (S), Knowledge of discrimination.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Phấn Chấn", "definition": "Ubbilla (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Quyền", "definition": "事權. Điều được phép làm trong công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Quá", "definition": "事過. Việc trôi qua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Quán", "definition": "事觀", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Sự Quán Lý Quán", "definition": "Cũng gọi Sự Lý Nhị Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Quân", "definition": "事君. Bề tôi làm việc cho vua. Thờ vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Ràng Buộc Của Nghiệp", "definition": "Karmic bondage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Sự Sám", "definition": "Cũng gọi Sự Sám Hối, Tùy Sự Phân Biệt Sám Hối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Súc", "definition": "事畜. Phụng dưỡng cha mẹ và nuôi nấng vợ con.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Sư Pháp", "definition": "Phép thờ thầy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Sư Pháp Ngũ Thập Tụng", "definition": "Tác phẩm, 1 quyển, do Bồ Tát Mã Minh biên tập, ngài Nhật Xứng dịch vào đời Tống, được thu vào Đại Chính Tạng tập 32.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Sư Pháp Ngũ Thập Tụng Thích", "definition": "Tác phẩm, do Tổ khai sáng phái Hoàng Giáo thuộc Lạt Ma Giáo Tây Tạng là ngài Tông Khách Ba soạn ở chùa Nhiệt Chấn vào năm Kiến Văn thứ 4 (1402) đời Huệ Đế nhà Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Sự Vô Ngại", "definition": "Hết thảy sự sự vật trong thế giới hiện tượng đều liên quan rất mật thiết và giao thoa dung hợp mà không hề ngăn ngại lẫn nhau. Đây là dụng ngữ của Tông Hoa Nghiêm hiển bày diệu nghĩa Nhất Đa Tương Tức, Đại Tiểu Tương Dung, Hiện Tượng Tức Bản Thể... (xt. Tam Trùng Quán Môn).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Sự Vô Ngại Pháp Giới", "definition": "Pháp Giới thứ 4 trong 4 giới do Tông Hoa Nghiêm thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Sự Vô Ngại Quán", "definition": "Cũng gọi Sự Sự Vô Ngại pháp giới quán. Pháp Giới quán thứ 4 trong 4 pháp giới quán do Tông Hoa Nghiêm thành lập. Nghĩa là quán xét hết thảy sự vật trong thế giới hiện tượng đều giao thoa dung hợp với nhau mà không bị ngăn ngại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Thân", "definition": "事親. Nuôi nấng thờ phượng cha mẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Thần", "definition": "事神. Thờ phượng các vị thần linh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Thật", "definition": "Avisaṃvāda (nam), sacca (trung), yathātathaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Sự Thế", "definition": "事世. Việc đời. Cung oán ngâm khúc có câu: “Khóc vì nỗi thiết tha sự thế, ai bày trò bãi bể nương dâu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Thể", "definition": "事體. Như Sự tình 事情.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Thực", "definition": "事實. Việc có xảy ra thật. Việc có thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Trạng", "definition": "事狀. Như Sự tình 事情.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Tình", "definition": "事情. Diễn biến của một sự việc. Bài Phú Hỏng thi của Trần Tế Xương có câu: “Thi là thế sự tình là thế, hỏi chuyện cùng ai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Tích", "definition": "事迹. Việc đã qua nhưng còn để lại dấu vết trong sách vở hoặc miệng đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Tướng", "definition": "Đối với tác pháp tu hành Tam Mật,", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Tướng Cách Lịch", "definition": "Tất cả sự vật tồn tại trong thế giới hiện tượng đều sai khác nhau, không dung hợp lẫn nhau, gọi là Sự tướng cách lịch. Thế giới hiện tượng là từ trong thế giới bản thể hiển hiện ra, cho nên nếu khi nhiếp thế giới hiện tượng về bản thể thì mỗi mỗi sự tướng không có sai khác. Nhưng nếu chỉ nói riêng về thế giới hiện tượng thì thấy các sự tướng đều sai khác, không dung hợp lẫn nhau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Tạo", "definition": "Đối lại: Lí cụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Tử", "definition": "事死. Thờ chết người. Thường nói: Sử tử như sự sinh (thờ người chết cũng hết lòng như thờ người đó lúc còn sống).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Và Lí", "definition": "“Sự” hay “sự tướng”, là tất cả pháp hữu vi do nhân duyên sinh, tức là mọi hiện tượng muôn vàn sai khác trong khắp vũ trụ. “Lí” hay “lí thể”, “lí tánh”, là bản thể của mọi hiện tượng được gọi là “sự” ở trên. Lí có hai đức tính vô cùng quan trọng: tùy duyên và bất biến; có nghĩa, tùy theo nhân duyên mà biến hóa ra vạn pháp sai khác, nhưng thể tánh thì thường trú bất biến. Lí vượt khỏi cái tri thức tương đối của phàm phu, cho nên không thể dùng ngôn ngữ, văn tự để diễn đạt, không thể nhận biết bằng ý thức phân biệt sai lầm. Người phàm phu chỉ biết mê đắm vào hiện tượng, cho nên chỉ thấy có sự, và vướng mắc vào sự, do đó mà gây tội lỗi; còn bậc thánh có trí tuệ, thấy rõ suốt chân lí của vạn pháp, không mê đắm hiện tượng, không vướng mắc sự tướng, cho nên không gây tội lỗi. Trong Phật giáo, Sự và Lí luôn luôn là hai mặt đối đãi nhau, quan hệ mật thiết với nhau. Hiện tượng (sự) là sự biểu hiện của bản thể (lí). Bản thể (lí) là thường trú bất biến, là tịch tịnh, là như như bất động, nhưng vạn pháp (sự) được phát hiện từ đó; hay nói cách khác, bản thể (lí) chính là căn cứ phát sinh của mọi hiện tượng (sự). Bởi vậy, sự và lí không bao giờ tách rời (bất li) nhau; không có sự thì không có lí, và ngược lại. Cũng có thể nói, như luận Đại Thừa Khởi Tín: sự tức là lí, lí tức là sự (tương tức); hay như tông Hoa Nghiêm: sự và lí hàm chứa nhau một cách không ngăn ngại (tương dung). Từ cái nhìn này, những người mới bắt đầu con đường tu học Phật pháp, thường được các bậc đạo sư hướng dẫn, trước hết là tu tập bằng sự tướng, tức là thực hành các hình thức lễ sám, tụng kinh, niệm Phật, ngồi thiền v.v...; rồi dần dần học tập nghĩa lí các kinh luật, từ dễ đến khó, mở dần trí tuệ, cho đến khi tự mình thấy rõ chân lí. Đó gọi là “mượn cảnh tu tâm”, mà cũng tức là “nhân sự hiển lí”. Đến khi trí tuệ đã sáng tỏ, thì tâm ý không còn vướng mắc vào sự tướng nữa, mà sự tướng trở nên được thể hiện một cách tự nhiên từ lí tánh, tâm phân biệt giữa sự và lí không còn nữa; đó gọi là “phúc tuệ song tu”. Nếu chỉ mê vào sự tụng kinh, niệm Phật mà không chịu học tập kinh luận để mở mang trí tuệ, đó gọi là “ham sự bỏ lí” (tức chỉ ham tu phúc mà không tu tuệ). Nếu chỉ mê học tập nghiên cứu kinh luận mà không chịu lễ sám, tụng kinh, niệm Phật, đó gọi là “ham lí bỏ sự” (tức chỉ ham tu tuệ mà không tu phúc). Cả hai trường hợp này đều làm cho hành giả không đạt được kết quả viên mãn trong sự tu học Phật pháp.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Sự Vô Nhất Hướng", "definition": "事 無 一 向. Không có vật nào giữ mãi trạng thái ban đầu của nó, ý nói phép tắc, sự lý tương đối v. v.. đều có thể biến đổi, nên có thái độ linh hoạt khi vận dụng nó. Đây là tập quán ngữ của thiền sư khi mở pháp môn phương tiện. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Sự Vật", "definition": "事物. Việc xảy ra và cái hiện có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Vụ", "definition": "事務. Công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự Vụ Sở", "definition": "事務所. Nơi làm việc. Cũng như: Công sở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Sự chuyên tâm nhất ý. Tức 1 lòng niệm Phật, tu hành, như Nhất hướng chuyên niệm, Nhất hướng chuyên tu.", "definition": "II.Nhất Hướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự phân biệt Tam địa là chung cho cả Tiểu Thừa lẫn Đại Thừa. Tầm và Tứ là Tâm Sở phân biệt thô và Tâm Sở phân biệt tế do đối cảnh sinh ra. [X. Luận Câu Xá Q.2]. (xt. Tứ, Tầm).", "definition": "II.Tam Địa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự thuyết pháp của Đức Phật có 3 ý nghĩa: Chuyển Pháp Luân, Chiếu Pháp Luân và Trì Pháp Luân, gọi là Tam Pháp Luân. (xt. Tam Pháp Luân).", "definition": "VI.Tam Luân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự vừa lòng đẹp ý.", "definition": "II.Như Ý.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Sự Độ", "definition": "Giữ gìn 5 giới, thực hiện 10 điều thiện để độ thoát các nỗi khổ của ác đạo.Bởi vì 5 giới, 10 điều thiện đều thuộc sự tướng hữu vi, cho nên gọi là Sự; Độ nghĩa là độ thoát các khổ trong 3 ác đạo địa ngục, súc sinh và ngã quỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "TRÍ, HUỆ - Trí là chiếu thấy, Huệ là hiểu rõ. Trí Huệ là sự thông minh, sáng suốt cuả Phật Bồ Tát, chư thánh và các nhà tu hành chơn chánh, trong sạch. (Bát nhã ba-la-mật=trí huệ Ba-la-mật)", "definition": "Vesak (Sanskrit: Vaishakha) = the day of the Buddha’s", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Ta", "definition": "𠂇. Cánh tay trái. Tay trái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Bà", "definition": "Là dịch âm từ chữ Phạn “saha”, dịch ra Hán ngữ là nhẫn, kham nhẫn, hay nhẫn độ; chỉ cho thế giới Ta-bà (Saha-lokadhatu), nơi đức Phật Thích Ca Mâu Ni ra đời hóa độ chúng sinh, mà giáo pháp của Ngài hiện còn đang truyền bá rộng rãi. Chúng Sinh ở thế giới này đa phần làm mười điều ác, cam chịu bao nhiêu đau khổ do vô minh phiền não hành hạ, mà không có ý muốn thoát li; đó là ý nghĩa của chữ “nhẫn”, tức là chịu đựng. Mặt khác, đức Phật và chư vị Bồ-tát ở thế giới này, trong công cuộc hành đạo để cứu độ chúng sinh, cũng phải chịu đựng nhiều khổ não để tỏ rõ đức vô úy và tâm từ bi; có thế mới đem lại lợi lạc cho chúng sinh một cách hữu hiệu; đó cũng là ý nghĩa của từ “kham nhẫn”. Ngoài ra, thế giới Ta-bà cũng được hiểu là nơi có ba đường dữ, có năm loài Trời, Người, Bàng-sinh, Ngạ-quỉ, và Địa-ngục cùng ở chung lộn với nhau. Từ “Ta-bà” nguyên được dùng chỉ cho châu Diêm-phù-đề, nơi cư trú của con người chúng ta, nhưng về sau nó được dùng để chỉ rộng ra cả một “ba ngàn đại thiên thế giới”, tức là toàn thể phạm vi giáo hóa của đức Phật Bổn Sư Thích Ca Mâu Ni.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Ta Bà Ha", "definition": "Svāhā (S, P), Soha (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Bà Thế Giới", "definition": "Mi-jied 'jig-rten-gyi khams (T), Sahalokadhātu (S), Human world.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Bà Thế Giới Chủ", "definition": "Brahma-sanamku (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Già La Long Vương", "definition": "Xem Biển.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Ha Đề Bà", "definition": "Sahadeva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Hồ", "definition": "嗟乎. Than ôi (lời than thở).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Kiệt La", "definition": "Sâgara. Long Vương Vị vua biển. Ta Kiệt La, vua loài rồng. Vì vị Long Vương ấy ở tại biển Ta Kiệt La, nên gọi là Ta Kiệt La Long Vương. Vua ấy có long cung nơi đại hải. Có một lúc, đức Văn thù sư lỵ Bồ Tát xuống đại hải của vua Ta Kiệt La mà thuyết pháp. Ngài diễn Kinh Diệu pháp liên hoa, làm cho vô số người thâm nhập Phật trí, vô số người đắc quả Bồ Tát. Trong số những người đắc đạo, có cô công chúa con vua Ta Kiệt La mới có tám tuổi, cô hiện lại viếng Phật Thích Ca. Và ngay lúc ấy, cô bỏ lốt phụ nữ, hóa thành Đại Bồ Tát mà đi đến Đạo tràng, ngồi nói Bồ đề thọ và thành Phật Như Lai.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Ta La Chỉ", "definition": "Saketa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta La Song Thọ", "definition": "(娑羅雙樹): gọi tắt là Ta La (s: śāla, p: sāla, 娑羅) là một loại cây rất cứng, chắc, cao, lá rộng thường xuyên, vốn có của Ấn Độ, vỏ cây có màu xanh trắng, lá có hình tròn thuẫn. Khi đức Thế Tôn nhập diệt ở bên bờ Ni Liên Thuyền thuộc ngoại thành Câu Thi Na, chính Ngài đã nhập Niết Bàn dưới hai gốc cây Ta La này. Tương truyền khi ấy do đau buồn vì sự nhập diệt của đức Thế Tôn, cây này đã khô héo. Khi cây này khô héo đi thì biến thành sắc màu trắng giống như con bạch hạc, cho nên rừng Ta La Song Thọ còn được gọi là Hạc Lâm (鶴林). Cây Song Thọ ở phía đông được ví cho thường và vô thường, cây ở phía Tây là ví cho ngã và vô ngã, cây ở phía Nam ví cho lạc và vô lạc, còn cây ở phía Bắc là ví cho tịnh và vô tịnh", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Ta La Thất Phạt Để", "definition": "Xem Biện Tài Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta La Thọ Vương", "definition": "Sal Tree King", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Ta La Thọ Vương Hoa Khai Phu Phật", "definition": "Xem Khai Phu Hoa Vương Như Lai.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta La Thọ Vương Phật", "definition": "Sāladrarāja (S), Sāladrarāja-buddha (S), Calendrarāja (S), Sala Tree King Buddha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Ngã", "definition": "嗟我. Than thân mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Oán", "definition": "嗟怨. Than thở giận hờn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Phẫn", "definition": "嗟憤. Than thở buồn giận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Sứ", "definition": "鹺使. Vị quan lo về việc khai thác, chuyên chở và phân phối muối thời xưa của Trung Hoa, cũng gọi là Diêm vận sứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Ta", "definition": "些些. Một chút. Dùng trong Bạch thoại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Thán", "definition": "Parideva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Ta Tiểu", "definition": "些 小. Một chút, chút ít. Tiết Ngạc Châu Vô Đẳng Thiền Sư trong NĐHN q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Ta Tu", "definition": "些須. Chút xíu. như Ta ta 些些.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Tình", "definition": "謝情. Kể lể nỗi lòng. Truyện Trê Cóc có câu: “Bản nha hiệp nghị một lòng, khấu đầu lạy trước cửa công tạ tình” Cũng có nghĩa là đáp lại lòng tốt của người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Tử", "definition": "些 子. Còn gọi: Ta Tử Cá. Một ít, chút xíu. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Ta Vi", "definition": "些微. Chút xíu. Như Ta ta 些些.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Ta Đà", "definition": "蹉 跎. Hỏng, làm lầm. Chương Thập Huyền Đàm trong CĐTĐL q. 29:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Ta Đậu", "definition": "獻豆. Tên một thứ đồ thờ thời cổ Trung Hoa, giống như cái bát có chân cao, dùng để đựng đồ cúng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tabernacle", "definition": "Hòm thánh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tabloid", "definition": "Báo khổ nhỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tacit", "definition": "Ngụ ý", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tactile", "definition": "Xúc giác, sờ mó được, đích xác, hiển nhiên", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tad", "definition": "Đứa trẻ nhỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tadyatha", "definition": "Means ‘it is thus’", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tag", "definition": "Bản (name tag = bản tên); phần kim loại bịt đầu dây giày", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tagarasikhi", "definition": "Tagarasikhi (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tai", "definition": "偲. Sự tài giỏi Một âm là Ti. Xem Ti.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Biến", "definition": "災變. Việc không may xảy tới thình lình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Dân", "definition": "災民. Người trong nước gặp nạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Hoang", "definition": "災荒. Việc không may lớn lao xảy tới cho nhiều người và nạn mất mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Hoạ", "definition": "災禍. Điều không may lớn lao xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Hoạn", "definition": "Chỉ cho các chướng ngại làm phương hại việc hướng thượng tu đạo, gồm 8 thứ là tầm (tìm cầu), tứ (rình xét), khổ, vui, lo mừng, thở ra và hít vào. Tám thứ này ngăn trở việc tiến vào Đệ tứ thiền cõi Sắc, vì thế gọi là Bát Tai Hoạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tai Hại", "definition": "災害. Điều không may lớn lao xảy tới, gây thiệt thòi lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Hạn", "definition": "災限. Thời gian gặp chuyện không may xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Khu", "definition": "災區. Vùng đất gặp việc không may lớn lao xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Lệ", "definition": "災戾. Ngang trái Việc ngang trái, không may xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Ngược", "definition": "災虐. Hành động trái lẽ, gây hại cho người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Nạn", "definition": "災難. Việc không may lớn lao xảy tới. Đoạn trường tân thanh có câu: “Nỗi nàng tai nạn đã đầy, nỗi chàng Kim Trọng bấy chầy mới thương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Quái", "definition": "災怪. Ma quỷ làm hại người. Ta còn hiểu là tính tình lạ lùng, hay chọc phá người khác, gây phiền hà khó chịu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Sinh Minh", "definition": "哉生明. Mặt trăng mới bắt đầu ló. Chỉ ngày mồng ba đầu tháng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Sinh Phách", "definition": "哉生魄. Mặt trăng mới bắt đầu có chỗ lẹm tối đi, tức ngày 16 tháng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Tai", "definition": "諰諰. Vẻ sợ hãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Thần", "definition": "災神. Vị thần chuyên gieo việc chẳng lành, gây hại cho người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Tiếng", "definition": "Ayasa (nam) (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tai Ách", "definition": "災厄. Điều không may lớn lao xảy tới làm cho khốn khổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tai Ương", "definition": "災殃. Việc không may lớn lao xảy tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Talisman", "definition": "Bùa (vật được cho là đem lại may mắn)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tallish", "definition": "Dong dỏng cao, khá cao", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tally", "definition": "Kiểm điểm (Tallyho = tiếng hú cuả người đi săn)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tam", "definition": "Tri- (S), Trini-, Trayo-, Traya-,Tisro-, Tisra-.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam A Tăng Kì Kiếp", "definition": "Cũng gọi Tam Đại A Tăng Kì Kiếp, Tam Kiếp A Tăng Xí Da, Tam A Tăng Xí Da, Tam A Tăng Kì, Tamkì, Tam Vô Số Đại Kiếp, Tam Vô Số Kiếp, Tam Kiếp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam A Tăng Kỳ Kiếp", "definition": "三呵僧祇刧 (Thiên Thai Tứ Giáo Nghi. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Ac Thú", "definition": "Cũng gọi Tam Ác Đạo, Tam Đồ, Tam Ác. Chỉ cho địa ngục, ngã quỉ, súc sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ba La Mật Đa", "definition": "I.Tam Ba La Mật Đa. Gọi tắt: Tam Ba La Mật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Biến Độ Điền", "definition": "Cũng gọi Tam Biến Độ Tịnh, Tam Biến Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bành", "definition": "三彭. Tiếng nhà Phật, chỉ ba vị ác thần họ Bành, ở đầu, trán, và bụng người ta, là Bành Kiêu, Bành Cứ và Bành Chất (có thuyết thì bảo là Bành Sư, Bành Kiển và Bành Chất), thường xui người ta làm điều hung dữ độc ác, rồi tới ngày Canh Thân thì lên trời tâu tội của người. Do đó Tam bành chỉ sự nổi nóng hung dữ. Ta thường dùng cho đàn bà. Đoạn trường tân thanh có câu: “Mụ nghe nàng nói hay tình, bấy giờ mới nổi tam bành mụ lên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Bách Dư Hội", "definition": "三 百 餘 會. Hơn 300 pháp hội do Đức Thích Ca Mâu Ni thuyết pháp trong một đời của Ngài. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Bách Lục Thập Hội", "definition": "Cũng gọi Tam Bách Hội.Tiếng dùng trong Thiền Lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Báo", "definition": "三報 (Từ Bi Thuỷ Sám)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bát La Già Đa", "definition": "Phạm: Saôpràgata.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bát Nhã", "definition": "三般若 (Kim Quang Minh Kinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bát Nhật", "definition": "Chỉ cho 3 ngày mồng 8, 18 và 28 mỗi tháng, là những ngày chúng tăng trong Thiền gia tụng niệm trên điện Phật. Thời xưa thì thực hành trong 6 ngày mồng 3, 13, 23, mồng 8, 18, 28 mỗi tháng. Vào các ngày 3 thì cầu nguyện quốc gia thanh bình, thịnh vượng, Phật Pháp hưng long, thí chủ an ổn; còn vào các ngày 8 thì quán niệm vô thường và cầu nguyện sự nghiệp tu hành của mình được thành tựu viên mãn. Về sau, diễn biến thành 3 ngày 8 là Thượng bát (mồng 8), Trung bát (18) và Hạ bát (28). Các ngày Thượng bát và Trung bát thì cầu nguyện cho đất nước phồn vinh, đạo pháp hưng thịnh; còn ngày Hạ bát thì Đại Chúng nhớ nghĩ vô thường. [X. điều Niệm Tụng trong Sắc Tu Bách Trượng Thanh Qui Q.2; môn Tiết thời trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bình Nghĩa Trung", "definition": "Sampei Gichū (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bình Tự", "definition": "三 平 寺. Chùa ở khu núi Văn Phong, huyện Bình Hòa, tỉnh Phúc Kiến, Trung Quốc. Nguyên tên “Tam Bình Chân Viện”, niên hiệu Bảo Lịch thứ 3 (827) đời Đường Thiền Sư Nghĩa Trung sáng lập, địa chỉ ban đầu ở phia đông nam sườn núi Tử Chi, thành phố Chương Châu. Lúc pháp nạn Hội Xương chùa chiền bị phá hủy. Niên hiệu Hàm Thông thứ 7 (866) Nghĩa Trung xây dựng lại chùa Tam Bình trong khe sâu núi Đại Bách, gần núi Cửu Thành, huyện Bình Hòa. Sau đó nhiều lần xây, nhiều lần hủy. Chùa Tam Bình hiện tại được xây vào cuối đời Thanh. Kiến trúc hiện còn tựa vào núi theo thứ tự đi lên, chủ thứ phân minh, liên tiếp ba dãy nhà, trước thấp sau cao, tổng diện tích 3000㎡. Đại hùng bảo điện rộng rãi hiên ngang, mặt rộng 5 gian, trước có nguyệt đài, hai bên là lầu chuông, lầu trống. Trong điện đường có tượng đắp thếp vàng Tam Bảo Như Lai, thần thái hòa nhã hiền lành. Dãy thứ hai là Tổ sư điện địa thế cao hơn đại hùng bảo điện, mái đơn, mặt rộng 2 gian thờ tượng Nghĩa Trung và 4 pho tượng thị giả bộ mặt dữ dằn đứng hầu hai bên. Dãy cuối cùng là tháp điện, nền tòa cao 2m, chính giữa điện đường trong khám đá có tượng Nghĩa Trung ngồi kiết già. Hai bên vách điện có khảm bia đá “Trùng khắc Đường Vương phúng Chương Châu Bình đại sư bi” do Lý Mật đời Minh viết và 7 tấm bia khắc của Lưu Bột, Vương Tài đầu đời Thanh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Bình Đẳng Quán", "definition": "Cũng gọi Tam Tam Muội Da Quán. Quán xét 3 thứ đều bình đẳng, đây là giáo nghĩa của Mật Giáo. Tức quán Phật, Pháp, Tăng; hoặc thân, ngữ, ý; hoặc tâm, Phật và chúng sinh là bình đẳng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bí Mật Thân", "definition": "Chỉ cho 3 thứ thân bí mật. Theo giáo nghĩa của Tông Chân Ngôn thì các vị tôn đều có 3 thứ thân là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bạch Thực", "definition": "Cũng gọi Tam Chủng Bạch Thực, Tam Chủng Bạch Tịnh Thực, Tam Tịnh Thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bạt Chí", "definition": "Saṃparti (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bạt La", "definition": "Xem Cấm Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bạt La Đà Da Đát Đặc La", "definition": "Phạm: Zrì-mahàsaôvarsdayatantraràja. Gọi tắt: Saôvarodayatantra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bạt Đề", "definition": "Xem Tam Bạt Chí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bản", "definition": "三板. Chiếc thuyền nhỏ, chỉ ghép bằng ba tấm ván gỗ, một tấm làm đáy, hai tấm làm cái thành hai bên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Bảo", "definition": "Tiratna (P), dkon mchog gsum (T), Triratna (S), Tiratanattaya (P), Tiratanam (P), Ratnatraya (S), Ratnattaya (P), Sambō (J), Three Treasures, Triple Jewels, Triple Gem, Three Jewels, Three Precious Ones.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bảo Chương", "definition": "Cũng gọi Tam Bảo Tiêu, Tam Bảo, Tam Xoa, Tam Cổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bảo Hội Từ", "definition": "Cũng gọi Tam Bảo Hội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bảo Hữu Lục Nghĩa", "definition": "三寶有六義 (Chư Kinh Yếu Tập)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bảo Lễ", "definition": "Cũng gọi Tam Kính Lễ, Kính Lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bảo Lục Nghĩa", "definition": "Sáu nghĩa của Tam Bảo được ghi trong", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bảo Vật", "definition": "Chỉ cho những vật thuộc về Phật, Pháp, Tăng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bảo Điểu", "definition": "Cũng gọi Phật Pháp Tăng Điểu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bảo Ấn", "definition": "Chỉ cho khuôn dấu có khắc 4 chữ “Phật Pháp Tăng Bảo”, mục đích là cầu nguyện Tam Bảo gia hộ, được dùng trong các viện thuộc Thiền Tông ở Nhật Bản. Khuôn dấu có hình vuông hoặc tròn, đôi khi cũng có hình quả ấu. Còn chữ khắc trên khuôn dấu thì có nhiều kiểu: Chữ triện, chữ lệ, chữ Phạm... [X. môn Khí Vật trong Thiền Lâm Tượng Khí Tiên].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bất Hộ", "definition": "Phạm: Trìịi tathàgatasyàrakwyàni.Pàli: Tìni tathàgatassàrakkheyyàni.Chỉ cho Thân bất hộ, Ngữ bất hộ và Ý bất hộ. Nghĩa là 3 nghiệp thân khẩu ý của Như Lai xưa nay vốn thanh tịnh, không lỗi lầm, không cần phải giữ gìn phòng hộ. Nếu thêm Mệnh Bất Hộ (sự sống của Như Lai vốn thanh tịnh, không cần giữ gìn) thì gọi là Tứ Bất Hộ. Những đặc tính này của Đức Phật khác với A La Hán. Ba nghiệp của A La Hán tuy thanh tịnh nhưng vẫn thường phải giữ gìn phòng hộ mới có thể tránh lỗi lầm. [X. Luận Tập Dị Môn Túc Q.4; Luận Du Già Sư Địa Q.83; Luận Hiển Dương Thánh Giáo Q.4; Đại Thừa Nghĩa Chương Q.19]. (xt. Tứ Bất Hộ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bất Hủ", "definition": "三不朽. Ba điều không bao giờ hư mất, gồm Lập đức, Lập ngôn và Lập công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Bất Khả Tận", "definition": "三不可盡 (Bảo Tích Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bất Kiên Pháp", "definition": "Ba thứ không bền chắc, không thể giữ được mãi mãi ở thế gian. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bất Năng", "definition": "Ba Trường Hợp Không Thể Thực Hiện. Trong công cuộc hoằng pháp độ sinh, có ba trường hợp mà ngay cả Đức Phật cũng không thể thực hiện được tâm nguyện của mình:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Bất Thiện Căn", "definition": "Tini-akuśala-mūlani (P), Triny-akuśala-mūlani (S), Three Unwholesome Roots.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bất Thoái", "definition": "Trong quá trình tu hành Phật đạo, nhờ công đức đã giác ngộ mà vào được địa vị không trở lui, gọi là Bất Thoái.Bất Thoái có 3 là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bất Thành", "definition": "Ba thứ không thành. Chỉ cho sự quan hệ giữa Tịnh Độ và Uế Độ, về mặt bản chất, có 3 thứ không thành. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bất Thối", "definition": "三不退 (Quán Kinh Diệu Tông Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bất Túc", "definition": "Ba thứ không đủ làm trở ngại việc tham thiền: Áo mặc không đủ, cơm ăn không đủ và ngủ nghỉ không đủ. Tọa Thiền Dụng Tâm Kí (Đại 82, 412 ha nói: “ Áo mặc không đủ, cơm ăn không đủ và ngủ nghỉ không đủ gọi là Tam bất túc, đều là nhân duyên làm cho việc tu hành lui sụt”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bất Tịnh Nhục", "definition": "三不凈肉 (Thập Tụng Luật)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bệnh Nan Trị", "definition": "三病難治 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bệnh Tam Dược", "definition": "Tam bệnh tam dược nghĩa là có ba thứ bệnh, mà chúng sanh thường mắc phải và có ba thứ thuốc để trị ba thứ bệnh ấy, bao gồm : Theo Kinh Niết Bàn dạy rằng : về thần bệnh thường có ba chứng : nhiệt, phong, lãnh.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Bịnh Dụng Tam Dược", "definition": "三病用三藥 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bố Thí", "definition": "Tam bố thí nghĩa là bố thí có ba cách:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Bối", "definition": "Ba nhóm. Chỉ cho 3 hạng chúng sinh Vãng Sinh Tịnh Độ được nói trong Kinh Vô Lượng Thọ. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bối Sự Phật", "definition": "三輩事佛 (Phân Biệt Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bối Vãng Sanh", "definition": "Tam bối vãng sanh là ba lớp vãng sanh, ba lớp tu hành được vãng sanh qua đời Cực Lạc của Phật A Di Đà, tùy theo hạnh nghiệp sâu hay cạn, nên phân ra ba lớp : trên, giữa và dưới.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Bồ Đề", "definition": "三菩提 (Kim Quang Minh Khinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Bổn Căn", "definition": "Xem Tam Luận Tông.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Bộ", "definition": "Ba bộ. Mật Giáo chia các vị tôn của Thai Tạng Giới làm 3 bộ: Liên Hoa Bộ, Kim Cương Bộ và Phật Bộ, biểu thị cho 3 đức của Phật là Đại Bi, Đại Trí và Đại Định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bộ Bí Kinh", "definition": "Cũng gọi Chân Ngôn Tam Bộ, Bí Mật Tam Bộ, Đại Nhật Tam Bộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bộ Giả Danh Sao", "definition": "Tác phẩm, 7 quyển, do ngài Hướng A Chứng Hiền người Nhật soạn vào khoảng năm 1221-1323, được thu vào Đại Chính Tạng tập 83.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bộ Kinh", "definition": "Gọi tắt: Tam Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Bộ Đại Pháp", "definition": "Chỉ cho 3 bộ pháp lớn, đó là: Kim Cương Giới Đại Pháp, Thai Tạng Giới Đại Pháp và Tô Tất Địa Đại Pháp, là thuyết đặc biệt của Thai Mật Nhật Bản. Đông Mật (Mật Giáo do ngài Không Hải của Nhật Bản truyền, lấy Đông Tự làm đạo tràng căn bản nên gọi là Đông Mật) y cứ vào Kinh Kim Cương Đính và Kinh Đại Nhật; chỉ nói có 2 bộ Đại Pháp Kim Cương Giới và Thai Tạng Giới mà thôi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ca Diếp", "definition": "三迦葉 (Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Cang", "definition": "Theo Nho giáo có lập ra Tam cang, cũng còn gọi là Tam cương là ba bậc chánh trong xã hội :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chi", "definition": "I.Tam Chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chi Tác Pháp", "definition": "Cũng gọi Tam Phần Tác Pháp. Gọi tắt: Tam Chi, Tam Phần. Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chi Tỉ Lượng", "definition": "三支比量 (A Tỳ Đạt Ma Tạp Tập Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chiếu", "definition": "Thứ tự chiếu soi của mặt trời có 3 nấc từ khi mới mọc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chu Thuyết Pháp", "definition": "Cũng gọi Pháp Hoa Tam Chu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chu Thụ Kí", "definition": "Đức Phật Thụ Kí cho hàng Thanh Văn Thành Phật qua 3 vòng thuyết pháp của Kinh Pháp Hoa. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chuyển Ngữ", "definition": "(三轉語, Santengo): ba loại ngữ cú làm chuyển từ mê sang ngộ, tỷ như Ba Lăng Tam Chuyển Ngữ (巴陵三轉語), Triệu Châu Tam Chuyển Ngữ (趙州三轉語), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Chuyển Pháp Luân", "definition": "三轉法輪 (Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chuyển Pháp Luân Kinh", "definition": "Phạm: Dharmacakrasùtra.Kinh, 1 quyển, do ngài Nghĩa Tịnh dịch vào đời Đường, được thu vào Đại Chính Tạng tập 2.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chuyển Thập Nhị Hành Tướng", "definition": "Tri-parivarta-dvadaśakaradharma-cakra-pravartana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Chuyển Độc Văn", "definition": "Cũng gọi Thập Như Tam Chuyển. Ba cách chuyển đọc văn kinh để hiển bày 3 đế Không, Giả, Trung do Đại Sư Trí Khải Tông Thiên Thai đặt ra. Phẩm Phương Tiện Kinh Pháp Hoa có đoạn văn “Thập Như Thị” (Đại 9, 5 hạ): “Chư pháp Như Thị Tướng, Như Thị Tính, Như Thị Thể, Như Thị Lực, Như Thị Tác, Như Thị Nhân, Như Thị Duyên, Như Thị Quả, Như Thị Báo, Như Thị Bản Mạt Cứu Cánh Đẳng”. Đại Sư Trí Khải chia đoạn văn này làm 3 cách đọc khác nhau là Không Chuyển, Giả Chuyển và Trung Chuyển, gọi là Tam Chuyển:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chân Như", "definition": "I.Tam Chân Như.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chính", "definition": "Cũng gọi Tam Trung.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chướng", "definition": "三障 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chỉ", "definition": "三止 (Chỉ Quán)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chỉ Tam Thỉnh", "definition": "Ba lần ngăn lại, ba lần thỉnh cầu. Đây là điển tích Đức Phật tuyên giảng Kinh Pháp Hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Biến Dịch Sinh Tử", "definition": "Ba nghĩa của sinh tử biến dịch:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Bất Kiên Dịch Tam Kiên Pháp", "definition": "三種不堅易三堅法 (Bổn Sự Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Bệnh Tướng", "definition": "三種病相 (Thích Thiền Ba La Mật Thứ Đệ Pháp Môn)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Chí Giáo", "definition": "三種至教 (Hiển Dương Chánh Giáo Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Chỉ Quán", "definition": "Gọi tắt: Tam Chỉ Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Chứng Tướng", "definition": "Ba loại tướng chứng thấy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Chứng Tướng Bất Đồng", "definition": "三種証相不同 (Pháp Hoa Sám Nghi. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Diệt", "definition": "I.Tam Chủng Diệt.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Duyên Từ", "definition": "三種緣慈 (Phật Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Giáo Tướng", "definition": "I.Tam Chủng Giáo Tướng. Cũng gọi Giáo Tướng Tam Ý.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Huân Tập", "definition": "三種熏習 (Hoa Nghiêm Khổng Mục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Hành Nghi", "definition": "Chỉ cho 3 nghi thức niệm Phật: Tầm thường hành nghi, Biệt Thời Hành Nghi, và Lâm Chung Hành Nghi.Ba nghi thức này do vị tăng người Nhật Bản là ngài Biện A căn cứ vào thuyết của các ngài Thiện Đạo (Trung Quốc) và Nguyên Tín (Nhật Bản) mà lập ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Hương", "definition": "Chỉ cho 3 thứ hương ở thế gian được làm bằng rễ, cành và hoa của cây.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Hối Pháp", "definition": "Tam chủng hối pháp tức là sám hối có ba pháp, bao gồm như sau :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Hữu", "definition": "三種有(Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Kì Đặc Sự", "definition": "Ba việc đặc biệt kì lạ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Kỳ Đặc Sự", "definition": "三種奇特事 (Quá Khứ, Hiện Tại Nhân Quả Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Luật Nghi", "definition": "Ba loại luật nghi. Thuyết Nhất Thiết Hữu Bộ chia luật nghi (tức phòng hộ) làm 3 loại:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Lễ Phật", "definition": "三種禮佛 (Hoa Nghiêm Kinh Khổng Mục )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Mãn", "definition": "Bậc tu hành khi thành đạo có đủ ba món đầy đủ gọi là Tam chủng mãn, bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Nhân Nan Báo", "definition": "三種人難報 (Đại Tỳ Bà Sa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Nhẫn Hạnh", "definition": "三種忍行 (Chư Kinh Yếu Tập)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Pháp Hoa", "definition": "Ba loại Pháp Hoa. Chỉ cho Căn Bản, Ẩn Mật và Hiển Thuyết Pháp Hoa, đây là chủ trương của Tông Thiên Thai Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Pháp Thân", "definition": "I.Tam Chủng Pháp Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Phát Bồ Đề Tâm", "definition": "三種發菩提心 ( Khởi Tín Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Phát Tâm", "definition": "三種發心 (Quán Kinh Diệu Tông Sao )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Phương Ngôn", "definition": "Ba thứ ngôn giáo dùng để giải thích “Bát Bất Trung Đạo” do ngài Hưng Hoàng Pháp Lãng thuộc Tông Tam Luận đời Tùy lập ra. Cứ theo Đại Thừa Huyền Luận quyển 1 thì 3 loại phương ngôn ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Quang Minh", "definition": "三種光明 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Quán Pháp", "definition": "三種觀法 (Chỉ Quán Nghĩa Lệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Quỉ Thần Ma", "definition": "三種鬼神魔 (Thích Thiền Ba La Mật Tứ Đệ Pháp Môn. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Sinh Thân", "definition": "Ba thứ thân do học phái Số Luận thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Sắc", "definition": "三種色 (Ngũ Uẩn Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Tam Bảo", "definition": "Tam chủng Tam bảo nghĩa là Tam bảo có ba loại, gồm như sau :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Tam Quán", "definition": "三種三觀 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thanh Tịnh", "definition": "三種清凈 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thiên", "definition": "三種天 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thiền", "definition": "Ba thứ thiền định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Thành Tựu", "definition": "Chỉ cho 3 thứ thành tựu: Chủng Tử, Tự Tại và Hiện Hành là giáo thuyết của tông duy thức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Thân", "definition": "三種身 (Đại Thừa Ngũ Uẩn Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thường", "definition": "三種常 (Phật Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thần Biến", "definition": "三種神变 (Đại Bảo Tích Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thắng Dũng Mãnh", "definition": "三種勝勇猛 (Đại Thừa Trang Nghiêm Kinh Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thế Gian", "definition": "三種世间 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thị Đạo", "definition": "三種示導 (Bát Nhã Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Thụy Miên", "definition": "Thụy Miên nghĩa đen là ngủ gục, nghĩa bóng là phiền não; Thụy Miên ở đây là tác dụng làm cho tâm trở nên mờ tối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Tinh Tiến", "definition": "I.Tam Chủng Tinh Tiến. Ba thứ tinh tiến do Luận Thành Duy Thức quyển 9 thiết lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Tinh Tấn", "definition": "三種精進 (Bồ Tát Thiện Giới Kinh. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Trang Nghiêm", "definition": "I.Tam Chủng Trang Nghiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Trọng Chướng", "definition": "三種重障 (Du Già Đại Giáo Vương Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Trọng Tội", "definition": "Ba thứ tội nặng do Mật Tông thành lập. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Tác Ý", "definition": "Ba loại tác ý. Tác ý là làm cho tâm chú ý để dẫn tới hoạt động. Ba loại tác ý là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Tăng", "definition": "三種僧 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Tư Hoặc", "definition": "Chỉ cho 3 thứ Tư Hoặc sinh khởi do tâm tham đắm các trần cảnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Tướng", "definition": "三種相 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Tập Khí", "definition": "Cũng gọi Tam Chủng Huân Tập, Tam Huân Tập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Tịnh Nghiệp", "definition": "三種凈業 (Quán Vô Lượng Thọ Phật Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Tịnh Nhục", "definition": "Ba Loại Tịnh Nhục. Chữ “tịnh” ở đây có nghĩa là không cố ý giết, không bảo người khác giết, và không chấp nhận khi biết người khác vì mình mà giết sinh vật để lấy thịt. Theo kinh điển Đại Thừa, ăn thịt là trái phạm tinh thần từ bi của người tu hành, cho nên có qui điều cấm chỉ ăn thịt. Nhưng trong kinh luật Tiểu Thừa thì quyền nghi cho phép các thầy tì kheo, có thể ăn ba loại thịt, được gọi là “tịnh nhục”, mà không bị phạm giới; đó là:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Chủng Tức Thân Thành Phật", "definition": "Chỉ cho 3 nghĩa Tức Thân Thành Phật: Lí cụ, Gia trì và Hiển đắc do Tông Chân Ngôn, Nhật Bản, thành lập. Ba nghĩa này đều là sự nghiệp tự nhiên, vô tác trong pháp giới bình đẳng, gọi chung là Tức Thân Thành Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Từ Bi", "definition": "Tam chủng từ bi nghĩa là từ bi có ba loại :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Tử", "definition": "Tam chủng tử nghĩa là khi chết có ba cách :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Tự Tánh", "definition": "Tam chủng tự tánh nghĩa là tự tánh phân ra làm ba loại, bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Viên Mãn An Lạc", "definition": "三種圓滿安樂 (Du Già Sư Địa Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Vô Thường", "definition": "三種無常 (Thuận Trung Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Vị", "definition": "Tam chủng vị là ba sở thích của nhà tu :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Ác", "definition": "三種恶 (Thành Thật Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Ý Sanh Thân", "definition": "三種意生身 (Lăng Già Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Ý Sinh Thân", "definition": "Ba thứ Ý Sinh Thân. Hàng Bồ Tát Thông Giáo Đăng địa được tam muội Như huyễn, có năng lực thị hiện vô lượng thần thông tự tại, vào khắp các cõi Phật, tùy ý không ngại, ý muốn đến nơi nào thì thân theo đến nơi ấy, cho nên gọi là Ý Sinh Thân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Chủng Đoạn", "definition": "Tam chủng đoạn là ba loại đoạn pháp chẳng tác khởi có nhiều loại :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Chủng Đại Sư", "definition": "三種大師 (Bổn Sự Kinh).", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Chủng Định Nghiệp Luân", "definition": "三種定業輪 (Địa Tạng Thập Luân Kinh. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Cá Cáo Sắc", "definition": "Ba lần dạy bảo của Đức Phật đối với các Bồ Tát tích hóa và các Bồ Tát đến từ các phương khác được ghi trong Kinh Pháp Hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cá Nguyệt", "definition": "三個月. Thời hạn ba tháng. Cứ ba tháng một.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Cô", "definition": "三孤. Ba chức quan lớn thời cổ Trung Hoa, ở dưới bực Tam công, gồm Thiếu sư, Thiếu phó, Thiếu bảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Công", "definition": "三公. Ba chức quan lớn nhất triều đình trong thời cổ Trung Hoa, gồm Thái sư, Thái phó, Thái bảo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Cú", "definition": "Ba câu chuyển ngữ của các Thiền Sư dùng để khai thị người học. Các tam cú sau đây được xem là có tính cách Đại Biểu:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cú Giai Đoạn", "definition": "Gọi tắt: Tam Cú.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cúng Dường", "definition": "Ba pháp cúng dường được nêu trong Phổ Hiền hành nguyện sớ, đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Căn", "definition": "I.Tam Căn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cương", "definition": "三綱. Ba giềng mối ở đời, gồm Quân thần, Phủ tử, Phu phụ. Cũng đọc Tam cang. Truyện Hoa Tiên có câu: “Tình phu phụ nghĩa quần thần, trong tam cương ấy xem phần nào hơn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Cước Lư Nhi", "definition": "三 脚 驢 兒. 1. Chỉ cho cái phi lý, cái không thể suy lường được. Bởi vì con lừa 3 chân làm sao leo núi được, nhưng chỗ cứu cánh tuyệt đối là phi lý nên phải nhờ đến con lừa 3 chân này mới vào được. Tứ Sơn Kệ trong Khóa Hư Lục của Trần Thái Tông:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Cảnh", "definition": "三境 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Cấp", "definition": "三級. Thềm nhà có ba bậc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Cấu", "definition": "Cấu, Phạm: Mala.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cổ", "definition": "Cũng gọi Tam Cổ Chử, Tam Cổ Kim Cương, Tam Cổ Bạt Chiếc La, Tam Cổ Phạ Nhật Ra, Để Lí Thường Câu, Tam Cổ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cổ Câu", "definition": "Cũng gọi Kim Cương Câu. Móc câu 3 chĩa, vốn là 1 trong những thứ vũ khí của Ấn Độ đời xưa, về sau được Mật Giáo sử dụng để tượng trưng cho hình Tam Muội Da của các vị tôn. Như các Bồ Tát Kim Cương Câu trong Tứ nhiếp Bồ Tát của Mạn Đồ La Kim Cương Giới, Kim Cương diện thiên của Ngoại Kim Cương Bộ, Bồ Tát Đại An lạc bất không chân thực trong Viện Biến Tri của Mạn Đồ La Thai Tạng Giới, Bồ Tát Bất Không Câu Quán Thế Âm của Viện Hư Không Tạng v.v... đều cầm Tam Cổ Câu. [X. Kim Cương Giới Thất Tập Q.thượng; Chư Thuyết Bất Đồng Kí Q.2]", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cổ Kích", "definition": "Phạm: Tri-sùlahoặc Zakti. Hán âm: Điệt Lí Thủ La. Cũng gọi Tam Đầu Kích, Tam Kích Xoa, Tam Cổ Mâu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cổ Ấn", "definition": "Cũng gọi Tam Cốc Ấn, Tam Cổ Kim Cương Chử Ấn, Tam Cổ Chử Ấn. Ấn Khế tượng trưng hình cây chày Kim Cương 3 chĩa của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cụ Túc", "definition": "Đầy đủ 3 thứ. Tức chỉ cho lô hương, bình hoa và chân đèn cúng dường ở trước Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cử", "definition": "Ba tội được nêu ra (cử) để chúng tăng xét xử trong khi làm pháp yết ma. Người vi phạm 1 trong 3 tội này thì bị đuổi ra khỏi Đại Chúng. Tam cử là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Cực", "definition": "三極. Ba thứ bậc nhất, quan trọng nhất trong vũ trụ, gồm Trời, Đất và Người. Còn gọi là Tam tài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Cực Thiểu", "definition": "Chỉ cho đơn vị nhỏ nhất của 3 thứ là vật chất, danh xưng và thời gian. Đơn vị nhỏ nhất của vật chất là cực vi; đơn vị nhỏ nhất của danh xưng là 1 chữ; đơn vị nhỏ nhất của thời gian là sát na. [X. Luận Câu Xá Q.12].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Da Tam Bồ", "definition": "Xem Tam Miệu Tam Phật Đà.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Da Tam Phật", "definition": "Xem Tam Miệu Tam Phật Đà.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Diệt Đế", "definition": "Chỉ cho 3 loại Diệt Đế do Tông Duy Thức dựa vào 3 tính mà lập ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Diệu", "definition": "Chỉ cho thuyết “Tâm, Phật và chúng sinh” dung hòa vào nhau một cách mầu nhiệm tự tại do Tông Thiên Thai thành lập. Đây là từ ngữ hình dung sự bao nhiếp lẫn nhau giữa mình và người.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Diệu Hạnh", "definition": "Trini-sucaritani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Duyên", "definition": "Cũng gọi Nhiếp Thủ Tam Duyên. Chỉ cho Thân Duyên, Cận duyên và Tăng Thượng Duyên. Từ ngữ này có xuất xứ từ Quán Kinh Sớ Định Thiện Nghĩa quyển 3 của ngài Thiện Đạo đời Đường, nói về duyên do mà những hành giả tu Tịnh Độ được ánh sáng của Đức Phật A Di Đà nhiếp thủ. Tam duyên là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Duyên Sơn Chí", "definition": "(三緣山志, Sanenzanshi): 9 quyển, trước tác của Trúc Vĩ Thiện Trúc (竹尾善筑, Takeo Zenchiku, 1782-1839), cháu của Sơn Huyện Đại Nhị (山縣大貳, Yamagata Daini, 1725-1767), nhà binh học dưới thời Giang Hộ; là thư tịch viết về lịch sử của Tăng Thượng Tự (增上寺, Zōjō-ji), ngôi chùa trung tâm của Phái Trấn Tây (鎭西派) thuộc Tịnh Độ Tông", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Dư", "definition": "三餘 (Hoa Nghiêm Tuỳ Sớ Diễn Nghĩa Sao )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Dương", "definition": "(三陽): Dịch Học Tượng Số thời nhà Hán lấy 12 quẻ tượng trưng cho 12 tháng trong năm. Trong đó, tháng 10 là quẻ Khôn (坤卦), thuần về hào âm; tháng 11 là quẻ Phục (復卦), một dương sanh bên dưới; tháng 12 là quẻ Lâm (臨卦), hai dương sanh bên dưới; tháng Giêng là quẻ Thái (泰卦), ba dương sanh bên dưới. Lúc này âm dần tiêu, dương dần tăng trưởng, có ý là vạn sự vạn vật đều đổi mới. Cho nên, sau này người ta thường dùng từ Tam Dương khai thái (三陽開泰), Tam Dương giao thái (三陽交泰) để xưng tụng, chúc mừng đầu năm mới hoặc ngụ ý cát tường, tốt đẹp. Như trong tờ Hạ Nguyên Đán Biểu (賀元旦表) của Trương Cư Chánh (張居正, 1525-1582) nhà Minh có đoạn: “Tư giả đương Tam Dương khai thái chi hầu, chánh vạn vật xuất chấn chi thời, khí chuyển hồng quân, cọng lạc Nghiêu thiên chi hóa nhật (茲者當三陽開泰之候、正萬物出震之時、氣轉鴻鈞、共樂堯天之化日, nay gặp lúc khí tiết đầu xuân tốt đẹp, đúng phải lúc vạn vật chuyển mình, khí rung đất trời, cùng vui ngày chuyển hóa dưới trời vua Nghiêu).” Hay trong Tục Chỉ Nguyệt Lục (續指月錄, 卍 Tục Tạng Kinh Vol. 84, No. 1579) quyển 11 có câu: “Tam Dương giao thái, vạn vật hàm tân, hiển nhất chân chi diệu dụng, tổng tạo hóa chi uyên nguyên, trần trần hợp đạo, xứ xứ thông tân, pháp diên đại khải, giác uyển hoằng khai (三陽交泰、萬物咸新、顯一眞之妙用、總造化之淵源、塵塵合道、處處通津、法筵大啟、覺苑弘開, đầu xuân an thái, muôn vật mới toanh, lộ nguồn chơn ấy diệu dụng, thảy tạo hóa ấy uyên nguyên, nơi nơi hợp đạo, chốn chốn thấm nhuần, cỗ pháp rộng mở, vườn giác phô bày).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Dục", "definition": "三慾. Tiếng nhà Phật, chỉ ba điều ham muốn xấu xa, gồm Ăn, Ngủ và Trai gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Gia Thôn Lý Hán", "definition": "三 家 村 裏 漢. Gã ở trong xóm hẻo lánh. Thiền Tông dùng cụm từ này để chỉ cho kẻ dốt nát; không có kiến thức. Đây là lời mà thiền sư thường dùng để chê trách. Vân Môn Ngữ Lục, q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Gia Thôn Lý Nam Nữ", "definition": "三 家 村 裏 男 女. Con cái kẻ quê mùa, hàm ngữ khí khinh rẻ. Tiết Huệ Trung Quốc sư trong TĐT q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Giai Giáo", "definition": "Cũng gọi Đệ Tam Giai Tông, Tam Giai Tông, Phổ Pháp Tông. Tông phái Phật Giáo Trung Quốc do ngài Tín Hành (540-594) sáng lập vào đời Tùy đến đời Trung đường thì bị cấm lưu hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giai Phật Pháp", "definition": "Cũng gọi Tam Giai Biệt Tập, Tam Giai Tập Lục, Tam Giai Tập, Tứ Quyển Tam Giai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giai Phật Pháp Mật Kí", "definition": "Tác phẩm, 3 quyển, hiện nay chỉ còn quyển thượng, là bản do ông P. Pelliot lấy được ở Đôn Hoàng, mang số hiệu 2412.Đây là sách chú thích bộ Tam Giai Phật Pháp do ngài Tín Hành soạn vào đời Tùy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giác", "definition": "三觉 (Viên Giác Kinh và Khởi Tín Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Giác Sơn", "definition": "三 角 山. Còn gọi: Thê Hiền Sơn. Núi cách Bắc thành 3km thuộc huyện Kim Đường, tỉnh Tứ Xuyên, Trung Quốc. Thế núi uốn khúc như rồng, đỉnh cao thanh tú. Những ngôi chùa được xây cất vào đời Tùy Đường có: Pháp Hải, Phổ Tế, Quảng Lạc gọi chung là Tam Giác Tự. Đời Đường, Vương Bột có bài thơ “Du Phạm Vũ Tam Giác Tự” như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Giáo", "definition": "三教. Ba hệ thống tư tưởng lớn của Đông phương, gồm Nho giáo, Lão giáo và Phật giáo. Văn tế sĩ dân lục tỉnh của Nguyễn Đình Chiểu có câu: “Bọn tam giáo quen theo đường cũ, riêng than bất hạnh làm nghèo”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Giáo Bình Tâm Luận", "definition": "Tác phẩm, 2 quyển, do ông Lưu mật soạn vào đời Nguyên, được thu vào Đại Chính Tạng tập 52.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giáo Chỉ Qui", "definition": "Tác phẩm, 3 quyển, do ngài Không Hải, vị tăng người Nhật soạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giáo Chỉ Quy", "definition": "(三敎指歸, Sankōshiiki, Sankōshiki): sách tuyên ngôn xuất gia của Không Hải Đại Sư, được viết dưới dạng tiểu thuyết ngụ ý mang tính tôn giáo, là trước tác ra đời vào năm thứ 16 (797) niên hiệu Khánh Lịch (慶曆), lúc Đại Sư 24 tuổi; gồm 3 quyển: quyển Thượng là Quy Mao Tiên Sinh Luận (龜毛先生), quyển Trung là Hư Vong Ẩn Sĩ Luận (虛亡隱士論) và quyển Hạ là Giả Danh Khất Nhi Luận (假名乞兒論). Trong lời tựa, Đại Sư thuật rõ lý do rời khỏi ghế nhà trường, nhân duyên gặp gỡ vị Sa Môn, phát tâm xuất gia và viết bộ này. Từ phần luận của Quy Mao Tiên Sinh trở về sau được cấu thành theo phong cách Hí Khúc. Trước hết, trong phần Quy Mao Tiên Sinh Luận, đối với tuổi thanh niên bất lương, phóng đãng, không chịu vâng lời của đứa cháu ngoại của Ông Thố Giác (兔角公) là Điệt Nha Công Tử (蛭牙公子), từ lập trường của Nho Giáo, Quy Mao Tiên Sinh thuyết giáo về đạo lý nhân luân, trung hiếu để cải hóa. Kế đến, trong phần Hư Vong Ẩn Sĩ Luận, khi ngồi bên lắng nghe sự việc như vậy, Hư Vong Ẩn Sĩ thuyết về tính ưu việt của Đạo Giáo hơn Nho Giáo để khuất phục Quy Mao Tiên Sinh, Điệt Nha Công Tử và Ông Thố Giác. Trong quyển Hạ Giả Danh Khất Nhi Luận, nhân vật Giả Danh Khất Nhi dưới dạng nhà khất thực (sự thật là Không Hải lúc tuổi thanh niên) khẳng định rằng chữ Hiếu vốn phủ định việc xuất gia là hạnh hiếu nhỏ; chính xuất gia mới là đại hiếu; vì vậy Phật Giáo ưu việt hơn cả Nho Giáo và Đạo Giáo; và cuối cùng Đại Sư kết thúc với bài Sanh Tử Hải Chi Phú (生死海之賦) cũng như Thập Vận Chi Thi (十韻之詩). Trong tác phẩm này, Quy Mao Tiên Sinh ám chỉ cho người chú bên mẹ của Không Hải là A Đao Đại Túc (阿刀大足). Tác phẩm thêu dệt câu chuyện Đại Sư nghỉ học, sống cuộc đời của người cư sĩ tại gia với chí nguyện xuất gia; nhưng bị cả gia đình dòng họ Tá Bá (佐伯) phản đối kịch liệt. với ý nghĩa đó, đây là thư tịch rất quý báu, thể hiện rõ bóng dáng thời đại thanh niên của Không Hải và sự chuyển biến về mặt tư tưởng của Đại Sư trong thời gian ấy", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Giáo Luận Hành", "definition": "I.Tam Giáo Luận Hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giáo Sưu Thần Đại Toàn", "definition": "Tác phẩm, 7 quyển, không rõ tác giả, có lẽ được trứ tác vào khoảng năm Vĩnh Lạc (1402-1424) đời Minh về sau.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giáo Đồ", "definition": "Cũng gọi Tam Giáo Thánh Nhân Đồ, Tam Thánh Đồ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giáp", "definition": "三甲. Ba hạng thi đậu trong khoa thi Hội và Đình thời xưa, gồm Trạng nguyên, Bảng nhãn, Thám hoa là đệ Nhất giáp, Hoàng giáp là đệ nhị giáp, và Tiến sĩ là đệ tam giáp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Giả", "definition": "三假 (Chỉ Quán Phụ Hành)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Giả Quán", "definition": "Chỉ cho 3 pháp quán: Pháp Giả Hư Thực Quán, Thụ Giả Hư Thực Quán và Danh Giả Hư Thực Quán được nêu trong Phẩm Tựa Kinh Nhân Vương Bát Nhã Ba La Mật quyển thượng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giải Thoát Môn", "definition": "三解脫門 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Giới", "definition": "三界(Hoa Nghiêm Khổng Mục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Giới Chư Thiên", "definition": "Tam giới chư thiên là các cõi trời trong Tam giới (dục giới, sắc giới, vô sắc giới) bao gồm như sau :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Giới Cửu Địa", "definition": "三界九地 (Thích Thị Yếu Lãm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Giới Duy Tâm", "definition": "Tribhāvacittamātra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Giới Duy Tâm - Vạn Pháp Duy Thức", "definition": "三 界 唯 心、萬 法 唯 識. Ý nói toàn ba cõi thế tục (Dục giới, Sắc giới, Vô sắc giới) và tất cả sự vật ở thế gian vốn không thật có, đều do tâm thức biến hiện mà thành. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Giới Hùng", "definition": "Đức hiệu của Phật. Phật là bậc Đại Hùng trong 3 cõi, có năng lực hàng phục tất cả ma chướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Hỏa Trạch", "definition": "Cảnh nhà cháy là Ba cõi. Tam giới tỷ như tòa nhà bị hỏa hoạn. Chúng sanh ở trong Ba cõi hằng bị thiêu đốt bởi các phiền não, các khổ lụy, cũng như người ta bị đốt trong tòa nhà bị hỏa hoạn, vì vậy nên gọi là Tam giới hỏa trạch. Diệu Pháp liên Hoa kinh, Thí dụ phẩm: Như thị đẳng chủng chủng chư khổ, chúng sanh một tại kỳ trung, hoan hỷ du hành bất ý giác bất trí, bất kinh bất bố, diệc bất sanh yếm, bất cầu giải thoát! Ư thử Tam giới hỏa trạch, Đông Tây trì ẩn. Tuy tao đại khổ, bất dĩ vi hoạn: Chúng sanh chìm đắm trong trong vô số nạn khổ như vậy, thế mà họ vui vẻ dong chơi, chẳng hay chẳng biết, chẳng kinh chẳng sở, chẳng hề biết chán, chẳng tầm ra khỏi! Ở trong Tam giới như cảnh nhà bị hỏa hoạn ấy, họ chạy trửng bên nầy bên kia. Tuy gặp đại khổ, thế mà họ chẳng cho đó là nguy!", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Giới Khổ Luân", "definition": "Ba cõi là vòng mê khổ, quay mãi không ngừng. Tức là cảnh giới sinh tử luân hồi của chúng sinh. Kinh Nhân Vương Hộ Quốc Bát Nhã Ba La Mật Đa quyển thượng (Đại 8, 837 trung) nói: “Thập Thiện Bồ Tát phát tâm rộng lớn, mãi mãi xa lìa biển khổ luân hồi 3 cõi (Tam Giới khổ luân hải)”. [X. Kinh Thắng Thiên Vương Bát Nhã Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Nhãn", "definition": "Con mắt của 3 cõi, danh từ tôn xưng Đức Phật. Phật là bậc Đại Trí Đại Giác, là con mắt của mọi loài trong 3 cõi, dắt dẫn chúng sinh ra khỏi hiểm nạn sinh tử, vì thế gọi là Tam Giới Nhãn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Trí", "definition": "Nyanatiloka (1878-1960). Danh tăng người Đức, sinh ở thành phố Wiesbaden, là vị Tỉ Khưu đầu tiên của nước Đức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Tôn", "definition": "Bậc tôn quí trong 3 cõi.Là danh từ tôn xưng Đức Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Tạng", "definition": "Ba cõi là cái kho chứa đựng phiền não nghiệp quả của tất cả chúng sinh, cho nên gọi là Tam Giới Tạng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Vô An", "definition": "Trong 3 cõi: Dục, Sắc và Vô Sắc không thể tìm được sự an lành chân thật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Vạn Linh Bài", "definition": "Bài vị của các vong linh trong 3 cõi được đặt ở điện Phật của các chùa viện để hàng ngày nguyện cầu cho những chúng sinh vô duyên cũng được nhờ ơn Phật mà chóng siêu thoát. Trên bài vị này, viết các hàng chữ: “Tam Giới vạn linh, Thập phương chí thánh, Lục thân quyến thuộc, Thất thế phụ mẫu”.(Muôn linh ba cõi, Các thánh mười phương, Họ hàng sáu thân, Cha mẹ bảy đời). Hoặc viết: “Tam Giới vạn linh, Lục đạo tứ sinh, Thất thế phụ mẫu, Lục thân quyến thuộc”... bài vị này cũng được đặt trên đàn cúng ngạ quỉ khi mở hội Thí Ngạ Quỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Giới Độc Tôn", "definition": "Từ tôn xưng Đức Phật. Phật là đấng tôn quí nhất trong 3 cõi, đầy đủ trí tuệ và phúc đức, là bậc duy nhất được 3 cõi tôn kính quí trọng, là bậc thầy dẫn đường cho 4 loài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hiền", "definition": "三贤 (Nhân Vương Hộ Quốc Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Hiền Thập Thánh", "definition": "Những vị tu hành đến giai đoạn tương tự chánh giải (hiểu đúng chơn lý) đè nén được hoặc nghiệp gọi là bậc Hiền, những vị phát sanh chơn trí đoạn được từng phần hoặc nghiệp gọi là bậc Thánh Có ba quả vị tu chứng được bậc Hiền gọi là Tam hiền, có mười quả vị tu chứng bậc Thánh nên gọi là Thập Thánh. v Tam hiền: gồm có ba quả vị :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Hiền Thập Tánh", "definition": "Thập Trụ + Thập Hạnh + Thập Hồi Hướng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Hiển Nhất", "definition": "Đồng nghĩa: Phế Quyền Lập Thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hiện Quán", "definition": "Chỉ cho Kiến Hiện Quán, Duyên Hiện Quán và Sự Hiện Quán. Hiện quán là dùng, trí tuệ Vô Lậu quán xét lí của Tứ Thánh Đế hiện tiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hoàng", "definition": "San-huang (C), Sanhuang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Hoặc", "definition": "三惑 (Thiên Thai Tứ Giáo Nghi Tập Chú. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Huyền", "definition": "三絃. Tên một thứ đàn thời cổ, có ba dây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Huyền Qua Giáp", "definition": "三 玄 戈 甲. Giáo giáp ba huyền. Tam huyền (ba huyền) của tông Lâm Tế giống như là giáo là giáp, người tu thiền phải mang nó để phá vượt qua ba cổng cứng chắc là Tổ Sư quan, Trùng quan, Lao quan. Bài tán của Pháp Cổ (phần Chư nhân tán tụng) trong Tuệ Trung Thượng Sĩ Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Huyền Tam Yếu", "definition": "Tiếng dùng trongThiền Lâm.Phương pháp tiếp dẫn người học của Thiền Sư Lâm Tế Nghĩa Huyền. Tam huyền là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Huệ", "definition": "三慧 (Thành Thật Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Hà", "definition": "(三河): có nhiều nghĩa khác nhau.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Hà Tứ Hải Cửu Giang", "definition": "(三河四海九江): ba sông, bốn biển, chín sông, là từ chỉ chung cho những nơi có nước như ao hồ, sông ngòi, biển cả trên khắp thế giới. Như trong Thái Thượng Linh Bảo Ngọc Quỹ Minh Chơn Đại Trai Quan Công Nghi (太上靈寶玉匱明眞大齋官功儀) của Đạo Giáo có đoạn cung thỉnh rằng: “Cẩn thượng thỉnh Tam Nguyên Quân, Thượng Nguyên Thiên Quan, Trung Nguyên Địa Quan, Hạ Nguyên Thủy Quan, Tam Cung Cửu Phủ, Bách Nhị Thập Tào, Ngũ Nhạc Đại Thần, Thập Đại Động Thiên, Tam Thập Lục Động Thiên, Nhị Thập Tứ Hóa, Tam Hà Tứ Hải, Cửu Giang Thủy Đế, Thập Nhị Hà Nguyên, Cửu Cung Chân Nhân, Thập Nhị Tiên Quân, Cửu Thiên Ty Mạng, Ngũ Nhạc Trượng Nhân, Cửu Thiên Sứ Giả, Trữ Phó Chánh Chức Tá Mạng Đại Thần, Thiên Tiên Địa Tiên, Phi Tiên Thần Tiên, Vương Đồng Ngọc Nữ, binh mã kỵ thừa, giáng lâm tiêu tòa (謹上請三元君、上元天官、中元地官、下元水官、三宮九府、百二十曹、五嶽大神、十大洞天、三十六洞天、二十四化、三河四海、九江水帝、十二河源、九宮眞人、十二仙君、九天司命、五嶽丈人、九天使者、儲副正職佐命大神、天仙地仙、飛仙神仙、王童玉女、兵馬騎乘、降臨醮座, xin cung thỉnh Tam Nguyên Quân, Thượng Nguyên Thiên Quan, Trung Nguyên Địa Quan, Hạ Nguyên Thủy Quan, Ba Cung Chín Phủ, Trăm Hai Mươi Tào, Đại Thần Năm Núi, Trời Mười Động Lớn, Trời Ba Mươi Sáu Động, Hai Mươi Bốn Hóa, Ba Sông Bốn Biển, Chín Sông Thủy Đế, Mười Hai Nguồn Sông, Chân Nhân Chín Cung, mười hai tiên quân, Cửu Thiên Ty Mạng, Ngũ Nhạc Trượng Nhân, Cửu Thiên Sứ Giả, Trữ Phó Chánh Chức Tá Mạng Đại Thần, Thiên Tiên Địa Tiên, Phi Tiên Thần Tiên, Vương Đồng Ngọc Nữ, cỡi mang binh ngựa, giáng xuống đàn cúng).” Hay như trong Thái Thượng Thần Chú Diên Thọ Diệu Kinh (太上神呪延壽妙經) cũng có đoạn: “Tam Hà Tứ Hải, Cửu Giang Bát Cực, chư chân nhân đẳng, Tiên Đồng Ngọc Nữ, Tam Giới Địa Kỳ, Tam Quan Cửu Thự, nhất thiết thần minh, văn trì thử kinh, tức vi tiêu trừ nhất thiết khổ não (三河四海、九江八極、諸眞人等、仙童玉女、三界地祇、三官九署、一切神明、聞持此經、卽爲消除一切苦惱, Ba Sông Bốn Biển, Chín Sông Tám Hướng, các vị chân nhân, Tiên Đồng Ngọc Nữ, Thổ Thần Ba Cõi, Ba Quan Chín Sảnh, hết thảy thần minh, nghe trì kinh này, tức được tiêu trừ hết thảy khổ ách).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Hàn", "definition": "(三韓): tên gọi chung của ba tiểu quốc Mã Hàn (馬韓), Thần Hàn (神韓) và Biện Hàn (辨韓), đã chiếm cứ phía Nam Triều Tiên cổ đại. Nó còn là tên gọi chung của Tân La (新羅), Bách Tế (百濟) và Cao Cú Lệ (高句麗).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Hành", "definition": "I.Tam Hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hòa", "definition": "Ba hòa hợp, tức chỉ cho căn, cảnh và thức hòa hợp mà sinh ra Tâm Sở Xúc. Luận Thành Duy Thức quyển 3 (Đại 31, 11 trung) nói: “Căn, cảnh, thức, tùy thuận nhau gọi là Tam hòa, Xúc do đó mà sinh”. Tuy nhiên, các sư khác đối với vấn đề này cũng có những quan điểm bất đồng. [X. Luận Câu Xá Q.10.Luận Thành Duy Thức Q.6]. (xt. Xúc).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hóa", "definition": "Trini-nirmanani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Hô", "definition": "三呼. Ba lần reo hò chúc tụng. Chỉ sự chúc tụng vị thánh quân. Do điển vua Vũ Đế nhà Hán lên núi, nghe trong núi vang lên ba lần những tiếng hô Vạn tuế. Bài Tụng Tây hồ phú của Nguyễn Huy Lượng có câu: “Dưới ngọ nhật vang lừng tiếng trúc, hình viễn sơn mong rạp xuống tam hồ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Hạnh", "definition": "三行 (Đại Trí Độ Luận và chánh pháp niệm xứ kinh )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Hạnh Nghiệp", "definition": "Xem Tam nghiệp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Học", "definition": "三学 (Phiên Dịch Danh Nghĩa).", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Học - Tam Vô Lậu Học", "definition": "Ba Môn Học Giải Thoát. Mục đích của người tu học Phật là đạt tới thành quả giác ngộ, an lạc và giải thoát cho chính mình và cho cả mọi người. Mục đích ấy chỉ có thể đạt được khi nào hành giả thể nghiệm trọn vẹn 3 phép học là Giới, Định và Tuệ.", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Hỏa", "definition": "I.Tam Hỏa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hối Pháp", "definition": "三悔法 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Hồn Thất Phách", "definition": "Ba hồn 7 vía trong thân của chúng sinh.Tam hồn chỉ cho Thai Quang Nghiệp Hồn Thần Thức, U Tinh Chuyển Hồn Thần Thức và Tương Linh Hiện Hồn Thần Thức; Thất Phách chỉ cho Tước Âm Phách Thần Thức, Thiên Tặc Phách Thần Thức, Phi Độc Phách Thần Thức, Thi Cấu Phách Thần Thức, Xú Phế Phách Thần Thức, Trừ Uế Phách Thần Thức Và Phục Thi Phách Thần Thức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hội", "definition": "I.Tam Hội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hợp", "definition": "三合. Vật liệu để xây nhà thời xưa, do ba thứ họp lại, là vôi, tro và muối. Thường gọi là Tam hợp thổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Hữu", "definition": "三有 (Bồ Tát Thiện Giới Kinh và Đại Trí Độ Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Hữu Vi", "definition": "Cũng gọi Tam hữu vi tướng, Tam tướng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hữu Đối", "definition": "Chỉ cho 3 thứ Hữu đối là Chướng Ngại Hữu Đối, Cảnh Giới Hữu Đối và Sở Duyên Hữu Đối.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Hựu", "definition": "三宥. Ba trường hợp được hưởng sự tha tội. Đời Chu, ba trường hợp gồm Bất thức (không biết luật lệ), Quá ngộ (vô tình phạm lỗi) và Di vong (quên luật lệ), gọi là Tam hựu, được hưởng khoan hồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Khoa", "definition": "三科 (Tỳ Bà Sa Luận và A Tỳ Đạt Ma Phẩm Loại Túc Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Khoa Giản Cảnh", "definition": "Lựa chọn cảnh trong 3 khoa (ấm nhập giới) để quán xét.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Khôi", "definition": "三魁. Ba người đậu đầu trong khoa thi Đình thời xưa, gồm Trạng nguyên, Bảng nhãn, Thám hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Không", "definition": "三空 (Kim Cang Kinh San Định Ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Khổ", "definition": "三苦 (Tích Huyền Ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Khổ Đối Tam Giới", "definition": "三苦對三界 (Thiên Thai Tứ Giáo Nghĩa Tập Chú. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Kinh Nghĩa Sớ", "definition": "Cũng gọi Tam Kinh Sớ Thích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Kinh Nhất Luận", "definition": "Ba kinh 1 luận. Tức 4 bộ kinh luận mà Tông Tịnh Độ y cứ. Tam kinh chỉ cho Kinh Vô Lượng Thọ 2 quyển (do ngài Khang Tăng Khải dịch vào đời Tào Ngụy), Kinh Quán Vô Lượng Thọ 1 quyển (do ngài Cương Lương Da Xá dịch vào đời Lưu Tống), và Kinh A Di Đà 1 quyển (do ngài Cưu Ma La Thập dịch vào đời Diêu Tần). Còn nhất luận thì chỉ cho Vô Lượng Thọ Kinh Ưu Bà Đề Xá Nguyện Sinh Kệ 1 quyển (do Bồ Tát Thiên Thân soạn, ngài Bồ Đề Lưu Chi dịch vào đời Nguyên Ngụy). Ý chỉ trọng yếu của 4 bộ kinh luận này đều nhằm hiển bày giáo pháp Vãng Sinh Tịnh Độ. Tam kinh còn được gọi là Tịnh Độ Tam Bộ Kinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Kinh Nhất Luận Ngũ Bộ Cửu Quyển", "definition": "(三經一論五部九巻): các kinh điển thuộc Tịnh Độ Tông. Tam Kinh gồm Vô Lượng Thọ Kinh (無量壽經), Quán Vô Lượng Thọ Kinh (觀無量壽經) và A Di Đà Kinh (阿彌陀經). Nhất Luận là bộ Vãng Sanh Luận (徃生論) của Thế Thân (s: Vasubandhu, 世親). Còn Ngũ Bộ Cửu Quyển là từ tổng xưng các trước tác của Thiện Đạo (善導, Zendō, 613-681), gồm: Quán Kinh Sớ (觀經疏) 4 quyển, Pháp Sự Tán (法事讚) 2 quyển, Quán Niệm Pháp Môn (觀念法門) 1 quyển, Vãng Sanh Lễ Tán (徃生禮讚) 1 quyển và Ban Chu Tán (般舟讚) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Kinh Thông Biệt", "definition": "三經通別 (Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Kiếp", "definition": "I.Tam Kiếp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Kiết", "definition": "Trini-samyojanani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Kiển Tự Phược", "definition": "Cũng gọi Tác Kiển Tự Phược. Con tằm làm kén để tự buộc mình. Ví dụ chúng sinh tự khởi phiền não, tự tạo ác nghiệp đểphảichìm đắm trong 3 cõi, giống như con tằm tự làm lấy kén và nhả tơ ra để tự buộc mình. Kinh Đại Bát Niết Bàn (bản Bắc) quyển 27 (Đại 12, 524 thượng) nói: “Như tằm làm kén, tự sống tự chết; tất cả chúng sinh cũng tự làm như thế, chẳng thấy Phật Tính, cho nên tự tạo kết nghiệp, sống chết trôi lăn [X. Kinh Phật Thuyết Vô Thường; Luận Đại Trí Độ Q.31, 90; Vãng Sinh Luận Chú Q.thượng]. (xt. Tác Kiển Tự Phược).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Kiệt", "definition": "三傑. Ba người giỏi đời Hán sơ, gồm Trương Lương, Hàn Tín, Tiêu Hà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Kì", "definition": "Ba Kì. Ba kì tức là ba A Tăng Kì Kiếp, nghĩa là ba vô số kiếp; là thời gian tu hành của một vị Bồ Tát từ lúc mới Phát Tâm cho đến ngày thành Phật. Bồ Tát Địa Tiền tu tập trải qua bốn mươi bậc (gồm mười Tín, mười Trụ, mười Hạnh và mười Hồ Hướng) thì hoàn tất A Tăng Kì thứ nhất (sơ A Tăng Kì); Bồ Tát Địa Thượng, từ bậc Sơ Địa cho đến khi đạt được bậc Thất Địa thì hoàn tất A Tăng Kì thứ hai (nhị A Tăng Kì); từ bậc Bát Địa cho đến bậc Thập Địa thì hoàn tất A Tăng Kì thứ ba (tam A Tăng Kì).", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Kết", "definition": "Phạm: Trìịi saôyojanàni.Pàli: Tìịi saôyojanàni.Cũng gọi Sơ Quả Tam Kết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Kỳ", "definition": "(三祇, Sangi): hay còn gọi là Tam A Tăng Kỳ Kiếp (三阿僧祇劫), Tam Đại A Tăng Kỳ Kiếp (三大阿僧祇劫), Tam Đại Tăng Kỳ (三大僧祇). A Tăng Kỳ Kiếp (s: asaṅkhyeya-kalpa, p: asaṅkheyya-kappa, 阿僧祇劫) có nghĩa là số lượng kiếp (thời gian vĩnh hằng) quá lớn đến nỗi không thể nào đếm được, và gấp lên ba lần như vậy được gọi là Tam A Tăng Kỳ Kiếp. Vị Bồ Tát từ khi bắt đầu phát tâm bồ đề cho đến khi thành Phật cần phải trải qua tu hành trong khoảng thời gian Tam A Tăng Kỳ Bách Đại Kiếp (三阿僧祇百大劫, tức ba kỳ và trăm kiếp lớn). Vị Bồ Tát đang tu hành 50 vị, trong A Tăng Kỳ Kiếp đầu tiên, cần phải tu tập 40 vị gồm Thập Tín (十信), Thập Hạnh (十行), Thập Trụ (十住), Thập Hồi Hướng (十回向); trong A Tăng Kỳ Kiếp thứ hai thì cần tu từ Sơ Địa cho đến Địa Thứ Bảy trong Thập Địa (十地); trong A Tăng Kỳ Kiếp thứ ba thì cần tu từ Địa Thứ Tám cho đến Địa Thứ Mười. Sau khi tu hạnh Ba La Mật trãi qua Ba A Tăng Kỳ Kiếp, trong thời gian trăm đại kiếp, vị Bồ Tát cần phải tu hành thêm nữa để đạt đến 32 tướng tốt, 80 vẻ đẹp. Trong Phật Thuyết A Di Đà Kinh (佛說阿彌陀經, Taishō No. 366) có giải thích về vị giáo chủ cõi Cực Lạc (s: Sukhāvatī, 極樂) như sau: “Hựu Xá Lợi Phất ! Bỉ Phật thọ mạng cập kỳ nhân dân, vô lượng vô biên A Tăng Kỳ Kiếp, cố danh A Di Đà (又舍利弗、彼佛壽命及其人民、無量無邊阿僧祇劫、故名阿彌陀, Lại nữa Xá Lợi Phất ! Thọ mạng và nhân dân của đức Phật kia vô lượng vô biên không thể tính đếm được, nên được gọi là A Di Đà).” Hay như trong Đạt Ma Đại Sư Phá Tướng Luận (達磨大師破相論, CBETA No. 1220) có đoạn: “A Tăng Kỳ Kiếp giả, tức Tam Độc tâm dã, cố ngôn A Tăng Kỳ; Hán danh bất khả số; thử Tam Độc tâm, ư trung hữu Hằng sa ác niệm, ư nhất nhất niệm trung, giai vi nhất thiết, như thị Hằng sa bất khả số dã; cố ngôn Tam Đại A Tăng Kỳ; chơn như chi tánh, ký bị Tam Độc chi sở phú cái; nhược bất siêu bỉ tam đại Hằng sa độc ác chi tâm, vân hà danh vi giải thoát (阿僧祇劫者、卽三毒心也、胡言阿僧祇、漢名不可數、此三毒心、於中有恆沙惡念、於一一念中、皆爲一劫、如是恆沙不可數也、故言三大阿僧祇、眞如之性、旣被三毒之所覆蓋、若不超彼三大恆沙毒惡之心、云何名爲解脫, A Tăng Kỳ Kiếp tức là tâm có Ba Độc; nên gọi là A Tăng Kỳ; Tàu gọi là không thể tính đếm được; tâm có Ba Độc này, trong đó có niệm ác nhiều như sông Hằng; trong mỗi một niệm đều có tất cả, như vậy cát sông Hằng không thể nào tính đếm được; nên có tên là Ba A Tăng Kỳ Kiếp Lớn; tánh của chơn như, đã bị Ba Độc che lấp, nếu không vượt qua tâm ác độc lớn như cát sông Hằng, thế nào gọi là giải thoát đây).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Kỳ Mạt Kiếp", "definition": "Tiếng dùng trong tông giáo dân gian ở đời Minh, Thanh tại Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Loại Cường Địch", "definition": "Tiếng dùng của Phật Giáo Nhật Bản.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Loại Cảnh", "definition": "三類境 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Luân", "definition": "三輪 (Kim Quang Minh Kinh Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Luân Giáo", "definition": "I.Tam Luân Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luân Thanh Tịnh", "definition": "Ba Vầng Thanh Tịnh. Khi tu tập sáu pháp qua bờ, dù ở bất cứ pháp nào, hành giả chỉ biết một mực tu tập mà không để tâm chấp trước vào ba vầng, không mong cầu phước báo Hữu Lậu, gọi là ba vầng thanh tịnh. Ví dụ, khi tu hạnh bố thí, hành giả nên bố thí một cách vô tâm, không để ý rằng mình chính là người bố thí, người kia là người thọ nhận vật bố thí của mình, và của cải (nhiều ít, tốt xấu v. v... ) này chính là do mình đem cho người. Nếu để ý tới mình là người đem cho thì sinh lòng tự đắc; để ý tới người thọ nhận thì sinh lòng thương hại hoặc khinh mạn; để ý đến của cải đem cho thì sinh tâm phân biệt, so đo, đôi khi còn hối tiếc, và như thế tức là tâm đã bị nhiễm ô; ngay cả khi bố thí một cách vô tâm mà lại mong cầu mai sau sẽ được phước, được đền ơn, được gặp quả báo tốt, v. v... thì tâm vẫn bị nhiễm ô, gọi là “ba vầng không thanh tịnh” (tam luân bất tịnh), chẳng được phước báo gì, hoặc chỉ được chút ít phước báo Hữu Lậu ở thế gian mà thôi. Hành giả thực hiện hạnh bố thí với tâm hoàn toàn vô tư như trên, thể hội tánh tướng của ba vầng đều không, không vướng mắc cũng không mong cầu, gọi là “ba vầng thanh tịnh”; đó chính là Bố Thí Ba La Mật (hay Bố Thí Độ).", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Luân Thân", "definition": "Cũng gọi Tam Chủng Luân Thân, Tam Luân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luân Thể Không", "definition": "三輪体空 (Năng Đoạn Kim Cang Kinh Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Luân Tướng", "definition": "Ba Tướng Luân. Chỉ cho người bố thí, người nhận sự bố thí và vật để bố thí. Tướng Tam Luân tồn tại trong ý tưởng gọi là Hữu Tướng tam luân. Diệt Tam Luân này, trụ nơi vô tâm mà thực hành pháp bố thí thì đó là Thí Ba La Mật tam luân thanh tịnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luân trên đây có thể được xem là Vũ Trụ Luân (cosmologie) của Phật Giáo. Ngoài Tam Luân cấu thành Khí thế giới, trên Kim Luân lại hình thành thế giới hiện thực. [X. Kinh Trường A Hàm Q.18; Kinh Tăng Nhất A Hàm Q.37; Kinh Khởi Thế Q.1; Kinh Đại Lâu Thán Q.1; Luận Câu Xá Q.11; Luận Lập Thế A Tì Đàm Q.1]. (xt. Đại Địa Tứ Luân, Tu Di Sơn).", "definition": "II.Tam Luân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luân trên đây có ý nghĩa giống với Tam Thị Hiện, Tam Chủng Thị Đạo. [X. Kinh Đại Thừa Đại Tập Địa Tạng Thập Luân Q.6; Luận Du Già Sư Địa Q.27, 37; Đại Thừa Pháp Uyển Nghĩa Lâm Chương Q.6, phần cuối]. (xt. Tam Chủng Thị Đạo).", "definition": "III.Tam Luân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luận", "definition": "三論 (Mỗi thứ trích ra từ một bộ luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Luận Huyền Nghĩa", "definition": "Tác phẩm, 1 quyển, do ngài Cát Tạng soạn vào đời Tùy, được thu vào Đại Chính Tạng tập 45.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luận Huyền Sớ Văn Nghĩa Yếu", "definition": "Tác phẩm, 10 quyển, do ngài Trân Hải, người Nhật Bản soạn, được thu vào Đại Chính Tạng tập 70.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Luận Phái", "definition": "San-lun (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Luận Tông", "definition": "Tông Tam Luận : còn được gọi bằng nhiều tên khác như tông Vô Tướng, Không, Bát Nhã, Trung Quán, Gia Tường, v.v..., là một trong 13 tông phái của Phật giáo Trung-quốc (xem mục “Tông Thiên Thai”). Tông này y cứ vào giáo nghĩa của ba bộ luận là Trung Luận, Bách Luận và Thập Nhị Môn Luận để làm cơ sở lập tông, xiển dương nghĩa lí không, vô tướng và bát bất trung đạo. Tông Tam Luận vốn có nguồn gốc từ Ấn-độ, bởi vậy, trong bộ Tam Luận Tổ Sư Truyện Tập đã liệt kê 6 vị tổ ban đầu của tông này ở Ấn-độ là: Đức Thế Tôn, Bồ Tát Văn Thù, Bồ Tát Mã Minh, Bồ Tát Long Thọ, Bồ Tát Ca Na Đề Bà, và Bồ Tát La Hầu La Bạt Đà La. Vào cuối thế kỉ thứ 2 và đầu thế kỉ thứ 3 TL, ngài Long Thọ ở Nam Ấn-độ đã trước tác hai bộ luận quan trọng là Trung Luận và Thập Nhị Môn Luận, khai mở nền móng cho tông này. Môn hạ của ngài Long Thọ là ngài Ca Na Đề Bà đã tạo bộ Bách Luận, hợp với hai bộ Trung Luận và Thập Nhị Môn Luận ở trên, làm thành ba bộ luận căn bản của tông Tam Luận. Rồi các ngài La Hầu La Bạt Đà La, Thanh Mục, Bà Tẩu, Phật Hộ, Vô Trước, An Tuệ, Thanh Biện, Hộ Pháp, Nguyệt Xứng, v.v... có đến hơn 70 vị luận sư trước sau viết các tác phẩm liên quan đến ba bộ luận trên, làm cho tông Tam Luận rất thịnh hành ở Ấn-độ trong khoảng thời gian mấy thế kỉ đó.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tam Luận Tổ Sư Truyện Tập", "definition": "Tác phẩm, 3 quyển, thu chép truyện kí về các Tổ thuộc Tông Tam Luận của Ấn Độ và Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Lăng Hình", "definition": "三稜形. Hình chóp ba mặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Lược", "definition": "三略. Tên cuốn binh thư do Khương Tử Nha soạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Lượng", "definition": "三量 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Lạc", "definition": "三樂 (Đại Bảo Tích Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Lạc Xoa", "definition": "Chỉ cho 3 ức, là số hạn thành tựu việc niệm tụng Đà La Ni trong Mật Giáo. Lạc xoa vốn là danh số của Ấn Độ, 10 vạn là 1 lạc xoa, vì 10 vạn là 1 ức nên 3 lạc xoa dịch là 3 ức. Hoặc chỉ cho 3 thời sáng, trưa, chiều, và 3 mùa lạnh, nóng, mưa, đây đều là cách giải thích theo nghĩa nông cạn và sơ lược. Còn nếu giải thích theo nghĩa sâu xa và kín nhiệm thì Lạc xoa nghĩa là tứơng và kiến, 3 lạc xoa nghĩa là hành giả quán xét thực tướng của 3 bình đẳng: Tự bình đẳng, Ấn bình đẳng và Bản Tôn bình đẳng, để đạt đến cảnh giới nhất thể viên dung vô ngại.Ngoài ra, 3 lạc xoa cũng có nghĩa là 3 nghiệp thân, khẩu, ý đều hiện 3 tướng lành: Hơi ấm (Tức Tai), khói (Hàng Phục) và ánh sáng (Tăng Ích). [X. Đại Nhật Kinh Sớ Q.17, 20; Đại Nhật Kinh Nghĩa Thích Diễn Mật Sao Q.10].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Lậu", "definition": "三漏 (Pháp Hoa Văn Cú Ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Lễ", "definition": "Cũng gọi Tam Bái.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Lục Độc Pháp", "definition": "Tam lục là 18 (3x6=18), Độc pháp chỉ cho pháp riêng biệt. Tức là 18 pháp đặc biệt, chỉ riêng Phật mới có, gọi là Thập bát bất cộng pháp. Mười tám thứ công đức này, hàng Nhị Thừa Thanh Văn và Duyên Giác không có được, nên gọi là Độc pháp, cũng gọi Bất cộng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Lực", "definition": "I.Tam Lực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Ba Đa Pháp", "definition": "Tam Ma Ba Đa, Phạm: Samàpta. Cũng gọi Tam Pha Đa, Tam Ba Đa. Hán dịch: Cứu cánh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Bát Để", "definition": "Xem Chánh Thọ.Xem Đẳng Chí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Ma Bát Để.", "definition": "Phạm, Pàli: Samàpatti. Hán âm: Tam Ma Bạt Đề, Tam Ma Nga. Hán dịch: Đẳng Chí, Chính Thụ, Chính Định Hiện Tiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Da Đạo", "definition": "Từ gọi chung pháp của Mật Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Hi Đa", "definition": "Phạm, Pàli: Samàhita.Hán dịch: Đẳng Dẫn, Thắng Định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Hý Đa", "definition": "Xem Đẳng Dẫn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Ma Nhã", "definition": "Dịch cũ: Tổng tướng. Dịch mới: Hữu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Đát Tra Quốc", "definition": "Tam Ma Đát Tra, Phạm: Samataỉa. Tên một nước đời xưa ở miền Đông Ấn Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Đế", "definition": "Xem Đại Định.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Ma Đề", "definition": "Là thiền quán tùy duyên biến hiện, quán các pháp đều giả như lúa mạ huyển hóa mà dần dần tăng trưởng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Ma Địa", "definition": "Phạm, Pàli: Samàdhi. Cũng gọi Tam Muội, Tam Ma Đề, Tam Ma Đế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Địa Pháp", "definition": "Từ gọi chung pháp của Mật Giáo. Vì bản ý của Mật Tông là tu Tam Ma Địa Tam Mật bình đẳng, cho nên pháp của Mật Giáo được gọi chung là Tam Ma Địa Pháp. Pháp này cũng là pháp lắng tưởng 5 tướng thành thân, quán xét 3 mật sâu kín để thông suốt Tam Ma Địa Bồ Đề Tâm. Vì thế, tâm bồ đề trong Mật Giáo cũng được gọi là Tam Ma Địa Bồ Đề Tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ma Địa Vương Kinh", "definition": "Samādhirāja Sūtra (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Minh", "definition": "三明(Tạp A Hàm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Miêu Tam Phật Đà", "definition": "Phạm: Samyak-saôbuddha. Pàli: Sammà-sambuddha.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Miệu Tam Bồ Đề", "definition": "Samyak-saṃbodhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Miệu Tam Phật Đà", "definition": "Samyak-saṃbuddha (S), Sammā-sambuddha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Muội", "definition": "Concentration-extatique Samādhi 三昧 samādhi", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Muội Da", "definition": "Samaya (S), dam sig (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Muội Da Giới", "definition": "Cũng gọi Tam Ma Da giới, Bí Mật Tam Muội Da Giới, Phật Tính Tam Muội Da Giới, Bí Mật Giới, Tam Thế Vô Chướng Ngại Trí Giới, Vô Vi Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Da Hình", "definition": "Cũng gọi Tam Ma Da hình. Gọi tắt: Tam Hình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Da Mạn Đa La", "definition": "Samaya-maṇdala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Muội Da Mạn Đồ La", "definition": "Phạm: Samaya-maịđala.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Da Thân", "definition": "Chỉ cho thân Phật trong Mạn Đồ La Tam Muội Da, giống với hình Tam Muội Da. Các phù hiệu tượng trưng cho bản thệ, nội chứng... của chư tôn trong Mật Giáo và tháp, bánh xe báu, hoa sen, quốc độ, khí thế giới... đều gọi là Tam Muội Da thân. Như lầu gác bảo vương tức là thân Tam Muội Da của Như Lai; trong Hiển Giáo, tứ Đại được xem là phi tình nhưng trong Mật Giáo thì chúng là thân Tam Muội Da của Như Lai.(xt. Tam Muội Da Hình).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Da nghĩa là bình đẳng, như Tam Mật thân, ngữ, ý cả 3 pháp đều bình đẳng và viên dung vô ngại, gọi là Tam Tam Muội Da, cũng gọi là Tam bình đẳng. Ngoài ra, tâm trí bi, Phật Pháp tăng, pháp báo ứng (3 thân)... cũng đều gọi là Tam Tam Muội Da. [X. Phẩm Tam Tam Muội Da trong Kinh Đại Nhật Q.6; Đại Nhật Kinh Sớ Sao Q.4; Đại Nhật Kinh Nghĩa Thích Diễn Mật Sao Q.10].", "definition": "II.Tam Tam Muội Da.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Hỏa", "definition": "Tummo (T), Subtle heat.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Muội Lạc Chánh Thọ Ý Sinh Thân", "definition": "Samādhi-sukhasamāpatti-manomayakāya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Muội Môn", "definition": "Chỉ cho cánh cửa Tam Muội, từ đó có thể tiến vào vô lượng Tam Muội của Phật. Tam Muội của Phật có vô lượng, vô số, hàng Bồ Tát không thể nào thâm nhập được hết các Tam Muội này, hoặc có vị nghe việc ấy sinh tâm trở lui, vì thế Đức Phật giảng nói về Tam Muội môn, hễ vào được 1 môn thì thu tóm vô lượng Tam Muội, hệt như nắm 1 góc tấm áo thì có thể giơ toàn thể tấm áo lên. [X. Luận Đại Trí Độ Q.28].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Phát Đắc", "definition": "Cũng gọi Phát Định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Trường", "definition": "Tiếng dùng của Phật Giáo Nhật Bản. Cũng gọi Tam Muội Sở.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Muội Vương An Lập Tam Muội", "definition": "Samādhirāja-supratisthita-samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Muội Vương Tam Muội", "definition": "(三昧王三昧, Zammaiōzammai): quyển thứ 72 trong bộ Chánh Pháp Nhãn Tạng (正法眼藏), là phần Thị Chúng (示眾) tại Cát Phong Tự (吉峰寺) vùng Việt Tiền (越前, Echizen), vào ngày 15 tháng 2 năm 1244. Đây là thiên dạy rõ rằng ngồi Thiền là vua của hết thảy các Tam Muội, hành Thiền là loại Tam Muội thâu nhiếp tất cả các Tam Muội khác.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Muội Đường", "definition": "Cũng gọi Pháp Hoa Tam Muội Viện, Pháp Hoa Đường.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Môn", "definition": "I.Tam Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Môn Tam Đại Thị Giả", "definition": "Cũng gọi Sơn Môn Tam Thị Giả. Ba vị Đại Thị Giả trong tùng lâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Môn Đồ Phái", "definition": "Cũng gọi Việt Tiền Tam Môn Đồ Bất Bái Chi Chúng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Mạn Đa Bạt Đà La", "definition": "Xem Phổ Hiền Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Mật", "definition": "Trini-guhyani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Mật Dụng Đại", "definition": "Tác dụng to lớn của Tam Mật. Tam Mật chỉ cho Thân Mật, Ngữ Mật và Ý Mật. Tác dụng của Tam Mật trùm khắp pháp giới, bao quát cả vũ trụ vạn hữu, cho nên gọi là Tam Mật dụng Đại.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Mật Gia Trì", "definition": "Thân, ngữ, ý là tam mật. Đại Nhựt Như Lai bản thể khắp thời gian không gian là thân mật, tiếng nói khắp thời gian không gian là ngữ mật, thức đại khắp thời gian không gian là ý mật. Bàn tay kiến ấn là thân mật, miệng tụng chú là ngữ mật, tâm quán tưởng là ý mật. Thân, ngữ, ý đồng thời thực hành gọi là tam mật gia trì.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Mật Quán", "definition": "Cũng gọi Tam Kim Cương Quán, Tam Kim Quán, Tam Hồng Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Mặc Đường", "definition": "Chỉ cho 3 nơi mà khi vào trong phải giữ im lặng, đó là nhà tắm, nhà tăng, và nhà xí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Mộc Thành Sâm", "definition": "三木成森. Cây làm nên rừng, chỉ sức mạnh của sự đoàn kết. Ca dao ta cũng có câu: “Một cây làm chẳng nên non, ba cây chụm lại nên hòn núi cao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Nghi", "definition": "三疑 (Thiền Ba La Mật Môn)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nghiêm", "definition": "Ba cách để nghiệm xem những cảnh tượng như Phật, Bồ Tát hiện ra khi hành giả ở trong định là chính hay tà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nghiêp Tứ Uy Nghi", "definition": "Ba nghiệp và 4 uy nghi.Ba nghiệp là những sự tạo tác của thân, khẩu, ý, 4 uy nghi là các nghi biểu đi, đứng, ngồi, nằm. Ba nghiệp và 4 uy nghi là chỉ chung cho tất cả mọi hành vi của người tu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nghiệp", "definition": "三業(Tích Huyền Ký)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nghiệp Cúng Dường", "definition": "三業供養 (Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nghiệp Hoặc Loạn", "definition": "(三業惑亂, Sangōwakuran): cuộc pháp luận (luận tranh về giáo pháp) xảy ra trong nội bộ Phái Bổn Nguyện Tự (本願寺派, Honganji-ha, phía Tây Bổn Nguyện Tự) thuộc Tịnh Độ Chơn Tông dưới thời Giang Hộ (江戸, Edo, 1600-1867). Người đứng ra xét xử để dẹp yên vụ náo động này là Hiếp Phản An Đổng (脇坂安董, Wakizaka Yasutada), quan Tự Xã Phụng Hành (寺社奉行, Jishabugyō) và là Phiên chủ đời thứ 8 của Phiên Long Dã (龍野藩, Tatsuno-han). Trong phần An Đổng của cuốn Hiếp Phản Gia Phổ (脇坂家譜) có ghi rằng: “Ngày 11 tháng 7 năm Văn Hóa thứ 3 (1806), xét xử vụ náo động về Tông ý của Tây Bổn Nguyện Tự.” Tại Thiện Long Tự (善龍寺, Zenryū-ji, thuộc Tatsuno-shi [龍野市], Hyōgo-ken [兵庫縣]) vẫn còn thư tịch Chơn Tông Tân Nghĩa Cổ Nghĩa Tài Đoạn Thật Ký (眞宗新義古義裁斷實記), được xuất bản ở Long Dã. Sự kiện Tam Nghiệp Hoặc Loạn này là cuộc luận tranh về vấn đề gọi là Dị An Tâm (異安心, ianshin, an tâm theo nghĩa khác). Dị An Tâm ở đây có nghĩa là an tâm của Chơn Tông, khác với an tâm của cảnh giới cứu độ; cho nên đây là cuộc luận tranh để nêu rõ đâu là an tâm đúng nghĩa. An tâm và giáo tướng (giáo lý) có mối quan hệ mật thiết hỗ tương lẫn nhau, không thể phân ly; cho nên nếu giáo thuyết mà sai lạc thì có khả năng nảy sinh mê tín, tà tín. Sự kiện này phát sinh vào năm 1791 (Khoan Chính [寛政] 3) và chấm dứt vào năm 1806 (Văn Hóa [文化] 3). Thật ra, vụ này cần phải mất 10 năm mới giải quyết xong. Nguyên nhân xảy ra cuộc náo động này là sau lễ Húy Kỵ lần thứ 300 của Liên Như Thượng Nhân (蓮如上人) vào năm 1798 (Khoan Chính 10). Năm trước đó, 1797, Trí Động (智洞), người nhậm chức Năng Hóa (能化, Nōke) đời thứ 7 của Học Lâm, thay thế Văn Như Thượng Nhân (文如上人) giảng thuyết về Vô Lượng Thọ Kinh (無量壽經); trong đó, ông tuyên xướng thuyết gọi là Tam Nghiệp Quy Mạng (三業歸命), Dục Sanh Quy Mạng (欲生歸命). Nếu truy nguyên đầu nguồn của thuyết này, nó vốn phát xuất từ Tri Không (知空), vị Năng Hóa đời thứ 3, cho đến Tuấn Đế (峻諦), cho đến vị Năng Hóa đời thứ 7 là Công Tồn (功存). Vị này viết cuốn Nguyện Sanh Quy Mạng Biện (願生歸命辨) để đưa ra chủ thuyết mới là Tam Nghiệp Quy Mạng; và đến thời của Trí Động thì thuyết này đã trở thành tiêu chuẩn an tâm của Chơn Tông thuộc phái Bổn Nguyện Tự. Như có đề cập ở trên, vào ngày 11 tháng 7 năm 1806, An Đổng đứng ra xét xử vụ dao động này, phán quyết rằng thuyết Tam Nghiệp Quy Mạng là không đúng chánh nghĩa, tuyên phạt rất khoan dung phía Tông môn Phái Bổn Nguyện Tự phải bế môn trong vòng 100 ngày. Cũng nhân xảy ra vụ này, chức Năng Hóa bị phế bỏ hẳn luôn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Nghĩa Hoan Hỉ", "definition": "三義歡喜 (Quán Kinh Diệu Tông Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nghĩa Quán", "definition": "Theo thứ tự quán xét nghĩa chân thực của 5 uẩn, 12 xứ, 18 giới...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ngu", "definition": "三虞. Lễ cúng tuần thứ ba sau khi chôn cất. Một trong tang lễ thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Nguyên", "definition": "三元. Ba lần đậu đầu trong các khoa thi Hương, thi Hội và thi Đình, tức Giải nguyên, Hội nguyên và Đình nguyên. Thơ Nguyễn Khuyến có câu: “Cậy cái bảng vàng treo nhị giáp, nẹt thằng mặt trắng lấy Tam nguyên” Ba hạng đứng đầu vũ trụ, gồm Thiên, Địa, Nhân. Cũng gọi là Tam tài, Tam cực – Ba ngày rằm của các tháng giêng, bảy và mười âm lịch, cũng gọi là Tam nguyên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Nguyên Chuyển Nhập", "definition": "Chuyển dần đến 3 nguyện. Đây là giáo nghĩa của Tịnh Độ Chân Tông ở Nhật Bản. Tông này chủ trương từ giáo Phương tiện (phương tiện dẫn đến chân thực) đến giáo chân thực là quá trình tín ngưỡng từ nguyện thứ 19 (yếu môn) trong 48 nguyện của Đức Phật A Di Đà tiến đến nguyện thứ 20 (chân môn), rồi sau lại chuyển tiến đến nguyện thứ 18 (hoằng nguyện). Tức là: Trước hết, xả bỏ giáo thánh đạo, nguyện sinh Tịnh Độ (nguyện thứ 19); kế đến, xả bỏ các hạnh để chuyên tu niệm Phật (nguyện thứ 20); cuối cùng, quyết lìa bỏ tâm tự lực mà nương tựa vào nguyện tâm tha lực (nguyện thứ 18).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nguyên Đích Chứng", "definition": "Cũng gọi Đích Thủ Tam Nguyện. Sự chứng minh của 3 nguyện. Nghĩa là dùng 3 nguyện thứ 18, 11, 22, trong 48 nguyện của Đức Phật A Di Đà để nói rõ rằng nhân (Ngũ Niệm Môn) và quả (Ngũ Công Đức Môn) của việc Vãng Sinh Tịnh Độ đều là nhờ sức bản nguyện của Phật A Di Đà mà có, đồng thời, để chứng minh rằng sinh về Tịnh Độ thì mau chóng được thành Phật. Cũng tức là dùng 3 nguyện này để chứng minh cái lực dụng của nguyện lực Phật A Di Đà. Thuyết này có xuất xứ từ Vãng Sinh Luận Chú quyển hạ. Cũng sách này còn nói, nếu chúng sinh tu Ngũ Niệm Môn và lấy sức bản nguyện của Phật A Di Đà làm duyên tăng thượng thì sẽ được Vãng Sinh Tịnh Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nguyện", "definition": "I.Tam Nguyện. Ba thứ thệ nguyện Bốn mươi tám nguyện của Đức Phật A Di Đà được chia làm 3 loại chung sau đây:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nguyện Định Lực", "definition": "Tam nguyện định lực còn gọi là Tam nguyện lực, chỉ ba môn lực dụng của Đức Phật A Di Đà gia trì hộ niệm chúng sanh, khiến chúng sanh luôn được thấy Phật. Tam nguyện định lực là :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Ngôn Thanh", "definition": "Cũng gọi Tam Số. Thuật ngữ đặc biệt trong văn pháp tiếng Phạm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nhiệt", "definition": "Cũng gọi Tam Hoạn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nhân", "definition": "三因 (Phật Tánh Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nhân Phật Tánh", "definition": "三因佛性 (Kim Quang Minh Kinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nhân Phật Tính", "definition": "I.Tam Nhân Phật Tính.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nhân Quán Thập Nhị Nhân Duyên", "definition": "三人觀十二因緣 (Niết Bàn Kinh )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nhân Tam Quả", "definition": "三因三果 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nhãn", "definition": "Chỉ cho nhục nhãn (mắt thịt), thiên nhãn (mắt trời) và tuệ nhãn (mắt tuệ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nhãn Nhân", "definition": "Trilochana (S), Three-eye person.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Nhơn Duyên", "definition": "Người tu hành đắc quả là nhờ có đủ ba nhơn duyên :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Như Lai Tạng", "definition": "三如來藏 (Viên Giác Kinh Lược Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nhất Nhị Thừa", "definition": "Chỉ cho Tam Thừa và Nhất Thừa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Nhất Trí", "definition": "三一致. Luật lệ soạn kịch cổ điển của Tây phương, gồm một nơi, một thời gian và một sự việc (Règle des Trois Unités).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Nhẫn", "definition": "三忍 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Nhật Trai", "definition": "Cũng gọi Kiến vương trai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Niên Nhũ Bộ", "definition": "(三年乳哺): ba năm trường mẹ cho con bú và mớm cơm cho con ăn. Trong Địa Mẫu Kinh (地母經) của Đạo Giáo có câu: “Thùy phi phụ mẫu sanh, thập nguyệt hoài thai khổ, tam niên nhũ bộ tân (誰非父母生、十月懷胎苦、三年乳哺辛, ai là người không phải do cha mẹ sanh ra, mười tháng mang thai cực khổ, ba năm cho con bú mớm nhọc nhằn).” Hơn nữa, trong Tây Du Ký (西遊記), hồi thứ 78 cũng có đoạn: “Thiên vô nhị nhật, nhân vô nhị lý, dưỡng dục hài đồng, phụ tinh mẫu huyết, hoài thai thập nguyệt, đãi thời nhi sanh, sanh hạ nhũ bộ tam niên, tiệm thành thể tướng, khởi hữu bất tri chi lý (天無二日、人無二理、养育孩童，父精母血，怀胎十月，待时而生，生下乳哺三年，渐成体相，岂有不知之理！養育孩童、父精母血、懷胎十月、待時而生、生下乳哺三年、漸成體相、豈有不知之理, trời không có hai mặt trời, người không có hai lý, nuôi dưỡng con nhỏ, tinh cha huyết mẹ, mang thai mười tháng, đợi đến lúc sanh con, sanh xong cho bú mớm ba năm, dần dần thành hình tướng, liệu làm sao chẳng biết lý ấy).” Hay như trong Khuyến Phát Bồ Đề Tâm Văn (勸發菩提心文) của Tỉnh Am Đại Sư (省庵大師, 1686-1734) có câu: “Vân hà niệm phụ mẫu ân ? Ai ai phụ mẫu, sanh ngã cù lao, thập nguyệt tam niên, hoài thai nhũ bộ (云何念父母恩、哀哀父母、生我劬勞、十月三年、懷胎乳哺, Thế nào là nhớ đến công ơn cha mẹ ? Thương thay cha mẹ, sanh ta khó nhọc, mười tháng ba năm, mang thai bú mớm).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Niết Bàn", "definition": "三涅槃 (Kim Quang Minh Kinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Niệm Nguyên Lực", "definition": "Cũng gọi Tam Niệm Lực, Tam Lực, Tam Sự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Niệm Phật", "definition": "Tam niệm phật, tức niệm phật có ba cách :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Niệm Trụ", "definition": "Trini-Smṛty-Upasṭhānani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Niệm Xứ", "definition": "Xem Tam Niệm Trụ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Nông", "definition": "三農. Ba hạng thuế đánh vào hoa lợi ruộng đất, tùy theo mức canh tác nhiều hay ít gồm Thượng nông, Trung nông và Hạ nông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Năng Biến", "definition": "Trividha-pariṇāma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Năng Tam Bất Năng", "definition": "Tam năng tam bất năng là ba món được và ba món không được, căn cứ trên nhơn quả và nghiệp báo của chúng sanh đối với hóa độ của Đức Phật. Ngài Nguyên Phong Thiền Sư nhận xét rằng : Phật là bậc vô lượng giác, lòng từ bi của Ngài dù trãi khắp thế giới chúng sanh, nhưng vẫn không vượt qua được chơn lý. Vì thế Phật có Tam năng tam bất năng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Nội", "definition": "Ba âm bên trong. Chỉ cho Hầu nội (cổ họng), Thiệt nội (lưỡi) và Thần nội (môi). Đây là tiếng dùng trong Tất Đàm học của Nhật Bản, tức là 3 cách phát âm tiếng Phạm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phong", "definition": "(1573-1635). Ngài họ Tô, hiệu là Hán Nguyệt, còn gọi là Pháp Tạng, hay Hán Nguyệt Pháp Tạng, quê ở huyện Vô-tích, tỉnh Giang-tô, là khai tổ của thiền phái Tam Phong, một chi phái của tông Lâm Tế thời nhà Minh. Ngài xuất gia năm 15 tuổi, rất ham thích học Thiền, nhân đọc Cao Phong Ngữ Lục có điểm nghi ngờ, bèn để tâm tham cứu. Trải hơn 10 năm, một hôm bỗng nghe tiếng cây tre gẫy mà hốt nhiên đại ngộ. Năm 52 tuổi ngài đến chùa Kim-túc tham yết thiền sư Mật Vân Viên Ngộ (1566-1642), được ấn khả phú pháp. Sau đó ngài khai pháp tòa ở thiền viện Tam-phong (núi Ngu-sơn, Tô-châu), được người đời xưng là Tam Phong Tạng Công. Ngài cũng cư trú tại nhiều chùa khác để hoằng pháp. Đương thời, tông Tào Động bài xích tông chỉ của “năm nhà”, chỉ đề xướng thuyết “tự tánh tự ngộ” do Truyền thuyết “niêm hoa vi tiếu” của đức Phật Thích Ca mà thôi. Nhân đó ngài liền soạn sách Ngũ Tông Nguyên để phản bác, trong đó nhấn mạnh, từ Phật Oai Âm Vương cho đến nay, không một lời, một pháp nào mà không phù hợp với tông chỉ của “năm nhà”. Sự việc này đã làm khơi dậy cuộc tranh luận sôi nổi một thời trong giới học Phật ở Trung-quốc. Ngài thị tịch năm 1635, thế thọ 62 tuổi.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tam Phong Phái", "definition": "Chi phái thuộc Tông Lâm Tế, hưng thịnh vào thời Minh, Thanh, Tổ khai sáng là ngài Hán Nguyệt Pháp Tạng (1573-1635), người huyện Vô tích, tỉnh Giang Tô, Trung Quốc.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phong Thanh Lương Thiền Tự", "definition": "三 峰 清 涼 禪 寺. Nằm trong núi Ngu Sơn, thành phố Thường Thục, tỉnh Giang Tô, Trung Quốc. Khoảng niên hiệu Vạn Lịch (1573-1619) đời Minh sáng lập, Hán Nguyệt Pháp Tạng khai sơn, xưa gọi là “Tam Phong Thiền Viện”. Niên hiệu Khang Hy thứ 38 (1699) đời Thanh ban tặng tấm biển “Tam Phong Thanh Lương Thiền Tự”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Phong Xuyên", "definition": "三 峰 川 (1710-1799). Thiền tăng đời Thanh, họ Lương, tên Di, tự Lễ Bỉnh, pháp danh Xuyên, hiệu Tam Phong, người xứ Thuận Đức, Quảng Đông, Trung Quốc. Nối pháp Thiền Sư Triện Ngọc, đời thứ 38 hệ Thanh Nguyên. Sư là một họa tăng nổi tiếng niên hiệu Càn Gia.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Pháp", "definition": "三法. Ba cơ quan tối cao của triều đình thời xưa, họp lại thành một thứ tòa án cao nhất để xét xử các vụ quan trọng, gồm bộ Hình, Đô sát viện và Đại lí tự. Thường là Tòa Tam pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Pháp Luân", "definition": "Gọi tắt: Tam Luân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Pháp Nhẫn", "definition": "Tisrah-ksantayah (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Pháp Thân", "definition": "Tam pháp thân là chỉ ba thể đạo pháp.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Pháp Triển Chuyển Nhân Quả Đồng Thời", "definition": "Chỉ cho 3 pháp: Chủng Tử Năng Sinh, Hiện Hành Năng Huân và Chủng Tử Sở Huân xoay vần, đắp đổi, đồng thời làm nhân làm quả lẫn nhau. Đây là tiếng dùng của Tông Duy Thức biểu thị sự quan hệ nhân quả giữa Chủng Tử và hiện hành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Pháp Độ Luận", "definition": "Tri-dharmika śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Pháp ấn", "definition": "三法印 (Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phát Nguyện", "definition": "Chỉ cho 3 nguyện đã phát, đang phát và sẽ phát nói trong Kinh A Di Đà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phát Tâm", "definition": "三發心 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phân", "definition": "三分. Chia làm ba phần. Lục Vân Tiên có câu: “Thương ông Gia Cát tài lành, gặp cơn Hán mạt chịu đành tam phân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Phân Biệt", "definition": "三分別 (A Tỳ Đạt Ma Tạp Tập Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phúc", "definition": "Chỉ cho 3 thứ tịnh nghiệp mà các hành giả Tịnh Độ tu để cầu vãng sinh Cực Lạc. Đây là chính nhân tịnh nghiệp của chư Phật 3 đời quá khứ, hiện tại, vị lai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phúc Bát Giảo", "definition": "Tam (3) chỉ cho ngày mùng 1 của các tháng 1, 5, 9; Bát (8) chỉ cho các ngày Bát vương: Lập xuân, Xuân phân, Lập hạ, Hạ chí, Lập thu, Thu phân, Lập đông, Đông chí. Vào 11 ngày này, các sứ giả của Chư Thiên Đế Thích và trăm vạn chúng thần, như Nhật Nguyệt quỉ thần, địa ngục Diêm La... đều tâu lại (phúc tấu) các việc thiện ác của chúng sinh trong 3 cõi và so sánh (tỉ giảo) xem có giống như những điều mà thiện thần của Tứ Thiên Vương đã tâu lại vào 6 ngày trai mỗi tháng hay không, xem xét kĩ những việc tội phúc của chúng sinh để tránh sự sai lầm oan uổng, rồi căn cứ vào tội phúc nhiều hay ít mà quyết định sống chết, thêm bớt tuổi thọ và phúc đức.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phương Tiện", "definition": "三方便 (Tịnh Danh Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phước", "definition": "Three kinds of blessings 三福", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Phước Nghiệp", "definition": "三福業 (Kinh Tăng Nhất A Hàm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phước Nghiệp Sự", "definition": "Trini-puṇya-kriya-vastuni (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Phước Điền", "definition": "三福田 (Ưu Bà Tắc Giới Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phược", "definition": "三縛 (Hoa Nghiêm Khổng Mục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phạm", "definition": "Trời Sơ Thiền trong Tứ Thiền Thiên cõi Sắc có 3 tầng trời là Phạm chúng, Phạm phụ và Đại Phạm, gọi chung là Tam phạm. Đại Phạm là vua, Phạm phụ là quan, Phạm chúng là dân. [X. Đại Nhật Kinh Nghĩa Thích Q.7; Chư Tôn Yếu Sao Q.12]. (xt. Đại Phạm Thiên).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phạt Nghiệp", "definition": "Trini-daṇḍani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Phần Khoa Kinh", "definition": "三分科經 (Pháp Hoa Kinh Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phẩm", "definition": "三品. Bậc quan thứ ba của trình đình thời xưa, gồm Chánh tam phẩm và Tòng tam phẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Phẩm Sa Di", "definition": "Chỉ cho 3 loại Sa Di, tức là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phẩm Thính Pháp", "definition": "Nghe kinh pháp có 3 Phẩm thượng, trung, hạ khác nhau, tức là: Thượng Phẩm dùng thần để nghe, Trung Phẩm dùng tâm để nghe, còn Hạ Phẩm thì dùng tai để nghe.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phẩm Tất Địa", "definition": "Tất Địa của người tu hành Mật Giáo có 3 Phẩm thượng, trung, hạ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phật Bồ Đề", "definition": "Khi thành Phật, Đức Thích Ca có giảng cho chúng đệ tử nghe về ba thể Bồ Đề của Ngài.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Phật Ngữ", "definition": "Cũng gọi Phật Tam ngữ, Tam Ý ngữ. Chỉ cho 3 thứ ý ngữ của Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phật Thân", "definition": "三佛身 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phật Tánh", "definition": "三佛性 (Hoa Nghiêm Khổng Mục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phật Tính", "definition": "I.Tam Phật Tính. Chỉ cho 3 nhân Phật Tính: Chính Nhân Phật Tính, Liễu Nhân Phật Tính, và Duyên Nhân Phật Tính, do ngài Trí Khải căn cứ vào Kinh Đại Bát Niết Bàn Q.28 (bản Bắc) mà lập ra. (xt. Tam Nhân Phật Tính, Phật Tính). II.Tam Phật Tính.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phật Tử", "definition": "三佛子 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Phật Đính", "definition": "Chỉ cho 3 Phật Đính trong Viện Thích Ca thuộc Mạn Đồ La Thai Tạng Giới của Mật Giáo, là đính biểu thị mọi đức của 3 bộ Như Lai.Phật Đính là Vô Kiến Đính Tướng của Như Lai, là tôn quí nhất trong các Đức Phật. Tam Phật Đính là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Phật Độ", "definition": "三佛度 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Quan", "definition": "San-kuan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Quan Ngữ", "definition": "三 關 語. Ba lời then chốt, ví như ba cửa ải. Thiền", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Quang", "definition": "三光. Ba thứ sáng, gồm mặt trời, mặt trăng và các ngôi sao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Quang Thiên Tử", "definition": "Chỉ cho 3 vị Thiên tử: Nhật Thiên Tử, Nguyệt Thiên Tử và Minh Tinh Thiên Tử. Trong Phẩm Tựa Kinh Pháp Hoa quyển 1 thì có: Danh Nguyệt Thiên Tử, Phổ Hương Thiên Tử, Bảo Quang Thiên Tử. Pháp Hoa Văn Cú quyển 2 hạ cho rằng 3 vị Thiên tử Danh nguyệt... là nội thần của trời Đế Thích, giống như các khanh tướng. Còn Pháp Hoa Kinh Huyền Tán quyển 2, phần đầu thì cho rằng Tam Quang là chỉ cho 3 vị: Bảo Quang, Danh nguyệt và Phổ hương. Quán Thế Âm tên là Bảo Ý, là Nhật Thiên Tử, tức Bảo Quang; Đại Thế Chí tên là Bảo cát tường, là Nguyệt Thiên Tử, tức Danh nguyệt; Hư Không Tạng tên là Bảo Quang, là Tinh thiên tử, tức Phổ hương. Đây là phối hợp Nhật, Nguyệt, Tinh với 3 vị Thiên Tử trong Kinh Pháp Hoa, nhưng Kinh Pháp Hoa bản tiếng Phạm ở đoạn văn kinh tương ứng đồng thời nêu tên 5 vị Thiên Tử, Nguyệt Thiên Tử (Candra devaputra), Nhật Thiên Tử (Sùrya deva-putra), Phổ Hương Thiên Tử (Samantagandha deva-putra), Bảo Quang Thiên Tử (Ratnapsabha deva-putra), và Quang minh thiên tử (Avabhàsaprabha devaputra). Ngoài ra, theo Học hải dư trích quyển 4, khi người thợ làm tượng Phật tạo tượng Tam quang thì tượng Đại Minh Tinh Thiên Tử có hình tướng Bồ Tát, còn Nhật Thiên Tử và Nguyệt Thiên Tử thì theo hình tướng người trời.Nếu y theo Bản Môn của Tam quang thì đều có hình tướng Bồ Tát, còn theo Tích Môn thì đều lấy hình người trời, tức dùng cả Bản và Tích để tạo thành hình tượng Tam quang. [X. Kinh Hư Không Bồ Tát Thần Chú; Kinh Thất Phật Bát Bồ Tát Sở Thuyết Đại Đà La Ni Thần Chú Q.1; Pháp Hoa Nghĩa Sớ Q.1].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Qui", "definition": "Xem Qui Y Tam Bảo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Qui - Tam Qui Y", "definition": "Ba Nơi Quay Về Nương Tựa. Sở dĩ có sự quay về là vì từ trước chúng ta đã bị bao nhiêu thứ mê hoặc làm cho sai đường, lạc lối. Chúng ta đã quen nếp sống quên lãng, tâm trí cứ luôn bị níu kéo về những hình ảnh quá khứ hoặc buông trôi theo những ảo tưởng tương lai. Vì vậy, “quay về” có nghĩa là Ý Thức phải được thắp sáng, từ bỏ nếp sống buông trôi, quên lãng, để sống trong tỉnh thức, nhìn rõ chân lí của thực tại vạn hữu. Muốn quay về thì phải có chỗ để quay về; và cái chỗ để quay về đó cũng đồng thời là nơi cho chúng ta nương tựa để sống. Có ba căn cứ vô cùng vững chắc để cho chúng ta quay về và nương tựa: đó là Ba Ngôi Báu (Tam Bảo) vừa được trình bày ở trên.", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Qui Y", "definition": "Triśaraṇa-gamāna (S), Ti- saranāgamāna (P), Tisaraṇa (P), Triśaraṇa (S), Three refuges.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Quy", "definition": "三皈. Tiếng nhà Phật, chỉ ba thứ quy y, gồm quy y Phật, quy y Pháp, quy y Tăng. Chỉ sự đi tu. Đoạn trường tân thanh có câu: “Đưa nàng đến trước phật đường, Tam quy ngũ giới cho nàng xuất gia”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Quy Y", "definition": "三歸依 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Quyết Định Nghiệp", "definition": "Cũng gọi Tam Thời Nghiệp, Tam Báo Nghiệp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quyền", "definition": "三權. Ba quyền lớn thuộc về toàn dân, trong quốc gia dân chủ, gồm quyền Lập pháp, quyền Hành pháp và quyền Tư pháp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Quyền Nhất Thực", "definition": "Ba giả tạm, một chân thực. Chỉ cho 4 giáo Hóa Pháp của Tông Thiên Thai.Trong 4 giáo thì 3 giáo Tạng, Thông, Biệt là giáo pháp phương tiện tạm thời lập ra chứ chưa phải là giáo pháp liễu nghĩa, cho nên gọi là Tam quyền; trái lại, Viên Giáo là giáo pháp chân thật liễu nghĩa, nên gọi là Nhất thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quán", "definition": "I.Tam Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quân", "definition": "三君. Ba toán quân trong đoàn quân lớn, sắp theo thứ tự trước sau, gồm Tiền quân, Trung quân và Hậu quân. Chỉ toàn thể quân lính.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Quĩ", "definition": "I.Tam Quĩ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quốc", "definition": "三國. Ba nước Nguỵ, Ngô, Thục hồi cuối đời Hán ở Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Quốc Di Sự", "definition": "Tác phẩm, 5 quyển, do vị tăng người Cao Li là Nhất Thiên (1206-1289) soạn, được thu vào Đại Chính Tạng tập 49.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quốc Phật Pháp Truyền Thông Duyên Khởi", "definition": "Tác phẩm 3 quyển, do ngài Ngưng Nhiên, người Nhật Bản soạn vào năm 1311.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quốc Truyện Kí", "definition": "Tác phẩm, 12 quyển, do ngài Huyền đống, người Nhật Bản soạn, được thu vào Đại Nhật Bản Phật Giáo Toàn Thư quyển 148.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Quỹ Hoằng Kinh", "definition": "三軌弘經 (Pháp Hoa Kinh và Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Sanh", "definition": "三生 (Hoa Nghiêm Kinh Tuỳ sở Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Sao Thất Bản", "definition": "三抄失本. Ba lần chép lại thì đã làm mất hết cả gốc, ý nói mỗi lần chép lại là mỗi lần sai đi Có người lại cho rằng Tam sao thất bản 三抄七本, nghĩa là có ba bản sao thì có tới bảy bản chính, chẳng biết tin vào bản nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Sinh", "definition": "Trijāti (S), Tijāti (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Sinh Chứng Đạo", "definition": "Thuyết “Ba đời chứng đạo” . Thuyết “ba đời chứng đạo” cũng tức là thuyết “ba đời thành Phật” (tam sinh thành Phật) do ngài Trí Nghiễm (602-668), tổ thứ hai của tông Hoa Nghiêm, đề xướng đầu tiên, và sau đó được ngài Pháp Tạng (613-712), tổ thứ ba của tông Hoa Nghiêm, tập đại thành (nhưng tác giả trình bày có khác chút ít). Thuyết này chủ trương hành giả tu tập trải qua ba đời có thể thành Phật. Ba đời gồm có:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tam Sinh Lục Thập Kiếp", "definition": "Ba đời sáu mươi kiếp. Đây là thời gian mà người tu Thanh Văn Thừa phải trải qua. Tức là tu quán 16 hành tướng của Tứ Đế, dứt hết phiền não trong 3 cõi, chứng được quả A La Hán thì nhanh nhất là 3 đời, mà chậm nhất là 60 kiếp. Trong 3 đời thì đời thứ nhất là tính tập tư lương Ngũ Đình Tâm và Tổng, Biệt niệm trụ... gieo trồng căn lành thuận với Giải Thoát Phần, đời thứ hai thì nương vào định Vị chí mà phát khởi trí tuệ thuận với Quyết Trạch Phần, đời thứ ba nương vào định Căn bản, một lần nữa, phát khởi trí tuệ thuận với Quyết Trạch Phần để vào Kiến Đạo. Cũng có thuyết cho rằng đời thứ ba mới phát khởi trí tuệ thuận với Quyết Trạch Phần.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Sinh Thành Phật", "definition": "Gọi tắt: Tam Sinh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Sám", "definition": "三懺 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Sĩ Giáo", "definition": "Tạng: Skyes-bu gsum. Cũng gọi Tam Sĩ Phu Đạo, Tam Trượng Phu Đạo Luận.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Sơn", "definition": "三山. Ba từng, ba đợt, giống như ba ngọn núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Sơn Đăng Lai", "definition": "(三山燈來, Sanzan Tōrai, 1614-1685): vị tăng của Lâm Tế Tông Trung Quốc, tự là Vi Độ (葦度), hiệu Tam Sơn (三山), xuất thân Điếm Giang (墊江), Trùng Khánh (重慶, Tỉnh Tứ Xuyên), họ là Tằng (曾). Đi thi cử không đỗ, ông chuyên tâm nghiên cứu Thiền học, đọc say sưa bộ Cổ Âm Lục (古音錄) cũng như Bình Sơn Lục (平山錄) của Tụ Tuyết Xuy Phương Quảng Chơn (聚雪吹風廣眞) và muốn trở thành con cháu của Tụ Tuyết. Vào năm thứ 6 (1643) niên hiệu Sùng Trinh (崇禎), lúc 30 tuổi, ông theo xuất gia với Nam Triết Nhị (南浙二) ở Phí Nham Sơn (弔嵓山). Năm sau, ông đến trú tại Đông Minh Tự (東明寺) ở Trung Châu (忠州, Tỉnh Tứ Xuyên), rồi chuyển đến Thạch Phong (石峰), tham bái Khánh Trung Thiết Bích Huệ Cơ (慶忠鐵壁慧機), nhưng chẳng khế ngộ, nên ông quay về đất Thục. Đến năm thứ 5 (1648) niên hiệu Thuận Trị (順治), lúc 35 tuổi, ông trở về tham yết Huệ Cơ lần thứ hai. Vào năm thứ 11 (1654) cùng niên hiệu trên, ông viếng thăm Huệ Cơ ở Trung Nam Ngọc Ấn Sơn (忠南玉印山), kế thừa dòng pháp của vị này và đến trú tại Sùng Thánh Viện (崇聖院), Trung Châu. Sau đó, ông đã từng sống qua một số nơi khác như Hưng Long Viện (興龍院), Ngũ Vân Viện (五雲院) và Ngũ Vân Bổn Viện (五雲本院) ở Huyện Lương Sơn (梁山縣), Phủ Quỳ Châu (夔州府, Tỉnh Tứ Xuyên), Bàn Thạch Sơn Đàm Hoa Viện (磐石山曇華院) ở Huyện Vân Dương (雲陽縣), Phủ Quỳ Châu, Thiên Ninh Viện (天寧院) ở Phủ Gia Hưng (嘉興府, Tỉnh Triết Giang). Vào ngày 18 tháng 7 năm thứ 24 (1685) niên hiệu Khang Hy (康熙), ông thị tịch, hưởng thọ 72 tuổi đời và 43 hạ lạp. Tác phẩm của ông để lại có Tam Sơn Lai Thiền Sư Ngữ Lục (三山來禪師語錄) 16 quyển, Ngũ Gia Tông Chỉ Toản Yếu (五家宗旨纂要) 3 quyển, Cao Phong Tam Sơn Thiền Sư Sớ Ngữ (高峰三山禪師疏語) 3 quyển. Bên cạnh đó, ông có bản tự thuật về hành trạng và Tánh Thống (性統) soạn bản Niên Phổ.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Sư", "definition": "Cg, tam sư thất chứng. Theo giới luật nhà Phật, muốn truyền giới Tỳ kheo, phải tổ chức giới đàn. Và chủ trì giới đàn có ba vị sư là:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Sư Thất Chứng", "definition": "Cũng gọi Thập Sư, Thập Tăng. Tam Sư là 3 vị thầy, Thất chứng là 7 vị chứng minh. Chỉ cho số Giới Sư phải có đủ trong giới tràng khi truyền giới Cụ Túc cho Tỉ Khưu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Sắc", "definition": "三色. Ba màu xanh, trắng, đỏ. Chỉ lá cờ của nước Pháp. Văn tế sĩ dân lục tỉnh của Nguyễn Đình Chiểu có câu: “Mấy nơi tổng lí xã thôn, đều mắc hại cùng cờ tam sắc”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Sở Y", "definition": "Cũng gọi Tam Chủng Sở Y.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Sự Giới", "definition": "三事戒 (Đại Bảo Tích Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Sự Nhân Thắng Chư Thiên", "definition": "三事人勝諸天 (Đại Tỳ Bà Sa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Sự Tính Tướng", "definition": "Xem Tam Tính.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Sự Vô Tận", "definition": "三事無尽 (Chúng Đức Tam Muội Kinh. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tai", "definition": "三災. Ba loại sự việc không may lớn lao xảy tới, gồm hoả tai (cháy nhà), phong tai (bão) và thuỷ tai (nước lụt).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tam Muội", "definition": "三三昧 (Thành Thật Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tam Pháp Môn", "definition": "Cũng gọi Lục Tam Phân Biệt, Lục Chủng Tam Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thai", "definition": "三台. Như Tam công 三公.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thanh", "definition": "San-ch'ing (C), Three Pure Ones Sanqing (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thanh Tịnh Tâm", "definition": "Cũng gọi Tam Chủng Tùy Thuận Bồ Đề Môn Pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên", "definition": "三遷. Ba lần dời chỗ ở, chỉ sự giáo dục con cái cẩn thận, bằng cách lựa chọn hoàn cảnh bên ngoài. Do điền bà mẹ thầy Mạnh Tử dọn nhà ba lần, cho thầy Mạnh Tử có được hoàn cảnh xung quanh tốt đẹp mà học tập.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thiên Chư Pháp", "definition": "Cũng gọi Tam Thiên, Tam Thiên Thế Gian. Ba nghìn các pháp. Tiếng dùng của Tông Thiên Thai, bao quát hết thảy muôn pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên Lý Ngoại", "definition": "三 千 里 外. Ngoài ba ngàn dặm. Ý nói lìa xa thiền pháp đâu chỉ có ba ngàn dặm. Đây là lời chê trách mà các thiền sư thường dùng. Tiết Dược Sơn Hòa Thượng trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Thiên Phật", "definition": "Cũng gọi Tam Kiếp Tam Thiên Phật, Tam Thế Tam Thiên Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên Phật Danh Kinh", "definition": "(三千佛名經), gọi đủ là Tam Kiếp Tam Thiên Phật Danh Kinh (三劫三千佛名經), thâu lục vào Taishō với 3 quyển riêng biệt là Quá Khứ Trang Nghiêm Kiếp Thiên Phật Danh Kinh (過去莊嚴劫千佛名經, No. 446a, thất dịch) 1 quyển; Hiện Tại Hiền Kiếp Thiên Phật Danh Kinh (現在賢劫千佛名經, No. 447a, thất dịch), 1 quyển; Vị Lai Tinh Tú Kiếp Thiên Phật Danh Kinh (未來星宿劫千佛名經, No. 448a, thất dịch), 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Thiên Thế Giới", "definition": "三 千世界 (Trường A Hàm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thiên Thế Giới – Tam Thiên Đại Thiên Thế Giới", "definition": "3.000 Đại Thiên Thế Giới. Nói đến “đại thiên thế giới” thì lấy “tiểu thế giới” làm đơn vị căn bản để tính. Một tiểu thế giới là một hệ thống thế giới gồm có: ở trung ương là núi Tu Di, xuyên suốt qua biển lớn, đứng sừng sững trên địa luân. Dưới địa luân là kim luân. Dưới nữa là thủy luân. Dưới thủy luân là phong luân. Bên ngoài phong luân thuộc về hư không.", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Thiên Trần Điểm Kiếp", "definition": "Ba nghìn kiếp chấm mực. Đây là số kiếp ví dụ thời gian lâu xa kể từ khi Đức Phật Đại Thông Trí Thắng diệt độ đến nay trong Phẩm Hóa Thành Dụ Kinh Pháp Hoa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên Tứ Tiên", "definition": "Ba trời bốn tiên. Tức thuyết của ngoại đạo Ấn Độ. Ba trời là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên Uy Nghi Bát Vạn Tế Hạnh", "definition": "Ba nghìn uy nghi tám vạn tế hạnh của Tỉ Khưu phải ứng xử hàng ngày.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên Viên", "definition": "Môn Tích của Tông Thiên Thai.Nhật Bản, tọa lạc tại khu Tả kinh ở Kyoto.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiên Đại Thiên Thế Giới", "definition": "Trois mille mondes one billion worlds 三千大千世界 Tri-sāhasra-mahā-sāhasra-loka-dhātu", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Thiếp Hòa Tán", "definition": "Từ ngữ gọi chung ba bộ hòa tán. Tịnh Độ, Cao Tăng và Chính Tượng Mạt, do ngài Thân Loan người Nhật Bản soạn. Lúc về già, vì muốn cho giáo nghĩa căn bản của Chân Tông dễ hiểu hơn, nên ngài Thân Loan đã soạn ra các hòa tán này và, cùng với “Chính Tín Kệ”, các hòa tán này đều được đọc tụng trong các khóa lễ sớm chiều tại các chùa viện Nhật Bản. Tịnh Độ hòa tán gồm 118 bài kệ, khen ngợi Đức Phật A Di Đà, Tam kinh(Kinh Vô Lượng Thọ, Kinh Quán Vô Lượng Thọ và Kinh A Di Đà), lợi ích đời hiện tại...; Cao Tăng Hòa Tán gồm 117 bài kệ, khen ngợi 7 vị cao tăng (Long Thụ, Thiên Thân, Đàm Loan, Đạo Xước, Thiện Đạo, Nguyên Tín và Nguyên Không); Chính Tượng Mạt Hòa Tán gồm 108 bài kệ, nói về Chính Tượng Mạt Tịnh Độ, Nghi Hoặc, Thánh Đức Phụng Tán, Thuật Hoài... Ngoài ra còn có Thiếp ngoại hòa tán, có phụ thêm “Tự nhiên pháp nhĩ chương” bằng tiếng Nhật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thiền", "definition": "Trititya-dhyāna (S), Tṛtiya-dhyāna (S), Tatiya-jhāna (P), Tatiya-jhāna (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thiền Thiên", "definition": "Third meditation heaven 三禪天 Tri-dhyāna", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Thiền Thiên Định Chi Công Đức", "definition": "三禪天定五支功德 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thiện", "definition": "三善 (Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thiện Căn", "definition": "三善根 (A Tỳ Đạt Ma Tập Dị Môn Túc Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thiện Tri Thức", "definition": "三善知識 (Chỉ Quán)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thiện Đạo", "definition": "三善道 (Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thoái", "definition": "Ba thứ lui mất. Tức sự lui mất công đức của hàng Thanh Văn, Duyên Giác và Phật có 3 loại như sau:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thoái Khuất", "definition": "Cũng gọi Tam Chủng Thoái Khuất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thuyết Thanh", "definition": "Cũng gọi Tam Sĩ. Chỉ cho 3 ngôi trong văn pháp tiếng Phạm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thuật", "definition": "Gọi đủ: Nội Ngoại Tam Thuật. Chỉ cho 3 phương pháp trong, ngoài được Tông Thiên Thai sử dụng để trừ khử ma chướng trong lúc tu thiền quán. Nghĩa là hành giả khi tu xong pháp quán thứ 8 “Tri thứ vị”, thường dễ bị nhiễu loạn bởi nghịch duyên bên trong (giặc cứng mạnh) và thuận duyên bên ngoài(giặc dịu dàng), đến nỗi tổn hại nội đức, rước lấy danh lợi mà tự phá hoại mình. Vì mục đích ngăn chặn 2 chướng duyên thuận và nghịch này để đạt đến cảnh giới an nhẫn bất động, cho nên dùng Nội Ngoại Tam Thuật lần lượt đối trị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thái", "definition": "三態. Ba thể của các vật, gồm thể rắn, thể lỏng và thể hơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thánh", "definition": "- Hoa Nghiêm Tam Thánh: Phật Thích Ca (Tỳ Lô Giá Na) ở giữa, bên hữu là ngài Phổ Hiền, bên trái là ngài Văn Thù.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thánh Huệ Nhiên", "definition": "San sheng Hui jen (C), Sansho Yenen (J), Sansho Enen (J), San-sheng Hui-jan (C), Sansheng Huiran (C), Sanshō Enen (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thánh Kim Lân", "definition": "Cũng gọi Tam Thánh Thấu Võng Kim Ngư, Tam Thánh Dĩ Hà Vi Thực.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thánh Viên Dung Quán", "definition": "Pháp quán của Tông Hoa Nghiêm, tức quán tưởng Đức Phật Tì Lô Giá Na và 2 vị Bồ Tát Phổ Hiền và Văn Thù dung hòa làm 1 thể không ngăn ngại.Trong đó, Phật Tì Lô Giá Na là thể chung của tất cả mọi đức, tượng trưng cho quả phần bất khả thuyết, còn 2 vị Bồ Tát Phổ Hiền và Văn Thù là đức riêng của Phật Tì Lô Giá Na, tượng trưng cho nhân phần khả thuyết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thân", "definition": "三身 (Kim Quang Minh Kinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thân Biến Tướng", "definition": "三身徧相 (Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thân Hoa Phạm", "definition": "三身華梵 (Pháp Hoa Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thân Phật", "definition": "Tam thân Phật là ba thân của chư Phật. Ba thân Phật Kinh luận có nhiều thuyết, chỗ hợp lại chỉ nói hai thân, chỗ phân ra ba thân, chỗ nói bốn thân, 10 thân khai hợp sai biệt không đồng, nhưng thuyết Tam thân phổ biến hơn hết trong các Kinh luận. Tam thân sau đây là căn cứ theo Duy Thức luận :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thân Tam Đức", "definition": "Tam thân là Pháp Thân, Báo Thân và Ứng Thân; Tam đức là Pháp Thân đức, Bát Nhã đức và Giải thoát đức. Nếu Tam thân và Tam đức được phối hợp với nhau, thì Pháp Thân là đức của Pháp Thân, Báo Thân là đức của Bát Nhã, Ứng Thân là đức của Giải thoát. (xt. Tam Thân, Tam Đức).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thân Thọ Lượng", "definition": "三身寿量 (Pháp Hoa Kinh Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thì Giáo", "definition": "Tam thì giáo là ba thời kỳ dạy đạo của Đức Phật, bao gồm như sau :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thì Pháp", "definition": "Tam thì pháp còn gọi là Tam thì, nghĩa là Phật Pháp trãi qua ba thời kỳ, ba giai đoạn :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thí", "definition": "三施 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thính", "definition": "三聽. Nghe xử án ba lần, luật lệ đời Chu, gồm sơ thẩm, tái thẩm và chung thẩm Nghe đi nghe lại kĩ càng nhiều lần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thô Trọng", "definition": "Ba to nặng. Tức chỉ cho 3 thứ tập khí thô to, nặng nề mà người tu hành phải lần lượt đoạn trừ trong 3 A Tăng Kì Kiếp. Ba thứ tập khí này là hạt giống của Phiền Não Chướng và Sở Tri Chướng, cho nên cũng gọi là Tam Chướng, Tam Phiền Não.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thông", "definition": "Tevijjā (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thông Lực", "definition": "三通力 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thú Độ Hà", "definition": "三獸渡河 (Thiên Thai Tứ Giáo Nghi và Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thường", "definition": "Chỉ cho 3 thứ thường trụ của thân Phật. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thảo", "definition": "三草 (Pháp Hoa Kinh Văn Cú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thảo Nhị Mộc", "definition": "Dùng cây cỏ lớn, nhỏ để ví dụ các căn tính khác nhau. Tam thảo là cỏ thuốc nhỏ, cỏ thuốc vừa và cỏ thuốc lớn. Nhị mộc là cây nhỏ và cây to.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thần Lực", "definition": "Three supernatural powers.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Bổng", "definition": "Ba mươi gậy. Dùng gậy đánh là 1 trong những phương pháp mà các Thiền Sư sử dụng để tiếp hóa và khai thị người học. Trong Thiền Lâm có những từ ngữ như: “Đức Sơn bổng” (gậy của Đức Sơn), “Lâm Tế hát” (tiếng hét của Lâm Tế), nghĩa là Thiền Sư Đức Sơn thường dùng cơ pháp “đánh” và Thiền Sư Lâm Tế thường dùng cơ pháp “hét” để chỉ dẫn và khai ngộ người học. Mục Khám Biện trong Lâm Tế Lục (Đại 47, 503 hạ) ghi: “Sư nghe ngài Đức Sơn đời thứ 2 chỉ dạy rằng: Nói được cũng lãnh 30 gậy, nói không được cũng lãnh 30 gậy!”.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Chủng Ngoại Đạo", "definition": "Ba mươi thứ ngoại đạo. Tức 30 loại ngoại đạo được liệt kê trong Phẩm Nhập Chân Ngôn môn trụ tâm Kinh Đại Nhật quyển 1.Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Duy Thức", "definition": "Xem Duy Thức Tam Thập Luận Tụng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Lục Bộ", "definition": "(三十六部): 36 bộ quỷ thần, 36 loại thân hình Ngạ Quỷ. Trong Phật Thuyết Thí Ngạ Quỷ Cam Lồ Vị Đại Đà La Ni Kinh (佛說施餓鬼甘露味大陀羅尼經, Taishō No. 1321) có đề cập đến một số thân Ngạ Quỷ do ác nghiệp mà phải chịu quả báo thân hình như vậy: Bế Lệ Đa Quỷ (薜荔多鬼, Tàu gọi là Ngạ Quỷ [餓鬼, quỷ đói]), Xa Da Quỷ (車耶鬼, Tàu gọi là Ảnh Quỷ [影鬼, quỷ bóng]), Kiện Đà Quỷ (健駄鬼, Tàu gọi là Thực Hương Quỷ [食香鬼, quỷ ăn mùi hương]), Bố Sắt Ba Quỷ (布瑟波鬼, Tàu gọi là Thực Hoa Ngạ Quỷ [食花餓鬼, quỷ đói ăn hoa]), Kệ Bà Da Quỷ (偈婆耶鬼, Tàu gọi là Thai Tàng Quỷ [胎藏鬼, quỷ nằm trong bào thai]), A Thâu Già Quỷ (阿輸遮鬼, Tàu gọi là Bất Tịnh Quỷ [不淨鬼, quỷ bất tịnh]), Bà Đa Quỷ (婆哆鬼, Tàu gọi là Thực Phong Quỷ [食風鬼, quỷ ăn gió]), Ô Đà Ha La Quỷ (烏駄訶羅鬼, còn gọi là Thực Tinh Khí Quỷ [食精氣鬼, quỷ ăn tinh khí]), Đà La Chất Đa Quỷ (駄羅質多鬼, còn gọi là Sân Tất Tâm Quỷ [嗔悉心鬼, quỷ thường nỗi tâm giận dữ]), Chất Đa Quỷ (質多鬼, hay Ác Tâm Quỷ [惡心鬼, quỷ có tâm ác]), Bà Rô Da Quỷ (皤嚕耶鬼, hay Thực Tế Tự Quỷ [食祭祀鬼, quỷ ăn các đồ cúng tế]), Thị Vĩ Đa Quỷ (視尾哆鬼, hay Thực Nhân Thọ Mạng Quỷ [食人壽命鬼, quỷ ăn thịt người có tuổi thọ]), Tỳ Sa Kê Đà Quỷ (芑莎鷄駄鬼, hay Thực Nhục Thực Chỉ Đẳng Quỷ [食肉食脂等鬼, quỷ ăn thịt ăn mỡ, v.v.]), Xà Để Quỷ (蛇底鬼, hay Thực Sơ Sản Tử Quỷ [食初産子鬼, quỷ ăn thịt con nít sơ sinh]), Yết Tra Bố Đơn Na Quỷ (羯吒布單那鬼, hay Kì Xú Quỷ [希臭鬼, quỷ thân hình có mùi hôi thối như xương cháy]), Cưu Bàn Trà Quỷ (鳩盤茶鬼, hay Thủ Cung Quỷ [守宮鬼, quỷ bảo vệ cung điện]), Tất Xá Già Quỷ (畢舍遮鬼, hay Xí Thần [廁神, thần bảo vệ nhà xí, chuyên ăn những đồ bất tịnh]), v.v. Theo Pháp Uyển Châu Lâm (法苑珠林, Taishō No. 2122) quyển 6, phần Liệt Số Bộ (列數部) thứ 4 có liệt kê rất rõ 36 loại như sau:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Thập Lục Bộ Quỷ Vương", "definition": "(三十六部鬼王): 36 vị Quỷ Vương. Trong Chánh Pháp Niệm Xứ Kinh (正法念處經, Taishō Vol. 17, No. 721) quyển 16, Phẩm Ngạ Quỷ (餓鬼品) cũng như Pháp Uyển Châu Lâm (法苑珠林, Taishō Vol. 53, No. 2122) quyển 6, phần Liệt Số Bộ (列數部) thứ 4 có nêu rõ tên 36 loại Ngạ Quỷ, nhưng tên gọi có khác. Đặc biệt, Pháp Uyển Châu Lâm quyển 6 nêu rõ từng nguyên nhân vì sao bị đọa làm thân quỷ của từng loại như vậy.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Thập Lục Bộ Thần Vương", "definition": "Cũng gọi Tam Thập Lục Thiện Thần.Chỉ cho 36 vị thiện thần theo truyền thuyết do trời Đế Thích sai xuống nhân gian để che chở cho loài người, đồng thời tiếp nhận Tam Qui của thiện nam, tín nữ. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Lục Cú", "definition": "Ba mươi sáu câu. Khi bàn về cảm ứng đạo giao, Pháp Hoa Kinh Huyền Nghĩa căn cứ vào sự tương xứng giữa Cơ và Ứng mà lập thành 36 câu. Cơ của chúng sinh tương ứng với Như Lai, đó là Cơ ứng; lí tính của chúng sinh và lí tính của Phật không khác nhau, nhưng ở chúng sinh thì lí ấy ẩn kín, còn ở Phật thì hiển hiện rõ ràng. Cơ và Ứng được dựa vào tính chẳng 1 chẳng khác ấy mà lập ra. Cơ được chia làm 4 loại: Cơ thầm kín, Cơ hiển hiện, Cơ vừa thầm kín vừa hiển hiện, Cơ chẳng phải thầm kín chẳng phải hiển hiện. Ứng cũng được chia làm 4 loại là Ứng thầm, Ứng hiển, Ứng vừa thầm vừa hiển, Ứng chẳng phải thầm chẳng phải hiển. Bốn cơ trên được phối với 4 ứng:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Lục Cầm", "definition": "Cũng gọi Tam Thập Lục Thời Thú, Tam Thập Lục Thú.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Lục Vật", "definition": "三十六物 (Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thập Lục Đối", "definition": "Cũng gọi Tam Khoa Tam Thập Lục Đối Pháp Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Ngũ Phật", "definition": "Ba mươi lăm Đức Phật thường trụ trong tất cả thế giới ở 10 phương. Theo Tam thập ngũ Phật danh lễ sám văn thì 35 Đức Phật gồm:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Nhất Sắc", "definition": "三十一色 (Phiên Dịch Dang Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thập Nhật Phật Danh", "definition": "Cũng gọi Tam Thập Phật Danh, Tam Thập Nhật Bí Phật. Danh hiệu Phật và 30 ngày. Nghĩa là 30 vị Phật, Bồ Tát được phối hợp với 30 ngày trong 1 tháng. Nghĩa này trong các kinh luận không thấy có, nhưng cứ theo Hư Đường Hòa Thượng Ngữ Lục quyển 10 thì do Thiền Sư Sư giới ở núi Ngũ Tổ soạn vào khoảng đời Ngũ Đại.Cách phối hợp ấy là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Nhị Khí", "definition": "Chỉ cho 32 pháp mà Bồ Tát thành tựu. Vì 32 pháp này được sử dụng để thành biện sự và lí nên gọi là Khí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Nhị Nghiệp", "definition": "Tam thập nhị nghiệp là 32 nghiệp ác bất thiện mà chúng sanh gây tạo. Vì thấy như vậy mà chư đại Bồ Tát tu tập 32 thiện nghiệp để phá trừ các nghiệp ác ấy cho chúng sanh, bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thập Nhị Thân", "definition": "1. Thân Phật", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thập Nhị Tướng", "definition": "32 Tướng Tốt Của Phật. Đây là 32 tướng quí mà người thường không có, chỉ có Chuyển luân thánh vương và thân ứng hóa của Phật mới có. Luận Đại Trí Độ liệt kê ba mươi hai tướng ấy như sau:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Thập Nhị Tướng Hảo", "definition": "Tam thập nhị tướng hảo là 32 tướng tốt của Đức Phật. Các nhà tướng số ở Ấn Độ nói rằng : 32 tướng quí là những tướng tốt các bậc Đại nhơn mới có, người có 32 tướng này ở tại gia thì làm chuyển luân Thánh Vương, xuất tu đạo thì thành bậc Vô Thượng, 32 tướng bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thập Nhị Ứng", "definition": "三十二應 (Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thập Niên Hậu", "definition": "三 十 年 後. Ba mươi năm sau. Ý nói lãnh ngộ thiền pháp còn phải đợi ba mươi năm nữa. Đây là lời chê trách mà các Thiền Sư thường dùng. Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Thập Tam Gian Đường", "definition": "Ngôi nhà 33 gian, một danh thắng của Phật Giáo Nhật Bản tại Kyoto. Vốn có tên là Viện Liên Hoa vương thuộc Tông Thiên Thai Nhật Bản. Vì trong viện được ngăn chia ra làm 33 gian nên gọi là Tam thập tam gian đường. Trong Đại đường khoảng 120m của viện này an trí 1001 pho tượng Quan Âm. Vào năm Trường khoan thứ 2 (1164), Thượng hoàng Hậu bạch hà sắc lệnh cho Bình thanh thịnh xây dựng viện này, phòng xá theo thứ tự đều nhau, đến niên hiệu Kiến Trường năm đầu (1249) thì bị thiêu hủy.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Tam Quá", "definition": "Tiếng dùng trong Nhân Minh.Chỉ cho 33 lỗi của 3 chi Tông (mệnh đề), Nhân (lí do) và Dụ (thí dụ) do Tân Nhân Minh thành lập. Trong đó, Tông gồm 9 lỗi, Nhân gồm 14 lỗi và Dụ gồm 10 lỗi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Tam Quán Âm", "definition": "Ba mươi ba Quán Âm. Tức chỉ cho 33 loại thân tướng mà Bồ Tát Quán Thế Âm thị hiện để hóa độ chúng sinh. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Tam Thiên", "definition": "Trāiyastrimśas (S), Tāvatiṁsa (P), Tridaśas (S), Heaven of Thirty-Three Gods, Thirty three realms of Gods.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Tam Thân", "definition": "Cũng gọi Tam Thập Tam Ứng Hóa Thân. Chỉ cho 33 loại hóa thân mà Bồ Tát Quán Thế Âm thị hiện trong Tam Muội để nhiếp thủ và làm lợi ích cho khắp cả chúng sinh. Ba mươi ba thân này được nói trong Phẩm Quán Thế Âm Bồ Tát phổ môn Kinh Pháp Hoa, thứ tự như sau:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Thiếp Sách Tử", "definition": "Cũng gọi Chân Pháp Văn Sách Tử Tam Thập Thiếp, Tam Thập Thiếp Sách Tử, Tam Thập Thiếp Thảo Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thập Thất Bồ Đề Phần Pháp", "definition": "Satta-tiṃsa-bodhipakkhiyā-dhammā (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Thất Giác Chi", "definition": "Xem Ba Mươi Bảy Phẩm Trợ Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Thất Phân Pháp", "definition": "Xem Ba Mươi Bảy Phẩm Trợ Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Thất Phẩm", "definition": "Xem Ba Mươi Bảy Phẩm Trợ Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Thất Phẩm Trợ Đạo", "definition": "Tam thập thất phẩm trợ đạo là 37 phẩm Trợ đạo. Cũng viết : Tam thập thất phẩm, Tam thập thất Bồ Đề thần pháp, Tam thập thất trợ Bồ Đề pháp, Tam thập thất trợ đạo chi pháp, Ba mươi bảy phẩm Trợ đạo bao gồm như sau : Tứ niệm xứ, Tứ chánh cần, Tứ như ý túc, Ngũ căn, Ngũ lực, Thất Bồ Đề phần, Bát chánh đạo, hợp lại thành 37 phẩm trợ đạo (những pháp số này đã giải rõ trong các chương )", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thập Thất Trợ Bồ Đề Pháp", "definition": "Xem Ba Mươi Bảy Phẩm Trợ Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Thất Trợ Đạo Chi Pháp", "definition": "Xem Ba Mươi Bảy Phẩm Trợ Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thập Thất Trợ Đạo Chi Pháp.", "definition": "Xem Ba Mươi Bảy Phẩm Trợ Đạo.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thập Thất Trợ Đạo Phẩm", "definition": "37 Phẩm Trợ Đạo. Đây là 37 yếu tố làm trợ lực lớn cho hành giả trên đường tu tập cho đến khi đạt được đạo quả giác ngộ. Hay nói chính xác hơn, “37 phẩm trợ đạo” chính là 37 pháp môn tu tập căn bản của đạo Phật. Ba tháng trước ngày nhập Niết Bàn, chính đức Thế Tôn đã tuyên bố: “Các vị khất sĩ! Những giáo pháp mà Như Lai đã truyền đạt lại tuy nhiều, nhưng có thể được tóm tắt trong các pháp môn như Tứ niệm xứ, Tứ chánh cần, Tứ như ý túc, Ngũ căn, Ngũ lực, Thất giác chi, và Bát chánh đạo. Các vị phải khéo léo học hỏi, tu tập, thực chứng, và truyền đạt lại những pháp môn ấy. ” Chúng cũng chính là nội dung của Sự Thật Thứ Tư (Đạo Đế) của giáo lí Bốn Sự Thật (tứ đế). 37 pháp môn này gồm trong 7 pháp số sau đây:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Thập Thất Đạo Phẩm", "definition": "三十七道品 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thập Tứ Tâm Đoạn Kết", "definition": "三十四心斷結 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thập Tứ Tâm Đoạn Kết Thành Đạo", "definition": "Gọi tắt: Tam Thập Tứ Tâm. Tức dùng 34 thứ tâm sát na dứt hết phiền não để thành tựu Phật đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thắng Học", "definition": "三勝学 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thắng Nghĩa", "definition": "Ba thứ nghĩa thù thắng. Tông Pháp Tướng chia Chân Đế Làm Nghĩa Thắng Nghĩa, Đắc Thắng Nghĩa, Chính Hành Thắng Nghĩa. Vì 3 nghĩa này lìa lời nói, siêu việt cácpháptướng, cho nên gọi là Thắng Nghĩa, cũng gọi Đệ nhất nghĩa, hoặc Chân Đế, đối lại với Tục Đế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thặng", "definition": "三乘. Ba cỗ xe, tiếng nhà Phật, chỉ ba phương cách tu đạo, gồm Bồ tát thặng, Bích chi thặng và Thanh văn thặng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thế", "definition": "三世 (A Tỳ Đạt Ma Dị Môn Túc Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thế Bất Khả Đắc", "definition": "Ba đời không có thực thể. Tức là các loại sự vật trong 3 đời quá khứ, hiện tại, vị lai, không có 1 sự tồn tại nào có thực thể,cho nên gọi là bất khả đắc. [X. Phẩm Đệ tử Kinh Duy Ma Cật; Kinh Kim Cương]. (xt. Tam Thế).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Chư Phật", "definition": "Cũng gọi Nhất Thiết Chư Phật, Thập Phương Phật, Tam Thế Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Gian", "definition": "Gọi đủ: Tam Chủng Thế Gian.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Gian Chinh Phục Thế Tự Tại Thành Tựu Pháp", "definition": "Tralokya-vaśaṃkara-lokesvara-sadhana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thế Giác Mẫu", "definition": "Tên khác của Bồ Tát Văn Thù. Văn Thù đứng đầu về trí tuệ của các Đức Như Lai, trí tuệ lại là nguồn gốc giác ngộ của chư Phật 3 đời, vì vậy gọi là Tam Thế Giác Mẫu (mẹ của sự giác ngộ trong 3 đời). (xt. Văn Thù Bồ Tát).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Lưỡng Trùng Nhân Quả", "definition": "Các bộ phái Phật giáo đều phân chia 12 chi nhân duyên thành hai lớp nhân quả liên hệ đến ba đời, quá khứ, hiện tại và tương lai. Trong đó, Vô Minh và Hành là hai chi nguyên nhân của đời quá khứ; Thức, Danh Sắc, Lục Xứ, Xúc, Thọ là năm chi kết quả của đời hiện tại. Đây là lớp nhân quả thứ nhất, nhân quá khứ, quả hiện tại. Tiếp theo, Ái, Thủ, Hữu là ba chi  nguyên nhân của đời hiện tại; cuối cùng, Sanh, Lão tử là hai chi kết quả của đời vị lai. Đây là lớp nhân quả thứ hai, nhân hiện tại, quả tương lai. Như vậy, thuyết Tam thế lưỡng trùng nhân quả giải thích:", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Thế Nghiệp", "definition": "三世業 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thế Nhân Quả", "definition": "Nhân Quả ba đời.Tức lí nhân quả nghiệp cảm được thành lập suốt trong ba đời quá khứ, hiện tại và vị lai.Bởi vì nghiệp tạo ra ở đời quá khứ là nhân, chiêu cảm quả ở hiện tại; rồi lại do nghiệp được tạo ở hiện tại làm nhân, chiêu cảm quả ở vị lai.Cứ như thế nhân quả nối nhau, sinh tử vô cùng, đó chính là tướng trạng lưu chuyển trong thế giới mê vọng. Bởi vậy, Thuyết Nhất Thiết Hữu Bộ đã dùng thuyết “Nhân Quả Tam Thế Lưỡng Trùng” để giải thích 12 nhân duyên, tức cho rằng “Vô Minh, Hành” là nhân quá khứ chiêu cảm 5 quả ở hiện tại là “thức, danh sắc, lục xứ, xúc, thụ”, lại lấy “ái, thủ, hữu” làm 3 nhân ở hiện tại chiêu cảm 2 quả “sinh, lão tử” ở vị lai.Đối với các tông giáo khác vốn chỉ bàn về 1 đời hiện tại, hoặc 2 đời hiện tại và vị lai, thuyết Tam Thế Nhân Quả này thực là 1 đặc sắc lớn của giáo lí Phật Giáo. [X. Kinh Niết Bàn Q.33 (bản Nam); Kinh Vô Lượng Thọ Q.hạ; Luận Đại Tì Bà Sa Q.20; Luận Câu Xá Q.6, 9; Luận Thành Duy Thức Q.8]. (xt. Thập Nhị Nhân Duyên, Tam Thế, Nhân Quả, Báo Ứng).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Như Lai", "definition": "Cũng gọi Tam Thế Phật. Như Lai trong 3 đời.Tức chỉ cho Phật Di Đà, Phật Thích Ca, Phật Di Lặc được phối với 3 đời quá khứ, hiện tại và vị lai.Đức Thích Ca là Phật về mặt lịch sử, cho nên gọi là Hiện Tại Phật; Đức Di Đà là Phật của 10 kiếp đã qua, cho nên là Phật quá khứ; còn đức Di Lặc thì trong 56 ức 7 nghìn vạn năm sau đây sẽ là Phật xuất hiện ở thế giới Sa Bà này, cho nên gọi là Vị Lai Phật. [X. Động Thượng Già Lam Tạp Kí].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Phái", "definition": "San-chieh p'ai (C), San-chieh chiao.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thế Pháp", "definition": "Tilokiyadhamma (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thế Tam Thiên Phật", "definition": "Ba đời ba nghìn Phật. Tức 3 đời quá khứ, hiện tại và vị lai, trong mỗi đời đều có 1000 vị Phật. Trong kiếp Trang Nghiêm quá khứ, Hiền Kiếp ở hiện tại và Kiếp Tinh Tú ở vị lai, mỗi kiếp đều có 1000 Đức Phật, cộng lại thành 3 đời 3 nghìn Phật. [X. Kinh Tam Thiên Phật Danh; kinh Quán Dược Vương Dược Thượng]. (xt. Tam Thiên Phật).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Thực Hữu", "definition": "Ba đời thật có. Tức là 3 đời quá khứ, hiện tại và vị lai thực sự tồn tại.Đây là giáo nghĩa do Thuyết Nhất Thiết Hữu Bộ thành lập.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Tâm", "definition": "Chỉ cho quá khứ tâm, hiện tại tâm và vị lai tâm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Tục", "definition": "I.Tam Thế Tục.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thế Vô Chướng Ngại Trí Giới", "definition": "Cũng gọi Tam Muội Da Giới, Tự Tính Bản Nguyên Giới.Gọi tắt: Tam Giới.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thể", "definition": "三采. Ba màu. Td: Mèo tam thể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thệ Nguyện", "definition": "Three vows.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Thỉnh", "definition": "Chỉ cho 3 lần xin Đức Phật nói pháp. Phẩm Như Lai Thọ Lượng trong Kinh Pháp Hoa quyển 5 (Đại 9, 42 trung) nói: “Lúc bấy giờ, Đại Chúng Bồ Tát, đứng đầu là ngài Di Lặc, chắp tay bạch Phật rằng: Bạch Đức Thế Tôn! Kính xinNgài hãy nói pháp ấy, chúng con sẽ tin nhận lời Ngài.Bạch như thế 3 lần rồi lại nói: Kính xin Phật nói pháp ấy, chúng con sẽ tin nhận lời Ngài.Lúc bấy giờ Đức Thế Tôn biết các Bồ Tát đã 3 lần thỉnh không thôi, Ngài liền bảo rằng: Các ông hãy lắng nghe!”", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thị Kệ", "definition": "Cũng gọi Tam Đế Kệ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thọ", "definition": "三受 (Tạp A Hàm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thối Khuất", "definition": "三退屈 (Hoa Nghiêm Kinh Tuỳ Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thốn Thiệt", "definition": "三寸舌. Ba tác lưỡi, chỉ tài ăn nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Thời", "definition": "三時 (Nam Nhạc Tổ Sư Phát Nguyện Văn. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thời Chướng", "definition": "Nghiệp dị thục làm chướng ngại Tam Thời.Tam Thời chỉ cho lúc sắp được Nhẫn Vị, quả Bất Hoàn, quả Vô Học. Tam Thời chướng là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thời Giáo", "definition": "Cũng gọi Tam Thời Giáo phán. Chỉ cho 3 thời kì của giáo pháp Đức Phật được chia loại theo thời đại Đức Phật thuyết pháp khác nhau và ý nghĩa cạn sâu của nội dung kinh điển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thời Hệ Niệm", "definition": "Nhớ nghĩ 3 thời.Tức là một trong các pháp môn niệm Phật của Tông Tịnh Độ, do Quốc Sư Trung Phong đời Nguyên đề xướng, mục đích chủ yếu là cầu cho các vong linh được sinh về thế giới Cực Lạc phương Tây, vĩnh viễn ra khỏi biển nghiệp mênh mông mờ mịt. Thời gần đây pháp môn này lưu hành rất rộng rãi, có xu hướng muốn thay thế nghi thức cúng thí ngã quỉ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thời Hệ Niệm Nghi Phạm", "definition": "Gọi đủ: Trung phong Tam Thời Hệ Niệm Nghi Phạm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thời Luận Môn", "definition": "Liên kết 3 thời quá khứ, hiện tại và vị lai để thảo luận và nghiên cứu tất cả sự pháp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thời Tọa Thiền", "definition": "Ba thời ngồi thiền. Tức là Hoàng Hôn Tọa Thiền, Tảo Thần Tọa Thiền và Bô Thời Tọa Thiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thời Vô Hối", "definition": "三時無悔 (Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thời Điện", "definition": "Cung điện được xây cất để thích ứng với 3 thời xuân, hạ và đông. Tại Ấn Độ, một năm được chia làm 3 mùa, tức từ ngày 16 tháng 1 đến ngày 15 tháng 5 là mùa nóng (xuân), từ ngày 16 tháng 5 đến ngày 15 tháng 9 là mùa mưa (hạ), từ ngày 16 tháng 9 đến ngày 15 tháng 1 là mùa lạnh (đông).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thụ", "definition": "Phạm: Tisro-vedanà. Pàli: Tisso-vedanà. Cũng gọi Tam thống. Chỉ cho ba thứ cảm nhận khi 6 căn tiếp xúc với 6 cảnh (đối tượng). Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thụ Nghiệp", "definition": "Cũng gọi Tam Thụ Báo Nghiệp.Chỉ cho 3 thứ nghiệp được phân loại theo 3 cảm thụ: Khổ, lạc, xả. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thủy", "definition": "Chỉ cho 3 thứ nước: Thời, phi thời và xúc dụng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Thức", "definition": "三識 (Lăng Già Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thức Duyên Cảnh Quảng Hiệp", "definition": "三識緣境廣狹 (Tông Cảnh Lục và Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thừa", "definition": "三乘 (Pháp Hoa kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thừa Cộng Thập Địa", "definition": "Theo Luận Đại trí độ tam thừa cộng thập địa là chỉ thập địa chung cho cả ba thừa, trong ba thiên Thai coi đó là địa vị của thông giáo trong Tứ giáo.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Thừa Học Đạo Nhân", "definition": "三 乘 學 道 人. Người học đạo Tam thừa, tức là người căn cứ theo giáo pháp Tam thừa để tu hành. Nhà thiền cho rằng dạng học đạo này không thể đạt được sự triệt ngộ. Đoạn Tế Tâm Yếu ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Thừa Nhất Thiết Chư Vị", "definition": "三 乘 一 切 諸 位. Giai vị có được do quá trình tu hành theo giáo pháp Tam thừa. Học thuyết đôán ngộ của Thiền Tông cho rằng Tâm này vốn là Phật, không cần phải theo giai vị tuần tự tiến dần. Đoạn Tế Tâm Yếu ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Thừa Quán Môn", "definition": "三乘觀門 (Thiên Thai Tứ Giáo Nghi Thập Chú )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Thực Thi", "definition": "三食匙 (Pháp Uyển Châu Lâm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tiêu", "definition": "三焦. Danh từ Đông y, chỉ thượng tiêu, trung tiêu và hạ tiêu (miệng trên của dạ dày, phần giữa của dạ dày, và miệng trên của bằng quang).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tiêu Phục", "definition": "Tiêu phục 3 thứ độc hại.Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tiệm Thứ", "definition": "三漸次 (Thủ Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tiện", "definition": "Ba thứ tầm thường hèn mọn khi may áo ca sa giúp cho Tỉ Khưu đối trị được tâm tham nhiễm. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Toan Đồ", "definition": "Bức tranh vẽ 3 nhân vật Nho, Thích, Đạo làm đề tài.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trai", "definition": "I.Tam Trai.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trang Nghiêm", "definition": "Chỉ cho ba thứ trang nghiêm.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trí", "definition": "三智 (Quán Âm Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Trùng Pháp Giới", "definition": "Chỉ cho bản thể của thân tâm tất cả chúng sinh. Tông Hoa Nghiêm vốn lập 4 thứ pháp giới, để đối ứng với trí năng quán nên lập riêng Tam Trùng Pháp Giới.Tức là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trùng Quán Môn", "definition": "Gọi đủ: Tam Trùng Pháp Giới Quán Môn. Cũng gọi Tam Trùng Quán, Pháp Giới Tam Quán.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trùng Thất Cá Pháp Môn", "definition": "Cũng gọi Giáo Hành Chứng Tam Phần. Bảy pháp môn được lí giải theo 3 lớp Giáo, Hành, Chứng, là giáo pháp khẩu truyền của Tông Thiên Thai Nhật Bản. Thất Cá Pháp Môn (7 cái pháp môn) gồm có 4 pháp khẩu truyền là: Nhất Tâm Tam Quán, Nhất Niệm Tam Thiên, Chỉ Quán Đại chỉ và Pháp Hoa Thâm Nghĩa. Nội dung của Pháp Hoa Thâm Nghĩa lại được chia làm 3 pháp lớn nữa là: Viên Giáo tam thân, Liên Hoa nhân quả và Thường Tịch Quang Độ, cộng chung thành 7 pháp môn. Phương pháp để hiểu các pháp môn này gồm Tam trùng là: Giáo trùng(lời dạy của các Tổ Sư lưu lại bằng văn tự), Hành Trùng (Phương pháp thực hành của các Tổ Sư) và Chứng Trùng (sự thực hành và thể hội trong nội tâm của hành giả), vì thế nên gọi là Tam trùng thất cá pháp môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trướng Vật", "definition": "Chỉ cho vật dư thừa mà Tỉ Khưu không nên cất giữ. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trường Trai Nguyệt", "definition": "Cũng gọi Tam Trường Nguyệt, Tam Trai Nguyệt, Thiên Nguyệt, Thần Túc Nguyệt, Thần Thông Nguyệt, Thần Biến Nguyệt. Ba tháng trường trai.Chỉ cho tháng giêng, tháng 5 và tháng 9 âm lịch.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Trường Vật", "definition": "三長物 (Ma Ha Tăng Kỳ Luật)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tu", "definition": "Chỉ cho ba lối tu. Cứ theo Kinh Niết Bàn quyển 2 (bản Bắc) thì Tam tu có 2 thứ: Liệt Tam Tu và Thắng Tam Tu.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tuy", "definition": "蔘綏. Rộng lớn. Chỉ lòng dạ quảng đại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tuyên Tam Nhất", "definition": "Ba Tuyên ba Nhất. Chỉ cho 6 vị tông tượng của tông Tứ Phần Luật đời Đường, Trung Quốc. Tam tuyên chi cho 3 vị: Nghĩa tuyên, Tuệ tuyên và Đức Tuyên, gọi chung là Tấn Dương tam tuyên. Còn tam nhất thì chỉ cho 3 vị: Linh nhất, Đàm nhất và Hoài nhất. Hệ thống truyền thừa như sau: Tổ của Tướng Bộ Tông là Đại sư Pháp Lệ truyền cho ngài Đạo thành, Đạo thành truyền cho ngài Hoài Tố, Hoài Tố truyền cho ngài Pháp thận, Pháp thận truyền cho ngài Linh nhất và Nghĩa tuyên, Nghĩa tuyên truyền cho ngài Tuệ tuyên và Đức Tuyên; còn Linh nhất thì ngang hàng với ngài Đàm nhất ở Cối Kê và Hoài Nhất ở Mân Xuyên, cho nên đời sau mới gọi là Tam Tuyên Tam Nhất.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tuệ", "definition": "Ba Tuệ.", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Tuệ Kinh", "definition": "Kinh, 1 quyển, được thu vào Đại Chính Tạng tập 17. Nội dung kinh này do thu chép các nhân duyên, pháp nghĩa trong các kinh luận mà thành, tất cả có hơn 60 điều, có thể làm kim chỉ nam cho sự tu dưỡng của tín đồ Phật Giáo. Chính vua Lương Vũ Đế đã từng giảng kinh này ở chùa Đồng thái.[X. Xuất Tam Tạng Kí Tập Q.4].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tuỳ Phiền Não", "definition": "三隨煩惱 (Hoa Nghiêm Kinh Tùy Sơ Diễn Nghĩa Sao. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tà Hạnh", "definition": "I.Tam Tà Hạnh. Chỉ cho 3 thứ tà hạnh mà Luận Câu Xá quyển 17 căn cứ vào Sắc nghiệp (tức thân nghiệp, ngữ nghiệp) để lập riêng ra như sau:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tài", "definition": "三才. Ba ngôi vị cao quý nhất trong vũ trụ, gồm Thiên, Địa, Nhân Ba màu. Td: Cờ tam tài (cờ có ba màu xanh trắng đỏ của nước Pháp).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tài Phối Tam Thế Gian", "definition": "三才配三世间 (Hoa Nghiêm Kinh Tùy Sở Diễn Nghĩa Sao. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tánh", "definition": "三性 (Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Táp", "definition": "Đi nhiễu 3 vòng theo chiều bên phải.Đây là 1 trong những hình thức kính lễ, bắt nguồn từ nghi thức của Ấn Độ. Tức đi vòng quanh bậc tôn túc hoặc tháp Phật 3 vòng theo chiều tay phải để bày tỏ tâm thành ngưỡng vọng. Có khi đi quanh 1 vòng, có khi đi 3 vòng; hoặc do tâm nguyện, biệt thỉnh mà tùy ý người đính lễ đi quanh nhiều vòng. Đến đời sau, trong công án Thiền Tông, thông thường sau khi vấn đáp, người tham vấn liền bái vị Tông sư, đi nhiễu 3 vòng rồi lui ra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tâm", "definition": "三心 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tín", "definition": "I.Tam Tín.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tín Tam Bất", "definition": "Cũng gọi Tam Bất Tam Tín. Chỉ cho 3 thứ tâm tin và 3 thứ tâm không tin do ngài Đàm Loan thuộc Tông Tịnh Độ của Phật Giáo Trung Quốc nêu ra. Tam tín tâm là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tính", "definition": "Trayaḥ svabhāvaḥ (S), Svabhāva-lakṣaṇa-traya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tính Nghiệp", "definition": "Chỉ cho 3 nghiệp: Thiện, Bất Thiện và Vô Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tính Ngũ Pháp", "definition": "Xem Ngũ Pháp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tính Nhất Tế", "definition": "Ba tính Biến Kế Sở Chấp, Y Tha Khởi và Viên Thành Thực thông suốt lẫn nhau từ đầu đến cuối và không sai khác, nên gọi là Tam Tính nhất tế. Đây là một trong các giáo nghĩa cơ bản của Tông Hoa Nghiêm ứng dụng vào việc thuyết minh lí pháp giới duyên khởi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tính Đối Vọng Trung Đạo", "definition": "Cũng gọi Tam Tính Tương Đối Trung Đạo, Ngôn Thuyên Trung Đạo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tòa Thuyết Pháp", "definition": "Tên công án trong Thiền Tông. Tam tòa chỉ cho vị Thủ Tọa thứ 3.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tòng", "definition": "三從. Ba điều theo của phụ nữ thời xưa, gồm Tòng phụ, Tòng phu và Tòng tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tôn", "definition": "Cũng gọi Tam Tôn Phật. Cách bài trí 3 pho tượng Phật trong chùa. Trung Tôn là chính, 2 bên Trung Tôn có 2 vị hiếp thị khác. Cách sắp xếp này bắt nguồn từ Nhất Quang Tam Tôn của Ấn Độ, thường thì Trung Tôn là Phật Thích Ca, bên trái là Phật Dược Sư, bên phải là Phật Di Đà. Ngoài ra cũng có cách thờ một Phật hai Bồ Tát, tức chính giữa là Phật, 2 bên là 2 vị Bồ Tát hoặc 2 vị Minh Vương. Từ xưa đến nay, Tam Tôn có hình thức nhất định, tức Phật Thích Ca, 2 vị đệ tử Thanh Văn là Ca Diếp, A Nan; Phật Thích Ca và 2 vị Bồ Tát Phổ Hiền, Văn Thù, gọi là Thích Ca Tam Tôn; Phật Di Đà và 2 Bồ Tát Quán Thế Âm, Đại Thế Chí, gọi là Di Đà Tam Tôn; hoặc Tây Phương Tam Thánh; Dược Sư Như Lai và 2 Bồ Tát Nhật Quang, Nguyệt Quang, gọi là Dược Sư Tam Tôn; hoặc Phật Dược Sư và 2 Bồ Tát Dược Vương, Dược Thượng; Bồ Tát Bát Nhã và 2 vị trời Phạm Thiên, Đế Thích; Minh Vương Bất Động và 2 đồng tử Chế Tra Ca, Căng Yết La. Hiếp Thị (cũng gọi là Hiếp Sĩ, Giáp Thị: Đứng hầu 2 bên) là biểu trưng cái đức của vị Trung Tôn, như Quán Thế Âm biểu trưng từ bi, Đại Thế Chí biểu trưng trí tuệ; Văn Thù biểu trưng sự hiểu biết, Phổ Hiền biểu trưng sự thực hành. Tượng Tam Tôn Phật nếu ở chính giữa an trí chung vầng ánh sáng phía sau lưng thì gọi là Nhất quang Tam Tôn, vầng ánh sáng ấy thông thường được biểu hiện bằng hình chiếc thuyền (Thuyền hậu quang). [X. Kinh Tăng Nhất A Hàm Q.28; Kinh Quán Dược Vương Dược Thượng Nhị Bồ Tát; Kinh Hoa Nghiêm Q.60 (bản dịch cũ); Kinh Nhất Thiết Công Đức Trang Nghiêm; Đại Đường Tây Vực Kí Q.8]. (xt. Quang Bối, Hiếp Sĩ).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tôn Lai Nghinh", "definition": "Ba vị Tôn đến đón. Chỉ cho lúc lâm chung, Đức Như Lai A Di Đà, Bồ Tát Quán Thế Âm và Bồ Tát Đại Thế Chí đến đón. Tức ứng theo bản nguyện mà các Ngài hiện ở trước để tiếp dẫn hành giả về Tịnh Độ Cực Lạc. (xt. Lai Nghinh).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tông", "definition": "三宗 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tông Luận", "definition": "Tác phẩm, do cư sĩ Chu Ngung soạn vào đời Nam Tề. Nội dung sách này dùng nghĩa Chân Đế và Tục Đế để bàn thuật ý chỉ của 3 tông: Không Giả Danh, Bất Không Giả Danh và Giả Danh Không. Không Giả Danh và Bất Không Giả Danh là thuyết của các Luận sư Thành Thực; còn Giả Danh Không là thuyết của Chu Ngung. Sách này là tác phẩm đầu tiên phục hưng Tam Luận học Bát Nhã ở Giang Nam. [X. Trung Quán Luận Sớ Q.2, phần cuối; Nhị Đế chương Q.hạ; Quảng Hoằng Minh Tập Q.24].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tông Nhị Đế", "definition": "Chỉ cho thuyết Chân Đế và Tục Đế nói trong luận Tam Tông của ẩn sĩ Chu Ngung đời NamTề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tùy Miên", "definition": "Cũng gọi Tam Sử. Tùy Miên (Phạm: Anuzaya) là tên khác của phiền não mà Bồ Tát ở giai vị Thập Địa phải đoạn trừ. Dựa theo tính chất thô tế của chúng mà các Tùy Miên được chia làm 3 loại là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tùy Phiền Não", "definition": "Chỉ cho 3 thứ Tùy Phiền Não nói trong Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao quyển 34.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tăng Kì Bách Đại Kiếp", "definition": "Cũng gọi Tam Kì Bách Kiếp. Ba Tăng Kì trăm Đại Kiếp, từ gọi chung Tam A Tăng Kì Kiếp và Bách Đại Kiếp, là thời gian vị Bồ Tát tu hành từ lúc mới phát tâm đến khi thành quả Phật. Tam A Tăng Kì cũng gọi là Tam Kiếp, A Tăng Kì Dịch là vô số, hoặc chỉ cho sự tột cùng của số; Kiếp là tên gọi thời gian, dịch là lâu xa, lâu dài... trong đó có Đại Kiếp, Trung Kiếp, Tiểu Kiếp khác nhau. Ba cái A Tăng Kì Đại Kiếp gọi là Tam Đại A Tăng Kì Kiếp, là khoảng thời gian vị Bồ Tát tích lũy tư lương bồ đề; còn 100 Đại Kiếp là thân của quả Phật được tướng hảo trang nghiêm, là thời gian tu phúc nghiệp. Bồ Tát vì sự nghiệp độ tha mà tu hành trong 3 A Tăng Kì Kiếp, lại vì chính thân mình thành Phật cảm được 32 tướng mà trong khoảng thời gian 100 Đại Kiếp vun trồng vô lượng phúc đức. Nhưng Luận Du Già Sư Địa quyển 48 và Luận Nhiếp Đại Thừa quyển hạ chỉ nêu Tam kì, chứ không nói Bách kiếp, cho nên các ngài Trí Khải, Pháp Tạng... đều chủ trương thuyết Tam Kì Bách Kiếp là do Tiểu Thừa thành lập. [X. Kinh Bồ Tát Anh Lạc Bản Nghiệp Q.hạ; Luận Đại Tì Bà Sa Q.178; Luận Câu Xá Q.18; Luận Thuận Chính Lí Q.44; Hoa Nghiêm Ngũ Giáo Chương Q.2]. (xt. Tam A Tăng Kì Kiếp, Kiếp).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tư", "definition": "三思 (Hoa Nghiêm Kinh Sớ Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tương Tục", "definition": "三相毒 (Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tướng", "definition": "三相(Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tướng Thần", "definition": "Phạm: Trimùrti. Chỉ cho 3 vị thần liên quan với nhau nhưng mỗi vị có một tướng. Chủ yếu chỉ cho 3 vị thần lớn mà Ấn Độ Giáo tin thờ là Phạm Thiên, Tì Thấp Nô và Thấp Bà. Người Ấn Độ Giáo tin rằng 3 vị thần này theo thứ tự Đại Biểu cho sự sáng tạo, sự duy trì và sự hủy diệt vũ trụ. Tín ngưỡng này bắt nguồn từ thời kì Phệ Đà.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tưởng", "definition": "I.Tam Tưởng.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tại", "definition": "Tại tâm, tại duyên và tại quyết định, được nói trong Vãng Sinh Luận Chú quyển thượng của ngài Đàm Loan. Nghĩa là nếu so sánh hiệu lực của việc suốt đời tạo các tội ác và việc niệm Phật 10 niệm lúc hấp hối thì hiệu lực của việc niệm Phật thù thắng hơn vì 3 lẽ:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tạng", "definition": "三藏 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tạng Giáo", "definition": "I.Tam Tạng Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tạng Kinh", "definition": "Piṭakatraya (S), Piṭakattaya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tạng Kinh Điển", "definition": "Tipiṭāka (P), Tripiṭaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tạng Pháp Sư", "definition": "Tipeṭaka (P), Master of Tipitaka, Tripiṭāka master, Tipeṭaki (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tạng Pháp Sư Cương Lương Da Xá", "definition": "Xem Cương Lương Da Xá.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tạng Sư", "definition": "Tipiṭākadhara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tạng Thiện Vô Úy", "definition": "Śubhākara-siṃha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tạng Thuyên Tam Học", "definition": "三藏詮三学 (Tứ Giáo Nghi)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tạp Nhiễm", "definition": "三雜染 (Hiển Dương Thánh Giáo Luận. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tần", "definition": "Tức ba triều đại ở miền Giang-bắc (phía Bắc sông Trường-giang) đều lấy tên là Tần; và để phân biệt, các sử gia đã gọi đó là Tiền-Tần, Hậu-Tần và Tây-Tần.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tam Tập Đế", "definition": "Chỉ cho 3 thứ Tập Đế do Tông Pháp Tướng thành lập, đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tắng Ái", "definition": "Tắng ái tức là ghét, thương, là hai mối lòng đối nhau. Tuy đối chọi nhau nhưng liên tiếp nhau, vì có thương thì có ghét. Ở đây thương có ba cảnh, ghét cũng có ba cảnh nên gọi là Tam Tắng ái. - Ghét (tắng) có ba cảnh : bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Tế", "definition": "I.Tam Tế. Tức Tam Thế.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tế Lục Thô", "definition": "Chỉ cho 3 tướng nhỏ nhiệm, 6 tướng thô to. Đây là 9 tướng trạng của tất cả vọng pháp do vô minh căn bản dấy động chân như mà sinh khởi.Tam Tế Lục Thô là dụng ngữ của Luận Đại Thừa Khởi Tín. Tế là giữa Tâm Vương và Tâm Sở không có sự phân biệt, tướng trạng của chúng tinh tế khó lường biết; còn Thô là Tâm Vương và Tâm Sở tương ứng, tướng tác dụng của chúng rõ rệt dễ thấy. Tam Tế gồm:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tế Thời", "definition": "三際時 (Hoa Nghiêm Kinh Sớ và Diễn Nghĩa Sao. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tế Tướng", "definition": "三細相 (Khởi Tín Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tỉnh", "definition": "三省. Ba điều từ hỏi mình. Do điển thầy Tăng Sâm hàng ngày tự xét mình ba điều là có bất trung, bất tín, bất tập hay không. Chỉ sự tự xét mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tỉnh Tự", "definition": "(三井寺, Mii-dera) hay Viên Thành Tự (園城寺, Onjō-ji): ngôi chùa trung tâm của Thiên Thai Tự Môn Tông (天台寺門宗), hiện tọa lạc tại số 246 Onjōji-chō (園城寺町), Ōtsu-shi (大津市), Shiga-ken (滋賀縣), nói cho đúng là Trường Đẳng Sơn Viên Thành Tự (長等山園城寺), nhưng thường được gọi là Tam Tỉnh Tự, hay Ngự Tỉnh Tự (御井寺), và rất nổi tiếng là ngôi chùa linh thiêng thứ 14 trong số 33 ngôi danh lam ở vùng Tây Quốc (西國) được mọi người thường đến tham bái. Tượng thờ chính là Di Lặc Bồ Tát. Suốt trong thời gian từ thời Bình An cho đến Liêm Thương, chùa đã từng đối kháng với Tỷ Duệ Sơn (比叡山, Hieizan), rồi cùng với Hưng Phước Tự (興福寺, Kōfuku-ji) ở vùng Nam Đô, chùa còn nuôi dưỡng lớp Tăng Binh để tranh đấu với hàng võ môn, là một trong những ngôi tự viện có quyền lực mạnh nhất đương thời. Sau khi Thiên Trí Thiên Hoàng (天智天皇, Tenchi Tennō) băng hà, chùa bắt đầu được dựng lên bởi vị Hoàng Tử của Hoằng Văn Thiên Hoàng (弘文, Kōbun Tennō) là Đại Hữu Dữ Đa Vương (大友與多王) cúng dường khu đất của ông. Đến năm 859 (Trinh Quán [貞觀] nguyên niên), Trí Chứng Đại Sư Viên Trân (圓珍, Enchin) tái kiến lại chùa. Có thuyết cho rằng tên gọi Tam Tỉnh Tự vốn phát xuất từ sự việc phía sau Kim Đường của chùa có một cái giếng, người ta thường dùng nước giếng này để hành lễ Tam Bộ Quán Đảnh (三部灌頂), cho nên chùa có tên như vậy. Cũng có thuyết cho rằng chính nước giếng này được dùng để tắm rửa cho ba vị Thiên Hoàng Thiên Trí (天智, Tenchi), Thiên Võ (天武, Temmu) và Trí Thống (持統, Jitō) khi vừa mới sinh ra. Chùa này ngày xưa là ngôi Biệt Viện của Diên Lịch Tự (延曆寺, Enryaku-ji), môn đồ của chùa đã từng tranh đấu với môn đồ của Viên Nhân (圓仁, Ennin) trên Tỷ Duệ Sơn; cuối cùng vào năm 993 (Chánh Lịch [正曆] 4), chùa tách riêng ra trở thành ngôi chùa tổ trung tâm. Đến cuối thời Bình An, chùa có khoảng 80 ngôi đường tháp, 600 tăng phòng; song chùa cũng đã gặp mấy lần hỏa hoạn, bị cháy tan tành. Ngôi già lam hiện tại có thể nói là kiến trúc tái kiến của mấy vị Tướng Quân nổi tiếng đời đầu của dòng họ Đức Xuyên (德川, Tokugawa) là Gia Khang (家康, Ieyasu), Tú Trung (秀忠, Hidetada), v.v. Hiện tại chùa được liệt vào một trong 4 ngôi tự viện lớn nhất Nhật Bản. Một phần rất rộng lớn của chùa nằm trên núi, lấy Quan Âm Đường làm trung tâm; một phần thì nằm dưới chân núi, chủ yếu là phối trí các ngôi đường tháp. Nơi Quan Âm Đường có tôn thờ tượng Như Ý Luân Quan Âm bằng gỗ Chiên Đàn, là một trong 33 chốn linh trường của vùng Tây Quốc. Tương truyền tượng này là tác phẩm của vị Tổ khai sơn Trí Chứng Đại Sư (智証大師). Ngôi đường hiện tại là kiến trúc được xây dựng vào năm 1689. Trong núi có Kim Đường, là kiến trúc được xây dựng vào năm 1252 (Kiến Trường [建長] 4), được xếp vào hạng quốc bảo. Các ngôi Khách Đường ở Khuyến Học Viện cũng như ở Quang Tịnh Viện cũng đều là quốc bảo. Cách đó khoảng 3 cây số về phía Bắc có Tân La Thiên Thần Đường (新羅天神堂), trong đó Tu Di Đàn cũng được xếp hạng quốc bảo. ngoài ra trong khuôn viên chùa còn có Nhân Vương Môn, Tam Trùng Tháp, Lầu Chuông, Đường Viện, Kinh Đường, Nhà Ăn, Tỳ Sa Môn Đường, v.v., đều là những kiến trúc được xếp hạng tài sản văn hóa trong yếu của quốc gia, và quanh đó cũng có rất nhiều ngôi đường tháp lớn nhỏ. Nơi Kinh Tàng có lưu trữ những bản kinh tạng Cao Lệ (Triều Tiên). Bên cạnh đó, chùa còn lưu giữ vô số các bảo vật khác.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Tịch Mặc", "definition": "Tịch mặc, Phạm: Mauneya, Mauna, Maunì. Hán âm: Mâu Ni.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tịnh Nhân", "definition": "Cũng gọi Thân Khí Thanh Tịnh Tam Nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tịnh Nhục", "definition": "三凈肉 (Thập Tụng Luật)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tịnh Đầu", "definition": "Chỉ chỗ đầu giường trong Tăng Đường. Chỗ này có 3 công dụng: Thứ nhất, dùng để cất ca sa, thứ hai, dùng để bình bát và thứ ba, dùng để làm gối khi ngủ (dùng đầu giường làm gối), cho nên gọi là Tam Tịnh đầu. [X. điều Nhật Dụng Quĩ Phạm trong Sắc Tu Bách Trượng Thanh Qui Q.6; Thiền Lâm Tượng Khí Tiên Q.1 thượng].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tổ Thực Lực", "definition": "三 祖 寔 錄. Lục. 1 quyển, do một vị khuyết danh (mà người ta đoán là một thiền sư Việt Nam) sống vào đời Trần soạn, Diệu Trạm đời Nguyễn hiệu chính. Nội dung gồm có 4 phần:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Tổ Tự", "definition": "Cũng gọi Càn Nguyên Thiền Tự, Sơn Cốc Tự. Chùa ở núi Thiên trụ, tỉnh An Huy, Trung Quốc, tương truyền do Thiền Sư Bảo Chí sáng lập vào thời Nam Triều. Về sau, Tổ thứ 3 của Thiền Tông là ngài Tăng Xán đến đây, xây cất chùa viện rộng thêm, trở nên nổi tiếng cả vùng Giang Nam, Giang Bắc. Vào năm Đại Nghiệp Thứ 2 (606) đời Tùy, Tam tổ đứng mà tịch ở gốc cây trong chùa, người đời sau xây đình “Lập hóa” để kỉ niệm. Phía đông chùa có động Bảo công, giếng Tích trượng, suối Trác tích. Tương truyền, động Bảo công là chỗ ở của Thiền Sư Bảo Chí lúc sáng lập chùa, giếng và suối là do Thiền Sư Bảo Chí dùng tích trượng để đào. Phía tây chùa có động Thạch ngưu là nơi đọc sách của Hoàng Đình Kiên đời Tống. Trong chùa có tòa tháp tên là Giác Tịch.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tổ Tự Tháp", "definition": "三 祖 寺 塔. Còn gọi: Giác Tịch Tháp. ở trong chùa Tam Tổ, khu Dã Trại, núi Thiên Trụ, huyện Tiềm Sơn, tỉnh An Huy, Trung Quốc. Xây vào niên hiệu Thiên Bảo thứ 5 (746) đời Đường. Vào thời Đường Võ Tông thiêu Phật chùa bị phá hủy. Đầu những năm Đại Trung (847-859) xây dựng lại. Tháp hiện nay được xây lại vào niên hiệu Gia Tĩnh thứ 43 (1564) đời Minh. Tháp 7 tầng hình bát giác cao 10 trượng theo kiểu lâu các, đấu củng bố cục nghiêm cẩn. Tháp thể ngoài xoáy trong rỗng xung quanh có khắc tượng Phật. Đỉnh tháp có tướng luân đúc sắt cao khoảng 5m được đúc vào niên hiệu Càn Đạo thứ 8 (1172) đời Tống.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tam Tộc", "definition": "三族. Ba họ, gồm họ hàng bên cha, họ hàng bên mẹ và họ hàng bên vợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tụ", "definition": "三聚 (Hiển Tông Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tụ Giới", "definition": "三聚戒 (Bồ Tát Giới Nghi Sớ và Pháp Uyển Châu Lâm. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tụ Tịnh Giới", "definition": "Trividhani-śīlani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tử", "definition": "Chỉ cho ba người con. Tức ví dụ cho 3 loại căn cơ: Bồ Tát, Thanh Văn và Nhất Xiển Đề giống như 3 người con có bản tính khác nhau. Điển tích này có xuất xứ từ Kinh Đại Bát Niết Bàn quyển 33 (bản Bắc) nói rằng: Trong 3 người con, người con thứ nhất có tâm tín thuận, cung kính cha mẹ, lợi căn trí tuệ, đối với các việc thế gian rõ biết nhanh chóng; người con thứ 2 không có tâm tín thuận, không cung kính cha mẹ, nhưng cũng lợi căn thông minh và đối với các việc thế gian cũng hiểu biết mau chóng; còn người thứ 3 thì đã không có tâm tín thuận, không kính cha mẹ lại ngu si vô trí. Ở đây, người con thứ nhất ví dụ cho Bồ Tát, người con thứ 2 ví dụ cho Thanh Văn và người con thứ 3 thí dụ cho Xiển Đề. Trong Hóa Giáo của Tông Thiên Thai thì vào thời Hoa Nghiêm đầu tiên hóa đạo Bồ Tát, kế đến là làm lợi ích cho hàng Thanh Văn, cuối cùng đến thời Niết Bàn mới mở đường tiếp hóa Xiển Đề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tự", "definition": "I.Tam Tự.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tự Kinh", "definition": "三字經. Cuốn sách chữ Hán dành cho trẻ con thời trước, do Vương Ứng Lân đời Tống làm ra, mỗi câu chỉ có ba chữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Tự Nhất Tâm Ma Ha Diễn Pháp", "definition": "Gọi tắt: Tam Tự. Chỉ cho tâm tuyệt đối duy nhất có đủ Thể, Tướng, Dụng, cũng tức là Nhất Tâm nói trong Luận Đại Thừa Khởi Tín. [X. Luận Biện Hiển Mật Nhị Giáo Q.thượng].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tự Thiền", "definition": "Cũng gọi Vân Môn Tam Tự Thiền. Tên công án trong Thiền Tông. Thiền ba chữ, tức chỉ cho 3 chữ Cố, Giám, Di của Thiền Sư Vân Môn Văn Yển thường dùng để tiếp hóa người học. “Cố” nghĩa là tự mình phàn tỉnh; “Giám” nghĩa là tự xem xét, răn giữ mình; còn “Di” nghĩa là lãnh hội được ý chỉ sâu xa, kín nhiệm mà ngôn ngữ, ý thức không thể đạt tới, tức chỉ cho cảnh giới an tự tại, siêu vượt tất cả các pháp tương đối.[X. Bích Nham Lục tắc 6, Thiền Tông Tụng Cổ Liên Châu Thông Tập Q.32].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Tự Tánh", "definition": "三自性 (Hiển Dương Thánh Giáo Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Tự Tính", "definition": "Gồm:", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tự Tính Tướng", "definition": "Pariniśpana (S), Svabhāva-lakṣaṇatraya (S), Pariniśpana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Tỷ Lượng", "definition": "Cũng gọi Tam Lượng, Tam Chi Tỉ Lượng. Tiếng dùng trong Nhân Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Uẩn", "definition": "Ba Uẩn. Hóa Địa Bộ của Tiểu Thừa chia vạn pháp thành 3 loại, gọi là Tam Uẩn:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Viên Mãn", "definition": "三圓滿 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Vô Gián Nghiệp", "definition": "Chỉ cho 3 thứ nghiệp cực ác chiêu cảm quả địa ngục Vô Gián, đó là giết cha, giết mẹ và giết A La Hán. [X. Chính Pháp Nhãn Tạng Biệt Lập Tam Thời Nghiệp].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vô Lậu Căn", "definition": "Phạm: Trìny anàsravendriyàị", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vô Lậu Học", "definition": "Trois disciplines Three uncontaminated studies 三無漏學 Tisraḥ śikṣāh", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Vô Minh", "definition": "三無明 (Phật Thuyết Quyết Định Nghĩa Kinh. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Vô Ngã", "definition": "Chỉ cho 3 thứ Vô Ngã do Tông Pháp Tướng dựa theo 3 tính Biến Kế, Y tha và Viên Thành mà lập ra. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vô Ngại", "definition": "三無碍 (Đại Bảo Tích Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Vô Sai Biệt", "definition": "三無差別 (Hoa Nghiêm Kinh Sớ. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Vô Sinh Nhẫn", "definition": "Ba thứ Vô Sinh Nhẫn do Tông Pháp Tướng dựa theo 3 tính Biến Kế Sở Chấp, Y Tha Khởi và Viên Thành Thực mà thành lập, đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vô Thường", "definition": "Ba thứ vô thường. Vô Thường nghĩa là các pháp sinh diệt đổi dời, không có thể tính cố định và có thể trình bày qua 3 phương diện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vô Tánh", "definition": "三無性 (Thành Duy Thức Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Vô Tính", "definition": "Ba Vô Tính. Tuy tự tính Y Tha Khởi có thể giúp phá vỡ được tính cách “Biến Kế Sở Chấp” của sự vật, nhưng dù sao thì nó vẫn chỉ được xem là một phương tiện, vì vẫn còn là một khái niệm về sự vật, và cuối cùng cũng phải bị quét sạch thì chân tướng của thực tại mới hoàn toàn được hiển lộ. Vì lí do đó, sau khi thuyết minh “ba tự tính” của đối tượng nhận thức, Duy Thức Học lại thành lập thuyết “ba vô tính” nhằm triệt tiêu hết mọi khái niệm:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Vô Tính Luận", "definition": "Phạm: Try-asvabhàva-prakaraịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vô Tư", "definition": "三無私. Ba điều không riêng cho ai, gồm Thiên vô tư phú (trời không che riêng ai), Địa vô tư tái (đất không chở riêng ai), và Nhật nguyệt vô tư chiếu (mặt trời mặt trăng không rọi sáng cho riêng ai).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Vô Vi", "definition": "三無為 (Câu Xá Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Võ Nhất Tông Pháp Nạn", "definition": "Pháp nạn ba vua Võ một vua Tông . Thuật ngữ này được dùng để chỉ cho bốn vị hoàng đế Trung-quốc đã bách hại Phật giáo một cách nghiêm trọng, gây ra bốn thời kì pháp nạn trong lịch sử Phật giáo Trung-quốc ở thời đại quân chủ:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tam Vũ Nhất Tông Pháp Nạn", "definition": "Chỉ cho 4 lần pháp nạn nghiêm trọng nhất trong lịch sử Phật Giáo Trung Quốc do các Hoàng Đế gây ra. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Vọng Chấp", "definition": "Cũng gọi Tam Kiếp Vọng Chấp, Tam Kiếp Hoặc. Gọi tắt: Tam Vọng, Tam Chấp, Tam Kiếp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Xa", "definition": "三車 (Pháp Hoa Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Xa Tứ Xa", "definition": "Ba xe 4 xe. Xe có thể chuyên chở các vật, ví dụ Phật Pháp hóa độ chúng sinh đưa đến Niết Bàn. Ba xe chỉ cho xe dê, xe nai và xe bò, nếu thêm xe trâu trắng lớn nữathìlà 4 xe.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Xá", "definition": "三赦. Ba hạng, người dáng được tha tội, theo luật đời Chu, gồm người quá trẻ, người quá già và kẻ ngu si.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Xứ A Lan Nhã", "definition": "Ba loại A Lan Nhã. A Lan Nhã là nơi vắng vẻ, an nhàn, ở cách xa làng xóm 1 câu lô xá(tức nơi mà tiếng kêu của con bò lớn không vang tới), là nơi thích hợp nhất cho việc tu hành. Theo Tuệ Lâm Âm Nghĩa quyển thượng thì có 3 loại A Lan Nhã sau đây:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Xứ Bất Chuyển Pháp Luân", "definition": "三處不轉法輪", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Xứ Mộc Xoa", "definition": "Chỉ cho giới pháp giữ gìn che chở 3 chỗ thân, khẩu, ý.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Xứ Nhập Pháp Giới", "definition": "三處入法界 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Xứ Truyền Tam", "definition": "Truyền tâm ở 3 nơi.Đây là truyền thuyết của Thiền Tông. Nghĩa là Đức Phật Thích Ca truyền tâm cho ngài Đại Ca Diếp ở 3 nơi: Một là trên núi Linh Thứu, Phật cầm hoa sen đưa lên, ngài Ca Diếp mỉm cười; hai là Phật chia nửa tòa ngồi cho ngài Ca Diếp ở trong tháp Đa Tử; ba là Phật ló 2 chân ra khỏi kim quan cho ngài Ca Diếp thấy khi Ngài nhập diệt ở rừng Sa La Song Thụ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Y", "definition": "Tricīvara (S), Ticīvara (P), Ticīvara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Y Danh Nghĩa", "definition": "三衣名義 (Phiên Dịch Danh Nghĩa. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Y Nhất Bát", "definition": "Ba áo một bát. Trong 6 vật của Tỉ Khưu, đặc biệt quan trọng là 3 áo: An Đà Hội, Uất Đa La Tăng, Tăng Già Lê và 1 chiếc bát là những vật dụng mà vị Tỉ Khưu thường mang bên mình.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Yếu", "definition": "(三要): 3 yếu tố quan trọng, có 2 nghĩa.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam chi là Tông (mệnh đề), Nhân (lí do) và Dụ (thí dụ). (xt. Tam Chi Tác Pháp).", "definition": "II.Tam Chi.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam lễ của Mật Giáo, tức hành giả Chân Ngôn 3 lần lễ bái Bản Tôn thánh chúng. Khi vị đạo sư lễ Tam lễ trước đàn tu pháp thì phần nhiều cầm lư hương có cán; hành giả sơ tâm thì cầm tràng hạt hoặc chắp tay Kim Cương, miệng tụng Chân Ngôn Phổ lễ để lễ. Chân Ngôn là “Án tát phạ đát tha nghiệt đa bả na mãn na nâm ca lô di”. Còn khi cử hành nghi thức Quán Đính, Truyền thụ... thì đệ tử lãnh thụ phải hướng vào vị Đại A Xà Lê mà lễ 3 lễ.", "definition": "V. Tam Lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam môn nghĩa là 3 cửa giải thoát: Từ bi, Trí tuệ và Phương tiện, hoặc tượng trưng cho 3 môn Tín, Giải, Hành, chứ không hẳn là phải có 3 cánh cửa. Hoặc kiến trúc Tam môn đã được căn cứ vào đoạn văn sau đây trong Luận Đại Trí Độ quyển 20 (Đại 25, 207 hạ): “Ví như tòa Thành có 3 cửa, 1 thân người không thể cùng 1 lúc vào cả 3 cửa, mà chỉ có thể từ 1 cửa đi vào. Thực Tướng các pháp là thành Niết Bàn, thành có 3 cửa: Không, Vô Tướng, Vô Tác”. [X. Phật Địa Kinh Luận Q.1].", "definition": "II.Tam Môn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam trí này thuộc về Quán Chiếu Bát Nhã trong 3 loại Bát Nhã, cũng thuộc về Nhất Thiết Chủng Trí. [X. Luận Du Già Sư Địa Q.38; Đại Thừa Nghĩa Chương Q.19].", "definition": "III.Tam Trí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ác", "definition": "I.Tam Ác.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ác Giác", "definition": "三惡覺 (Niết Bàn Kinh và Tông Cảnh Lục )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Ác Hạnh", "definition": "Tini-duccaritani (P), Trini-duscaritani (S), Tini-duccaritani (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Ác Đạo", "definition": "三恶道 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Ái", "definition": "Chỉ cho 3 thứ yêu thương, luyến tiếc khởi lên lúc hấp hối sắp chết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ích", "definition": "I.Tam Ích.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đa", "definition": "三多. Ba thứ nhiều ở đời. Gồm Đa phúc, Đa lộc và Đa thọ (nhiều con cháu, nhiều tiền bạc do chức vụ cao, và nhiều tuổi).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Điên Đảo", "definition": "三顚倒 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Điền", "definition": "Ba loại ruộng được dùng để ví dụ cho 3 hạng người là Bồ Tát, Thanh Văn và Xiển Đề.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Điền Dụ Tam Chủng Nhân", "definition": "三田喻三種 人 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Điều Chuyên Hạ Thất Xích Đơn Tiền", "definition": "Chỉ cho cái giường thiền trong Tăng Đường. Giường này rộng 3 thước (Tàu). Trên đầu giường có 3 cái đòn tay, cho nên gọi là Tam Điều chuyên hạ. Chiều dài của giường là 6 thước, gọi là Đơn tiền; ván giường dày 1 thước, cộng chung là 7 thước, gọi là “Thất xích đơn tiền”. Tùy kích thước khác nhau mà có Lục xích đơn, Ngũ xích đơn...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Điểu Xuất Võng", "definition": "Ba loại chim bay ra khỏi lưới, ví dụ cho căn khí của chúng sinh Tam Thừa đều khác nhau. Các chúng sinh Tam Thừa thoát khỏi sự ràng buộc của vọng chấp, giống như 3 loài chim bung ra khỏi lưới, đều bay vào thế giới tự do không phiền não, không chướng ngại; họ đều ở trong hoàn cảnh giống nhau, nhưng vì Chủng Tính bất đồng nên cảnh giới mà họ cảm được có khác nhau. Ba loại chúng sinh này (Tam Thừa) đều đã thoát khỏi cảnh khổ phiền não, hướng tới cảnh giải thoát vô vi, nhưng do căn khí thượng, trung, hạ khác nhau, nên cảnh giới do tu mà chứng được cũng bất đồng. [X. Nhân Vương Hộ Quốc Bát Nhã Kinh Sớ Q.2; Pháp Hoa Nghĩa Sớ Q.3, Triệu Luận].", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đoạn", "definition": "三断 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đoạn Luận", "definition": "Syllogism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Đà La Ni", "definition": "三陀羅尼 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đàn", "definition": "Cũng gọi Tam Thí. Đàn nói đủ là Đàn Na, nghĩa là bố thí. Cứ theo Luận Đại Trí Độ quyển 14 thì Tam đàn là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đàn Đại Giới", "definition": "Nghi thức thụ giới được chia làm 3 giai đoạn gọi là Tam Đàn Đại Giới.Tức là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đĩnh Viện", "definition": "Three Pillars, The.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Đại", "definition": "三大 (Khởi Tín Luận Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đại Bí Pháp", "definition": "Cũng gọi Tam bí. Chỉ cho 3 pháp môn Đại Bí Mật của tông Nhật Liên, Nhật Bản. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đại Bộ", "definition": "I.Tam Đại Bộ. Cũng gọi Thiên Thai Tam Đại Bộ, Pháp Hoa Tam Đại Bộ, Tam Đại Chương Sớ. Chỉ cho 3 bộ sách căn bản của tông Thiên Thai là Diệu Pháp Liên Hoa Kinh Văn Cú 10 quyển, Diệu Pháp Liên Hoa Kinh Huyền Nghĩa, 10 quyển và Ma Ha Chỉ Quán, 10 quyển, do Đại Sư Trí Khải soạn, đệ tử của ngài là sư Quán Đính ghi chép. Trong đó, bộ Diệu Pháp Liên Hoa Kinh Văn Cú được ngài Trí Khải giảng ở chùa Ngõa Quan tại Kim Lăng vào năm Khai Hoàng thứ 7 (587) đời Tùy, nội dung giải thích rõ câu văn của Kinh Pháp Hoa; Diệu Pháp Liên Hoa Kinh Huyền Nghĩa lúc đầu được ngài giảng ở chùa Ngõa Quan, sau, vào năm Khai Hoàng thứ 13 (593) lại giảng ở chùa Ngọc Tuyền tại Kinh Châu, nội dung giảng rõ về đề kinh và giáo tướng của Pháp Hoa; còn Ma Ha Chỉ Quán cũng do ngài Trí Khải giảng cùng thời gian và cũng ở chùa Ngọc Tuyền, nội dung giải thích về pháp quán tâm của Kinh Pháp Hoa. Về các sách chú sớ Tam Đại bộ thì có: Tam Đại bộ khoa văn 16 quyển (Trạm Nhiên), Tam Đại Bộ Bổ Chú 14 quyển (Tòng nghĩa) và Tam Đại bộ độc giáo kí 20 quyển (Pháp Chiếu). [X. Pháp Hoa Văn Cú Kí Q.10, thượng; Tùy Thiên Thai Trí Giả Đại Sư Biệt Truyện; Đệ tử chí trong Thích Môn Chính Thống Q.3; Sơn Gia Chính Thống Học Tắc Q.thượng]. II.Tam Đại Bộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đại Kỳ Kiếp", "definition": "Kỳ kiếp quá khứ là Trang Nghiêm Kỳ Kiếp. Hiện tại kiếp là Hiền Kiếp. Vị lai kiếp là Tinh Tú Kiếp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Đại Nguyện", "definition": "I.Tam Đại Nguyện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đại Ngũ Tiểu Bộ", "definition": "Tam Đại bộ chỉ cho Diệu Pháp Liên Hoa Kinh Văn Cú 10 quyển, Diệu Pháp Liên Hoa Kinh Huyền Nghĩa 10 quyển và Ma Ha Chỉ Quán 10 quyển. Còn Ngũ tiểu bộ thì chỉ cho Quán Vô Lượng Thọ Phật Kinh Sớ 1 quyển, Kim Quang Minh Kinh Huyền Nghĩa 2 quyển, Kim Quang Minh Kinh Văn Cú 6 quyển, Quán Âm Huyền Nghĩa 2 quyển và Quán Âm Nghĩa Sớ 2 quyển.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đại Tam Thiên Thế Giới", "definition": "Triple-thousand great-thousand worlds.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tam Đại Thật Lục", "definition": "(三代實錄, Sandaijitsuroku): một trong Lục Quốc Sử (六國史), 50 quyển, còn gọi là Nhật Bản Tam Đại Thật Lục (日本三代實錄, Nihonsandaijitsuroku). Đây là bộ sử thư kế thừa sau Văn Đức Thật Lục (文德實錄, Montokujitsuroku), được viết theo thể biên niên, ghi lại những sự kiện trong vòng 30 năm của thời đại của 3 vị Thiên Hoàng là Thanh Hòa (清和, Seiwa), Dương Thành (陽成, Yōsei) và Quang Hiếu (光孝, Kōkō). Công trình này mất trong vòng 30 năm, từ tháng 8 năm 858 (niên hiệu Thiên An [天安] thứ 2) cho đến tháng 8 năm 887 (niên hiệu Nhân Hòa [仁和] thứ 3), do nhóm Đằng Nguyên Thời Bình (藤原時平, Fujiwara-no-Tokihira), Đại Tạng Thiện Hành (大藏善行) phụng sắc chỉ soạn. Vào năm 901 (niên hiệu Diên Hỷ [延喜] thứ 1), bộ này được hoàn thành và trình lên triều đình.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tam Đại Thừa", "definition": "三大乘 (Kim Quang Minh Kinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đạo", "definition": "三道 (Kim Quang Minh Kinh Huyền Nghĩa. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đạo Bảo Giai", "definition": "Cũng gọi Tam Đạo Bảo Thê.Ba bậc thềm báu bằng vàng, bạc và lưu li, tức là 3 bậc thềm mà Đức Phật bước xuống khi Ngài từ cung trời Đao Lợi trở lại nhân gian.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đạo Khổ", "definition": "Tam đạo cũng gọi là Luân hồi tam đạo, cũng gọi là Tam luân, bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tam Đạt Đức", "definition": "三達徳. Ba nết tốt lớn, gồm Nhân, Trí và Dũng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Đảo", "definition": "三島. Ba hòn đảo ở biển Bột hải, tương truyền là nơi thần tiên ở, gồm Bồng lai, Phương trượng và Doanh châu. Đoạn trường tân thanh có câu: “Trên tam đảo dưới cửa tuyền, tìm đâu thì cũng biết tin rõ ràng” Tên một ngọn núi ở Bắc phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Đầu Chế", "definition": "三頭制. Chế độ chính trị, trong đó việc quốc gia được giao phó cho ba người đứng đầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Đẳng", "definition": "三等. Ba hạng Hạng thứ ba.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tam Đẳng Chí", "definition": "Cũng gọi Tam Định.Chỉ cho 3 tính chất: Vị, tịnh và Vô Lậu của 8 thứ thiền định căn bản:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đẳng Lưu", "definition": "三等旒(Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đế", "definition": "三諦 (Pháp Hoa Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đế Tương Tức", "definition": "Chỉ cho Tam đế Không, Giả, Trung viên dung bất nhị của Viên Giáo Thiên Thai, khác với Tam đế cách lịch của Biệt Giáo. [X. Ma Ha Chỉ Quán Q.3, thượng]. (xt. Tam Đế).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Địa", "definition": "I.Tam Địa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Định Tụ", "definition": "Phạm: Trayo-ràzaya. Pàli: Tayo ràsì.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đồ", "definition": "Trois voies three destinies 三塗", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Đồ Chi Xuyên", "definition": "Cũng gọi Tam Đồ Hà, Tam Lại Xuyên, Độ Hà, Táng Đầu Hà. Chỉ cho bến Nại Hà. Bến này nằm ở nửa đường đi đến cõi U Minh. Tương truyền, sau khi chết được 7 ngày, vong linh người chết phải đi qua bến này. Ở đây có 3 dòng thác chảy êm đềm, và chảy cuồn cuộn khác nhau, tức thác Sơn Thủy, thác Thâm Uyên và thác có cầu bắc ngang. Người chết tùy theo nghiệp đã tạo lúc còn sống, phải đi qua 1 trong 3 dòng thác này. Ba dòng thác này gọi là Tam Đồ. Trên bờ thác có 1 cái cây rất to gọi là Y Lãnh Thụ (cây lãnh áo), trên cây có 2 con quỉ cư trú, đó là Đoạt Y Bà (bà cướp áo) và Huyền Y Ông (ông treo áo). Khi vong linh người chết đi qua đây, 2 con quỉ này cướp lấy y phục của họ rồi đem treo lên cành cây Y Lãnh, tùy theo tội lỗi tạo tác lúc sinh tiền nặng, nhẹ khác nhau mà cành cây rũ xuống cũng có cao, thấp khác nhau. Thuyết này nói trong Kinh Thập Vương. Nhưng kinh này bị giới nghiên cứu cho là kinh giả, nên thuyết này chẳng phải đã có từ Ấn Độ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Đồ Đối Tam Độc", "definition": "三涂對三毒 (Từ Bi Thuỷ Sám)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Độc", "definition": "三毒 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đức", "definition": "三德 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tam Đức Lục Vị", "definition": "三德六味", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tam Ư", "definition": "Chỉ cho 3 thứ Sở Y (chỗ nương, điểm tựa). Ư nghĩa là chỗ nương. Đại Sư Gia Tường thuộc Tông Tam Luận dựa vào 3 thứ sở y mà thành lập 3 thứ Nhị Đế:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ưng Cúng Dường", "definition": "Chỉ cho 3 đối tượng mà chúng sinh nên cúng dường, đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tam Ấn - Tam Pháp Ấn", "definition": "Ba Con Dấu. Con dấu dùng để chứng nhận một sự việc là thật, chắc chắn, đáng tin tưởng. Vậy từ ngữ “con dấu” (ấn) ở đây có nghĩa là chân lí, là điều chân thật được chứng ngộ và nói ra bởi bậc Giác Ngộ (Phật) mà người học trò của Phật phải tin tưởng, phải thường quán niệm để có được một nhận thức sáng tỏ về thực tại. Tất cả giáo lí nào phát biểu đúng với nội dung ba con dấu này đều là Phật pháp. Tất cả mọi nhận thức không phù hợp với ba con dấu này đều là sai lạc, tà ngụy.", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Tam Ứng Cúng Dường", "definition": "三應供養 (Tăng Nhất A Hàm Kinh )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tamper", "definition": "Cái đầm đất", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tan Mất", "definition": "Antaradhāyati (antara + dhe + a), antaradhāna (trung), antaradhāyana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tan Rã", "definition": "Bhaṅga (nam), bhedeti (bhid + e), lujjana (trung), nirujjhati (ni + rudh + ya), vipajjati (vi + pad + ya), vipajjana (trung), vilīyati (vi + lī + ya), vilīyana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tandem", "definition": "Cách bố trí trước sau", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tang", "definition": "丧. Như chữ Tang 喪.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Bạch Bì", "definition": "桑白皮. Vỏ trắng của rễ cây dâu, dùng làm vị thuốc bắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Bồng", "definition": "桑蓬. Nói tắc của chữ Tang hồ bồng thỉ 桑弧蓬矢, cây cung bằng gỗ dâu và mũi tên bằng cỏ bồng, chỉ sự tung hoành vùng vẫy của kẻ nam nhi. Tục Trung Hoa thời xưa, nhà quyền quý sinh con trai thì người cha lấy cung dâu tên bồng bắn đi bốn phương. Thơ Nguyễn công Trứ: “Sạch nợ tang bồng mới kể người”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Bộc", "definition": "桑濮. Nói tắt của chữ Tang gian bộc thượng 桑間濮上 (trong đám ruộng dâu và trên bờ sông, chỗ trai gái hẹn hò gặp gỡ), chỉ việc trai gái không đứng đắn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Chế", "definition": "喪制. Phép tắc luật lệ về việc ma chay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Chủ", "definition": "喪主. Người đứng ra lo việc ma chay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Chứng", "definition": "贓證. Đồ vật dùng làm bằng cớ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Cứ", "definition": "贓據. Như Tang chứng 贓證.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Diên Tự", "definition": "Tạng: Bsam-yas. Gọi đủ: Bsam-yas mi-gyur Ihungyis grupai gsug-lag-khaí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tang Du", "definition": "桑楡. Cây dâu và cây du, lại có thuyết cho rằng Tang du là tên một loại cây. Tương truyền ở phía cực Tây có nhiều cây Tang du, mặt trời tới đó thì lặn. Chỉ tuổi già, Tụng Tây hồ phú của Nguyễn Huy Lượng: “Ngoài năm tuần thẹn bóng tang du”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Gia", "definition": "喪家. Nhà có người chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Gian Bộc Thượng", "definition": "桑間濮上. Xem Tang bộc 桑濮.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Hải", "definition": "桑海. Xem Tang thương 桑蒼.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Hồ Bồng Thỉ", "definition": "桑弧蓬矢. Xem Tang bồng 桑蓬.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Kí Sinh", "definition": "桑寄生. Loài cây nhỏ sống bám trên cây dâu, dùng làm vị thuốc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Lễ", "definition": "喪禮. Cách thức định sẵn về việc ma chay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Phương Ca Mã Cáp Nhã Ni Khang", "definition": "Sang Hyang Kamahàyànikan.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tang Phục", "definition": "喪服. Quần áo mặc trong việc ma chay và thời gian tưởng nhớ người chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Sấn", "definition": "Phạm: Dakwiịà. Cũng gọi Dã Bố Thí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tang Thương", "definition": "桑蒼. Nói tắt của Tang điền thương hải 桑田蒼海 (ruộng dâu biến thành biển xanh), chỉ sự thay đổi ở đời. Cung oán ngâm khúc: “Tang thương đến cả hoa kia cỏ này”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Thương Ngẫu Lục", "definition": "桑蒼偶錄. Tên một cuốn sách của Phạm Đình hổ và Nguyễn Án, hai danh sĩ thời Nguyễn Sơ, nội dung nói về lịch sử, địa lí và phong tục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Trai", "definition": "喪齋. Việc ma chay. Đoạn trường tân thanh: “Nào là khâm liệm nào là tang trai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Trung", "definition": "桑中. Trong ruộng dâu, chỉ việc hẹn hò giữa trai gái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Trung Chi Lạc", "definition": "桑中之樂. Cái sướng trong ruộng dâu, chỉ việc trai gái ăn nằm lén lút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Trùng", "definition": "桑蟲. Con sâu ở cây dâu, ăn béo ngon.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Táng Nghi Qui", "definition": "Nghi thức xử lí có tính tông giáo đối với người chết, bao gồm: An táng(chôn cất), tấn nghi (bỏ xác vào quan tài), cử ai (cất tiếng khóc)...", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tang Tích", "definition": "贓迹. Dấu vết làm bằng cho sự gian tham.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Tử", "definition": "桑子. Cây dâu và cây tử, hai loại cây thường trồng trước sân nhà. Chỉ quê hương. Tự tình khúc của Cao Bá Nhạ: “Câu thơ tang tử giữa đường càng đau”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Vật", "definition": "贓物. Đồ ăn trộm Đồ vật tiền của đút lót Đồ vật dùng làm bằng cớ để kết tội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tang Điền Thương Hải", "definition": "桑田蒼海. Xem Tang thương 桑蒼.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tangential", "definition": "Đường tiếp tuyến", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tanha", "definition": "Desire as a chief culprit = lòng ham muốn chính là thủ phạm Tanha is a Buddhist term that literally means \"thirst,\" and is commonly translated as craving or desire. Within Buddhism, tanha is defined as the craving or desire to hold onto pleasurable experiences, to be separated from painful or unpleasant experiences, and for neutral experiences or feelings not to decline. In the first teaching of the Buddha on the Four Noble Truths, the Buddha identified tanha as a principal cause in the arising of dukkha", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tantalize", "definition": "Dầy vò, đầy đọa", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tantamount", "definition": "Tương đương với, có giá trị như", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tantra", "definition": "Refers to the Vajrayana or Diamond Vehicle (Kinh Kim Thừa). The inner teaching of Mahayana Buddhism, used to progress rapidly on the path to enlightenment… A form of practice whose origin is attributed to the Buddha", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tantrum", "definition": "Cơn thịnh nộ, cơn cáu kỉnh, cơn giận", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tao", "definition": "傮. Xong một lần. Một lần. Một lượt Gắng sức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Dưỡng", "definition": "搔癢. Gãi ngứa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Khang", "definition": "糟糠. Bã rượu và gạo tấm, đồ ăn của người nghèo. Chỉ người vợ lấy mình từ thuở nghèo nàn. Đoạn trường tân thanh: “Mặn tình cát luỹ nhạt tình tao khang”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Khách", "definition": "騷客. Chỉ người giỏi văn thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Ngộ", "definition": "遭遇. Gặp gỡ tình cờ, không định trước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Nhân", "definition": "騷人. Như Tao khách 騷客.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Nhã", "definition": "騷雅. Văn thơ hay như bài Li Tao của Khuất Nguyên và các bài thơ trong các thiên Đại nhã, Tiểu nhã của kinh Thi Chỉ tài văn chương Nói về cử chỉ ngôn ngữ êm tai đẹp mắt của người có học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Phùng", "definition": "遭逢. Gặp gỡ không hẹn trước. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành: “Nhưng tiếc cho tạo hoá khéo vô tình, ngàn năm một hội tao phùng, phận thuỷ có phận chung sao chẳng có”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tao Tì La", "definition": "Phạm: Parisràvaịa.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tao Đà Kì Lê", "definition": "Phạm: Sodàgiri (?). Hán dịch: Dự Sơn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tao Đầu", "definition": "搔頭. Gãi đầu Vò đầu, dáng lo nghĩ bối rối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tapas", "definition": "Put up (hành hạ) with the extremes of heat and cold, hunger and thirst without complaint and to control words and gestures, which must never betray the inner thought…", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tara", "definition": "A female meditational deity who is regarded as the embodiment of all the Buddha’s enlightened activity (Green Tara = protection; White Tara = healing and longevity practices). The Goddess of the lotus:", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tarry", "definition": "Delay", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tassel", "definition": "Tua, núm tua (buộc ở gối, khăn trải bàn…)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tathagata", "definition": "An epithet of the Buddha, which literally means ‘He who has gone thus’ (who has disappeared).", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tatra majjhattata", "definition": "Quân bình nội tâm. Một khía cạnh của tâm xả.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Tavatimsa", "definition": "Cõi trời Đao Lợi còn gọi là cõi trời Tam thập tam thiên: cõi trời của ba mươi ba vị trời. Đây là cõi trời mà Đức Phật thuyết vi diệu pháp cho Phật mẫu nghe. Hoàng hậu Maya sau khi chết tái sinh vào cõi trời này.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Taxonomy", "definition": "Study of general principles of scientific classification. Sự phân loại trong sinh vật học", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tay", "definition": "Hattha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Taṇhā", "definition": "Một trăm lẻ tám ái.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Taṇhāsaṅkhaya Sutta", "definition": "và Mahā*.", "source": "Tu-Dien-Danh-Tu-Rieng-Pali-Chon-Quan-Tran-Ngoc-Loi-Dich"}
{"term": "Teeming", "definition": "Thừa thải, dồi dào", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Teepee", "definition": "(Or tepee) . Lều hình nón làm bằng da xúc vật cuả người da đỏ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Teja", "definition": "Năm uy lực, quyền năng áp chế được nghịch cảnh", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Tekicchakārī Thera", "definition": "kāni) Thera. Ông là con của Bà la môn Subandhu; ông được sanh ra đời nhờ tài của lương y nên được gọi như vậy. Lúc Tekicchakārī trưởng thành, cha ông bị cận thần của Candagutta là Cāṇakka ganh tị vì tài trí vượt bực của ông, nên bị bỏ vô ngục thất. Sợ liên luỵ, Tekicchakārī bỏ trốn vô sống với các Tỳ kheo ẩn tu trong rừng và sau đó gia nhập Tăng Đoàn. Bấy giờ Tỳ kheo Tekicchakārī luôn sống lộ thiên, không bao giờ ngủ và không màng nóng lạnh. Māra giả làm người chăn bò đến dụ dỗ ông, nhưng ông quyết tâm và sau đó đắc Thiền chứng thành A la hán.", "source": "Tu-Dien-Danh-Tu-Rieng-Pali-Chon-Quan-Tran-Ngoc-Loi-Dich"}
{"term": "Telepathy", "definition": "Communication from one’s mind to other = thần giao cách cảm", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tem", "definition": "Muddā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Temerity", "definition": "Táo bạo, liều lĩnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Temperament", "definition": "Tính khí của một người", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tenet", "definition": "Học thuyết, giáo điều", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Teo Lại", "definition": "Saṅkucati (saṃ + kuc + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Terebinth", "definition": "Dầu thông", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tether", "definition": "Dây cột con vật, cột chặc, trói buộc", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tevijja", "definition": "Tam minh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Tha", "definition": "Xem Tối cao.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Duyên Giác Tâm", "definition": "Xem Tha Hóa Tự Tại Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Hóa Thiên", "definition": "Xem Tha Hóa Tự Tại Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Hóa Tự Tại Thiên", "definition": "Paramimmita-vaśavatti (P), Paramimmitavaśavartin (S), Heaven of Free Enjoyment of Others' Manifestations, Paranirmita-vasavattīdevaloka (P), Vaśavartin (S), Tha Hóa Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Hóa Tự Tại Thiên Tử Ma", "definition": "Xem Thiên Ma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Hương", "definition": "他鄉. Quê người. Đoạn trường tân thanh: “Bơ vơ lữ thấn tha hương đề huề”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tha Hậu", "definition": "他 後. Về sau, mai sau. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tha Lực", "definition": "Tariki (S), External power, Other-power.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Lực Tín", "definition": "Faith of the other-power.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Nga Thanh Lương Tự", "definition": "(嵯峨清涼寺, Sagaseiryō-ji) hay Thanh Lương Tự (清涼寺, Seiryō-ji): ngôi chùa của Tịnh Độ Tông, hiện tọa lạc tại số 46 Sagashakadōfujinoki-chō (嵯峨釈迦堂藤ノ木町), Sakyō-ku (右京區), Kyōto-shi (京都市), Kyōto-fu (京都府); hiệu núi là Ngũ Đài Sơn (五台山), thường được gọi là Tha Nga Thích Ca Đường (嵯峨釋迦堂). Tượng thờ chính của chùa là Thích Ca Như Lai (quốc bảo). Ban đầu chùa thuộc về Hoa Nghiêm Tông, rồi sau đến Thiên Thai, Chơn Ngôn, Niệm Phật Tông, nhưng hiện tại thì thuộc về Tịnh Độ Tông. Ngôi chùa này nguyên sơ là sơn trang của Hoàng Tử Nguyên Dung (源融), con của Tha Nga Thiên Hoàng (嵯峨天皇, Saga Tennō, tại vị 809-823), sau đó được cải thành chùa với tên là Thê Hà Tự (棲霞寺). Đến năm 987 (niên hiệu Vĩnh Diên [永延] thứ nhất), vị Tăng Điều Nhiên (奝然) lấy bức tượng Thích Ca đem từ nhà Tống về tôn trí tại đây, sau đó vào năm 1016, khi Điều Nhiên qua đời, thì cao đệ là Thạnh Toán (盛算) mới theo di chí của sư huynh mà tiếp tục khai sáng chùa. Nguyên bản tên chùa Thê Hà Tự hiện vẫn còn lưu lại ở A Di Đà Đường. Tượng Thích Ca đứng bằng gỗ ở chùa này cao 6 mét, có hình tướng đặc dị nhất ở Nhật, tương đương với tượng Phật ở Mathura, Ấn Độ, là loại tượng gỗ bằng Chiêu Đàn. Tượng thờ chính của chùa là A Di Đà Phật, một danh tác vào đầu thời đại Đằng Nguyên, được gọi là Tha Nga Quang Phật (嵯峨光佛). Chùa này cũng đã mấy lần bị hỏa tai cháy rụi, các đường vũ hiện tại là những kiến trúc do vị trú trì Nghiêu Trấn Hòa Thượng (堯鎭和上) tái tạo nên theo mệnh lệnh của Tướng Quân Đức Xuyên Cương Cát (德川綱吉, Tokugawa Tsunayoshi) vào khoảng niên hiệu Văn Lộc (文祿, 1592-1596). Quần thể kiến trúc hiện tại của chùa có Chánh Điện, Tàng Kinh Các, Dược Sư Đường, Linh Bảo Tháp, Sơn Môn, Cổ Tháp, v.v. Chùa còn lưu giữ nhiều bảo vật thuộc dạng quốc bảo hay tài sản văn hóa trọng yếu như tượng đứng Thích Ca Như Lai, bằng gỗ, do Điều Nhiên tạc nên vào năm 985 tại Khai Nguyên Tự (開元寺) ở Đài Châu (台州), khi đang còn ở bên nhà Tống cầu pháp; tượng ngồi A Di Đà Tam Tôn, bằng gỗ, nguyên lai là tượng thờ chính của Thê Hà Tự, được hoàn thành vào năm 896, nhân lễ Húy Kỵ của Hoàng Tử Nguyên Dung; 16 bức tranh màu trên lụa tượng Thập Lục La Hán, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tha Nga Thiên Hoàng", "definition": "(嵯峨天皇, Saga Tennō, tại vị 809-823): vị Thiên Hoàng sống đầu thời Bình An, hoàng tử của Hoàn Võ Thiên Hoàng (桓武天皇, Kammu Tennō), tục danh là Thần Dã (神野, Kamino). Ông đã từng biên tập bộ Hoằng Nhân Cách Thức (弘仁格式), Tân Soạn Tánh Thị Lục (新撰姓氏錄), rất sở trường về văn chương Hán Thi, và soạn nên bộ Văn Hoa Tú Lệ Tập (文華秀麗集), Lăng Vân Tập (菱雲集). Ngoài ra, ông lại rất giỏi về Thư Đạo", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tha Nhân", "definition": "他人. Người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tha Phương", "definition": "他方. Như Tha hương 他鄉.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tha Thiết", "definition": "Abhigijjhati (abhi + gidh + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tha Thọ Dụng Thân", "definition": "Body for the sake of beings.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Thời Hậu Nhật", "definition": "他 時 後 日. Mai kia mốt nọ, ngày sau. Tiết Nham Đầu Hòa Thượng trong TĐT q. 7 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tha Thụ Dụng Thân", "definition": "他受用身", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Tha Thụ Dụng Độ", "definition": "Độ là cõi đât. Các đức Phật có những cõi đất do các Ngài lập ra để cứu độ chúng sinh, được sinh về cõi đất của các Ngài. Còn cõi nước của riêng các đức Phật tự thụ dụng, thì chúng ta thật sự không thể biết.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tha Thứ", "definition": "Titikkhā (nữ), vijahati (vi + hā + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tha Tâm Luân", "definition": "Xem Chiên Niệm Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Tâm Thông", "definition": "Paracetah-paryayajñāna-saksat-kriyabhijñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Tâm Thị Hiện", "definition": "Xem Chiên Niệm Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Tâm Trí", "definition": "Paracittā-jñāna (S), Knowing the other's mind, Cetopariyañāṇa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Tì Lị", "definition": "Xem Trưởng Lão.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Tỳ", "definition": "Xem Tha Tỷ Lượng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Tỷ Lượng", "definition": "Pararthanumāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tha Đà", "definition": "蹉 跎. Lầm lỗi, sai sót. Chương Thập huyền đàm trong CĐTĐL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thai", "definition": "台. Tên một ngôi sao Xem Di.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thai Bàn", "definition": "胎盤. Cái nhau của đàn bà đẻ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thai Giáo", "definition": "胎教. Dạy con từ lúc con còn ở trong bụng mẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thai Nghén", "definition": "Gahaṇī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thai Sanh", "definition": "Jarāyuva (S), Born from foetus, Jalābuja (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thai Sản", "definition": "胎產. Có mang và sinh đẻ. Truyện Trê Cóc: “Tới khi thai sản thành hình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thai Tạng Giới", "definition": "Gọi đủ là “Đại bi thai tạng sinh”, là một trong hai bộ căn bản của Mật Giáo. Từ “thai tạng” hàm ý chứa đựng, nhiếp giữ, bao che, bảo hộ. Hành Giả bắt đầu phát tâm, như chủng tử của thức, được mẫu thai chứa giữ, bảo hộ, cho đến khi các căn đầy đủ thì sinh ra đời; rồi trưởng thành, học các thứ kĩ năng, sau đó sẽ xây dựng sự nghiệp; cũng như y vào lí tính vốn sẵn có nơi chúng sinh mà học muôn hạnh đại bi, hiển bày tịnh tâm, phát khởi phương tiện, tự lợi lợi tha, rốt ráo viên mãn, gọi đó là “đại bi thai tạng sinh”. Bởi vậy, “thai tạng” là chỉ cho lí tính vốn có nơi chúng sinh, và pháp môn bình đẳng của lí tính gọi là “Thai-tạng giới”; đối lại, pháp môn sai biệt của trí tuệ thì gọi là “Kim-cương giới”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thai Tạng Giới Mạn Đà La", "definition": "Xem Thai Tạng Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thai Tạng Giới tu Cửu phương tiện sám hối và Kim Cương Giới tu Ngũ hối sám hối.", "definition": "I.Cửu Phương Tiện.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tham", "definition": "(參). Chữ “tham” nghĩa là dự vào, nghiên cứu, tìm cầu học hỏi. Học trò xin yết kiến thầy để hỏi đạo, gọi là “tham yết” hay “tham vấn”; thực tập thiền quán gọi là “tham thiền”. Trong thiền môn, khi đại chúng vân tập để nghe sư trụ trì khai thị, thuyết giáo, cũng gọi là “tham” – vào buổi sáng thì gọi là “tảo tham”; vào buổi xế chiều gọi là “vãn tham”; tọa thiền trước thời khóa tụng gọi là “tọa tham”; lên giảng đường theo định kì gọi là “đại tham”; lên giảng đường vào lúc bất thường gọi là “tiểu tham” v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tham Biện", "definition": "參辦. Góp mặt mà làm việc Tên một chức vụ tại công sở thời Pháp thuộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Bão", "definition": "參 飽. Còn gọi: Bão Tham. Ngộ được toàn phần. Tham bão nhân: Người tham học Phật pháp đạt đến chỗ triệt ngộ như người đói được ăn no. Thung Dung Lục q. 1 (Đại 48, 235 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Bảng", "definition": "參 榜. Còn gọi: Tham Trạng, Môn Trạng. Tấm danh thiếp sẽ được đưa ra khi đến yết kiến một vị thiền sư. Kích thước của tham bảng là: 1,8 x 2,1dm, tên họ đề phía trên, khoảng giữa chừa trống, lấy chỉ cột nơi chính giữa của mép trên, cuốn vào từ bên trái.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Chiến", "definition": "參戰. Dự vào việc đánh nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Chính", "definition": "參政. Dự vào việc nước. Ra làm quan.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Cứu", "definition": "參 究. Suy xét, tìm tòi tra cứu thiền pháp. Tiết Thế Kỳ Thủ Tọa trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Dịch", "definition": "Cũng gọi là “Chứng Phạn ngữ”, là một trong chín vị pháp sư thuộc hội đồng phiên dịch ở Trung-quốc thời xưa (xem mục “Dịch Kinh”), giữ nhiệm vụ đối chiếu giữa Phạn văn và Hán văn, coi chỗ nào đúng, chỗ nào sai.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tham Dục", "definition": "Thèm muốn.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Dục Cái", "definition": "Vaga-āvaraṇa (S), Rāga-āvaraṇa (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tham Dục Tam Chủng Phát Tướng", "definition": "貪欲三種發相 (Thích Thiền Ba La Mật Thứ Đệ Pháp Môn)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Tham Dự", "definition": "參預. Góp mặt vào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Gia", "definition": "參加. Góp mặt thêm vào với người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Huyền", "definition": "參 玄. Còn gọi: Tham Thiền. Tìm tòi tra cứu huyền nghĩa. Phần Khai thị Duy Na Như trong Duy Tắc Ngữ Lục q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Hạ", "definition": "參 暇. Còn gọi: Tham Giả. Thiền tăng xin phép ra khỏi thiền viện trong khoảng thời gian 15 ngày. Oánh Sơn Thanh Qui, q. hạ (Đại 82, 447 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Hậu", "definition": "參 後. Còn gọi: Tham Thối. Đối lại: Tham Tiền. Thời gian sau lúc tham vấn, niệm tụng buổi chiều. Điều Tọa Thiền trong Sắc Tu Bách Trượng Thanh Quy q. 5 (Đại 48, 1142 hạ) ghi: “參 後 坐 禪 如 常。", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Học", "definition": "參 學. 1. Gọi đủ: Tham Thiền Học Đạo. Sau khi thiền giả đi thưa hỏi về phong cách, quy củ của các Tông phái trong thiền viện, vị này liền nương theo một vị Minh sư để học tập. Trong bài thơ Hoàn Trấn Thành tiễn Thượng nhân Giản Tuyền đi du phương có câu:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Học Nhãn", "definition": "參 學 眼. Con mắt trí huệ thấu rõ mọi vật, chỉ người tham thiền mới có. Như Tịnh Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Khảo", "definition": "參考. Tìm kiếm xem xét nhiều thứ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Khấu", "definition": "參 扣. Còn gọi: Tham vấn. Ra mắt Thiền Sư và thưa hỏi thiền pháp. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Kiến", "definition": "Tà kiến sinh ra từ lòng tham.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Lam", "definition": "貪婪. Ham tiền bạc và ham ăn uống, chỉ chung sự ham muốn không biết chán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Lam Quá Độ", "definition": "Mahātaṇha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tham Luận", "definition": "參論. Dự phần vào bàn xét một việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Muốn", "definition": "Rati (S), Lust.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tham Mê", "definition": "Rāga (S), Greed, Lobha (S), Tanhā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tham Mưu", "definition": "參謀. Dự phần vào việc bàn xét một việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Nghị", "definition": "參議. Dự phần bàn xét và quyết định.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Nhiễm", "definition": "Lòng tham làm ô nhiễm, nhơ bẩn thân tâm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Nhũng", "definition": "貪冗. Ham muốn tiền bạc và hạch sách đòi hỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Phược", "definition": "Rāga-bandhana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tham Quá", "definition": "Mahiccha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tham Sanh", "definition": "Upādhi (S), Clinging to rebirth.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tham Sân Si", "definition": "Ba phiền não gốc, đẻ ra mọi thứ phiền não khác.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Sự", "definition": "參事. Dự phần vào công việc Tên một chức việc tại công sở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Thiền", "definition": "參禪. Dự vào việc yên lặng, một phép tu đạo của nhà Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Thiền Đáo Gia", "definition": "參 禪 到 家. Tham thiền đến nhà, chỉ cho đã lãnh ngộ thiền pháp, đã nhận rõ tự tâm tự tính. Tiết Nghệ Ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Thoại Đầu", "definition": "Chữ “tham” hay chữ “khán” là một thuật ngữ Thiền học, có nghĩa là chỉ nhìn đối tượng một cách chăm chú mà không phát ra tiếng nói. Đối tượng nổi hiện thường trực trên ý thức, và hành giả dùng trí tuệ để chiếu soi nó, cho tới khi thấy được chân tướng của nó tức là được khai ngộ. “Thoại đầu” cũng là một thuật ngữ Thiền học, chỉ cho một câu nói được dùng làm đề tài tham cứu cho hành giả trong lúc thực tập thiền quán. Những lời dạy của Phật trong kinh điển, những lời huấn thị của các vị tổ sư ngộ đạo, những lời đối đáp giữa các vị thiền sư, đều là những pháp tắc, mô phạm mà các hành giả trong thiền môn phải lấy đó để chiêm nghiệm, tu tập, nhờ đó mà được khai ngộ. “Khán thoại đầu” (hay tham thoại đầu) tức là dùng trí tuệ để chiêm nghiệm, quán chiếu một lời dạy của Phật, một câu nói của bậc tổ sư ngộ đạo, cho đến khi toàn vẹn yếu nghĩa của nó bùng vỡ, đó là lúc hành giả được khai ngộ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Tham Thỉnh", "definition": "參 請. Còn gọi: Thỉnh Ích, Tham Thiền Biện Đạo. Người học đạo thiền đi đến chỗ của vị Thiền Sư kiến tính để thưa hỏi và thọ giáo về đại ý Phật pháp. Phần Khám Biện trong Lâm Tế Lục (Đại 47, 504 trung) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Tiền", "definition": "參 前. Chỉ khoảng thời gian trước giờ tham thiền tụng niệm buổi chiều, hoặc khoảng thời gian trước lúc phỏng tham. Điều Đạt Ma Kị trong Sắc Tu Bách Trượng Thanh Quy q. 2 (Đại 48, 117 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Trước", "definition": "Greed and attachment", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Tham Trọc", "definition": "Trọc là nhơ bẩn. Sự nhơ bẩn ở lòng tham và hành động tham. Cũng đọc là xam. Tham dự vào.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Tàn", "definition": "貪殘. Ham muốn không chính đáng và độc ác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Tá", "definition": "參佐. Dự phần vào để giúp đỡ Tên một chức việc tại công sở thời Pháp thuộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Tán", "definition": "參賛. Dự phần vào việc bàn kế hoạch quân sự Tên một chức quan võ thời xưa. Hát nói của Nguyễn Công Trứ: “Khi Thủ khoa, khi Tham tán, khi Tổng đốc Đông”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Tập", "definition": "Tham lam mãi thành thói quen.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Tập Nhân", "definition": "Thói quen tham lam, thành nghiệp nhân ác, dẫn tới sau khi mạng chung phải đọa xuống các cõi ác.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Tỉnh", "definition": "(參省): Tham (參) ở đây nghĩa là xem xét, quan sát; tỉnh (省) là phản tỉnh, nhìn lại chính mình. Từ này vốn xuất xứ từ trong Thiên Khuyến Học (勸學篇) của Tuân Tử (荀子): “Quân tử bác học nhi nhật tham tỉnh hồ kỉ, tắc tri minh nhi hành vô quá hỉ (君子博學而日參省乎己、則知明而行無過矣, người quân tử học rộng mà mỗi ngày kiểm điểm lại mình thì trí tuệ mới sáng suốt và hành vi sẽ không có lỗi lầm).” Đối với Thiền Tông, tham tỉnh có nghĩa là đến tham học Thiền pháp với bậc cao đức nào đó và được vị ấy làm cho tỉnh ngộ; tương đương với nghĩa của tham học (參學), tham vấn (參問). Như trong Thiên Thánh Quảng Đăng Lục (天聖廣燈錄, 卍 Tục Tạng Kinh Vol. 78, No. 1553) quyển 17, phần Tương Châu Cốc Ẩn Sơn Uẩn Thông Từ Chiếu Thiền Sư (襄州谷隱山蘊聰慈照禪師) có câu: “Sư ly Bách Trượng, chí Nhữ Châu tham tỉnh Niệm Thiền Sư (師離百丈、至汝州參省念禪師, sư rời Bách Trượng, đến Nhữ Châu tham học với Thiền Sư Niệm).” Hay như trong Thiền Tông Tụng Cổ Liên Châu Thông Tập (禪宗頌古聯珠通集, 卍Tục Tạng Kinh Vol. 65, No. 1295) quyển 30, phần Nhữ Châu Nam Viện Huệ Ngung Thiền Sư (汝州南院慧顒禪師) có đoạn: “Hậu ư Vân Môn hội hạ, văn biệt tăng cử thử thoại, phương ngộ chỉ, khước hồi tham tỉnh, sư dĩ viên tịch, toại lễ Phong Huyệt Hòa Thượng (後於雲門會下、聞別僧舉此話、方悟旨、卻回參省、師已圓寂、遂禮風穴和尚, sau nhân trong hội chúng của Vân Môn, ông nghe có vị tăng nọ nêu ra câu chuyện này, mới ngộ được yếu chỉ; liền quay về tham học, nhưng thầy đã qua đời, ông bèn lạy Hòa Thượng Phong Huyệt làm thầy).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tham Từ Tạ Hạ", "definition": "參 辭 謝 賀. Lời cảm ơn hoặc chúc mừng của vị Giám viện đối với tăng quan vừa mãn nhiệm hoặc các tăng quan mới nhậm chức. Thiền Uyển Thanh Quy q. 3 (Vạn Tục 111, 445 hạ):", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Vấn", "definition": "參 問. Ra mắt Thiền Sư và thưa hỏi thiền pháp. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Vọng", "definition": "Vedayita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tham Ái", "definition": "Greed and infatuation", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Tham Ô", "definition": "貪污. Lòng dạ ham muốn nhơ bẩn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tham Đường", "definition": "參 堂. Vào tăng đường ra mắt Thủ tọa, đại chúng để nhập chúng. Vị tăng hành cước chính thức được thiền viện tiếp nạp gọi là ứng tham đường. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Đầu", "definition": "參 頭. Người đứng đầu các vị tăng hành cước tham thiền. Phần lớn chức vụ này do các vị tăng hơi lớn tuổi đảm nhiệm. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Đồ", "definition": "參 徒. Các thiền tăng. Trung Phong Hòa Thượng Hành Lục trong Trung Phong Quảng Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Đồ Biểu Quyết", "definition": "Sách do thiền sư Viên Chiếu đời Lý soạn, bao gồm nhiều câu đối đap giữa thiền sư Viên Chiếu và các đệ tử của mình.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Tham Đồng Khế", "definition": "參 同 契. Tụng, 1 thiên gồm hơn 200 chữ, do Thạch Đầu Hy Thiên trứ tác. Trong thiên thi ca này, Thạch Đầu ca ngợi trạng thái ngộ vượt lên tất cả các tính nhị nguyên. Tham Đồng Khế thường được đọc tụng trong các thiền viện của tông Tào Động.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tham Độc", "definition": "Lòng tham ví như thuốc độc, làm hư hỏng thân tâm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Than", "definition": "嘽. Thở hổn hển, thở mạnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Than Chì", "definition": "Abbhaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Than Khóc", "definition": "Ādeva (nam) ādevanā (nữ) ārodanā (nữ), akkandati (ā + kand + a), akkandana (trung), anutthunāti (anu + thu + nā), anutthunana (trung), parideva (nam), paridevati (pari + dev + a), thūnāti (thu + nā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Than Oán", "definition": "(Lời nói), Resentful words", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Than Phiền", "definition": "Anusocati (anu + suc + a), anusocana (trung), ujjhāpeti (u + jhe + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Than Van", "definition": "Akkandati (ā + kand + a), akkandana (trung), anutthunāti (anu + thu + nā), anutthunana (trung), anusocati (anu + suc + a), anusocana (trung), nitthunana (trung), nitthunāti (ni + thu + nā), vippalapati (vi + pa + lap + a), vilapati (vi + lap + a), vilāpa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thang", "definition": "湯. Nước nóng Phỏng vì quá nóng (dùng trong Bạch thoại) Tên người, tức vua Thành Thang nhà Thương. Câu đối của Cao Bá Quát: “Mục dã Minh điền hữu Vũ thang” Ta còn hiểu là thứ nước nấu lá để uống chung với thuốc mà trợ lực cho thuốc. Đoạn trường tân thanh: “Kẻ thang người thuốc bời bời” Món canh (Bạch thoại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thang Dụng Đồng", "definition": "湯 用 彤 (1893-1946). Học giả Phật giáo hiện đại, tự Tích Dư, người Hoàng Mai, Hồ Bắc, Trung Quốc. Năm 1917, ông tốt nghiệp tại Thanh Hoa học đường. Năm sau sang Hoa Kỳ học tập Phạn văn, Pali văn tại Đại học Harvard. Năm 1922 sau khi về nước, ông lần lượt nhận chức Giáo sư Đại học Đông Nam ở Nam Kinh, Đại học Nam Khai, Đại học Bắc Kinh, Tây Nam Liên Đại. Sau giải phóng (1949), ông làm Hiệu phó trường Đại học Bắc Kinh. Từ tuổi 20, ông đã nghiên cứu Phật giáo sử Trung Quốc, đồng thời nghiên cứu Triết học sử ấn Độ để đối chiếu vối sự nghiên cứu Phật giáo sử Trung Quốc. Nhờ nắm được tài liệu đặc sắc và phong phú nên ông đã kết hợp được phương pháp nghiên cứu theo truyền thống Trung Quốc với phương pháp nghiên cứu tiên tiến cận đại Tây phương. Tác phẩm chủ yếu: Hán Ngụy Lưỡng Tấn Nam Bắc Triều Phật Giáo Sử, Tùy Đường Phật Giáo Sử Cảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thang Giới", "definition": "(湯界): cõi nước nóng sôi sùng sục, tức chỉ cho Địa Ngục, như trong 18 cõi địa ngục có 18 Địa Ngục Vạc Nước Sôi (十八鑊湯地獄, Thập Bát Hoạch Thang Địa Ngục).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thang Tuyền Tam Duyên", "definition": "湯泉三緣 (Kế Cổ Lược)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thangka", "definition": "Tranh vẽ các vị thần, Bồ-tát của Tây Tạng dùng quán chiếu khi thiền. A scroll painting which depicts deities or illustrations such as the Wheel of life, and is used for visualization and meditational purposes… Picture(s)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thanh", "definition": "Śabda (S), Sound, Sadda (P), Nīla (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Biện", "definition": "Bhavaviveka : là vị đại luận sư của học phái Trung Quán thuộc Phật giáo đại thừa ở Nam Ấn-độ vào đầu thế kỉ thứ 6 TL. Có thuyết nói ngài xuất thân từ vương tộc của nước Mạt-lị-da-na (Malyara) ở Nam-Ấn; có thuyết lại nói ngài thuộc chủng tánh quí tộc của nước Ma-kiệt-đà ở Trung- Ấn. Ban đầu ngài học theo ngoại đạo, đặc biệt nghiên cứu về học thuyết phái Số Luận. Sau ngài bỏ ngoại đạo, theo Phật giáo, đến Trung-Ấn thờ ngài Tăng Hộ (Samgharaksita) làm thầy, tinh cần tu học kinh điển đại thừa, đặc biệt chuyên tâm nghiên cứu giáo nghĩa của hai vị Bồ Tát Long Thọ và Đề Bà. Sau đó ngài trở về Nam-Ấn, lấy nước Đà-na-yết-trách-ca (Dhanakataka) làm trung tâm hành đạo. Tại đây, ngài chuyên tuyên dương giáo nghĩa Thực Tướng luận (cũng tức là Không tông) của Bồ Tát Long Thọ, và bài xích Duyên Khởi luận (cũng tức là Hữu Tông) của đại luận sư Hộ Pháp (Dharmapala) ở nước Ma-kiệt-đà; tạo nên phong trào “Tranh luận giữa Không và Hữu” (Không Hữu tranh luận). Cuối đời, ngài vào ẩn cư trong một hang núi ở phía Nam nước này, chuyên trì chân ngôn cho đến khi viên tịch. Truớc tác quan trọng của ngài có Đại Thừa Chưởng Trân Luận (thuyết minh giáo nghĩa “hữu vi không, vô vi không”), Bát Nhã Đăng Luận Thích (giải thích Trung Luận của ngài Long Thọ), và Trung Quán Tâm Luận Tụng (được truyền sang Tây-tạng).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thanh Biện Bồ Tát", "definition": "Bhāvaviveka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Bình", "definition": "清平. Yên lặng bằng phẳng, không có gì xảy ra. Bản dịch Chinh phụ ngâm khúc: “Nước thanh bình ba trăm năm cũ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Bình Linh Tuân", "definition": "Ching ping Ling tsun (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Bạch", "definition": "清白. Trong sạch, không nhơ bẩn. Chỉ cảnh nghèo nhưng cao quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Bần", "definition": "清貧. Nghèo mà trong sạch. Truyện Lục Vân Tiên: “Thanh bần giữ phận yên vui”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Bẩm", "definition": "清 稟 (895-976). Thiền tăng đời Ngũ Đại, họ Lý, người Tuyền Châu, Phúc Kiến, Trung Quốc. Sư nối pháp thiền sư Văn Yển, thuộc tông Vân Môn đời thứ 2, trụ thiền viện Quang Mục theo chiếu chỉ của Nam Đường Trung Chủ. Sau khi vào nội cung ở Trừng Tâm Đường soạn sách “Chư Phương Ngữ Yếu” sư được Hậu Chủ sắc trụ trì thiền viện Phổ Lợi ở Động Sơn (ở Nghi Phong, Giang Tây).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Cao", "definition": "清高. Trong sạch, vượt người thường Còn chỉ cuộc sống đẹp tốt hơn người. Đoạn trường tân thanh: “Cho thanh cao mới được phần thanh cao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Chuyên Tháp", "definition": "青 磚 塔. Là tháp Trừng Linh, chùa Lâm Tế, huyện Chính Định, tỉnh Hà Bắc, Trung Quốc, do tháp có màu gạch xanh lam nên còn gọi “Thanh Chuyên Tháp”. X. “Lâm Tế Tự Trừng Linh Tháp”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Chuyết", "definition": "清 拙. Hiệu của Thiền tăng Chính Trừng sống vào đời Nguyên. X. Chính Trừng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Chuyết Chánh Trừng", "definition": "(清拙正澄, Seisetsu Shōchō, 1274-1339): vị tăng của phái Dương Kì và Phá Am thuộc Lâm Tế Tông Trung Quốc, tổ của Phái Đại Giám (大鑑 派), hiệu là Thanh Chuyết (清拙), biệt hiệu là Tất Cánh Giảm (畢竟減), xuất thân Liên Giang (連江), Phúc Châu (福州, Tỉnh Phúc Kiến), họ Lưu (劉). Năm 15 tuổi, ông theo xuất gia với người bác Nguyệt Khê Viên (月溪圓) ở Báo Ân Tự (報恩寺) và năm sau thọ cụ túc giới tại Khai Nguyên Tự (開元寺). Ông đã từng đến tham học nơi pháp tịch của Bình Sở Tủng (平 楚 聳), rồi đến Tịnh Từ Tự (淨 慈 寺) ở Triết Giang (浙江), bái yết Ngu Cực Trí Tuệ (愚極智慧) và sau khi vị nầy qua đời ông kế thừa dòng pháp của Phương Sơn Văn Ngọc (方山文玉). Sau đó, ông cũng từng đến tham vấn chư vị cao tăng khác như Hổ Nham (虎巖) ở Linh Ẩn (靈隱), Đông Nham (東巖) ở Dục Vương (育王), Nguyệt Đình (月庭) ở Tương Sơn (蔣山) và Hư Cốc Hy Lăng (虛谷希陵) ở Ngưỡng Sơn (仰山). Cuối cùng ông bắt đầu khai đường giáo hóa ở Kê Túc Sơn (雞足山) để báo đáp ơn giáo dưỡng của Ngu Cực Trí Tuệ, rồi dời đến Chơn Tịnh (眞 淨) ở Tùng Giang (松 江). Vào năm thứ 3 (1326, tức Gia Lịch nguyên niên) niên hiệu Thái Định (泰定), nhận lời triệu thỉnh của họ Bắc Điều (北 條), ông cùng với đệ tử Vĩnh Kỳ (永錤) sang Nhật Bản và trú tại Kiến Trường Tự (建 長 寺, Kenchō-ji). Sau đó, ông cũng sống qua các chùa như Tịnh Trí (淨 智), Viên Giác (圓覺), nhưng rồi lại trở về dựng Thiền Cư Am (禪居庵) trong khuôn viên Kiến Trường Tự. Vào năm thứ 3 (1333) niên hiệu Nguyên Hoằng (元弘), ông chuyển đến Kiến Nhân Tự (建仁寺, Kennin-ji) ở kinh đô Kyoto, rồi qua Nam Thiền Tự (南禪寺, Nanzen-ji). Thể theo lời thỉnh cầu của tín đồ Tiểu Lạp Nguyên Trinh Tông (小笠原貞 宗), ông đến làm trú trì đời thứ nhất tại Khai Thiện Tự (開善寺) vùng Y Hạ Lương (伊賀良), Tín Nùng (信濃, Shinano, thuộc Nagano-ken), nhưng không bao lâu ông lại lui về Thiền Cư Am. Sau đó, vâng sắc mệnh hoàng triều, ông đến trú trì Kiến Nhân Tự lần nữa và đến ngày 17 tháng giêng năm thứ 2 niên hiệu Lịch Ứng (曆應), ông thị tịch, hưởng thọ 66 tuổi đời và 53 hạ lạp. Ông được ban cho thụy hiệu là Đại Giám Thiền Sư (大鑑禪師). Ông có để lại một số trước tác như Thanh Chuyết Hòa Thượng Ngữ Lục (清 拙 和 尚 語 錄), Đại Giám Thanh Quy (大 鑑 清 規), Đại Giám Tiểu Thanh Quy (大鑑小清規), Thanh Chuyết Hòa Thượng Thiền Cư Tập (清拙和 尚禪居集). Đông Lăng Vĩnh Dư (東陵永璵) soạn bài Thanh Chuyết Đại Giám Thiền Sư Tháp Minh (清拙大鑑禪師塔銘).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Chuyết Hòa Thượng Thiền Cư Tập", "definition": "清 拙 和 尚 禪 居 集. Gọi tắt: Thiền Cư Tập. Sách, 2 quyển, do Thanh Chuyết Chính Trừng soạn vào cuối đời Tống đầu đời Nguyên, Vĩnh Ki biên. Thiền Cư là tên cái am tại chùa Kiến Nhân Nhật Bản mà sư Chính Trừng ẩn tu ở đấy. Sách này lấy phần soạn trước khi sang Nhật làm thiên trước, phần sưu tập sau khi sang Nhật làm thiên sau. Nội dung gồm các thể lẫn lộn: Phật Tổ Tán, Tự Tán, Tiểu Phật sự, Đề bạt, Minh, Ký, Tự, Tự thuyết, Sớ, Tế văn v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Châu Bách Vấn", "definition": "青 州 百 問. Sách, 1 quyển. Vào khoảng niên hiệu Tuyên Hòa (1119-1125) đời Tống, Hòa Thượng Nhất Biện ở chùa Phổ Chiếu Thanh Châu lúc trụ chùa Đại Vạn Phật, tập họp chư tăng mười phương nêu ra cương tông đặt 100 câu để hỏi đại chúng. Trong chúng có sư Từ Vân Giác Toại của chùa Thập Thân trả lời được tất cả. Sau đó, Lâm Tuyền Tùng Luân ở dưới mỗi câu hỏi đáp có phụ 1 bài tụng và tập thành sách này, được xếp vào Tục Tạng Kinh tập 119, trang 345. Sách này cùng một thể loại với Thung Dung Lục, đều là tập sách bình xướng công án, tuyên bày tông phong Tào Động. Đời sau thường đem sách này cùng với “Thông Huyền Bách Vấn” của Thông Huyền Viên Thông (Đệ tử của Nhất Biện) hợp thành “Thông Huyền Thanh Châu Nhị Bách Vấn” và ấn hành để phổ biến.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Chúng", "definition": "清 眾. Tăng chúng. Chương “Thiền Môn Quy Thức” trong CĐTĐL q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Chơn Giáo", "definition": "Mahometism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Cánh Quan Âm", "definition": "Xem Thanh Cảnh Quán Thế Âm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Cư", "definition": "Seikyo (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Cảnh", "definition": "Śabda-visaya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Cảnh Quán Âm Bồ Tát", "definition": "Nīlakantha (S), Nīlakanthi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Củng", "definition": "清 珙 (1272-1352). Thiền tăng đời Nam Tống, họ Ôn, hiệu Thạch ốc, người xứ Ngu Sơn (Thường Thục, Giang Tô) Trung Quốc. Nối pháp Thiền Sư Cập Am Tín, đời thứ 23 hệ Nam Nhạc. Sư kết am tranh ở núi Hà Vụ thuộc Hồ Châu, Chiết Giang. Có kệ sơn cư lưu truyền lại đời, về thơ thì có “Nguyên Thi Tuyển”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Danh", "definition": "清名. Tiếng tăm trong sạch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Du", "definition": "清遊. Rongchơi trong cảnh sáng sủa đẹp đẽ. Bài Chiến Tụng Tây hồ phú của Phạm Thái: “Xem hồ quang đà không dấu thanh du”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Dung Phu Nhân", "definition": "Priyadarsika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Dạ", "definition": "清夜. Đêm vắng lặng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Dục", "definition": "清 昱 (?-975). Thiền tăng đời Ngũ Đại, người xứ Vĩnh Gia (nay là Ôn Châu tỉnh Chiết Giang) Trung Quốc, nối pháp Quốc sư Đức Thiều ở núi Thiên Thai, thuộc tông Pháp Nhãn. Ngô Việt Trung Hiến Vương triệu sư vào cung hỏi đạo, cho dựng chùa Phụng Tiên ở Hàng Châu rồi thỉnh sư ở đó. Vua ban hiệu “Viên Thông Diệu Giác Thiền Sư”. Có vị tăng hỏi: Thế nào là ý Tổ sư từ ấn Độ sang? Sư đáp: Lên tiếng chỉ dạy đại chúng. 清 欲 (1288-1363). Thiền tăng đời Nguyên, họ Chu, tự Liễu Am, hiệu Nam Đường, người xứ Lâm Hải, Thai Châu (nay thuộc tỉnh Chiết Giang) Trung Quốc. Lúc 9 tuổi, sư thọ tang cha. Đến 16 tuổi sư theo Hổ Nham Tịnh Phục xuất gia, dự thi kinh điển được độ làm tăng. Sư nghe lời khuyên của Tri tạng Tùng Hi Bạch Minh, đến chùa Khai Nguyên ở Tô Châu yết kiến Cổ Lâm Thanh Mậu, nhiều lầm tham vấn, nghi tình tan vỡ, sư liền khế ngộ và nối pháp ngài. Niên hiệu Hoàng Khánh thứ 1 (1312), Thanh Mậu lại ra trụ trì chùa Khai Nguyên, Thanh Dục theo làm thị giả cho Ngài. Sau đó sư trở về Kính Sơn, nhậm chức Thủ tọa trong pháp hội của ngài Hư Cốc Hy Lăng. Khi Thanh Mậu trụ trì chùa Bảo Ninh, sư làm Đệ nhất tọa. Sau khi thầy tịch, sư lui về ẩn ở chùa Khai Phúc. Năm 1333, sư dời đến chùa Bản Giác tại Gia Hưng (nay thuộc Chiết Giang) ở được 10 năm. Người thời ấy tôn sư làm Đông am Đại pháp tràng (ngọn cờ pháp lớn ở miền đông nam), giới trí thức quan lại hỏi đạo nơi sư rất nhiều. Vua ban hiệu “Từ Vân Phổ Tế Thiền Sư” và y Kim lan. Năm 1345, sư ở chùa Linh Nham tại Ngô Trung. Về già, sư lui về ở ẩn nơi viện Từ Vân. Tác phẩm: Liễu Am Thanh Dục Thiền Sư 9 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Giá", "definition": "(聲價): bên cạnh ý nghĩa thanh danh và giá trị, nó còn có nghĩa là sự bình phẩm, mến chuộng, yêu thích. Cho nên trong cuốn Thượng Hàn Kinh Châu Thư (上韓荊州書) của Lý Bạch (李白) có đoạn rằng: \"Nhất đăng Long Môn, thanh giá thập bội\" (一登龍門、聲價十倍, Một lần lên Long Môn thì yêu thích gấp mười lần).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Giáo", "definition": "Giáo pháp được Phật và các vị Bồ-tát nói ra thành lời, có âm thanh cho người nghe mà tu tập, gọi là “thanh giáo”. Thanh là một trong sáu cảnh, và là đối tượng của nhĩ căn. Tùy theo nhiều loại người hay chúng sinh khác nhau, thích dùng phương tiện gì để dễ tu tập, thì Phật dùng phương tiện đó để chỉ bày giáo pháp. Những phương tiện đó có thể là hình sắc (sắc cảnh – đối tượng của mắt), âm thanh (thanh cảnh – đối tượng của tai), mùi hương (hương cảnh – đối tượng của mũi), v.v... Vì vậy mà Phật có thể dùng cả sáu cảnh để làm phương tiện giáo hóa chúng sinh (lục trần thuyết pháp).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thanh Giản", "definition": "清 簡. Thiền tăng đời Tống, họ Trương, người xứ Tiền Đường (nay là Hàng Châu) Trung Quốc, nối pháp Thiền Sư Quy Tông Nghĩa Nhu, thuộc tông Pháp Nhãn. Sư trụ chùa Thiên Đồng ở Minh Châu (nay là huyện Ninh Ba, tỉnh Chiết Giang). Do tính tình sư giản dị, trong sạch, nên người đời gọi sư là “Giản Chiết Khách”. Có vị tăng hỏi: Thế nào là ý Tổ sư từ ấn Độ sang? Sư đáp: Đạt Ma chẳng thể sang Trung Hoa lần nữa. Về già, sư ở chùa Tuyết Đậu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Hanh", "definition": "Thiền sư trụ trì chùa Vĩnh Nghiêm Bắc Việt Nam, vào nửa đầu thế kỷ XX. Thường gọi là Tổ Vĩnh Nghiêm. Là nhà sư có công lớn trong việc chấn hưng Phật giáo Việt Nam tại Bắc Bộ, đã cho sưu tầm và in lại nhiều tác phẩm Phật giáo, do các tác giả Phật giáo Việt Nam soạn từ đời nhà Trần trở về sau. Như cuốn Thiền tông bản hạnh của Chân Nguyên được in lại năm 1931, cuốn Tuệ Trung Thượng Sĩ ngữ Lục, năm 1903, hai cuốn Pháp Hoa đề cương và Bát Nhã Tâm Kinh trực giải của thiền sư Đạo Tôn Minh Chánh, năm 1934.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thanh Hiên Tiền Hậu Tập", "definition": "清軒前後集. Tên hai tập thơ chữ Hán của Nguyễn Du, danh sĩ đời Nguyễn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Hiển Luận", "definition": "Abhivyakti-vada (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Hoá", "definition": "清化. Tên tỉnh ở phía Bắc, Trung phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Hòa Thiên Hoàng", "definition": "(清和天皇, Seiwa Tennō, tại vị 858-876): vị Thiên Hoàng sống vào đầu thời kỳ Bình An, Hoàng Tử thứ 4 của Văn Đức Thiên Hoàng (文德天皇, Montoku Tennō), mẹ là Đằng Nguyên Minh Tử (藤原明子), tên là Duy Nhân (惟仁, Korehito), còn gọi là Thủy Vĩ Đế (水尾帝). Khi ông lên ngôi còn nhỏ tuổi, nên ông ngoại là Đằng Nguyên Lương Phòng (藤原良房, Fujiwara-no-Yoshifusa) làm Nhiếp Chính. Ông quy y theo Phật Giáo và xuất gia năm 879 (niên hiệu Nguyên Khánh [元慶] thứ 3), với pháp húy là Tố Chơn (素眞).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Hư Đại Đế", "definition": "(清虛大帝): một trong Tam Quan (三官), là Địa Quan Đại Đế (地官大帝), gọi đủ là Trung Nguyên Xá Tội Địa Quan Nhị Phẩm Thanh Hư Đại Đế (中元赦罪地官二品清虛大帝), Trung Nguyên Nhị Phẩm Xá Tội Địa Quan Thanh Hư Đại Đế (中元二品赦罪地官清虛大帝); lệ thuộc Thượng Thanh Cảnh (上清境). Địa Quan do khí nguyên động hỗn linh hòa với tinh màu vàng kết thành, chủ quản tất cả các cõi thần tiên của Ngũ Đế, Ngũ Nhạc. Ngày đản sanh của vị này là Rằm tháng Bảy. Vào ngày này, Địa Quan xuống nhân gian, chỉnh đốn tội phước và ân xá tội cho người; nên được gọi là Địa Quan Xá Tội (地官赦罪).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Hải", "definition": "青海. Biển xanh Tên đất thuộc Mông Cổ, giáp tỉnh Cam Túc. Bản dịch Chinh phụ ngâm khúc: “Mai Hồ vào Thanh Hải nhòm qua”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Hằng", "definition": "青 恒 (1785-1855). Thiền tăng đời Thanh, họ Trần, tự Cự Siêu, hiệu Tá Am, người xứ Hải Ninh, Chiết Giang, Trung Quốc. Nối pháp Thiền Sư Trừng Đào, đời thứ 42 hệ Thanh Nguyên. Trụ trì chùa Vân Lâm. Tác phẩm: Tá Am Tập, Thanh Hằng Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Hộ", "definition": "清 護 (916-970). Thiền tăng đời Ngũ Đại, họ Trần, người Trường Lạc, Phúc Châu (Phúc Kiến) Trung Quốc. Năm 6 tuổi xuất gia nơi Quốc sư Thần Yến ở Cổ Sơn, ngay dưới lời liền tỏ ngộ. Phong độ thanh thoát cao vút, Nam Đường Hậu Chủ khâm phục đức hạnh sư thỉnh về Kim Lăng (Nam Kinh) trụ trì 2 chùa Báo Ân và Tịnh Đức. Ban hiệu “Sùng Nhân Đại Sư”, còn có hiệu “Diệu Hạnh Thiền Sư”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Khiết", "definition": "清潔. Sạch sẽ trong trắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Khoát", "definition": "清 豁. Thiền tăng đời Ngũ Đại, người xứ Phúc Châu, Trung Quốc. Thuở bé sư thông minh, lễ Cổ Sơn Thần Yến Quốc sư, cạo tóc thụ giới cụ túc. Sư còn tham yết Như Am chủ ở núi Đại Chương. Sau đó sư tham vấn Thiền Sư Thùy Long Đạo Phổ và đắc pháp. Sư ở viện Bảo Phúc, Chương Châu (nay là huyện Chương Phố, tỉnh Phúc Kiến). Lúc tuổi già sắp tịch, sư dặn đệ tử đừng xây tháp, rồi vào núi ngồi thị tịch.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Khách", "definition": "清客. Một tên chỉ hoa mai.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Khâm", "definition": "青襟. Vạt áo màu xanh. Chỉ người học trò, vì thời xưa, học trò Trung Hoa mặc áo xanh. Tài tử đa cùng phú của Cao Bá Quát: “… Quyết ném thanh khâm sang cẩm tú”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Khí", "definition": "聲氣. Do câu: “Đồng thanh tương ứng, đồng khí tương cầu”, chỉ sự hoà hợp với nhau. Đoạn trường tân thanh: “Lạ gì thanh khí lẽ hằng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Không", "definition": "青空. Khoảng trống màu xanh, chỉ bầu trời. Ta cũng đọc thinh không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Kiểu", "definition": "清 皎 (906-993). Thiền tăng đời Tống, họ Vương, người xứ Phúc Châu, Trung Quốc. Sư thờ Thiền Sư Bạch Triệu Chí Viên làm thầy, theo học và đắc pháp nơi Ngài. Ban đầu sư ở núi Đại Dương (nay ở phía Bắc Kinh sơn, tỉnh Hồ Bắc) rồi dời đến chùa Huệ Nhật ở An Châu (nay là An Lục, tỉnh Hồ Bắc). Sau đó, sư trụ trì Ngũ Tổ Sơn ở Kỳ Châu (nay là huyện Kỳ Xuân, tỉnh Hồ Bắc).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Kính", "definition": "清 鏡 (1790-1870). Thiền tăng đời Thanh, họ An, tự Siêu Nhiên, người xứ Đan Dương, Giang Tô, Trung Quốc. Nối pháp Thiền Sư Trừng Lãng ở Thượng Hải, đời thứ 42 hệ Thanh Nguyên. Trụ trì chùa Đảm Vân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Liêm", "definition": "清廉. Trong sạch, tham lam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Liên", "definition": "Upala (S), Cyan lotus.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Liên Long Vương", "definition": "Utpalaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Liễu", "definition": "清 了 (1090-1151). Thiền tăng đời Tống, họ Ung, tự Chân Hiết, người An Xương, Miên Châu, Trung Quốc. Sư nối pháp thiền sư Tổ Chiếu (Pháp Nhất), thuộc tông Tào Động đời thứ 10, trụ Trường Lô, Chân Châu (Nghi Trưng, Giang Tô). Thụy hiệu: Ngộ Không Thiền Sư. Có Ngữ Lục lưu hành ở đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Long", "definition": "(青龍): tên gọi của cây đao báu được Quan Công thường đeo bên mình, còn gọi là Thanh Long Yển Nguyệt Đao (青龍偃月刀). Nhờ cây đao này, Quan Công đã từng tạo những chiến công hiển hách như chém Hoa Hùng (華雄), Phách Nhan Lương (劈顏良), Tru Văn Xú (誅文醜), v.v.; cho nên người Trung Quốc cũng thần thánh hóa và xem nó như là Tướng Quân Võ Thánh. Trong Tam Quốc Diễn Nghĩa (三國演義), hai người con của Quan Công là Quan Hưng (關興) và Quan Sách (關索) cũng cầm cây đao này. Như trong bài thơ Quá Ngũ Quan Trảm Lục Tướng (過五關斬六將) có câu: “Quải ấn phong kim từ Hán tướng, tầm huynh diêu vọng viễn đồ hoàn, mã kỵ Xích Thố hành thiên lý, đao yển Thanh Long xuất ngũ quan (掛印封金辭漢相、尋兄遙望遠途還、馬騎赤兔行千里、刀偃青龍出五關, treo ấn niêm phong thôi Hán tướng, tìm anh xa tít muôn dặm đàng, cỡi ngựa Xích Thố đi vạn nẻo, Thanh Long đao xếp ra cửa quan).” Sau này, khi điêu khắc hay tạc vẽ hình tượng của Quan Công đều có hình tay cầm cây Thanh Long Yển Nguyệt Đao này. Ngoài ra, Thanh Long còn gọi là Thương Long (蒼龍). Trong truyền thống văn hóa của Trung Quốc, Thanh Long là một trong Tứ Tượng (四象). Căn cứ học thuyết Ngũ Hành, Thanh Long đại biểu cho loại linh thú ở phương Đông, là con rồng có màu xanh. Phương vị của sao này nằm ở phương Đông, đại biểu cho mùa Xuân. Trong 28 chùm sao theo quan niệm của Trung Quốc, Thanh Long là tên gọi chung của 7 ngôi sao ở phương Đông, gồm: Giác (角), Cang (亢), Để (氐), Phòng (房), Tâm (心), Vĩ (尾) và Ky (箕). Hình trạng của 7 ngôi sao này rất giống một con rồng. Trong phần Tạp Ứng (雜應) của Bão Phác Tử (抱朴子) có đề cập đến Tiên Kinh (仙經) chỉ dẫn cho cách khi vẽ hình Thái Thượng Lão Quân thì bên trái phải có 12 con Thanh Long, bên phải có 26 con Bạch Hổ, phía trước 24 con Châu Tước và phía sau là 72 Huyền Võ. Sau này, Tứ Tượng được nhân cách hóa và phong hiệu như vậy. Theo Bắc Cực Thất Nguyên Tử Diên Bí Quyết (北極七元紫延秘訣) cho biết rằng Thanh Long hiệu là “Mạnh Chương Thần Quân (孟章神君)”, Bạch Hổ hiệu “Giám Binh Thần Quân (監兵神君)”, Châu Tước là “Lăng Quang Thần Quân (陵光神君)” và Huyền Võ là “Chấp Minh Thần Quân (執明神君).” Trong cuốn Nhạc Dương Phong Thổ Ký (岳陽風土記) của Phạm Trí Năng (範致能) nhà Tống có đoạn rằng: “Lão Tử từ hữu nhị thần tượng, vị Thanh Long, Bạch Hổ dã (老子祠有二神像、謂青龍、白虎也, tại đền thờ Lão Tử có hai tượng thần là Thanh Long và Bạch Hổ).” Bên cạnh đó, trong Thường Thục Tư Chí (常熟私志), Thiên Thư Tự Quan (舒寺觀篇) của Diêu Tông Nghi (姚宗儀) cũng có ghi rằng: “Trí Đạo Quán sơn môn nhị đại thần, tả vi Thanh Long Mạnh Chương Thần Quân, hữu vi Bạch Hổ Giám Binh Thần Quân (致道觀山門二大神、左爲青龍孟章神君、右爲白虎監兵神君, đặt tại sơn môn của Đạo Quán hai tượng thần lớn, bên trái là Thanh Long Mạnh Chương Thần Quân, bên phải là Bạch Hổ Giám Binh Thần Quân).” Thái Thượng Hoàng Lục Trai Nghi (太上黃籙齋儀) quyển 44 nhà Minh gọi 7 ngôi sao Thanh Long ở phương Đông là “Giác Tú Thiên Môn Tinh Quân (角宿天門星君), Cang Tú Đình Đình Tinh Quân (亢宿庭庭星君), Đê Tú Thiên Phủ Tinh Quân (氐宿天府星君), Phòng Tú Thiên Tứ Tinh Quân (房宿天駟星君), Tâm Tú Thiên Vương Tinh Quân (心宿天王星君), Vĩ Tú Thiên Kê Tinh Quân (尾宿天雞星君), và Ky Tú Thiên Luật Tinh Quân (箕宿天律星君)”. Về hình tượng của Thanh Long, Đạo Môn Thông Giáo Tất Dụng Tập (道門通敎必用集) quyển 7 có giải thích rằng: “Rồng nhả mây nuốt khí, phun sấm sét phát ra tiếng, bay khắp Tám Cực, chu du Tứ Minh.” Lại nữa, bộ Linh Cấp Thất Thiêm (靈笈七籖) quyển 72 có dẫn rằng: “Thanh Long là Giáp, Ất, Mộc, Thủy, Ngân ở phương Đông, lắng trong mà không chút gợn, quậy lên mà không đục, đến gần không thể lấy được, cách xa chẳng thể bỏ qua, tiềm tàng biến hóa vô tận, nên gọi là rồng”. Tục ngữ có câu rằng: “Nam tánh sanh thực khí vô âm mao, tại quá khứ dã khiếu thanh long (男性生殖器無陰毛、在過去也叫青龍, người nam sanh ra dương vật không có lông, tại vì đời trước gào thét Thanh Long).” Ngoài ra, dân gian thường cho rằng rồng có tánh dâm, nên khi nó hòa hợp với bò thì sinh ra kỳ lân, với con heo thì sinh ra con voi.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Long Tháp", "definition": "清 龍 塔. Còn gọi: Kiết Vân Thiền Tự Tháp. ở thị trấn Cổ Thanh Long, huyện Thanh Phố, thành phố Thượng Hải, Trung Quốc. Thời kỳ Đường Tống thị trấn này là bến cảng mua bán với bên ngoài, thương nhân tụ tập, có tên gọi “Tiểu Hàng Châu”. Niên hiệu Thiên Bảo thứ 2 (743) đời Đường xây dựng chùa Báo Đức. Niên hiệu Trường Khánh thứ 2 (822) đổi tên là “Long Phúc Tự”, và xây tháp tại trong chùa. Khoảng niên hiệu Khánh Lịch (1041-1048) đời Tống tháp hư hủy được xây dựng lại. Tháp hình bát giác 7 tầng, thân gạch mái gỗ. Từ Nam Tống trở đi, sông Thanh Long dần dần bị lấp, thị trấn cũng suy vi, chỉ lưu lại đây một ngôi tháp điêu tàn. Khi vua Khang Hy đời Thanh đi Nam tuần, sắc phong chùa Long Phúc là “Kiết Vân Thiền Tự”, một lần nữa thắp lại hương khói.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Lâm Sư Kiền", "definition": "(青 林 師 虔, Seirin Shiken, ?-904): họ Trần (陳), xuất thân Hàng Châu (杭州, Tỉnh Triết Giang), đã từng đắc pháp với Động Sơn Lương Giới (洞山良 价). Ông trú tại Thanh Lâm (青林), Hán Đông (漢東), sau đó làm vị tổ đời thứ 3 của Động Sơn (洞山, Tỉnh Giang Tây). Vào năm đầu niên hiệu Thiên Hựu (天祐), ông thị tịch. Trước tác của ông có Huyền Cơ Thị Hối Tập (玄機示誨集).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Lâu", "definition": "青樓. Chỉ nơi bán phấn buôn hương. Đoạn trường tân thanh: “Thanh lâu hai lượt, thanh y hai lần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Lương", "definition": "(738-839): tức Trừng Quán, một vị danh tăng đời Đường, Trung-quốc. Ngài quê huyện Thiệu-hưng, tỉnh Triết-giang, họ Hạ-hầu, tự Đại Hưu, hiệu Thanh Lương. Năm 11 tuổi, ngài xin xuất gia với thiền sư Bái ở chùa Bảo-lâm; đến 14 tuổi được thế độ. Từ năm 758 (20 tuổi) trở đi, ngài theo học Luật với luật sư Lễ ở chùa Thê-hà, và luật sư Đàm Nhất ở Nhuận-châu; rồi lại theo học Tam Luận với ngài Huyền Bích ở Kim-lăng. Sau đó ngài lại đi các nơi để tham học về Luận Đại Thừa Khởi Tín, Tam Luận, Kinh Niết Bàn, Kinh Hoa Nghiêm, Kinh Pháp Hoa, Kinh Duy Ma, thiền pháp Nam-tông, thiền pháp Bắc-tông, v.v... Ngoài ra, ngài còn nghiên cứu các kinh điển Phệ Đà, ngũ minh của Ấn-độ, và cả các bộ Kinh, Sử, Tử, Truyện của Trung-hoa. Năm 776, ngài chu du các núi Ngũ-đài, Nga-mi; rồi về trú tại chùa Đại-hoa-nghiêm ở núi Ngũ-đài, chuyên tu Phương Đẳng Sám Pháp. Tại đây, ngài thường giảng dạy về tông chỉ của Kinh Hoa Nghiêm, tiếng tăm lừng lẫy, vang động đến tận triều đình, được vua Đường Đức-tông (780-805) thỉnh về Trường-an dịch kinh. Nhân ngày sinh nhật của vua, ngài được triệu vào cung giảng về tông chỉ Kinh Hoa Nghiêm. Nhà vua nhờ đó mà tỏ ngộ, bèn ban tặng cho ngài danh hiệu Thanh Lương quốc sư. Các vua kế tiếp là Thuận-tông (805) và Hiến-tông (806-820), cũng đều nhờ ngài mà tỏ ngộ đạo lí, cho nên ngài đã được tôn lên tước vị tăng thống quốc sư. Ngài viên tịch năm 839, dưới triều vua Đường Văn-tông (827-840), thế thọ 102 tuổi. Ngài sống trải qua 9 đời vua (Đường Huyền-tông, Túc-tông, Đại-tông, Đức-tông, Thuận-tông, Hiến-tông, Mục-tông, Kính-tông, Văn-tông), trong số đó, tới 7 vị (từ vua Đại-tông đến vua Văn-tông) được ngài giáo hóa. Đệ tử đắc pháp của ngài có hơn trăm vị. Trước tác của ngài rất nhiều: Đại Phương Quảng Phật Hoa Nghiêm Kinh Sớ, Tùy Sớ Diễn Nghĩa Sao, Hoa Nghiêm Kinh Cương Yếu, Ngũ Uẩn Quán, Tam Thánh Viên Dung Quán Môn, v.v... Ngài chuyên về Hoa Nghiêm, nên được tông Hoa Nghiêm Trung-quốc tôn xưng là vị Tổ thứ tư; đồng thời ngài cũng xiển dương pháp môn niệm Phật (như trong bộ Đại Phương Quảng Hoa Nghiêm Kinh Sớ, quyển 56, ngài có nêu ra 5 phương pháp niệm Phật), nên cũng được coi là một trong các vị tôn sư của tông Tịnh Độ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thanh Lương Sơn", "definition": "清 涼 山. Núi Ngũ Đài. Mặc dù vào mùa hè oi bức, nhưng khí hậu ở Ngũ Đài sơn vẫn mát mẻ, nên núi này còn được gọi là Thanh Lương Sơn. X. Ngũ Đài Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Lương Thái Khâm", "definition": "(清 涼 泰 欽, Shōryō Taikin, ?-974): vị tăng của Pháp Nhãn Tông, xuất thân vùng Ngụy Phủ (魏府, Tỉnh Hồ Bắc). Ông đến tham vấn Pháp Nhãn Văn Ích (法眼文益) và kế thừa dòng pháp của vị nầy. Sau đó ông đến sống tại Song Lâm Viện (雙 林 院) ở vùng Hồng Châu (洪 州, Tỉnh Giang Tây), rồi chuyển đến Thanh Lương Tự (清涼寺) ở Kim Lăng (金陵, Nam Kinh). Pháp từ của ông có Vân Cư Đạo Tề (雲居道齊) là nhân vật kiệt xuất. Ông thị tịch vào ngày 24 tháng 6 năm thứ 7 niên hiệu Khai Bảo (開寳) và được ban cho thụy hiệu là Pháp Đăng Thiền Sư (法燈禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Lương Trừng Quán", "definition": "(清涼澄觀, Shōryō Chōkan, 738-839): vị tổ thứ 4 của Thiên Thai Tông Trung Quốc, sống dưới thời nhà Đường, người Sơn Âm (山陰), Việt Châu (越州, Thiệu Hưng, Triết Giang), họ Hạ Hầu (夏候), tự Đại Hưu (大休), hiệu Thanh Lương Quốc Sư (清涼國師), Hoa Nghiêm Bồ Tát (華嚴菩薩), Hoa Nghiêm Sớ Chủ (華嚴疏主). Năm 11 tuổi, ông xuất gia với Bái Thiền Sư (霈禪師) ở Bảo Lâm Tự (寳林寺) và đến năm 14 tuổi thọ giới đắc độ. Từ năm đầu (758) niên hiệu Càn Nguyên (乾元) trở về sau, ông theo Lễ Luật Sư (醴律師) ở Thê Hà Tự (棲霞寺) vùng Nhuận Châu (潤州) học về Luật; rồi lại nương theo Huyền Bích (玄璧) ở Kim Lăng (金陵) học về Tam Luận. Trong khoảng thời gian niên hiệu Đại Lịch (大曆), ông học Đại Thừa Khởi Tín Luận, Niết Bàn Kinh ở Ngõa Quan Tự (瓦官寺). Bên cạnh đó, ông còn theo Hoài Nam Pháp Tạng (淮南法藏) học Hoa Nghiêm Kinh. Năm thứ 7 (772) niên hiệu Đại Lịch, ông đến Diệm Khê (剡溪) theo Huệ Lượng (慧量) ở Thành Đô (城都) học Tam Luận lần nữa. Đến năm thứ 10 cùng niên hiệu trên, ông đến Giang Tô (江蘇), theo Trạm Nhiên (湛然) học Thiên Thai Chỉ Quán, Pháp Hoa Kinh, Duy Ma Kinh, v.v. Ông còn tham yết Duy Trung (惟忠) ở Ngưu Đầu Sơn (牛頭山), Đạo Khâm (道欽) ở Kính Sơn (徑山), v.v., để học về Thiền pháp của Nam Tông, rồi học Thiền pháp của Bắc Tông với Huệ Vân (慧雲). Ngoài ra, ông còn thông cả Phệ Đà, Ngũ Minh, nghi thức bí chú, v.v. Vào năm thứ 11 niên hiệu Đại Lịch, ông đi ngao du Ngũ Đài Sơn (五台山), Nga Mi Sơn (峨嵋山), sau trở về sống tại Đại Hoa Nghiêm Tự (大華嚴寺) trên Ngũ Đài Sơn, chuyên tu Phương Đẳng Sám Pháp. Ông thường giảng tông chỉ Hoa Nghiêm tại chùa này và Sùng Phước Tự (崇福寺), danh tiếng vang khắp kinh đô. Đến năm thứ 12 (796) niên hiệu Trinh Nguyên (貞元), thể theo lời mời của vua Đức Tông, ông vào Trường An (長安), cùng với Tam Tạng Bát Nhã (三藏般若) người Kế Tân (罽賓) dịch Tứ Thập Hoa Nghiêm Kinh (四十華嚴經) do quốc vương Ô Trà (烏茶) dâng cống, rồi đem dâng lên cho triều đình; nhân đó nhà vua rất vui mừng, ban cho Tử Y và hiệu Giáo Thọ Hòa Thượng (敎授和尚). Ngoài ra, ông còn phụng sắc chỉ triều đình chế 10 quyển kinh sớ tại Thảo Đường Tự (草堂寺) thuộc Chung Nam Sơn (終南山) và đây chính là bản Trinh Nguyên Tân Dịch Hoa Nghiêm Kinh Sớ (貞元新華嚴經疏). Vào năm thứ 15 (có thuyết cho là 11) niên hiệu Trinh Nguyên, nhân dịp sinh nhật, vua Đức Tông mời ông vào nội điện, diễn thuyết tông chỉ Hoa Nghiêm, nhờ vậy nhà vua mới giác ngộ, bảo rằng: “nhờ diệu pháp mà làm cho trong sạch, mát mẻ tâm của Trẫm”, cho nên ban cho ông hiệu là Thanh Lương Quốc Sư. Ông đã từng lập ra 10 thệ nguyện để tự khuyên răn mình, cho nên người ta gọi là Thanh Lương Thập Nguyện. Đến khi vua Thuận Tông lên ngôi, vua cũng lấy lễ bái ông làm Quốc Sư, trong triều đình ngoài dân dã đều mến mộ cao phong của ông. Vào năm thứ 5 (810) niên hiệu Nguyên Hòa (元和) đời vua Hiến Tông, ông trả lời các câu vấn đáp của nhà vua, giảng rõ về nghĩa của pháp giới Hoa Nghiêm, được vua hài lòng, bèn tặng cho ông hiệu là Tăng Thống Thanh Lương Quốc Sư (僧統清涼國師). Đến năm thứ 4 niên hiệu Khai Thành (開成), ông thị tịch, hưởng thọ 102 tuổi. Có thuyết cho là ông mất trong khoảng thời gian niên hiệu Nguyên Hòa, hưởng thọ 70 tuổi. Ông được táng trong thạch thất trên Chung Nam Sơn và Tướng Quốc Bùi Hưu (裴休) soạn bia văn. Ông đã trãi qua 9 triều đại, từng giảng kinh cho 7 đời vua, đệ tử có Tông Mật (宗密), Tăng Duệ (僧叡), Pháp Ấn (法印), Tịch Quang (寂光), và đệ tử đắc pháp có hơn 100 người. Trước tác của ông có rất nhiều như Đại Phương Quảng Phật Hoa Nghiêm Kinh Sớ (大方廣佛華嚴經疏) 60 quyển, Tùy Sớ Diễn Nghĩa Sao (隨疏演義鈔) 90 quyển, Hoa Nghiêm Kinh Cương Yếu (華嚴經綱要) 3 quyển, Ngũ Uẩn Quán (五蘊觀), Tam Thánh Viên Dung Quán Môn (三聖圓融觀門), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Lương Tự", "definition": "(清涼寺, Seiryō-ji): xem Tha Nga Thanh Lương Tự (嵯峨清涼寺, Sagaseiryō-ji) (嵯峨清涼寺, Sagaseiryō-ji) hay Thanh Lương Tự (清涼寺, Seiryō-ji): ngôi chùa của Tịnh Độ Tông, hiện tọa lạc tại số 46 Sagashakadōfujinoki-chō (嵯峨釈迦堂藤ノ木町), Sakyō-ku (右京區), Kyōto-shi (京都市), Kyōto-fu (京都府); hiệu núi là Ngũ Đài Sơn (五台山), thường được gọi là Tha Nga Thích Ca Đường (嵯峨釋迦堂). Tượng thờ chính của chùa là Thích Ca Như Lai (quốc bảo). Ban đầu chùa thuộc về Hoa Nghiêm Tông, rồi sau đến Thiên Thai, Chơn Ngôn, Niệm Phật Tông, nhưng hiện tại thì thuộc về Tịnh Độ Tông. Ngôi chùa này nguyên sơ là sơn trang của Hoàng Tử Nguyên Dung (源融), con của Tha Nga Thiên Hoàng (嵯峨天皇, Saga Tennō, tại vị 809-823), sau đó được cải thành chùa với tên là Thê Hà Tự (棲霞寺). Đến năm 987 (niên hiệu Vĩnh Diên [永延] thứ nhất), vị Tăng Điều Nhiên (奝然) lấy bức tượng Thích Ca đem từ nhà Tống về tôn trí tại đây, sau đó vào năm 1016, khi Điều Nhiên qua đời, thì cao đệ là Thạnh Toán (盛算) mới theo di chí của sư huynh mà tiếp tục khai sáng chùa. Nguyên bản tên chùa Thê Hà Tự hiện vẫn còn lưu lại ở A Di Đà Đường. Tượng Thích Ca đứng bằng gỗ ở chùa này cao 6 mét, có hình tướng đặc dị nhất ở Nhật, tương đương với tượng Phật ở Mathura, Ấn Độ, là loại tượng gỗ bằng Chiêu Đàn. Tượng thờ chính của chùa là A Di Đà Phật, một danh tác vào đầu thời đại Đằng Nguyên, được gọi là Tha Nga Quang Phật (嵯峨光佛). Chùa này cũng đã mấy lần bị hỏa tai cháy rụi, các đường vũ hiện tại là những kiến trúc do vị trú trì Nghiêu Trấn Hòa Thượng (堯鎭和上) tái tạo nên theo mệnh lệnh của Tướng Quân Đức Xuyên Cương Cát (德川綱吉, Tokugawa Tsunayoshi) vào khoảng niên hiệu Văn Lộc (文祿, 1592-1596). Quần thể kiến trúc hiện tại của chùa có Chánh Điện, Tàng Kinh Các, Dược Sư Đường, Linh Bảo Tháp, Sơn Môn, Cổ Tháp, v.v. Chùa còn lưu giữ nhiều bảo vật thuộc dạng quốc bảo hay tài sản văn hóa trọng yếu như tượng đứng Thích Ca Như Lai, bằng gỗ, do Điều Nhiên tạc nên vào năm 985 tại Khai Nguyên Tự (開元寺) ở Đài Châu (台州), khi đang còn ở bên nhà Tống cầu pháp; tượng ngồi A Di Đà Tam Tôn, bằng gỗ, nguyên lai là tượng thờ chính của Thê Hà Tự, được hoàn thành vào năm 896, nhân lễ Húy Kỵ của Hoàng Tử Nguyên Dung; 16 bức tranh màu trên lụa tượng Thập Lục La Hán, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Lương Văn Ích", "definition": "(885-958): là vị khai tổ của tông Pháp Nhãn, một trong “năm nhà bảy tông” của Thiền Tông Trung-quốc. Ngài họ Lỗ, người huyện Dư-hàng, tỉnh Triết-giang. Ngài xuất gia khi lên 7 tuổi, chuyên học Luật; về sau theo học thiền pháp với thiền sư Tuệ Lăng (854-932) ở Trường-khánh viện (Phúc-châu), trải thời gian lâu mà không khế ngộ. Tình cờ ngài gặp thiền sư La Hán Quế Sâm (867-928) ở Đàm-châu, bèn tỏ ngộ đắc pháp; từ đó ngài ra sức xiển dương thiền pháp. Về sau, vua nước Nam-Đường (937-9580 – một trong 10 nước thời Ngũ-đại-thập-quốc) kính mộ, thờ ngài làm thầy, thỉnh về Kim-lăng, trú tại thiền viện Báo-ân, ban hiệu là Tịnh Tuệ đại sư. Sau đó, nhà vua lại xin thọ giới với ngài, và xây dựng Thanh-lương già lam để ngài mở đạo tràng giáo hóa đồ chúng; chính nơi đây ngài đã khai sáng thiền phái Pháp Nhãn. Môn nhân của ngài rất đông, trong đó có cả các sư tới từ Nhật-bản và Cao-li. Năm 74 tuổi ngài thị tịch, thụy hiệu là Đại Pháp Nhãn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thanh Lịch", "definition": "清歴. Người tốt đẹp ăn ở từng trải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Lọc", "definition": "Payata (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thanh Minh", "definition": "Śabdavidyā (S), Subdavidyā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Minh Luận", "definition": "Śabdavidyā śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Mậu", "definition": "清 茂 (1262-1329). Thiền tăng đời Nguyên, họ Lâm, tự Cổ Lâm, hiệu Kim Cang Tràng, Lân Cư Tẩu; thường gọi sư là Mậu Cổ Lâm. Nhờ thư pháp mà nổi tiếng khắp nơi. Năm 12 tuổi sư theo Cô Nham Khải chùa Quốc Thanh núi Thiên Thai xuất gia, qua thi kinh luật mà được thụ giới. Sư rất thích thiền tịch và đi du phương khắp nơi, trước sau tham phỏng Giản Ông Kính núi Tuyết Đậu, Thạch Lâm Củng ở Nam Bình, Giác Am Chân ở Thừa Thiên, lại theo học với Hoành Xuyên Như Củng chùa Năng Nhân, tinh tấn tu tập nên lúc 19 tuổi nối pháp làm truyền nhân phái Dương Kỳ tông Lâm Tế. Niên hiệu Đại Đức thứ 2 (1298) sư khai đường thuyết pháp tại Bạch Vân Thiền Tự núi Thiên Bình, Tô Châu. Sau 9 năm dời sang chùa Khai Nguyên. Chẳng bao lâu sư lui vể ở ẩn nơi Tháp viện Thiệu Long núi Hổ Khâu trùng niêm “Bách Tắc Tụng cổ” của Tuyết Đậu Trọng Hiển. Niên hiệu Hoàng Khánh thứ 1 (1312) một lần nữa trụ chùa Khai Nguyên, khi ấy do theo lời mời của Dương Quốc Công, được ban hiệu “Phù Tông Phổ Giác Phật Tính Thiền Sư”. Niên hiệu Diên Hựu thứ 2 (1315) sư dời sang chùa Vĩnh Phúc ở Nhiêu Châu (Ba Dương, Giang Tây). Lại trụ 6 năm chùa Bảo Ninh núi Phụng Đài ở Kiến Khang (Nam Kinh). Tuổi già phụng mạng triều đình, sư mở ra Đại hội Kim Sơn, được vua quan đại phu tôn sùng, kẻ sĩ thứ đến cầu pháp không dưới vài ngàn người. Tính sư cương trực, cơ phong bén nhạy, thủ đoạn cao vút, người học rất kính sợ. Đệ tử nối pháp có Thanh Dục, Lương Du, Phạm Tiên v. v… Tác phẩm: Tục Tông Môn Thống Yếu, Cổ Lâm Thanh Mậu Thiền Sư Ngữ Lục 5 quyển, Cổ Lâm Thanh Mậu Thiền Sư Thập Di Kệ Tụng 2 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Mộ", "definition": "清 慕. Thiền tăng đời Tống, tham vấn Thiền Sư Đạo Hy được ngộ và nối pháp ngài. Sư ở viện Bạch Long tại Thăng Sơn, Phúc Châu. Có một vị tăng hỏi: Thế nào là một cơ mật dụng của Bạch Long? Sư đáp: Mỗi ngày ngươi dùng cái gì?", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Mục", "definition": "Piṅgalanetra (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Nghiêm Đại Sư", "definition": "清 嚴 大 師. Thụy hiệu của Thiền tăng Toàn Khoát, sống vào đời Ngũ Đại. X. Toàn Khoát.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Nghị", "definition": "清議. Lời bàn bạc khen chê. Hát nói của Nguyễn Công Trứ: “Phù thế giáo một vài câu thanh nghị”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Nguyên", "definition": "清 原. Thiền tăng đời Lê trung hưng, thuộc tông Tào Động, đời thứ 41. Sư hiệu Minh Nam, là người viết bài tựa cho sách Pháp Hoa Đề Cương của Thanh Đàm Minh Chính. Hai vị có lẽ có cùng một bản sư. Sau đây là bài kệ của sư tán dương sách Pháp Hoa Đề Cương:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Nguyên Duy Tín", "definition": "Seigen Ishin (J), Ching yuan Wei hsin (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Nguyên Hành Tư", "definition": "(?-740). Ngài họ Lưu, quê ở huyện An-phước, tỉnh Giang-tây, xuất gia từ thuở nhỏ, theo học với Lục Tổ Tuệ Năng, cùng với ngài Hoài Nhượng, được coi là hai vị đệ tử thượng thủ và cùng kế thừa đạo nghiệp của Lục Tổ. Về sau ngài đến trụ tích tại chùa Tĩnh-cư ở núi Thanh-nguyên (tỉnh Giang-tây), nên được xưng là Thanh Nguyên Hành Tư. Tại đây ngài xiển dương thiền pháp của Lục Tổ, môn đồ vân tập tu học đông đảo, lập thành dòng phái gọi là Thanh Nguyên Hạ. Dòng phái này về sau đã sản xuất ra ba pháp phái nổi tiếng khác là các tông Tào Động, Vân Môn và Pháp Nhãn. Ngài viên tịch năm 740, không rõ tuổi thọ, thụy hiệu là Hồng Tế thiền sư.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thanh Nguyên Sơn", "definition": "清 原 山. Núi ở thành phố Cát An, tỉnh Giang Tây, Trung Quốc, nằm cách trung tâm thành phố 15km về hướng đông nam. Từ xưa đến nay núi vẫn tốt đẹp mãi, được làm thắng cảnh du lịch. Các danh nhân như: Nhan Chân Khanh, Tô Đông Pha, Văn Thiên Tường đã từng đến núi này ngoạn cảnh. Thiền Sư Hành Tư, Tổ hệ phái Thanh Nguyên (nối pháp Lục Tổ Huệ Năng) đến đây xây dựng chùa Tĩnh Cư, hoằng dương đạo pháp thiền đốn ngộ phương Nam. Các cổ tích trong núi còn có Tổ quan núi Thanh Nguyên, tháp Thất Tổ, tháp Phi Lai, cầu Đãi Nhật, Điếu đài thạch, đình Ngũ Tiếu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Nguyên Sơn Chí Lược", "definition": "清 原 山 志 略. Chí, 13 quyển, do Tiếu Phong Đại Nhiên biên vào đời Thanh. Thi Nhuận Chương biên tập bổ sung, và được ấn hành vào niên hiệu Khang Hy thứ 8 (1669) đời Thanh. Quyển 1 ghi chép về sơn thủy, đạo tràng. Quyển 2 là tăng truyện, quyển 3 về thư viện, quyển 4-11: gồm các bài minh, thuyết, thư, ký v. v… quyển 12, 13 là tạp ghi. Quyển thủ có phàm lệ gồm 7 tiết do Thi Nhuận Chương soạn, giải thích về đại ý của mỗi quyển, trình bày và phát huy ý nghĩa của việc biên tập thật đặc sắc, giống như 7 tiểu phẩm về triết lý. Các thơ văn, bi minh, du ký của các vị thiền sư nhiều đời trụ núi Thanh Nguyên và các cư sĩ văn nhân mặc khách đều được thu thập vào.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Ngạc", "definition": "清 諤. Thiền tăng đời Ngũ Đại, người xứ Mân, Trung Quốc. Sư thờ Quốc sư Cổ Sơn Thần Yến và đắc pháp, kế vị pháp hội của Ngài. Trong khi làm chủ tùng lâm nhờ sư chỉnh đốn nghiêm túc nên tiếng tăm vang dậy. Hiệu: Tông Hiểu Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Nhàn", "definition": "清閒. Rảnh rang công việc và vi vẻ tâm hồn. Đoạn trường tân thanh: “Buồng riêng sửa chốn thanh nhàn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Nhã", "definition": "清雅. Trong sạch tốt đẹp, không loè loẹt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Nhượng", "definition": "清 讓. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư Ba Tiêu Huệ Thanh thuộc tông Quy Ngưỡng. Sư ở núi Hưng Dương tại Dĩnh Châu (nay là Kinh Sơn, tỉnh Hồ Bắc).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Nhất Tẩu", "definition": "清 一 叟 (1300-1360). Thiền tăng đời Nguyên, họ Lưu, người xứ Tân An (Tuy Ninh, Giang Tô) Trung Quốc. Nối pháp Thiền Sư Kính Sơn Hạnh Đoan, đời thứ 24 hệ Nam Nhạc. Trụ trì Nam Hoa thiền tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Niên", "definition": "青年. Tuổi trẻ. Tuổi xanh. Người đàn ông trẻ tuổi. Truyện Hoa Tiên: “Đẫy đà chắc giá, thanh niêm hiếm tày”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Nữ Ly Hồn", "definition": "倩 女 離 魂. Cô Thanh lìa hồn. Công án này được thấy trong Vô Môn Quan như sau:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Phong", "definition": "清風. Gió mát. Hát nói của Cao Bá Quát: “Duy giang thượng chi thanh phong…” (chỉ có gió mát trên sóng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Phong Truyền Sở", "definition": "(青峰傳楚, Seihō Denso, ?-?): nhân vật sống vào cuối đời nhà Đường, người vùng Kinh Châu (涇州, Tỉnh Cam Túc), người kế thừa dòng pháp của Lạc Phổ Nguyên An (樂普元安). Ông đã từng sống tại Thanh Phong Sơn (青峰山) thuộc Phủ Phong Tường (風翔府).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Pháp Thiền Sư", "definition": "清 法 禪 師. Hiệu của Thiền tăng Khế Phù sống vào đời Ngũ Đại. X. Khế Phù.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Phúc", "definition": "清 福 (1850-1915). Thiền tăng đời Thanh, họ Nghiêm, người xứ Bồng An, Tứ Xuyên, Trung Quốc. Nối pháp Thiền Sư Thể Hải, đời thứ 46 hệ Nam Nhạc. Trụ trì chùa Bảo Quang ở Tân Đô. Có Ngữ Lục truyền lại đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Quang", "definition": "清光. Trong trẻo sáng sủa. Trong sáng. Chiến Tụng Tây hồ phú của Phạm Thái: “Nước thanh quang khôn lọt vết tham ô”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Sơn", "definition": "青山. Ngọn núi xanh. Tụng Tây hồ phú của Nguyễn Huy Lượng: “Nỗi thanh sơn mừng xuân kỉ dao đồ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Sơn Thiền Viện", "definition": "清 山 禪 院. ở Thanh Sơn, Hồng Kông, Trung Quốc. Vào thời Đường Tống đã có chùa này, khi đó gọi là “Bôi Độ Tự” nguyên để kỷ niệm Thiền Sư Bôi Độ mà sáng lập. Phía sau chính điện bên phải có Thạch Phật Nham gọi là “Bôi Độ Động”, trước động có tượng Bôi Độ điêu khắc bằng đá.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Sắc", "definition": "聲色. Giọnghát và vẻ đẹp (nói về ca kỉ).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Sở", "definition": "清楚. Rõ ràng Xong xuôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Sử", "definition": "青史. Sử xanh, chỉ sử sách (thời cổ chưa có giấy, phải viết chữ vào thẻ tre).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Tao", "definition": "清騷. Cao thượng trong sạch. Hát nói của Nguyễn Công Trứ: “Để ông Tô riêng một thú thanh tao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Thanh Thúy Trúc Tận Thị Chân Như - Uất Uất Hoàng Hoa Vô Phi Bát Nhã", "definition": "青 青 翠 竹 盡 是 眞 如、郁 郁 黃 花 無 非 般 若. Trúc biếc xanh xanh, thảy đều là thật tướng chân như hoa vàng rực rỡ không gì chẳng phải là trí huệ Bát nhã. Ý nói chân như Phật tính tồn tại ở khắp nơi, là trừ sạch mọi vọng tâm phân biệt, đạt đến cảnh giới vạn vật nhất như, sau khi vật ngã nhất như. Tiết Huệ Trung Quốc sư trong TĐT q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Thiên", "definition": "青天. Bầu trời xanh. Đoạn trường tân thanh: “Thanh thiên bạch nhật rõ ràng cho coi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Thiên Bạch Nhật Niệu Sàng", "definition": "青 天 白 日 尿 床. Ban ngày ban mặt lại đái dầm, dụ cho hành vi vô lý đến buồn cười. Tiết Thanh Hóa Toàn Phó Thiền Sư trong NĐHN q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Thái Quốc", "definition": "Xem Cực Lạc Quốc.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Thường Trú", "definition": "Mimansaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Thế", "definition": "聲勢. Tiếng tăm địa vị Tiếng tăm bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Thủy Tự", "definition": "(清水寺, Kiyomizu-dera hay Seisui-ji): ngôi chùa trung tâm của Bắc Pháp Tướng Tông, tọa lạc tại số 1-294 Kiyomizu (清水), Higashiyama-ku (東山區), Kyōto-shi (京都市), Kyōto-fu (京都府); hiệu núi là Âm Vũ Sơn (音羽山), nơi tham bái hành hương thứ 16 trong suốt 33 nơi tham bái chính ở vùng Tây Quốc (西國, Saikoku). Tượng thờ chính của chùa là Thiên Thủ Quan Âm (千手觀音). Vào năm 796, ngôi Quan Âm Tự (觀音寺) được dời đến vùng đất này, rồi đệ tử của Báo Ân Đại Sư (報恩大師) là Diên Trấn (延鎭) mới làm Tổ khai sơn chùa, còn hào tộc Điền Thôn Ma Lữ (田村麻呂) thì có công khai sáng chùa. Mấy năm sau các đường vũ của chùa được dựng lên và chùa trở thành ngôi chùa sắc nguyện của Hoàn Võ Thiên Hoàng (桓武天皇, Kammu Tennō), với tên gọi là Thanh Thủy Tự. Vào năm 811, chùa trở thành đạo tràng trấn hộ quốc gia, triều đình và hoàng thất quy y theo rất nhiều, nên chùa rất hưng thạnh. Sau đó, chùa phụ thuộc vào Hưng Phước Tự (興福寺, Kōfuku-ji) ở vùng Nam Đô, chuyên tu cả Chơn Ngôn và Pháp Tướng, nhưng do chùa bị lôi cuốn vào cuộc phân tranh với Diên Lịch Tự (延曆寺, Enryaku-ji), nên cũng bao lần bị đốt cháy. Sau cuộc loạn Bình Nguyên (平源) thì chùa hoàn toàn suy thối, nhưng trong khoảng thời gian niên hiệu Kiến Cửu (建久, 1190-1198) thì chùa lại được tái kiến. Vào thời đại Thất Đinh (室町, Muromachi) thì Tướng Quân Túc Lợi Tôn Thị (足利尊氏, Ashikaga Takauji) cúng dường đất xây chùa nên các đường vũ mới được tạo dựng nên. Sau đó chùa lại trải qua đến ba lần bị cháy rụi, rồi đến năm 1633 thì được Tướng Quân Đức Xuyên Gia Quang (德川家光, Tokugawa Iemitsu) tái kiến lại. Hiện tại có Thành Tựu Viện (成就院), Thái Sản Tự (泰産寺), Từ Tâm Viện (慈心院), Lai Nghênh Viện (來迎院), v.v. Chánh điện của chùa được tái kiến lại do sự hỗ trợ của Đức Xuyên Gia Quang, vẫn còn bảo trì cho đến ngày nay. Đây là một trong những ngôi chùa nổi tiếng nhất ở kinh đô Kyoto", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Tiến", "definition": "清 進. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư La Hán Đạo Nhàn. Sư ở viện Bảo ứng tại Đàm Châu (nay là huyện Trường Sa, tỉnh Hồ Nam).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Toán", "definition": "清算. Tính việc mà làm cho xong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Tra", "definition": "聲查. Nghe ngóng soát xét công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Trượng Vương", "definition": "Nīladaṇḍa (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Trừng Tự", "definition": "(清澄寺, Seichō-ji): ngôi chùa trung tâm của Nhật Liên Tông, hiện tọa lạc tại số 322-1 Seichō (清澄), Kamogawa-shi (鴨川市), Chiba-ken (千葉縣); hiệu núi là Thiên Quang Sơn (千光山), người thế gian thường gọi là Thanh Trừng Sơn (清澄山, Kiyosumiyama). Tượng thờ chính của chùa là Pháp Hoa Mạn Trà La (法華曼荼羅). Đây được xem là ngôi chùa nơi Nhật Liên xuất gia thọ giới, nên hiện tại nó gắn liền rất mật thiết với Nhật Liên Tông; nhưng nguyên gốc chùa thì không phải như vậy. Theo truyền thuyết của chùa, vào năm 771 (Bảo Quy [寶龜] 2) dưới thời đại Nại Lương, có vị Pháp Sư tên Bất Tư Nghì (不思議) đến thăm địa phương này, rồi lấy cây bách mà khắc thành tượng Hư Không Tạng Bồ Tát, từ đó nó trở thành tượng thờ chính của chùa. Sau đó, Từ Giác Đại Sư (慈覺大師) cũng đến đây rồi khắc bức tượng Bất Động Minh Vương, và từ nhân duyên đó chùa trở thành nơi của Dòng Thiên Thai Từ Giác. Theo như bài minh nơi pho Đại Hồng Chung được đúc vào năm 1392 vốn hiện còn lưu giữ trong nhà kho, có dòng chữ “Thiên Quang Sơn Thanh Trừng Tự ở Phòng Châu do Từ Giác Đại Sư sáng lập”, ta có thể biết được rằng dưới thời Nam Bắc Triều thì Viên Nhân (圓仁, Ennin) là người khai cơ chùa này. Nhưng hiện tại Thanh Trừng Tự là linh địa của Nhật Liên Tông. Khi mới bước vào cửa Sơn Môn, trong khuôn viên chùa ta sẽ thấy có tượng Hư Không Tạng Bồ Tát đứng trên đài cao phía bên tay trái, và chung quanh với rất nhiều cây đại thụ. Lúc còn nhỏ, Nhật Liên thường đến trước tượng này cầu nguyện rằng: “xin cho con trở thành bậc trí giả số một của Nhật Bản” suốt trong 37 ngày liên tục, đến sáng hôm sau thì nằm mộng thấy có vị lão tăng hiện đến ban cho xâu chuỗi ngọc. Chính điều này, Nhật Liên có ghi lại trong di văn của ông, và ngay trước bức tượng Hư Không Tạng này, có những cây tre thấm máu, tương truyền rằng đây là dấu hiệu chứng tỏ ngày Nhật Liên được mãn nguyện, ông thổ máu và máu ấy thấm vào cây này. Khoảng cuối thời đại Thất Đinh, chùa thuộc về Phái Trí Sơn của Chơn Ngôn Tông, nhưng sau đó thì hoàn toàn quy về Nhật Liên Tông.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Tuấn", "definition": "清 浚 (1328-1392). Thiền tăng đời Minh, họ Lý, tự Thiên Uyên, người Hoàng Nham (Chiết Giang) Trung Quốc. Thuở nhỏ sư học Nho giáo, 13 tuổi theo Diệu Minh chùa Bảo Đà xuất gia, qua tuổi 20 mới cạo tóc thụ giới cụ túc. Diệu Minh sang chùa Trung Thiên Trúc, sư được mời đến Thị Ty, dời sang Song Kính lại giữ chức Ký thất. Một hôm đọc Đại Huệ Ngữ Lục chợt tỏ ngộ. Trở về ở chùa Thiên Đồng Ninh Ba (Chiết Giang). Niên hiệu Hồng Vũ thứ 1 (1368) ra hoằng pháp trụ trì chùa Vạn Thọ ở Tứ Minh, năm thứ 5 (1372) đến dự đại hội Phổ Độ ở Chung Sơn, xong việc sư trở về núi, vua Thái Tổ ban thưởng rất nhiều. Năm thứ 15 (1382) thăng chức Tả giác nghĩa Tăng lục ty. Năm thứ 19 (1386) phụng chỉ thuyết pháp ở chùa Linh Cốc, Nam Kinh. Năm thứ 3 (1390) vâng lệnh trụ trì chùa Linh Cốc, Minh Thái Tổ đích thân làm 13 bài thơ đề tặng sư. Sư chuyên nghiên cứu giáo nghĩa, thông suốt sách Nho, lại giỏi thi văn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Tâm", "definition": "清心. Tấm lòng trong sạch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Tân", "definition": "清新. Trong sáng tươi trẻ Chỉ người con gái trẻ tuổi xinh tươi. Đoạn trường tân thanh: “Có chiều phong vận, có chiều thanh tân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Tích", "definition": "清 錫. Thiền tăng đời Tống, người xứ Tuyền châu, nối pháp Thiền Sư Thanh Lương Văn Ích, thuộc tông Pháp Nhãn. Ban đầu sư trụ viện Quảng Bình núi Long Tu rồi dời sang núi Vân Cư ở quận Nam Khang (nay là huyện Tinh Tử, tỉnh Giang Tây), sau đó sư trụ trì viện Tây Minh ở Tuyền Châu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Tú", "definition": "清秀. Đẹp đẽ cao cả. Truyện Nhị Độ Mai: “Dạng gười thanh tú, vẽ người văn chương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Tịnh", "definition": "Viśuddhi (S), Purity, Subha (P), Śuddha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Giới", "definition": "Śīla-visuddhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Hoa Viện", "definition": "(清淨華院, Shōjōke-in): một trong 4 ngôi chùa bổn sơn trung tâm của Tịnh Độ Tông; hiện tọa lạc tại Teramachidōri (寺町通), Jōkyō-ku (上京區), Kyoto-shi (京都市), không có hiệu chùa cũng như hiệu núi. Tượng thờ chính là Pháp Nhiên Thượng Nhân. Tương truyền theo sắc nguyện của Thanh Hòa Thiên Hoàng (清和天皇, Seiwa Tennō, tại vị 858-876), ngôi viện vốn phát xuất từ đạo tràng nhỏ do Viên Nhân (圓仁, Ennin) sáng lập, rồi vị khai Tổ của Tịnh Độ Tông là Nguyên Không (源空, Genkū, tức Pháp Nhiên) mới khai sáng ra ngôi viện này; nhưng thật tế người khai sơn viện này chính là Hướng A Chứng Hiền (向阿証賢), vào khoảng đầu thế kỷ 14. Đầu tiên nó nằm ở vùng Cao Thương (高倉, Takakura), nhưng đến năm 1339 thì Tướng Quân Túc Lợi Tôn Thị (足利尊氏, Ashikaga Takauji) mới dựng lên Đẳng Trì Tự (等持寺) và dời về chùa này. Hơn nữa, trong khoảng niên hiệu Thiên Chánh (天正, 1573-1592), do chính sách cải cách kinh đô của Tướng Quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi), nên chùa được dời về vị trí hiện tại. Với tư cách là cứ điểm của Phái Nhất Điều (一條派) thuộc Tịnh Độ Tông, chùa đã hưng thạnh rực rỡ, rồi được hàng ngũ công khanh cũng như Hoàng Thất quy y theo rất nhiều; nhưng trong hai vụ Loạn Ứng Nhân (應仁) và Văn Minh (文明) thì vận chùa bị suy thối, nhưng đến khoảng đầu thế kỷ thứ 17 thì chùa lại được phục hưng. Nguyên lai chùa này vốn là đạo tràng trong cung cấm nên hiện tại trong khuôn viên chùa vẫn còn nhiều ngôi mộ của các Hoàng Tử, Hoàng Nữ, Công Chúa, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thanh Tịnh Huệ Bồ Tát", "definition": "Viśuddha-mati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Pháp Nhãn", "definition": "清 淨 法 眼. Huyền chỉ của giáo ngoại biệt truyền (tức Thiền Tông). Chương “Thích Ca Mâu Ni Phật” trong CĐTĐL q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Tịnh Tam Muội", "definition": "Prāsādavati (S), Prāsādavati samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Tam Nghiệp", "definition": "清凈三業 (Anh Lạc Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thanh Tịnh Thành", "definition": "Sobbavati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Thức", "definition": "Xem Như Lai Tạng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Tri Kiến", "definition": "Purification of Knowledge.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Trí", "definition": "Śuddha-jñāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Tâm", "definition": "Purification of mind.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Đạo", "definition": "Viśuddhi-magga (P), Way of Purity.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tịnh Đạo Luận", "definition": "Xem Thanh Tịnh Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Tủng", "definition": "清 聳. Thiền tăng đời Ngũ Đại, họ Thái, người Phúc Thanh, Phúc Châu (Phúc Kiến) Trung Quốc. Ban đầu tham kiến Thiền Sư Thanh Lương Văn Ích, Văn Ích chỉ mưa, nói: “Giọt mưa rơi trong mắt Thượng tọa”. Thanh Tủng không lãnh hội ý chỉ. Sau nhờ xem kinh Hoa Nghiêm cảm ngộ, được Văn Ích ấn khả, nối pháp làm truyền nhân tông Pháp Nhãn. Trở về ở thảo am núi Tứ Minh, Minh Châu (Ninh Ba, Chiết Giang), Tiết độ sứ Tiền ức lễ sư làm thầy. Ngô Việt Trung Ý Vương ra lệnh sư khai đường thuyết pháp hai nơi trong Hàng Châu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Viên Tự", "definition": "青 園 寺. Nằm trên sườn núi Hà Chu, ngoại ô thành phố Nam Kinh, tỉnh Giang Tô, Trung Quốc. Hoàng hậu Cung Tư đời Đông Tấn là Chữ Thị sáng lập. Trúc Đạo Sinh từng ở chùa này giảng nghĩa lý đốn ngộ thành Phật. Niên hiệu Cảnh Bình thứ 1 (423) đời Lưu Tống điện Phật chấn động, tương truyền có rồng thăng thiên bèn đổi tên là “Long Quang Tự”. Bảo Lâm, Pháp Bảo, Huệ Sinh nối nhau đến trụ trì. Khoảng niên hiệu Hội Xương (841-846) đời Đường chùa bị phá hủy. Đến niên hiệu Hàm Thông thứ 2 (861) xây dựng lại, ban cho tấm biển “Long Quang Viện”. Niên hiệu Thăng Nguyên thứ 2 (938) đời Nam Đường trùng tu, Trừng Di. Thái Khâm trụ chùa này hoằng dương thiền pháp.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Vân", "definition": "青雲. Mây xanh. Chỉ con đường công danh. Đoạn trường tân thanh: “Thênh thang đường cái, thanh vân hẹp gì”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Văn", "definition": "Nyan thos (T), rāvaka (S), Sāvaka (P), Nyan thos (T), Śrāvika (S), Sāvika (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Văn Giác", "definition": "Śrāvaka-bodhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Văn Thừa", "definition": "Sāvakayāna (P), Śrāvaka-yāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thanh Văn Thừa Và Duyên Giác Thừa", "definition": "Chữ “thừa” là chỉ cho giáo pháp. Những hành giả chính mình được nghe lời Phật dạy, tỏ ngộ lí “tứ đế”, đoạn trừ kiến, tư hoặc mà chứng quả A-la-hán, thì thuộc về Thanh-văn thừa. Những vị sinh nhằm thời Phật tại thế, được nghe Phật nói giáo pháp “mười hai nhân duyên”, tu hành đoạn diệt vô minh, giải thoát dòng sinh tử, gọi là Duyên-giác; những vị sinh ra đời không gặp lúc có Phật tại thế, nhưng tự mình quán chiếu các cảnh hoa rơi lá rụng mà ngộ được lẽ vô thường, nhân đó mà tu đạo chứng quả, gọi là Độc-giác; cả hai quả vị này đều thuộc về Duyên-giác thừa.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thanh Vận", "definition": "清 運. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư Bảo Phúc Tùng Triển. Khi ra hoằng pháp, sư trụ viện Vạn An ở Tuyền Châu. Hiệu: Tư Hóa Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Vắng", "definition": "Vivitta (tính từ), rāhaseyyaka (tính từ), samattha (nam), panta (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thanh Xuân", "definition": "青春. Xuân xanh, tuổi trẻ. Đoạn trường tân thanh: “Một chàng vừa trạc thanh xuân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Y", "definition": "青衣. Áo xanh, áo của đày tớ gái Trung Hoa thời xưa. Đoạn trường tân thanh: “Thanh lâu hai lượt, thanh y hai lần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Âm", "definition": "聲音. Tiếng phát ra, nghe được Giọng nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thanh Âm Các", "definition": "清 音 閣. Nằm dưới ngọn Ngưu Tâm, núi Nga My, tỉnh Tứ xuyên, cách chùa Báo Quốc chừng 15km. Đời Đường gòi là “Ngưu Tâm Tự”. Niên hiệu Hồng Vũ thứ 1 (1368) đời Minh Thiền Sư Quảng Tế sau khi tu sửa lại, đổi tên là “Thanh Âm Các”. Hai dòng Bạch Long Giang và Hắc Long Giang tập họp dưới Thanh Âm Các, chỗ hiệp lưu có một hòn đá hình dáng giống như trái tim bò, gọi là “Ngưu Tâm Thạch”. Cách Ngưu Tâm Thạch không xa có hai chiếc cầu đá có vòm tròn bắc qua hai dòng Hắc, Bạch gọi là “Song Phi Kiều”. Sau khi nước chảy qua cầu va vào Ngưu Tâm Thạch làm nước bắn tung tóe óng ánh như ngọc rất là đẹp mắt. “Song Kiều Thanh Âm” là một trong mười cảnh đẹp của núi Nga My.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Đàm", "definition": "清 談. Thiền tăng đời Nguyễn, thuộc tông Tào Động, đời thứ 42, nối pháp Thiền Sư Đạo Nguyên hiệu Minh Chính, là Trụ trì chùa Bích Động ở làng Đam Khê, phủ An Khánh, tỉnh Ninh Bình, miền Bắc Việt Nam. Sư xuất gia năm 1807, thụ giới cụ túc năm 1810. Sư là đệ tử Thiền Sư Đạo Nguyên, lúc bấy giờ ngài đang trụ trì thiền viện Nguyệt Quang, một Tổ đình của phái Chân Nguyên. Một hôm sư hỏi Thiền Sư Đạo Nguyên:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thanh Đạm", "definition": "清淡. Trong sạch mà nhạt nhẽo, chỉ cuộc sống nghèo mà trong sạch, hoặc đồ ăn tầm thường. Cung oán ngâm khúc: “Mùi hoắc lê thanh đạm mà ngon”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao", "definition": "𠬢. Sườn núi trơn trượt Trơn trượt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao Diễn", "definition": "操演. Tập tành võ nghệ, hoặc việc binh bị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao Luyện", "definition": "操練. Tập tành nhiều lần cho giỏi về võ nghệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao Lược", "definition": "韜略. Phép dùng binh. Tài dùng binh. Văn tế Vũ Tính và Ngô Tùng Châu: “Thao lược ấy tài, Kinh luân là chí”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao Quang Dưỡng Hối", "definition": "韜 光 養 晦. Còn gọi: Hối Tích Thao Danh, Ẩn Tích Mai Danh. ẩn mình, giấu tên. Có tài trí, đạo đức mà giữ kín đáo không cho người ta biết đến mình. Truyện Thiền Sư Cảnh Nguyên trong Vân Cư Sơn Chí (134, hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thao Trường", "definition": "操場. Bãi đất rộng để luyện tập võ nghệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao Túng", "definition": "操縱. Nắm giữ và buông thả, ý nói mặc tình làm theo ý muốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thao Đường", "definition": "操堂. Nhà luyện tập võ nghệ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thay Phiên", "definition": "Mithu (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thay Thế", "definition": "Vattati (vat + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thay Đổi", "definition": "Ruppati (rup + ya), vikāra (nam), viparināmeti (vi + pari + nam + a), vikubbati (vi + kar + o), vikubbana (trung), pārivaṭṭaka (tính từ), nāvanā (nữ), viparināma (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thạch Sương Khánh Chư", "definition": "(石霜慶諸, Sekisō Keisho, 807-888): xuất thân vùng Tân Cam (新淦), Cổ Châu (古州, thuộc Tỉnh Triết Giang), họ là Trần (陳). Năm lên 13 tuổi, ông xuống tóc xuất gia với Tây Sơn Thiệu Giám (西山紹鑑) ở Hồng Châu (洪州, thuộc Huyện Nam Xương, Tỉnh Triết Giang), rồi thọ cụ túc giới với Tung Nhạc (嵩岳) và học về giới luật. Sau đó, ông đến tham yết Đạo Ngô Viên Trí (道吾圓智) và kế thừa dòng pháp của vị nầy. Về sau, ông đến sống ở Thạch Sương Sơn (石霜山) trong vòng 10 năm, và chính trong khoảng thời gian nầy, ông đã cùng với môn đệ mình chuyên tâm ngồi Thiền mà không hề nằm nghỉ như cây khô, nên người đời thường gọi họ là Người Cây Khô. Vua Hy Tông (僖宗) nhà Đường nghe được đạo phong của ông nên ban cho Tử Y, nhưng ông cố từ không thọ nhận. Vào ngày 20 tháng 2 năm Mậu Thân (888, năm đầu niên hiệu Văn Đức), ông thị tịch, hưởng thọ 82 tuổi đời và 59 hạ lạp. Ông được sắc phong thụy hiệu là Phổ Hội Đại Sư (普會大師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "The Dalai Lama", "definition": "The Dalai Lama has been called a “Buddhist Pope”, a “bodhisattva,” a “head of state” in exile, and so on. He describes himself as a “simple Buddhist monk,” though he is not unaware of other dimension of his being. To understand him better, while appreciating his own intellectual background and education, we can try to see him the way Tibetans see him in the context of Tibetan culture:", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The Perfections", "definition": "Paramitas (Ba-la-mật)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The Seven Chakras", "definition": "Yogic tradition teaches that we have two bodies – our tangible, physical body and our “subtle”, or energetic, body. Seven subtle energy centers or chakras (meaning “wheels” in Sanskrit), lie along the midline of the subtle body, within the spine, at the points where the main nadis (energy channel) intersect. Each chakras is associated with not only a particular part of the body but also a particular color, mantra, and mental or emotional benefit.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The Spirit of Theravada Buddhism", "definition": "The major lands in which Theravada Buddhism prevails are Ceylon, Burma and Thailand… The vital area of continuity between Theravada and original Buddhism lies many in the earnest, hopeful and self-sufficient humanism that is so constantly displayed in the Dhammapada – Buddhist scriptures.", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The Stupa tradition", "definition": "When the Buddha died, his remains were distributed in eight simple hemispherical burial mounds, created in India at places important in his life. In Sanskrit these mounds became known as Stupas (literally “heaps = đống”) [tháp chứa hài cốt]", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The Three Types of Karma", "definition": "A fundamental concept of Eastern (Hindu, Buddhist, Jain, Sikh) thought, karma is the law of moral consequences. In literal terms, if you do something bad, you will, at some point, pay for it; if you do something good, you will receive kindness and happiness in return . More profoundly, every thought, word and deed is weighed on the scales of an eternal justice. Even if you have been virtuous in this life, misfortune and sickness can come from the accumulated bad karma of past lives. Until you pay off your “karmic debts”, and expunge (xoá bỏ) your karma, you are condemned to repeat life again and again, through reincarnation. Three types of karma are described in Hindu texts:", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The mantra of Manjushri is “Om A Ra Pa Cha Na Dhi”.", "definition": "Manjushri Bodhisattva = V T S L B T; Biểu tượng trí tuệ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The process itself", "definition": "The continual arising, fading away, and re-arising of phenomena. Reality as we know it – conditioned existence, or samsara – is creating itself in every moment by a chain of causality known as “dependent origination.” Often that’s depicted as a wheel, to indicate the cyclical nature of the twelve interconnected factors: ignorance, karma-producing formations, consciousness, mental and physical phenomena, the senses, contact with objects, feeling, craving, clinging, becoming, re-birth, and old age and death. These elements are arising in every moment, producing everything constructed, including what we call the personality or ego", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "The three Jewels", "definition": "Buddha (teacher); Dharma (teaching); Sangha (Commun-ity of practitioners) - Phật, Pháp, Tăng", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Theist", "definition": "Người tu theo thuyết hữu thần", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Then Cửa", "definition": "Aggala (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Theo", "definition": "Yathā (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Theo Atthakathā.", "definition": "(Kāma).", "source": "Kho Tang Phap Hoc - Viet - Pali - TK Giac Gioi"}
{"term": "Theo Bích Nham Lục tắc 10 thì Thực Tướng Bát Nhã chính là chân trí, Quán Chiếu Bát Nhã chính là chân cảnh, còn Văn Tự Bát Nhã chính là Văn Tự Năng Thuyên. Ba Bát Nhã này thêm vào 2 Bát Nhã nữa là Cảnh Giới Bát Nhã và Quyến Thuộc Bát Nhã, gọi là Ngũ Chủng Bát Nhã. Ngoài ra, Văn Tự Bát Nhã cũng có khi được gọi là Phương Tiện Bát Nhã. [X. Kim Cương Bát Nhã Kinh Sớ; Đại Phẩm Kinh Nghĩa Sớ Q.1; Bát Nhã Tâm Kinh Lược Sớ; Tam Luận Huyền Nghĩa; Chỉ Quán Phụ Hành Truyền Hoằng Quyết Q.3].", "definition": "II.Tam Bát Nhã.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Cách Nào", "definition": "Kathaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Theo Cơ Nghi", "definition": "In accordance with what is appropriate", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Theo Du Già Luận Kí quyển 19 phần đầu thì “Phạm” là tiếng Ấn Độ, Hán dịch là Tịch tĩnh, Niết Bàn; “Chí” là tiếng Trung Quốc, quyết chí cầu Phạm, cho nên ghép chung 2 chữ lại thành là Phạm Chí (nửa Ấn nửa Tàu). Các Phạm Chí thấy ghi rải rác trong kinh điển như Phạm Chí Trường trảo, Phạm Chí Loa kế... đều là Bà La Môn, sau trở thành đệ tử nổi tiếng của Đức Phật. Ngoài ra, con gái của Phạm Chí, hoặc cô gái tu theo đạo Phạm, gọi là Phạm nữ. [X. Kinh Mã Ấp trong Trung A Hàm Q.48; Kinh Tăng Nhất A Hàm Q.9; Kinh Pháp Cú Q.hạ; Đại Nhật Kinh Sớ Q.4]. (xt. Bà La Môn).", "definition": "II.Phạm Chí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Dõi", "definition": "Paṭisevati (paṭi + sev + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Theo Giải Thâm Mật Kinh Sớ quyển 5, Tam Giáo lập trong Bộ tông dị luận kí của ngài Chân Đế là: Tiểu Thừa pháp luân, Đại Thừa pháp luân, và Nhất Thừa pháp luân. Trong đó, Pháp Luân đầu là Tam Tạng Giáo, chỉ cho Tiểu Thừa, tức kinh A Hàm; Pháp Luân thứ 2 chung cho cả Đại Thừa và Tiểu Thừa, tức Kinh Niết Bàn; Pháp Luân thứ 3 thì chỉ riêng cho Đại Thừa, tức các Kinh Hoa Nghiêm, Bát Nhã... Đây là thuyết khác của 3 pháp luân: Chuyển Pháp Luân, Chiếu Pháp Luân, và Trì Pháp Luân.", "definition": "VII.Tam Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Kinh Viên Giác Thì Đức Phật là vua của muôn pháp, nên gọi là Không vương. [X. Niệm Thập Phương Phật Duyên, Thiên Kính Phật, bộ Tam Bảo Trong Chư Kinh Yếu Tập Q.1].", "definition": "II.Không Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Kinh Vô Lượng Thọ quyển thượng, thì 53 Đức Phật trên đây ra đời trước Đức Phật trên đây ra đời trước Đức Phật Thế Tự Tại Vương (Thầy của Bồ Tát Pháp Tạng, tiền thân của Đức Phật A Di Đà). Tức Đức Phật Định quang là Phật đầu tiên xuất hiện trong quá khứ, cuối cùng đến Phật Xử thế, rồi sau đó Đức Phật Thế Tự Tại Vương mới ra đời.Nhưng, theo các bản dịch Kinh Vô Lượng Thọ đời Đường, Tống và bản dịch Tây Tạng thì ngược lại, Phật Thế Tự Tại Vương ra đời đầu tiên trong quá khứ, còn Phật Định quang thì xuất hiện sau cùng.", "definition": "II.Ngũ Thập Tam Phật.Chỉ cho 53 Đức Phật mà 3.000 vị Phật trong 3 kiếp (Trang Nghiêm, Hiền, Tinh tú) đã được nghe danh hiệu và trì niệm khi còn ở giai vị tu nhân. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Kinh Đại Bát Niết Bàn quyển 39 (bản Bắc) thì dùng tô đối trị bệnh nóng, dùng dầu đối trị bệnh phong và dùng mật đối trị bệnh lạnh. [X. Kinh Tăng Nhất A Hàm Q.12].", "definition": "II.Tam Bệnh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Luận Đại Trí Độ quyển 7, sư tử một mình đi giữa các loài thú mà không sợ hãi, có thể hàng phục tất cả. Đức Phật cũng thế, ở trong 96 thứ ngoại đạo mà hàng phục tất cả, chẳng sợ hãi, nên gọi là Nhân sư tử. [X. Kinh Niết Bàn Q.33 (bản Bắc); Kinh Vô Lượng Thọ].", "definition": "II.Nhân Trung Sư Tử.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Luận Đại Tì Bà Sa quyển 102 thì Túc Mệnh Minh thấy được các việc quá khứ nên sinh tâm chán lìa, Thiên Nhãn Minh thì thấy được các việc vị lai mà sinh tâm chán lìa, còn Lậu Tận Minh thì đã chán lìa rồi bèn ưa thích Niết Bàn. Ngoài ra,Túc Mệnh Minh có thể đoạn trừ thường kiến, Thiên Nhãn Minh thì dứt trừ được đoạn kiến; còn Lậu Tận Minh thì xa lìa cả hai bên thường, đoạn mà an trụ ở Trung Đạo. Nếu phối với 6 thần thông thì Tam minh này theo thứ tự lấy thần thông thứ 5, thứ 2, thứ 6 trong 6 thần thông làm tự tính. [X. Kinh Tạp A Hàm Q.31; Luận Đại Trí Độ Q.2; Luận Tập Dị Môn Túc Q.3,15; Luận Tạp A Tì Đàm Tâm Q.6; Luận Câu Xá Q.27]. (xt. Lục Thần Thông].", "definition": "II.Tam Minh.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Phds của Ht Thích Từ Thông.", "definition": "Ba của quý đó là Phật, Pháp, Tăng. Quy y tam bảo là quy y, nương tựa vào Phật, Pháp và Tăng. Theo Mạnh Tử , thì chư hầu cũng có ba của báu là: đất đai, nhân dân và chính sự (chính sự là công việc chính trị, công việc cai trị dân, làm an dân). Cũng có sách gọi Tam bảo là mặt trời, mặt trăng và tinh tú (các vì sao):", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phds của Như Thọ - Nguyên Liên", "definition": "Chín đế ( Chín lý chơn thật), tức là nói cái lý chín món vô thường có thiệt vậy:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phds của Ni sư Đức Trí", "definition": "Khi niệm danh hiệu Phật thì chỉ nghĩ đến Phật, công đức và đức hạnh của Phật, không nghĩ đến việc gì khác.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phds của Thích Nữ Đức Trí", "definition": "六 通; C: liùtōng; J: rokutsū; S: ṣāḍabhijñāna; Thông, thắng trí: S: abhijñā; P: abhiññā; Sáu thắng trí mà Phật , Bồ Tát hay A-la-hán đạt được. Trong sáu thắng trí đó, người ta phân ra hai loại:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phds của Tn Đức Trí", "definition": "1. Tự tánh thân (pháp thân)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phtđ của Đoàn Trung Còn", "definition": "Thiên long là loài trời và loài rồng (nagas), ngoài ra còn có tám chủng quỷ Thần khác là: Dạ Xoa (Yaksa), Càn thát bà (Gandharvas), A tu la (Asuras), Ca lâu la (Garudas), Kiên Na la (Kinnaras), Ma hầu la ca (Mahoragas). Trong các kinh Đại thừa, thường nói đến Thiên long bát bộ đến nghe Phật giảng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phtđ của Đoàn Trung Còn)", "definition": "Bảy tình. Theo đạo Phật, bảy thứ tình cảm hay khuấy rối tâm người mà người tu hành phải chế ngự cho được: mừng, giận, đau đớn, sợ sệt, yêu, ghét và thèm muốn. Cũng có sách khác viết bảy tình: mừng, giận, lo, nghĩ ngợi,thương sót, sợ, hãi hùng. Sách Trung Quốc thường gọi thất tình lục dục. Lục dục là sáu thèm muốn: danh, lợi, sắc, vị kỷ, ghen ghét, dối trá. Hợp từ thất tình dùng khá phổ biến trong văn học:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Phẩm Phân biệt định trong Luận Giải Thoát Đạo quyển 2 thì định có 2 loại: Tà Định và Chính Định. Tà Định là thiền định sai lầm, không thể nào đạt đến trạng thái nhất định.", "definition": "II.Tà Định.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Phẩm Thích Tự Mẫu trong Kinh Du Già Kim Cương Đính thì chữ Sái chỉ cho độn tính của tất cả các pháp. (xt. Sái).", "definition": "III.Sát. Phạm: Kwetra.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Sau", "definition": "Anubandhati (anu + badh + m + a), anubandhana (trung), anuanusarati (anu + sar + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Theo Thích Thị Yếu Lãm quyển hạ, con người sinh trong cuộc đời nhận chịu những quả báo khác nhau như giầu sang, nghèo hèn, xinh đẹp, xấu xí, yên vui, lo sợ v.v... đều do nghiệp nhân bất đồng mà ra. Như người sinh ra chịu thân phận thấp hèn là vì gây nhân kiêu căng, tự Đại, khinh miệt người khác, hành động ngông cuồng, chẳng lễ kính Tam Bảo. Nếu chí thành không lừa dối, tụng kinh giữ giới, khuyên người lánh ác làm thiện, không tìm lỗi của người, thì hơi miệng thơm sạch, thân tâm yên vui, được mọi người khen ngợi, quí mến... [X. kinh Nghiệp báo sai biệt].", "definition": "II.Đối lại: Quả nhân.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Thập Bất Nhị Môn xu yếu quyển thượng thì Thập thừa là thể chung của 3 loại quán pháp, còn Thác Sự, Phụ Pháp và Tòng Hành là tướng riêng của 3 loại quán pháp. [X. Thập Bất Nhị Môn Chỉ Yếu Sao Q.thượng; Chỉ Quán Nghĩa Lệ; Chỉ Quán Nghĩa Lệ Tùy Thích Q.6].", "definition": "III.Tam Quán. Chỉ cho 3 pháp quán do Luật sư Đạo Tuyên ở núi Chung Nam Thành lập, gọi là Nam Sơn tam quán. Ba pháp này theo thứ tự là pháp quán của Nhị Thừa, Tiểu Bồ Tát và Đại Bồ Tát. Đó là:", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Tiểu Bộ Kinh nghĩa thích, trí mâu ni bao gồm: Tuệ, Tri Giải, Giản Trạch, Tư Sách, Hiền Minh, Thiện Xảo, Biện Biệt, Tuệ Đăng, Chính Kiến v.v... [X. Kinh Ưu Ba Li trong Trung bộ bản Pàli].", "definition": "III.Mâu Ni.Phạm: Mauneya. Pàli: Moneyya.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Tuệ Lâm Âm Nghĩa quyển 19, vị Ni dạ ma là chỉ cho giai vị Bồ Tát bất thoái chuyển.", "definition": "II.Ni Dạ Ma.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo Vãng Sinh Lễ Tán Kệ của ngài Thiện Đạo thì khi qui y Tam Bảo nên xướng rằng (Đại 47, 440): “Qui y Phật được bồ đề, đạo tâm thường chẳng lui, nguyện cùng các chúng sinh, hồi hướng nguyện sinh về cõi Vô Lượng Thọ, Qui y pháp Tát bà nhã, được môn Đại Tổng Trì, nguyện cùng các chúng sinh, hồi hướng nguyện sinh về cõi Vô Lượng Thọ; Qui y tăng dứt tranh luận, cùng vào biển hòa hợp, nguyện cùng với chúng sinh, hồi hướng nguyện sinh về cõi Vô Lượng Thọ”. (xt. Tam Qui Y).", "definition": "III.Tam Lễ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo bài ca Nguyên nhân trong Lê Câu Phệ Đà (Phạm: Fg-veda) thì vị thần này là chúa tể trong tất cả thời hiện tại, quá khứ và vị lai, có nghìn đầu, nghìn mắt, nghìn chân. Từ đầu thần này sinh ra Bà La Môn, từ vai sinh ra Sát Đế Lợi, từ bắp vế sinh ra Thủ Đà La, từ tim sinh ra mặt trăng, từ mắt sinh ra mặt trời, từ hơi thở sinh ra gió, từ rốn sinh ra cõi hư không, từ trên đầu sinh ra cõi trời, từ chân sinh ra đất.", "definition": "II.Nguyên Nhân.Danh hiệu của thần Phạm Thiên sáng tạo Bà La Môn giáo và Ấn Độ Giáo. III.Nguyên Nhân.Dịch cũ: Cố nhân...Tên hiệu của vị thứ thần trong Ma Ni Giáo. Vị thần tối cao của Ma Ni Giáo là thần Đại Minh (Zarvàn), thông qua vị sứ giả là Thiên Mẫu mà sáng tạo ra thần Nguyên nhân, tức là ông Tổ đầu tiên của loài người.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo sự giải thích trong Huyền Ứng Âm Nghĩa quyển 18, thì Mâu ni là người tu tâm học đạo, đã thông suốt nội ngoại, ẩn cư lâu ngày trong rừng núi.Trong Pháp sắc của vua A Dục có khuyên người xuất gia, tại gia đọc tụng 7 kinh, trong đó, Mâu ni kệ (Phạm: Muni-gàthà) có lẽ là Mâu Ni Kinh (Munisutta) trong “Kinh tập” bản Pàli, cho rằng Mâu ni là Tỉ Khưu chân thực. Còn Kinh Pháp Cú thứ 268, 269 bảnPàli thì gọi người làm thiện lánh ác là Mâu ni.Tiểu Bộ Kinh nghĩa thích bản Pàli cho rằng người có trí tuệ, tri giải là Mâu Ni và phân biệt 6 bậc Mâu ni: Tại Gia Mâu Ni, Phi Tại Gia Mâu Ni, Hữu Học Mâu Ni, Vô Học Mâu Ni, Bích Chi Mâu Ni Và Mâu Ni Mâu Ni.", "definition": "II.Mâu Ni.Phạm: Mauna. Pàli: Mona.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo thứ tự quán xét để phá bỏ thì trong Tam Quán, trước hết phá bỏ Danh giả, kế đến, phá bỏ Thụ giả và sau cùng phá bỏ Pháp giả mà chứng nhập thực tướng các pháp, tức là Chân Không. [X. Kinh Đại Phẩm Bát Nhã Q.23; Luận Đại Trí Độ Q.41; Đại Thừa Nghĩa Chương Q.1; Đại Thừa Huyền Luận Q.1].", "definition": "II.Tam Giả Thi Thiết.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo truyện Hàm Quang trong Tống Cao Tăng Truyện quyển 27 và lời bạt ở cuối sách này, thì tác giả có đến núi Ngũ Đài để hội kiến ngài Hàm Quang, cứ đó mà suy đoán thì có lẽ sách này đã được hoàn thành vào khoảng năm Đại Lịch thứ 9, 10 (774-775). Còn theo tư liệu của các sư Đạo Thúy và Hạnh mãn môn đệ của ngài Trạm Nhiên ghi thì các vị này từng nghe ngài Trạm Nhiên giảng bộ Pháp Hoa Văn Cú ở Tì Lăng. Như vậy, sách này chính là bản mà ngài Trạm Nhiên đã giảng ở chùa Diệu lạc tại Tấn lăng, cho nên đời sau mới gọi sách này là Diệu Lạc Kí. Nguyên bản của sách này trong Đại Tạng ở chùa Khai Nguyên là 10 quyển. Trong năm Vạn Lịch (1573-1619) đời Minh, để tiện cho việc học tập, nghiên cứu, ngài Thiệu giác đem cả 3 bộ: Kinh Pháp Hoa, Pháp Hoa Văn Cú và Pháp Hoa Văn Cú Kí hợp lại làm một, chính là bộ Pháp Hoa Văn Cú Hội Bản 30 quyển lưu hành hiện nay.", "definition": "II.Pháp Hoa Văn Cú Kí.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Theo từ điển Phật học Huệ Quang", "definition": "Lục thức là sáu sự nhận biết của lục căn khi tiếp xúc với lục trần. - Nhãn Thức: Cái biết của con mắt, về thức này nhãn căn khởi ra tác dụng phân biệt về sắc trần, nên gọi là nhãn thức.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo từ điển Phật học Hán Việt của Đoàn Trung Còn", "definition": "Một khái niệm của Tông Thiên Thai ở Trung Hoa, phân chia toàn bộ giáo lý Phật Thích Ca thành tám loại, có thể nói là tám bộ môn:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo từ điển Phật học Đạo Uyển", "definition": "Lục đạo còn gọi là lục thú, đạo là đường, thú là nơi hướng tới. Ý nói chúng sanh khi chưa khỏi vòng sống chết luân hồi, thường phải tái sinh vào một trong sáu cõi trên. Sáu cõi này là chúng phàm phu qua lại , nên còn gọi là lục phàm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Theo Ý", "definition": "Cittarūpaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Theo: PQĐTĐ của nhóm Từ Di.", "definition": "2. Thuật lại y hệt hồi trước. Truyện Thiền Sư Đại Xả trong TUTA ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Theo: Thiền Sư Việt Nam của HT Thanh Từ.", "definition": "2. Thiền tăng đời Tống, hiệu Nhã Sung. X. Nhã Sung.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "definition": "2. Thiền tăng đời Minh, họ Vương, tự Định Nham, hiệu Huyễn Cư, người xứ Nam Tầm (nay là huyện Hồ Châu, tỉnh Chiết Giang) Trung Quốc. Sư xuất gia ở viện Chủng Phúc rồi đi các chùa: Thiên Trúc, Hổ Bào, Linh Cốc để tham lễ các bậc danh sư. Sau đó, sư nhận chức Tả giác nghĩa ở Tăng lục ty rồi chuyển sang chức Tả giảng kinh. Vua ban cho sư hiệu “Huệ Tế Thiền Sư”. Sư có Ngữ Lục lưu hành ở đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Theosophical", "definition": "Theo thuyết thần trí (Theosophy  - Thuyết thần trí)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thera", "definition": "Trưởng lão tăng. Thường được dùng để trước tên những vị tăng cao hạ để bày tỏ lòng kính trọng.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Theradhamma", "definition": "Mười pháp bậc trưởng lão, đức tính của vị tỳ-kheo cao hạ đáng kính", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Theravada", "definition": "Phật giáo Nam truyền: Ấn Độ, Tích Lan, Miến Điện, Lào, Thái Lan và Cao Miên (Mahayana = Phật Giáo Bắc truyền)", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Theri", "definition": "Trưởng lão ni. Thường được dùng để trước tên những vị Ni cao hạ để bày tỏ lòng kính trọng.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Thermonuclear", "definition": "Nhiệt hạch, phản ứng tổng hợp hạt nhân ở nhiệt độ cao", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thi", "definition": "㕧. Rên rỉ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Bà Đàn Ni", "definition": "Sītapāni (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Bá", "definition": "詩伯. Người tài giỏi trong đám người làm thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Ca", "definition": "詩歌. Bài thơ và bài hát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Ca Cung Đình", "definition": "Kavya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Ca La Việt", "definition": "Xem Thiện Sanh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Ca La Việt Bồ Tát", "definition": "Sigalavada (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Ca La Việt Kinh", "definition": "Sigalovāda-Sūtra (S), Sigalovāda-Sutta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Hoa La Sát Nữ", "definition": "Xem Hoa Sĩ La Sát Nữ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Hành", "definition": "施行. Theo sự định sẵn mà làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Hào", "definition": "詩豪. Người cực tài giỏi về thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Hộ", "definition": "Danapala: là vị cao tăng dịch kinh ở đời Tống. Ngài người nước Ô-điền-nang (Udyana, Udnvanaka) ở phía Tây-Bắc Ấn-độ. Năm 980 (dưới triều vua Tống Thái-tông), ngài đã cùng với ngài Thiên Tức Tai (người nước Ca-thấp-di-la ở phía Bắc Ấn-độ) đến Biện-kinh (tức phủ Khai-phong, kinh đô nhà Triệu-Tống), trú tại Dịch-kinh viện của chùa Thái-bình-hưng-quốc, chuyên việc dịch kinh. Ngài đã dịch được các bộ như Đại Thừa Trang Nghiêm Bảo Vương Kinh, Cấp Cô Trưởng Giả Nữ Đắc Độ Nhân Duyên Kinh, Quảng Thích Bồ Đề Tâm Luận, Đại Thừa Nhị Thập Tụng Luận, Lục Thập Tụng Như Lí Luận, Thủ Hộ Đại Thiên Quốc Độ Kinh, Biến Chiếu Bát Nhã Ba La Mật Kinh, v.v... tất cả là 115 bộ, gồm 255 quyển. Người đời xưng ngài là Hiển Giáo đại sư. Không ai biết năm sinh và năm mất của ngài.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thi Hứng", "definition": "詩興. Niềm thích thú thúc đẩy việc làm thơ, ngâm thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Khiêu Bất Thượng - Tắng Chưng Bất Thục", "definition": "匙 挑 不 上、甑 蒸 不 熟. Muỗng múc chẳng được, nồi hấp chẳng chín. Thiền cơ nhân duyên khó có thể lãnh ngộ, không dễ ứng phó. Thi khiêu bất thượng: ý nói mềm nhũn. Tắng chưng bất thục: ý nói còn sống, còn cứng. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thi Khí", "definition": "Sikhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Khí Phật", "definition": "Ṣikhin (S), Sikhi-buddha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Khí Thiên", "definition": "Xem Đại Phạm Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Khí Đại Phạm", "definition": "Sikhi-brahman (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi La", "definition": "Xem Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi La Ba La Mật", "definition": "Xem Trì Giới Ba La Mật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi La Bạt Đà La", "definition": "Xem Giới Hiền Luận Sư.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Lễ", "definition": "施禮. Làm lễ chào người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Lợi Sa", "definition": "Sirisa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Nhân", "definition": "詩人. Người làm thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Phệ Đa Ba Nga Phược Để", "definition": "Xem Bạch Thân Quán Tự Tại Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Sĩ", "definition": "詩士. Người giỏi về thơ. Người làm thơ. Thơ Tản Đà: “Nghìn năm thi sĩ tửu đồ là ai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Thiết", "definition": "施 設. 1. Biện pháp của thiền sư chọn lấy để tiếp dẫn người học. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thi Thiết Luận", "definition": "Prajñāpti-śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Thiết Luận Bộ", "definition": "Xem Thuyết Giả Bộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Thu Ma La Sơn Thôn", "definition": "Sisumāragira (S), Simsumaragira (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Thư", "definition": "詩書. Kinh Thi và kinh Thư, hai bộ trong Ngũ kinh của Trung Hoa Chỉ gia đình học hành giỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Thể", "definition": "尸體. Xác người chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Thố", "definition": "施措. Đem tài sức ra làm việc cho người biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Tứ", "definition": "詩思. Ý thơ. Ý tưởng trong bài thơ, câu thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Tỳ Vương", "definition": "Sibi (S), Sivi (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Vị", "definition": "詩味. Niềm thích thú của thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Xã", "definition": "詩社. Đoàn thể gồm những người làm thơ. Thơ Cao Bá Quát: “Câu thơ thi xã con thuyền Nghệ an”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Ân", "definition": "施恩. Làm ơn cho người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thi Đà Lâm", "definition": "Sitavana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thi Đồng", "definition": "詩筒. Cái ống tre thời xưa dùng để đựng những bài thơ làm được. Đoạn trường tân thanh: “Trên yên bút giá thi đồng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thina", "definition": "Dã dượi.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Thina middha", "definition": "Dã dượi buồn ngủ. Dã dượi và buồn ngủ thường đi đôi với nhau. Dã dượi là tâm co rút lại như lông gà đặt gần lửa thì bị teo lại. Buồn ngủ là một tâm thụ động đi theo dã dượi. ThÊna middha là chướng ngại thứ tư trong năm chướng ngại, là đạo binh thứ năm trong mười đạo binh ma.", "source": "Tu Dien Pali - Viet - Binh Anson"}
{"term": "Thinh", "definition": "廳. Phủ quan Nhà lớn để tiếp khách Khu vực hành chánh tại các địa phương dưới thời Thanh Ta thường đọc Sảnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thinh Cảnh", "definition": "Xem Thanh Cảnh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thinh Danh Bất Chánh", "definition": "Xem Da Xá Trưởng Lão.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thinh Tiền Nhất Cú Thiên Thánh Bất Truyền", "definition": "聲 前 一 句 千 聖 不 傳. Một câu (nói) trước khi chưa mở miệng, dù là ngàn thánh ra đời cũng không thể truyền. Nghĩa là một câu “Chính pháp nhãn tạng, Niết Bàn diệu tâm” đã không phải “Ngữ” cũng chẳng phải “Câu” và cũng không phải ngàn Phật muôn Tổ có thể truyền; biểu thị việc lớn hướng thượng Tông thừa không phải do người khác truyền trao mà phải do chính mình thực tế khai ngộ chứng đắc. Tắc 7, Bích Nham Lục (Đại 48, 147 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thinh Văn Tam Đạo", "definition": "聲聞三道 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thinh Văn Tứ Quả", "definition": "聲聞四果 (Kim Cang Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thinh Vận Tinh Nghĩa Kinh", "definition": "Saddaśaratthajalini (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiu Thỉu", "definition": "Pacalāyati (pa + cal + āya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiêm", "definition": "僉. Đều. Cùng Cái néo để đập lúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiêm Sự", "definition": "僉事. Tên chức quan xử án thời xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên", "definition": "Trời. Là tiếng dịch nghĩa từ Phạn ngữ “deva-loka”. Những từ Hán-Việt đồng nghĩa của nó là thiên thượng, thiên đạo, thiên thú, hay thiên giới; dùng chỉ cho cảnh giới của các vị trời cư trú. “Trời” là loài hữu tình cao cấp nhất trong sáu đường (hay ba cõi), mà thông tục thường gọi là “thần” hay “tiên”. Nếu chỉ cho tự thể của loại hữu tình này thì gọi là “thiên nhân” (số ít), hay thiên chúng, thiên bộ, chư thiên (số nhiều). “Trời” vốn là một thứ tín ngưỡng dân gian rất xưa ở Ấn-độ, nhưng đã không có quan niệm rõ ràng nào về sự khác biệt hay tầng bậc cao thấp của các trời. Khi đạo Phật xuất hiện, nó được dùng trong hệ thống vũ trụ quan của Phật giáo.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Biểu", "definition": "(阡表): tấm bia dựng trước ngôi mộ.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Bình", "definition": "T'ien-P'ing (C), Tianping (C), Tempyo (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Bình Tùng Y", "definition": "(天 平 從 漪, Tempei Shūi, ?-?): nhân vật sống dưới thời nhà Tống, pháp từ của Thanh Khê Hồng Tấn (清谿洪進). Ông đã từng sống tại Thiên Bình Sơn (天平山), Tương Châu (相州, Tỉnh Hà Nam).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Bức Luân Tướng", "definition": "(p: heṭṭhā pāda-talesu cakkāni jātāni, 千輻輪相): chỉ cho tướng tốt vi diệu có đầy đủ ngàn bánh xe dưới chân, thuộc một trong 32 tướng tốt, còn gọi là Túc Hạ Thiên Bức Luân Tướng (足下千輻輪相), Thường Hiện Thiên Bức Luân Tướng (常現千輻輪相), Song Túc Hạ Hiện Thiên Bức Luân Triển Chuyển Chúng Tướng (雙足下現千輻輪輾轉眾相). Tướng này chỉ cho các hoa văn dưới lòng bàn chân Phật có hình dáng cả ngàn bánh xe rõ ràng. Tướng này do nghiệp nhân mà cảm được, do thời quá khứ đức Phật đã từng cúng dường, bố thí các thứ cho cha mẹ, sư trưởng, bạn tốt cho đến hết thảy chúng sanh. Tướng này không những chỉ thấy hiện nơi chân Phật, mà còn có cả nơi hai bàn tay Ngài. Tướng ngàn bánh xe còn thể hiện cho sự chuyển bánh xe giáo pháp của ngài; nếu hiện dưới chân là thể hiện cho việc du hóa khắp mọi nơi để chuyển pháp luân; khi thuyết pháp thì tướng này hiện ra nơi lòng bàn tay. Tướng này có thể hàng phục được oán địch, ác ma, thể hiện công đức chiếu phá vô minh và ngu si. Khi nói chân có nghĩa là cả tay chân, nên gọi là tướng tay chân có vòng tròn (s: cakrāṅkita-hasta-pāda-tala). Từ ngàn xưa đã có truyền thống lễ bái dưới lòng bàn chân Phật rồi. Trong Pháp Uyển Châu Lâm (法苑珠林, Taishō No. 2122) quyển 9, phần Xuất Thai Bộ (出胎部) có câu: “Thân biên tắc quang sắc nhất trượng, mi gian tắc bạch hào ngũ xích, khai Vạn tự ư hung tiền, nhiếp thiên luân ư túc hạ (身邊則光色一丈、眉间则白毫五尺。眉間則白毫五尺、开万字于胸前。開萬字於胸前、蹑千轮于足下。躡千輪於足下, bên thân sắc ánh sáng một trượng, giữa lông mi có lông mày trắng năm tấc, mở chữ Vạn nơi trước ngực, hiện ngàn bánh xe ở dưới chân).” Hay trong Đại Bát Niết Bàn Kinh Hậu Phần (大般涅槃經後分, Taishō No. 377) quyển hạ có đoạn: “Thế Tôn đại bi tức hiện nhị túc thiên bức luân tướng, xuất ư quan ngoại hồi thị Ca Diếp, tùng thiên bức luân phóng thiên quang minh, biến chiếu thập phương nhất thiết thế giới (世尊大悲卽現二足千輻輪相、出於棺外迴示迦葉、從千輻輪放千光明、遍照十方一切世界, Thế Tôn có lòng thương xót lớn, tức hiện tướng hai bàn chân có ngàn bánh xe, ra bên ngoài quan tài cho Ca Diếp biết rõ, từ ngàn bánh xe ấy phong ra ngàn ánh sáng, chiếu khắp mười phương hết thảy các thế giới).” Hoặc như trong Biệt Thích Tạp A Hàm Kinh (別譯雜阿含經, Taishō No. 100) quyển 13 cũng có đoạn rằng: “Thời hữu nhất Bà La Môn tánh viết Yên thị, tại Phật hậu lai, kiến Phật tích trung thiên bức luân tướng quái vị tằng hữu, tức tự tư duy, ngã vị kiến nhân hữu như thọ tích (時有一婆羅門姓曰煙氏、在佛後來、見佛跡中千輻輪相怪未曾有、卽自思惟、我未見人有如是跡, lúc bấy giờ có một Bà La Môn họ Yên, từ phía sau Phật đến, thấy trong dấu chân Phật có hình tướng ngàn bánh xe, lấy làm lạ chưa từng có, bèn tự suy nghĩ rằng ta chưa hề thấy người nào có dấu chân như vậy).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Chân Phật", "definition": "天 眞 佛. Chỉ cho bản tính tự nhiên vốn sẵn có, không phải do sức người tạo nên. Lục Tổ Lạc Đạo Ca ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Châu", "definition": "扁舟. Chiếc thuyền nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Chính Ngũ Vị", "definition": "偏 正 五 位. Trình bày hệ thống htiền pháp của tông Tào Động (được khai sáng bởi Lương Giới và Bản Tịch), cũng là phương pháp đặc biệt của tông này dùng để tiếp dẫn người học. X. Ngũ Vị Quân Thần. Tiết Tông Thừa Yếu Nghĩa trong DTNL q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Chúa", "definition": "天主. Đức Chúa trời. Đáng lẽ đọc Thiên chủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Chương", "definition": "天章. Vẻ sáng đẹp trên trời, tức chỉ chung trăng sao trên trời. Bản dịch Chinh phụ ngâm khúc: “Ngửa trông xem vẻ thiên chương thẫn thờ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Chủ", "definition": "Xem Thiên Vương Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Chức", "definition": "天職. Việc làm trời trao cho. Việc làm tự nhiên thuộc về phần mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Cung", "definition": "Deva-pura (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Cung Sự", "definition": "Vimāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Cung Tự", "definition": "(天宮寺): ngôi bảo sát được kiến lập dưới thời nhà Đường, hiện tọa lạc tại Phủ Lạc Dương (洛陽府), Hà Nam (河南). Nguyên lai chùa là tư gia của vua Thái Tông (太宗, tại vị 626~649); đến năm 632 (Trinh Quán [貞觀] 6), nhà vua hạ chiếu cải gia vi tự. Vào năm 638 (Trinh Quán 12), Pháp Hộ (法護, ?-?) được sắc chỉ trú trì chùa này. Từ đó trở đi, chư vị cao đức, tiếng tăm đến đây cư trú mỗi ngày một nhiều; chùa trở thành ngôi danh sát ở Đông Đô. Vua Cao Tông (高宗, tại vị 649-683) nhà Đường đã từng thân chinh đến đây thiết trai cúng dường. Vào năm 692 (Trường Thọ [長壽] 2) đời Võ Hậu, Tam Tạng Pháp Sư của nước Ca Thấp Di La (s: Kaśmīra, p: Kasmīra, 迦濕彌羅) là A Nhĩ Chơn Na (阿儞眞那, Bảo Tư Duy [寶思惟]) đến Lạc Dương, phụng sắc chỉ trú tại chùa này, dịch một số kinh điển như Cầu Tức Đắc Tự Tại Đà La Ni Kinh (求得自在陀羅尼經), Bất Không Quyên Sách Đà La Ni Tự Tại Vương Chú Kinh (不空羂索陀羅尼自在王咒經), v.v. Lúc bấy giờ, Huệ Tú (慧秀) cũng trú tại đây, chuyên trì giới kiên cố, thông đạt Thiền định. Mỗi khi Võ Hậu đến Đông Đô, đều mời ông đến để tham vấn pháp yếu. Đặc biệt, Thần Tú (神秀, 605-706) đã từng truyền bá Bắc Tông Thiền tại ngôi già lam này. Sau này có Quảng Tế (廣濟) đến trú, cùng với Bát Nhã Tam Tạng (s: Prajñā, 般若三藏, 734-?) tham gia công tác phiên dịch bộ Tứ Thập Hoa Nghiêm. Dưới thời Ngũ Đại, có Tùng Ẩn (從隱) trú trì tại đây, rất nổi tiếng với Tánh Tướng Học. Về sau, chùa hưng thịnh thế nào không rõ và cuối cùng phải chịu số phận phế tuyệt.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Có Kệ", "definition": "Devatā-samyutta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Cơ", "definition": "天機. Sự sắp đặt sẵn của trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Cư", "definition": "遷居. Dời chỗ ở, từ vùng này tới vùng khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Cổ", "definition": "千古. Nghìn xưa. Rất lâu đời Chỉ người đã chết. Hát nói của Nguyễn Công Trứ: “Đã gọi người nằm thiên cổ dậy”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Cổ Lôi Âm Phật", "definition": "Divyadundubhi-meghanirghoṣa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Diệp", "definition": "(千葉, Chiba): tên gọi của một dòng họ, chi lưu của Lương Văn (良文, Yoshifumi) thuộc họ Hoàn Võ Bình (桓武平). Vào thời Trung Đại, dòng họ này vốn là hào tộc, đến sinh sống ở Quận Thiên Diệp (千葉郡, Chiba-gun), Hạ Tổng (下總, Shimōsa), rồi lấy tên vùng này làm họ của mình. Sau đó, dòng họ này đi theo dòng họ Bắc Điều (北條, Hōjō), và cuối cùng bị dòng họ Phong Thần (豐臣, Toyotomi) tuyệt diệt", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Diệp Thị Dận", "definition": "(千葉氏胤, Chiba Ujitane, 1337-1365): vị Võ Tướng dưới thời đại Nam Bắc Triều; Đương Chủ đời thứ 13 của dòng họ Thiên Diệp; con trai thứ của Thiên Diệp Trinh Dận (千葉貞胤, Chiba Sadatane); thân mẫu là cháu của Tằng Cốc Giáo Tín (曾谷敎信, Soya Kyōshin). Ông kế thừa làm chức Thủ Hộ 3 tiểu quốc: Thượng Tổng (上總, Kazusa), Hạ Tổng (下總, Shimōsa) và Y Hạ (伊賀, Iga). Ông đã từng lập khá nhiều chiến công trong trận mạc. Vào năm 1365, ông nhuốm bệnh ở kinh đô Kyoto, và trên đường về cố hương, ông qua đời tại Mỹ Nùng (美濃, Mino), hưởng dương 29 tuổi. Con trai ông, Thánh Thông (聖聰, Shōsō), là vị Tăng của Tịnh Độ Tông và cũng là người có công trong việc sáng kiến Tăng Thượng Tự (增上寺, Zōjō-ji).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Duyên", "definition": "天緣. Mối ràng buộc vợ chồng do trời định. Duyên trời. Truyện Hoa Tiên: “Khen rằng này thực thiên duyên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Dữ", "definition": "Xem Đề Bà Đạt Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Gia", "definition": "(天家): có hai nghĩa chính. (01) Từ xưng hô đối với thiên tử. Như trong tác phẩm Độc Đoán (獨斷) của Thái Ung (蔡邕, 133-192) nhà Hán có giải thích rằng: “Thiên gia, bách quan tiểu lại chi sở xưng, thiên tử vô ngoại, dĩ thiên hạ vi gia, cố xưng thiên gia (天家、百官小吏之所稱、天子無外、以天下爲家、故稱天家, thiên gia là từ xưng hô của trăm quan lại, thiên tử không ngoại lệ, lấy thiên hạ làm nhà, nên gọi là thiên gia [nhà trời]).” Hay trong bài thơ Tri Phủ Tôn Học Sĩ Kiến Thị Ngũ Thủ Nhân Dĩ Xuyết Thiên (知府孫學士見示五首因以綴篇) của Phạm Trọng Yêm (范仲淹, 989-1052) nhà Tống có câu: “Hồng hà lục trúc vong cơ địa, vị miễn thiên gia hạ chiếu cầu (紅霞綠竹忘機地、未免天家下詔求, ráng hồng trúc biếc quên vạn sự, chẳng khỏi vương gia hạ chiếu tìm).” (02) Chỉ nhà đế vương. Như trong Tấn Thư (晉書), Truyện Hồ Phấn (胡奮傳), có câu: “Lịch quán tiền đại, dữ thiên gia hôn (歷觀前代、與天家婚, xét khắp các đời trước, đều cùng với nhà đế vương kết hôn).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Giới", "definition": "Heaven.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Giới Tự", "definition": "(天界寺, Tenkai-ji): hiện tọa lạc tại phía Nam Kim Lăng (金陵, Nam Kinh), Phủ Giang Ninh (江寧府, Tỉnh Giang Tô), trên núi Phụng Sơn (鳳山), tên cũ là Long Tường Tập Khánh Tự (龍翔集慶寺), còn gọi là Đại Long Tường (大龍翔), một trong những danh lam của Trung Quốc. Vào năm đầu (1328) niên hiệu Thiên Lịch (天曆), vua Văn Tông nhà Nguyên bỏ ly cung của mình ở phía bắc Cầu Đại Thị (大市橋) trong Thành Kim Lăng (金陵城) và biến nơi đây thành chùa; năm sau nhà vua cung thỉnh Tiếu Ẩn Đại Hân (笑隱大訢) ở Trung Thiên Trúc Tự (中天竺寺), Hàng Châu (杭州) đến làm tổ khai sơn chùa này. Đến năm thứ 9 (1349) niên hiệu Chí Chánh (至正), Phù Trung Hoài Tín (孚中懷信) đến trú tại đây và làm cho chùa hưng thịnh. Vào năm thứ 17 (1357) cùng niên hiệu trên, Giác Nguyên Huệ Đàm (覺源慧曇) đến trú trì và theo sắc chỉ chùa được đổi tên thành Đại Thiên Giới Tự (大天界寺). Đến tháng 3 năm đầu (1368) niên hiệu Hồng Võ (洪武) đời vua Thái Tổ nhà Minh, nhà vua cho kiến lập Thiện Thế Viện (善世院) trong khuôn viên chùa, cử Huệ Đàm trú trì nơi đây và quản lý toàn thể Phật Giáo. Cũng vào lúc này, chùa được đổi tên thành Thiên Giới Thiện Thế Thiền Tự (天界善世禪寺) và xếp lên trên cả hệ thống Ngũ Sơn. Nam Thiền Tự (南禪寺, Nanzen-ji) của Nhật Bản do Quy Sơn Pháp Hoàng (龜山法皇) kiến lập được liệt trên Ngũ Sơn cũng bắt chước theo trường hợp này. Vào năm thứ 21 (1388) cùng niên hiệu trên, chùa bị lửa thiêu cháy tan tành nên được dời về vị trí hiện tại; đến năm thứ 23 (1390), chùa được trùng tu lại và có tên là Thiên Giới Thiện Thế Thiền Viện (天界善世禪院). Sau đó, vào năm thứ 30 (1397) niên hiệu Hồng Võ, Thứu Phong Đạo Thành (鷲峰道成) đến trú trì chùa; ngoài ra, trong khoảng thời gian niên hiệu Sùng Trinh (崇禎, 1628-1644), Vô Dị Nguyên Lai (無異元來) cũng như Giác Lãng Đạo Thạnh (覺浪道盛) thay nhau làm trú trì và nỗ lực cử xướng tông phong của họ. Vào năm thứ 17 (1660) niên hiệu Thuận Trị (順治), chùa nhất thời bị hoang phế, nhưng sau đó thì được trùng tu lại.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Hoa", "definition": "Deva-puppha (P), Divya-puspa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Hoa Loạn Trụy", "definition": "天 花 亂 墜. Hoa trời rơi tới tấp. Truyền thuyết khi Lương Võ Đế, pháp sư Vân Quang giảng kinh, cảm động đến trời, hương hoa từ không trung rơi tới tấp. Về sau, nhà thiền dùng từ ngữ này hình dung việc thuyết pháp hay, làm cảm động mọi người. Chương Thanh Bình sơn Linh Tuân Thiền Sư trong CĐTĐL q. 15 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Hoa Lạc - Thạch Điểm Đầu", "definition": "天 花 落 石 點 頭. Hoa trên trời rơi xuống, đá gật đầu. Hình dung việc giảng kinh thuyết pháp rất hay làm người nghe cảm động, đến nỗi trên trời có hoa thơm rơi xuống, đá cứng cũng cảm động mà gật đầu. Tiết Vân Cư Đạo Ưng Thiền Sư trong NĐHN q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Hoàng Tự", "definition": "天 皇 寺 (68). ở huyện Giang Lăng, tỉnh Hồ Bắc, Trung Quốc. Chùa được xây dựng vào đời Lương Nam Triều, khi ấy Pháp Luận từng ở chùa này dạy dỗ đệ tử. Đời Bắc Chu Võ Đế, đây là nơi hủy Phật pháp của Nan Ba và Kinh Sở, bởi trong chùa có tượng Khổng Tử do vị tăng vẽ nên được đổi làm trường học, tránh khỏi bị hủy diệt. Thời Đường Đức Tông, Linh Giám nghinh đón đệ tử nối pháp của Thạch Đầu Hy Thiên là Thiền Sư Đạo Ngộ đến bản tự, tu sửa đường vũ, hoằng dương Phật pháp. Đời Tống ban đầu gọi là “Thái Bình Hưng Quốc Tự”, sau đổi tên là “Càn Minh Tự”. Khoảng niên hiệu Hồng Vũ (1368-1398) đời Minh xây dựng lại.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Hoàng Đạo Ngộ", "definition": "(天皇道悟, Tennō Dōgo, 748-807): người Huyện Kim Hoa (金華), Tỉnh Triết Giang (浙江, thuộc Vụ Châu), họ là Trương (張). Năm lên 14 tuổi, ông có chí xuất gia, rồi sau xuống tóc xuất gia với vị Đại Đức ở Minh Châu (明 州, thuộc Tỉnh Triết Giang), và năm 25 tuổi thì thọ cụ túc giới tại Trúc Lâm Tự (竹 林 寺) ở Hàng Châu (杭 州, thuộc Tỉnh Triết Giang). Sau đó, ông chuyên tâm tu tập phạm hạnh. Có hôm nọ, ông ngao du Dư Hàng, tham yết Kính Sơn Pháp Khâm (徑山法欽) và theo hầu vị nầy trong vòng 5 năm. Trong khoảng thời gian niên hiệu Đại Lịch (大 歷, 766-779), ông vào tu trong Đại Mai Sơn (大梅山), rồi trong khoảng đầu niên hiệu Kiến Trung (建 中, 780-783), ông đến vùng Chung Lăng (鍾 陵, Tỉnh Giang Tây), tham bái Mã Tổ Đạo Nhất (馬祖道一), và lưu lại với vị nầy được 2 năm. Cuối cùng ông đến tham bái Thạch Đầu Hy Thiên (石頭希遷) và kế thừa dòng pháp của vị nầy. Sau đó, ông đến sống tại Sài Tử (柴紫) thuộc Đương Dương (當陽), Kinh Châu (荆 州), học đồ theo ông rất đông. Tiếp theo, ông chuyển đến sống tại Thiên Hoàng Tự (天 皇 寺) ở Thành Đông, Kinh Châu. Vào ngày 30 tháng 4 năm thứ 2 niên hiệu Nguyên Hòa (元和), ông thị tịch, hưởng thọ 60 tuổi đời và 35 hạ lạp.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Hoàng Đạo Ngộ Tien", "definition": "Huang Tao wu (C), Tennō Dōgo (J), TianhuangDaowu (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Huống", "definition": "(天貺): ân sủng trời ban. Như trong Thông Dịch Luận (通易論) của Nguyễn Tịch (阮籍, ?-?) nhà Ngụy thời Tam Quốc có câu: “Chiêu minh kỳ đạo, dĩ đáp thiên huống (昭明其道、以答天貺, sáng tỏ đạo ấy, để đáp ơn trời).” Hay trong bài Thành Quân Phúng (成均諷) của Tư Không Đồ (司空圖, 837-908) nhà Đường lại có câu: “Cố dĩ cảm động thiên huống, cương kỷ nhân luân (故以感動天貺、紀綱人倫, nên lấy sự cảm động ơn trời ban để làm kỷ cương luân lý con người).” Hiện tại dân gian Trung Quốc vẫn còn lưu hành Thiên Huống Tiết (天貺節) vào ngày mồng 6 tháng 6 Âm Lịch. Thời xưa, dân gian Hoài An (淮安) thuộc Tỉnh Giang Tô (江蘇省) có tập tục gọi là Sái Hồng Lục (曬紅綠) vào ngày mồng 6 tháng 6. Tương truyền tập tục này xuất phát từ thời nhà Đường (唐, 618-907). Huyền Trang (玄奘, 602-664), cao tăng nhà Đường, sang Tây Thiên thỉnh kinh, trên đường trở về nước, khi đi ngang qua biển, một số kinh điển bị rơi xuống biển, ẩm ướt, nên vào ngày mồng 6 tháng 6 này người ta lấy kinh văn ra để phơi khô. Từ đó, ngày này trở thành ngày tốt lành. Khởi đầu, vào ngày này trong hoàng cung tiến hành phơi Long Bào của nhà vua, sau đó tập tục này được lưu truyền ra dân gian. Vào đúng ngày này, nhà nào cũng đem áo quần ra phơi nơi cổng nhà. Vì vậy, ở Dương Châu (揚州) vẫn có câu ngạn ngữ rằng: “Lục nguyệt lục gia gia sái hồng lục (六月六家家曬紅綠, mồng sáu tháng sáu nhà nhà phơi áo quần).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Hy", "definition": "千 熙 (1335-1415). Thiền tăng Cao Ly, họ Phác. Niên hiệu Chí Chính thứ 24 (1364) vượt biển sang nhà Nguyên (Trung Quốc) tầm phỏng thiện tri thức, đến chùa Thánh Ân tham học với Thiền Sư Vạn Phong Thời Uùy mà đắc pháp, đời thứ 26 hệ Nam Nhạc. Sư là một trong những Tổ sư tông Tào Khê Triều Tiên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Hà", "definition": "天河. Sông trời. Tức sông Ngân hà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Hóa", "definition": "遷 化. Còn gọi: Niết Bàn, Viên Tịch, Diệt Độ, Thuận Thế, Quy Chân. Chỉ cho việc thị tịch của hàng tăng lữ. Những bậc Cao tăng có đức độ, khi duyên giáo hóa chúng sinh ở cõi này đã hết liền dời sang cõi khác để hóa độ chúng sinh ở đó. Truyện Đàm Giới trong Lương Cao Tăng truyện q. 5 (Đại 50, 356 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Hương", "definition": "天香", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thiên Hạ", "definition": "天下. Dưới trời. Chỉ mọi người ở đời. Đoạn trường tân thanh: “Mà cho thiên hạ trông vào cũng hay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Hạ Hoành Hành", "definition": "天 下 橫 行. Hình dung khí thế vận dụng vô ngại, chẳng chịu người lừa, tùy chỗ làm chủ của người ngộ đạo. Pháp Diễn Ngữ Lục q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Hạnh", "definition": "Là một trong năm hạnh của hàng Bồ-tát. “Thiên” tức là lí lẽ của thiên nhiên, hàng Bồ-tát thuận theo lí lẽ của thiên nhiên mà nên hạnh nhiệm mầu, đó là “thiên hạnh”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Hải", "definition": "(天海, Tenkai, 1536-1643): vị tăng của Thiên Thai Tông Nhật Bản, sống vào khoảng thời đại An Thổ Đào Sơn (安土桃山) và đầu thời Giang Hộ, vị tổ thời Trung Hưng của Thiên Thai Tông, húy là Tùy Phong (隨風), Thiên Hải (天海), hiệu Nam Quang Phường (南光坊) và Trí Lạc Viện (智樂院), thụy hiệu là Từ Nhãn Đại Sư (慈眼大師), xuất thân vùng Fukushima-ken (福島縣). Ông xuất gia lúc 11 tuổi, đến năm 14 tuổi thì lên Tỷ Duệ Sơn (比叡山, Hieizan), theo học Thiên Thai với Thật Toàn (實全), Câu Xá với Tôn Thật (尊實), rồi Tam Luận và Pháp Tướng với Thật Không (實空). Sau khi Chức Điền Tín Trưởng (織田信長, Oda Nobunaga) đốt cháy toàn bộ Tỷ Duệ Sơn, ông dẫn đồ chúng đến nương náu nơi Võ Điền Tín Huyền (武田信玄, Takeda Harunobu) ở vùng Giáp Phỉ (甲斐, Kai). Từ đó về sau, ông từng đến trú ở Bất Động Viện (不動院), rồi Hỷ Đa Viện (喜多院) vùng Võ Tàng (武藏, Musashi, thuộc Saitama-ken [埼玉縣]). Đến năm 1607, ông trở về sống tại Nam Quang Phường trên Tỷ Duệ Sơn, rồi nỗ lực tập trung cho việc phục hưng Sơn Môn. Năm 1616, ông được cử làm Đại Tăng Chánh, rồi cùng năm đó, ông lấy nghi Nhất Thật Thần Đạo để làm lễ an táng cho Gia Khang (家康, Ieyasu). Vào năm 1624, ông kiến lập Khoan Vĩnh Tự (寬永寺) ở Đông Duệ Sơn (東叡山) và làm tổ khai sơn của chùa này. Ông được sự tín nhiệm của 3 đời Tướng Quân Gia Khang, Tú Trung và Gia Quang; nên thường tham gia bàn chính sự trong Mạc Phủ, và lần đầu tiên đã thống chế các phái của Thiên Thai Tông Nhật Bản. Trước tác của ông để lại có Nhất Thật Thần Đạo Bí Quyết (一實神道秘決) 1 quyển, Dị Bộ Kiến Văn Thuật Ký Định Thư (異部見聞述記掟書) 1 quyển, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Hỏa", "definition": "Cosmic fire.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Hộ", "definition": "千户. Viên chức địa phương thời xưa, trông coi một nghìn nhà, tương tự như Chánh tổng Tên một chức quan võ nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Hữu", "definition": "Xem Bà Tu Mật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Khoan Địa Trách", "definition": "天 寬 地 窄. Còn gọi: Thiên Địa Huyền Thù, Thiên Địa Huyền Cách. Cách đạo rất xa. NĐHN q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Khu", "definition": "天樞. Cột trời. Chỉ ông vua. Chiến Tụng Tây hồ phú của Phạm Thái: “Quyết gan này đem lại đấng thiên khu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Không", "definition": "Nghĩa là nghiêng chấp về lí không.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Khải Kinh", "definition": "Srauta Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Kim", "definition": "千金. Nghìn vàng. Chỉ sự cực quý giá. Tự tình khúc của Cao Bá Nhạ: “Giữ gìn di thể như hình thiên kim”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Kiến", "definition": "偏見. Cái nghĩ lệch lạc, không công bằng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Kiến Luận Chú", "definition": "Samantapasadika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Kỳ Thụy", "definition": "Tien chi Shui (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên La Quốc", "definition": "Devala (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Liễu Bách Đáng", "definition": "千 了 百 當. Còn gọi: Thiên Ẩn Bách Đáng. Mục đích của đời tu (việc lớn) xong xuôi. Việc lớn đã xong. Tiết Tông Thừa Yếu Nghĩa trong DTNL q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Long", "definition": "Tien lung (C), Tenryu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Long Bát Bộ", "definition": "Thiên, Long, Dạ Xoa (quỷ dũng mãnh), Càn Thác Bà (hương thần), A Tu La (phi thiên), Ca Lâu La (Kim Xí Điểu), Khẩn Na La (phi nhơn), Ma Hầu La Già (Đại Mãng Xà).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Long Tự", "definition": "(天龍寺, Tenryu-ji): ngôi chùa trung tâm của Phái Thiên Long Tự (天龍寺派) thuộc Lâm Tế Tông, ngôi Thiền Tự được xây dựng vào đời đại Nam Bắc Triều, tọa lạc tại số 68 Sagatennōjisusukinobabachō (嵯峨天龍寺芒ノ馬場町), Ukyō-ku (右京区), Kyoto-shi (京都市), Kyoto-fu (京都府); hiệu núi là Linh Quy Sơn (靈龜山), còn gọi là Thiên Long Tư Thánh Thiền Tự (天龍資聖禪寺); tên chính thức là Linh Quy Sơn Thiên Long Tư Thánh Thiền Tự (靈龜山天龍資聖禪寺). Lúc ban đầu mới thành lập thì chùa được gọi là Lịch Ứng Tự (曆應寺), nhưng không bao lâu thì tên này được sửa đổi. Đây là ngôi chùa đứng hàng đầu nổi tiếng trong năm ngôi bảo sát ở vùng kinh đô Kyoto. Nơi vùng đất chùa ngày xưa có Đàn Lâm Tự (檀林寺), rồi có Tiên Động Ngự Sở của Hậu Tha Nga Thượng Hoàng (後嵯峨上皇), và Ly Cung của Quy Sơn Thiên Hoàng (龜山天皇, Kameyama Tennō). Vào năm thứ 4 (1339) niên hiệu Diên Nguyên (延元), khi Hậu Đề Hồ Thiên Hoàng (後醍醐天皇, Godaigo Tennō) băng hà ở vùng Cát Dã (吉野, Yoshino), theo lời khuyên của Mộng Song Sơ Thạch (夢窻疎石), Tướng Quân Túc Lợi Tôn Thị (足利尊氏, Ashikaga Takauji) mới nhận chiếu chỉ và khai sáng chùa này. Chính bản thân Mộng Song và Túc Lợi đã tự mình bưng đất cát xây chùa, rồi cho đến năm thứ 6 (1345) niên hiệu Hưng Quốc (興國) thì chùa được hoàn thành, và Mộng Song trở thành vị Tổ khai sơn chùa này. Kế đến bảy ngôi đường vũ già lam cũng đều được hoàn bị. Về sau, chùa cũng đã nhiều lần bị nạn binh hỏa, các ngôi đường vũ dần dần bị cháy tan tành. Đến trong khoảng niên hiệu Ứng Vĩnh (應永, 1394-1427), khuôn viên chùa được nới rộng ra thêm, có đến khoảng 110 ngôi tháp. Kiến trúc hiện còn lại là Tổng Môn, Sắc Tứ Môn, Chánh Điện, Pháp Đường, Thư Viện, Đại Phương Trượng, Tuyển Phật Trường, Tàng Kinh, Sơn Môn, v.v. Phần lớn những kiến trúc này đều được xây dựng lại dưới thời Minh Trị trở về sau. Chánh Điện chùa được gọi là Đa Vũ Điện (多宇殿), nơi đây an trí tôn bia của Hậu Đề Hồ Thiên Hoàng. Còn ở trên trần nhà của Pháp Đường có vẽ hình rồng ẩn trong mây, là thư bút nổi tiếng của Linh Mộc Tùng Niên (鈴木松年). Trong khuôn viên chùa còn có rất nhiều tòa viện và chùa nhỏ như Kim Cang Viện (金剛院), Bảo Thọ Viện (寶壽院), Từ Tế Viện (慈濟院), Diệu Trí Viện (妙智院), Tùng Nham Tự (松岩院), Lộc Vương Viện (鹿王院), Tây Phương Tự (西芳寺), Địa Tạng Viện (地藏院), v.v. Đình viên Tào Nguyên Trì (曹源池) của chùa được công nhận là thắng cảnh nổi tiếng, tương truyền do tay Mộng Song Sơ Thạch làm ra.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Luân", "definition": "(天倫):", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Lí", "definition": "千里. Nghìn dặm. Chỉ đường dài, hoặc sự cách trở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Lôi", "definition": "天雷. Sấm trời. Chỉ vị thần làm sấm sét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Lý Vạn Lý", "definition": "千 里 萬 里. Ngàn dặm muôn dặm, ý nói cùng với thiền nghĩa cách nhau rất xa. Đây là lời thiền sư ưa dùng. Tào Sơn Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Lợi Hưu", "definition": "(千利休, Sen-no-Rikyū, 1522-1591): vị tổ khai sáng ra Trà Đạo Nhật Bản, sống vào khoảng giữa hai thời đại Chiến Quốc (戰國, Sengoku) và An Thổ Đào Sơn (安土桃山, Azuchimomoyama), húy là Tông Dị (宗易), hiệu Lợi Hưu (利休), Phao Thuyên Trai (抛筌齋), Bất Thẩm Am (不審庵), xuất thân vùng Hòa Tuyền (和泉, Izumi, thuộc Ōsaka-fu [大阪府]). Ban đầu ông theo học với mấy nhân vật nỗi tiếng về trà như Đạo Trần (道陳) và Thiệu Âu (紹鷗) ở vùng Hòa Tuyền, kế đến tham vấn Thiền với Đại Lâm Tông Sáo (大林宗套), Tiếu Lãnh Tông Hân (笑嶺宗訢), và thành công trong việc sáng tạo ra loại hình thức uống trà trong tĩnh lặng gọi là Wabicha (侘茶) để thấu triệt tận cùng tinh thần của Thiền. Ông cũng đã từng phục vụ cho hai Tướng Quân Chức Điền Tín Trưởng (織田信長, Oda Nobunaga) và Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi) với tư cách là Thiền tăng pha trà. Đến năm 1587, ông đã cùng với Kim Tỉnh Tông Cửu (今井宗久), Tân Điền Tông Cập (津田宗及) đóng vai trò người ngồi hầu sau lưng Tú Cát trong Đại Hội Trà Bắc Dã, và được xem như là bậc trà tượng số một trong thiên hạ. Vào năm 1589, theo lời khuyên của Cổ Khê Tông Trần (古溪宗陳), ông đem an trí tiêu tượng của mình ở Sơn Môn Đại Đức Tự (大德寺, Daitoku-ji). Tương truyền rằng cũng chính vì việc làm nầy mà ông tạo nên mối nghi ngờ cho Tú Cát, nên ông đã dùng đao tự vẫn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Lương", "definition": "天良. Phần tốt đẹp có sẵn của con người do trời ban cho. Thơ Tản Đà: “Là việc thiên lương của nhân loại”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Lại", "definition": "天 籟. Sáo trời, tức là những âm hưởng của tự nhiên như gió thổi vào hang, tiếng reo của cây… Thiên Bán Dạ Thì trong Khóa Hư Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Ma", "definition": "Tức ma vương Ba-tuần ở cõi trời thứ sáu (tức cõi trời Tha-hóa-tự-tại của cõi Dục), có vô số quyến thuộc, thường gây chướng ngại cho những người tu hành theo đạo giác ngộ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Ma Ba Tuần", "definition": "Sreshtha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Môn", "definition": "天門. Cửa trời. Thơ Tản Đà: “Thiên môn Đế khuyết như là đây”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Mệnh", "definition": "天命. Sự sắp đặt của trời cho mỗi người Chỉ cuộc đời và sự sống chết của mỗi người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Mụ", "definition": "Tên chùa. Cũng gọi Linh Mụ. Chùa do Chúa Nguyễn Phúc Chu (tức Hiền Minh Vương) xây dựng, có cơ ngơi rộng rãi, tráng lệ, dựng bia đá trắng khắc bài văn ghi có chiếc khánh đá quý do một nước phương Tây tặng để trên gác chùa.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiên Mục", "definition": "(天目, Temmoku, 1245-1308 hay 1337 [?]): vị Tăng của Nhật Liên Tông, sống vào khoảng cuối thời Liêm Thương, húy là Thiên Mục (天目), Nhật Thạnh (日盛); hiệu là Mỹ Nùng A Xà Lê (美濃阿闍梨), Thượng Pháp Phòng (上法房); xuất thân vùng Tĩnh Cương (靜岡, Shizuoka). Năm 1281, ông theo xuất gia với Nhật Liên, rồi sau khi thầy qua đời; ông chủ xướng về Nghĩa Bổn Tích Thắng Liệt, và luận nạn với 6 vị lão Tăng hàng đầu của Nhật Liên. Sau ông khai sáng ra Diệu Hiển Tự (妙顯寺) ở vùng Tá Dã (佐野, Sano), Hạ Dã (下野, Shimotsuke); Diệu Quốc Tự (妙國寺) ở Phẩm Xuyên (品川, Shinagawa), Võ Tàng (武藏, Musashi, thuộc Tokyo), và Bổn Môn Tự (本門寺) ở Tiểu Thắng (小勝), Thường Lục (常陸, Hitachi). Đời sau mới lấy mấy chùa này làm cứ điểm cho Phái Nhất Mục mà hóa đạo. Trước tác của ông có Viên Cực Thật Nghĩa Sao (圓通極實義抄) 2 quyển, Bổn Tích Vấn Đáp Thất Trùng Nghĩa (本迹問答七重義)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Mục Minh Bản Thiền Sư Tạp Lục", "definition": "天 目 明 本 禪 師 雜 錄. X. Trung Phong Hòa Thượng Tạp Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Mục Mãn", "definition": "Tien mu Man (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Mục Trung Phong Hòa Thượng Quảng Lục", "definition": "(天目中峰和尚廣錄, Temmokuchūhōoshōkōroku): xem Trung Phong Hòa Thượng Quảng Lục (中峰和尚廣錄, Chūhōoshōkōroku) 30 quyển, do Trung Phong Minh Bổn (中峰明本) nhà Tống soạn, Từ Tịch (慈寂) biên, san hành năm đầu (1325) niên hiệu Chí Nguyên (至元), trùng san vào năm thứ 20 (1387) niên hiệu Hồng Võ (洪武), là bộ Ngữ Lục của Trung Phong Minh Bổn, còn gọi là Thiên Mục Trung Phong Hòa Thượng Quảng Lục (天目中峰和尚廣錄, Temmokuchūhōoshōkōroku). Vào năm thứ 2 (1334) niên hiệu Nguyên Thống (元統), bộ này được dâng lên triều đình xin nhập vào Đại Tạng Kinh và nhận được sắc chỉ cho phép, đến năm sau cho khắc bản nhưng trong khi chưa được lưu bố rộng rãi thì cháy mất. Trải qua hơn 50 năm, Trương Tử Hoa (張子華) cùng với hai vị tăng là Trí Cảo (智暠), Huệ Trạch (慧澤) tìm cách cho san hành lại. Từ quyển 1 đến 10 gồm những bài thị chúng, tiểu tham, niêm cổ, tụng cổ, pháp ngữ, thư vấn, Phật sự, tán Phật tổ, tự tán, đề bạt; quyển 11 là Sơn Phòng Dạ Thoại (山房夜話); quyển 12 là Tín Tâm Minh Tịch Nghĩa Giải (信心銘闢義解); quyển 13 là Lăng Nghiêm Trưng Tâm Biện Kiến Hoặc Vấn (楞嚴徵心辯見或問); quyển 14 là Biệt Truyện Giác Tâm (別傳覺心); quyển 15 là Kim Cang Bát Nhã Lược Nghĩa (金剛般若略義); quyển 16 là Huyễn Trú Gia Huấn (玄住家訓); quyển 17 là Nghĩ Hàn Sơn Thi (擬寒山詩); quyển 18 là Đông Ngữ Tây Thoại (東語西話); quyển 19-20 là đồng tục tập; quyển 21-26 là các bài phú, ký, châm, minh, tựa, văn, sớ, tạp trước, v.v.; quyển 27-30 là kệ tụng. Cuối quyển có thêm các hành lục, tháp minh, bia đạo hạnh và bản Nhập Tạng Tinh Phong Hiệu Quốc Sư Biểu (入藏並封號國師表)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Nam Dư Hạ Tập", "definition": "天南餘暇集. Tên một bộ sách viết bằng chữ Hán của vua Lê Thánh Tông và các văn thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Nam Động Chủ", "definition": "天南洞主. Hiệu của vua Lê Thánh Tông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Nga", "definition": "Haṃsa (S), Mythical swan.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nghiệp Thí Dụ", "definition": "Divyavadāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhai", "definition": "天涯. Chân trời. Chỉ nơi cực xa xôi. Hát nói của Cao Bá Quát: “Kìa kìa hải giác thiên nhai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Nham Nguyên Trường", "definition": "(千巖元長, Sengan Genchō, 1284-1357): vị tăng của Lâm Tế Tông Trung Quốc, hiệu Thiên Nham (千巖), tự là Vô Minh (無明), xuất thân Tiêu Sơn (蕭山), Việt Châu (越州, Tỉnh Triết Giang), họ Đổng (董). Năm lên 7 tuổi, ông cùng với Tỳ Kheo Đàm Phương (曇芳) nhập môn Pháp Môn Viện (法門院) ở Phú Dương (富陽, Tỉnh Triết Giang), rồi đến năm 19 tuổi thì xuất gia và thọ giới cụ túc. Sau đó, ông học về giới luật ở Linh Chi Tự (靈芝寺), Võ Lâm Sơn (武林山, Tỉnh Triết Giang) và cuối cùng kế thừa dòng pháp của Trung Phong Minh Bổn (中 峰 明 本). Từ đó, ông bắt đầu giáo hóa ở Vô Minh Tự (無明寺) thuộc Phục Long Sơn (伏 龍山), Ô Thương (烏傷). Vào tháng 10 năm thứ 4 (1327) niên hiệu Thái Định (泰定), ông tiến hành tu sửa Thánh Thọ Tự (聖壽寺) và làm trú trì chùa nầy. Ông được ban tặng cho một số danh hiệu như Phổ Ứng Diệu Trí Hoằng Biện (普應妙智弘辯), Phật Huệ Viên Giám Đại Nguyên Phổ Tế (佛 慧 圓 鑑 大 元 普 濟), Phật Huệ Viên Minh Quảng Chiếu Vô Biên Phổ Lợi Đại Thiền Sư (佛慧圓明廣照無邊普利大禪師). Đến ngày 14 tháng 6 năm thứ 17 niên hiệu Chí Chánh (至正), ông thị tịch, hưởng thọ 74 tuổi đời và 56 hạ lạp. Ông có để lại tác phẩm Thiên Nham Hòa Thượng Ngữ Lục (千 巖和尚語錄) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Nhan", "definition": "天顏. Khuôn mặt của trời. Chỉ mặt vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Nhiên", "definition": "(739-824): là vị thiền sư đời Đường, đệ tử của thiền sư Thạch Đầu Hi Thiên. Ban đầu ngài theo Nho học, sau nhân gặp một vị thiền sư mà được tỉnh ngộ; liền đến Nam-nhạc xin làm môn nhân của ngài Thạch Đầu, hầu hạ 3 năm, được cạo đầu thọ giới. Sau đó ngài tìm đến Giang-tây, xin yết kiến Mã đại sư, được đặt cho pháp hiệu là Thiên Nhiên. Ngài trú tại ngọn Hoa-đỉnh của núi Thiên-thai 3 năm, rồi sang Kính-sơn tham bái thiền sư Quốc Nhất. Sau đó lại trụ tích tại núi Đan-hà ở Nam-dương. Năm 824 (cuối đời vua Đường Mục-tông) ngài viên tịch, thế thọ 86 tuổi.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Nhiệt", "definition": "Xem Đề Bà Đạt Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhân Sư", "definition": "Most Honoured One among human and heavenly beings, Śastā-deva-manusyānam (S), Teacher of devas and men.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhãn", "definition": "Divine eye.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhãn - Thiên Nhãn Thông - Thiên Nhãn Minh", "definition": "“Thiên nhãn” là con mắt của chư thiên, có thể thấy biết tất cả mọi hình sắc lớn, nhỏ, xa, gần, không bị chướng ngại. Có hai loại thiên nhãn: loại do quả báo mà có được và loại do tu tập mà có được. Thiên nhãn của chư thiên thì do quả báo mà có. Các bậc thánh từ A-la-hán trở lên là do tu tập mà có được thiên nhãn, nhưng so với con mắt chư thiên thì các ngài còn sáng tỏ hơn nhiều, cho nên đặc biệt gọi là “thiên nhãn thông”; thiên nhãn của Phật còn vượt trội hơn nữa, có thể thấy suốt tướng trạng sinh tử của chúng sinh ở đời vị lai, nên được gọi là “thiên nhãn minh”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Nhãn Minh", "definition": "Cyuty-upapada-jñānasak-satkriya-vidyā (S), Cutupapatañāṇa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhãn Thông", "definition": "Dibbacakkhu (P), Divyacakṣu (S), Devine hearing, Divya-cakṣus-jñāna-saksatkriya-bhijñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhĩ Thông", "definition": "Dibbasota (P), Dibbasotam (P), Divine ears, Divyaśrotra (S), Divya-śrotra-jñāna-saksatkriyabhijñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhĩ Trí", "definition": "Divya-śrotra-bhijñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhơn Sư", "definition": "Một trong 10 danh hiệu của đức Phật, nghĩa là Bậc thầy của cõi trời và người.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhơn Viên", "definition": "Ṛṣipatana (S), Isipatana (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Như", "definition": "(1286-1354): tức Duy Tắc, một vị thiền sư thuộc thiền phái Lâm Tế đời Nguyên, Trung-quốc, đệ tử đắc pháp của thiền sư Trung Phong Minh Bản (1263-1323). Ngài họ Đàm, tự Thiên Như, quê huyện Vĩnh-tân, tỉnh Giang-tây. Lúc nhỏ, ngài xuống tóc ở núi Hòa, sau đến núi Thiên-mục, theo học với thiền sư Nguyên Bản, đắc pháp và trở thành người thừa kế của thiền sư. Năm đầu niên hiệu Chí-chánh (1341) đời vua Nguyên Thuận-đế (1333-1368), ngài trú tại rừng Sư-tử ở Tô-châu. Tại đây, năm sau, chư đồ chúng góp sức, xây cất chùa Bồ-đề-chánh-tông, thỉnh ngài trú trì hoằng hóa, trở thành ngôi đạo tràng lớn của thiền phái Lâm Tế. Ngài được vua cúng dường pháp y và ban tặng hiệu Phật Tâm Phổ Tế Văn Tuệ Đại Biện thiền sư. Dù vậy, vua nhiều lần thỉnh ngài vào cung, ngài đều cáo bệnh không đi. Cùng lúc hoằng dương tông phong của thiền phái Lâm Tế, ngài cũng nghiên cứu kĩ càng giáo chỉ của chư tổ tông Thiên Thai; lại xiển dương giáo pháp Tịnh Độ. Ngài viên tịch năm 69 tuổi. Trước tác của Ngài có: Thiền Tông Ngữ Lục, Thập Phương Giới Đồ Thuyết, Lăng Nghiêm Kinh Hội Giải (phụ chú), Lăng Nghiêm Kinh Viên Thông Sớ, Tịnh Độ Hoặc Vấn (phá trừ những nghi hoặc về giáo pháp Tịnh Độ).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Như Duy Tắc", "definition": "Tien ju Wei tse (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nhị Bách Ngũ Thập Nhân", "definition": "千二百五十人 (Nhân Quả Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiên Ninh Tự", "definition": "Tien ning (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Ninh Tự Tháp", "definition": "天 寧 寺 塔. Tháp nằm trong khuôn viên Thiên Ninh Thiền Tự, ngoài Quảng An Môn, khu Tuyên Vũ, thủ đô Bắc Kinh Trung Quốc. Theo sách Hữu Quan Văn Hiến, tháp được xây sớm nhất vào đời Tùy, nhưng xem cách tạo hình, kết cấu thì phải là tháp đời Liêu được xây vào đầu thế kỷ thứ 12. Tháp được xây trên một cái đài hình vuông, cao 57,8 mét. Mặt bằng là hình bát giác, đáy là tòa Tu Di, trên khắc ba tầng cánh sen to lớn nâng đỡ thân tháp tầng thứ nhất. Góc quàng thân tháp làm trụ, trên trụ có giao long quấn tròn. Bốn mặt chính là cửa, hai bên cửa có tượng Thiên vương, hình tượng sinh động truyền thần. Toàn bộ tháp tạo dáng vững vàng trang trọng, hùng vĩ tráng lệ. Tòa Tu Di, thân tháp tầng thứ nhất, 13 tầng mái kín, ngọc báu to lớn kết trên đảnh, tạo thành toàn thể nghệ thuật nặng nhẹ, dài ngắn, kín hở, xen kẻ nhau, liền lạc nhau.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Nữ", "definition": "Devī (S), Goddess.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Nữ Biện Tài", "definition": "Sarasvati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Phong Tự", "definition": "千 峰 寺. X. Phong Huyệt Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Phú", "definition": "天賦. Trời cho, không do mình làm ra hay tập luyện mà có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Phúc Tự", "definition": "天 福 寺. Còn gọi: Chùa Thầy, Chùa Cả. Chùa ở phía nam núi Sài Sơn, huyện Thạch Thất, tỉnh Sơn Tây (Hà Sơn Bình), Việt Nam, cách hiên thấp đứng trên một nền bệ đất cao. Bên trong là một bộ sườn nhà cao lớn với những cột to kèo lớn đội một mái nhà một gian hai chái nhưng to rộng khác thường. Cột kèo chạm trổ đơn giản nhưng những vách gỗ bọc chung quanh được cấu tạo theo kiểu nong đố dầy chắc. Trong chùa có thờ tượng của Thiền Sư Từ Đạo Hạnh. 千 福 寺. ở phường An Định, Trường An xưa, thành phố Tây An, tỉnh Thiểm Tây, Trung Quốc. Niên hiệu Hàm Hanh thứ 4 (673) đời Đường, Thái tử Chương Hoài bỏ nhà làm chùa. Học trò của Thiện Đạo là Hoài Cảm trụ trì, kẻ đồng đạo bốn phương đến xin ở ngày càng đông. Cuối những năm Khai Nguyên (713-741) Sở Kim thiền tọa 6 năm tại chùa này. Niên hiệu Thiên Bảo thứ 3 (744) xây cất tháp, tập họp các vị Đại đức ở dưới tháp tu “Pháp Hoa tam muội”. Niên hiệu Thượng Nguyên thứ 2 (761) vua Túc Tông vời Huệ Trung đến cung đình làm lễ thầy trò, sai trụ Tây Thiền Viện của chùa này. Thời kỳ Võ Tông hủy Phật, chùa này cũng bị phá hoại. Niên hiệu Đại Trung thứ 6 (852) phục hưng, đổi tên là “Hưng Nguyên Tự”, về sau dần dần suy vi, hiện chùa không còn nữa.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Phật", "definition": "Buddha-sahasra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Phật Tháp", "definition": "千 佛 塔. X. Hoa Tháp.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Phật Tự", "definition": "千 佛 寺. X. Hưng Quốc Thiền Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Quan", "definition": "(天官): tên gọi của một trong ba vị Tam Quan Đại Đế (三官大帝), tức Thiên Quan Đại Đế (天官大帝), còn gọi là Thượng Nguyên Tứ Phước Thiên Quan Nhất Phẩm Tử Vi Đại Đế (上元賜福天官一品紫微大帝), và hai vị kia là Trung Nguyên Xá Tội Địa Quan Nhị Phẩm Thanh Hư Đại Đế (中元赦罪地官二品清虛大帝), Hạ Nguyên Giải Ách Thủy Quan Tam Phẩm Động Âm Đại Đế (下元解厄水官三品洞陰大帝). Từ thời Thượng Cổ, tại Trung Quốc đã có nghi lễ tế trời, đất và nước rồi. Ba vị Đại Đế này được thần cách hóa chỉ dưới Ngọc Hoàng Thượng Đế (玉皇上帝) một bậc, chuyên chưởng quản việc phước lộc, tội ác và giải trừ tai ách của con người. Trong dân gian vẫn truyền tụng rằng: “Thiên Quan hảo lạc, Địa Quan hảo nhân, Thủy Quan hảo đăng (天官好樂、地官好人、水官好燈, Thiên Quan thích vui, Địa Quan thích người, Thủy Quan thích đèn).” Thượng Nguyên (上元, rằm tháng giêng), Trung Nguyên (中元, rằm tháng bảy) và Hạ Nguyên (下元, rằm tháng mười) là ba ngày tế hội của ba vị Đại Đế này. Thiên Quan Đại Đế lệ thuộc vào Ngọc Thanh Cảnh (玉清境), do 3 khí xanh, vàng, trắng mà kết hợp thành, tổng chủ quản các đế vương trên trời. Mỗi năm vào ngày rằm tháng giêng, vị này thường giáng phàm xem xét tội phước của con người, nên có tên là Thiên Quan Tứ Phước (天官賜福, Quan Trời Ban Phước). Có nhiều truyền thuyết khác nhau liên quan đến vị này. Có thuyết cho rằng ông là Nghiêu Đế (堯帝); do vì nhà vua có lòng nhân lớn nên được phong làm Thiên Quan, phụng mạng Ngọc Hoàng Thượng Đế, xem xét việc tốt xấu của con người. Nghiêu Đế họ là Y Kì (伊祁), tên Phóng Huân (放勳), con vua Khốc (嚳), em của vua Chí (摰). Khi Chí lên ngôi vua thì phong cho Nghiêu là (陶侯), rồi đổi tên là Đường (唐); nên được gọi là Đào Đường (陶唐). Tương truyền Đường Nghiêu (唐堯) có dung mạo rất quái dị, lông mày có 8 sắc màu, tai có 3 lỗ thông. Khi vua Chí nhường ngôi cho Nghiêu thì bốn phương xuất hiện hung thần, ác khí, làm nguy hại đến tánh mạng của bá tánh. Nhà vua bèn sai Hậu Nghệ (后羿) đến hàng phục hung thần kia. Ông tóm thâu gió lớn nơi sông hồ, chém chết mãnh thú ven hồ Động Đình (洞庭), thâu tóm độc xà và làm cho dân chúng được yên ổn. Vua Nghiêu lại vẽ ra bốn mùa Xuân, Hạ, Thu, Đông, chế định một năm có 12 tháng. Sau khi tại vị được 98 năm, vua Nghiêu truyền ngôi vị lại cho Thuấn (舜), hưởng thọ 177 tuổi; được tôn xưng là Thiên Quan Tứ Phước Thần (天官大帝賜福神). Trong Đạo Giáo tôn sùng ông là Thượng Nguyên Nhất Phẩm Tứ Phước Thiên Quan Đại Đế (上元一品賜福天官大帝). Thuyết khác cho rằng Thiên Quan là vị quan thường tâu những lời can gián lên nhà vua tên Đường Hoằng (唐宏) dưới thời Chu U Vương (周幽王, tại vị 781-771 tcn). Ông cùng với Cát Ung (葛雍), Chu Thật (周實) từ quan và sống cuộc đời vui thú điền viên. Đến thời Tống Chơn Tông (宋眞宗, tại vị 997-1022), cả ba được phong làm Thiên Quan, Địa Quan, Thủy Quan và được tế tự hàng năm. Cũng có truyền thuyết giải thích rằng từ khi Trương Thiên Sư (張天師, 34-156, tức Trương Đạo Lục [張道陵], tự là Phụ Hán [輔漢], cháu đời thứ 8 của Trương Lương [張良], xuất thân Phong Huyện [豐縣], Tỉnh Giang Tô [江蘇省]) khai sáng Đạo Giáo về sau, dân gian mới bắt đầu biết cúng tế ba vị Thiên Quan, Địa Quan và Thủy Quan. Ngoài ra, có thuyết lại cho rằng Ngôn Vương Gia (言王爺) có 3 người con gái, đem gả cho Trần Tử Thung (陳子摏) làm vợ; mỗi người lại hạ sinh một người con, có bẩm tính khác thường. Nguyên Thỉ Thiên Tôn (元始天尊) phong cho 3 người này làm Thiên Quan, Địa Quan, Thủy Quan và ra lệnh cho họ cai quản ba cõi. Trong Thái Thượng Tam Nguyên Tứ Phước Xá Tội Giải Ách Tiêu Tai Diên Sanh Bảo Mạng Diệu Kinh (太上三元賜福赦罪解厄消災延生保命妙經), phần Thiên Quan Bảo Cáo (天官寶誥) của Đạo Giáo có đoạn: “Chí tâm quy mạng lễ: Huyền Đô Nguyên Dương, Tử Vi Cung trung, bộ Tam Thập Lục Tào, giai cửu thiên vạn chúng, khảo hiệu đại thiên thế giới chi nội, lục tịch thập phương quốc độ chi trung; phước bị vạn linh, chủ kiêm sanh thiện ác chi tịch; ân đàm Tam Giới, trí chư tiên thăng giáng chi ty, trừ vô vọng chi tai, giải thích túc ương, thoát sanh tử chi thú, cứu bạt u khổ, quần sanh thị lại, xuẩn động hàm khang, đại bi đại nguyện, đại thánh đại từ, Thượng Nguyên Cửu Khí, Tứ Phước Thiên Quan, Diệu Linh Nguyên Dương Đại Đế, Tử Vi Đế Quân (志心皈命禮、玄都元陽、紫微宮中、部三十六曹、偕九千萬眾、考較大千世界之內、錄籍十方國土之中、福被萬靈、主兼生善惡之籍、恩覃三界、致諸仙升降之司、除無妄之災、解釋宿殃、脫生死之趣、救拔幽苦、群生是賴、蠢動咸康、大悲大願、太聖大慈、上元九氣、賜福天官、曜靈元陽大帝、紫微帝君, Một lòng quy mạng lễ: Huyền Đô Nguyên Dương, trong Tử Vi Cung, cai quản 36 bộ quan, nhiếp chín ngàn vạn chúng, giám sát trong khắp thế giới đại thiên, xét hồ sơ mười phương quốc độ, chủ quản hồ sơ thiện ác con người, phước nhuần vạn sinh, chủ kiểm soát hồ sơ thiện ác; ơn ban Ba Cõi, quản lý chư tiên lên xuống, trừ các tai họa, giải trừ oan khiên đời trước, thoát khỏi đường sanh tử, cứu bạt khổ ách, chúng sanh nương tựa, động vật đều yên, đại bi đại nguyện, đại thánh đại từ, Thượng Nguyên Cửu Khí, Tứ Phước Thiên Quan, Diệu Linh Nguyên Dương Đại Đế, Tử Vi Đế Quân).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Quan Quán Tự Tại", "definition": "Xem Thiên Thủ Thiên Nhãn Quán Tự Tại.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Quan Tự", "definition": "Makutabandhanacetiya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Quang Thiền Tự", "definition": "千 光 禪 寺. ở làng Thủy Thượng, huyện Gia Nghĩa, tỉnh Đài Loan, Trung Quốc. Khoảng niên hiệu Đạo Quang (1821-1850) đời Thanh sáng lập, ban đầu gọi “Thiện Đức Phật Đường”. Niên hiệu Đồng Trị thứ 3 (1864), Quang Tự thứ 7 (1881) từng hai lần thi công. NaÊm 1932 tín đồ cũng tập họp tiền bạc xây cất lại. Về sau gặp phải trình độ bất đồng mà hủy hoại. Tín đồ vì hoằng dương Phật pháp mà quyết định dời chỗ xây dựng. Năm 1966 đặt mua khu đất hiện nay, năm sau khởi công xây dựng. Năm", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Quế Truyền Tôn", "definition": "(天 桂 傳 尊, Tenkei Denson, 1648-1735): vị tăng của Tào Động Tông Nhật Bản, tự là Thiên Quế (天 桂), thường gọi là Đồng Nhãn Lâu (瞳 眼 樓), Diệt Tông (滅 宗), Lão Loa Cáp (老 螺 蛤), Lão Mễ Trùng (老 米 虫), họ là Đại Nguyên (大 原), xuất thân vùng Kỷ Y (紀 伊, Kii, thuộc Wakayama-ken ngày nay). Năm lên 8 tuổi, ông theo xuất gia với Truyền Cung (傳弓) ở Song Dự Tự (窻譽寺) vùng Kỷ Y; đến năm 18 tuổi thì lên đường hành cước tu tập, đã từng đến tham vấn chư vị tôn túc như Tổ Hải (祖海) ở Vạn Tùng Tự (萬松寺), Xung Thiên (衝天) ở Khả Thùy Trai (可睡濟), Long Bàn (龍蟠) ở Hưng Thánh Tự (興聖寺). Đến năm thứ 5 (1677) niên hiệu Diên Bảo (延寳), ông đến tham yết Ngũ Phong Hải Âm (五峰海 音) ở Tĩnh Cư Tự (静居寺) và kế thừa dòng pháp của vị nầy. Sau ông sống ở chùa nầy, rồi đến năm thứ 2 (1689) niên hiệu Nguyên Lộc (元祿), ông được Phùng Tu Hạ Hầu (蜂 修賀 候) quy y theo, và chuyển đến sống tại Đại Vân Tự (大 雲寺) ở vùng Cận Giang (近江, Ōmi, thuộc Shiga-ken ngày nay). Thêm vào đó, ông còn di chuyển đến Tàng Lộ Am (藏鷺庵) ở vùng Lãng Hoa (浪華, thuộc Ōsaka ngày nay), Trượng Lục Tự (丈 六寺) vùng A Ba (阿波, Awa, thuộc Tokushima-ken ngày nay); và cuối cùng vào năm thứ 6 (1721) niên hiệu Hưởng Bảo (享 保), ông lui về sống tại Thối Tàng Phong (退藏峰, tức Dương Tùng Am) ở vùng Nhiếp Tân (攝津, Settsu, thuộc Ōsaka ngày nay). Vào ngày mồng 10 tháng 12 năm thứ 20 niên hiệu Hưởng Bảo, ông thị tịch, hưởng thọ 88 tuổi.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Sai", "definition": "千 差. Nhiều sự khác biệt, đủ mọi sự khác biệt. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Sơn", "definition": "千山. Nghìn núi. Chỉ sự cách trở xa xôi. Thường nói: Thiên sơn vạn thuỷ (nghìn núi vạn sông).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Sơn Vạn Thủy", "definition": "千 山 萬 水. Ngàn núi muôn sông, ý nói cách thiền pháp rất xa, căn bản chẳng hợp thiền pháp. Đây là lời thiền sư hay dùng. Phần Dương Ngữ Lục q. thượng:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Sứ", "definition": "Dūta (S), Deva messenger.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tai", "definition": "天災. Việc không may lớnlao xảy tới, do trời bày ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Thai Bát Giáo", "definition": "Tông Thiên Thai lập ra bốn hóa pháp và bốn hóa nghi, cộng [tr.676] thành tám giáo. Bốn hóa pháp (bốn giáo pháp của Phật dạy để đem lợi ích cho chúng sinh):", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiên Thai Ngũ Hối", "definition": "Đại sư Trí Khải dựa vào kinh sách Phật lập ra năm phép sám hối được thực hành sáu lần trong một ngày đêm, gọi là lục thời sám hối (sáu thời sám hối).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiên Thai Ngũ Thời", "definition": "天台五時 (Thiên Thai Tứ Giáo Nghi. )", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiên Thai Sơn", "definition": "Núi Thiên-thai : là tên một dãy núi ở tỉnh Triết-giang, Trung-quốc. Núi này cũng có tên là Thiên-thê, hay Thai-nhạc, nằm ở huyện Thiên-thai, cao 1.136 mét, gồm 8 ngọn lớn và nhiều ngọn nhỏ, với nhiều hang động, khe, suối, đầm, hồ, ao, từng nổi danh từ thời cổ, được rất nhiều đạo sĩ, ẩn sĩ chọn làm nơi ẩn cư. Tương truyền, Phật giáo đã bắt đầu khai thác núi này vào khoảng niên hiệu Xích-ô (238-251) thời Đông-Ngô, mà chùa Thanh-hóa là ngôi pháp vũ đầu tiên được xây cất trên núi này. Rồi những ngôi chùa khác trên núi cũng dần dần được kiến tạo vào những thế kỉ kế tiếp. Đến năm 575 (đời Trần, thời Nam-triều), đại sư Trí Khải (538-597) đã lên núi này, kiến lập chùa Tu-thiền (sau đổi tên là chùa Thiền-lâm) ở ngọn Phật-lũng để làm nơi tu thiền. Và chính tại nơi đây, ngài đã sáng lập tông Thiên Thai. Vào lúc cuối đời, ngài Trí Khải muốn dựng một ngôi chùa ở triền Nam của ngọn Phật-lũng, nhưng việc chưa thành thì ngài đã viên tịch (năm 597, đời vua Tùy Văn Đế). Vì đại sư Trí Khải chính là vị thầy truyền giới Bồ-tát cho thái tử Dương Quảng, cho nên, để cảm niệm ân đức của ngài, thái tử (lúc đó được phong là Tấn vương, nên sử gọi là Tấn vương Quảng) đã vì ngài mà thiết trai cúng dường 1.000 vị tăng, rồi hưng công xây cất ngôi chùa theo ước nguyện của ngài, đặt tên là Thiên-thai-sơn tự. Đó là một ngôi chùa thật hùng vĩ, xây xong thì vị cao đồ của đại sư Trí Khải là ngài Quán Đảnh (561-632) được mời làm trú trì. Từ đó, chùa Thiên-thai-sơn đã trở thành đạo tràng căn bản của tông Thiên Thai; các vị tổ sư của tông này cũng kế tiếp nhau trú trì tại chùa này.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Thai Tam Quán", "definition": "天台三觀 (Kim Quang Minh Kinh Huyền Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiên Thai Tông", "definition": "Tông Thiên Thai : là một trong 13 tông phái của Phật giáo Trung-quốc (Câu Xá tông, Thành Thật Tông, Tam Luận Tông, Niết Bàn Tông, Luật Tông, Địa Luận tông, Tịnh Độ Tông, Thiền Tông, Nhiếp Luận Tông, Thiên Thai Tông, Hoa Nghiêm Tông, Pháp Tướng Tông, và Mật Tông). Vì tông phái này được thành lập và đặt đạo tràng trung ương tại núi Thiên-thai, nên có tên là Thiên Thai Tông, hay gọi tắt là Thai tông. Vả lại, tông này lấy Kinh Pháp Hoa làm thánh điển chủ yếu để lập tông, nên cũng được gọi là tông Pháp Hoa.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Thai Tự", "definition": "遷 台 寺. Còn gọi: Địa Tạng Thiền Lâm. ở phía bắc đình Bổng Nhật, ngọn Thiên Thai, núi Cửu Hoa, tỉnh An Huy, Trung Quốc. Vào đời Đường, Kim Địa Tạng kết tranh làm am ở nơi đây, có tăng Khiết Bình thường từ gò La hán đến đây gặp gỡ trò chuyện với Địa Tạng. Đời Tống cao tăng Tông Cảo có làm thơ vịnh chùa này: “Đạp biến Thiên Thai bất tác thinh, thanh chung nhất chử vạn sơn minh” (Giẫm khắp Thiên Thai chẳng tiếng tăm, chuông vang một tiếng động núi non). Đời Minh chùa này y nguyên vô cùng sơ sài, chỉ là vài gian nhà tranh với cỏ xanh. Khoảng niên hiệu Gia Tĩnh (1522-1566) đời Minh, tăng trong chùa là Trân Ngọc tuần tra núi, bảo vệ núi vài mươi năm như một ngày. Vào cuối đời Minh đầu đời Thanh Thiền Sư Mặc An giỏi cả thi thư họa trường kỳ ở chùa này. Khoảng niên hiệu Khang Hy (1662-1722) đời Thanh, tăng Trần Trần Tử kết am bên cạnh chùa, gọi “Hoạt Mai Am”. Thi nhân đời Thanh Viên Mai có bài thơ viết về Hoạt Mai Am trong quyển “Tùy Viên thi Thoại”: “Thùy bả am danh hiệu Hoạt Mai, linh nhân thiên cổ phí nghi xai. Ngã kim khởi thị khinh sinh giả, chỉ vị tùng tiền tử quá lai. “ (Ai đặt tên am là Hoạt Mai, khiến người thiên cổ phải nghi hoài. Nay tôi đâu phải người tự tử, chỉ bởi trước đây đã chết rồi). Về sau có Hòa Thượng Lãn Ngộ thường ở nơi này họa vẽ vật thực và cùng với trụ trì Pháp sư Nghĩa Phương đàm đạo suốt ngày. Chùa dựa vào thế núi mà cất, trước sau ba dãy điện vũ là Địa Tạng điện, Đại hùng bảo điện, Vạn Phật lâu, dãy sau còn có Thiền phòng, Nhà khách. Tượng Phật ở mỗi điện trang nghiêm, chuông to, trống lớn, pháp khí có đủ cả. Trên Vạn Phật lâu nhiều tượng khắc gỗ treo đầy trên xà nhà, bị khói hương xông mãi nên rất giống tượng Phật đúc bằng sắt. Trên núi sau điện có một hòn đá lớn, trên có in dấu chân lớn hình lõm, tương truyền đó là dấu chân của Kim Địa Tạng để lại.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Thai Đại Sư", "definition": "Danh hiệu của Đại sư Trí Khải đời nhà Đường, người lập ra tông Thiên Thai. Tông này lấy kinh Pháp Hoa làm bộ kinh căn bản, lấy Luận Trí Độ làm kim chỉ nam, lấy Kinh Niết Bàn làm kinh hỗ trợ, lấy Kinh Đại Phẩm (Bát Nhã) làm chỗ dựa để thành lập các phép quán.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiên Thai Đức Thiều", "definition": "T'ien-T'ai Te-shao (C), Tendai Tokushō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thanh", "definition": "天青. Màu xanh da trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Thu", "definition": "千秋. Nghìn năm Như Thiên cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Thánh Quảng Đăng Lục", "definition": "天 聖 廣 燈 錄. Đăng Lục, 30 quyển, do Lý Tuân Húc biên soạn vào đời Tống. Vào niên hiệu Thiên Thánh thứ 7 (1029), Tuân Húc dâng Quảng Đăng Lục lên vua Tống Nhân Tông. Vua ban cho 2 chữ Thiên Thánh làm tựa sách, được xuất bản vào niên hiệu Thiệu Hưng thứ 18 (1148), về sau đựơc xếp vào Tục Tạng Kinh tập 135, trang 595. Sách này thu thập lược truyện và cơ duyên của khoảng trên 370 vị từ Phật Thích Ca, 27 vị Tổ ấn Độ, 6 vị Tổ Trung Quốc đến 9 đời dưới Tổ Nam Nhạc, 12 đời dưới Tổ Thanh Nguyên. Đặc biệt kể tỉ mỉ về hệ phái Nam Nhạc, gom chép hầu như toàn bộ Ngữ Lục các thiền sư từ Mã Tổ Đạo Nhất trở về sau.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Thân", "definition": "S. Vasubandhu. Cũng dịch là Thế Thân. Vị Luận sư Ấn Độ, sinh quán ở Peshawar, 900 năm sau Phật Niết Bàn, tức năm 400 TL. Tác giả nhiều bộ Luận Phật giáo quan trọng, trong đó có bộ Luận Câu Xá và bộ Luận Duy Thức. Cùng với anh ruột là Vô Trước (Asanga) lập ra Du Già tông. Ông được xem là vị Tổ thứ 21 của Phật giáo Ấn Độ. Thiên Thần Tên gọi chung Thần Đế Thích (Indra), và các vị Thần theo hầu thần Đế Thích, hay là các vị thần do Đế Thích cai quản.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiên Thân Bồ Tát", "definition": "Xem Thế Thân Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thùy Bảo Cái Địa Dõng Kim Liên", "definition": "(天垂寳蓋、地湧金蓮): trên trời rũ lọng báu xuống, dưới đất vọt lên hoa sen vàng ròng. Trong Độ Kiều Khoa Ngân Kiều Nghi (度橋科銀橋儀) của Đạo Giáo có đoạn: “Thiên thùy bảo cái trùng trùng hiện, địa dõng kim liên đóa đóa tiên, sám hối do như liên thủy xuất, siêu thăng hảo tợ nguyệt đương viên (天垂寳蓋重重現、地湧金蓮朵朵鮮、懺悔猶如蓮出水，超升好似月當圓, Trời buông lọng báu lớp lớp hiện, đất vọt sen vàng đóa đóa nguyên, sám hối giống như sen khỏi nước, siêu thăng nào khác nguyệt đang viên).” Hay trong Phật Nhật Phổ Chiếu Huệ Biện Sở Thạch Thiền Sư Ngữ Lục (佛日普照慧辯楚石禪師語錄, Taishō No. 1420) quyển 1 cũng có câu: “Thiên thùy bảo cái, địa dõng kim liên, nhất cú vô tư, như hà chúc tán (天垂寶蓋、地湧金蓮、一句無私、如何祝贊, trời buông lọng báu, đất vọt sen vàng, một câu vô tư, làm sao chúc tán ?).” Trong văn cúng thỉnh Phật an vị cũng có đoạn rằng: “Nam mô nhất tâm phụng thỉnh: thiên hoa đài thượng, bách bảo quang trung, Tam Thập Nhị Tướng chi Năng Nhân, Bát Thập Chủng Hảo chi Đại Giác, quá hiện vị lai vô lượng Phật Đà Gia. Duy nguyện: thiên thùy bảo cái, địa dõng kim liên, quang giáng đạo tràng, chứng minh công đức (南無一心奉請、千花臺上、百寳光中、三十二相之能仁、八十種好之大覺、過現未來無量佛陀耶。惟願、天垂寶蓋、地湧金蓮、光降道塲、證明功德, Kính thành một lòng phụng thỉnh: trên đài ngàn hoa, trăm báu ánh sáng, Ba Hai Tướng Tốt đấng Năng Nhân, Tám Mươi Vẻ Đẹp bậc Đại Giác, quá khứ, hiện tại, tương lai vô lượng các đức Phật. Cúi mong: trời ban lọng báu, đất nỗi sen vàng, giáng xuống đạo tràng, chứng minh công đức).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Thú", "definition": "Xem Thiên Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thượng Thiên Hạ, Duy Ngã Độc Tôn", "definition": "天 上 天 下 唯 我 獨 尊. Trên trời dưới trời, chỉ có Ngã là tôn quý. Truyền thuyết khi Phật ra đời đã nói ngay câu này. Tiết Thích Ca Mâu Ni phật trong NĐHN q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Thượng Tứ Tháp", "definition": "天上四塔 (Phật Thành Đạo Ký và Bổn Hạnh Tập Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiên Thất Bách Tắc Trần Lạn Cát Đằng", "definition": "千 七 百 則 陳 爛 葛 藤. Một ngàn bảy trăm (1. 700) công án là lời cũ mèm vô dụng. 1. 700 tắc: chỉ cho tất cả công án trong Cảnh Đức Truyền Đăng Lục đời Bắc Tống. Cát đằng: dây leo, dụ chỉ lời nói trong công án. Hàm ý chê bai. Tiết Trung Phong Hòa Thượng Hành Lục trong TPQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Thần", "definition": "天神. Vị thần trên trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Thọ", "definition": "Xem Đề Bà Đạt Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thọ Thánh Ân Tự", "definition": "天 壽 聖 恩 寺. Nằm ở sườn nam núi Đặng Úy, thị trấn Quang Phúc, huyện Ngô, tỉnh Giang Tô, Trung Quốc. Thiên Thọ và Thánh Ân vốn là hai chùa. Thiên Thọ Thiền Tự sáng lập vào khoảng niên hiệu Thiên Bảo (742-755) đời Đường, Thanh Ân Thiền Viện sáng lập vào khoảng niên hiệu Bảo Hựu (1253-1258) đời Tống. Thiên Thọ Thiền Tự bị hủy vào đời Nguyên. Niên hiệu Hồng Vũ thứ 9 (1376) đời Minh đem hai chùa hiệp làm một, phát triển mạnh công trình thổ mộc, xây đại điện, đúc chuông, cất lầu chuông. Niên hiệu Vĩnh Lạc thứ 7 (1409) trùng tu đại điện, xây Tàng kinh các, Thiên vương điện. Niên hiệu Chính Thống thứ 8 (1443) ban cho tấm biển “Thiên Thọ Thánh Ân Tự”. Niên hiệu Chính Thống thứ 10 (1445) lại xây Phạm thiên các. Hoàng đế Càn Long sáu lần Nam tuần, đều đến chùa này ban tấm biển, tặng thơ, đề chữ, từ đây danh tiếng chùa càng lẫy lừng. Hiện chỉ còn Đại hùng bảo điện, Thiên vương điện, Tăng xá. Ngoài ra còn có nửa ngôi miếu thờ đời Minh và phần điêu khắc đá rất tinh xảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Thọ Tự Đại Thánh Bảo Tháp", "definition": "天 壽 寺 大 聖 寶 塔. Nằm trong khuôn viên chùa Thiên Thọ, huyện Quảng Đức, tỉnh An Huy, Trung Quốc. Chùa Thiên Thọ nguyên gọi là “Thông Thiên Tự”, do Thiền Sư Pháp Uyển sáng lập vào khoảng niên hiệu Thiên Hựu (904-907) đời Đường. Niên hiệu Kiến Trung Tĩnh Quốc thứ 1 (1101) đời Tống đổi tên là “Khai Hóa Tự”. Niên hiệu Vạn Lịch thứ 30 (1602) đời Minh mới đổi tên là “Thiên Thọ Tự”, bị phá hủy vào năm 1938, chỉ còn tháp này. Đại Thánh Bảo Tháp được xây vào niên hiệu Thái Bình Hưng Quốc thứ 4 (979) đời Tống, khi đó chỉ có 5 tầng. Niên hiệu Nguyên Phù thứ 2 (1099) bị lửa thiêu hủy. Niên hiệu Sùng Ninh thứ 4 (1105) trùng tu thành 7 tầng. Niên hiệu Vạn Lịch thứ 30 (1602) đời Minh, Khang Hy thứ 7 (1668) lần lượt trùng tu. Tháp thể hiện còn là kết cấu hỗn hợp gạch gỗ theo kiểu lâu các, hình lục giác, 7 tầng, 6 cửa, cao khoảng 42m. Đỉnh tháp là kiểu nồi sắt úp, mái cong phô bày ngói ống màu xanh lam, có treo phong linh, tạo dáng đặc biệt hoa lệ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Thời", "definition": "天時. Tiết trời. Khí hậu Dịp tốt trời cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Thủ Thiên Nhãn Quán Thế Âm", "definition": "Sahasrabhūjāry-Āvalokiteśvara (S), Sahasra-bhūjāsahasraneta (S), Sahasrabhūjāsahas-raneta (S), One-thousand Arms and Eyes World Listerner.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thủ Thiên Nhãn Quán Thế Âm Bồ Tát Quảng Đại Viên Mãn Vô Ngại Đại Bi Tâm Đà La Ni Kinh", "definition": "Ch'ien-shou ch 'ien-yen kuan-shih-yin p'u-sa kuang-ta t 'u-man wu-ai ta-fei-hsin t'o-lo-ni ching (C), Mahā-karuṇā-dhāraṇī (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thủ Thiên Nhãn Quán Tự Tại Bồ Tát", "definition": "Avalokiteśvara-sahasrabhuja-locana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thủ Thánh Quán Tự Tại", "definition": "Xem Thiên Thủ Thiên Nhãn Quán Âm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Thừa", "definition": "Devayāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tiên", "definition": "Deva-ṛṣi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tiểu Ngũ Suy Tướng", "definition": "天小五衰相 (Pháp Uyển Châu Lâm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiên Trung Thiên", "definition": "Devātideva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Trí", "definition": "Devaprajñā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Trù", "definition": "天廚. Bếp trời. Tên một ngôi chùa ở động Hương tích. Hát nói của Dương Khuê: “Thiên trù vong cơ càng thấy khoẻ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Trúc", "definition": "Vào thời cổ, nước Ấn-độ được người Trung-quốc gọi là Thiên-trúc. Về danh xưng của nước này, theo sách sử Trung-quốc, trước tiên nó được ghi trong sách Sử Kí của Tư Mã Thiên (145-86 tr.TL) với tên là Thân-độc; sau đó, trong sách Hậu Hán Thư của Phạm Việp (389-445), nó được gọi là Thiên-trúc; từ đời Đường (618-907) về sau, nó thường được gọi là Ấn-độ. Trong Phật điển, tên Thiên-trúc được dùng rất nhiều. Ngoài ra, một số danh xưng khác của nước Ấn-độ cũng thấy được dùng rải rác trong các kinh sách thời xưa: Thiên-đốc, Thiên-độc, Càn-đốc, Hiền-đậu, Ấn-đệ-á, v.v... Vào thời trung cổ, nước Ấn-độ chia làm năm khu vực: Đông, Tây, Nam, Bắc và Trung-ương, gọi là “Ngũ Thiên-trúc” (gọi tắt là “Ngũ-Trúc”), hay “Ngũ Ấn-độ” (gọi tắt là “Ngũ-Ấn”). Do vậy mà có các địa danh như Nam Thiên-trúc, Tây Thiên-trúc v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Trước", "definition": "Xem Ấn Độ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Trụ Sùng Huệ", "definition": "Tien chu Chung hui (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Trụ Vương", "definition": "(Cây), Heavenly king of trees", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thiên Tuế", "definition": "千歲. Nghìn tuổi. Tiếng để chúc tụng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tài", "definition": "天才. Sự giỏi giang trời cho. Đoạn trường tân thanh: “Người quốc sắc kẻ thiên tài”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tình Bất Khẳng Khứ", "definition": "天 晴 不 肯 去. Trời tạnh chẳng chịu đi. Nói đủ gồm có 2 câu:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Tí Quán Thế Âm", "definition": "Sahasrabhujasa-harenetra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tính", "definition": "天性. Cái tính tự nhiên trời cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tôn", "definition": "(天尊): có hai nghĩa chính:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Tùng Bút Ký", "definition": "千 松 筆 記. Bút ký, 1 quyển, do Đại Thiều viết vào đời Minh, được ấn hành vào cuối đời Minh và được xếp vào Tục Tạng Kinh tập 114, trang 773. Sách này thu thập 4 thiên do Đại Thiều viết lúc ở Thiền viện Thiên Tùng, Biện Sơn. Đó là: “Thiên Tùng Bút Ký”, Thiền Tông Hợp Luận”, “Lăng Nghiêm Kích Tiết”, “Tạp trước” và lấy thiên đầu “Thiên Tùng Bút Ký” để làm tên sách. Nội dung nêu lên việc tham thiền ngộ đạo có thể ở trong pháp thế gian kiểm chứng được pháp xuất thế gian và ngược lại. Một loại bản gốc còn được xếp vào 1 thiên “Kim Cang Chính Nhãn”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Tư", "definition": "天資. Tính chất tốt đẹp trời cho.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tư Phúc Tự", "definition": "天 資 福 寺. Còn gọi: Chùa Côn Sơn, chùa Hun. Chùa nằm trong núi Côn, thuộc huyện Chí Linh, tỉnh Hải Hưng, miền Bắc Việt Nam, là một trong ba trung tâm Phật giáo lớn nhất vào đời Trần. Chùa nguyên được lập ra từ triều Lý nhưng mãi đến đời Trần, được Tam Tổ Trúc Lâm là Huyền Quang sửa sang thành một ngôi đại tùng lâm. Tam Tổ trụ trì và viên tịch tại đây, Xá Lợi được bảo tàng trong ngọn tháp ở phía sau chùa trên lưng chừng núi Côn Sơn. Tháp xây bằng đá xanh, xung quanh có tường hoa, mặt tường có những viên gạch cổ chạm triệu gấm, rất lớn và nặng. Tương truyền xưa kia, chùa này tòa ngang dãy dọc có đến 83 gian. Sau bao năm tháng đổi thay, bao cuộc chiến tranh tàn phá, chùa chỉ còn lại mấy gian thờ Phật và gian nhà Tổ. Đến đầu triều Nguyễn, vị thiền sư Trụ trì trùng tu lại chùa: Tòa thượng điện khá to, ngói lợp to bằng cái khay hình chữ nhật kiểu mũi hài và rất dầy, đến nay vẫn còn Nhà Tổ thờ Trúc Lâm Tam Tổ, hai bên thờ tượng các vương hầu đời hậu Lê. Tất cả tượng đều được tạc rất khéo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Tượng", "definition": "天象. Các hình trạng sự việc xảy ra trong bầu trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tạo", "definition": "天造. Tự nhiên, do trời làm ra sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tải", "definition": "千載. Nghìn năm. Chỉ một thời gian lâu dài. Đoạn trường tân thanh: “Nàng rằng thiên tải nhất thì”. (nghìn năm một thuở).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tải Tập", "definition": "(千載集, Senzaishū): hay còn gọi là Thiên Tải Hòa Ca Tập (千載和歌集), một trong những bộ Sắc Soạn Hòa Ca Tập (勅撰和歌集), bộ thứ 7 trong Bát Đại Tập (八代集), gồm 20 quyển. Năm 1183, vâng sắc chỉ của Hậu Bạch Hà Pháp Hoàng (後白河法皇), Đằng Nguyên Tuấn Thành (藤原俊成, Fujiwara-no-Toshinari) soạn nên tập này. Đây là ca tập thể hiện cảnh giới u tịch trong sắc thái ôn nhã, diêm tuyệt.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Tịch", "definition": "Xem Hiền Tịch.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tức Tai", "definition": "(?-1000). Ngài là người nước Ca-thấp-di-la ở phía Bắc Ấn-độ, nguyên cư trú tại chùa Mật-lâm, nước Xà-lan-đạt-la (Jalandhara), cũng phía Bắc Ấn-độ. Năm 980, ngài đã cùng với ngài Thi Hộ sang đến Biện-kinh, được vua Tống Thái-tông triệu kiến và tiếp đãi trọng vọng. Nhà vua liền cho xây viện Dịch-kinh ở mé Tây chùa Thái-bình-hưng-quốc, rồi ban sắc mời ngài cùng với hai ngài Pháp Thiên và Thi Hộ vào đây cư trú để chuyên việc dịch kinh. Ngài được vua ban hiệu là Minh Giáo đại sư. Trước sau ngài đã dịch được 22 bộ kinh, gồm 75 quyển. Ngài viên tịch năm 1000 (dưới triều vua Tống Chân-tông), thụy hiệu là Tuệ Biện. Có thuyết nói rằng, vào năm 987, ngài đã vâng chiếu vua (Thái-tông), đổi tên lại là Pháp Hiền.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Từ", "definition": "Deva-kula (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tử", "definition": "天子. Con trời. Chỉ ông vua thay trời trị dân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Tử Cù Bà Già", "definition": "Gopaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tử Ma", "definition": "Xem Thiên Ma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Tửu", "definition": "Xem Cam Lộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Võ Thiên Hoàng", "definition": "(天武天皇, Temmu Tennō, tại vị 672-686): vị Thiên Hoàng sống vào hậu bán thế kỷ thứ 7, tên là Thiên Đình Trung Nguyên Doanh Chân Nhân (天渟中原瀛眞人), hay còn gọi là Đại Hải Nhân (大海人), vị Hoàng Tử thứ 3 của Thư Minh Thiên Hoàng (舒明天皇, Jomei Tennō, tại vị 629-641). Năm 671, ông xuất gia, rồi ẩn cư tại vùng Cát Dã (吉野). Sau khi Thiên Trí Thiên Hoàng (天智天皇, Tenji Tennō, tại vị 661-671) băng hà, ông giành được thắng lợi dẹp yên vụ loạn năm Nhâm Thân (672), đến năm sau thì lên ngôi ở Tịnh Ngự Nguyên Cung (淨御原宮). Chính nhà vua đã cải định lại giai phẩm trong triều, chế ra luật lịnh mới, và biên sửa lại Quốc Sử.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Văn", "definition": "天文. Vẻ đẹp của bầu trời Chỉ chung các hiện tượng trên trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Văn Học", "definition": "Jotisattha (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiên Vương", "definition": "Tennō (J), Devaloka-rāja (S), Deva King, King of the devas.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Vương Bồ Tát", "definition": "Devarāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Vương Phật", "definition": "Xem Thiên Vương Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Vị", "definition": "偏爲. Vì lòng riêng mà có ý nghĩ và hành động lệch lạc, không công bằng. Đoạn trường tân thanh: “Có đâu thiên vị người nào”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Xứ Hà", "definition": "Mandākinī (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Y", "definition": "(989-1060): tức Nghĩa Hoài, một vị cao tăng đời Tống, Trung-quốc. Ngài họ Trần, quê huyện Vĩnh-gia, tỉnh Triết-giang. Tuổi niên thiếu, ngài vào chùa Cảnh-đức ở kinh thành xin làm chú tiểu để chuẩn bị xuất gia. Khoảng niên hiệu Thiên-thánh (1023-1032) đời vua Tống Nhân-tông (1023-1063), sau khi đỗ các kì khảo hạch kinh điển, ngài được thế độ. Sau đó ngài chu du các nơi cầu học, cuối cùng, ngài đến chùa Thúy-phong ở Cô-tô, y chỉ thiền sư Minh Giác (tức Tuyết Đậu Trọng Hiển, thiền phái Vân Môn), ngày ngày kiếm củi gánh nước, nhưng tâm chí chuyên cần tu học. Một hôm đang gánh nước, bỗng nhiên cây đòn gánh bị gẫy, ngài liền tỏ ngộ, bèn viết bài kệ kiến giải trình lên, được thầy ấn chứng. Sau đó, trước sau ngài đã chủ trì năm ngôi đạo tràng; đầu tiên là chùa Thiết-Phật, sau cùng là chùa Thiên-y, giáo hóa đồ chúng vô cùng đông đảo. Ngài vừa ra sức xiển dương tông chỉ của thiền phái Vân Môn, lại vừa khuyến khích mọi người thực hành pháp môn niệm Phật cầu vãng sinh Tịnh-độ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiên Y Huệ Thông", "definition": "Tien i Hui tsung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Y Nghĩa Hoài", "definition": "(天衣義懷, Tenne Gie, 993-1064): vị tăng của Vân Môn Tông Trung Quốc, người Huyện Lạc Thanh (樂清縣), Ôn Châu (温州, Tỉnh Triết Giang), họ là Trần (陳). Hồi nhỏ ông đã theo cha làm nghề đánh cá, nhưng tương truyền bắt được bao nhiêu cá ông đều thả hết. Sau được cha mẹ cho phép, ông theo học với vị tăng trong quận và xuất gia trong khoảng thời gian niên hiệu Thiên Thánh (天 聖, 1023-1031). Đầu tiên ông đến tham bái Pháp Hoa Chí Ngôn (法 華 志 言), rồi Kim Loan Thiện (金鑾善) và Diệp Huyện Quy Tỉnh (葉縣歸省). Cuối cùng ông đến tham yết Tuyết Đậu Trùng Hiển (雪竇重顯) ở Thúy Phong Tự (翠峰寺) và kế thừa dòng pháp của vị nầy. Đầu tiên ông diễn xướng pháp môn của mình tại Thiên Y Sơn (天衣山) vùng Việt Châu (越州, Tỉnh Triết Giang), rồi sau lui về ẩn cư tại Sam Sơn Am (杉山 庵) vùng Trì Châu (池州, Tỉnh An Huy). Vào ngày 25 tháng 9 năm đầu niên hiệu Trị Bình (治平), ông thị tịch, hưởng thọ 72 tuổi đời và 46 hạ lạp. Ông được ban cho thụy là Chấn Tông Đại Sư (振宗大師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Y Phái", "definition": "Digambara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Y Tông Bổn", "definition": "(天 衣 宗 本, Tenne Sōhon, ?-?): vị tăng của Thiên Thai Tông Trung Quốc, sống dưới thời nhà Minh, hiệu là Nhất Nguyên (一 元) hay Thiên Y (天 衣), xuất thân Tứ Minh (四 明, Tỉnh Triết Giang), họ Trần (陳). Năm 15 tuổi, nhân gặp một vị tăng nơi quán trà, ông được phó chúc cho phép 10 Pháp Giới và chuyên tâm sống với pháp môn Niệm Phật. Ông có viết bộ Quy Nguyên Trực Chỉ Tập (歸元直指 集) tại Diên Thọ Giảng Tự (延壽講寺), Tứ Minh vào năm thứ 32 (1553) niên hiệu Gia Tĩnh (嘉靖) với chủ trương tổng hợp Thiền và Niệm Phật.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Ái", "definition": "Devanāṁpriya (S), Preferred by Devas.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Ái Đế Tu Vương", "definition": "Devanāṁpriya-tissa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Ân", "definition": "天恩. Ơn trời. Ơn vua. Truyện Nhị Độ Mai: “Giải tình oan khuất hoạ nhờ thiên ân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Đài", "definition": "天臺. Bàn thờ ở ngoài trời. Đoạn trường tân thanh: “Nén hương khấn trước thiên đài”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Đài Tông", "definition": "Tien tai tsung (C), Tendai-shu (J), Tendai School.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đàn", "definition": "Sagga (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiên Đình", "definition": "天庭. Nhà trời. Nơi Trời ở Tiếng của các nhà tướng số, chỉ cái trán của người ta.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Đô", "definition": "遷都. Dời nơi đặt triều đình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Đường", "definition": "Svarga (S), Svarga (S), Sagga (P), Devakhan (S), Paradise, Heaven.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đại Ngũ Suy Tướng", "definition": "天大五衰相 (Pháp Uyển Châu Lâm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiên Đại Tướng Quân", "definition": "Great General of Heaven", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thiên Đạo", "definition": "Deva-gati (S), Devasoppāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đạo Giới", "definition": "Xem Thiên Đạo, Xem Thiên Vương Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đản Phái", "definition": "Ekamsikanikāya (S). Ekamsika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đảng", "definition": "偏 党. Chấp nghiêng về một phía, lệch một bên. Chương Tín Tâm Minh của Tam Tổ Tăng Xán Đại Sư trong CĐTĐL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Đế", "definition": "天帝. Vua trên trời. Ông trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Đế Thích", "definition": "Xem Đế Thích Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Địa", "definition": "天地. Trời và đất. Tụng Tây hồ phú của Nguyễn Huy Lượng: “Lò thiên địa mới bay gio”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Định", "definition": "天定. Do trời xếp đặt sẵn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiên Đồng Chính Giác Thiền Sư Quảng Lục", "definition": "天 童 正 覺 禪 師 廣 錄. Còn gọi: Hoằng Trí Thiền Sư Quảng Lục, Hoằng Trí Quảng Lục, Hoằng Trí Lục, Phổ Chiếu Giác Hòa Thượng Ngữ Lục. Ngữ Lục, 9 quyển, do Thiên Đồng Chính Giác soạn vào đời Tống, Tông Pháp và Tập Thành cùng biên tập, và được xếp vào Tục Tạng Kinh tập 124, trang 657. Thiên Đồng Chính Giác là đệ tử của Đan Hà Tử Thuần thuộc tông Tào Động, cùng với Đại Huệ Tông Cảo của tông Lâm Tế, cả hai được xem là hai cửa Cam lộ lớn vào lúc đương thời. Thiền mặc chiếu của Thiên Đồng Chính Giác thực hành lấy việc tĩnh tọa khán tâm làm căn bản. Từ các chỗ trong quyển 8 của sách này chúng ta có thể thấy ý chỉ của Thiền mặc chiếu. Chính Giác cho rằng Thiền mặc chiếu “không có nhiều lời nói, lặng lẽ là phải”. “Ngươi nhằm trong ấy lo lường, hư mà linh, không mà diệu” cũng chính là thông qua phương thức tĩnh tọa mặc chiếu mà thể ngộ tâm hư linh không diệu. Sách này là tư liệu quan trọng để nghiên cứu về sự phát triển tông Tào Động.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Đồng Như Tịnh", "definition": "Tendō Nyojō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đồng Sơn", "definition": "Tendō-zan (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Đồng Sơn Cảnh Đức Thiền Tự", "definition": "(天童山景德禪寺): hay Thiên Đồng Tự (天童寺), Thiên Đồng Thiền Tự (天童禪寺); hiệu là Đông Nam Phật Quốc (東南佛國); là ngôi tự viện Thiền Tông trứ danh, được xếp hạng thứ 2 trong 5 ngôi chùa nổi tiếng của Thiền Tông Trung Quốc; hiện tọa lạc tại sườn núi Thái Bạch Sơn (太白山), Ngân Huyện (鄞縣), Phố Ninh Ba (寧波市), Tỉnh Triết Giang Thánh địa này có liên quan mật thiết với Thiền Tông Nhật Bản, Tào Động Tông nước này xem nơi đây là Tổ Đình. Vào năm 1983, chùa được Quốc Vụ Viện công nhận là ngôi tự viện trọng yếu thuộc địa khu Hán tộc của Phật Giáo toàn quốc. Thiên Đồng Tự được sáng kiến dưới thời nhà Tấn, tương truyền do vị tăng vân du tên Nghĩa Hưng (義興) từng kết thảo am tu tập tại đây vào năm đầu (300) niên hiệu Vĩnh Khang (永康) nhà Tây Tấn. Vào năm đầu nhà Đường (唐, 618-907), chùa được dời về vị trí hiện tại. Đến năm thứ 2 (759) niên hiệu Càn Nguyên (乾元) nhà Đường, vua Túc Tông (肅宗, tại vị 756-762) ban cho tên chùa là Thiên Đồng Linh Lung Tự (天童玲瓏寺). Năm thứ 10 (869) niên hiệu Hàm Thông (咸通) nhà Đường, vua Ý Tông (懿宗, tại vị 859-873) sắc phong tên chùa là Thiên Thọ Tự (天壽寺). Đến năm thứ 4 (1007) niên hiệu Cảnh Đức (景德) nhà Tống, vua Chơn Tông (眞宗, tại vị 997-1022) ban cho chùa tên Thiên Đồng Cảnh Đức Thiền Tự (天童景德禪寺). Vào năm 1125, Thiền Sư Như Tịnh (如淨, 1163-1228), vị Tổ đời thứ 13 của Tào Động Tông Trung Quốc, đến trú trì chùa này. Lúc bấy giờ, có Đạo Nguyên (道元, Dōgen) của Nhật bản đến tham học và sau khi trở về nước thì sáng lập Tào Động Tông Nhật Bản. Vào năm thứ 5 (1178) niên hiệu Thuần Hy (淳熙) nhà Tống, vua Hiếu Tông (孝宗, tại vị 1162-1189) ban cho 4 chữ Thái Bạch Danh Sơn (太白名山). Năm thứ 4 (1134) niên hiệu Thiệu Quang (紹光) nhà Tống, ngôi Đại Điện ở phía Đông Nam được mở rộng thêm. Trong khoảng thời gian niên hiệu Gia Định (嘉定, 1208-1224) nhà Tống, chùa được liệt vào hàng thứ 3 trong Thiền Viện Ngũ Sơn Thập Sát. Sau đó, Chu Nguyên Chương (朱元璋, tức vua Thái Tổ [太祖, tại vị 1368-1398]) nhà Minh sắc phong chùa là Thiên Hạ Danh Tự (天下名寺), xếp chùa vào hàng thứ 2 trong Thiên Hạ Thiền Tông Ngũ Sơn (天下禪宗五山). Về sau, vua Ung Chính (雍正, tức vua Thế Tông [世宗, tại vị 1722-1735]) nhà Thanh ban cho chùa tấm biển Từ Vân Mật Bố (慈雲密布). Về xuất xứ tên chùa, tương truyền khi Nghĩa Hưng đến đây lập thảo am tu hành thì có sao Thái Bạch (太白) xuất hiện, biến thành đồng tử, hằng ngày hái củi, gánh nước cúng dường; nên cảm niệm ơn đó, Nghĩa Hưng đặt tên cho ngọn núi này là Thiên Đồng Sơn. Ngoài Đạo Nguyên ra, Minh Toàn (明全, Myōzen), Vinh Tây (榮西, Eisai) cũng đã từng đến đây tham bái", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Đồng Triệt", "definition": "天 童 徹 (1621-1705). Thiền tăng đời Thanh, họ Tiêu, tên Triệt, tự Thiên Nhạc, hiệu Bản Thư, người xứ Kỳ Xuân, Hồ Bắc, Trung Quốc. Nối pháp Thiền Sư Linh Thứu Thành, đời thứ 39 hệ Nam Nhạc. Trụ trì Thiên Đồng sơn tự. Có Ngữ Lục truyền lại đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Đồng Tự", "definition": "(天童寺): xem Thiên Đồng Sơn Cảnh Đức Thiền Tự (天童山景德禪寺) (天童山景德禪寺): hay Thiên Đồng Tự (天童寺), Thiên Đồng Thiền Tự (天童禪寺); hiệu là Đông Nam Phật Quốc (東南佛國); là ngôi tự viện Thiền Tông trứ danh, được xếp hạng thứ 2 trong 5 ngôi chùa nổi tiếng của Thiền Tông Trung Quốc; hiện tọa lạc tại sườn núi Thái Bạch Sơn (太白山), Ngân Huyện (鄞縣), Phố Ninh Ba (寧波市), Tỉnh Triết Giang Thánh địa này có liên quan mật thiết với Thiền Tông Nhật Bản, Tào Động Tông nước này xem nơi đây là Tổ Đình. Vào năm 1983, chùa được Quốc Vụ Viện công nhận là ngôi tự viện trọng yếu thuộc địa khu Hán tộc của Phật Giáo toàn quốc. Thiên Đồng Tự được sáng kiến dưới thời nhà Tấn, tương truyền do vị tăng vân du tên Nghĩa Hưng (義興) từng kết thảo am tu tập tại đây vào năm đầu (300) niên hiệu Vĩnh Khang (永康) nhà Tây Tấn. Vào năm đầu nhà Đường (唐, 618-907), chùa được dời về vị trí hiện tại. Đến năm thứ 2 (759) niên hiệu Càn Nguyên (乾元) nhà Đường, vua Túc Tông (肅宗, tại vị 756-762) ban cho tên chùa là Thiên Đồng Linh Lung Tự (天童玲瓏寺). Năm thứ 10 (869) niên hiệu Hàm Thông (咸通) nhà Đường, vua Ý Tông (懿宗, tại vị 859-873) sắc phong tên chùa là Thiên Thọ Tự (天壽寺). Đến năm thứ 4 (1007) niên hiệu Cảnh Đức (景德) nhà Tống, vua Chơn Tông (眞宗, tại vị 997-1022) ban cho chùa tên Thiên Đồng Cảnh Đức Thiền Tự (天童景德禪寺). Vào năm 1125, Thiền Sư Như Tịnh (如淨, 1163-1228), vị Tổ đời thứ 13 của Tào Động Tông Trung Quốc, đến trú trì chùa này. Lúc bấy giờ, có Đạo Nguyên (道元, Dōgen) của Nhật bản đến tham học và sau khi trở về nước thì sáng lập Tào Động Tông Nhật Bản. Vào năm thứ 5 (1178) niên hiệu Thuần Hy (淳熙) nhà Tống, vua Hiếu Tông (孝宗, tại vị 1162-1189) ban cho 4 chữ Thái Bạch Danh Sơn (太白名山). Năm thứ 4 (1134) niên hiệu Thiệu Quang (紹光) nhà Tống, ngôi Đại Điện ở phía Đông Nam được mở rộng thêm. Trong khoảng thời gian niên hiệu Gia Định (嘉定, 1208-1224) nhà Tống, chùa được liệt vào hàng thứ 3 trong Thiền Viện Ngũ Sơn Thập Sát. Sau đó, Chu Nguyên Chương (朱元璋, tức vua Thái Tổ [太祖, tại vị 1368-1398]) nhà Minh sắc phong chùa là Thiên Hạ Danh Tự (天下名寺), xếp chùa vào hàng thứ 2 trong Thiên Hạ Thiền Tông Ngũ Sơn (天下禪宗五山). Về sau, vua Ung Chính (雍正, tức vua Thế Tông [世宗, tại vị 1722-1735]) nhà Thanh ban cho chùa tấm biển Từ Vân Mật Bố (慈雲密布). Về xuất xứ tên chùa, tương truyền khi Nghĩa Hưng đến đây lập thảo am tu hành thì có sao Thái Bạch (太白) xuất hiện, biến thành đồng tử, hằng ngày hái củi, gánh nước cúng dường; nên cảm niệm ơn đó, Nghĩa Hưng đặt tên cho ngọn núi này là Thiên Đồng Sơn. Ngoài Đạo Nguyên ra, Minh Toàn (明全, Myōzen), Vinh Tây (榮西, Eisai) cũng đã từng đến đây tham bái", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiên Đồng Tự Thất Phật Tháp", "definition": "天 童 寺 七 佛 塔. ở trước điện Thiên vương, chùa Thiên Đồng, huyện Ngân, thành phố Ninh Ba, tỉnh Chiết Giang, Trung Quốc. Là bảy ngôi tháp nhỏ bày hình chữ nhất (一) là kiến trúc thời đại Tống Nguyên. Phần nền tòa của tháp hình bát giác, bệ nền mỗi ngôi tháp là một tầng, phần dưới là chân đàn, Như Ý khám. Trên đặt nền tòa 2 tầng, tầng dưới cao, tầng trên thấp, thân tháp là hình bầu dục, chọn dùng theo kiểu “Suất đổ ba”. Phần trên là mái tháp khắc bằng đá, đỉnh tháp hình lục giác nhọn đầu, góc mái vểnh lên, đỉnh tháp độ nghiêng dốc đứng. Thất Phật Tháp mang một tác dụng như sợi dây gắn bó cho cảnh quan trong ngoài Thiên vương điện.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiên Đức Đại Long Vương", "definition": "The Great Dragon King Heavenly Virtue.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiên Ấn", "definition": "Chùa dựng trên núi Thiên Ấn, từ năm 1694, do công của Thiền sư Trung Quốc, pháp hiệu Pháp Hóa. Chùa được chúa Nguyễn Phúc Chu ban biển ngạch: “Sắc tứ Thiên Ấn tự” Sư Pháp Hóa trụ trì chùa Thiên Ấn suốt 60 năm, những vị sư kế tiếp trụ trì chùa theo thứ tự là Khánh Vân, Báo Ân, Giác Tính, Hoằng Pháp, Diệu Quang. Hiện tháp mộ của sáu vị sư này vẫn còn ở chùa.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiên Ẩn Viên Tu", "definition": "(天 隱 圓 修, Tenin Enshū, 1575-1635): vị tăng của Lâm Tế Tông Trung Quốc, hiệu là Thiên Ẩn (天隱), xuất thân Nghi Hưng (宜興), Kinh Khê (荆溪, Tỉnh Giang Tô), họ Mẫn (閔). Năm 24 tuổi, ông xuất gia với Huyễn Hữu Chánh Truyền (幻 有 正 傳) ở Long Trì Viện (龍 池 院), rồi được đại ngộ và kế thừa dòng pháp của vị nầy. Vào năm thứ 4 (1620) niên hiệu Vạn Lịch (萬 曆), ông đến trú tại Khánh Sơn (磬山), Thường Châu (常州, Tỉnh Giang Tô), và sau đó sống qua một số nơi như Pháp Tế Thiền Viện (法 濟 禪 院), Báo Ân Thiền Viện (報 恩 禪 院) ở Võ Khang (武康, Tỉnh Triết Giang), v.v. Đến ngày 23 tháng 9 năm thứ 8 niên hiệu Sùng Trinh (崇禎), ông thị tịch, hưởng thọ 61 tuổi đời và 37 hạ lạp. Ông có để lại bộ Thiên Ẩn Hòa Thượng Ngữ Lục (天隱和尚語錄) 15 quyển. Trương Ngọc (張玉) soạn bài minh tháp của ông.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiêu", "definition": "佻. Lấy trộm Xem Dao, Điểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiêu Chích Địa Ngục", "definition": "Xem Viêm Nhiệt Địa Ngục.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiêu Huỷ", "definition": "燒毀. Đốt phá cho hư hỏng đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiêu Hương", "definition": "燒香. Đốt nhang. Thắp nhang.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiêu Hủy", "definition": "Anuḍahati (anu + dah + a), anuḍahana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiêu Táng", "definition": "燒葬. Đốt xác người chết, lấy tro đem chôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiêu Tống", "definition": "燒 送. Hỏa táng. Tiết Hoài Hải, đời thứ 3 dưới Đại Giám trong CTTNL q. 1:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiêu Đốt", "definition": "Jhāyati (jhā + ya), jāyana (trung), ḍahati (dah + a), ḍāha (nam), jalati (jal + a), jalana (trung), santāpeti (saṃ + tap + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiệu Âu", "definition": "(紹鷗, Jōō, 1504-1555): một trà nhân sống vào khoảng cuối thời đại Thất Đinh (室町, Muromachi), xưa kia họ Võ Điền (武田, Takeda), sau đổi sang họ Võ Dã (武野, Takeno), hiệu Nhất Nhàn Cư Sĩ (一閑居士), Đại Hắc Am (大黒庵). Ông đã từng theo học Trà Đạo với môn nhân của Châu Quang (珠光) là Tông Trần (宗陳), Tông Ngộ (宗悟), rồi tạo nên cốt cách của Wabicha và truyền lại cho Lợi Hưu (利休)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiến", "definition": "倩. Vẻ dẹp đẽ Đẹp trai Mỉm cười.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếp", "definition": "怗. Yên lặng Thuận theo. Bằng lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếp Canh", "definition": "帖庚. Mảnh giấy ghi tuổi, ngày sanh tháng đẻ của đôi trai gái trong việc hôn nhân. Truyện Hoa Tiên: “Tay trao cho nhận mấy tờ thiếp canh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếp Danh", "definition": "妾名. Tờ giấy ghi tên tuổi chức vụ trong việc giao thiệp. Cũng nói là Danh thiếp. Đoạn trường tân thanh: “Thiếp danh đưa đến lầu hồng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếp Phục", "definition": "妾服. Bằng lòng nghe theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết", "definition": "切. Dùng dao mà cắt ra Gần gũi. Td: Thân thiết Gấp rút. Td: Cấp thiết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Bì", "definition": "鐵皮. Da đen sạm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Bích Cơ Thiền Sư Ngữ Lục", "definition": "鐵 壁 機 禪 師 語 錄. Gọi đủ: Khánh Trung Thiết Bích Cơ Thiền Sư Ngữ Lục. Ngữ Lục, 20 quyển, do Thiết Bích Huệ Cơ soạn vào đời Minh, Huyễn Mẫn trùng biên. Nội dung bao gồm: Thượng đường, Bỉnh phất, Phổ thuyết, Tiểu tham, Thị chúng, Trà thoại, Pháp ngữ, Cơ duyên, Vấn đáp, Tiên sách ngữ, Phật sự, Tượng tán, Tự tán, Thi, Tụng, Kệ, Liên phương, Ca minh, Tụng cổ (Niêm. biệt, bình, trưng, đại), Tạp trước, Thư vấn, Thỉnh khải, Hành trạng, Tháp minh, Tế văn và phụ lục 1 thiên niên phổ. Quyển thủ có lời tựa do Hùng Nhữ Học soạn vào niên hiệu Sùng Trinh thứ 15 (1642) và lời dẫn do Hành Hoằng Ngộ soạn. Bộ Ngữ Lục này mang tính chất Quảng Lục, cũng có đem vào “Thiết Bích Cơ Thiền Sư Ngữ Lục” 3 quyển do Tam Sơn Đăng Lai biên vào niên hiệu Sùng Trinh thứ 15. Sách này có bản in lại của chùa Lăng Nghiêm phủ Gia Hưng, đời Thanh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Chi Đan", "definition": "(切支丹): xem Cát Lợi Chi Đan (吉利支丹) (吉利支丹 hay 切支丹, Christão [tiếng Bồ Đào Nha]): ban đầu từ này được viết là Cát Lợi Chi Đan (吉利支丹); nhưng sau khi Thiên Chúa Giáo bị cấm đoán thì được viết là Quỷ Lý Tử Đan (鬼理死丹) hay Thiết Tử Đan (切死丹), v.v. Hơn nữa, từ thời Tướng Quân Đức Xuyên Cương Cát (德川綱吉, Tokugawa Tsunayoshi) trở đi, để tránh tên húy chữ “Cát (吉)” của ông, người ta viết thành Thiết Chi Đan (切支丹). Đây là tên gọi chỉ cho Thiên Chúa Giáo vốn do giáo sĩ Francisco de Zabiel truyền vào Nhật năm 1549 (Thiên Văn [天文] 18), hay tên gọi của tín đồ đạo ấy; còn được gọi là Tông Thiết Chi Đan (切支丹宗), Tông Nam Man (南蠻宗).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiết Chủy Giác", "definition": "Tesshikaku (J), Tich tsui Chiao (C), Tesshikaku (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiết Cước", "definition": "鐵 脚. Thiền tăng Ngộ Duyên sống vào đời Tống, hành cước tham phỏng, chẳng nệ xa gần, người thời ấy gọi sư là “Thiết Cước”. X. Ngộ Duyên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Cước Ứng Phu", "definition": "(鉄 脚 應 夫, Tekkyaku Ōfu, ?-?): vị tăng của Vân Môn Tông sống dưới thời nhà Tống, người vừng Thanh Lưu (清流), Trừ Châu (滁州, Tỉnh An Huy), họ là Tương (蔣). Ông nương theo Thừa Thái (承泰) ở Bảo Ninh Thiền Viện (保寧禪 院) thuộc Phủ Giang Ninh (江寧府, Tỉnh Giang Tô) xuất gia và thọ cụ túc giới. Sau đến tham học với Thiên Y Nghĩa Hoài (天衣義懷) và kế thừa dòng pháp của vị nầy. Ban đầu ông đến trú tại Cam Lồ (甘露) ở Nhuận Châu (潤州, Tỉnh Giang Tô), kế đến là Sùng Phước Thiền Viện (崇福禪院) ở Trường Lô Sơn (長蘆山), thuộc Chơn Châu (眞州, Tỉnh Giang Tô). Ông được ban cho hiệu là Quảng Chiếu Thiền Sư (廣照禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiết Diện", "definition": "切面. Danh từ Toán học, chỉ cái mặt cắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Dụng", "definition": "切用. Cần dùng. Hợp với sự đem dùng vào đời sống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Giáp", "definition": "鐵甲. Áo mặc ra trận làm bằng sắt để che tên đạn Vỏ ngoài bằng sắt. Td: Thiết giáp xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Luân Vương", "definition": "Vị vua ngự trị phương Nam và cõi Diêm phù đề (Jambudvipa). Là một trong bốn Luân vương. Biểu trưng của Thiết luân vương là bánh xe sắt. Thiết luân vương, theo truyền thuyết sẽ xuất hiện và ngự trị cõi Nam Diêm phù đề, khi loài người đã đạt tuổi thọ trung bình 8 vạn tuổi trong thời kỳ giảm kiếp và 2 vạn tuổi trong thời kỳ tăng kiếp (x. các từ Kiếp, tăng kiếp giảm kiếp).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiết Lập", "definition": "Samāropa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiết Lộ", "definition": "鐵路. Đường sắt, tức đường xe lửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Lợi", "definition": "設 利. Xá Lợi, chỉ cho những mảnh răng xương giống như ngọc của Phật và các bậc cao tăng. Thiết lợi thu được sau khi hỏa táng thi thể của các vị này. Tiết Long Tường Sĩ Khuê Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Lỵ La", "definition": "Xem Xá Lợi.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiết Ngưu", "definition": "鐵 牛. Trâu sắt. Vốn là một pho tượng được thần cách hóa để giữ gìn, phù hộ cho vùng Thiểm Phủ Hà Nam khỏi bị nạn lũ lụt bởi nước sông Hoàng Hà. Thiền Tông muợn từ này để đổi thành thuật ngữ “Thiết ngưu chi cơ” có nghĩa là Tâm ấn vô tướng của Phật Tổ; về thể thì bất động, về dụng thì tự tại mà không dấu vết. Tắc 38, Bích Nham Lục (Đại 48, 175 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Phương Tiện", "definition": "設 方 便. Ý nói lập ra pháp môn phương tiện, vì người chỉ dạy. Khai thị Dục Tạng chủ trong DTNL q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Phược Lý Minh Phi", "definition": "Sobari (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiết Phật Tự", "definition": "佛 寺. ở phía tây thành phố Hồ Châu, tỉnh Chiết Giang, Trung Quốc. Được xây vào khoảng niên hiệu Thiên Giám (502-519) đời Lương Nam Triều, Thượng thư hữu bộc Xạ Từ Miễn sửa nhà làm chùa, ban đầu gọi “Bát Chính Tự”, đời Đường đổi tên “Khai Nguyên Tự”. Thời Bắc Tống, trong chùa Khai Nguyên có hai viện Quảng Phúc, Trí Giả, chia ra thờ Quán Âm và Phổ Hiền. Tượng Quán Âm đúc bằng sắt vào niên hiệu Thiên Thánh thứ 3 (1025) đời Tống. Niên hiệu Hồng Vũ thứ 2 (1369) đời Minh ban tên “Thiết Phật Thiền Tự”, tục gọi “Thiết Phật Tự”, hiện chỉ còn tiền điện, hậu điện và sương phòng. Tiền điện là Quán Âm điện, chính giữa thờ tượng sắt Quán Âm, cao 2, 15m nặng 1500 kg. Tượng hơi hướng về bên phải, thần thái đoan trang, phong tư phóng khoáng tự nhiên, pháp tướng trang nghiêm, tạo dáng ưu mỹ. Dù trải qua ngàn năm mà không bị gỉ sét, là kiệt tác của kỷ thuật đúc luyện kim đời Tống. Hậu điện là nhà trưng bày văn vật. Có 4 chiếc cột đá khắc kinh Phật của chùa Thiên Ninh, Hồ Châu được xây vào niên hiệu Hội Xương thứ 3 (843) đời Đường, trên có khắc “Tôn Thắng đà la ni kinh” và phù điêu. Còn có dựng một tấm bia lớn, trên có ghi “Thiên Ninh Vạn Thọ Thiền Tự”, là bút tích đích thực của Triệu Mạnh Phủ. Trong chùa còn có một chiếc giếng cổ do trụ trì Đàm Bích xây dựng vào niên hiệu Tuyên Đức thứ 8 (1434) đời Minh, trên miệng giếng xây vòng rào hình quả bí đỏ bằng đá cẩm thạch.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Quyết Tử", "definition": "鐵 橛 子. Cây cọc sắt. Thiền Tông muợn từ này để chỉ cho trạng thái không gì dính mắc được. Tắc 44, Bích Nham Lục (Đại 48, 180 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Sàng Đồng Trụ", "definition": "Giường sắt, trụ đồng : chỉ chung cho các loại hình cụ ở chốn Địa-ngục.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiết Tha", "definition": "切磋. Cắt và mài Chỉ sự đau khổ (như lòng dạ bị cắt bị mài). Cung oán ngâm khúc: “Khóc vì nỗi thiết tha sự thế”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Thạch", "definition": "鐵石. Sắt đá, chỉ sự cứng cỏi, bển vững.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Thật", "definition": "切實. Sát với sự thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Thọ Khai Hoa", "definition": "鐵 樹 開 花. Cây sắt trổ hoa. Thiền Tông lấy câu “Thiết thọ hoa khai thế giới hương” tỷ dụ cho mọi vật trong pháp giới đều do diệu dụng vô tâm vô tác hiển hiện. Câu “Thiết thọ hoa khai” biểu thị lý bị xem là cố định bất biến nhưng thật ra có biến hóa. Nếu phối hợp vào thể dụng, thì thiết thọ là thể, hoa khai là dụng, biểu thị công dụng vô vi vô tác do chết mà hiển sống, do tĩnh mà phát động. Phần lời dẫn, tắc 40, Bích Nham Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Trí", "definition": "設置. Xếp đặt, bày biện.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Tuấn Thao", "definition": "鐵 餕 饀. Còn gọi: Thiết tuấn liêm. Bánh bao có nhưn bằng sắt, không thể nhai, nuốt và tiêu hóa được tỷ dụ cho cơ ngữ của nhà thiền siêu việt ngôn cú, nghĩa lý, rất khó tham cứu. Pháp Diễn Ngữ Lục, q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Tích Lương", "definition": "鐵 脊 梁. Sống lưng bằng sắt, ví dụ dùng để chỉ hành vi làm phấn chấn tinh thần, tự xây dựng chí lớn và quyết tâm theo đuổi. Tiết Phúc Nghiêm Diễn Thiền Sư trong Tăng Bảo Chính Tục Truyện q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Tưởng", "definition": "竊想. Trộm nghĩ (lời nói khiêm nhường).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Tật Lê", "definition": "鐵 蒺 藜. 1. Trái chùy gai bằng sắt, là vũ khí dùng để đánh nhau vào thời xưa. Thiền Tông mượn từ này để chỉ cho sự dạy đạo nghiêm khắc. Tắc 12, Bích Nham Lục (Đại 48, 152 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiết Vi", "definition": "Vimalasvabhāva (S), Cakravāla (S), Sumeru (S), Cakravāḍa (S), Adamantine Mountains, Mount Sumeru, Iron Mountain.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiết Vi Sơn", "definition": "Theo Ấn Độ giáo, trái đất này có bảy vòng núi kim loại (sắt) và tám biển bao bọc. Ở giữa dãy núi sắt có núi Tu di (Meru), đó là trung tâm của trái đất. Chưa rõ ý nghĩa biểu trưng của bản đồ địa lý huyền thoại này.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiết Yếu", "definition": "切要. Lớn lao, cần có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Đãi", "definition": "設待. Xếp đặt các thứ để đốixử tốt với người khác. Ta thường đọc trại thành Thết đãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiết Địch Đảo Xuy", "definition": "鐵 笛 倒 吹. Tác phẩm, 2 quyển, do sư Huyền Lâu Áo Long thuộc tông Tào Động, Nhật Bản soạn. Nội dung sách này mô phỏng theo Bích Nham Lục gồm 100 tắc công án, có phần bình xướng và tụng cổ. Quyển thượng gồm 50 tắc từ “Văn Thù nhập môn” đến “Nghĩa Trung thăng tòa”. Quyển hạ gồm 50 tắc từ “Bảo Phúc Phật điện” đến “Quy Sơn phương trượng”. Theo: PQĐTĐ của Nhóm Từ Di.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu", "definition": "少. Ít tuổi. Trẻ tuổi Xem Thiểu Phụ vào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Hiệu", "definition": "少校. Cấp bậc sĩ quan trong quân đội Trung Hoa Dân quốc, tức cấp Thiếu tá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Khang", "definition": "(?-805). Ngài họ Châu, ở núi Tiên-đô, tỉnh Triết-giang, năm sinh năm tịch đều không rõ. Ngài xuất gia lúc mới lên 7 tuổi, 15 tuổi thọ đại giới tại chùa Gia-tường ở Việt-châu, học rộng kinh luận. Về sau ngài đến chùa Bạch-mã ở Lạc-dương, nhân đọc được bài văn “Tây Phương Hóa Đạo” của đại sư Thiện Đạo (613-681), bèn quyết tâm chuyên tu Niệm Phật. Ngài đem số tiền khất thực được, bảo các trẻ con, cứ niệm một câu A Di Đà Phật thì cho một tiền. Một năm sau, tất cả số con trai con gái ấy, hễ trông thấy ngài thì liền niệm A Di Đà Phật. Về sau ngài đến núi Ô-long ở Mục-châu mở đạo tràng Tịnh Độ, qui tụ đồ chúng chuyên niệm Phật. Cứ một câu niệm Phật, một đức Phật xuất ra từ miệng ngài, niệm 10 câu thì xuất ra 10 đức Phật; người đương thời gọi ngài là hậu thân của đại sư Thiện Đạo. Năm 805 ngài thị tịch.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiếu Kém", "definition": "Ūna (tính từ), ūnaka (tính từ), ūnatta (trung), ūnattā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiếu Lâm", "definition": "Shao-lin (C), Shaolinsi (C), Shōrin-ji (J), Shao-lin ssu (C)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiếu Lâm Diện Bích", "definition": "少 林 面 壁. Chỉ câu chuyện Bồ Đề Đạt Ma ngồi thiền ngó vách chùa Thiếu Lâm ở Tung Sơn. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Lâm Lãnh Tọa", "definition": "少 林 冷 坐. Đạt Ma ngồi lặng lẽ (ở chùa Thiếu Lâm). Chỉ câu chuyện Bồ Đề Đạt Ma suốt ngày ngồi lặng lẽ ngó vách chùa Thiếu Lâm ở Tung Sơn. Tiết Hoàng Long Đạo Trăn Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Lâm Phong", "definition": "少 林 風. Còn gọi: Thiền Phong. Chỉ cho Thiền Tông, Thiền pháp do Tổ Đạt Ma truyền. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Lâm Trực Chỉ", "definition": "少 林 直 指. Đạt Ma chỉ thẳng. Chỉ thiền pháp chỉ thẳng tâm người của Tổ Bồ Đề Đạt Ma truyền bá. Tiết Khai thị Bạch Vân Nhiên Trưởng lão trong MANL ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Lâm Tự", "definition": "Chùa Thiếu lâm. Có hai ngôi chùa cùng tên Thiếu-lâm: một ngôi tọa lạc tại Bàng-sơn, tỉnh Hà-bắc, được xây vào giữa thế kỉ 13, dưới triều đại nhà Nguyên; một ngôi tọa lạc tại Tung-sơn, tỉnh Hà-nam, được xây sớm hơn, vào cuối thế kỉ thứ 5, dưới triều đại nhà Bắc-Ngụy. Nhưng ngôi chùa Thiếu-lâm được nhiều người biết và nói tới nhiều nhất là ngôi ở Tung-sơn, tỉnh Hà-nam. Chùa này tọa lạc tại ngọn Thiếu-thất, là một ngọn ở đầu phía Tây của rặng núi Tung-sơn, do vua Hiếu-văn đế (471-499) của nhà Bắc-Ngụy kiến tạo vào năm 496, mời Phật Đà thiền sư (người Thiên-trúc) trụ trì. Năm 527, ngài Bồ Đề Đạt Ma đến đây, ngồi trong hang đá “diện bích” nhập định 9 năm, rồi truyền pháp cho sư Tuệ Khả, sáng lập Thiền Tông; sử gọi ngài Bồ Đề Đạt Ma là Sơ-tổ, chùa Thiếu-lâm là tổ đình, tăng tục vân tập tu học đông đảo, Thiền pháp từ đó thịnh hành. Đến triều đại Bắc-Chu, vua Vũ đế (561-578) bài trừ đạo Phật, tất cả tự viện đều bị phá hủy, chùa này cũng cùng chung số phận; nhưng đến đời vua Tĩnh đế (579-581) thì chùa lại được phục hưng, và được đổi tên là Trắc-hộ. Đến thời đại nhà Tùy, vua Tùy Văn Đế (581-604) ban sắc, chùa lấy lại tên cũ là Thiếu-lâm. Năm 617 (năm cuối cùng của vua Tùy Dạng đế) chùa bị sơn tặc phá hủy, chỉ còn lại một ngôi tháp. Vào đầu thời đại nhà Đường, vì tăng chúng chùa Thiếu-lâm từng giúp vua Đường Thái-tông (627-649) dựng nước có công, chùa Thiếu-lâm lại được trùng hưng, và môn võ nghệ Thiếu-lâm cũng được nổi danh, thịnh truyền từ đó. Từ cuối đời Đường sang đời Ngũ-đại (tức nửa đầu thế kỉ thứ 10), chùa Thiếu-lâm là đạo tràng lớn của tông Lâm Tế; từ thế kỉ 13 đến nay, nó là đạo tràng trung tâm của tông Tào Động.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiếu Lâm Tự Tháp Lâm", "definition": "少 林 寺 塔 林. Rừng tháp nằm dưới chân núi Thiếu Thất, cách chùa Thiếu Lâm chừng 0,5km về phía tây, thuộc huyện Đăng Phong, tỉnh Hà Nam Trung Quốc, gồm 250 ngôi mộ tháp lớn nhỏ, là một rừng tháp lớn nhất Trung Quốc. Mộ tháp nơi đây có đủ tháp của các triều đại, sớm nhất là niên hiệu Trinh Nguyên thứ 7 (791) đời Đường, trể nhất là niên hiệu Gia Khánh thứ 8 (1803) đời Thanh, trong đó tháp gạch nhiều, tháp đá ít, từ 1 tầng đến 7 tầng, cao từ 15m trở xuống. Mỗi tháp đều có niên đại chuẩn xác và đều có ghi chép điêu khắc phong phú. Tạo hình cũng phong phú đa dạng. Xét về bình diện, có tháp hình vuông, hình lục giác, hình bát giác, hình tròn; xét về lập thể, có tháp theo kiểu đình các một mái một tầng, có tháp nhiều mái nhiều tầng, có tháp hình chuông, hình cột, hình bình, trong đó đa số tháp theo kiểu đình các và mái kín. Có thể nói đây là một nơi tham quan thưởng thức về nghệ thuật thư pháp, điêu khắc và cổ tháp qua các thời đại. Trong rừng tháp còn có một số mộ tháp của cao tăng nước ngoài như mộ tháp Trưởng lão Cúc Am (Nhật Bản) xây vào niên hiệu Chí Nguyên thứ 5 (1339) đời Nguyên, mộ tháp Hòa Thượng Thiên Trúc (ấn Độ) xây vào niên hiệu Gia Tỉnh thứ 43 (1564) đời Minh…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Niên", "definition": "少年. Tuổi trẻ. Người trẻ tuổi. Bản dịch Chinh phụ ngâm khúc: “Nỡ nào đôi lứa thiếu niên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Nữ", "definition": "少女. Người con gái trẻ tuổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Phụ", "definition": "少婦. Người đàn bà trẻ tuổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Quân", "definition": "少君. Ông vua lên ngôi còn nhỏ tuổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Sót", "definition": "Vippaṭipajjati (vi + paṭi + pad + ya), vipajjhati (vi + radh + ya), virādhanā (nữ), vekalla (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiếu Sức Khỏe", "definition": "Dubbala (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiếu Thất", "definition": "少 室. 1. Ngọn núi ở phía bắc huyện Đăng Phong tỉnh Hà Nam, Trung Quốc. Do vì trong núi có thất đá nên mới có tên này và nó thuộc về Tung Sơn. Vào thời Bắc Ngụy. Hiếu Văn Đế cho xây chùa Thiếu Lâm trên núi và Tổ Đạt Ma đã từng ngồi xoay mặt vào vách chùa này đến 9 năm. Đây là lý do khiến chùa nổi danh ở đời. Tắc 1, Bích Nham Lục (Vạn Tục 117, 128 thượng) ghi: 直 歸 少 室 峰 前 坐", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Thất Gia Phong", "definition": "少 室 家 風. Môn phong nhà thiền, hoặc sự truyền thừa Thiền pháp. Tiết Tuyết Phong Tư Huệ Thiền Sư trong NĐHN q. 16 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Thất Lục Môn Tập", "definition": "少 室 六 門 集. Còn gọi: Thiếu Thất Lục Môn. Sách, 1 quyển, do Bồ Đề Đạt Ma soạn, được xếp vào Đại Chính Tạng tập 48, trang 365. Nội dung ghi lại những lời nói quả quyết chân thật và quan trọng của thiền gia, chia ra làm 6 cửa như sau: Tâm kinh tụng, Phá tướng luận, Nhị chủng nhập, An tâm pháp môn, Ngộ tính luận. Huyết mạch luận. Có người nghi rằng trừ “Nhị chủng nhập” ra, còn 5 cửa kia là do người sau ngụy tác.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Thất Tâm Ấn", "definition": "少 室 心 印. Thiền pháp tâm tâm tương ấn (Tâm thầy in sang tâm trò) của Tổ Đạt Ma truyền bá. X. Thiếu Thất. Tiết Nghệ Ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Thất Đơn Truyền", "definition": "少 室 單 傳. Chỉ thiền pháp do Tổ Bồ Đề Đạt Ma truyền bá. Đơn truyền: Theo cách nói của nhà thiền: Hai mươi tám vị Tổ ấn Độ và sáu vị Tổ Trung Hoa, mỗi đời chỉ truyền một người, gọi là đơn truyền. X. Thiếu Thất.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiếu Thốn", "definition": "Vikala (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiếu Thời", "definition": "少時. Lúc còn trẻ tuổi, nhỏ tuổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Tá", "definition": "少佐. Tên một cấp bậc sĩ quan, trên cấp Đại uý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Tướng", "definition": "少將. Tên một cấp bậc sĩ quan trong quân đội, dưới cấp Trung tướng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Uý", "definition": "少尉. Một cấp bậc sĩ quan trong quân đội.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiếu Đàm", "definition": "少 曇. X. Bảo Đàm", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiềm", "definition": "檐. Mái hiên nhà.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiềm Cung", "definition": "蟾宮. Chỉ mặt trăng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiềm Quang", "definition": "(蟾光): tức chỉ cho ánh sáng mặt trăng, vì trong văn hóa cổ đại của Trung Quốc thường lấy con thiềm thừ (蟾蜍, con cóc) để thay thế cho mặt trăng. Cho nên cổ nhân thường dùng từ “ngân thiềm quang mãn (銀蟾光滿, trăng bạc sáng tròn).” Đạo Giáo Trung Quốc dùng chữ thiềm quang để chỉ cho huệ quang (慧光, ánh sáng trí tuệ); còn Khí Công thì chỉ cho ánh sáng vàng ròng. Trong bài thơ Khê Thượng Nguyệt (溪上月) của thi tăng Kiểu Nhiên (皎然, ?-?) nhà Đường có câu: “Thiềm quang tán phố tự, tố ảnh động luân liên (蟾光散浦溆、素影動淪漣, ánh trăng tan bến nước, bóng trắng động sóng chìm).” Hay như trong bài từ Tình Cửu Trường (情久長) của Lữ Vị Lão (呂渭老, ?-?) nhà Tống có đoạn: “Tuế hoa mộ, thiềm quang xạ tuyết, bích ngõa phiêu sương, trần bất động, hàn vô tế (歲華暮、蟾光射雪、碧瓦飄霜、塵不動、寒無際, dịp cuối năm, ánh trăng bắn tuyết, ngói biếc bay sương, bụi chẳng động, lạnh vô cùng).” Trong bài Túy Bồng Lai Cửu Nguyệt Thập Bát Nhật Tây Quắc Lưu Thị Tiếu (醉蓬萊九月十八日西虢劉氏醮) của Khưu Xứ Cơ (丘處機, 1148-1227) nhà Nguyên có câu: “Nhạn ảnh trầm sa, thiềm quang chiếu dạ, huân huân đồng túy (雁影沉沙、蟾光照夜、醺醺同醉, bóng nhạn chìm cát, ánh trăng chiếu đêm, vui vẻ say mèn).” Bản Tiêu Thích Kim Cang Kinh Khoa Nghi Hội Yếu Chí Giải (銷釋金剛經科儀會要註解, 卍 Tục Tạng Kinh Vol. 24, No. 467) quyển 7 cũng có đoạn: “Thanh sơn lục thủy, dữ ngã hà thù, kim sanh Lệ thủy, thiềm quang mãn thái hư (青山綠水、與我何殊、金生麗水、蟾光滿太虛, núi xanh nước biếc, cùng ta khác gì, vàng sanh sông Lệ, ánh trăng khắp hư không).” Hoặc như trong Chứng Đạo Ca Tụng (證道歌頌, 卍Tục Tạng Kinh Vol. 65, No. 1291) lại có câu: “Lục Độ vạn hạnh thể trung viên, chân thể vô lao biện đồng biệt, vạn thủy thiềm quang nhậm khứ lưu, kiểu kiểu thiên tâm duy nhất nguyệt (六度萬行體中圓、眞體無勞辨同別、萬水蟾光任去留、皎皎天心唯一月, Sáu Độ muôn hạnh thể tròn đầy, thật thể chẳng cần phân khác giống, muôn dòng trăng sáng mặc cuốn trôi, vằng vặc giữa trời trăng một đóa).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiềm Thừ", "definition": "蟾蜍. Con cóc Chỉ mặt trăng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiền", "definition": "Son (K), Meditation, Ch'an (C), Zen (J), Dhyāna (S), Jhāna (P)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Am", "definition": "禪 庵. Nhà cỏ đơn sơ để tu tập pháp thiền. Huyền Giác truyện trong TCTT q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Ba La Mật", "definition": "Dhyana Paramita", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thiền Bardo", "definition": "Bardo Meditation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Buổi Tối", "definition": "Yaza (J), Evening meditation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Bá", "definition": "禪 伯. Lời tôn xưng các vị thiền sư có đạo đức cao, danh vọng lớn. Thư Dương ức gởi Lý Duy trong CĐTĐL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Bản", "definition": "Kyosaku (J), Zemban (J), Meditation plank.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Bắc Tông", "definition": "Beizongchan (C), Hokushū-zen (J), Pei-tsung ch'an (C), Beizongchan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Bệnh", "definition": "禪 病. Đứng về lập trường Tổ sư thiền, nói chung những gì có thể chướng ngại sự kiến tính đều gọi là Thiền bệnh. Nói khác đi, hễ có sở trụ đều là bệnh, lọt vào tương đối đều là bệnh. Viên Giác Kinh (Đại 17, 920 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Bị Chúng Cách", "definition": "禪 備 眾 格. Pháp môn của nhà thiền bao gồm và súc tích nhiều phương thức. Tiết Tục Nghệ Ngôn trong NHQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Chi", "definition": "États de contemplation Jhanangani - Full concentration states 禪支 Jhānangāni", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thiền Chúng", "definition": "禪 眾. Tăng chúng tham thiền. Pháp Diễn Ngữ Lục q. thượng:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Chỉ", "definition": "Serenity meditation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Chủ Đại Sư", "definition": "禪 主 大 師. Hiệu của Thiền tăng Kiểu Nhiên, đời Ngũ Đại, do Mân Vương ban cho. X. Kiểu Nhiên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Chứng", "definition": "Xem Đẳng Chí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Cơ", "definition": "Là một thuật ngữ trong thiền môn, chỉ cho cái trạng thái mẫn nhuệ của một thiền sinh khi tiếp nhận giáo pháp do thầy trao truyền. Để thu nhận đồ đệ hay khảo nghiệm trình độ tu chứng của môn đồ, thiền sư thường gửi ý tứ vào một hành vi bất chợt hay lời nói vu vơ, vô nghĩa nào đó, rồi quan sát phản ứng của đối tượng, từ đó mà biết được căn cơ của đối tượng.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiền Cầu", "definition": "禪 毬. Quả banh lông, nhà chùa dùng để ném đánh thức người tu thiền ngủ gật. Tư Trì Ký q. hạ ghi: “Quả banh của nhà chùa dùng gọi là thiền cầu, được ném từ đằng xa để đánh thức người ngủ gật trong lúc tọa thiền”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Duyệt", "definition": "禪 悅. Trạng thái vui vẻ thoải mái phát sinh nơi tâm khi người tu nhập vào thiền định. Thượng Sĩ Hành Trạng trong Tuệ Trung Thượng Sĩ Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Duyệt Thực", "definition": "Food of meditation delight", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thiền Gia", "definition": "禪家. Người tu theo đạo Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiền Gia Quy Giám", "definition": "禪 家 龜 鍳. Sách, 1 quyển, do Thanh Hư Thể Tịnh (vị tăng Triều Tiên) soạn, được xếp vào Tục Tạng Kinh tập 112, trang 911. Trong sách này, tác giả giải thích về yếu chỉ của công phu tham thiền, gồm hơn 80 điều như: Nhất vật bất sinh bất diệt, Tâm Phật Chúng sinh, Giáo Thiền nhị đồ, Tổ Sư công án, Thoại đầu công phu, Vô sinh không, Giới định huệ, Bố thí trì giới nhẫn nhục tinh tấn, Trì chú lễ bái niệm Phật, Thính kinh khán kinh, Xuất gia tu đạo, Vô thường, Sám hối, Lâm chung, Tông sư, Ngũ gia gia phong, Lâm Tế tông chỉ v. v… phụ lời bình hoặc kệ tụng và trưng dẫn lời kinh, lời của các thiền sư. Đầu quyển có lời tự tự vào niên hiệu Gia Tĩnh thứ 43 (1564) đời Minh. Cuối quyển có lời bạt của Tùng Vân Duy chính (đệ tử của sư) vào niên hiệu Vạn Lịch thứ 7 (1579).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Huệ", "definition": "Dhyāna-Prajñā (S), Dhyana wisdom.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Hà", "definition": "Sông thiền. Đạo Phật ví như sông lớn, có thể đáp ứng mọi nhu cầu của chúng sinh và diệt trừ mọi phiền não: “Nguyệt bạch vừng thanh, soi mọi chỗ, thiền hà lai láng.” (Trần Nhân Tông – Cư Trần Lạc Đạo)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Hành", "definition": "Cankramāna (S), Cankamana (P), Cankama (S), Kinhin (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Hòa", "definition": "(禪和): còn gọi là Thiền hòa tử (禪和子), Thiền hòa giả (禪和者); tức chỉ cho người tham Thiền. Như trong Thiền Tông Tụng Cổ Liên Châu Thông Tập (禪宗頌古聯珠通集, 卍Tục Tạng Kinh Vol. 65, No. 1295) quyển 20, phần Tổ Sư Cơ Duyên (祖師機緣), có đoạn: “Tằng đáo khiết trà khứ, vị đáo khiết trà khứ, Triệu Châu lão Thiền hòa, khẩu điềm tâm lí khổ (曾到喫茶去、未到喫茶去、趙州老禪和、口甜心裏苦, từng đến [bảo] uống trà đi, chưa đến [cũng bảo] uống trà đi, Triệu Châu lão Thiền sư, miệng ngọt trong tâm đắng).” Hay trong Thiền Tông Tạp Độc Hải (禪宗雜毒海, 卍Tục Tạng Kinh Vol. 65, No. 1278) quyển 8, bài Kết Hạ (結夏), lại có đoạn: “Nhất bách Thiền hòa tam thập châu, vô thằng tự phược vạn sơn đầu, thùy thị hộ thân thùy thị sát, bạch vân ảnh lí thiết thuyền phù (一百禪和三十州、無繩自縛萬山頭、誰是護身誰是殺、白雲影裏鐵船浮, một trăm Thiền tăng ba mươi châu, không thừng tự buộc vạn non đầu, ai kẻ hộ thân ai là giết, trắng mây trong bóng thuyền sắt trôi).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Hải Thập Trân", "definition": "(禪海十珍, Zenkaijicchin): 1 quyển, do Vi Lâm Đạo Bái (爲霖道霈) nhà Minh biên tập, san hành năm thứ 26 (1687) niên hiệu Khang Hy (康熙) nhà Thanh. Vi Lâm Đạo Bái—pháp từ của Vĩnh Giác Nguyên Hiền (永覺元賢)—đặc biệt soạn ra 10 thiên từ trong Thiền Hải Pháp Bảo (禪海法寶), ghi lời niêm vào trong cương tông và luận bình về yếu chỉ của chúng với mục đích làm sách gối đầu cho những người sơ tâm tham học. Mười thiên gồm: Thất Phật Truyền Pháp Kệ (七佛傳法偈), Nhập Đạo Tứ Hành (入道四行) của Bồ Đề Đạt Ma (菩提達磨), Tín Tâm Minh (信心銘) của Tam Tổ Tăng Xán (僧璨), Nhị Chủng Tam Muội (二種三昧) của Lục Tổ Huệ Năng (慧能), Chứng Đạo Ca (證道歌) của Vĩnh Gia (永嘉), Tham Đồng Khế (參同契) của Thạch Đầu (石頭), pháp ngữ của Lâm Tế (臨濟), Bảo Kính Tam Muội (寶鏡三昧) của Động Sơn (洞山), Thập Huyền Đàm (十玄談) của Đồng An (同安), và Cửu Đới (九帯) của Phù Sơn (浮山). Tác phẩm này được san hành tại Thánh Tiễn Đường (聖箭堂) ở Cổ Sơn (鼓山) và tại Nhật có bản san hành vào năm thứ 8 (1695) niên hiệu Nguyên Lộc (元祿).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Họa Nhất Vị", "definition": "禪 畫 一 味. Thiền học và hội họa có cùng một tính chất tốt đẹp. Hội họa là một ngành nghệ thuật chú trọng đến phần thẩm mỹ bên ngoài. Thiền học là một ngành nghệ thuật hướng đến phần thẩm mỹ bên trong. Cả trong và ngoài, cả tình và lý, cả họa và thiền dung hợp bổ túc cho nhau để đào tạo những con người thiện mỹ sống trong một thế giới đẹp đẽ an lành. Đó là chủ trương, cũng là thuyết của ngài Tuyết Đơn, thiền sư kiêm họa sĩ của Nhật Bản. Theo: Triết học Zen của Hòa Thượng Thiên Ân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Học Đại Hệ", "definition": "禪 學 大 系. Sách, 8 quyển, do “Thiền Học Đại Hệ Biện Toản Cục” biên, được ấn hành vào khoảng niên hiệu Minh Trị thứ 43 đến niên hiệu Đại Chính thứ 4 (1910-1915). Nội dung bao gồm các kinh lục mang tính đại biểu về thiền, chia làm: Kinh luận bộ, Giới pháp bộ, Tổ lục bộ, Thanh quy bộ, Truyện ký bộ, Phê phán bộ, Tạp bộ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Khách", "definition": "禪 客. 1. Người tham thiền, bao quát cả những vị tu thiền tại gia, chứ không chỉ riêng cho thiền tăng. Lâm Tế Lục (Đại 47, 506 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Kinh Tu Hành Phương Tiện", "definition": "Xem Đạt Ma Đa La Thiền Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Luật", "definition": "Thiền môn và Luật tông.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Lâm", "definition": "Zenrin (J), A forest for meditation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Lâm Bảo Huấn", "definition": "(禪林寳訓, Zenrinhōkun): 2 quyển, do Tịnh Thiện (淨善) nhà Tống thâu tập, san hành vào năm thứ 11 (1378) niên hiệu Hồng Võ (洪武). Ban đầu nó có tên gọi là Thiền Môn Bảo Huấn (禪門寳訓) và chẳng biết khi nào sau đó được đổi thành Thiền Lâm Bảo Huấn. Từ các truyền ký, Ngữ Lục chư vị thánh đức xưa kia, của Đại Huệ Tông Cảo (大慧宗杲) và Trúc Am Sĩ Khuê (竹菴士珪) đã biên soạn hơn 100 sự việc đáng làm mô phạm cho hàng học nhân, sau đó Tịnh Thiện bổ sung, biên tập lại làm thành hơn 300 thiên và chia bộ này thành 2 quyển thượng, hạ. Vốn xưa nay tác phẩm này được lưu hành rộng rãi trong Thiền lâm, trong phần cuối sách có Thiền Lâm Bảo Huấn Âm Nghĩa (禪林寳訓音義, Tục Tạng 2, 18, 2) Đại Kiến (大建) nhà Minh hiệu đính, Thiền Lâm Bảo Huấn Hợp Chú (禪林寳訓合注, Tục Tạng 2, 18, 2) do Trương Văn Gia (張文嘉) nhà Thanh hiệu đính, Thiền Lâm Bảo Huấn Niêm Tụng (禪林寳訓拈頌, Tục Tạng 2, 18, 2) do Hành Thạnh (行盛) nhà Thanh soạn, Thiền Lâm Bảo Huấn Thuận Chu (禪林寳訓順硃, Tục Tạng 2, 18, 2) do Thánh Khả Đức Ngọc (聖德可玉) nhà Thanh soạn và Thiền Lâm Bảo Huấn Bút Thuyết (禪林寳訓筆說, Tục Tạng 2, 18, 4) do Trí Tường (智祥) nhà Thanh soạn, v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Lâm Bảo Huấn quyển 1 (Đại 48, 1019 thượng) ghi: “Ngài Diễn tổ nói: (...) Người nắm giữ công việc trong sơn môn, phải hiểu biết nhân quả, như sư ông giúp sư tổ Từ Minh vậy!”.", "definition": "II.Sư Tổ (?-?).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thiền Lâm Bị Dụng Thanh Quy", "definition": "禪 林 備 用 清 規. Còn gọi: Bị Dụng Thanh Quy, Trạch Sơn Thanh Quy, Chí Đại Thanh Quy, Bị Quy. Sách, 10 quyển, do Trạch Sơn Nhất Hàm biên vào đời Nguyên, được biên tập xong vào niên hiệu Chí Đại thứ 4 (1311) đời Nguyên, sau đó được xếp vào Tục Tạng Kinh tập 112, trang 56. Tác giả biên tập lại các quy củ, lễ pháp của thiền lâm từ đời Đường trở về sau. Tất cả gồm l69 mục về quy củ nghi thức thiền môn như: Thánh tiết thăng tòa phúng kinh, Tọa thiền, Lăng Nghiêm hội, Chuyên sứ thỉnh trụ trì, Bách Trượng quy cảnh văn, Trì phạm nghi quỹ, Đương đại trụ trì Niết Bàn, Nhật dụng thanh quy v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Lâm Loại Tụ", "definition": "禪 林 類 聚. Sách, 20 quyển, do Đạo Thái soạn vào đời Nguyên, Trí Cảnh biên tập, được xếp vào Tục Tạng Kinh tập 117, trang 1. Tác giả sưu tập cơ duyên Ngữ Yếu của các thiền sư từ Truyền Đăng Lục, Ngữ Lục rồi biên chép lại mà thành. Nội dung bao gồm 102 loại như sau: Đế vương, Tể thần, Nho sĩ, Phật tổ, Pháp thân, Phật tượng, Già lam, Điện đường, Tháp miếu, Trượng thất, Môn hộ, Thiền định, Kinh giáo, Ni nữ, Giới luật, Lễ bái, Duyên hóa, Thần dị, Vấn tật, Phục sức, Pháp khí, Trai chúc, Hương đăng, Sư tử tượng, Quy ngư v. v… Trong ấy có rất nhiều lời thị chúng của thiền gia, vấn đáp thương lượng giữa bậc thầy với người học, các câu hỏi về việc tham cứu, sự nghiệp của nhà thiền …", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Lâm Thiết Chủy Ngữ Lục", "definition": "禪 林 鐵 觜 語 錄. Tác phẩm, 1 quyển, do vua Trần Nhân Tông, Sơ tổ Thiền phái Trúc Lâm Yên Tử soạn vào đời Trần, Việt Nam. Nội dung gồm các bài kệ tụng, những lời Thiền ngữ và những đoạn vấn đáp giữa Trúc Lâm và các môn đệ. Tuy tác phẩm hiện nay không còn, nhưng tư tưởng và văn phong còn sót lại trong những đoạn trích cho thấy đây là một tác phẩm giá trị. Ngoài những giá trị được chuyển tải trong nội dung tác phẩm, sách này còn đóng góp rất lớn vào kho tàng văn học Thiền của Việt Nam thời Lý Trần. Hiện nay, tác phẩm chỉ còn vài đoạn trích in lại trong Tam Tổ Thục Lục và Thánh Đăng Lục. Theo: VNPGSL q. 1 của Nguyễn Lang.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Lâm Tăng Bảo Truyện", "definition": "禪 林 僧 寶 傳. Gọi tắt: Tăng Bảo Truyện. Truyện ký, 30 quyển, do Huệ Hồng soạn vào đời Tống, được xếp vào Tục Tạng Kinh tập 137, trang 439. Nội dung bao gồm lược truyện của 81 vị thiền tăng từ đời Ngũ Đại đến niên hiệu Chính Hòa thứ 7 (1117) đời Bắc Tống. Trong ấy có: 11 vị thuộc pháp hệ Thanh Nguyên 10 vị thuộc tông Tào Động, 17 vị thuộc tông Lâm Tế, 15 vị thuộc Vân Môn,5 vị thuộc tông Pháp Nhãn, 1 vị thuộc tông Quy Ngưỡng, 15 vị thuộc phái Hoàng Long, 4 vị thuộc phái Dương Kỳ, riêng có 3 vị không rõ thuộc pháp hệ nào. Sách này đặt nặng phần sự tích còn các bộ Đăng Lục nghiêng về việc ghi chép cơ ngữ. Tuy nhiên sách này cũng có thu thập một vài cơ duyên ngữ cú, sau đó phụ thêm tán ngữ để bình nghị. Huệ Hồng góp nhặt những tin tức, sự tích của thiền lâm còn sót lại, dung hội các thuyết, lời văn trang nhã, nhất quán; sau khi hoàn tất được thiền gia xem trọng. Sách này về mặt sử liệu tuy có vài chỗ chẳng đáng tin, nhưng trong sử truyện Thiền Tông nó vẫn là một tác phẩm có ảnh hưởng quan trọng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Lâm Tự", "definition": "(禪林寺, Zenrin-ji): còn gọi là Thánh Chúng Lai Nghênh Sơn (聖眾來迎山), tục xưng là Vĩnh Quán Đường (永觀堂), là ngôi chùa trung tâm của Phái Tây Sơn (西山派) thuộc Tịnh Độ Tông; hiện tọa lạc tại Yōgandō-chō (永觀堂町), Sakyō-ku (左京區), Kyoto-shi (京都市). Vào năm 855 (niên hiệu Tề Hành [齊衡] thứ 2), Chơn Thiệu (眞紹) cải biến ngôi sơn trang của Đằng Nguyên Quan Hùng (藤原關雄) thành Vô Lượng Thọ Viện (無量壽院), làm đạo tràng cầu nguyện trấn hộ quốc gia. Sau đó, vào năm 863 (niên hiệu Trinh Quán [貞觀] thứ 5), chùa được ban sắc phong của triều đình với tên gọi là Thiền Lâm Tự; đến năm 877 (niên hiệu Nguyên Khánh [元慶] nguyên niên), Ngự Nguyện Đường (御願堂) được xây dựng, lãnh vức của chùa cũng được mở rộng thêm. Chư vị danh đức như Tông Duệ (宗叡), Thâm Giác (深覺), Tĩnh Biến (靜遍) thay nhau làm cho tông phong của chùa hưng thạnh; nhưng trong khoảng thời gian niên hiệu Thừa Lịch (承曆, 1077-1080), khi Luật Sư Vĩnh Quán (永觀) của Tam Luận Tông đến trú trì chùa, kiến lập Đông Nam Viện (東南院) để giảng thuyết về Tam Luận và tuyên dương pháp môn Niệm Phật. Tượng thờ chính của chùa là A Di Đà Phật có câu chuyện liên quan đến Vĩnh Quán. Sau đó, Tịnh Âm (淨音) của Phái Tây Sơn thuộc Tịnh Độ Tông đến đây trú trì, cải đổi chùa thành đạo tràng Niệm Phật; và từ đó trở đi, chùa trở thành thánh địa của phái này. Trong vụ loạn Ứng Nhân (應仁), chùa cũng bị suy tàn, nhưng đến thời đại Giang Hộ thì phục hưng lại. Bảo vật của chùa liên quan đến Tịnh Độ Giáo có rất nhiều như Sơn Việt A Di Đà Đồ (山越阿彌陀圖), Lai Nghênh Đồ (來迎圖), Đương Ma Mạn Trà La Đồ (當麻曼荼羅圖), Dung Thông Niệm Phật Duyên Khởi (融通念佛緣起), Thích Ca Tam Tôn, 3 bức Thập Đại Đệ Tử, 16 bức Thập Lục La Hán, v.v. (禪林寺, Zenrin-ji): ngôi tự viện của Tào Động Tông; hiện tọa lạc tại Ichinomiya-shi (一宮市), Aichi-ken (愛知縣). Vào năm 970 (Thiên Lộc [天祿] nguyên niên), để hồi hướng công đức cầu nguyện siêu độ cho Đằng Nguyên Thật Lại (藤原實賴, Fujiwara-no-Saneyori), quan Chánh Nhất Vị của Tiểu Dã Cung (小野宮), Vĩ Trương (尾張, Owari), người ta đã cho tạc tượng Dược Sư Như Lai và kiến lập một ngôi chùa, lấy tên là Tiểu Dã Viện Cực Lạc Tự (小野院極樂寺). Đương thời chùa này thuộc về Thiên Thai Tông; người khai cơ là Hòa Thượng Hoa Quốc (花國). Vào năm 1019 (Khoan Nhân [寛仁] 3), nhà công khanh Đằng Nguyên Tư Bình (藤原資平, Fujiwara-no-Sukehira) mô phong theo Tỷ Duệ Sơn (比叡山, Hieizan), xây dựng ngay trước cổng chùa đền thờ Nhật Cát Thần Xã (日吉神社, Hiyoshi Jinja) để trấn hộ. Đến năm 1525 (Đại Vĩnh [大永] 5), Thiền Sư Tuyên Tẩu Đàm Châu (宣叟曇周) tái hưng chùa, chuyển sang Tào Động Tông và giữ mãi cho đến hôm nay. Tượng thờ chính của chùa là Dược Sư Như Lai, được an trí tại Dược Sư Đường, tương truyền do Tăng Đô Huệ Tín (惠信) tạc nên, là bảo vật vô giá của chùa.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Lão", "definition": "禪 老 (?-?). Thiền tăng đời Lý, thuộc dòng Vô Ngôn Thông, đời thứ 6, nối pháp Thiền Sư Đa Bảo. Không rõ tên họ và sinh quán. Sau sư đến trụ trì chùa Trùng Minh trên núi Thiên Phúc huyện Tiên Du (nay thuộc tỉnh Hà Bắc). Thiền phong của sư lan khắp, số người theo học có trên số ngàn, khiến cảnh chùa này trở thành một tùng lâm sung thạnh. Khoảng niên hiệu Thông Thụy (1034-1038), vua Lý Thái Tông thường đến viếng chùa sư. Sau khi về cung, Vua sai sứ đến chùa rước sư vào triều làm cố vấn. Khi sứ đến nơi, sư đã viên tịch. Vua rất đỗi mến tiếc, ngự chế thi và ai vãn, sai Trung sứ đến cúng và tặng lễ, thu linh cốt xây tháp cúng dường. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Lưu", "definition": "(禪流): những người tu tập Thiền Tông, hay nói chung là tu sĩ Phật Giáo. Nam Thạch Văn Tú Thiền Sư Ngữ Lục (南石文琇禪師語錄, 卍Tục Tạng Kinh Vol. 71, No. 1422) quyển 4, bài Tặng Hổ Kheo Hỷ Tạng Chủ (贈虎丘喜藏主), có đoạn: “Tỳ Lô các hạ quỷ tiên thi, tứ hải Thiền lưu thiết yếu tri, khán tận nguyên lai duy nhất cú, nhược ngôn nhất cú tảo thành nghi (毗盧閣下鬼仙詩、四海禪流切要知、看盡元來惟一句、若言一句早成疑, Tỳ Lô dưới điện linh quỷ thơ, bốn biển Thiền tăng rõ biết cho, xét kỹ xưa nay một câu chỉ, một câu nếu bảo thành nghi ngờ).” Hay trong bài Thích Ca Văn Phật Tán (釋迦文佛贊) của Sở Thạch Phạn Kỳ Thiền Sư Ngữ Lục (楚石梵琦禪師語錄, 卍Tục Tạng Kinh Vol. 71, No. 1420) quyển 13 có đoạn rằng: “Tam thế Như Lai cọng nhất tâm, nhất tâm bất cách khứ lai câm, Nhiên Đăng thọ ký duyên vô đắc, Bát Nhã đàm không thán thậm thâm, cùng tử nhiếp quy An Dưỡng sĩ, đạo tràng xướng xuất Niết Bàn âm, Vân Môn tối thị tri ân giả, giải hướng Thiền lưu thống xứ châm (三世如來共一心、一心不隔去來今、然燈授記緣無得、般若譚空嘆甚深、窮子攝歸安養士、道場唱出涅槃音、雲門最是知恩者、解向禪流痛處針, ba đời Như Lai cũng một tâm, một tâm chẳng cách xưa nay cùng, Nhiên Đăng thọ ký duyên chẳng có, luận bàn Bát Nhã thật thâm huyền, con khổ thảy về An Dưỡng kẻ, đạo tràng vang xướng Niết Bàn âm, Vân Môn quả đúng tri ân bạn, xoa dịu tu Thiền nhói kim đâm).” Hoặc như trong Kiềm Nam Hội Đăng Lục (黔南會燈錄, 卍Tục Tạng Kinh Vol. 85, No. 1591) quyển 2 có câu: “Trân trọng Thiền lưu thân thiết cú, hưu đắc vô thằng tự thảo phược (珍重禪流親切句、休得無繩自討縛, trân trọng tu hành lời thân thiết, chớ để không dây trói buộc mình).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Lạc", "definition": "Niềm vui của thiền định.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Minh Sát", "definition": "Vipaśyana meditation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Môn", "definition": "禪門. Cửa chùa. Nhà chùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiền Môn Bảo Tạng Lục", "definition": "禪 門 寶 藏 錄. Lục, 3 quyển, do Thiên Sách (vị tăng Cao Ly) soạn, được xếp vào Tục Tạng Kinh tập 113, trang 985. Sách này là do tác giả trích lục các lời hỏi đáp chất vấn quan trọng về tông thừa từ trong các bộ Truyền Đăng Lục như “Cảnh Đức Truyền Đăng Lục”, “Gia Thái Phổ Đăng Lục”. Nội dung gồm có:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Chư Tổ Sư Kệ Tụng", "definition": "禪 門 諸 祖 師 偈 頌. Thi ca hợp tập, 4 quyển, do Tử Thăng và Như Hựu biên vào đời Tống, được xếp vào Tục Tạng Kinh tập 116, trang 908. Nội dung bao gồm trên 80 mục răn dạy của các bậc cao tăng Thiền Tông dưới hình thức kệ tụng như: Phật Tổ truyền pháp tụng, Trí tâm minh, Huyền trung minh, Tuyết Tử ngâm, Tọa thiền minh, Ngũ vị tụng, Thiền nguyệt quy giám, Chí Công dược phương, Nhân Tông Hoàng đế tán tăng, miễn Phật Quả hành cước, Chân tính tụng v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Khoa Giáo", "definition": "禪 門 科 教. Tác phẩm, 1 quyển, do Trạng nguyên Lương Thế Vinh soạn vào đời Hậu Lê, Việt Nam. Đây là một cuốn giáo khoa Phật học. Có thuyết đây là một cuốn sách nói về những nghi thức cúng tế trong Phật giáo, điều này không đúng. Vì chữ khoa trong Phật học có nghĩa là phân tích văn mạch và làm cho rõ ý từng đoạn. Văn đây là nguyên văn của kinh điển. Trong lúc Phật giáo suy đồi, có lẽ vì nhận thấy sách giáo khoa Phật giáo soạn thảo dưới đời Trần mất hết, nên Lương Thế Vinh mới biên tập một cuốn sách giáo khoa Phật học để giúp người chưa biết Phật học đi vào Phật giáo một cách dễ dàng. Tác phẩm này hiện đã bị thất lạc. Theo: VN PGSL q. 2 của Nguyễn Lang.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Niêm Tụng Tập", "definition": "禪 門 拈 頌 集. Sách, 30 quyển, do Huệ Trạm và Chân Huấn (2 vị tăng Cao Ly) biên. Tác giả sưu tập cơ duyên ngữ cú của các thiền sư trong các Truyền Đăng Lục, Ngữ Lục kể từ Sơ tổ Đạt Ma đến Thiền Sư Giới Kham ở chùa Dục Vương đời Tống. Tổng cộng gồm 1125 tắc, phụ thêm các phần: Chư gia niêm cổ, Tụng cổ, Phổ thuyết, Tiểu tham.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Quy Thức", "definition": "禪 門 規 式. X. Bách Trượng Thanh Quy.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Sư Tư Thừa Tập Đồ", "definition": "禪 門 師 資 承 襲 圖. Còn gọi: Tập Thể Thập Di Vấn. Sách, 1 quyển, do Khuê Phong Tông Mật soạn vào đời Đường. Tựa đề bên trong là “Trung Hoa Truyền Tâm Địa Thiền Môn Sư Tư Thừa Tập Đồ, Nội Cung Phụng Sa Môn Tông Mật Đáp Bùi Tướng Quốc Vấn”, được xếp vào Tục Tạng Kinh tập 110, trang 866. Sách này là Tông Mật đáp những câu hỏi của Tể tướng Bùi Hưu về lịch trình thay đổi và phát triển các tông phái Thiền Tông vào thời kỳ đầu, và tính cạn sâu được mất của ngôn giáo. Nội dung chủ yếu có 3 phần:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Thập Di Lục", "definition": "禪 門 拾 遺 錄. X. Tuyết Đường Thập Di Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Toát Yếu", "definition": "禪 門 撮 要. Sách, 2 quyển, do Thể Tịnh (vị tăng Triều Tiên) biên, được ấn hành vào niên hiệu Long Hy thứ 1 (1907) ở chùa Vân Môn, núi Hổ Cứ, Triều Tiên. Nội dung bao gồm 15 loại trứ thuật về Thiền Tông Trung Quốc và Triều Tiên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Môn Đoạn Luyện Thuyết", "definition": "禪 門 鍛 煉 說. Còn gọi: Thiền Lâm Đoạn Luyện Thuyết, Đoạn Luyện Thuyết Thập Tam Thiên. Sách, 1 quyển, do Hối Sơn Thành Hiển soạn vào đời Minh, được ấn hành vào niên hiệu Đồng Trị thứ 11 (1872), sau đó được xếp vào Tục Tạng Kinh tập 112, trang 985. Tác giả cho rằng rèn luyện thiền tăng cần phải giống như Tôn Võ dụng binh, nên ở trong sách này nêu ra cách rèn luyện thiền tăng gồm 13 bước theo thứ tự 13 thiên như sau: Kiên thệ nhẫn khổ, Biện khí thọ thoại, Nhập thất sưu quát, Lạc đường khai đạo, Thùy thủ đoạn luyện, Cơ quyền sách phát, Ký xảo hồi hoán, Trảm quan khai nhãn, Nghiên cứu cương tông, Tinh nghiêm tháo lý, Ma trị học nghiệp, Giản luyện tài năng, Cẩn nghiêm phó thọ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Mông Cầu", "definition": "(禪蒙求, Zenmōkyū): xem Thiền Uyển Mông Cầu (禪苑蒙求, Zennenmōkyū) (禪苑蒙求, Zennenmōkyū): còn gọi là Thiền Uyển Dao Lâm (禪苑瑤林, Zennenyōrin), Thiền Mông Cầu (禪蒙求, Zenmōkyū), 3 quyển, do Thác Am Chí Minh (錯庵志明) nhà Tống soạn, Tuyết Đường Đức Gián (雪堂德諫) nhà Nguyên chú, Vương Khê (王溪) san hành vào năm thứ 3 (1255) niên hiệu Bảo Hựu (寳祐) nhà Nam Tống. Thác Am Chí Minh, người xuất thân từ Tung Sơn Thiếu Lâm Tự (嵩山少林寺) ở Hà Nam (河南), bắt chước bộ Mông Cầu (蒙求) của Lý Cán (李澣) nhà Đường, biên thuật thành tác phẩm này để cho hàng sơ tâm cầu học biết rõ hành trạng của chư Phật tổ trong vườn Thiền, làm tư lương để soi sáng tâm mình và tìm thấy đạo. Với hình thức đối ngẫu vận ngữ, hai câu 5-6, tổng số chữ là 2.248, từ đức Thế Tôn cho đến Thủ Sơn Tỉnh Niệm (守山省念), Đại Huệ Tông Cảo (大慧宗杲), Giác Phạm Huệ Hồng (覺範慧洪), v.v., mỗi hành trạng của mỗi vị đều có 2 câu thêm vào, đây là sách giáo huấn hữu ích cho Thiền môn. Vào năm thứ 3 niên hiệu Bảo Hựu, khi Vương Khê có ý định san hành bộ này, Tuyết Đường Đức Gián (雪堂德諫)―đệ tử của Vạn Tùng Hành Tú (萬松行秀)―viết lời chú giải tường tận về tác phẩm này và giao cho Vương Khê; nhân đó, Vương Khê kết hợp luôn cả phần chú giải này và cho san hành. Tại Nhật Bản, cũng có san hành bộ này vào năm thứ 16 (1639) và 17 (1640) niên hiệu Khoan Vĩnh (寬永)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Mặc Chiếu", "definition": "(黙照禪): đương thời có từ gọi là Mặc Chiếu Tà Sư (黙照邪師) hay Mặc Chiếu Tà Thiền (黙照邪禪) mà Đại Huệ Tông Cảo (大慧宗杲) dùng để phê phán khuynh hướng đang hiện hành trong Thiền Tông. Đây chính là ngôn từ nhằm phê phán những người không nhắm mục đích giác ngộ mà chỉ chuyên im lặng ngồi Thiền, và vì trước tác của Hoằng Trí Chánh Giác (宏智正覺), tức cuốn Mặc Chiếu Minh (黙照銘), nên đối tượng phê phán của Đại Huệ hẳn nhiên là những người thuộc Phái Hoằng Trí. Tuy nhiên, giữa Đại Huệ và Hoằng Trí vốn có mối thâm giao, cho nên đối tượng phê phán không phải là trực tiếp Hoằng Trí mà là các huynh đệ đệ tử của ông như nhóm Chơn Hiết Thanh Liễu (眞歇清了). Có điều dầu sao đi nữa, sự phê phán này rõ ràng là tiền đề nói lên sự khác nhau giữa Thiền phong của Lâm Tế và Tào Động. Vẫn có ít nhiều dị luận, song chúng ta cũng khó phủ định được rằng chính Thiền của Đạo Nguyên (道元) bên Nhật Bản vốn chủ trương \"chỉ quản đả tọa\" (只管打坐, Shikantaza) đã nối tiếp hệ thống của Thiền Mặc Chiếu này. Nếu từ ý nghĩa ấy mà xét, chúng ta có thể nói rằng đó là nguyên nhân vì sao Đạo Nguyên đã phê phán kịch liệt Đại Huệ", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Na", "definition": "Meditation, Zenjō (J), Zenna (J), Dhyāna (S), Jhāna (P), Ch'an na (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Na Phật", "definition": "Jina (S), Dhyāna Buddha (S), Conqueror.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Nguyên Chư Thuyên Tập Đô Tự", "definition": "(禪源諸詮集都序, Zengenshosenshūtojo): 2 quyển, trước tác của Khuê Phong Tông Mật (圭峰宗密) nhà Đường, được san hành vào năm thứ 7 (1062) niên hiệu Gia Hựu (嘉祐) nhà Tống, là tác phẩm thâu tập các yếu ngữ, kệ tụng có liên quan đến huyền nghĩa của Thiền môn từ các trước thuật của chư vị trong hệ thống Thiền Tông, lấy tên là Thiền Nguyên Chư Thuyên Tập (禪源諸詮集), xem đây như là kho tàng của Thiền với ý nghĩa “Đô Tự (都序)”. Nó còn có tên gọi khác là Thiền Na Lý Hành Chư Thuyên Tập (禪那理行諸詮集), có nghĩa là tập giải thích kỹ lưỡng đạo lý căn nguyên của Thiền. Nói tóm lại, nó luận rõ bản nguyên của Thiền là bản giác chơn tánh của tất cả chúng sanh, chứng được bản nguyên ấy gọi là Tuệ, tu tập bản nguyên ấy gọi là Định và trải qua quá trình lý của Thiền, hành của Thiền và thể của Thiền. Hơn nữa, Thiền có 5 loại: Ngoại Đạo Thiền (外道禪), Phàm Phu Thiền (凡夫禪), Tiểu Thừa Thiền (小乘禪), Đại Thừa Thiền (大乘禪), và Tối Thượng Thừa Thiền (最上乘禪). Về Tối Thượng Thừa Thiền, tác phẩm này giải thích rằng: “Tối Thượng Thừa Thiền diệc danh Như Lai Thanh Tịnh Thiền, diệc danh Nhất Hành Tam Muội, diệc danh Chơn Như Tam Muội, thử thị nhất thiết tam muội căn bản, nhược năng niệm niệm tu tập, tự nhiên tiệm đắc bách thiên tam muội, Đạt Ma môn hạ triển chuyển tương truyền giả, thị thử Thiền dã (最上乘禪亦名如來清淨禪、亦名一行三昧、亦名眞如三昧、此是一切三昧根本、若能念念修習、自然漸得百千三昧、達磨門下展轉相傳者、是此禪也, Tối Thượng Thừa Thiền còn có tên gọi khác là Như Lai Thanh Tịnh Thiền, cũng có tên là Nhất Hành Tam Muội, lại có tên là Chơn Như Tam Muội; đây là căn bản của tất cả tam muội, nếu có thể mỗi niệm tu tập nó, tự nhiên dần dần đạt được trăm ngàn tam muội; pháp môn mà môn hạ của Đạt Ma thay nhau truyền thừa chính là Thiền này)”. Đối với Thiền, Khuê Phong thuộc môn hạ của Hà Trạch Tông (荷澤宗) và từng kế thừa dòng pháp của Toại Châu Đạo Viên (遂州道圓); nhưng đồng thời đối với Hoa Nghiêm Tông (華嚴宗), ông lại kế thừa Thanh Lương Trừng Quán (清涼澄觀) và trở thành vị tổ thứ 5; cho nên ông là nhân vật dung hợp cả Giáo và Thiền. Do đó, trong tác phẩm này ông đã tạo sự điều hòa cuộc đấu tranh giữa các nhà Giáo gia cũng như Thiền gia, làm sáng tỏ cả Giáo và Thiền đều có 2 phương diện đốn tiệm như nhau và phải nói rằng ông là luận giả hệ thống hóa nhất trí tư tưởng Thiền và Giáo. Theo bản Trùng Khắc Thiền Nguyên Thuyên Tự (重刻禪源詮序) của Cổ Nhữ Chu (賈汝舟) với tên gọi Minh Tàng Bản (明藏本), chúng ta biết có bản ấn tạo vào năm thứ 8 (tức năm thứ 7 [1062] niên hiệu Gia Hựu [嘉祐]) niên hiệu Thanh Ninh (清寧). Ngoài ra, còn có bản năm thứ 7 (1303) niên hiệu Đại Đức (大德), Phúc Tống Bản (覆宋版) do Triều Tiên khai bản vào năm thứ 4 (1576) niên hiệu Vạn Lịch (萬曆), v.v. Tại Nhật Bản, cũng có san hành bộ này vào năm thứ 3 (1358) niên hiệu Diên Văn (延文) và năm thứ 11 (1698) niên hiệu Nguyên Lộc (玄祿). Sách chú thích có Thiền Nguyên Tập Đô Tự Trước Bính (禪源集都序着柄) của Hối Am Đại Sư Định Tuệ (晦庵大師定慧) người Triều Tiên, Thiền Nguyên Chư Thuyên Tập Đô Tự Khoa Mục Tinh Nhập Tư Ký (禪源諸詮集都序科目幷入私記) của Liên Đàm Hữu Nhất (蓮潭有一), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Nguyên Chư Thuyên Tập Đô Tự quyển thượng, phần 1 (Đại 48, 399 hạ) nói: “Đáy nước đầm trong, bóng hiện rõ ràng, đâu có như hạng si thiền chỉ chấp giữ sự yên lặng rỗng không, như kẻ cuồng tuệ chỉ biết tìm chương trích cú?”.", "definition": "II.Si Thiền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thiền Nguyệt Tập", "definition": "禪 月 集. Thi ca biệt tập, 30 quyển, có riêng một quyển bổ di, do Quán Hưu soạn vào đời Đường, đệ tử của sư là Đàm Vực biên chép thơ văn của sư mà thành, được xếp vào “Tứ Khố Toàn Thư”. Trong 30 quyển nguyên bản, 5 quyển văn tập đã mất, chỉ còn 25 quyển thi tập. Đến đời Minh, Mao Tấn làm một quyển bổ di. Trong ấy có: Nhạc phủ cổ tụng tạp ngôn, Cổ phong tạp ngôn, Luật thi, Tuyệt cú… được gom chung vào trăm bài thơ của Quán Hưu. Tuy ca ngâm trăng gió, nhưng lời lẽ trong sáng đẹp đẽ, xuất phát từ chỗ thật ngộ nên rất có thiền vị.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Nguyệt Đại Sư", "definition": "禪 月 大 師. Hiệu của Thiền tăng Quán Hưu đời Ngũ Đại do Thục chủ Vương Kiến ban cho. X. Quán Hưu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Nham", "definition": "禪 岩 (1093-1163). Thiền tăng đời Lý, thuộc dòng Tỳ Ni Đa Lưu Chi, đời thứ 13, nối pháp Thiền Sư Đạo Pháp. Sư họ Khương tên Thông, gia thế đời đời làm Tăng quan, tinh thần quắc thước, tiếng nói trong thanh. Triều đình mở khoa thi về các kinh điển Đại Thừa: Pháp Hoa, Bát Nhã, sư đỗ Giáp khoa (thủ khoa). Về sau sư được một lời ấn chứng của Thiền Sư Pháp Y chùa Thành Đạo, nên nhân đó xuất gia luôn và nối pháp Ngài. Ban đầu sư trụ trì chùa Thiên Phúc trong núi Tiên Du, giới hạnh tinh nghiêm, tâm đạo rộng lớn. Đói thì ăn lá cây, khát thì uống nước suối, suốt 6 năm trường như vậy. Sau, sư trở về quê trùng tu ngôi chùa Trí Quả làng Cổ Châu, Long Biên và trụ trì nơi đây. Khoảng niên hiệu Thiên Thuận (1128-1132), triều đình gởi chiếu vời sư về kinh đô cầu mưa. Bởi có linh nghiệm nên vua Lý Thần Tông trọng sư vào hàng danh tăng và ban cho thượng phục. Năm Chính Long Bảo ứng thứ 1 (1163), khoảng giữa mùa xuân, lúc ban ngày, sư đốt hương từ biệt mọi người, ngồi an nhiên mà tịch, thọ 71 tuổi. Thời gian sau, thể xác của sư vẫn còn, thời nhân gọi sư là “Phật sống”. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Nhân", "definition": "禪 人. Lời gọi người tham thiền, tăng nhân Thiền Tông. Pháp Diễn Ngữ Lục q. thượng:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Nhạc Phủ", "definition": "禪 樂 府. Thi ca biệt tập, 1 quyển, do Vô Khả soạn vào đời Thanh, được ấn hành vào năm 1935. Nội dung gồm có 22 bài từ của tác giả đều ngầm chứa thiền cơ, khiến người tìm thấy được ý vị.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Nội Quán", "definition": "Vipassanā-bhāvana (S), Insight-meditation, Vipaśyana (S), lhak tong (T), Vipassana (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Phong", "definition": "(禪風): gia phong hay phương pháp đặc biệt để cử xướng Thiền, thường chỉ về người hay tông phái, còn gọi là gia phong, tông phong, môn phong.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Phòng", "definition": "Phòng ngồi thiền. Trong các Thiền viện, thường bố trí phòng ngồi thiền có bàn thờ Phật và các tọa cụ (nệm gối, khăn trải).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Phòng Tự Tháp", "definition": "禪 房 寺 塔. Tháp nằm trên đỉnh ngọn Trượng Nhân, núi Thất Phong, cách thành phố Đại Đồng, tỉnh Sơn Tây, Trung Quốc 35km về phía tây nam, bởi phía bắc dưới núi có một ngôi Thiền Phòng Tự nên gọi là “Thiền Phòng Tự Tháp”. Được xây vào thời kỳ Liêu, Kim, cao 15m, 7 tầng, mặt bằng là hình bát giác. Tháp càng lên cao càng thu nhỏ là một tháp gạch đặc ruột hình dáng và cấu tạo vững vàng. Mặt tháp có đồ án hoa văn cửa sổ, Phật khám, Đại lực sĩ, điêu khắc tinh xảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Phường", "definition": "禪 坊. Thiền viện, thiền tự (chùa thiền). Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Quan", "definition": "Cửa thiền, cửa chùa. “Canh năm vừa đến thiền quan.” (Toàn Nhật – Hứa Sử Truyện Văn)", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Quan Sách Tiến", "definition": "禪 關 策 進. Sách, 1 quyển, do Vân Thê Châu Hoằng soạn vào đời Minh, được xếp vào “Vân Thê Pháp Vựng” và Đại Chính Tạng tập 48, trang 1097. Phần đầu trích yếu 39 pháp ngữ của chư Tổ như Hoàng Bá Hy Vận, Huyền Sa Sư Bị, Nga Hồ Đại Nghĩa,… Phần kế tóm lược 24 gương tu tập, gồm quá trình tu khổ hạnh và khai ngộ của các Thiền Sư như: Ngồi trên cây dựa mé hố, lấy dùi chích vào mình, thề không xổ mền, không lúc nào duyên ảnh khác, thân miệng đều quên, đụng đầu vào cột… Phần cuối là phần tóm lược các kinh dẫn chứng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Quán", "definition": "禪 觀. Tĩnh tâm tư duy, quán chiếu chân lý. Chương Chí công Hòa Thượng Thập tứ liệu tụng trong CĐTĐL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Quán A Di Đà", "definition": "Amitābha meditation.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Sinh", "definition": "Học trò theo học phép tu thiền. Thiền Sư Thầy dạy tu thiền.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Sàng", "definition": "(禪床): giường ngồi của tu sĩ, giường để ngồi Thiền, như trong bài thơ Tống Thiên Thai Tăng (送天台僧) của Giả Đảo (賈島, 779-843) nhà Đường có câu: “Hàn sơ tu tịnh thực, dạ lãng động Thiền sàng (寒蔬修淨食、夜浪動禪床, rau lạnh ăn lót dạ, sóng đêm động giường Thiền).” Hay như trong Thiền Tông Tụng Cổ Liên Châu Thông Tập (禪宗頌古聯珠通集, CBETA No. 1295) quyển 20 có đoạn kể vị thị giả hỏi Hòa Thượng Triệu Châu rằng: “Hòa Thượng kiến Đại Vương lai bất hạ Thiền sàng, kim nhật Tướng Quân lai, vi thậm ma khước hạ Thiền sàng. Sư viết: 'Phi nhữ sở tri, đệ nhất đẳng nhân lai, Thiền sàng thượng tiếp, trung đẳng nhân lai, hạ Thiền sàng tiếp, mạt đẳng nhân lai, Tam Môn ngoại tiếp' (和尚見大王來不下禪床、今日將軍來、爲甚麼卻下禪床、師曰、非汝所知、第一等人來、禪床上接、中等人來、下禪床接、末等人來、三門外接, Hòa Thượng thấy Đại Vương đến mà chẳng bước xuống giường Thiền, hôm nay Tướng Quân đến, vì sao Ngài lại bước xuống giường Thiền mà tiếp. Hòa Thượng bảo: 'Ngươi không hiểu đâu, người hạng nhất thì ta tiếp trên giường Thiền; người hạng trung thì ta bước xuống giường Thiền tiếp; người thuộc hạng cùng mạt thì ta ra tận ngoài cửa Tam Quan tiếp').”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Sư", "definition": "Dhyana master, Zen master, Dyayin (S), Jhayin (P), Butto Kokushi (J), Jakuhitsu Genko (J), Zenji (J), Son (K), Ch'an shi (C), Chanshī (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Sắc Giới", "definition": "Rūpa-jhāna (P), Rūpa-dhyāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Tam Muội", "definition": "Dhyāna meditation, sam ten (T), Dhyana-Samadhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Thiên", "definition": "Dhyāna Heaven (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Thuế", "definition": "蟬蜕. Xác của con ve, dùng làm vị thuốc Chỉ sự thay đổi, sự lột xác, sự giải thoát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiền Tháp", "definition": "禪 榻. Còn gọi: Thiền Sàng. Chiếc bục để tọa thiền, thấp và ngắn hơn chiếc giường. Bài thơ Thứ Vận Tăng Tiềm Kiến Tặng của Tô Đông Pha có câu:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Thất", "definition": "禪 室. 1. Chỗ tu hành tọa thiền. Bài “Đề Đạm Thủy Tự” của thiền Sư Huyền Quang (Việt Nam) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Trí", "definition": "Xem Thiền Huệ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Trượng", "definition": "禪杖. Cây gậy của nhà sư.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiền Tâm", "definition": "禪 心. Đạo pháp nhà thiền. Đạo Lượng Truyện trong TCTT q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông", "definition": "Tông Thiền: cũng gọi là tông Phật Tâm, hay tông Đạt Ma, là một trong 13 tông phái của Phật giáo Trung-quốc (xem mục “Tông Thiên Thai”). Thiền, nói đủ là “thiền na” (dhyana), người Hán dịch nghĩa là “tĩnh lự”. “Tĩnh” là tâm ý đạt được trạng thái tĩnh lặng; và “lự” là vận dụng trí tuệ để tư duy quán chiếu về một đối tượng. Tu thiền cũng đồng thời là tu định, cho nên trong Phật giáo đã có thuật ngữ “thiền định”. Thiền định là một trong ba pháp học trọng yếu và căn bản của Phật giáo (tức giới học, định học và tuệ học), nhưng nguyên thỉ, đó là truyền thống tư duy từng được thực hành trong các hệ phái triết học và tôn giáo từ thời cổ Ấn-độ. Tư tưởng về “mục đích tọa thiền để sinh lên các cõi trời” đã từng thịnh hành từ lâu trước khi đức Phật Thích Ca giáng thế. Khi đức Phật ra đời, Ngài đã chủ trương mục đích của thiền là xa lìa cả hai cực đoan khổ và vui, để đạt được trung đạo, tức cảnh giới niết bàn. Và chính Ngài đã triệt để tu tập thiền định mà đạt được đạo quả bồ đề vô thượng; rồi hàng vạn thánh chúng đệ tử của Ngài, cũng vì triệt để tu tập thiền định mà được giải thoát khỏi ba cõi, chứng nhập niết bàn. Ý nghĩa “hành thiền” nguyên thỉ là như vậy, nhưng trên tiến trình phát triển, dần dần kinh điển về thiền càng xuất hiện nhiều, và tùy theo mục đích tu tập của hành giả mà nhiều chi tiết về đối tượng của thiền định đã được thêm vào, từ đó mà phân chia có loại thiền tiểu thừa, có loại thiền đại thừa; có loại thiền hữu lậu, có loại thiền vô lậu; có loại thiền gọi là “Như Lai thiền”, có loại thiền gọi là “Tổ Sư thiền”; v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiền Tông Bản Hạnh", "definition": "禪 宗 本 行. Gọi đủ: An Tử Sơn Trúc Lâm Trần Triều Thiền Tông Bản Hạnh. Tập thơ nôm của Thiền Sư Chân Nguyên sống vào đời Hậu Lê (Việt Nam) viết. Nội dung kể sơ lược về lịch sử Thiền Tông từ Phật Thích Ca đến thời nhà Trần.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông Chính Mạch", "definition": "禪 宗 正 脉. Đăng Lục, 10 quyển, do Như Cần biên tập vào đời Minh, được xếp vào Tục Tạng Kinh tập 146, trang 1. Vì “Ngũ Đăng Hội Nguyên” quá bề bộn khó đọc nổi, cơ duyên cao vút như vách đứng muôn trượng, khiến cho bậc thượng căn phải líu lưỡi còn hàng hạ căn thì không có chỗ xoay xở, nên sư chọn lấy những chỗ đơn giản bình dị mà biên thành sách này, khiến cho mọi người đều có thể đọc hiểu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông Chỉ Nam", "definition": "Vua Trần Thái Tông để lại hai cuốn sách Phật. một: Khóa Hư Lục, hiện nay vẫn còn, được dịch ra tiếng Việt và xuất bản nhiều lần. Cuốn thứ hai: Thiền tông chỉ nam bị thất lạc. Chỉ còn giữ lại được bài tựa. Nội dung cuốn sách hướng dẫn các phép tu thiền.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Tông Quyết Nghi Tập", "definition": "禪 宗 決 疑 集. Sách, 1 quyển, do Đoạn Vân Trí Triệt soạn vào đời Nguyên, được ấn hành vào niên hiệu Khang Hy thứ 6 (1667) đời Thanh, sau đó được xếp vào Đại Chính Tạng tập 48, trang 1009. Tác giả đem sự thể nghiệm của chính mình để nói về công phu dụng tâm học đạo cùng với việc trình bày và giải thích phương pháp tu đạo thực tiễn, lấy việc tham cứu sâu huyền chỉ Phật đạo để hiển bày bản lai diện mục nơi mỗi người. Nội dung chia làm 21 môn: Nguyên trạm lưu thanh môn, Ly trần tinh tấn môn, Khước bộ phục thăng môn, Thối đọa sách lệ môn, Giải đải miễn cần môn, Chấp đại quyết nghi môn, Thất chính cứu cánh môn, Triệt để cùng uyên môn, Chỉ bản hoàn chân môn, Thuận tức miễn hoạn môn, Thượng căn lợi khí môn, Thiền lâm tĩnh lự môn, U cư chính phái môn, Kỳ Viên Thánh chúng môn, Giác ngộ huyền tông môn, Quy nguyên thật tế môn, Thể dụng song tu âm dực Vương hóa, Song lâm di giới chúng đẳng tuân y, Sám hối pháp môn Bồ Đề hạnh nguyện, ức tích xuất trần thừa huynh cảnh giới, Phục trưng giải đọa chỉ cảnh tức mê. Phần lớn trong văn bàn về việc của Triệu Châu Tùng Thẩm. Sau này các tác phẩm Thiền Quan Sách Tiến của Châu Hoằng, Giác Hổ Tập quyển hạ của Tế Năng, phần nhiều lấy sách này để làm căn cứ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông Trứ Thuật", "definition": "Tch'an-tsoung Tchou-chou (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Tông Trực Chỉ", "definition": "禪 宗 直 指. Sách, 1 quyển, do Thạch Thành Kim soạn vào đời Thanh, được xếp vào Tục Tạng Kinh tập 112, trang 972. Sách này là một phần trong 4 tập “Truyền Gia Bảo” do Thạch Thành Kim viết. Tựa bên trong là “Truyền Gia Bảo Thiền Tông Trực Chỉ”, dưới tựa có viết 12 chữ “Minh tâm kiến tính tu tri, thành Phật thành Tổ yếu pháp” (Pháp môn quan trọng để thành Phật thành Tổ, người muốn minh tâm kiến tính cần phải biết). Đầu tiên đem 46 mục mật truyền yếu pháp tham thiền, trình bày và phân tích tỉ mỉ cách thức hạ thủ công phu ngộ đạo. Tiếp theo đem 10 mục chỉ chung về mật truyền Phật pháp, giải thích một số câu của người đời chất vấn về Phật pháp.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông Tạp Độc Hải", "definition": "禪 宗 雜 毒 海. Còn gọi: Đại Huệ Thiền Sư Thiền Tông Tạp Độc Hải, Phổ Giác Tông Cảo Thiền Sư Ngữ Lục, Đại Huệ Phổ Giác Thiền Sư Ngữ Lục. Thi ca hợp tập, 2 quyển, do Pháp Hoằng và Đạo Khiêm biên, được ấn hành vào niên hiệu Thiệu Hưng thứ 1 (1131) đời Tống, sau đó được xếp vào Tục Tạng Kinh tập 121, trang 47. Tựa sách được lấy từ lời nói của Thiền Sư Đại Huệ “Tham thiền chẳng được, đều do tạp độc nhập tâm”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông Tụng Cổ Liên Châu Thông Tập", "definition": "禪 宗 頌 古 聯 珠 通 集. Sách, 40 quyển, do Pháp ứng biên vào đời Tống, Phổ ứng tục biên vào đời Nguyên, được xếp vào Tục Tạng Kinh tập 115, trang 1. Sách này sưu tập các tác phẩm về tụng cổ của Tổ sư Thiền Tông. Nội dung bao gồm 24 tắc cơ duyên của Thế Tôn, 30 tắc cơ duyên của Bồ Tát, 62 bài kệ kinh Đại Thừa, 702 bài tắc cơ duyên của Tổ sư. Mỗi khi có thêm vào đều có để 2 chữ “Tục Thu”, nhằm phân biệt với nguyên tập.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tông Vô Môn Quan", "definition": "(禪宗無門關, Zenshūmumonkan): xem Vô Môn Quan (無門關, Mumonkan) (無門關, Mumonkan): 1 quyển, tác phẩm do Vô Môn Huệ Khai (無門慧開) nhà Tống chỉ đạo cho đệ tử Tông Chiêu (宗紹) biên tập các ký lục tại Long Tường Tự (龍翔寺) vào năm 1228, và năm sau (năm thứ 2 niên hiệu Thiệu Định [紹定]) thì được san hành. Tên gọi chính thức của tác phẩm này là Thiền Tông Vô Môn Quan (禪宗無門關, Zenshūmumonkan). Nội dung của nó là những bài tụng cũng như bình xướng mà Huệ Khai thêm vào trong 48 tắc công án quan trọng từ xưa đến nay, cùng với Bích Nham Lục (碧巖錄, Hekiganroku), nó được xem như là tập công án đại biểu nhất. Tâm Địa Giác Tâm (心地覺心, 1207-1298), người đã từng sang nhà Tống cầu pháp, khi trở về nước có đem tác phẩm này về và đó là bản đầu tiên được đưa vào Nhật, từ đó về sau, nó được Lâm Tế Tông rất xem trọng, thỉnh thoảng có san hành phổ biến, đặc biệt đến thời Cận Đại nó được quan tâm đến nhiều nhất. So với Bích Nham Lục thì nội dung của nó ít, đơn giản, nhưng là lời trợ ngôn trực tiếp cho người tu tập. Bộ này nổi tiếng với tắc công án thứ nhất là \"Triệu Châu Vô Tự\" (趙州無字, chữ Không Có của Triệu Châu). Công án này do Triệu Châu Tùng Thẩm (趙州從諗) nhà Đường trả lời là “không có” khi được một vị tăng hỏi rằng con chó có Phật tánh hay không, và đã đem lại sự chuyển cơ rất lớn cho Thiền Công Án. Tuy nhiên, khi xem như là tập công án, thì thế giới phong phú về mặt văn học của Vô Môn Quan giống như trong Bích Nham Lục lại mất đi, chỉ còn lại ấn tượng nhiều vẻ khô khan, gầy gò mà thôi. Tại Trung Quốc không còn truyền bản nữa, nhưng ở Nhật có một số bản như Bản Ngũ Sơn của năm thứ 4 (1291) niên hiệu Chánh Ứng (正應) và năm thứ 12 (1405) niên hiệu Ứng Vĩnh (應永), bản chữ xưa của năm đầu (1624) niên hiệu Khoan Vĩnh (寬永), bản năm thứ 8 (1631) và 9 (1632) cùng niên hiệu trên, v.v. Dưới thời đại Giang Hộ (江戸, Edo, 1603-1867) nó cũng thỉnh thoảng được san hành. Vào thời Trung Đại, người ta vẫn chưa quan tâm gì mấy đến tác phẩm này; nhưng kể từ thời Giang Hộ trở đi, người ta bắt đầu nhận thức được giá trị của nó, cho nên khá nhiều sách chú thích xuất hiện như Thiền Tông Vô Môn Quan Tư Sao (禪宗無門關私鈔) của Quy Bá Huyền Phương (規伯玄方), Vô Môn Quan Sao (無門關鈔) của Vạn An Anh Chủng (萬安英種), Vô Môn Quan Sao (無門關鈔) Tây Bá (西伯) chú giải, Vô Môn Quan Xuân Tịch Sao (無門關春夕鈔), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Tông chủ trương ngôn ngữ văn tự không thể biểu đạt được pháp tự nội chứng của Phật, tức gọi là Phật Tâm. Chân lí do Đức Phật chứng ngộ như dấu ấn của thế gian quyết định không thay đổi, nên gọi Tâm Ấn. Không nương vào văn tự liền thấy được bản tính của mình, gọi là Truyền tâm ấn. [X. Hoàng Bá Truyền Tâm Pháp Yếu Q.thượng; Truyền Pháp Chính Tông Kí Q.2; Tổ Đình Sự Uyển Q.8].", "definition": "II.Tâm Ấn.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thiền Tập", "definition": "Xem Thành Tựu Pháp.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Tịch", "definition": "(禪席): chỗ ngồi để tham học Thiền, hành Thiền; từ đó chỉ chung cho nơi tham vấn Thiền, hay cũng là tên gọi khác của Thiền Viện (禪院). Như trong Ngũ Đăng Toàn Thư (五燈全書, 卍Tục Tạng Kinh Vol. 82, No. 1571) quyển 73, phần Nam Nhạc Hạ Tam Thập Ngũ Thế Tùy Lục (南嶽下三十五世隨錄), Quảng Nhuận Cự Linh Tự Dung Thiền Sư (廣潤巨靈自融禪師), có câu: “Nãi biến lịch chư Thiền tịch, hậu yết Sơn Ông Mân đắc pháp (乃遍歷諸禪席、後謁山翁忞得法, Thiền Sư bèn đi khắp các Thiền đường, sau tham yết Sơn Ông Đạo Mân và đắc pháp [của vị này]).” Hay trong Thiền Lâm Bảo Huấn Âm Nghĩa (禪林寶訓音義, 卍Tục Tạng Kinh Vol. 64, No. 1262) lại có đoạn: “Thị thời nội sứ Lý Doãn Ninh, tấu thí Biện trạch nhất khu, sáng lập Thiền tịch, tứ ngạch Thập Phương Tịnh Nhân Thiền Viện (是時內使李允寧、奏施汴宅一區、創立禪席、賜額十方淨因禪院, lúc bấy giờ nội sứ Lý Doãn Ninh, tâu lên nhà vua xin cho một khu nhà ở đất Biện, sáng lập nơi tu Thiền, ban cho biển ngạch là Thập Phương Tịnh Nhân Thiền Viện).” Hoặc trong Tân Tu Khoa Phần Lục Học Tăng Truyện (新修科分六學僧傳, 卍Tục Tạng Kinh Vol. 77, No. 1522) quyển 20, phần Đường Kiểu Nhiên (唐皎然), cũng có đoạn: “Trung niên biến phỏng Thiền tịch, Nam Năng Bắc Tú chi chỉ, giai sở tham khấu (中年遍訪禪席、南能北秀之指、皆所參扣, tuổi trung niên sư đi khắp các Thiền viện, yếu chỉ của Huệ Năng ở phương Nam và Thần Tú ở phương Bắc, đều đã từng tham học qua).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Tịch Chí", "definition": "禪 籍 志. Chí, 2 quyển, do Diệu Đế (vị tăng Nhật Bản soạn), được xếp vào “Đại Nhật Bản Phật Giáo Toàn Thư” ấn hành vào niên hiệu Đại Chính thứ 2 (1913). Sách này nêu ra 244 thứ sách vở Thiền Tông Trung Quốc và Nhật Bản, có giải thích sơ lược về tựa đề mỗi thứ. Nội dung chia ra: Đơn lục thiền yếu, Bả đoạn công án, Tông môn toàn sử, Tông môn lược sử, Tùng lâm lễ phạm, Thiền giáo tổng sử, Tông môn tùy bút, Thiền giáo tạp thuyết, Tông sư chú kinh v. v… Phần sau có phụ Thập di.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tịch Phú", "definition": "Bài phú Nôm của Hòa thượng Chân Nguyên, chùa Long Động (Yên Tử), ca ngợi nếp sống chùa chiền, vui vẻ thanh bạch. Bài phú có 72 câu, đối nhau được sư Thiền Phổ phiên âm và đăng trên báo Đuốc Tuệ năm 1936.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiền Tịnh", "definition": "Paṭisallāna (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiền Tủy", "definition": "禪 髓. 1. Phần tinh túy của Thiền. Chương Trần Nhân Tông trong Tam Tổ Thực Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tứ", "definition": "禪 肆. Còn gọi: Thiền Tự, Thiền Lâm. Tự viện Thiền Tông, Thiền viện. Chương Giáp Sơn Thiện Hội Thiền Sư trong CĐTĐL q. ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Tử", "definition": "(禪子): tên gọi khác của người tin Phật, tăng lữ, hay chỉ cho người hành Thiền. Như trong bài thơ Văn Chung (聞鐘) của tăng Kiểu Nhiên (皎然, ?-?) nhà Đường có câu: “Vĩnh dạ nhất Thiền tử, linh nhiên tâm cảnh trung (永夜一禪子、泠然心境中, suốt đêm một Thiền khách, an nhiên tâm cảnh trong).” Hay trong Ngốc Am Phổ Trang Thiền Sư Ngữ Lục (呆菴普莊禪師語錄, 卍 Tục Tạng Kinh Vol. 71, No. 1418) quyển 1, phần Vân Cư Ngữ Lục (雲居語錄), có đoạn: “Thiền tử lâm xuyên hóa đạo quy, nhập môn nhất tiếu triển song mi, phá vi trần xuất đại kinh quyển, đả cổ chùy chung báo chúng tri (禪子臨川化導歸、入門一笑展雙眉、破微塵出大經卷、打鼓椎鐘報眾知, Thiền giả đến sông hóa đạo về, mỉm cười vào cửa dương hàng mi, phá bụi trần tung bao kinh quyển, đánh trống rung chuông báo chúng hay).” Hoặc trong Liễu Am Thanh Dục Thiền Sư Ngữ Lục (了菴清欲禪師語錄, 卍Tục Tạng Kinh Vol. 71, No. 1414) quyển 7, bài Thứ Vận Tống Mãn Trấn Thành Khang Tứ Thượng Nhân (次韻送滿鎭成康四上人), lại có đoạn: “Thiền tử tâm như mãn nguyệt minh, định càn khôn cú hợp tướng trình, tam thiên lí ngoại thân huề thủ, cửu khúc Hoàng Hà triệt để thanh (禪子心如滿月明、定乾坤句合相呈、三千里外親攜手、九曲黃河徹底清, Thiền tăng tâm như trăng sáng tinh, định càn khôn câu hợp tướng trình, ba ngàn dặm ngoài cùng tay nắm, chín khúc Hoàng Hà tận đáy trong).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Tự", "definition": "Xem Thiền Viện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Uyển Dao Lâm", "definition": "(禪苑瑤林, Zennenyōrin): xem Thiền Uyển Mông Cầu (禪苑蒙求, Zennenmōkyū) còn gọi là Thiền Uyển Dao Lâm (禪苑瑤林, Zennenyōrin), Thiền Mông Cầu (禪蒙求, Zenmōkyū), 3 quyển, do Thác Am Chí Minh (錯庵志明) nhà Tống soạn, Tuyết Đường Đức Gián (雪堂德諫) nhà Nguyên chú, Vương Khê (王溪) san hành vào năm thứ 3 (1255) niên hiệu Bảo Hựu (寳祐) nhà Nam Tống. Thác Am Chí Minh, người xuất thân từ Tung Sơn Thiếu Lâm Tự (嵩山少林寺) ở Hà Nam (河南), bắt chước bộ Mông Cầu (蒙求) của Lý Cán (李澣) nhà Đường, biên thuật thành tác phẩm này để cho hàng sơ tâm cầu học biết rõ hành trạng của chư Phật tổ trong vườn Thiền, làm tư lương để soi sáng tâm mình và tìm thấy đạo. Với hình thức đối ngẫu vận ngữ, hai câu 5-6, tổng số chữ là 2.248, từ đức Thế Tôn cho đến Thủ Sơn Tỉnh Niệm (守山省念), Đại Huệ Tông Cảo (大慧宗杲), Giác Phạm Huệ Hồng (覺範慧洪), v.v., mỗi hành trạng của mỗi vị đều có 2 câu thêm vào, đây là sách giáo huấn hữu ích cho Thiền môn. Vào năm thứ 3 niên hiệu Bảo Hựu, khi Vương Khê có ý định san hành bộ này, Tuyết Đường Đức Gián (雪堂德諫)―đệ tử của Vạn Tùng Hành Tú (萬松行秀)―viết lời chú giải tường tận về tác phẩm này và giao cho Vương Khê; nhân đó, Vương Khê kết hợp luôn cả phần chú giải này và cho san hành. Tại Nhật Bản, cũng có san hành bộ này vào năm thứ 16 (1639) và 17 (1640) niên hiệu Khoan Vĩnh (寬永).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Uyển Mông Cầu", "definition": "(禪苑蒙求, Zennenmōkyū): còn gọi là Thiền Uyển Dao Lâm (禪苑瑤林, Zennenyōrin), Thiền Mông Cầu (禪蒙求, Zenmōkyū), 3 quyển, do Thác Am Chí Minh (錯庵志明) nhà Tống soạn, Tuyết Đường Đức Gián (雪堂德諫) nhà Nguyên chú, Vương Khê (王溪) san hành vào năm thứ 3 (1255) niên hiệu Bảo Hựu (寳祐) nhà Nam Tống. Thác Am Chí Minh, người xuất thân từ Tung Sơn Thiếu Lâm Tự (嵩山少林寺) ở Hà Nam (河南), bắt chước bộ Mông Cầu (蒙求) của Lý Cán (李澣) nhà Đường, biên thuật thành tác phẩm này để cho hàng sơ tâm cầu học biết rõ hành trạng của chư Phật tổ trong vườn Thiền, làm tư lương để soi sáng tâm mình và tìm thấy đạo. Với hình thức đối ngẫu vận ngữ, hai câu 5-6, tổng số chữ là 2.248, từ đức Thế Tôn cho đến Thủ Sơn Tỉnh Niệm (守山省念), Đại Huệ Tông Cảo (大慧宗杲), Giác Phạm Huệ Hồng (覺範慧洪), v.v., mỗi hành trạng của mỗi vị đều có 2 câu thêm vào, đây là sách giáo huấn hữu ích cho Thiền môn. Vào năm thứ 3 niên hiệu Bảo Hựu, khi Vương Khê có ý định san hành bộ này, Tuyết Đường Đức Gián (雪堂德諫)―đệ tử của Vạn Tùng Hành Tú (萬松行秀)―viết lời chú giải tường tận về tác phẩm này và giao cho Vương Khê; nhân đó, Vương Khê kết hợp luôn cả phần chú giải này và cho san hành. Tại Nhật Bản, cũng có san hành bộ này vào năm thứ 16 (1639) và 17 (1640) niên hiệu Khoan Vĩnh (寬永)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Uyển Mông Cầu Dao Lâm", "definition": "禪 苑 蒙 求 瑤 林. Còn gọi: Thiền Uyển Dao Lâm Chú, Thiền Uyển Dao Lâm, Thiền Uyển Mông Cầu, Thiền Lâm Mông Cầu, Thiền Mông Cầu. Sách, 3 quyển, cho Chí Minh soạn vào đời Kim, Đức Giản chú thích vào đời Nguyên, được xếp vào Tục Tạng Kinh tập 148, trang 189. Sư Chí Minh sưu tập hạnh nghiệp của các thiền sư làm thành sách tham khảo cho người sơ học biện đạo tu nghiệp. Sách này được làm theo thể văn vần, mỗi câu (mỗi tắc) 4 chữ, gồm 562 tắc, thu thập từ Phật Thích Ca Mâu Ni đến Thiền Sư Thủ Sơn Tỉnh Niệm đời Tống. Phần chú thích của sư Đức Giản chính là trưng dẫn ở các sách: Cảnh Đức Truyền Đăng Lục, Ngũ Đăng Hội Nguyên, Nhân Thiên Nhãn Mục rất là tường tận.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Uyển Mông Cầu Thập Di", "definition": "禪 苑 蒙 求 拾 遺. Sách, 1 quyển, không rõ tác giả, được xếp vào Tục Tạng Kinh tập 148, trang 288. Sách này được làm ra để bổ cứu cho quyển “Thiền Uyển Mông Cầu Dao Lâm”, dùng thể văn vần, mỗi câu 4 chữ, gồm 144 câu (tức 144 tắc), dưới mỗi tắc đều có chú thích, từ tắc “Thiếu Lâm xích tướng” đến tắc “Đại Quy niệm tụng”, trưng dẫn các sách Bích Nham Lục, Nhân Thiên Bảo Giám, Lâm Gian Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Uyển Thanh Qui quyển 3, thiên Duy Na (Vạn Tục 111, 446 thượng) nói: “Mỗi người làm 1 tấm thẻ nhập liêu, trên 1 mặt tấm thẻ ghi thứ tự tuổi hạ, gọi là Nhất diện”.", "definition": "II.Nhất Diện. Một phía.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thiền Uyển Thanh Quy", "definition": "(禪苑清規, Zennenshingi): 10 quyển, do Tông Trách (宗賾, ?-?) ở Trường Lô (長蘆) soạn, bản san hành đề năm thứ 2 (1103) niên hiệu Sùng Ninh (崇寧). Bách Trượng Hoài Hải (百丈懷海, 749-814) lần đầu tiên chế ra quy cũ Thiền môn qua bộ Bách Trượng Thanh Quy (百丈清規), nhưng bộ này bị tán thất và đến thời Huy Tông (徽宗, tại vị 1100-1125) nhà Tống thì không còn thấy bóng dáng nó nữa. Thấy vậy, Tông Trách rất cảm hoài, nên mới đi tìm lại những dấu vết về cách thức hành pháp vốn hiện tại đang còn hành trì tại các ngôi chùa xưa lúc bấy giờ, rồi ông biên tập lại thành bản quy định về quy cũ Thiền môn. Vì bản này được hình thành vào năm thứ 2 niên hiệu Sùng Ninh nhà Tống, nên còn được gọi là Sùng Ninh Thanh Quy (崇寧清規). Trong các bản Thanh Quy hiện tồn thì đây được xem như là bản xưa nhất, có thể giúp chúng ta hồi tưởng lại những quy cũ ngày xưa thời Bách Trượng như thế nào, và trở thành bản chuẩn cứ cho các bản Thanh Quy sau này ra đời. Bản này giải thích rất rõ từng chi tiết về hành vi của vị Thiền tăng, các chức vụ, cũng như tác pháp oai nghi tế hạnh hằng ngày. Trong đó còn có những đoạn văn như Quy Kính Văn (龜敬文), Tọa Thiền Nghi (坐禪儀), Tự Cảnh Văn (自警文), v.v. Vào năm thứ 2 (1202) niên hiệu Gia Thái (嘉泰), Ngu Tường (虞翔) cho tái san hành; đến năm thứ 2 (1254) niên hiệu Bảo Hựu (寶祐), Bản Cao Lệ (高麗本, Triều Tiên) bắt đầu xuất hiện. Tại Nhật Bản, có Bản Ngũ Sơn (五山本) được san hành dưới thời Nam Bắc Triều (1336-1392), bản ghi năm thứ 6 (1709) niên hiệu Bảo Vĩnh (寶永), bản ghi năm thứ 8 (1796) niên hiệu Khoan Chính (寛政); và tả bản của Kim Trạch Văn Khố (金澤文庫, Kanazawa-bunko) thuộc giữa thời Liêm Thương (鎌倉, Kamakura, 1185-1333)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Uyển Tập Anh", "definition": "禪苑集英. Tên một cuốn sách viết bằngchữ Hán chép sự tích các vị cao tăng ở nước ta, tác giả là người đời Trần, nhưng không rõ tên họ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiền Viện", "definition": "Zenke (J), Zen-en (J), Zen monastery, Zen temple.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Vô Sắc", "definition": "Arūpa-jñāna (S), Immaterial absorption.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Xương Tự", "definition": "(禪昌寺, Zenshō-ji): ngôi chùa của Phái Diệu Tâm Tự (妙心寺派) thuộc Lâm Tế Tông; hiệu núi là Long Trạch Sơn (龍澤山); hiện tọa lạc tại Gero-shi (下呂市), Gifu-ken (岐阜縣). Tượng thờ chính là Thích Ca Như Lai, Dược Sư Như Lai, Quan Thế Âm Bồ Tát. Huệ Tâm Tăng Đô Nguyên Tín (惠心僧都源信) là người khai sáng ra chùa. Đến khoảng niên hiệu Vĩnh Hòa (永和, 1375-1379), Trúc Xử Sùng Viên (竹處崇圓) là người khai sơn, lấy tên là Đại Hùng Sơn Viên Thông Tự (大雄山圓通寺). Sau đó, do vì gặp hỏa tai nên chùa trở thành hoang phế; nhưng đến năm 1716 thì Tam Mộc Trực Lại (三木直賴, Mitsuki Naoyori) mới cung thỉnh Minh Thục Khánh Tuấn (明叔慶俊) đến tái kiến lại chùa này, rồi đổi tên hiệu chùa và lưu truyền cho đến nay.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Y", "definition": "禪 衣. Y (áo) của thiền tăng. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Yếu", "definition": "禪 要. Yếu chỉ Thiền Tông. Tiết Đông Sơn Hòa Thượng trong TĐT q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Ông Đạo Giả", "definition": "禪 翁 道 者 (902-979). Thiền tăng đời cuối Ngô đầu Đinh, thuộc dòng Tỳ Ni Đa Lưu Chi đời thứ 11, nối pháp Đinh Trưởng Lão. Sư họ Lữ, quê làng Cổ Pháp (tức làng Đình Bảng, huyện Từ Sơn, tỉnh Hà Bắc hiện nay), tuổi nhỏ sư theo đời học nghiệp Nho, về sau mới theo Đinh Trưởng lão xuất gia. Sư trụ trì chùa Song Lâm làng Phù Ninh, phủ Thiên Đức. Niên hiệu Thái Bình thứ 10 (977) triều Đinh, nhằm năm Kỷ Mão, sư viên tịch, thọ 78 tuổi. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Đà Ca Vương", "definition": "Jñātaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Đăng Thế Phổ", "definition": "(禪燈世譜, Zentōsefu): 9 quyển, do Sơn Ông Đạo Mân (山翁道忞) nhà Minh biên tập, san hành vào năm thứ 3 (1654) niên hiệu Thừa Ứng (承應). Đây là bộ truyền đăng hệ phổ do Mộc Trần Đạo Mân (木陳道忞), pháp từ của Mật Vân Viên Ngộ (密雲圓悟), biên tập vào năm thứ 4 (1631) niên hiệu Sùng Trinh (崇貞). Ban đầu, Đạo Mân có ý muốn biên tập lịch sử truyền đăng kể từ thời nhà Nguyên trở về sau, nhưng các bài minh văn bia bị khuyết mất khá nhiều, định làm thế phổ để thay thế, nhân thỉnh thoảng ông đến Huyện Mân (閩, Tỉnh Phúc Kiến), bắt gặp cuốn thế phổ do Ngô Đồng (呉侗) biên soạn, nương vào các Truyền Đăng Lục để hiệu đính những đúng sai trong đó và hình thành nên bộ sách này. Nó làm sáng tỏ hệ phổ truyền đăng từ thời đức Thích Tôn cho đến 5 tông phái ở Trung Quốc và rất tiện lợi về thông tin mối quan hệ truyền thừa trong Thiền Tông. Tuy nhiên, do vì người ta nhận lầm Thiên Hoàng Đạo Ngộ (天皇道悟) thành Thiên Vương Đạo Ngộ (天王道悟) là pháp từ của Mã Tổ (馬祖), cho nên đã phạm phải sai lầm liệt chung cả 2 tông Vân Môn và Pháp Nhãn đều thuộc môn hạ của Nam Nhạc (南岳).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiền Đường", "definition": "Xem Viễn Công.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Đạo", "definition": "禪 道. Đạo pháp Thiền Tông. Pháp Diễn Ngữ Lục q. trung:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Đầu", "definition": "Xem Thiền Đậu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Đậu", "definition": "Jantu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Định", "definition": "Absorption, Meditation, Dhyāna (S), Jhānna (P), Jhānaṃ (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Định Ba La Mật", "definition": "Dhyāna-pāramitā (S), Dhyana Perfection.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Định Thập Chủng Lợi Ích", "definition": "禪定十種利益 (Nguyệt Đăng Tam Muội Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiền Định Và Trí Huệ", "definition": "Xem Thiền Huệ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Đồ", "definition": "禪 徒. Thiền sinh. Lục Tổ Lạc Đạo Ca ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiền Độ", "definition": "Xem Thiền Định Ba La Mật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiền Đức", "definition": "禪 德. Lời tôn xưng các vị thiền tăng. Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiều", "definition": "岧. Dáng núi cao. Cao ngất. Cũng nói: Thiều thiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiều Nhạc", "definition": "韶樂. Hai nhạc đời Nghiêu Thuấn Tiếng đàn sáo du dương. Truyện Nhị Độ Mai: “Mùi hương xạ ngát tiếng thiều nhạc rung”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiều Quang", "definition": "韶光. Ánh sáng đẹp. Chỉ ngày mùa xuân. Đoạn trường tân thanh: “Thiều quang chín chục đã ngoài sáu mươi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiểm", "definition": "Syamaca (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiểm Ma", "definition": "Xem Thiểm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiểm Ma Ca", "definition": "Xem Thiểm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiển", "definition": "刌. Dùng dao mà cắt ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiển Cận", "definition": "淺近. Nông cạn và gần, hẹp. Không sâu rộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiển Kiến", "definition": "淺見. Cái nhìn nông cạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiển Lậu", "definition": "淺陋. Nông cạn quê mùa. Tụng Tây hồ phú của Nguyễn Huy Lượng: “Tôi nay, Hổ mình thiển lậu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiển Thổ", "definition": "淺土. Đống đất thấp, chỉ nấm mồ vùi nông. Đoạn trường tân thanh: “Xin cho thiển thổ một đôi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiển Trí", "definition": "淺智. Sự hiểu biết nông cạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiểu", "definition": "悄. Lo nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiểu Dục", "definition": "Alpecha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiểu Dục Tri Túc", "definition": "Désirer peu, se rejouir d'un rien Content with few desires 少欲知足 alpeccha saṃtuṣṭa", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thiểu Não", "definition": "悄惱. Sầu khổ lo nghĩ. Đoạn trường tân thanh: “Kể đà thiểu não lòng người bấy nay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiểu Phùng Xuyên Nhĩ Khách", "definition": "少 逢 穿 耳 客. Xuyên nhĩ khách: Vị khách xỏ lỗ tai, chỉ cho Tổ Đạt Ma, là bậc đã kiến tính. Khó gặp được bậc kiến tính. Tiết Đức Sơn Chí Tiên Thiền Sư trong NĐHN q. 15 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiểu Quang Thiên", "definition": "Parinimmitavasavatti-deva (S), Parīttābha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiểu Số", "definition": "少數. Số ít.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiểu Thiện Căn", "definition": "Avaramatraka-kuśalamūla (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiểu Tịnh Thiên", "definition": "Parīttaśubha (P), Parittaśubhadeva (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệm", "definition": "栝. Củi đun bếp Xem Quát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiệm Ba", "definition": "Sona (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệm Bộ", "definition": "Xem Nam Thiệm Bộ Châu.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệm Bộ Châu", "definition": "Xem Diêm Phù Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệm Đàm", "definition": "蚦䗊. Dáng le lưỡi của thú vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện", "definition": "Kuśala (P), Wholesome.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện An Trụ Tháp", "definition": "Xem Thiện Kiến Lập Chi Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Biến Nhất Xứ Bồ Tát", "definition": "Xem Kim Cang Nghiệp Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Bản", "definition": "善 本. 1. Thiền tăng đời Ngũ Đại. Sư đến Hào Châu (nay là huyện Phụng Dương, tỉnh An Huy) Trung Quốc, tham vấn thiền sư Tư Minh và đắc pháp. Khi ra hoằng pháp, sư ở Thứu Lãnh, Tương Châu. Một hôm, sư đang tắm, có vị tăng hỏi: Hòa Thượng là người ly cấu (xa lìa nhiễm bẩn của trần lao phiền não) sao lại phải tắm? Sư đáp: Nước định trong veo đầy ắp, tắm gội người vô cấu này. 2. Thiền tăng đời Tống (1035-1109), họ Đổng, người Dĩnh Châu (Phụ Dương, An Huy) Trung Quốc. Sư nối pháp thiền sư Tông Bản ở chùa Huệ Lâm, thuộc tông Vân Môn đời thứ 7, trụ chùa Pháp Vân ở Đông Kinh. Hiệu: Đại Thông Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Chi", "definition": "Xem Đại Mãn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Chiêu", "definition": "善 昭 (947-1024). Thiền tăng đời Tống, họ Du, người Thái Nguyên (Sơn Tây) Trung Quốc. Thuở nhỏ sư thông minh trí huệ hơn người. Lúc 14 tuổi cha mẹ lần lượt qua đời, sư bèn cắt tóc thụ giới cụ túc. Du phương khắp nơi, từng tham phỏng 71 vị tôn túc thạc đức. Sư đến Thủ Sơn, Nhữ Châu (Lâm Nhĩ, Hà Nam) tham kiến Thiền Sư Tỉnh Niệm được đại ngộ, nối pháp làm truyền nhân tông Lâm Tế. Đến khi Tỉnh Niệm tịch, sư mới đáp ứng lời thỉnh của đạo tục Tây Hà, trụ trì Thái Tử Thiền Tự, Thái Bình Tự ở Phần Châu (Phần Dương, Sơn Tây) diễn nói tông yếu đem cơ dụng ba câu, bốn câu, ba quyết, 18 xướng v. v… tiếp dẫn kẻ học đạo, danh tiếng một thời. Ba mươi năm thuyết pháp không biết mỏi mệt, phong cách cao nhã, giới hạnh tinh nghiêm. Mọi người cung kính ngưỡng mộ không dám kêu tên mà chỉ gọi sư là “Thiền Sư Phần Châu”. Thụy là “Vô Đức Thiền Sư”. Tác phẩm: Phần Dương Vô Đức Thiền Sư Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Chí", "definition": "Xem Cấp Cô Độc.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Cát", "definition": "Xem Tu Bồ Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Căn", "definition": "Nghiệp lành của thân miệng ý, chắc chắn như rễ cây, không thể nhổ bật lên. Lại có thể lấy tính thiện làm gốc, chứa giữ tất cả hạt giống thiện, phát sinh tất cả mọi hành động thiện, nở hoa kết quả, như rễ cây vậy. Ví dụ, người có khả năng giữ giới không giết hại và bảo vệ sự sống, là chắc chắn đã có thiện căn từ đời trước; và nếu như đời này lại tiếp tục giữ giới hạnh, làm việc thiện cứu giúp chúng sinh, để bồi đắp nhân lành thâm sâu, khiến cho thiện căn càng thêm to lớn, thì phúc đức còn trải cả đời sau.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Căn Vị - Tứ Thiện Căn Vị", "definition": "Địa vị Thiện-căn. Từ “thiện căn” có nghĩa là gốc rễ phát sinh ra mọi pháp lành. Ba đức tính không tham, không sân, không si, gọi là “ba thiện căn”, được coi là thể tính của thiện căn. Trái lại, tham, sân, si là nguồn gốc của mọi tội ác, được gọi là “bất thiện căn”. Ở đây, Thiện-căn là địa vị thứ nhì trong quá trình tu tập của tiểu thừa, cao hơn địa vị Ba-hiền một cấp. Địa vị này gồm có 4 bậc (Noãn, đảnh, Nhẫn, và Thế-đệ-nhất), cho nên cũng được gọi là địa vị Bốn-thiện-căn. Tuy Ba-hiền là địa vị trung gian giữa phàm và thánh, nhưng phải cần bốn loại thiện căn để củng cố thêm, làm cho công hạnh vững chắc thêm, để chuẩn bị cho hành giả tiến vào địa vị Kiến-đạo – tức rời hẳn ranh giới phàm phu, bước vào dòng thánh. Bởi vậy, Bốn-thiện-căn cũng được gọi là Bốn-gia-hạnh (khác với địa vị Bốn-gia-hạnh của Bồ-tát thừa). Lại nữa, cũng như địa vị Ba-hiền, địa vị Bốn-thiện-căn vẫn còn trong vòng phàm phu, nhưng vì đã trừ bỏ được tâm trước tướng, không còn hướng ngoại tìm cầu chân lí, mà biết quay vào quán chiếu nội tâm, phát sinh trí giải tương tự với chánh lí, cho nên cũng còn được gọi là địa vị “Nội-phàm” (phàm phu hướng nội – đối lại với Ngoại-phàm). Bốn bậc của địa vị Thiện-căn là: - Noãn vị, - Đảnh vị, - Nhẫn vị, - Thế-đệ-nhất vị. Bốn loại thiện căn này, tuy còn thuộc trong vòng hữu lậu, nhưng lại có công năng phát sinh loại thiện vô lậu của bậc Kiến-đạo; cho nên chúng là gốc rễ của thiện pháp, và được gọi là “thiện-căn”. Vả lại, bốn thiện-căn này có công năng giúp cho ba bậc Hiền vững chắc thêm để tiến vào dòng thánh, cho nên, có thể gộp chung ba bậc Hiền và bốn bậc Thiện-căn, mà làm thành địa vị Bảy-phương-tiện, cũng gọi là Bảy-hiền, hay Bảy-gia-hạnh (xem mục “Địa Vị Bảy Phương Tiện”).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Dung", "definition": "Xem Bạc Câu La.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Duyên", "definition": "(善緣): duyên lành, duyên tốt. (01) Có duyên với Phật pháp. Như trong Pháp Uyển Châu Lâm (法苑珠林, Taishō Vol. 53, No. 2122) quyển 35 có câu: “Túc tạo chư thiện duyên, bách kiếp nhi bất hủ (宿造諸善緣、百劫而不朽, xưa tạo các duyên lành, trăm kiếp vẫn bất hủ).” Hay trong Thiền Lâm Sớ Ngữ Khảo Chứng (禪林疏語考證, 卍 Tục Tạng Kinh Vol. 63, No. 1252) quyển 1, phần Kết Chế (結制), lại có câu: “Nghiệp sơn phiên vi phước hải, ma chướng chuyển tác thiện duyên (業山翻爲福海、魔障轉作善緣, núi nghiệp biến thành biển phước, ma chướng chuyển làm duyên lành).” (02) Chỉ chung cho những nhân duyên tốt. Như trong tác phẩm Âu Bắc Thi Thoại (甌北詩話), phần Tra Sơ Bạch Thi (查初白詩), của Triệu Dực (趙翼, 1727-1814) nhà Thanh, có câu: “Yếm phùng tục khách đàm thi sự, nhàn dữ hương nhân kết thiện duyên (厭逢俗客談時事、閒與鄉人結善緣, chán gặp khách tục bàn thơ chuyện, nhàn với dân làng kết duyên lành).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiện Giác", "definition": "善 覺. Thiền tăng đời Đường. Sư thờ Mã Tổ Đạo Nhất và đắc pháp. Khi ra hoằng pháp ở chùa Hoa Lâm tại Đàm Châu (nay là huyện Trường Sa tỉnh Hồ Nam). Sư thường cầm tích trượng, ban đêm đi ra khỏi rừng dưới chân núi, cứ bảy bước dộng tích trượng một cái. Bùi Hưu hỏi sư rằng: “Sư làm sự nghiệp gì”. Đáp rằng: “Sơn tăng thường niệm Quán Âm”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Giác Vương", "definition": "Supra-Buddha (S), Suppabuddha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Giới", "definition": "Good realms.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Hiền", "definition": "Śubhadrā (S), Subhadda (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Hiện", "definition": "Là dịch ý từ tiếng Phạn “Subhuti”, tức tên của tôn giả Tu Bồ Đề, một trong mười vị đệ tử lớn của đức Phật. Tôn giả là con của một gia đình Bà-la-môn ở thành Xá-vệ. Ngài vốn là bậc có trí tuệ hơn người, nhưng tính tình nóng nảy, bị bạn bè chán ghét, bèn vào núi ở ẩn; rồi được sơn thần dẫn đường tìm đến chỗ Phật ngự. Ngài được Phật chỉ dạy cho biết cái hại của tâm nóng giận, nhân đó mà ăn năn sám hối tội lỗi, dốc lòng tu tập, và chứng quả A-la-hán. Vì vốn có trí tuệ lỗi lạc, tôn giả đã mau lẹ chứng ngộ lẽ Không, trở thành đương cơ của đức Phật trong các pháp hội Bát Nhã; được mọi người xưng tụng là bậc “giải không đệ nhất” trong giáo đoàn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Hiện Thiên", "definition": "Sudassadeva (P), Sudarśana (S), Sudassi (P), Sudassana (P), Sudassa (P), Sudṛsa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Hoan Hỷ", "definition": "Xem Bạt Nan Đà.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Huệ Bồ Tát", "definition": "Sujñāna (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Huệ Địa", "definition": "Sadhumati-bhūmi (S), Good-Thought stage.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Hóa Thiên Vương", "definition": "Sunirmita-devarāja (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Hội", "definition": "善 會. 1. Thiền tăng đời Đường, (805-881) họ Liệu, người Hiện Đình, Quảng Châu Trung Quốc. Năm 9 tuổi sư xuất gia nơi núi Long Nha, 20 tuổi thụ giới cụ túc. Chẳng bao lâu sư đến Giang Lăng (Hồ Bắc) chuyên nghiên cứu kinh luận. Về sau quay sang mộ thiền pháp, ban đầu trụ chùa Hạc Lâm ở Kinh Khẩu, Nhuận Châu (Trấn Giang, Giang Tô) cùng hỏi đáp với Đạo Ngô sư được sở đắc. Nghe lời khuyên của Đạo Ngô, sư đến tham kiến Thiền Sư Đức Thành, thầy trò khế hợp, ngay dưới lời ngộ nhập bèn nối pháp. Niên hiệu Hàm Thông thứ 11 (870) nơi Giáp Sơn, Lễ Châu (Đông Nam huyện Lễ, Hồ Nam) sư xây dựng viện Đại Đồng truyền bá thiền phong, thiền tăng khắp nơi tụ hội. Thụy là “Truyền Minh Đại Sư”. 2. Thiền tăng thời Bắc thuộc (?-900), thuộc dòng Vô Ngôn Thông, đời thứ 2, nối pháp Thiền Sư Cảm Thành. Sư quê ở Điển Lãnh Giao Chỉ. Thuở nhỏ sư theo thầy Tiệm Nguyên ở chùa Đông Lâm bản hương xuất gia, hiệu là Tổ Phong. Lớn lên sư tham học khắp nơi và gặp Thiền Sư Cảm Thành, phục vụ ngài trong 10 năm. Một hôm sư vào thất ngài thưa hỏi, bỗng nhiên tỉnh ngộ. Sau, sư trụ trì chùa Định Thiền làng Siêu Loại để truyền bá Tâm Tông. Niên hiệu Quang Hóa thứ 3 (900) đời Đường, sư tịch tại bản tự. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Hữu", "definition": "Xem Đạo Sư.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Hữu Thất Sự", "definition": "善友七事 (Lăng Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiện Kiên", "definition": "善 堅 (1409-1493). Thiền tăng đời Minh, họ Đinh, tự Cổ Đình, người Côn Minh (Vân Nam) Trung Quốc. Năm 10 tuổi xuất gia nơi chùa Ngũ Hoa, pháp danh Thiện Hiền, 19 tuổi y chỉ Thiền Sư Bách Nham đổi pháp danh là Thiện Kiên. Vào niên hiệu Chính Thống (1436-1449) yết kiến Thiền Sư Kim Lăng Vô Tế, đọc kinh Viên Giác đến chỗ “thân tâm như huyễn” hoát nhiên đại ngộ liền được ấn chứng làm truyền nhân tông Lâm Tế. Khoảng niên hiệu Thiên Thuận (1457-1464) trụ trì Phù Sơn, rồi trở về Vân Nam kiến thiết chùa Quy Hóa. Tác phẩm: Cổ Đình Tổ Sư Ngữ Lục Tập Lược 4 quyển, Vân Thủy Thạch Tập 4 quyển, Hoa Nghiêm Đại Ý 1 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Kiến", "definition": "Xem A Xà Thế.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Kiến Lập Chi Đề", "definition": "Suppatittha-cetiya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Kiến Thiên", "definition": "Sudṛsa (S), Sudassana (P), Sudassideva (P), Sudassi (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Kiến Vương", "definition": "Piyadasi (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Lai", "definition": "Susyagata (S), Svāgata (S), Sagata (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Lai Tỳ Kheo", "definition": "Ehi-bhikkhu", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiện Luật Nghi", "definition": "Xem Cấm Giới.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Lập Định Vương Tam Muội", "definition": "Xem Tam Muội Vương An Lập Tam Muội.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Mỹ", "definition": "善 美. Thiền tăng đời Tống, nối pháp Thiền Sư Nam An Thủ An. Sư ở Thứu Linh tại Tương Châu (nay là huyện Tương Phàn tỉnh Hồ Bắc).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Nam", "definition": "Xem Ưu Bà Tắc.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Nam Tử", "definition": "Kulaputri (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Nghiệp", "definition": "Kuśala kamma (P), Kuśala-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Nghệ", "definition": "善藝. Giỏi trong nghề của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện Nha", "definition": "Sudāna (S), (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Nhân", "definition": "善人. Người tốt, túc người lưong thiện. Đoạn trường tân thanh: “Con này chẳng phải thiện nhân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện Nhượng", "definition": "禪讓. Nhường mà đưa lại. Thường chỉ sự nhường ngôi vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện Nữ Nhân", "definition": "Kuladuhitra (S), Kuladhita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Pháp", "definition": "Kuśala-dharma (S), Kusala-dhamma (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Pháp Dục", "definition": "Kuśalo-dharma-cchanda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Pháp Phái", "definition": "Saddhammaikāya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Phục", "definition": "(善伏, Zempuku, ?-660): vị Thiền tăng sống dưới thời nhà Đường, người vùng Nghĩa Hưng (義興), Giang Tô (江蘇), họ Tương (蔣), thường gọi là Đẳng Chiếu (等照). Năm lên 5 tuổi, ông xuất gia ở An Quốc Tự (安國寺), mặc áo vải thô sơ, ăn uống bần cùng, hằng ngày tụng kinh. Vào năm thứ 3 (629) niên hiệu Trinh Quán (貞觀), ông đi du lịch khắp bốn phương, học pháp hành quán Tịnh Độ với Siêu Pháp Sư (超法師) của Thiên Thai Tông, đến các vùng Quế Châu (桂州), Quảng Châu (廣州), Tuần Châu (循州), v.v., sau cùng gặp Tứ Tổ Đạo Tín (道信), được vị này khai thị pháp môn phương tiện. Vào năm thứ 5 (660) niên hiệu Hiển Khánh (顯慶), ông trú ở Hành Nhạc (衡嶽), một hôm nọ bảo đại chúng rằng: “Nhất thiết vô thường, khí tức nan bảo, dạ thâm các tán, duyên tận thường ly (一切無常、氣息難保、夜深各散、緣盡常離, hết thảy vô thường, hơi thở khó toàn, đêm dày chia tan, duyên hết thường lìa)”. Ngay đêm ấy, ông ngồi xếp bằng ngay ngắn mà thị tịch.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiện Quyền", "definition": "擅權. Như Chuyên quyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện Quán Thiên", "definition": "Xem Tu Đới Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Quả", "definition": "善 果 (1079-1152). Thiền tăng đời Tống, họ Dư, hiệu Nguyệt Am, người Tín Châu (Thượng Nhiêu, Giang Tây) Trung Quốc. Sư nối pháp thiền sư Đạo Ninh, thuộc tông Lâm Tế thư 12, phái Dương Kỳ đời thứ 5, trụ chùa Thượng Phong ở Hành Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Sanh", "definition": "Singalaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Sanh Bồ Tát", "definition": "Xem Thi Ca La Việt Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Sanh Kinh", "definition": "Sujata Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Sinh", "definition": "Tên người thanh niên trong Kinh Thiện Sinh, nghe lời người cha dặn ngày nào cũng làm lễ sáu phương, sau được Phật giải thích lễ sáu phương là giữ gìn quan hệ gia đình và xã hội tốt đẹp: cụ thể là giữa cha mẹ và con cái, giữa vợ và chồng, giữa thầy và trò, giữa bạn bè với nhau, giữa chủ nhân và người phục vụ, giữa tăng sĩ và tín đồ (Trường A Hàm). Kinh tương đương trong Kinh tạng Pali là Giáo thọ thi ca la việt (Trường Bộ Kinh). Nội dung Kinh Thiện sinh cho thấy, đức Phật coi trọng quan hệ đạo đức tốt đẹp giưa người và người hơn là nghi lễ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiện Tai", "definition": "Sadhu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Thanh", "definition": "善 清 (1057-1142). Thiền tăng đời Tống, họ hà, hiệu Thảo Đường, người Nam Hùng, Quảng Đông, Trung Quốc. Sư nối pháp thiền sư Tổ Tâm, thuộc tông Lâm Tế đời thứ 10, phái Hoàng Long đời thứ 3, sư phụ giúp ngài Tổ Tâm trên 20 năm. Khi Thầy tịch, sư kế tiếp trụ trì Hoàng Long sơn. Niên hiệu Sùng Ninh thứ 4 (1105) sư từ Vân Nham đón sư huynh là Ngộ Tân về trụ trì Hoàng Long, còn sư trở về chùa Lặc Đàm ở bản quận. Nhờ học thức uyên bác, tiếp dẫn người học bằng cơ phong bén nhạy nên người đến học tấp nập như chợ, được suy tôn đứng đầu chư sơn. Tác phẩm: Thảo Đường Tập, Thiện Thanh Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Thanh Tịnh Bồ Tát", "definition": "Xem Kim Cang Pháp Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Thí", "definition": "Xem Tu đạt Đa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Thôi", "definition": "善 崔. Thiền tăng đời Đường, nối pháp Thiền Sư Lâm Tế Nghĩa Huyền. Sư trụ Định Châu (nay là huyện Định, tỉnh Hà Bắc) Trung Quốc, có thuyết nói sư trụ Trấn Châu (nay là huyện Chính Định, tỉnh Hà Bắc).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Thông", "definition": "善 通; C: shàntōng; J: zentsū; Thông đạt, tương giao mật thiết với nhau không ngăn ngại.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiện Thông Tự", "definition": "(善通寺, Zentsū-ji): ngôi chùa trung tâm Tổng Bản Sơn của Phái Thiện Thông Tự (善通寺派) thuộc Chơn Ngôn Tông, hiện tọa lạc tại 615 Zentsūji-chō (善通寺町), Zentsūji-shi (善通寺市), Kagawa-ken (香川縣), hiệu núi là Bình Phong Phố Ngũ Nhạc Sơn (屏風浦五岳山); tên gọi chính thức là Bình Phong Phố Ngũ Nhạc Sơn Đản Sanh Viện Thiện Thông Tự (屏風浦五岳山誕生院善通寺). Vốn là nơi linh địa chốn đản sanh của Hoằng Pháp Đại Sư, nên danh hiệu viện được đặt như vậy; còn tên chùa là Thiện Thông Tự. Tên chùa này vốn xuất phát từ tên của người cha Đại Sư là Tá Bá Thiện Thông (佐伯善通). Trong thời kỳ chiến tranh, nơi vùng đất đản sanh của Hoằng Pháp Đại Sư này lại rất nổi tiếng với doanh đô của quân lính; cho nên khi nghe tên Thiện Thông Tự, có nhiều người lại nghĩ đến tên của quân đội hay tên của nơi đóng quân hơn là tên chùa. Vào năm thứ 16 niên hiệu Chiêu Hòa (昭和, Shōwa), theo mệnh lệnh của quân đội, khi toàn thể Chơn Ngôn Tông hợp nhất lại thành một khối, Thiện Thông Tự này cũng đã từng trở thành Tổng Bản Sơn của toàn bộ Tông phái. Điều này cũng có liên quan đến nguồn gốc ra đời của Đại Sư vậy. Vào ngày 15 tháng 6 năm thứ 5 (774) niên hiệu Bảo Quy (寶龜), Hoằng Pháp Đại Sư Không Hải (空海, Kūkai) ra đời ở vùng đất này, là con của Tá Bá Thiện Thông. Sau đó, Đại Sư sang nhà đường cầu pháp, rồi sau khi trở về nước thì nhận được sắc chỉ của triều đình cho phép khai Tông lập giáo Chơn Ngôn Tông vào năm 807, lúc ấy phụ thân của Đại Sư mới lấy nhà của ông mà dâng cúng để làm nên ngôi chùa này. Đây là ngôi chùa tối cổ của Chơn Ngôn Tông và thậm chí còn xưa hơn cả Cao Dã Sơn (高野山, Kōyasan) nữa. Từ năm đầu (1229) niên hiệu Khoan Hỷ (寛喜) trở đi, chùa phụ thuộc vào Đông Tự (東寺, Tō-ji), có đầy đủ cả Kim Đường, Giảng Đường, Hộ Ma Đường và rất hưng thạnh; nhưng vào khoảng thời gian 1275-80 thì lại suy thối, và được Hậu Vũ Đa Thiên Hoàng (後宇多天皇, Gouda Tennō) phục hưng lại. Sau đó, vào năm 1340 thì chùa bị cháy rụi, và vị Tổ thời Trung Hưng của chùa là Hựu Phạm (宥範, Yūhan) đã bỏ hết 22 năm để trùng hưng lại ngôi chùa này. Việc này tương truyền là nhờ sự trợ lực của những nhân vật có quyền thế đương thời như Túc Lợi Tôn Thị (足利尊氏), Trực Nghĩa (直義) và Nghĩa Mãn (義滿), v.v. Tuy nhiên, các đường tháp cũng như già lam của chùa lại một lần nữa bị cháy tan tành do vụ binh loạn giữa hai dòng họ Tam Hảo (三好) và Hương Xuyên (香川) vào năm 1558. Các đường tháp hiện tại là do sự ngoại hộ của các vị lãnh chúa của vùng đất này qua nhiều đời. Ngoài các vị lãnh chúa ra thì lịch đại những vị Thiên Hoàng cũng rất sùng tín với chùa. Nơi Kim Đường của chùa tôn trí bức tượng Dược Sư Như Lai dạng ngồi. Nơi Ngự Ảnh Đường tương truyền là ngự điện của mẹ Đại Sư. Còn chánh điện của chùa thì cũng không lớn lắm, nhưng là kiến trúc điển hình của đầu thời kỳ Giang Hộ. Ngôi Ngũ Trùng Tháp tương truyền do Hoằng Pháp Đại Sư kiến lập nên, nhưng rồi lại bị hỏa tai nên cháy rụi và trải qua một thời gian khá lâu không phục hưng lại, mãi đến năm 1884, nhân lúc Húy Kỵ lần thứ 1050 năm của Đại Sư thì ngôi tháp này mới được làm lễ lạc thành", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiện Thú", "definition": "善 趣; C: shànqù; J: zenshu; Cõi giới lành. Tái sinh vào cảnh giới trong lành có được từ kết quả tích tập các thiện nghiệp trong đời trước (S: sugati-gati). Tái sinh làm người, hay chư thiên trong sáu đường (lục đạo 六 道 ). Ngược lại là tái sinh trong các đường dữ (ác đạo 惡 道 ). Một số truyền thống xem tái sinh làm a-tu-la là một trong các đường lành.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiện Thần", "definition": "(善神): tên gọi chung những vị hộ trì chánh pháp trong Tám Bộ chúng. Như trong Phật Thuyết Tạo Tháp Diên Mạng Công Đức Kinh (佛說造塔延命功德經, Taishō Vol. 19, No. 1026) có câu: “Bi mẫn cứu hộ nhất thiết chúng sanh, chư thiên thiện thần thường lai thủ hộ (悲愍救護一切眾生、諸天善神常來守護, thương xót cứu giúp hết thảy chúng sanh, chư thiên thiện thần thường đến bảo vệ).” Hay trong Thiên Địa Bát Dương Thần Chú Kinh (天地八陽神咒經, Taishō Vol. 85, No. 2897) cũng có đoạn: “Nhược văn thử kinh, tín thọ bất nghịch, tức đắc giải thoát chư tội chi nạn, xuất ư khổ hải, thiện thần gia hộ, vô chư chướng ngại, diên niên ích thọ (若聞此經、信受不逆、卽得解脫諸罪之難、出於苦海、善神加護、無諸障礙、延年益壽, nếu nghe kinh này, tin nhận không trái, tức được giải thoát ách nạn các tội, ra khỏi biển khổ, thiện thần gia hộ, không có chướng ngại, sống lâu thêm thọ).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiện Thệ", "definition": "Well-gone Sugata (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Thệ Tạng", "definition": "Sugatagarbha (S), der sheg nying po (T), Tathāgatagarbha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Thủ Bồ Tát", "definition": "Xem Hiền Hộ Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tinh", "definition": "Zensho (J), Shan hsing (J), Pradhanaśūra (S), Shan hsing (C), Zensho (J), Suna-kkhatta (P), Suna-ksatra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tinh Ly Xa Tử", "definition": "Sunakkhatta Licchaviputta (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tri", "definition": "Vibhāvana (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tri Thức", "definition": "Trong Phật giáo, những người chánh trực, có đức hạnh, có khả năng dạy dỗ, hướng dẫn người khác đi theo con đường chánh, bỏ ác làm lành, dứt trừ phiền não, phát triển trí tuệ, v.v... đều được gọi là “thiện tri thức”, hoặc “thiện hữu tri thức”; – ngược lại là “ác tri thức”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Trụ", "definition": "Supratisthita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tài Ngũ Thập Tam Tham", "definition": "善才五十三參 (Hoa Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thiện Tài Đồng Tử", "definition": "Sudhana-sresthi-daraka: là vị Bồ-tát đệ tử Phật, rất nổi tiếng với hành trình tham vấn 53 vị thiện tri thức để cầu đạo Bồ-tát, được ghi chép trong Kinh Hoa Nghiêm. Ngài là con một vị trưởng giả, khi vừa sinh ra đời thì mọi vật trân quí tự nhiên xuất hiện, cho nên được đặt tên là Thiện Tài. Sau ngài phát tâm đến tu học với đức Bồ Tát Văn Thù. Vâng lời dạy của đức Bồ Tát, ngài đi dần về phương Nam của nước Thiên-trúc, tham bái cả thảy 53 vị thiện tri thức, học đủ mọi pháp môn, cuối cùng đến đạo tràng của đức Bồ Tát Phổ Hiền thì thành tựu Phật đạo, chứng nhập pháp giới vô sinh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Tâm", "definition": "Kuśala citta (P), Suhada (S), Good-hearted.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tích", "definition": "Xem Tu Di.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tín", "definition": "(善信): niềm tin chí thành vào Phật pháp, hay chỉ cho người có niềm tin như vậy. Như trong Kim Cang Kinh Thạch Chú (金剛經石注, 卍Tục Tạng Kinh Vol. 25, No. 497) có đoạn: “Đản hữu thiện tín chi nhân, giai tri độc tụng Kim Cang tôn kinh, cập khấu kỳ nghĩa lý vân hà (但有善信之人、皆知讀誦金剛尊經、及叩其義理云何, chỉ có người có niềm tin chí thành, đều biết đọc tụng Kim Cang tôn kinh, và hỏi nghĩa lý kinh như thế nào).” Hay trong Phạm Võng Kinh Bồ Tát Giới Lược Sớ (梵網經菩薩戒略疏, 卍Tục Tạng Kinh Vol. 38, No. 695) quyển 6 lại có đoạn: “Cố tu thường sanh thiện tín, tín ngã cập chúng sanh, thị đương thành chi Phật, chư Phật thị dĩ thành chi Phật (故須常生善信、信我及眾生、是當成之佛、諸佛是已成之佛, vì vậy nên thường sanh niềm tin chí thành, tin ta và chúng sanh, là vị Phật sẽ thành, chư Phật là vị Phật đã thành).” Hoặc trong Thời Thời Háo Niệm Phật (時時好念佛, 卍Tục Tạng Kinh Vol. 62, No. 1200) cũng có câu: “Thiện tín kiến văn tâm hoan hỷ, ác nhân đỗ lí khởi phong ba (善信見聞心歡喜、惡人肚裏起風波, khéo tin thấy nghe tâm hoan hỷ, người ác trong ruột nỗi phong ba).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thiện Tú", "definition": "Xem Thiện Tinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Túc", "definition": "Upavasa (S), Upavasath-posadha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Túc Bồ Tát", "definition": "Madrajyotis (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Tĩnh", "definition": "善 靜 (858-946). Thiền tăng đời Ngũ Đại, họ Vương, người xứ Toàn Thành (nay là huyện Hưng Bình tỉnh Thiểm Tây) Trung Quốc. Thuở bé sư theo Nho học, thông suốt nhiều sách vở. Năm 27 tuổi, sư đến chùa Phong Đức trong núi Chung Nam lễ Thiền Sư Quảng Độ. Khoảng niên hiệu Thiên Phục (901-903), sư về Nam yết kiến Thiền Sư Lạc Phố Nguyên Tĩnh, được cử làm Tri viên. Sau đó sư trụ trì Vĩnh An Thiền Uyển ở Kinh Triệu, có đến 500 người theo học với sư. Thụy hiệu: Tịnh Ngộ Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Tạng", "definition": "善 藏. Thiền tăng đời Ngũ Đại. Sư đến núi Đại Quang, Đàm Châu (nay là huyện Trường Sa, tỉnh Hồ Nam) thờ Thiền Sư Cư Hối làm thầy, học đạo với ngài và đắc pháp, rồi trụ chùa Bạch Vân ở Lạc Dương.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Tịnh", "definition": "Good and Pure", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thiện Tịnh Cõi Giới", "definition": "Suvisudda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Vi", "definition": "善 爲. Hãy bảo trọng. Lưu tâm, chú ý trên đường đi. Lời dặn dò người đi đường. Tiết Động Sơn Hòa Thượng trong TĐT q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiện Vô Lậu Pháp", "definition": "Kuśalanāsravāḥ (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Vô Úy", "definition": "(Subhakara-simha, 637-735): là một trong những vị tổ sư của Mật Tông Trung-quốc, cùng với hai ngài Kim Cương Trí và Bất Không, được người đời xưng là “Khai-nguyên tam Đại-sĩ” (ba vị Bồ-tát thời Khai-nguyên). Ngài là người nước Ô-trà (Odra) ở Đông-Ấn (có người nói là Trung-Ấn), thuộc dòng Sát-đế-lị, vốn là hậu duệ của Cam Lộ Phạn vương (chú ruột của đức Thích Ca). Năm 13 tuổi ngài nối ngôi vua, nhân vì nội loạn, ngài đã nhường ngôi rồi đi xuất gia. Ngài đi về bờ biển phía Nam, gặp được ngài Thù Thắng Chiêu Đề, và ngộ được Pháp-hoa tam-muội. Sau đó ngài đi ngược lên Trung-Ấn, đến chùa Na-lan-đà, cầu học với ngài Đạt Ma Cúc Đa (Dharma-gupta), được trao truyền trọn vẹn pháp Tam-mật Du-già và thọ lễ a-xà-lê quán đảnh, trở thành vị đại học giả của Mật Giáo. Năm 716, ngài vâng mệnh sư phụ rời Thiên-trúc, đi xuyên qua vùng Trung-Á để đến Trường-an, được vua Đường Huyền-tông dùng trọng lễ tôn làm quốc sư, mời ở chùa Hưng-phước, rồi chùa Tây-minh. Năm 717 ngài vâng chiếu dịch kinh tại chùa Bồ-đề, và đã dịch được quyển Hư Không Tạng Bồ Tát Năng Mãn Chư Nguyện Tối Thắng Tâm Đà La Ni Cầu Văn Trì Pháp. Và từ đó ngài dốc lòng chuyên việc dịch kinh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Vô Úy Sa Môn", "definition": "Śubhakara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Vị", "definition": "禪位. Nhường ngôi (vua).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện Xạ", "definition": "善射. Bắn giỏi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiện Xảo", "definition": "Khéo léo, mang lại kết quả. Trong kinh Phật hay dùng câu “Phương tiện thiện xảo” để chỉ những biện pháp khôn khéo mà Phật và các đệ tử Phật dùng để giáo hóa chúng sinh, đưa chúng sinh vào con đường đạo.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thiện Xảo Phương Tiện", "definition": "Upāya-kuśala (S), Upāya-kuśala (P), Skillful means.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Ý", "definition": "Good Intention", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thiện Ý Bồ Tát", "definition": "Sumati (S), Dantamati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Đạo", "definition": "(613-681): là vị cao đồ của ngài Đạo Xước, và là tổ thứ ba tông Tịnh Độ (theo Phật Quang Đại Từ Điển), Trung-quốc. Ngài họ Châu, hiệu là Chung Nam đại sư, quê ở huyện Lâm-truy, tỉnh Sơn-đông (có thuyết nói là huyện Hu-di, tỉnh An-huy). Lúc nhỏ, ngài xuất gia với Minh Thắng pháp sư ở Mật-châu, chuyên trì tụng các kinh Pháp Hoa, Duy Ma, v.v... Về sau, nhân được đọc kinh Quán Vô Lượng Thọ, ngài liền tu tập 16 phép quán (quán mặt trời, quán nước, quán đất, quán cây báu, quán ao báu, v.v...). Năm 28 tuổi, ngài đến chùa Huyền-trung ở Tây-hà, yết kiến đại sư Đạo Xước, nghe giảng kinh Quán Vô Lượng Thọ; từ đó, dốc lòng chuyên tu pháp môn niệm Phật, chuyên cần tinh tấn, chứng được “niệm Phật tam muội”, ở trong định từng được trông thấy cảnh giới trang nghiêm của cõi Tịnh-độ. Về sau, ngài đến chùa Quang-minh ở Trường-an, truyền bá pháp môn Tịnh Độ cho bốn chúng đệ tử. Mỗi ngày ngài quì niệm Phật, đến khi nào kiệt sức mới nghỉ. Sau khi niệm Phật lại diễn giảng pháp môn Tịnh Độ và khuyến khích đại chúng niệm Phật. Ròng rã hơn 30 năm, ngài không ngủ ở một chỗ nhất định, không nhìn ngó phụ nữ, không nhận lễ bái của các chú sa-di, xa lánh danh lợi, không nhận cúng dường. Ngài viên tịch năm 681, thế thọ 69 tuổi. Có thuyết nói rằng, ở trước chùa Quang-minh có cây liễu, ngài đã leo lên cây và gieo mình xuống tự xả bỏ thân mạng. Trước tác của ngài có Quán Vô Lượng Thọ Phật Kinh Sớ, Tịnh Độ Pháp Sự Tán, Quán Niệm Pháp Môn, Vãng Sinh Lễ Tán Kệ, v.v...", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Đạo Leo Lên Ngọn Cây Gieo Mình", "definition": "Theo Phật Quang Đại Từ Điển, đại sư Thiện Đạo là vị tổ thứ ba của tông Tịnh Độ Trung-quốc. Nhưng theo các sách Phật Tổ Thống Kỉ, Tịnh Độ Thánh Hiền Lục, Liên Tông Thập Tam Tổ, đều nói ngài là tổ thứ hai của tông Tịnh Độ. Theo Phật Tổ Thống Kỉ (quyển 26) và Tịnh Độ Thánh Hiền Lục (quyển 2) ghi chép về giờ phút lâm chung của ngài Thiện Đạo: Bỗng một hôm, đại sư Thiện Đạo gọi mọi người bảo rằng: “Thân này thật đáng chán, tôi sắp trở về cố hương Tây-phương Cực-lạc đây!” Nói xong, ngài leo lên cây liễu ở trước chùa, hướng về phương Tây kì nguyện: “Xin đức Phật A Di Đà tiếp dẫn con. Xin chư vị Bồ-tát hộ niệm, giúp cho con không mất chánh niệm, được vãng sinh về thế giới Cực-lạc!” Kì nguyện vừa xong, ngài liền gieo mình xuống đất tự tuyệt. Vua Đường Cao-tông biết tin, vô cùng cảm kích, bèn ban tên cho ngôi chùa là Quang-minh. Về việc “gieo mình tự tuyệt” này của ngài Thiện Đạo, trong Tục Cao Tăng Truyện (quyển 27) cũng có nói tới.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thiện Đạo Tông", "definition": "Shan-tao School.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiện Đức Thiền Viện", "definition": "善 德 禪 院. ở làng Xã Đầu, huyện Chương Hóa, tỉnh Đài Loan, Trung Quốc. Năm 1935 do Pháp sư Diệu Tu sáng lập, từ đó qua nhiều năm lần lượt xây cất thêm. Sau khi Diệu Tu thị tịch, do đệ tử Pháp sư Đạt Cẩm kế nhiệm trụ trì. Năm 1957 mời Pháp sư Thánh ấn làm đạo sư thường xuyên giảng kinh hoằng pháp, tín đồ ngày càng tăng. Năm 1970 xây cất lại hậu điện.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệp", "definition": "涉. Lội qua dòng nước Bước qua. Trải qua Dính dáng vào chuyện gì. Td: Can thiệp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiệp Ly Vi", "definition": "涉 離 微. Liên quan đến thế đối lập giữa Ly (thể) và Vi (dụng), tức là chưa trừ hết vọng tâm phân biệt đối đãi. Tiết Tông Thừa Yếu Nghĩa trong Duy Tắc Ngữ Lục q. 9 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệp Mời", "definition": "Nimantakana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiệp Nê Thủy", "definition": "涉 泥 水. Dính bùn dính nuớc, dụ chỉ những vướng mắc liên quan đến ngôn từ nghĩa lý, làm chướng ngại việc đốn ngộ. Tiết Cổ Sơn An Vĩnh Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệp Thần Vẫn", "definition": "涉 㖘 吻. Còn gọi: Lạc thần vẫn, Quải thần vẫn. Liên quan tới lời lẽ giảng thuyết. Việc này chẳng phải phù hợp với tông chỉ: “Chẳng lập văn tự ngữ ngôn” của nhà Thiền. Tiết Kim Sơn Đàm Dĩnh Thiền Sư trong NĐHN q. 12 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệp Thế", "definition": "涉世. Trải đời. Từng trải.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiệp Tật", "definition": "Xem Dạ Xoa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệp Đạo Lý", "definition": "涉 道 理. Những gì có liên quan đến tri thức nghĩa lý. Đối với nhà thiền thì những thứ này không dính dáng đến thiền ngộ, hơn nữa còn chướng ngại cho thiền ngộ. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệt", "definition": "𢗗. Quen đi. Quen thuộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiệt Chiến", "definition": "舌戰. Đánh nhau bằng lưỡi, tức cãi cọ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiệt Căn", "definition": "Jihvendriya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệt Hại", "definition": "Hiṃsati (hiṃs + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thiệt Thức", "definition": "Jihvā-vijñāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệt Tướng", "definition": "Prabhūtatanu-jihvata (S), Pahuta-jihva (S), Prabhūta-jihvata (S), Prabhutatanu-jihvata (S), Pahuta-jihva (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệt Uẩn", "definition": "Jivha-viññāṇa (P), Tasting-consciousness.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệt Đầu Thượng Thủ Biện", "definition": "舌 頭 上 取 辯. Trên cái lưỡi mà phân biệt được, nghĩa là thông qua ngôn ngữ mà tham cứu thiền pháp. Tiết Vân Nham Hòa Thượng trong TĐT, q. 5 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu", "definition": "劭. Gắng sức Khuyên nhủ gắng sức Tốt đẹp Chỉ người già cả, có đức tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thiệu An", "definition": "紹 安. Thiền tăng đời Tống, nối pháp Quốc sư Đức Thiều ở núi Thiên Thai, thuộc tông Pháp Nhãn. Sư trụ chùa Báo Ân ở Hàng Châu. Có vị tăng hỏi: Thế nào là gia phong của Hòa Thượng?. Sư đáp: Tất cả chỗ sẵn sàng. Hiệu: Thông Biện Minh Đức Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Chân Thiền Sư", "definition": "紹 眞 禪 師. Thụy hiệu của Thiền tăng Pháp Đoan, sống vào đời Đường. X. Pháp Đoan.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Hiển", "definition": "紹 顯. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư Thanh Lương Văn Ích, thuộc tông Pháp Nhãn. Sư trụ viện Đồng An, núi Phụng Thê, Hồng Châu (nay là huyện Nam Xương tỉnh Giang Tây).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Khanh", "definition": "紹 卿. Thiền tăng đời Ngũ Đại, họ Trần, người xứ Tuyền Châu, Trung Quốc. Thuở bé ở chùa Linh Nham tập Kinh Luận, lớn lên yết kiến Thiền Sư Tuyết Phong Nghĩa Tồn. Sư đi trên núi, thấy lá khoai lay động, Tuyết Phong chỉ lá lay động để dạy sư, Thiệu Khanh nhờ đây có tỉnh ngộ. Ban đầu sư ở Long Khê, sau dời sang viện Long Thọ ở Chương Châu (nay là huyện Chương Phố, tỉnh Phúc Kiến). Hiệu: Hưng Pháp Đại Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Loan", "definition": "Shao-luan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệu Long", "definition": "紹 隆 (1077-1136). Thiền tăng đời Tống, họ Cổ người xứ Hàm Sơn, Hòa Châu (nay thuộc tỉnh An Huy) Trung Quốc. Năm lên 9, sư vào viện Phật Huệ, nghiên cứu tinh tường Luật tạng. Tham vấn các vị: Tịnh Chiếu Sùng Tín, Trạm Đường Văn Chuẩn, Tử Tâm Ngộ Tân. Sau đó, sư đến Giáp Sơn theo hầu Viên Ngộ Khắc Cần 20 năm và nối pháp ngài, thuộc tông Lâm Tế. Kệ ngộ đạo:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Long Thánh Chủng", "definition": "紹 隆 聖 種. Tiếp nối và làm rạng rỡ dòng giống của Thánh hiền. Quy Sơn Cảnh Sách của Thiền Sư Linh Hựu ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Long Đại Sư", "definition": "紹 隆 大 師. Thụy hiệu của Thiền tăng Hồng Tiến, sống vào đời Ngũ Đại. X. Hồng Tiến.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Minh", "definition": "Shōmyō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thiệu Nguyên", "definition": "邵 元 (1305-1385). Thiền tăng Nhật Bản, gọi đủ là Cổ Nguyên Thiệu Nguyên. Niên hiệu Thái Định thứ 4 (1327) sang nhà Nguyên (Trung Quốc) trụ tại chùa Thiếu Lâm núi Tung Sơn, nối pháp Thiền Sư Văn Tài, đời thứ 24 hệ Thanh Nguyên, đời thứ 8 tông Tào Động Nhật Bản. Niên hiệu Chí Chính thứ 7 (1347) sư trở về nước trụ các chùa Đại Thánh, Đẳng Trì, Đông Phúc.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Nham", "definition": "紹 岩 (899-971). Thiền tăng đời Ngũ Đại, họ Lưu, người xứ Ung Châu (nay là huyện Phượng Tường, tỉnh Thiểm Tây) Trung Quốc. Năm lên 7 tuổi, sư xuất gia nơi Thiền Sư Cao An. Đến 18 tuổi sư thụ giới cụ túc nơi Luật sư Hoài Huy, du phương tham vấn Thiền Sư Thanh Lương Văn Ích, nối pháp ngài thuộc tông Pháp Nhãn. Sư trụ chùa Chân Thân Bảo Tháp ở Hàng Châu, Ngô Việt Vương thỉnh sư khai pháp và ban hiệu “Liễu Không Đại Trí Thường Chiếu Thiền Sư”. Trước khi lâm chung, sư có bảo với đệ tử rằng: “Chư hành vô thường tức thường trụ tướng” (các hiện tượng vô thường tức tướng thường trụ).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Trân", "definition": "紹 珍. Thiền tăng đời Tống. Sư tham vấn Thiền Sư La Hán Hạnh Lâm và đắc ngộ, nối pháp Ngài thuộc tông Pháp Nhãn. Sư trụ viện Huệ Lực thuộc quận Lâm Giang (nay là huyện Thanh Giang, tỉnh Giang Tây). Một hôm, có vị tăng hỏi: Lúc gà vàng chưa gáy thì sao? Sư đáp: Là thời tiết gì? Lại hỏi: Sau khi gáy thì sao? Sư đáp: Lại chẳng biết thời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Tu", "definition": "紹 修. Thiền tăng đời Ngũ Đại, người xứ Mân, nối pháp Thiền Sư La Hán Quế Sâm. Sư ở núi Long Tế, Phủ Châu. Sư chẳng kêu gọi tụ tập đồ chúng, mà người học vẫn tìm đến. Sư học rộng giỏi văn chương. Tác phẩm: Quần Kinh Lược Yếu và hơn 60 bài kệ tụng truyền bá ở đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Tông", "definition": "紹 宗. Thiền tăng đời Ngũ Đại, người xứ Tô Châu, sư thờ Thiền Sư Trường Khánh Huệ Lăng làm thầy, theo học và đắc pháp nơi Ngài. Ban đầu sư cất am ở Nha Sơn, Kiền Châu trong 20 năm, đạo đức vang xa. Về sau sư ở chùa Khai Tiên, Lô sơn. Nam Đường Trung Chủ từng vào núi để yết kiến sư. Hiệu: Viên Trí Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Tư", "definition": "紹 孜. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư La Hán Đạo Nhàn, kế vị Trụ trì. Khi Mân Việt được bình định, sư đến Kim Lăng (nay là Nam Kinh) ra mắt Nam Đường Trung Chủ, tuyên dương thiền chỉ được vua ban thưởng, đãi ngộ. 邵 思 (990-1066). Thiền tăng đời Tống, họ lý, người Khúc giang, Quảng Đông, Trung Quốc. Sư nối pháp thiền sư Hiểu Thông ở Động Sơn, thuộc tông Vân Môn đời thứ 5, trụ trì thiền viện Định Huệ núi Tịnh Nguyên (tại Ông Nguyên, Quảng Đông). Người đời gọi là Tịnh Nguyên Tư Trưởng lão.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thiệu Viễn", "definition": "紹 遠. Thiền tăng đời Ngũ Đại. Sư đến chùa Thạch Môn ở Tương Châu (nay là huyện Tương Phàn, tỉnh Hồ Bắc) tham vấn Thiền Sư Huệ Triệt, nối pháp Ngài thuộc tông Tào Động. Lúc mới đến sư làm Điền đầu (quản lý ruộng nương). Sau sư kế vị Trụ trì.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoa", "definition": "嗦. Miệng mấp máy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoa Bóp", "definition": "Parimaddati (pari + mad + a), sambāhati (saṃ + bah + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoa Dầu", "definition": "Abbhañjati (abhi + añj + a), abbhañjana (trung), limpeti (lip + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoa Dầu Thơm", "definition": "Upavāseti (upa + vas + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoan", "definition": "湍. Nước chảy xiết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoi", "definition": "(Dệt). Vema (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thong Thả", "definition": "Mutti (nữ), seritā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoá", "definition": "毤. Chim rụng lông. Rụng lông. Rụng đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái", "definition": "退. Lùi lại phía sau Không nhận. Từ chối Cũng đọc Thối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Bộ", "definition": "退步. Bước lùi về phía sau Thụt lùi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Hóa", "definition": "退化. Thay đổi mà lùi với lúc trước. Thụt lùi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Hôn", "definition": "退婚. Từ chối việc cưới xin. Như từ hôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Khước", "definition": "退却. Từ chối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Pháp", "definition": "Parihana-dharman (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thoái Thác", "definition": "退託. Viện cớ để từ chối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Thực Kí Văn", "definition": "退食記文. Tên một cuốn sách viết bằng chữ Hán của Phạm Phú Thứ, danh sĩ đời Thiệu Trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Trào", "definition": "退潮. Nước ròng rút xuống Chỉ sự suy yếu dần đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Vị", "definition": "退位. Lui khỏi ngôi vua. Nhường ngôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoái Ông", "definition": "退 翁. 1. Hiệu của Thiền tăng Nhất Như đời Minh. X. Nhất Như. 2. Hiệu của Thiền tăng Hoằng Trữ đời Thanh. X. Hoằng Trữ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoán", "definition": "彖. Lời đoán ở bên dưới các quẻ bói trong kinh Dịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoán Danh", "definition": "竄 名. Dấu đi tên thật, dùng tên giả. Tiết Vân Nham Thiên Du Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoán Truyện", "definition": "Tuan-chuan (C), Commentary on the Decision.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thoát", "definition": "侻. Giản dị. Nhẹ nhàng Hợp lại Xem Đoái.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoát Không Vọng Ngữ", "definition": "脫 空 妄 語. Còn gọi: Thoát Không Mạn Ngữ. Nói lung tung và không chân thật. Vân Môn Quảng Lục, q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoát Khỏi", "definition": "Mokkhati (mokkh + a), mokkha (nam), muccati (mucc + a), nissaraṇa (trung), nissāraṇa (trung), odhunāti (ova + dhu + nā), parimutti (nữ), samatikkamati (sām + ati + kam + a), samatikkama (nam), samatikkamana (trung), samativattati (saṃ + ati + kam + a), vitarati (vi + tar + a), vitarana (trung), vimuccati (vi + muc + ya), vimuccana (trung), ādhunāti (ā + dhu + nā)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoát Khỏi Gánh Nặng", "definition": "Mocana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoát Khỏi Phiền Não", "definition": "Viraja (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoát Khỏi Ái Dục", "definition": "Bibbana (tính từ), banatha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoát Li", "definition": "脫離. Chia lìa rời bỏ nhau ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoát Lược", "definition": "脫 略. Siêu thoát, lãnh ngộ, thông đạt. Duy Tắc Ngữ Lục q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoát Nhiên", "definition": "脫 然. Có vẻ siêu thoát, lãnh ngộ. Siêu thoát, thông đạt. Tiết Vân Nham Thiên Du Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoát Nạn", "definition": "脫難. Tránh khỏi tai vạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoát Nợ", "definition": "Ānanya (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoát Thai", "definition": "脫胎. Ra khỏi cái thai, ý nói bắt chước theo một khuôn mẫu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoát Thân", "definition": "脫身. Đem thân mình tránh được tai vạ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoát Thể", "definition": "脫 體. 1. Toàn thể của sự vật, khối thống nhất trong đó có các bộ phận có quan hệ chặt chẽ không thể tách rời nhau. Bài thơ “Tự Tán” của Thiền Sư Xiển Đề Chiếu trong GTPĐL ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoát Trám", "definition": "脫 賺. Lừa dối, đánh lừa. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoát Trần", "definition": "脫塵. Ra khỏi cuộc đời. Chỉ sự đi tu theo đạo Phật. Cung oán ngâm khúc: “Thoát trần một gót thiên nhiên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoát Vòng", "definition": "Niddhurana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thoát Xác", "definition": "脫殻. Lột vỏ (nói về loài côn trùng biến dạng) Chỉ sự thay đổi hoàn toàn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thọ Ông Tông Bật", "definition": "(授翁宗弼, Juō Sōhitsu, 1296-1380): vị tăng của Lâm Tế Tông Nhật Bản, sống vào giữa hai thời đại Liêm Thương (鎌倉, Kamakura) và Nam Bắc Triều, húy Tông Bật (宗弼), tục danh Đằng Nguyên Đằng Phòng (藤原藤房), đạo hiệu Thọ Ông (授翁), thụy hiệu là Thần Quang Tịch Chiếu Thiền Sư (神光寂照禪師), Viên Giám Quốc Sư (圓鑑國師), Vi Diệu Đại Sư (微妙大師), xuất thân kinh đô Kyoto, con của vị Quyền Đại Nạp Ngôn Đằng Nguyên Tuyên Phòng (藤原宣房). Trước kia ông đã từng phục vụ cho Hậu Đề Hồ Thiên Hoàng (後醍醐天皇, Godaigo Tennō), làm đến chức Trung Nạp Ngôn (中納言), ngoài công vụ ra ông còn đến tham Thiền với Minh Cực Sở Tuấn (明極楚俊). Ông được Tông Phong Diệu Siêu (宗峰妙超) truyền trao cho y bát và pháp hiệu, và đến năm 1334 thì xuất gia. Khi Huệ Huyền (慧玄) khai sáng Diệu Tâm Tự (妙心寺, Myōshin-ji), ông theo hầu và kế thừa dòng pháp của vị nầy. Sau khi thầy mình qua đời, ông làm trú trì đời thứ hai chùa nầy.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thoại", "definition": "話. Nói chuyện. Td: Đàm thoại Lời nói. Câu chuyện. Td: Thần thoại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoại Bá", "definition": "話 霸. Đầu đề câu chuyện, phần lớn chỉ cho công án nhà thiền. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoại Bả", "definition": "話 靶. Đầu đề câu chuyện, phần lớn chỉ công án nhà thiền. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoại Hội", "definition": "話 會. Thông qua lời nói mà giao lưu và lãnh hội. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoại Nham Sư Ngạn", "definition": "(瑞巖師彦, Zuigan Shigen, ?-?): nhân vật sống vào cuối thời nhà Đường, người vùng Mân Việt (閩越, Tỉnh Phúc Kiến), họ là Hứa (許). Lúc còn nhỏ ông có chí xuất gia, nên mặc áo ca sa và nghiêm trì giới luật. Ông đến tham vấn Nham Đầu Toàn Khoát (巖 頭 全 奯) và kế thừa dòng pháp của vị nầy. Sau ông đến sống ở Thoại Nham Viện (瑞 巖 院) vùng Đài Châu (台 州, Tỉnh Triết Giang) và đã từng quy y cho cả dòng họ của Võ Túc Vương Tiễn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thoại Phá", "definition": "話 破. Nói toạc ra, nói rõ. Tiết Lâm Tế Hòa Thượng trong TĐT q. 19 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoại Thuyết", "definition": "話說. Trò chuyện (Bạch thoại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoại Tuyền Tự", "definition": "(瑞泉寺, Zuisen-ji): ngôi chùa trung tâm của Phái Đại Cốc (大谷派) thuộc Tịnh Độ Chơn Tông, hiện tọa lạc tại số 3050 Inami (井波), Nanto-shi (南砺市), Toyama-ken (富山縣); hiệu là Sam Cốc Sơn (杉谷山), hay còn gọi là Tỉnh Ba Đại Ngự Phường (井波大御坊), Tỉnh Ba Biệt Viện (井波別院). Tượng thờ chính là A Di Đà Như Lai. Vào năm 1390 (Minh Đức [明德] nguyên niên), Xước Như (綽如, Shakunyo), vị Tổ đời thứ 5 của Bổn Nguyện Tự (本願寺, Hongan-ji), khai sáng chùa này, sau chùa trở thành nơi cầu nguyện của Hậu Tiểu Tùng Thiên Hoàng (後小松天皇, Gokomatsu Tennō). Đến năm 1581 (Thiên Chánh [天正] 9), chùa gặp phải nạn binh hỏa, bị thiêu cháy tan tành; đến năm 1596 (Khánh Trường [慶長] nguyên niên), nhờ sự hỗ trợ của Tướng Quân Tú Cát (秀吉, Hideyoshi), ông cho dựng nên một ngôi chánh điện tạm thời; tuy nhiên, sau đó thì chùa lại gặp phải biết bao lần hỏa hoạn, song cũng được tái thiết rất nguy nga cho đến ngày nay. Trước ngôi nhà Thái Tử Đường có tấm bia Hậu Tiểu Tùng Đế Tụng Đức (後小松帝頌德), còn lưu lại nét bút của Xước Như. Trong vườn chùa có Đại Cốc Miếu Đường, nơi an trí di cốt của Xước Như. Tượng thờ chính của chùa, A Di Đà Như Lai, là tác phẩm của Thái Trừng (泰澄) dưới thời Bình An. Nơi Thái Tử Đường còn có an trí bức tượng tranh Thánh Đức Thái Tử (聖德太子, Shōtoku Taishi) năm lên 2 tuổi. Hằng năm người ta mở cửa ngôi nhà này và tổ chức thuyết giảng về nguồn gốc bức tranh", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thoại Tác Lưỡng Quyết", "definition": "話 作 兩 橛. Lời nói trước sau tự mâu thuẫn với nhau. Tiết Tịnh Từ Ngạn Sung Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoại Vân", "definition": "(瑞雲): hiện tượng xảy ra khi đám mây đi ngang qua gần mặt trời, tạo thành 5 sắc màu trắng, đen, đỏ, vàng, xanh lục; còn gọi là thái vân (彩雲), khánh vân (慶雲), cảnh vân (景雲). Từ xa xưa, thoại vân được xem như là điềm lành, nhưng thực tế là hiện tượng khí tượng mà thôi. Trong Phật Giáo, thoại vân còn được gọi là nhật vựng (日暈, vừng sáng của mặt trời), là hiện tượng thường xảy ra trong những lúc đại lễ quan trọng như Lạc Thành, Khai Nhãn Tượng Phật, v.v.; và có tên gọi là Ngũ Sắc Thái Vân (五色彩雲), Ngũ Sắc Thoại Vân (五色瑞雲), v.v. Hơn nữa, trong các bức tranh Lai Nghênh Đồ (來迎圖), v.v., thường có vẽ hình đức Phật A Di Đà cùng với chư Bồ Tát từ Tây Phương Cực Lạc Tịnh Độ lướt trên đám mây lành năm sắc này đến tiếp rước. Trong Địa Tạng Bổn Nguyện Kinh Chú Giải (地藏本願經科註, 卍 Tục Tạng Kinh Vol. 21, No. 384) quyển 6 có đoạn rằng: “Tây Kinh Tạp Ký vân: 'Thoại vân viết khánh vân, viết cảnh vân; vân ngũ sắc viết khánh, hoặc viết khanh; thử biểu ly Ngũ Trú Phiền Não, hiển Ngũ Phần Pháp Thân chi tường chưng dã' (西京雜記云、瑞雲、曰慶雲、曰景雲、雲五色曰慶、或曰卿、此表離五住煩惱、顯五分法身之祥徵也, Tây Kinh Tạp Ký giải thích rằng: 'Thoại vân còn gọi là khánh vân, cảnh vân; mây năm sắc gọi là khánh, hay khanh; nó biểu hiện cho sự xa lìa Ngũ Trú Phiền Não và hiển lộ điềm lành Năm Phần Pháp Thân').” Trong Phật Tổ Thống Kỷ (佛祖統紀, Taishō Vol. 49, No. 2035) quyển 22, có đoạn: “Huyền Tông mộng không trung Sở Kim nhị tự, cật triều phỏng vấn, hàm dĩ sư đối, nãi thân chế Đa Bảo Tháp ngạch tứ kiêm mân vi trợ, công tất chi nhật ngũ sắc thoại vân ngưng ư tháp thượng (玄宗夢空中楚金二字、詰朝訪問、咸以師對、乃親製多寶塔額賜縑緡爲助、功畢之日五色瑞雲凝於塔上, vua Huyền Tông mơ thấy trên không có hai chữ 'Sở Kim', mới hỏi triều thần, tất cả đều nhờ sư trả lời; nhà vua bèn ngự chế ban sắc ngạch trợ giúp lụa tiền dựng Tháp Đa Bảo; ngày hoàn tất công trình có đám mây lành năm sắc đọng trên tháp).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thoại Đầu", "definition": "Hau tou (C), Watō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thoại Đọa", "definition": "話 墮. Sẩy lời; lời nói chẳng khế hợp thiền nghĩa. Vân Môn Quảng Lục q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thoả", "definition": "妥. Yên ổn, xong xuôi. Td: Thoả đáng. Ổn thoả Ta còn hiểu là đã vừa lòng, không còn mong muốn gì hơn nữa. Đoạn trường tân thanh: “Khát khao đã thoả tấm lòng lâu nay”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoả Mãn", "definition": "妥滿. Đầy đủ, vừa lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoả Nguyện", "definition": "妥願. Vừa với lòng trông mong của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoả Thiếp", "definition": "妥貼. Yên ổn xong xuôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoả Thích", "definition": "妥適. Vừa hợp với lòng mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoả Tình", "definition": "妥情. Vừa lòng. làm cho vừa lòng. Truyện Trê Cóc: “Liệu sao các việc thoả tình người ta”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoả Đáng", "definition": "妥當. Xong xuôi, yên ổn, tốt đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thoải Mái", "definition": "Yathāsukhaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thrall", "definition": "Sự nô lệ, người nô lệ", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thrisong Deutsen", "definition": "Thrisong Deutsen (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thrive", "definition": "Produce, grow = phát sinh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Throbbing", "definition": "(pulse) . Đập mạnh", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thu", "definition": "揫. Gom lại. Bó lại. Cũng đọc Tưu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Ba", "definition": "秋波. Làn sóng mùa thu, chỉ ánh mắt trong sáng long lanh của người con gái như sóng nước mùa thu. Cung oán ngâm khúc: “Khoé thu ba gợn sóng khuynh thành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Binh", "definition": "收兵. Rút quân về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Cảnh", "definition": "秋景. Chỉ chung những vật thiên nhiên bày ra trước mắt trong mùa thu, tức phong cảnh mùa thu. Truyện Hoa Tiên: “Tả nơi thu cảnh bàn nơi thu tình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Dung", "definition": "秋容. Khuôn mặt mùa thu, tức cảnh sắc mùa thu. Cung oán ngâm khúc: “Gấm nàng Ban cũng lại mùa thu dung”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Duyên", "definition": "(收緣): kết liễu các duyên trước, chấm dứt mọi duyên, cũng có nghĩa là chấm dứt mạng sống. Như trong hồi thứ 41 của Tái Sanh Duyên (再生緣) có câu: “Thượng Bản tằng ngôn Khuê Bích tử, Nam Lao tứ bạch dĩ thu duyên (上本曾言奎璧死、南牢賜帛已收緣, Thượng Bản từng bảo rằng Khuê Bích chết, Nam Lao ban cho lụa rồi kết liễu mọi duyên).” Hay trong Kim Cang Tân Nhãn Sớ Kinh Kệ Hợp Thích (金剛新眼疏經偈合釋, 卍Tục Tạng Kinh Vol. 25, No. 487) quyển 1 có đoạn: “Cự nhĩ thu duyên tẩy túc, phu tòa nhi tọa, nhất niệm bất sanh, vạn lự giai vong, ngũ uẩn ký không, tứ tướng hà hữu, thử hựu Như Lai mật thị hàng tâm pháp dã (遽爾收緣洗足、敷座而坐、一念不生、萬慮皆亡、五蘊旣空、四相何有、此又如來密示降心法也, gấp rút thu duyên rửa chân, trãi tòa mà ngồi, một niệm không sanh, vạn lo đều không, Năm Uẩn đã không, Bốn Tướng sao có, đây là pháp hàng phục tâm do đức Như Lai bí mật dạy cho).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thu Dụng", "definition": "收用. Gom lại mà dùng. Nhận mà dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Hoạch", "definition": "收穫. Gặt hái được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Hồi", "definition": "收囘. Lấy về. Gom về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Không", "definition": "收空. Hiệu chuông hoặc trống báo hiệu soát xét không có kẻ gian hoặc việc lạ trong thành khi trời gần tối. Đoạn trường tân thanh: “Mặt trời gác núi chiêng đà thu không”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Kim Cang Bồ Tát", "definition": "Sarada-vajrah (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thu Nhập", "definition": "Saṃharati (saṃ + har + a), dāyati (dā + ya), dāyana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thu Nạp", "definition": "收納. Gom nhận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Phong", "definition": "秋風. Làn gió mùa thu. Thơ Tản Đà: “Trận gió thu phong rụng lá vàng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Phân", "definition": "秋分. Tên thời tiết, vào khoảng 23 hoặc 24 tháng 9 dương lịch, ngày đêm dài bằng nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Sinh Bà", "definition": "收生婆. Người đàn bà đỡ đẻ. Bà mụ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Sát", "definition": "收 殺. Kết cục, kết thúc. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thu Sắc", "definition": "秋色. Cảnh đẹp của phong cảnh mùa thu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Thanh", "definition": "收聲. Ghi tiếng nói, tiếng nhạc vào đĩa nhựa, băng nhựa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Thuỷ", "definition": "秋水. Nước mùa thu, chỉ ánh mắt trong sáng long lanh của người con gái đẹp. Đoạn trường tân thanh: “Làn thu thuỷ, nét xuân sơn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Thúc", "definition": "收束. Gom lại để chấm dứt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Thúc Lục Căn", "definition": "Indriyadamana (trung), indriyasaṃvara (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thu Thập", "definition": "收拾. Gom góp lượm lặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Tàng", "definition": "收藏. Gom lại mà cất đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Tình", "definition": "秋情. Lòng người trước mùa thu. Truyện Hoa Tiên: “Tả nơi thu cảnh bàn nơi thu tình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thu Được", "definition": "Upalabhati (upa + labh + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thua Trận", "definition": "Parājaya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thung", "definition": "從. Xem Thung dung 從容 Xem các âm Tòng, Tùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thung Dung", "definition": "從容. Thảnh thơi thong thả. Truyện Hoa Tiên: “Thuận lời vui chén thung dung”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thung Dung Am Lục", "definition": "從 容 庵 錄. Gọi đủ: Vạn Tùng Lão Nhân Bình Xướng Thiên Đồng Hòa Thượng Tụng Cổ Thung Dung Am Lục. Niêm tụng bình xướng, 6 quyển do Vạn Tùng Hành Tú soạn vào đời Nguyên, được xếp vào Đại Chính Tạng tập 48, trang 226. Đệ tử của Hành Tú là Da Luật Sở Tài lúc đi theo Thành Cát Tư Hãn để chinh phục các nước phía tây, do tỏ lòng thương cảm khi phải rời xa thầy, nhiều lần ông ta gởi thư thỉnh Hành Tú bình xướng các bài tụng cổ của Thiên Đồng nên Hành Tú ở am Thung Dung chùa Báo Ân tại Yên Kinh soạn sách này. Vào đời Nguyên Thế Tổ thứ 8 (1213), sách được gởi sang Tây Vực cho Da Luật Sở Tài. Năm kế, Sở Tài viết tựa. Sách này là do Thiên Đồng Chính Giác dựa trên cơ sở 100 tắc công án để làm tụng cổ và do Hành Tú thêm phần bình xướng mà thành. Mỗi tắc gồm 6 phần:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thung Dung Lục", "definition": "Shōyō roku (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thung Huyên", "definition": "(椿萱): Thung hay xuân (椿) là loại cây cao lá rụng thuộc Khoa Chiên Đàn (栴檀), gỗ cứng, thường dùng làm khí cụ rất tốt. Trong Trang Tử (莊子), phần Tiêu Dao Du (逍遙遊) có đoạn rằng: “Thượng cổ hữu đại Thung giả, dĩ bát thiên tuế vi Xuân, bát thiên tuế vi Thu (上古有大椿者、以八千歳爲春、八千歳爲秋, thời xưa có cây thung lớn, lấy tám ngàn năm làm một mùa Xuân, tám ngàn năm làm một mùa Thu)”; vì vậy sau này cây Thung được dùng thể hiện sự trường thọ và mượn thay thế cho người cha. Nơi người cha ở được gọi là Thung Đình (椿庭), Thung Đường (椿堂) hay Thung Phủ (椿府); cho nên người ta hay dùng câu “Thung Đường Trường Thanh (椿堂長青, Cha Lành Sống Mãi [nhà có cây thung xanh mãi])” để chúc thọ cho phụ thân. Bên cạnh đó, Huyên (萱) là loại cây cỏ sống lâu năm, Huyên Thảo (萱草) là loại Kim Châm (金針), tương truyền khi ăn vào thì làm cho người ta quên đi ưu sầu, phiền muộn; nên được gọi là Vong Ưu Thảo (忘憂草, Cỏ Quên Buồn) và thường được dùng thay thế cho người mẹ. Nơi người mẹ cư ngụ được gọi là Huyên Đường (萱堂), tức là nơi có trồng nhiều loại cỏ huyên để giúp cho mẹ quên đi mọi ưu phiền. Nếu như cả cha lẫn mẹ đều song toàn, tức vẫn còn sống thọ, thế gian vẫn thường dùng câu chúc thọ là “Thung Huyên Tinh Mậu (椿萱並茂, Cha Mẹ Cùng Thọ [cây Thung và cây Huyên cùng tươi tốt])”. Trong bài thơ Tống Từ Hạo (送徐浩) của Mâu Dung (牟融) nhà Đường có câu: “Tri quân thử khứ tình thiên cấp, đường thượng thung huyên tuyết mãn đầu (知君此去情偏急、堂上椿萱雪滿頭, Biết người đi mãi tình ngăn cách, nhà vắng mẹ cha tóc bạc đầu)”. Hay trong Nhất Chi Hoa (一枝花), Tử Đệ Mỗi Tâm Kí Thanh Lâu Thọ Nhân Khúc (子弟毎寄青樓受人曲) của Thang Thức (湯式) nhà Minh có đoạn: “Thung huyên suy mại, tùng cúc tiêu điều (椿萱衰邁、松菊蕭條, Mẹ cha suy yếu, tùng cúc tiêu điều)”. Hoặc trong bài Mẫu Đơn Đình (牡丹亭) của Thang Hiển Tổ (湯顯祖) nhà Minh cũng có câu: “Đương kim sanh hoa khai nhất hồng, nguyện lai sanh bả huyên thung tái phụng (當今生花開一紅、願來生把萱椿再奉, Ngày nay đơm hoa nở nụ hồng, nguyện đời sau gặp mẹ cha cung phụng).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thung Lũng Nhỏ", "definition": "Kuñja (trung), nikuñja (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thung Đình", "definition": "(椿庭): chỉ cho người cha, hay nơi người cha ở; vì cây thung (椿, hay xuân) tượng trưng cho sự trường thọ. Như trong phần Hội Giảng (會講) thuộc Kinh Xoa Ký (荊釵記) của Chu Quyền (朱權, 1378-1448) nhà Minh có câu rằng: “Bất hạnh Thung Đình vẫn táng, thâm lại Huyên Đường huấn hối thành nhân (不幸椿庭殞喪、深賴萱堂訓誨成人, không may cha lành qua đời, thảy nhờ mẹ hiền dạy dỗ nên người).” Từ đó, có một số câu được dùng để chúc tụng người cha như: “Thung Đình nhật noãn (椿庭日暖, Thung Đình mỗi ngày một ấm áp, nghĩa là người cha mỗi ngày một mạnh khỏe)”, “Thung Đình trường thanh (椿庭長青, Thung Đình xanh tươi mãi, nghĩa là cha lành vẫn sống mãi)”, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thus", "definition": "Theo cách đó, như vậy, như thế, do đó", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thuyên", "definition": "拴. Trói lại. Buộc lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyên Chuyển", "definition": "銓轉. Lựa chọn và thay đổi chỗ làm việc của quan lại và các viên chức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyến", "definition": "縓. Tơ màu vàng đỏ Tơ nhuộm một lần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết", "definition": "說. Nói rõ ra Lời nói Một hệ thống tư tưởng. Td: Học thuyết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Biến Thập Xứ", "definition": "說徧十處 (Hoa Nghiêm Kinh Tùy Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thuyết Chuyển Bộ", "definition": "Saṃkantikah (P), Saṃkrantivadah (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Duyên Khởi này cùng với luận Thực Tướng của Trung Luận và Thiên Thai đã tạo thành hai hệ thống lớn của giáo học Phật Giáo. [X. Kinh Tạp A Hàm Q.12; kinh Đa giới trong Trung A Hàm Q.47; Luận Đại Tì Bà Sa Q.23; Luận Phẩm Loại Túc Q.6]. (xt. Duyên Dĩ Sinh, Duyên Khởi Luận).", "definition": "II.Duyên Khởi.Phạm: Nidàna. Dịch âm: Ni Đà Na. Dịch ý là Duyên Khởi, Nhân Duyên. Giống như từ ngữ Duyên Khởi đã nói ở trên nhưng được sử dụng trong tình huống khác: chỉ cho Nhân Duyên bộ trong 12 bộ loại kinh (kinh điển Phật Giáo Nguyên Thủy). Tức là nói rõ duyên do (lí do, nguyên do) Đức Phật hoặc Tổ Sư các đời tùy theo căn cơ của chúng sinh mà thuyết pháp, hoặc lí do soạn thuật ba tạng Kinh, Luật, Luận, như “Duyên Khởi nhân phần...” trong giáo nghĩa của Tông Hoa Nghiêm là thuộc loại này.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thuyết Giả Bộ", "definition": "Prajnapti-vadin. Sau khi Đa Văn Bộ được thành lập không lâu, từ Đại Chúng Bộ lại tách ra một bộ phái nữa, gọi là Thuyết Giả Bộ. Chủ trương của bộ phái này không giống với chủ trương của Thuyết Xuất Thế Bộ (tất cả pháp xuất thế gian đều chân thật), lại cũng không giống với chủ trương của Nhất Thuyết Bộ (tất cả pháp thế và xuất thế gian đều không chân thật, chỉ có giả danh); mà chủ trương rằng, các pháp thế hay xuất thế gian đều có một ít phần là giả. Tương truyền, khi đức Phật còn tại thế, tôn giả Đại Ca Chiên Diên (Kaccayana) đã từng tạo luận để phân tích, giải thích giáo pháp của Phật dạy. Đến khoảng 250 năm sau ngày Phật nhập diệt, tôn giả Đại Ca Chiên Diên đã từ hồ A-nậu-đạt (Anavatapta, trong vùng núi Tuyết) đến nước Ma-kiệt-đà, xuất hiện trong Đại Chúng Bộ, xướng xuất chủ trương rằng, mười hai xứ và mười tám khu vực đều là giả danh, còn năm uẩn là chân thật; cứ theo đó mà phân biệt Ba Tạng thánh giáo. Những người tin theo chủ trương này, đã tự thành lập Thuyết Giả Bộ (cũng gọi là Phân Biệt Thuyết Bộ - Vibhajya-vandi), tách khỏi Đại Chúng Bộ. Cứ theo thuyết này thì Thuyết Giả Bộ là do đệ tử của tôn giả Đại Ca Chiên Diên hoằng dương. Do chủ trương “thế giới hiện thật một mặt là chân, một mặt là giả” của bộ phái này, đã diễn thành giáo nghĩa “hai mặt chân vọng” của thế giới quan đại thừa trong Luận Đại Thừa Khởi Tín.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thuyết Giảng", "definition": "Bhaṇati (bhaṇ + a), lapati (lap + a), vadati (vad +a), deseti (dis + e), sammadakkhāta (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuyết Giới Kiền Độ", "definition": "Uposatha-khandaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Hàng", "definition": "說降. Dùng lời lẽ giảng giải để cho quân địch xin chịu thua mà theo mình. Đoạn trường tân thanh: “Ngọc vàng gấm vóc sai quan thuyết hàng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Khách", "definition": "說客. Người dùng lời lẽ để vận động việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Lí", "definition": "說理. Nói rõ cái lẽ của sự vật. Thơ Tản Đà: “Hai quyển Khối tình văn thuyết lí”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Minh", "definition": "說明. Nói rõ ra cho người khác hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Mạn Đà La Pháp Kinh", "definition": "Dharma-maṇdala Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Nhân Bộ", "definition": "Hetuvidyāh (S), Hetuvāda (S), Hetuvādapūrva, Sthavirāḥ (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Nhất Thiết Hữu Bộ", "definition": "Sarvasti-vadin: cũng gọi là Căn Bản Thuyết Nhất Thiết Hữu Bộ, gọi tắt là Hữu Bộ; lại có tên là Thuyết Nhân Bộ; và nói theo âm tiếng Phạn là Tát Bà Đa Bộ. Vì bộ phái này chủ trương tất cả các pháp trong ba đời đều thật có, cho nên có tên là Thuyết Nhất Thiết Hữu Bộ. Sáng tổ của bộ phái này là trưởng lão Ca Đa Diễn Ni Tử, sống vào khoảng đầu thế kỉ thứ 3 PL (xem mục “Ca Đa Diễn Ni Tử”). Thượng Tọa Bộ từ trước vẫn thiên trọng Kinh tạng và Luật tạng, nhưng đến đây, Ca Đa Diễn Ni Tử chống lại truyền thống ấy, chuyển sang chú trọng hoằng dương Luận tạng, tự thành lập một bộ phái riêng, đối lập với Thượng Tọa Bộ. Sau khi xảy ra sự phân rẽ này, Thượng Tọa Bộ đã dời vào Tuyết-sơn lập cứ địa, còn Thuyết Nhất Thiết Hữu Bộ thì vẫn đặt căn cứ tại Ca-thấp-di-la, gây thanh thế vững mạnh, lan dần sang nước Kiền-đà-la, rồi bao trùm cả Bắc, Tây-Bắc và Trung Ấn-độ, luôn cả các nước Tây-vực, tỏa rộng ra đến các nước phương Nam và phương Đông như Nam-dương, Đông-dương và Trung-quốc, cực thịnh một thời, địa bàn rộng lớn không bộ phái nào sánh bằng. Bộ phái này cường thịnh đến nỗi nó đã được coi là đại diện cho toàn thể Thượng Tọa Bộ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thuyết Nhất Thiết Hữu Bộ Giới Thân Tức Luận", "definition": "Xem A Tỳ Đạt Ma Giới Thân Tức Luận.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Nhất Thiết Trí", "definition": "(說一切智) [tạp]: trong 48 lời nguyện của Kinh Vô Lượng Thọ (無量壽經) có lời nguyện thứ 25 là nguyện nói về trí tuệ hiểu biết hết tất cả. Kinh dạy rằng: “Thiết ngã đắc Phật, quốc trung Bồ Tát bất năng diễn thuyết nhất thiết trí giả, bất thủ chánh giác (設我得佛、國中菩薩不能演說一切智者、不取正覺, nếu như ta thành Phật mà các vị Bồ Tát trong nước của ta không thể nào diễn nói trí tuệ hiểu biết hết tất cả, ta sẽ không thành chánh giác).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thuyết Nhất Thừa Kinh", "definition": "Ekayāna-nirdeśa (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Pháp", "definition": "說法. Tiếng nhà Phật, chỉ sự giảng rõ phép Phật, giáo lí của Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Pháp Ngũ Phước Đức", "definition": "說法五福德 (Hiền Giả Ngũ Phước Đức Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thuyết Pháp Tứ Báng", "definition": "說法四謗 (Hoa Nghiêm Kinh Tuỳ Sớ Diễn Nghĩa Sao)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thuyết Quy Củ", "definition": "說 規 矩. Chỉ dạy quy tắc lễ độ Thiền môn cho các ông tăng nhỏ tuổi, như trong Huấn Đồng Hạnh được ghi ở Sắc Tu Bách Trượng Thanh Quy, Thiền Lâm Bị Dụng Thanh Quy. Theo: PQĐTĐ của nhóm Từ Di.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuyết Quái", "definition": "Sho-kua (C), Discussion of the Trigrams.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết Ra", "definition": "Brūti (brū + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuyết Thoại", "definition": "說話. Nói năng trò chuyện (Bạch thoại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyết Trình Viên", "definition": "Akkhātu (nam), akkhāyī (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuyết Tự Nhất Vật Tức Bất Trúng", "definition": "說 似 一 物 即 不 中. Ý nói thiền pháp là một cái gì thì không đúng. Thiền pháp siêu việt tất cả hình tướng, số lượng, thời gian, không gian. Nếu nói là một vật gì, là một cái gì thì cái đó sẽ không hợp với thiền pháp. Chương Hoài Nhượng, đời thứ 1 dưới Đại Giám trong CTTNL q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuyết Xuất Thế Bộ", "definition": "Lokottara-vada. Cùng trong khoảng thời gian Nhất Thuyết Bộ được thành lập và tách khỏi Đại Chúng Bộ, Thuyết Xuất Thế Bộ cũng được thành lập và cũng tách khỏi Đại Chúng Bộ. Bộ phái này chủ trương tất cả các pháp thế gian đều không có thật thể, chỉ có giả danh. Pháp thế gian do sự điên đảo khởi ra; từ điên đảo mà sinh ra phiền não, do phiền não mà gây nghiệp, do nghiệp mà kết thành quả báo, tất cả đều hư vọng, không chân thật. Vì vậy, tất cả pháp thế gian đều chỉ là giả danh; trong khi đó, tịch diệt (diệt) và các pháp môn tu tập (đạo) thuộc pháp xuất thế gian, cho nên đều là chân thật. Pháp sư Khuy Cơ gọi bộ phái này là “Tục Vọng Chân Thật tông” (tục đế là vọng, chân đế là thật). Có thuyết nói rằng, nguyên thỉ, Thuyết Xuất Thế Bộ và Kê Dận Bộ (xem mục “Kê Dận Bộ”) chỉ là một bộ phái; vì Kê Dận Bộ chủ trương tất cả các pháp hữu lậu của thế gian đều là giả, và chỉ trú trọng đến các pháp vô lậu xuất thế gian của Phật mà thôi, cho nên nó cũng được gọi là “Xuất Thế Bộ”. Về sau, nhân vì chủ thuyết này dần dần có chỗ biến hóa, Xuất Thế Bộ (tức Thuyết Xuất Thế Bộ) bèn tách riêng ra thành một phái độc lập.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thuyết này của tông Hoa Nghiêm, không phải các tông phái khác đều tán thành. Vd, có người thay vì Mật giáo, dùng từ Viên giáo (giảng giáo lý đầy đủ trọn vẹn).", "definition": "Tông Thiên Thai lập thuyết giáo pháp của Phật được giảng theo năm thời kỳ:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thuyết này được khai sáng sau ngài Tuệ Quang. [X. Đại Thừa Huyền Luận Q.5]", "definition": "IV. Tam Giáo.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thuyết Đạo", "definition": "Acquainted with the path", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thuyết Độ Bộ", "definition": "Xem Kinh Lượng Bộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyết, Duyệt, Thoát, Thuế", "definition": "説. Như chữ 說.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyền", "definition": "船. Dụng cụ để chở người và đồ đạc trên mặt nước. Đoạn trường tân thanh: “Cùng người một hội một thuyền đâu xa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyền Cước", "definition": "船脚. Tiền đò. Tiền trả về việc đi thuyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuyền Trưởng", "definition": "Niyāmaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuyền Tôn Tự", "definition": "禪 宗 寺. Chùa ở ấp Ngũ Tây, làng An Cựu, Thủy An, Việt Nam, cách thành phố Huế 7km về phía nam. Chùa do Thiền Sư Liễu Quán sáng lập.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuyền Tử Hòa Thượng", "definition": "船 子 和 尚. Hòa Thượng chèo đò. Thiền tăng Đức Thành đời Đường ở ẩn nơi bến Hoa Đình, bên bờ sông Ngô, đưa đò tiếp hóa người bốn phương qua lại, được người đời gọi là Thuyền tử Hòa Thượng (Hòa Thượng chèo đò). X. Đức Thành.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuyền Tử Hòa Thượng Bạt Trạo Ca", "definition": "船 子 和 尚 拔 櫂 歌. Thi ca biệt tập, Chính tập 2 quyển, Tục tập 2 quyển, do Đức Thành (tức Thuyền Tử Hòa Thượng) soạn vào đời Đường, và được xếp vào “Thượng Hải Văn Hiến Tùng Thư”. Sách này được xếp vào 39 bài “Thuyền Tử Hòa Thượng Ngư Phủ Ca Từ”, và “Lịch Đại Tăng Tục Họa Vịnh”… Nội dung đều là những bài ngâm vịnh về sinh hoạt của ngư dân nhưng hàm chứa huyền lý nhà Phật. Đây là tư liệu quan trọng để nghiên cứu về “thiền thi”, “thiền từ” vào thời kỳ sớm nhất. Sách này được ấn hành vào năm 1987 do nhà xuất bản Đại Học Sư Phạm Hoa Đông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuyền Tử Đức Thành", "definition": "Sensu Tokujō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuyền pháp. Phật Pháp có năng lực cứu vớt chúng sinh đang chìm đắm trong biển sinh tử để đưa đến bờ Niết Bàn giải thoát, giống như con thuyền có khả năng đưa người qua sông, vì thế ví dụ Phật Pháp như chiếc thuyền, nên gọi là Pháp thuyền. Kinh Tâm Địa Quán quyển 1 (Đại 3, 295 thượng) nói: “Đức Phật luôn là chiếc thuyền diệu pháp, có năng lực cắt đứt dòng ái dục mà vượt lên bờ giải thoát”.", "definition": "II.Pháp Thuyền.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thuân", "definition": "𠣟. Như chữ Thuân 逡.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuý", "definition": "翆. Như chữ 翠.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuấn", "definition": "Shun (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuấn Đô Tông", "definition": "舜 都 宗 (1340-1426). Thiền tăng đời Nguyên, họ Thuấn, hiệu Nhược Ngu, người xứ Tứ Dương, Giang Tô, Trung Quốc. Nối pháp Thiền Sư Thiên Khánh Nghĩa Nhượng, đời thứ 24 hệ Thanh Nguyên. Trụ trì chùa Linh Cốc ở Nam Kinh (Nam Kinh, Giang Tô).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuần", "definition": "淳. Thật thà mộc mạc, không trau chuốt Vẫn nguyên vẹn như lúc đầu, không pha trộn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Chân", "definition": "純 眞 (?-1101). Thiền tăng đời Lý, thuộc dòng Tỳ Ni Đa Lưu Chi đời thứ 12, nối pháp Thiền Sư Pháp Bảo. Sư họ Đào quê làng Cửu Ông, huyện Tế Giang (tức huyện Văn Giang, tỉnh Hưng Yên ngày nay). Sư thuở nhỏ thông thạo kinh sử, đi đến đâu bọn Nho sĩ tranh nhau theo về. Chẳng bao lâu, sư mở tung được cánh cửa áo diệu, tia sáng giác ngộ xuất hiện. Từ đó, sư trụ trì chùa Hoa Quang, làng Tây Kết, Thượng Nghi. Tùy người đến thưa hỏi, sư phát huy tông chỉ, dẫn dắt những kẻ mờ tối. Ngày 7 tháng 2 năm ất Dậu nhằm niên hiệu Nguyên Phù thứ 1 đời Lý Nhân Tông (1101), sư báo tin sắp tịch. Có đệ tử là Bản Tịch vào thất thưa hỏi thêm, sư nói kệ dạy:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuần Hòa Thiên Hoàng", "definition": "(淳和天皇, Junna Tennō, tại vị 758-764): vị Thiên Hoàng sống vào đầu thời kỳ Bình An, con thứ 7 của Hoàn Võ Thiên Hoàng (桓武天皇, Kammu Tennō), tên là Đại Bạn (大伴) hay còn gọi là Tây Viện Đế (西院帝, Saiin-no-mikado). Ông rất giỏi về Hán Thi, đã từng ra lệnh cho nhóm Lương Sầm An Thế (良岑安世) soạn ra Kinh Quốc Tập (經國集)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thuần Hóa", "definition": "Dameti (dam + e), damaka (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuần Hậu", "definition": "淳厚. Lòng dạ tốt đẹp, thành thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Hựu", "definition": "(淳祐, Shunnyū, 890-953): vị học tăng của Chơn Ngôn Tông Nhật Bản, sống vào giữa thời Bình An, húy là Thuần Hựu (淳祐), thông xưng là Thạch Sơn Nội Cúng (石山內供), Phổ Hiền Viện Nội Cúng (普賢院內供); xuất thân kinh đô Kyoto, con của quan Hữu Trung Biện Quản Nguyên Thuần Mậu (右中辯菅原淳茂). Ông theo xuất gia với Quán Hiền (觀賢) ở Đề Hồ Tự (醍醐寺, Daigo-ji), thọ giới ở Giới Đàn của Đông Đại Tự (東大寺, Tōdai-ji), và đến năm 925 thì nhận Truyền Pháp Quán Đảnh của Quán Hiền. Ông được suy cử chức Tọa Chủ Đề Hồ Tự, nhưng vì biết thân mang nhiều bệnh tật, không thể làm việc được nhiều, nên khước từ và lui về ẩn cư ở Thạch Sơn Tự (石山寺), trú tại Phổ Hiền Viện. Tương truyền ông theo hầu Quán Hiền lên Cao Dã Sơn để thông báo cho đại chúng biết việc triều đình hứa khả ban thụy hiệu cho Không Hải Đại Sư vào năm 921, khi ấy ông chạm tay vào đùi gối của Không Hải, đến lúc thả tay ra thì mùi hương thơm vẫn tỏa ngát mãi cho đến suốt đời. Ông đã cho tiến hành nghiên cứu kinh điển và hoàn thành vai trò rất lớn trong việc làm cho Đông Mật phát triển. Đệ tử phú pháp của ông có Nguyên Cảo (元杲), Cứu Thế (救世), Khoan Trung (寬忠), v.v. Trước tác ông để lại có Thai Tạng Tập Ký (胎藏集記) 10 quyển, Thai Tạng Thất Tập (胎藏七集) 3 quyển, Kim Cang Giới Thất Tập (金剛界七集) 2 quyển, Kim Cang Giới Thứ Đệ Pháp (金剛界次第法) 4 quyển, v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thuần Lí", "definition": "純理. Chỉ chuyên về cái lẽ do đầu óc nhận biết, mà không cần có phù hợp với sự thật bên ngoài hay không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Lý Chủ Nghĩa", "definition": "Rationalism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuần Lương", "definition": "純良. Thật thà tốt đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Nhất", "definition": "純一. Chỉ có một, không thay đổi, lẫn lộn cái khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Nhất Thiền Sư", "definition": "純 一 禪 師. Hiệu của Thiền tăng Toàn Phó đời Ngũ Đại. X. Toàn Phó.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuần Phong", "definition": "淳風. Nếp sống thật thà tốt đẹp có từ xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Phác", "definition": "純樸. Thật thà, không trau chuốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Phục", "definition": "Akkamati (ā + kam + a), akkami (trung), akkamana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuần Thiện", "definition": "Spotless and good", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thuần Túy", "definition": "純粹. Một mình, không pha trộn Hoàn toàn tốt đẹp ngay từ đầu, không trau chuốt, pha trộn gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuần Tỳ Tương Bán", "definition": "醇 疵 相 半. Nửa ưu nửa khuyết. Tiết Tục Nghệ Ngôn trong NHQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuần Đà", "definition": "Cunda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuẫn", "definition": "揗. Dùng tay vẫy vẫy, hoặc vỗ về.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận", "definition": "順. Theo. Nghe theo. Đi theo. Truyện Hoa Tiên: “Lại xem thuận lối dần dà” Xuôi theo, không trái nghịch. Thành ngữ: “Thuận bườm xuôi gió”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Bất Khổ Bất Lạc Thọ Nghiệp", "definition": "Aduḥkha-sukha-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Chi", "definition": "(順之, Junshi, ?-?): vị tăng của Quy Ngưỡng Tông, xuất thân Phối Giang (浿 江), Tân La (新羅), họ Phác (朴). Ông xuống tóc xuất gia ở Ngũ Quan Sơn (五冠山) và thọ cụ túc giới ở Tục Ly Sơn (俗 離 山). Vào năm thứ 2 (858) đời vua Hiến An Vương (憲安王), ông sang nhà Đường cầu pháp, theo hầu Ngưỡng Sơn Huệ Tịch (仰 山 慧 寂) và được vị nầy truyền tông chỉ cho. Đến năm thứ 14 (874) đời vua Cảnh Văn Vương (景文王), ông trở về nước, được cử đến trú trì Long Nghiêm Tự (龍嚴寺, sau là Thoại Vân Tự [ 瑞雲寺]). Ông thị tịch hưởng thọ 65 tuổi, được ban cho thụy hiệu Liễu Ngộ Thiền Sư (了悟禪師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thuận Chiều", "definition": "Anuvāta (nam), anuvātaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuận Chánh Luận", "definition": "Xem A Tỳ Đạt Ma Thuận Chánh Luận.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Chánh Lý Luận", "definition": "Abhidharmanyā-yānusāra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Gió", "definition": "Anuvāta (nam), anuvātaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuận Hiểu", "definition": "(順曉, Junkyō, ?-?): vị tăng Mật Giáo Trung Quốc, sống dưới thời nhà Đường, không rõ xuất thân quê quán, môn hạ của Thiện Vô Úy (s: Śubhakarasiṃha, 善無畏), theo Nghĩa Lâm (義林) của Tân La (新羅, Triều Tiên) học tập mật pháp của Chơn Ngôn. Ban đầu ông trú tại Linh Nham Tự (靈巖寺) vùng Thái Nhạc (泰嶽), sau chuyển đến Long Hưng Tự (龍興寺) ở Việt Châu (越州). Vào tháng 4 năm 805 (niên hiệu Vĩnh Trinh [永貞] nguyên niên), nhân hai vị tăng Nhật Bản là Tối Trừng (最澄, Saichō) và Nghĩa Chơn (義眞, Gishin) đến Long Hưng Tự tham bái, ông truyền thọ phép Quán Đảnh cho họ và trao các đồ hình Tam Muội Da (三昧耶), pháp môn niệm tụng, khế ấn, đạo cụ, v.v. Người đời thường gọi ông là Trấn Quốc Đạo Tràng Đại Đức A Xà Lê (鎭國道塲大德阿闍梨).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thuận Hòa", "definition": "順和. Êm đềm tốt đẹp, không trái nghịch nhau. Truyện Hoa Tiên: “Thuận hoà từ đấy cũng in một lòng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Hóa", "definition": "順化. Tên cũ của thị xã Huế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Hỷ Thọ Nghiệp", "definition": "Saunanasya-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Khẩu", "definition": "順口. Buột miệng mà nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Khổ Thọ Nghiệp", "definition": "Dukha-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Lưu", "definition": "Anusrotogamin (S), Anusot-agamin (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Lưu Thập Tâm", "definition": "順流十心 (Ma Ha Chỉ Quán)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thuận Lạc Thọ Nghiệp", "definition": "Sukha-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Lợi", "definition": "順利. Êm xuôi dễ dàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Nghịch Nhị Quán", "definition": "Thuận nghịch nhị quán là hai phép quán thuận và nghịch, bao gồm :", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thuận Nhẫn", "definition": "Chữ “nhẫn” nghĩa là an trú ở địa vị đã đạt được; chữ “thuận” nghĩa là tùy thuận chân lí, không trái ngược chân lí. “Thuận Nhẫn” nghĩa là tùy thuận chân lí, nhờ vào chính sự tư duy của mình mà tỏ ngộ. “Thuận Nhẫn tâm thức vô sở thủ” nghĩa là an trú nơi tâm vắng lặng.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thuận Phong", "definition": "順風. Theo gió, xuôi gió mà đi. Đoạn trường tân thanh: “Thuận phong một lá thuận sang bến Tề”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Quyền Phương Tiện Kinh", "definition": "Strivi-varta-vyākaraṅa Sūtra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Theo Pháp", "definition": "Heedful of law (to be)", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thuận Thảo", "definition": "Anukūla (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuận Thế", "definition": "順 世. Còn gọi: Thuận hóa. (Tăng nhân) thị tịch, mất. Tiết Nam Tuyền Hòa Thượng trong TĐT q. 16 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuận Thế Phái", "definition": "Lokayatika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Tiện", "definition": "順便. Êm xuôi dễ dàng. Như Thuận lợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Tình", "definition": "順情. Bằng lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuận Tín", "definition": "(順信, Junshin, ?-1250): vị Tăng của Chơn Tông sống vào giữa thời Liêm Thương, một trong 24 đệ tử xuất sắc của Thân Loan (親鸞), húy là Tín Hải (信海), hiệu là Thuận Tín Phòng (順信房), xuất thân vùng Ibaraki-ken (茨城縣). Tương truyền vì có điềm linh nghiệm rằng vị Minh Thần của Lộc Đảo (鹿島) quy y theo Thân Loan, nên Đại Cung Ty Tín Thân (信親) mới cho con mình là Tín Quảng (信廣) xuất gia theo Thân Loan. Rồi sau đó, ông đến làm trú trì Vô Lượng Thọ Tự (無量壽寺) ở Điểu Sài (鳥梄). Sau khi Thân Loan qua đời, ông truyền xướng cao phong của thầy mình ở các địa phương phía đông, và cùng với môn đồ Cao Điền (高田) duy trì giáo đoàn. Trước tác của ông có Hạ Dã Duyên Khởi (下野緣起) 2 quyển", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thuận Xả Thọ Nghiệp", "definition": "Upekśā-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuận Đức Đại Sư", "definition": "順 德 大 師. Hiệu của Thiền tăng Đạo Phó, đời Ngũ Đại. X. Đạo Phó.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuận Ưu Thọ Nghiệp", "definition": "Daurmanasya-vedaniya-karma (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuật", "definition": "沭. Tên sông, tức Thuật thuỷ, thuộc tỉnh Sơn Đông.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuật Lại", "definition": "Bhaṇati (bhaṇ + a), bhāsati (bhās + a), vadati (vad +a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuật Sĩ", "definition": "術士. Người có phù phép.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuật Số", "definition": "術數. Phép tính toán để đoán biết cuộc đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuế", "definition": "帨. Cái màn treo cửa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuế Má", "definition": "Bali (nữ), kara (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuế Nợ", "definition": "Nyāsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuế Y", "definition": "毳 衣. Áo lông. Bài thơ “Thạch Thất” của Huyền Quang (thiền sư Việt Nam) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thuốc", "definition": "Agadas (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuốc Dán", "definition": "Ālepa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuốc Nhỏ Mắt", "definition": "Añjana (trung), rasañjana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuốc Xổ", "definition": "Vireka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuộc", "definition": "属. Lối viết giản dị của chữ Thuộc 屬.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Hạ", "definition": "屬下. Người dưới quyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Liêu", "definition": "屬僚. Các quan cấp dưới. Như thuộc lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Lòng", "definition": "Paguṇa (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuộc Lại", "definition": "屬吏. Viên chức dưới quyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Quốc", "definition": "屬國. Một nước phụ vào nước khác, bị nước khác thống trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Tùy", "definition": "屬隨. Viên chức cấp dưới đi theo cấp trên. Truyện Hoa Tiên: “Tinh binh mười vạn thuộc tuỳ trăm viên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Viên", "definition": "屬員. Người làm việc cấp dưới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuộc Về Nghiệp", "definition": "Karmic.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuộc Địa", "definition": "屬地. Vùng đất bị nước khác thống trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuở Xưa", "definition": "Bhūtapubbaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thuỳ", "definition": "𠃀. Như chữ Thuỳ 垂.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuỳ Diên", "definition": "垂涎. Nhõ rãi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuỳ Lệ", "definition": "垂淚. Nhỏ nước mắt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuỵ", "definition": "睡. Nhắm mắt ngủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuỵ Miên", "definition": "Thīnamiddha (P), Dullness and drowsiness, Middha (S), Torpor, Thina-middha.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuỷ", "definition": "始. Đứa con mới lọt lòng mẹ Bắt đầu Mới. Vừa mới Cũng đọc Thuỷ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuỷ Chung", "definition": "始終. Lúc bắt đầu và lúc cuối cùng, ý nói trước sao sau vậy, lòmg dạ không thay đổi. Đoạn trường tân thanh: “Một lời vâng tạc đá vàng thuỷ chung”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thuỷ Thần", "definition": "Nāgavajra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thuỷ Tổ", "definition": "始祖. Người đầu tiên bắt đầu một dòng họ, hoặc một nghề nghiệp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành", "definition": "城. Bức tườngcao và dài đắp lên để ngăn giặc, bảo vệ cho một nơi dân cư đông đúc. Bản dịch Chinh phụ ngâm khúc: “Tên reo đầu ngựa giáo lan mặt thành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành - Trụ - Hoại - Không", "definition": "Theo vũ trụ quan Phật giáo, quá trình sinh diệt của một thế giới trải qua bốn thời kì – thuật ngữ Phật học gọi là “bốn kiếp” (tứ kiếp):", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thành Biện", "definition": "成 辦. Thành công. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thành Bại", "definition": "成敗. Nên việc và hỏng việc. Cung oán ngâm khúc: “Cuộc thành bại hầu cằn mái tóc”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Bất Nhị Luận", "definition": "Advayasiddhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Chiêm-Ba", "definition": "Campā (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Chiếu Tự", "definition": "(誠照寺, Jōshō-ji): ngôi chùa trung tâm của Phái Thành Chiếu Tự (誠照寺派) thuộc Chơn Tông, hiện tọa lạc tại số 3-2 Hon-chō (本町), Sabae-shi (鯖江市), Fukui-ken (福井縣), hiệu là Thượng Dã Sơn (上野山), thường được gọi là Chinh Giang Bản Sơn (鯖江本山), là một trong 4 ngôi chùa Tổ trung tâm ở vùng Việt Tiền (越前, Echizen). Tượng thờ chính của chùa là A Di Đà Như Lai. Phái Thành Chiếu Tự là một trong 10 phái lớn của Chơn Tông. Khi Thân Loan bị lưu đày đến vùng Việt Tiền, thể theo lời thỉnh cầu của vị hào tộc vùng này, ông thăng tòa thuyết pháp, nên người ta dựng cho ông một ngôi nhà trú ngụ tại đây. Từ đó, Đạo Tánh (道性) cùng với con là Như Giác (如覺) mới thành lập Chơn Chiếu Tự (眞照寺), và đến năm 1438 (Vĩnh Hưởng [永享] 10) thì chùa nhận được sắc phong của Hậu Hoa Viên Thiên Hoàng (後花園天皇, Gohanazono Tennō) với tên gọi cũng như hiệu chùa như hiện tại. Cũng có thuyết cho rằng Như Giác thành lập chúng môn đồ Sabae, rồi dựng nên chùa này. Vào năm 1583 (Thiên Chánh [天正] 11), trong vụ binh hỏa do Tướng Quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi) gây ra, chùa bị thiêu cháy tan tành, nhưng sau đó vị Tổ thứ đời thứ 14 và 15 của chùa là Tú Sơn (秀山), Tú Thành (秀誠) đã phục hưng lại được. Quần thể kiến trúc hiện tại được tái kiến vào năm 1877 (Minh Trị [明治] 10). Đến thời đại Giang Hộ, chùa phụ thuộc vào sự quản lý của Nhật Quang Luân Vương Tự (日光輪王寺), rồi đến thời Minh Trị thì bị lệ thuộc Thiên Thai Tông; nhưng sau đó chùa tách riêng ra và thành lập Phái Thành Chiếu Tự cho đến ngày nay.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thành Công", "definition": "成功. Nên việc. Xong việc một cách tốt đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Danh", "definition": "成名. Làm nên tiếng tăm, ý nói có địa vị cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Duy Thức Luận", "definition": "Vijnāptimātrata-siddhi-śāstra (S), Vijñāptimātra-siddhi-śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Duy Thức Luận Thuật Kí", "definition": "Gồm 20 quyển, do đại sư Khuy Cơ (632-682) soạn, được thu vào quyển 43 của Tạng Đại Chánh. Bộ sách này được soạn để chú giải bộ Thành Duy Thức Luận của đại luận sư Hộ Pháp (Dharmapala – ngài Huyền Trang dịch ra Hán văn), rất được các học giả về tông Pháp Tướng tán thưởng, coi đó thuộc loại thánh điển căn bản của Duy Thức Học.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thành Già Da", "definition": "City of Gaya", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thành Hiện", "definition": "成 現. Đầy đủ sẵn sàng, hàm ý vốn tồn tại, luôn luôn tồn tại, hiện tại cũng xem đến được, phần lớn chỉ cho Phật tính, thiền pháp. Tiết Luy Phong Sung Áo Thiền Sư trong NĐHN q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thành Hoàng", "definition": "Ch'eng-Huang (C), Chenghuang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Hôn", "definition": "成婚. Làm lễ cưới để trở nên vợ chồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Hạ", "definition": "城下. Ở chân bức thành. Hàn nho phong vị phú của Nguyễn Công Trứ: “Nơi thành hạ gieo cần câu cá”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Kiến", "definition": "成見. Cái ý nghĩ có sẵn về một sự việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Kiếp", "definition": "Vivarta-kalpa (S), Kṛta-yuga (P), Satya-yuga (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Kính", "definition": "誠敬. Coi trọngvà đối xử thật lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Luỹ", "definition": "城壘. Chỉ chung những bức tường cao và dày, đắp lên chống giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Lũy", "definition": "Pākāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thành Lập", "definition": "成立. Dựng nên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Ngữ", "definition": "成語. Câu nói có sẵn, đã trở nên như vậy rồi, không thể sửa đổi được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Nhân", "definition": "成人. Nên người Người đã lớn khôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Nhất Đạo", "definition": "Cheng-i tao (C), Way of Right Unity.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Niên", "definition": "成年. Tới tuổi lớn khôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Phần", "definition": "成分. Những phần nhỏ, làm nên một sự vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Phật", "definition": "Jōbutsu (J), Buddho-bavati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Phố Trên Núi", "definition": "Giurinaraga (S), A mountain city.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Phố Trên Trời", "definition": "Gagananagara (S), Town in the sky.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Quách", "definition": "城郭. Bức tường cao ở phía trong là Thành, bức tường thấp bao phía ngoài là Quách. Chỉ chung những bức tường cao và dày, đắp lên ngăn giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Sở Tác Trí", "definition": "Kṛtyanuthana-jñāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Thân", "definition": "成親. Làm lễ kết hôn. Đoạn trường tân thanh: “Thành thân rồi sẽ liệu về châu Thai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Thật Luận", "definition": "Satyasiddhi-śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Thật Tông", "definition": "Tông Thành Thật : là một trong 13 tông phái Phật giáo ở Trung-quốc (xem mục “Tông Thiên Thai”), lấy bộ Luận Thành Thật làm chỗ y cứ căn bản. Bộ Luận Thành Thật do ngài Ha Lê Bạt Ma trước tác, cho nên ngài đã được tôn làm vị sáng tổ của tông này. Danh xưng “Thành Thật” có nghĩa là xác lập tính chân thật của giáo lí Tứ Đế. Bộ luận này thuyết minh rằng, tất cả vũ trụ vạn hữu đều là những hiện tượng giả hợp, không có thật thể, cuối cùng đều trở về không; phải quán chiếu như thế thì mới thể hội được chân lí Bốn Sự Thật (Tứ Đế), rồi dùng tám nguyên tắc hành động chân chính (bát chánh đạo) để tận diệt phiền não, chứng nhập cảnh giới niết bàn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thành Thị", "definition": "城市. Nơi dân cư đông đúc, bên ngoài có thành bao bọc, bên trong có chợ buôn bán. Hát nói của Cao Bá Quát: “Kẻ thành thị kẻ vui niềm lâm tẩu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Thục", "definition": "成熟. Trở nên quen việc thạo việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Thử", "definition": "成此. Hoá nên. Vì vậy mà trở nên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Thực", "definition": "誠實. Thật lòng, không dối trá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Thực Luận", "definition": "Satyasaddhi śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Trì", "definition": "城池. Bức tường cao và dày đắp lên chống giặc, và rãnh nước ở bên ngoài để ngăn giặc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Tâm", "definition": "誠心. Lòng chân thành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thành Tín", "definition": "Śraddha (S), Conviction Saddha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Tôn", "definition": "(成尊, Seizon, 1012-1074): vị tăng của Chơn Ngôn Tông Nhật Bản, sống vào giữa thời Bình An, Tự Trưởng đời thứ 30 của Đông Tự, húy là Thành Tôn (成尊), hiệu Tiểu Dã Tăng Đô (小野僧都). Sau khi xuất gia với Nhân Hải (仁海) ở Mạn Trà La Tự (曼荼羅寺, Mandara-ji, tức Tùy Tâm Viện [隨心院]) vùng Tiểu Dã (小野, Ono), ông được thọ phép Quán Đảnh và làm trú trì chùa này. Đến năm 1065, ông hành phép cầu mưa và có linh nghiệm, sau đó ông lại cầu nguyện cho Hậu Tam Điều Thiên Hoàng (後三條天皇, Gosanjō Tennō, tại vị 1068-1072) tức vị, nên rất được sủng kính. Năm 1069, ông làm Quyền Luật Sư, đến năm 1072 thì truyền trao phép Quán Đảnh cho Minh Toán (明算) ở Cao Dã Sơn. Năm sau ông làm Quyền Thiếu Tăng Đô, và năm sau nữa thì làm Tự Trưởng của Đông Tự. Đệ tử của ông có Nghĩa Phạm (義範), Phạm Tuấn (範俊), v.v. Trước tác ông để lại có Chơn Ngôn Phú Pháp Toản Yếu Sao (眞言付法纂要抄) 1 quyển, Tiểu Dã Lục Thiếp Khẩu Quyết (小野六帖口決) 5 quyển, Quán Tâm Nguyệt Luân Ký (觀心月輪記) 1 quyển, Đồ Sư Quán Đảnh Quyết Nghĩa Sao (徒師灌頂決義抄) 4 quyển, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thành Tầm", "definition": "(成尋, Shōjin, 1011-1081): vị tăng của Thiên Thai Tông Nhật Bản, sang nhà Tống cầu pháp, cha là con của Đằng Nguyên Thật Phương (藤原實方), mẹ là con của Nguyên Tuấn Hiền (源俊賢); tuy nhiên cũng có nhiều thuyết khác nhau. Năm lên 7 tuổi, ông nhập môn xuất gia với Văn Khánh (文慶, Bunkei, sau này là Trưởng Lại của Viên Thành Tự [園城寺, Onjō-ji]) ở Đại Vân Tự (大雲寺, Daiun-ji) vùng Nham Thương (岩倉, Iwakura), kinh đô Kyōto và học giáo lý Hiển Mật. Sau đó, ông thọ pháp Thai Mật của Hành Viên (行圓, Gyōen) và Minh Tôn (明尊, Myōson); đến năm 1041 (niên hiệu Trường Cửu [長久] thứ 2) thì làm Biệt Đuơng (別當, Bettō) của Đại Vân Tự. Cùng lúc đó, ông còn làm vị tăng hộ trì cho vị Quan Bạch Đằng Nguyên Lại Thông (藤原賴通, Fujiwara-no-Yorimichi). Đến năm 62 tuổi (1072), ông mang bộ Vãng Sanh Yếu Tập (徃生要集) cũng như Tuần Lễ Ký (巡禮記) của Viên Nhân (圓仁, Ennin) và Điều Nhiên (奝然, Chōnen) sang nhà Tống, đi tham bái khắp các nơi, rồi tham gia dịch kinh ở Biện Kinh (汴京, Khai Phong [開封]) và được ban cho hiệu là Thiện Huệ Đại Sư (善慧大師) nhờ ông cầu mưa có linh nghiệm. Vì không được phép trở về nước, ông ủy thác cho đệ tử 527 quyển kinh mang về và cuối cùng qua đời tại Khai Bảo Tự (開寳寺), Phủ Khai Phong. Ngoài tác phẩm Tham Thiên Thai Ngũ Đài Sơn Ký (參天台五台山記), ông còn để lại một số trước tác khác như Quán Tâm Luận Chú (觀心論註), Pháp Hoa Kinh Chú (法華經註), v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thành Tựu", "definition": "Samanvagama (S), Samannagama (P), Sampana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Tựu Giác Huệ Bồ Tát", "definition": "Dhimat (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Tựu Giả", "definition": "Siddhi (P), Accomplished One drup top (T), ngodrup (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Tựu Pháp Man", "definition": "Sādhana-mala (S), Sadhana-samuccaya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Tựu Pháp Tập", "definition": "Sādhana-samuccaya (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Tựu Sự Mong Cầu", "definition": "Fullfil one's longings, to.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Vô Úy Luận", "definition": "Abhayasiddhi-śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành lũy của tâm, ví dụ thiền định, vì thiền định phòng vệ tâm có tác dụng ức chế vọng động, giống như thành lũy có công năng phòng ngự kẻ địch, nên gọi là Tâm thành. Thí Dụ này đồng nghĩa với thí dụ bờ đê nói trong Kinh Di Giáo. [X. Tứ Phần Luật San Phồn Bổ Khuyết Hành Sự Sao Q.thượng, phần 1].", "definition": "II.Tâm Thành.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thành Đạo", "definition": "Jōdō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thành Đẳng Minh Lượng", "definition": "成 等 明 亮. Thiền tăng đời Lê trung hưng, thuộc tông Lâm Tế, đời thứ 34, nối pháp Thiền Sư Nguyên Thiều Siêu Bạch, chưa rõ quê quán và hành trạng của sư… Có thể sư thọ giáo quy y với Hòa Thượng Minh Vật Nhất Tri ở chùa Kim Cang (Bình Thảo Đồng Nai), và sau đó thiền sư đến trụ trì chùa Đại Giác ở Đại Phố Đồng Nai (cù lao Phố, xã Hiệp Hòa, tỉnh Biên Hòa) sau này. Theo: LSPGĐTcủa Nguyễn Hiền Đức.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thác", "definition": "厝. Hòn đá mài Xem vần Thố.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thác Am Chí Minh", "definition": "(錯庵志明, Sakuan Shimyō, khoảng thế kỷ 12-13): vị tăng sống dưới thời nhà Kim, xuất thân An Châu (安州, An Tân, Tỉnh Hà Bắc), họ Hác (郝), tự là Bá Hôn (伯昏), hiệu Thác Am (錯庵), Lạc Chơn Tử (樂眞子), không rõ ngày tháng năm sinh và mất, cũng như tông phái. Ông đã từng viết cuốn Hoa Tiêu Nguyệt Tập (花標 月集), được vị Thủ Tòa Khiết khích lệ nên xuất gia, rồi nương theo Hương Lâm Tịnh (香林淨) thọ giới cụ túc. Sau đó, ông đến tham yết Thắng Tĩnh Phổ (勝靜普) và kế thừa dòng pháp của vị nầy. Ông đến trú tại Tung Sơn Thiếu Lâm Tự (嵩山少林寺), người đời thường gọi ông là Thác Am Chí Minh. Vào năm thứ 2 (1125) niên hiệu Đại Chánh (大正) đời vua Thái Tông nhà Kim, ông thâu tập tất cả hành trạng của chư vị tôn túc trong Thiền lâm, soạn thành tác phẩm Thiền Uyển Mông Cầu (禪 苑 蒙 求), hay còn gọi là Thiền Uyển Dao Lâm (禪苑瑤林) gồm 3 quyển cho những người sơ tâm học đạo.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thác Bác", "definition": "Piṇḍapata (P), Going for almsfood.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thác Chi", "definition": "拓 枝. Tên một điệu múa. Điệu múa này được trang trí bằng hai hoa sen lớn bằng giấy, hai cô gái đứng trong hoa sen; tời giờ múa hai hoa sen nở ra và 2 cô đứng múa trong ấy. Phần Tụng cổ trong Tuệ Trung Thượng Sĩ Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thác Chất", "definition": "(托質): đồng nghĩa với thác sanh (托生), thác thai (s: garbhāvakrānti, p: gabbhāvakkanti, 托胎), tức thác sanh vào trong bào thai mẹ, hoặc chỉ cho sự thác sanh vào trong hoa sen ở thế giới Cực Lạc. Như trong Phật Thuyết A Di Đà Kinh Yếu Giải (佛說阿彌陀經要解) của Ngẫu Ích Trí Húc (蕅益智旭, 1599-1655) có đoạn: “Di Đà thánh chúng, bất lai nhi lai, thân thùy tiếp dẫn, hành nhân tâm thức, bất vãng nhi vãng, thác chất bảo liên hoa dã (彌陀聖眾、不來而來、親垂接引、行人心識、不徃而徃、托質寶蓮也, đức Phật Di Đà và thánh chúng, không đến mà đến, gần gủi tiếp dẫn, tâm thức hành giả, không đi mà đi, thác sanh vào hoa sen báu).” Hay trong Ngẫu Ích Đại Sư Tịnh Độ Tuyển Tập (蕅益大師淨土選集), phần Truyện Ký, Tụng Chửu Sư Vãng Sanh Truyện (誦帚師徃生傳) có đoạn: “Sư toại thị tật, triệu dư trợ kỳ niệm Phật, mạng thị giả trừ phát dục thân; dục tất, đoan tọa, cử thủ nhi thệ, chánh niệm phân minh, thần thanh khí định; việt nhị thời, đảnh hiển thượng noãn, thác chất liên nhụy, vô nghi dã (師遂示疾、召予助其念佛，命侍者除发浴身；浴毕、端坐，举手而逝。召予助其念佛、命侍者除發浴身、浴畢、端坐、舉手而逝、正念分明，神清气定。正念分明、神清氣定、越二时，顶显尚暖。越二時、頂顯尚暖、托质莲蕊，无疑也。托質蓮蕊、無疑也, sư bèn cáo bệnh, mời tôi đến giúp sư niệm Phật, sai thị giả xuống tóc, tắm rửa thân thể; tắm xong, sư ngồi ngay ngắn, vẩy tay chào mà đi, chánh niệm rõ ràng, thần khí trong sáng, định tĩnh; trãi qua hai thời gian, trên đỉnh đầu sư vẫn còn ấm, quả là thác sanh vào nhụy hoa sen, chẳng còn nghi ngờ gì cả).” Cũng như trong Sanh Tử Quan Toàn Tập (生死關全集), Thiên Chuyển Nữ Thành Nam (轉女成男篇) do Cư Sĩ Trần Do Bân (陳由斌) biên soạn có câu: “Cánh hữu dị phương tiện, chuyên niệm A Di Đà, thác chất diệu Liên Hoa, tật đắc bất thối chuyển (更有異方便、專念阿彌陀、托質妙蓮華、疾得不退轉, lại có phương tiện khác, chuyên niệm A Di Đà, thác sanh hoa sen mầu, mau được không thối chuyển).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thác Ngôn", "definition": "託言. Đặt điều mà nói ra. Mượn lời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thác Ngộ", "definition": "錯誤. Sai lầm. Lầm lẫn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thác Thai", "definition": "Garbhāvakranti (S), Gabbhāvakkanti (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thác Thực", "definition": "託食. Ăn nhờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thác Tuý", "definition": "託醉. Giả say để làm điều gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thác Túc", "definition": "託足. Gửi chân, ý nói sống nhờ ở đậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thác Tử", "definition": "橐 子. Cái khay, cái mâm. Tiết Tùng Sơn Hòa Thượng trong NĐHN q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thác Ấm", "definition": "(托蔭): được che chở, bảo hộ, nhờ ơn, thác sanh. Như trong tiểu thuyết Duyệt Vi Thảo Bút Ký (閱微草堂筆記), chương Hòe Tây Tạp Chí (槐西雜志) 1 của Kỷ Quân (紀昀, 1724-1805) nhà Thanh có câu: “Kim hạnh thác ấm đắc nhất quan, tương cát cư doanh truân tịch hỉ (今幸托蔭得一官、將拮据營窀穸矣, nay may được che chở làm chức quan, sau gặp lúc cùng đường thì đào huyệt mộ vậy).” Hay trong Cao Phong Long Tuyền Viện Nhân Sư Tập Hiền Ngữ Lục (高峰龍泉院因師集賢語錄, 卍 Tục Tạng Kinh Vol. 65, No. 1277) quyển 4, phần Ca Dương Tán Phật Môn (歌揚讚佛門), Kiều Cổ Xã (喬鼓社), có đoạn: “Thích Ca thị chơn từ phụ, hóa hiện thân hình ly bổ xứ, giá bạch tượng thừa vân khứ, hướng hoàng cung thác ấm Ma Da, cửu long thổ thủy kim bồn dục (釋迦是眞慈父、化現身形離補處、駕白象乘雲去、向皇宮托蔭摩耶、九龍吐水金盆浴, Thích Ca đúng là cha lành, hóa hiện thân hình rời bổ xứ, cỡi voi trắng nương mây đi, hướng hoàng cung gởi chất Ma Da, chín rồng phun nước bồn vàng tắm).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái", "definition": "埰. Ngôi mộ lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái A Kiếm", "definition": "太 阿 劍. Một loại gươm quý, dụ cho cơ phong nhà Thiền. Lai lịch của thanh gươm này như sau: Lôi Hoán làm chức Huyện Lệnh ở Phong thành, huyện Dự Chương, thường thấy luồng khí màu tía ở khoảng giữa sao Ngưu và sao Đẩu. Ông cho đó là khí của thanh kiếm quý bốc lên. Sau đó, ông đào nền nhà ngục quả nhiên gặp một chiếc hòm đá đựng 2 thanh kiếm: một có khắc tên Long Tuyền, một có khắc tên Thái A. Phần lời bình của tắc 1 trong Bích Nham Lục (Vạn Tục 117, 129 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Bình", "definition": "太平. Rất yên ổn, không có chuyện gì xảy ra. Thơ Nôm đời Hồng đức: “Lừng lẫy cùng ca khúc thái bình” Tên một tỉnh ở Bắc phần Việt Nam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Bình Dương", "definition": "太平洋. Tên vùng biển lớn, giữa Á châu và Mĩ châu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Bình Hưng Quốc Tự", "definition": "(太平興國寺, Taiheikōkoku-ji): ngôi danh lam cổ sát hiện tọa lạc trong Ngưỡng Sơn (仰山), cách 80 dặm về phía Nam Huyện Nghi Xuân (宜春縣), Viên Châu (袁州, Tỉnh Giang Tây). Cùng với Quy Sơn (潙山), nơi đây là vùng đất phát xuất của Quy Ngưỡng Tông (潙仰宗). Huệ Tịch (慧寂) là người khai sơn ra chùa này. Nó được kiến lập trong khoảng niên hiệu Hội Xương (會昌, 841-846), ban đầu có tên là Thê Ẩn Tự (棲隱寺) và đến thời nhà Tống thì được đổi thành Thái Bình Hưng Quốc Tự.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Bình Đạo", "definition": "T'ai-ping tao (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Bạch", "definition": "太白. Tên một ngôi sao (Kim Tinh).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Bạch Sơn", "definition": "(太白山): tên gọi khác của Thiên Đồng Sơn (天童山), nơi Như Tịnh trú ngụ. Thái Bạch còn là tên gọi của vị trú trì ở Thiên Đồng Sơn, tức Như Tịnh.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Bạch Tinh", "definition": "Xem Ô Sá.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Chính Quan", "definition": "(太政官, Daijōkan, Ōimatsurigoto-no-Tsukasa): (01) Cơ quan hành chính tối cao trong Luật Lịnh Quan Chế (律令官制), quản chưởng 8 Bộ trở xuống, chuyên trách toàn thể chính vụ. Hàng ngũ quan công khanh được hình thành bởi Thái Chính Đại Thần (太政大臣), Tả Hữu Đại Thần (左右大臣), Đại Nạp Ngôn (大納言, sau này còn có Trung Nạp Ngôn [中納言], Tham Nghị [參議]). Cục Thiếu Nạp Ngôn (少納言局), Cục Tả Hữu Biện Quan (左右辨官局) xử lý về mặt sự vụ kết quả phiên nghị quốc chính của các quan công khanh ấy. Cục Thiếu Nạp Ngôn thì quản lý Cục Ngoại Ký (外記局), chuyên trách về việc tuyên hạ những sắc chiếu, đóng nội ấn, ngoại ấn. Trong khi đó, Cục Tả Hữu Biện Quan thì thống lãnh cả 8 Bộ và chấp hành sự vụ hành chính. Từ cuối thời Bình An trở đi, cơ quan này hữu danh mà vô thật và vẫn tồn tại cho đến cuối thời kỳ Mạc Phủ. (02) Thái Chính Quan (太政官, Dajōkan), cơ quan tối cao của chính phủ vào đầu thời Minh Trị. Nhân phong trào Vương Chính Phục Cổ (王政復古) vào tháng 12 năm 1867 (Khánh Ứng [慶應] 3), việc phục hưng Thái Chính Quan được tiến hành; cho nên vào tháng 1 năm sau, cơ quan đại diện Thái Chính Quan được thiết lập; rồi đến tháng 4 nhuận, trong Chính Thể Thư (政体書), chức chế của Thái Chính Quan được quy định rõ ràng. Về mặt hình thức thì có 3 chức quan gồm: Nghị Chính Quan (議政官, lập pháp), Hành Chính Quan (行政官, hành chính) và Hình Pháp Quan (刑法官, tư pháp); rồi bên dưới Thái Chính Quan còn có 4 chức quan khác như Thần Kỳ (神祇), v.v. Vào năm 1869 (Minh Trị [明治] 2), dưới Thái Chính Quan và Thần Kỳ Quan lại có thêm 6 Bộ. Trong Thái Chính Quan có Chính Viện (政院), Tả Viện (左院), Hữu Viện (右院). Về sau, hai viện tả hữu bị phế bỏ; thay vào đó là Nguyên Lão Viện (元老院) và Đại Thẩm Viện (大審院). Cuối cùng, vào năm 1885 (Minh Trị 18), cơ quan này bị phế bỏ hẳn và sát nhập vào chế độ Nội Các", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Chính Quan Phù", "definition": "(太政官符, Daijōkampu): trên cơ sở chế độ luật lịnh của nhật bản ngày xưa, đây là bức công văn do vị quan Thái Chính (太政) phát lệnh đến các công sở của những quan hạ cấp, hay công sở của các tiểu quốc vốn trực thuộc quyền quản hạt của vị này. Văn thư này được gởi đến các cơ quan chính vụ nói trên để phát huy hiệu lực công việc thực tế. Dưới thời đại Bình An (平安, Heian), để được thừa nhận các trang viên mới lập, cần phải có Thái Chính Quan Phù hay Dân Bộ Tỉnh Phù (民部省符, văn thư của Dân Bộ Tỉnh [tương đương với Bộ Ngân Khố ngày nay]); cho nên các trang viên như vậy được gọi là Quan Tỉnh Phù Trang (官省符莊, trang viên được cấp văn thư công nhận của quan phủ). Đến cuối thời Bình An, Quan Phù này bị phế bỏ và được thay thế bằng một hình thức đơn giản hơn là Quan Tuyên Chỉ (官宣旨), hay Tuyên Chỉ (宣旨, chiếu chỉ tuyên bố của Thiên Hoàng).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Cô Nguy Sinh", "definition": "太 孤 危 生. Cao chót vót. Thái: rất, cô nguy: ngọn núi hiểm trở, sinh: tiếp vĩ ngữ. Thiền Tông dùng từ này để chỉ cho cơ phong lanh lợi luôn luôn hướng thượng, không phải chỗ nói năng suy nghĩ đến được. Phần Thùy thị của tắc 3 trong Bích Nham Lục (Đại 48, 142 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Cổ", "definition": "太古. Thời rất xa xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Cực", "definition": "T'aichi (C), Supreme Ultimate Energy.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Cực Đồ", "definition": "T'ai-chi-t'u (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Diễn", "definition": "(泰演, Taien, ?-?): vị tăng của Pháp Tướng Tông Nhật Bản, sống vào đầu thời kỳ Bình An, húy Thái Diễn (泰演). Ông từng học cả Đại Thừa lẫn Tiểu Thừa, đặc biệt tinh thông về Pháp Tướng và Duy Thức. Trong thời gian niên hiệu Đại Đồng (大同, 806-810), ông trú tại Tây Đại Tự (西大寺, Saidai-ji) và tuyên dương Pháp Tướng Tông. Năm 840, ông làm giảng sư của Duy Ma Hội (維摩會). Cuộc luận tranh giữa ông với An Trừng (安澄, Anchō) về vấn đề có không đã trở thành nổi tiếng.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Dương", "definition": "太陽. Mặt trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Dương Cảnh Huyền", "definition": "Taiyō Keigen (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Dương Hệ", "definition": "Cakkavāla (nam), dinapati (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thái Dương Tinh", "definition": "Xem Mặt trời.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Dục", "definition": "太 毓 (747-826). Thiền tăng đời Đường, họ Phạm, người xứ Kim Lăng (nay là Nam Kinh) Trung Quốc. Xuất gia từ thuở bé, sư thờ Thiền Sư Huệ Trung ở núi Ngưu Đầu làm thầy, dũng mãnh tinh tấn, cầu huyền chỉ của Ngài. Sư đến chùa An Quốc ở Ung Kinh, thụ giới cụ túc. Tham yết Mã Tổ Đạo Nhất và đắc pháp. Niên hiệu Nguyên Hòa thứ 13 (818), sư dừng chân ở núi Phù Dung, Nghĩa Hưng (nay là huyện Nghi Hưng tỉnh Giang Tô), người học bốn phương hướng về. Từ đấy ở Giang Nam là nơi có nhiều người ngộ thiền lý. Thụy hiệu: Đại Bảo Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Hoà", "definition": "太和. Rất êm đềm. Hát nói của Nguyễn Công Trứ: “Cõi đời mở mặt giang san thái bình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Hư", "definition": "T'ai-hsu (C), Taixu (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Hậu", "definition": "太后. Bà mẹ của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Khâm", "definition": "泰 欽 (910-974). Thiền tăng đời Ngũ Đại, họ Quý người xứ Ngụy Phủ (nay là huyện Đại Danh, tỉnh Hà Bắc) Trung Quốc, nối pháp Thiền Sư Thanh Lương Văn Ích, thuộc tông Pháp Nhãn. Sư ở viện Song Lâm, Hồng Châu (nay là huyện Nam Xương, tỉnh Giang Tây) rồi dời đến viện Hộ Quốc ở Thượng Lam. Sư nhận lời mời của Nam Đường Hậu Chủ, trụ trì Đại đạo tràng Thanh Lương ở Kim Lăng, nối tiếp pháp hệ tông Pháp Nhãn. Sư biện tài vô ngại, thiền tăng trong nước hướng về đều cho rằng sư là bậc Thầy thông sáng. Hiệu: Pháp Đăng Thiền Sư.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Kinh Nhập Đạo", "definition": "(泰經入道, Taikyō Nyūdō, ?-1201): tức là Cao Giai Thái Kinh (高階泰經), con của Trưởng Quan Kami vùng Nhược Hiệp (若狹, Wakasa, nay là Fukui-ken [福井縣]), tên Thái Trọng (泰重), làm quan đến chức Chánh Tam Vị. Ông xuất gia vào ngày mồng 6 tháng 9 năm thứ 8 (1197) niên hiệu Kiến Cửu (建久), qua đời ngày 23 tháng 11 năm đầu (1201) niên hiệu Kiến Nhân (建仁).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Liêu", "definition": "寀 寮. Từ chỉ chung các vị quan chức, quan lại. Pháp Diễn Ngữ Lục q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Miếu", "definition": "太廟. Nhà thờ tổ tiên của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Nguyên", "definition": "Phu Tai yuan Pu (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Phó", "definition": "太傅. Chức quan đứng thứ nhì trong hàng Tam công (Thái sư, Thái phó, Thái bảo). Thơ Nguyễn Khuyến: “Mòn câu Thái phó tảng rêu tròn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Phạm", "definition": "(泰範, Taihan, 778-?): một trong 10 vị đại đệ tử của Không Hải (空海, Kūkai). Ban đầu ông xuất gia ở Nguyên Hưng Tự (元興寺, Gankō-ji), rồi sau đó theo hầu Tối Trừng (最澄, Saichō) trên Tỷ Duệ Sơn (比叡山, Hieizan). Năm 810, ông làm Tổng Biệt Đương (總別當) của Tỷ Duệ Sơn, cùng với Tối Trừng định ra quy chế Thiền môn. Vào năm 812, ông cùng với Tối Trừng và đồ chúng đến Cao Hùng Sơn Tự (高雄山寺) tự thọ lễ Quán Đảnh với Không Hải. Sau đó, ông không nghe lời khuyên của thầy để trở về núi mà theo hầu Không Hải để học về Mật Giáo, trở thành một trong mấy vị đại đệ tử của Không Hải và tận lực khai sáng Cao Dã Sơn (高野山, Kōyasan).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Quá", "definition": "太過. Vượt khỏi mức thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Sát", "definition": "太 殺. Rất ghê gớm. Tiết Vân Môn Văn Yển Thiền Sư trong NĐHN q. 15 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Sơn", "definition": "T'ai-shan (C), Mount T'ai.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Sơn Nương Nương", "definition": "T'ai-shan Niang-niang (C), Taishan Niangniang (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Thô Sinh", "definition": "太 粗 生. Thô lỗ quá! Thái là rất, thô là bạo, sinh là tiếp vĩ ngữ. Trong Thiền Tông thường mượn từ này để quở trách người tu hành chưa viên mãn mà có cử chỉ không thận trọng. Lâm Tế Ngữ Lục (Đại 47, 503) trung) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Thượng Lão Quân", "definition": "T'ai-shang Lao-chun (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Thốc", "definition": "(太簇、太蔟、泰簇): còn gọi là Thái Tộc (太族、泰族), Đại Tộc (大族), Đại Thốc (大蔟), có hai nghĩa chính.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Tuế", "definition": "(太歲): Mộc Tinh (木星, Jupiter), còn gọi là Tuế Tinh (歲星), Thái Âm (太陰), Tuế Âm (歲陰), Tuế Quân (歲君), Thái Tuế Tinh Quân (太歲星君), là tên gọi của vị thần trong Đạo Giáo Trung Quốc. Ngày xưa ngôi sao này được dùng để đếm tuổi nên có tên gọi như vậy, về sau biến thành một loại tín ngưỡng thần linh. Thái Tuế còn là tên của một trong Lưu Niên Tuế Số Thập Nhị Thần Sát (流年歲數十二神煞), lưu hành trong 12 tháng, với câu kệ là: “Thái Tuế đương đầu tọa, chư thần bất cảm đương, tự thân vô khắc hại, tu dụng khốc đa dương (太歲當頭坐、諸神不敢當、自身無剋害、須用哭爹娘, Thái Tuế ngay đầu tọa, các thần chẳng dám chường, tự thân không nguy hại, nên thương khóc mẹ cha).” Sao này có công năng đè ép các sao Thần Sát, người gặp sao này nếu gặp vận thì xấu nhiều tốt ít, chủ yếu gặp tai nạn bất trắc, nên làm việc phước thiện. Trong dân gian thường có từ “phạm Thái Tuế (犯太歲)”, “xung Thái Tuế (衝太歲)”, “hình Thái Tuế (刑太歲)” hay “thiên xung Thái Tuế (偏衝太歲)”. Tỷ dụ như năm nay là năm con Tỵ (巳, con rắn), người tuổi con rắn là phạm Thái Tuế, tuổi Hợi (亥, con heo) là xung Thái Tuế; tuổi Thân (申, con khỉ) và Dần (寅, con cọp) là thiên xung Thái Tuế. Vì vậy, có câu ngạn ngữ rằng: “Thái Tuế đương đầu tọa, vô hỷ khủng hữu họa (太歲當頭坐、無喜恐有禍, Thái Tuế trên đầu ngự, chẳng vui e có họa).” Cho nên, người ta có tục lệ An Thái Tuế (安太歲), tức cúng sao giải hạn, cầu nguyện được vạn sự bình an, cát tường. Ngay từ buổi đầu, tục lệ An Thái Tuế rất giản dị. Tín đồ nào muốn cúng An Thái Tuế thì nên nhân dịp trước hay sau tiết Xuân, lấy giấy màu hồng hay vàng viết lên dòng chữ như “Bổn niên Thái Tuế Tinh Quân đáo thử (本年太歲星君到此, năm nay Thái Tuế Tinh Quân đến đây)”, “Bổn niên Thái Tuế Tinh Quân thần vị (本年太歲星君神位, thần vị của Thái Tuế Tinh Quân năm nay)”, “Nhất tâm kính phụng Thái Tuế Tinh Quân (一心敬奉太歲星君, một lòng kính thờ Thái Tuế Tinh Quân)”, đem dán trong nhà, hằng ngày dâng hương cầu khấn. Đến cuối năm, nên đem giấy đó ra đốt với ý nghĩa là “tiễn Thần lên Trời.” Tương truyền trong vòng 60 năm, mỗi năm Trời phái một vị thần phụ trách năm ấy, quản lý toàn bộ việc phước họa của con người. Cho nên, trong thời gian 60 năm ấy có 60 vị Thái Tuế. Tín ngưỡng này có từ thời Nam Bắc Triều (南北朝, 220-589), và đến đầu thời nhà Thanh (清, 1616-1911) thì có tên họ rõ ràng của 60 vị thần Thái Tuế Tinh Quân. Tên của mỗi vị ứng vào các năm như sau:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thái Tông Hoàng Đế", "definition": "Tai-tsung (C), Daizong (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Tử", "definition": "太子. Con trai lớn của vua, và Hoàng hậu Người con trai vua, được lựa chọn để nối ngôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Tử Kỳ Đà", "definition": "Jita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Tử Tam Phi", "definition": "太子三妃 (Kinh Thuỵ ứng và Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thái Vũ Đế", "definition": "(408-452): tức là vua đời thứ ba của nhà Bắc-Ngụy (386-534) thuộc thời đại Nam-Bắc-triều (420-589). Ông tên là Thác-bạt Đào, tộc người Tiên-ti, có hùng tài đại lược, giỏi dùng binh. Sau khi lên ngôi, ông đã đuổi được giống người Nhu-nhiên ra khỏi bờ cõi, thôn tính đất đai của giống Hung-nô, tiêu diệt các tiểu quốc Bắc-Yên, Tây-Lương và Tây-Hạ, thống nhất trọn vùng Giang-bắc, chia hai lãnh thổ Trung-quốc, mở ra thời đại Bắc-triều, đối lập với Nam-triều. Lúc mới lên ngôi, ông kế thừa chính sách đối với Phật giáo của hai vua Thái-tổ (Đạo-vũ đế Thác-bạt Khuê, 386-409) và Thái-tông (Minh-nguyên đế Thác-bạt Tự, 409-423), sùng tín Phật pháp, kính lễ sa môn. Ông cũng đã thỉnh đại sư Huyền Cao (402-444) làm thầy của thái tử Thác-bạt Hoảng. Nhưng tể tướng Thôi Hạo (?-450) lại là tín đồ Đạo Giáo, kết đảng với đạo sĩ Khấu Khiêm Chi (365-448), thường dèm pha, nói xấu Phật giáo ở trước mặt vua, làm cho vua cũng thấy xiêu lòng, nghi ngờ Phật giáo, chuyển sang tin Đạo Giáo.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thái Y", "definition": "太醫. Chức quan coi việc chữa bệnh cho hoàng gia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Âm", "definition": "太陰. Một tên chỉ mặt trăng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Âm Tinh", "definition": "Xem Tô Ma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thái Đầu", "definition": "菜 頭. Vị tăng phụ trách việc cung cấp rau cải trong thiền viện. “Thiền môn quy thức” trong CĐTĐL q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thái Độ", "definition": "態度. Dáng dấp và vẻ mặt bên ngoài nhờ đó biết được lòng dạ bên trong.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thái Ấp", "definition": "采邑. Đất vua cấp cho quan để hưởng hoa lợi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thám", "definition": "嗿. Tiếng ăn uống ồn ào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thám Can, ảnh Thảo", "definition": "探 竿 影 草. Mồi câu, dề cỏ. Còn gọi: Thám thảo. Cây trúc dò dẫm, bóng cỏ. Bậc Thầy kiến tính dò xét người học bằng cách sử dụng tiếng hét loại này để thử nghiệm trình độ của người học. Đây là 1 trong 4 loại hét. Thám can ảnh thảo, nghĩa đen có 2:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thám Hiểm", "definition": "探險. Dò thăm những chỗ khó khăn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thám Hoa", "definition": "探花. Tên gọi bậc đậu thứ ba trong khoa thi Đình thời xưa. Phú hỏng thi của Trần Tế Xương: “Nào ai ngờ chữ tốt văn hay, tài Bảng nhỡn Thám hoa lỡ ra cũng hỏng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thám Thính", "definition": "探聽. Dò xét nghe ngóng để biết sự thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thám Tử", "definition": "探子. Người làm công việc dò xét sự thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thám Đầu", "definition": "探 頭. Sự khám biện, dò xét của thiền sư. Lâm Tế Lục (Đại 47, 496 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thán", "definition": "嘆. Than thở. Td: Oán thán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thán Hoạ", "definition": "炭畫. Ngành vẽ tranh bằng than.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thán Khí", "definition": "炭氣. Chất hơi do than bị đốt mà bốc ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thán Tích", "definition": "嘆惜. Than tiếc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thán Tức", "definition": "嘆息. Than thở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thán Đầu", "definition": "炭 頭. Vị tăng trông coi than củi trong ba tháng lạnh tại thiền viện. Sắc Tu Bách Trượng Thanh Quy q. 4 (Đại 48, 1233 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháng", "definition": "Māsa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tháng Ba Âm Lịch", "definition": "Có tên gọi khác như Mộ Xuân (暮春), Mạt Xuân (末春), Quý Xuân (季春), Vãn Xuân (晚春), Diểu Xuân (杪春), Khiết Xuân (褉春), Tàm Nguyệt (蠶月), Hoa Nguyệt (花月), Đồng Nguyệt (桐月), Đào Nguyệt (桃月), Quái Nguyệt (夬月), Gia Nguyệt (嘉月), Thần Nguyệt (辰月), Đạo Nguyệt (稻月), Anh Duẩn Nguyệt (櫻筍月), Cô Tẩy (姑洗), Đào Lãng (桃浪), Vu Phong (雩風), Ngũ Dương Nguyệt (五陽月), Đào Quý Nguyệt (桃季月), Hoa Phi Nguyệt (花飛月), Tiểu Thanh Minh (小清明), Trúc Thu (竹秋), Phu Nguyệt (夫月), Mộ Nguyệt (暮月), Thần Nguyệt (辰月), Oa Nguyệt (窩月), Tú Nguyệt (宿月), Thương Nguyệt (商月), Anh Nguyệt (莫月), Linh Nguyệt (靈月), Vân Nguyệt (雲月). Một số câu hay cho tháng Ba như phụng tình hoa tín (鳳情花信, phụng quyến luyến tin tức hoa nở), vũ trạc xuân trần (雨濯春塵, mưa tẩy sạch bụi Xuân), bình tinh điểm lục (萍星點綠, bèo trôi điểm màu xanh), đào vũ phiên hồng (桃雨翻紅, mưa Đào phất phơ màu hồng), tuế hàn linh tiết (歲寒令節, năm rét tiết khó), cấm hỏa lương thần (禁火良辰, cấm lửa dịp tốt). Một số từ dùng cho Tiết Thanh Minh như liễu yên ngưng thoại (柳煙凝瑞, khói liễu đọng điềm lành), lan bội nghênh hy (蘭佩迎禧, ngọc đeo đón điều tốt), xuân thâm bích hải (春深碧海, Xuân sâu thẳm như biển xanh), hoa mãn thiên trì (花滿天池, hoa đầy khắp hồ Trời), phong hoa chánh tú (風花正秀, hoa gió rực rỡ), đồng quan du xuân (童冠遊春, trẻ đội mũ đi chơi Xuân), Lê hoa lạc viện (梨花落院, hoa Lê rơi rụng nơi tòa viện), liễu nhứ phi tường (柳絮飛牆, tơ liễu bay qua tường). Các từ dùng cho tháng Ba nhuận như Tam Xuân nghi cửu (三春宜久, ba tháng mùa Xuân vẫn còn lâu), nhuận quy trừ tận (潤歸除盡, ẩm ướt về dứt sạch). Từ ngữ dùng cho truy điệu vào tháng này là oanh đề hoa lão (鶯啼花老, oanh khóc hoa già cỗi), điệp trướng xuân tàn (蝶悵春殘, bướm buồn Xuân tàn tạ).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Bảy Âm Lịch", "definition": "Có tên gọi khác như Mạnh Thu (孟秋), Thủ Thu (首秋), Thượng Thu (上秋), Qua Thu (瓜秋), Tảo Thu (早秋), Tân Thu (新秋), Triệu Thu (肇秋), Lan Thu (蘭秋), Lan Nguyệt (蘭月), Thân Nguyệt (申月), Xảo Nguyệt (巧月), Qua Nguyệt (瓜月), Lương Nguyệt (涼月), Tương Nguyệt (相月), Văn Nguyệt (文月), Thất Tịch Nguyệt (七夕月), Nữ Lang Hoa Nguyệt (女郎花月), Văn Phi Nguyệt (文披月), Đại Khánh Nguyệt (大慶月), Tam Âm Nguyệt (三陰月), Di Tắc (夷則), Sơ Thương (初商), Mạnh Thương (孟商), Qua Thời (瓜時), Tố Thu (素秋), Sơ Thu (初秋), Sương Nguyệt (霜月), Trung Nguyệt (中月), Triệu Nguyệt (肇月). Một số câu hay cho tháng Bảy như vân thu Hạ sắc (雲收夏色, mây thâu sắc màu mùa Hè), nguyệt động Thu thanh (月動秋聲, trăng làm động tiếng Thu), kim phong đãng thử (金風蕩暑, gió Thu quét phăng đi hơi nóng), ngọc luật minh Thu (玉律鳴秋, nhạc ngọc vang vọng mùa Thu), kiểu nguyệt như sương (皎月如霜, trăng sáng như sương), Thu khai ngọc vũ (秋開玉宇, Thu mở nhà ngọc), luật ứng thanh cao (律應清高, nhạc vận thanh cao), thủy thiên nhất sắc (水天一色, nước và trời cùng một sắc màu), phong nguyệt song thanh (風月雙清, gió và trăng đều trong suốt), tam canh thử thối (三更暑退, ba canh oi bức thối lui), nhất chẩm lương sanh (一枕涼生, bên gối hưởng gió mát). Một số từ dùng cho Thất Tịch (七夕) như nhân gian khất xảo (人間乞巧, mọi người xin trí tuệ khôn ngoan), thiên thượng giai kỳ (天上佳期, thời kỳ tốt trên trời). Một số từ dùng cho tháng Bảy nhuận như song tinh nhất hội (雙星一會, hai sao cùng gặp nhau), nhất nhuận quy dư (一閏歸餘, một lần nhuận vẫn còn dư). Một số từ dùng cho truy điệu vào tháng này như thiền thanh đề mộ (蟬聲啼暮, tiếng ve khóc chiều), cùng vận bi Thu (蛩韻悲秋, tiếng dế buồn mùa Thu)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Chín Âm Lịch", "definition": "Có tên gọi khác như Cúc Nguyệt (菊月), Thọ Y Nguyệt (授衣月), Thanh Nữ Nguyệt (青女月), Tiểu Điền Nguyệt (小田月), Bác Nguyệt (剝月), Quán Nguyệt (貫月), Sương Nguyệt (霜月), Trưởng Nguyệt (長月), Tuất Nguyệt (戌月), Hủ Nguyệt (朽月), Vịnh Nguyệt (詠月), Huyền Nguyệt (玄月), Nỉ Giác Nguyệt (禰覺月), Cúc Khai Nguyệt (菊開月), Hồng Diệp Nguyệt (紅葉月), Quý Thu (季秋), Mộ Thu (暮秋), Vãn Thu (晚秋), Cúc Thu (菊秋), Thu Mạt (秋末), Tàn Thu (殘秋), Lương Thu (涼秋), Tố Thu (素秋), Ngũ Âm Nguyệt (五陰月), Cùng Thu (窮秋), Diểu Thu (杪秋), Thu Thương (秋商), Mộ Thương (暮商), Quý Bạch (季白), Vô Xạ (無射), Sương Tự (霜序), Lương Nguyệt (涼月), Tam Thu (三秋), Quý Thương (季商), Cúc Tự (菊序). Một số câu hay cho tháng Chín như hà bàn lạc thúy (荷盤落翠, gương sen không còn sắc xanh biếc), phong cảnh phiêu hồng (楓景飄紅, cảnh cây phong phất phơ màu hồng), giang phong huyến cẩm (江風絢錦, gió sông rực rỡ gấm), ly cúc thư kim (籬菊舒金, cúc bờ rào phô màu vàng óng). Một số từ dùng cho tiết Trùng Dương (重陽) như Tam Thu hầu túc (三秋候足, khí tiết Ba Thu vừa đủ), vạn bảo cáo thành (萬寶告成, muôn điều quý báu đã thành), hoàng hoa mãn kính (黃花滿徑, hoa vàng khắp lối), hồng diệp doanh câu (紅葉盈溝, lá đỏ đầy rãnh nước), thư truyền tặng cúc (書傳贈菊, thư truyền đi tặng hoa cúc), Mạnh Gia lạc mạo (孟嘉落帽, Mạnh Gia rơi mũ), Hoàn Cảnh đăng cao (桓景登高, Hoàn Cảnh lên núi cao), sương lăng cúc nhị (霜淩菊蕊, sương thấm nhụy hoa cúc), tửu túy Thù Du (酒醉茱萸, rượu say Thù Du). Một số từ dùng cho truy điệu vào tháng này như cùng thanh bi thiết (蛩聲悲切, tiếng dế buồn da diết), nhạn trận hoành không (雁陣橫空, nhạn dàn trận trên không)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Giêng Âm Lịch", "definition": "Có tên gọi khác như Nguyệt Chánh (月正), Tân Chánh (新正), Mạnh Xuân (孟春), Thủ Xuân (首春), Thượng Xuân (上春), Dần Mạnh Xuân (寅孟春), Thỉ Xuân (始春), Tảo Xuân (早春), Nguyên Xuân (元春), Tân Xuân (新春), Sơ Xuân (初春), Đoan Xuân (端春), Triệu Xuân (肇春), Hiến Xuân (獻春), Xuân Vương (春王), Hoa Tuế (華歲), Tuế Tuế (歲歲), Triệu Tuế (肇歲), Khai Tuế (開歲), Hiến Tuế (獻歲), Phương Tuế (芳歲), Sơ Tuế (初歲), Sơ Nguyệt (初月), Sơ Dương (初陽), Mạnh Dương (孟陽), Tân Dương (新陽), Xuân Dương (春陽), Xuân Vương (春王), Thái Thấu (太簇), Tuế Thỉ (歲始), Vương Chánh Nguyệt (王正月), Sơ Không Nguyệt (初空月), Hà Sơ Nguyệt (霞初月), Sơ Xuân Nguyệt (初春月), Tưu Nguyệt (陬月), Vương Nguyệt (王月), Đoan Nguyệt (端月), Mạnh Tưu (孟陬), Thái Nguyệt (泰月), Cẩn Nguyệt (謹月), Kiến Dần (建寅), Dần Nguyệt (寅月), Dương Nguyệt (楊月), Mạnh Xuân Nguyệt (孟春月), Tam Vi Nguyệt (三微月), Tam Chánh (三正), Mục Nguyệt (睦月), Thượng Nguyệt (上月), Tam Chi Nhật (三之日). Một số câu hay cho tháng Giêng như Tam Dương sơ trưởng (三陽初長, tháng Giêng mới lớn), Tứ Tự cánh đoan (四序更端, bốn mùa trở lại đầu), mai đôi bạch ngọc (梅堆白玉, mai chất đầy ngọc trắng [tuyết]), liễu đĩnh hoàng kim (柳錠黃金, liễu trĩu nặng vàng ròng), tiêu hoa tống lạp (椒花送臘, hoa tiêu tiễn năm cũ đi), canh điểu sơ minh (庚鳥初鳴, chim Vàng Anh bắt đầu hót), Ngọc Luật hồi phù (玉律回夫, nhạc khí Ngọc Luật trở về chăng), duệ Ki tiễn lạp (睿璣餞臘, sao Ki sáng tiễn năm cũ), tiêu chuyển Bắc Đẩu (杓轉北鬥, chuôi sao chuyển Bắc Đẩu), nhân tại Đông phong (人在東風, người nơi gió Đông), nhất thanh trừ cựu (一聲除舊, một tiếng vang trừ năm cũ), vạn hộ cánh tân (萬戶更新, ngàn nhà lại mới mẻ). Một số từ dùng cho truy điệu vào tháng này như mai tai lệ phấn (梅腮淚粉, mặt hoa mai đầy phấn lệ), liễu nhãn bi thanh (柳眼悲青, mắt liễu buồn trong xanh). Ngữ cú dành cho Thượng Nguyên như cửu thiên nguyệt lãng (九天月朗, chín tầng trời trăng sáng rực), vạn hộ đăng huy (萬戶燈輝, vạn nhà đèn tỏ rạng). Một số từ dùng cho Lập Xuân như Đông phong giải đống (東風解凍, gió Đông làm tan băng), Bắc Đẩu hồi chước (北斗回杓, chùm Bắc Đẩu trở về đuôi)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Hai Âm Lịch", "definition": "Có tên gọi khác như Như Nguyệt (如月), Mai Kiến Nguyệt (梅見月), Mai Nguyệt (梅月), Lệ Nguyệt (麗月), Mão Nguyệt (卯月), Hạnh Nguyệt (杏月), Hàm Nguyệt (酣月), Lệnh Nguyệt (令月), Khiêu Nguyệt (跳月), Tiểu Thảo Sanh Nguyệt (小草生月), Y Cánh Trước Giáp Chung (衣更著夾鐘), Trọng Chung (仲鐘), Trọng Xuân (仲春), Trọng Dương (仲陽), Trung Hòa Nguyệt (中和月), Tứ Dương Nguyệt (四陽月), Xuân Trung (春中), Hôn Nguyệt (婚月), Môi Nguyệt (媒月), Đại Tráng (大壯), Trúc Thu (竹秋), Hoa Triêu (花朝), Hoa Nguyệt (花月), Tứ Chi Nguyệt (四之月). Một số câu hay cho tháng Hai như Hải Đường tẩm nguyệt (海棠浸月, hoa Hải Đường ngấm trăng), Dương Liễu lung yên (楊柳籠煙, cây Dương Liễu nhốt khói), liễu khê tiếu bích (柳溪醮碧, khe liễu cúng màu xanh biếc), hoa ổ phi hồng (花塢飛紅, ụ hoa phất phơ màu hồng), oanh ca hoa tự (鶯歌花序, oanh ca đầu hoa), yến tiễn xuân phong (燕剪春風, chim Yến xé gió Xuân), hoa vũ lộng tình (花雨弄晴, mưa hoa đùa giỡn với trời tạnh), thời cánh thường hoa (時竟嚐花, đến lúc lại thưởng thức hoa), dã điểu hổ xuân (野鳥唬春, chim rừng dọa nạt mùa Xuân), ngạn hoa khấp hiểu (岸花泣曉, hoa bên bờ khóc lúc hừng sáng), Đỗ ông hành vũ (杜翁行雨, ông lão họ Đỗ đi trong mưa), hoa tín xuy phong (花信吹風, tin tức hoa nở thổi gió bay). Một số từ dùng cho gió Xuân như Tam Xuân tiền bán (三春前半, một nửa trước của ba tháng mùa Xuân), bách khắc bình phân (百刻平分, trăm khắc phân rõ). Các từ dùng cho tháng Hai nhuận như Trọng Xuân kỷ nhuận (仲春紀閏, Trọng Xuân gặp nhuận), tích vũ lưu hàn (積雨留寒, chứa mưa giữ lại cái lạnh), tự hoa thời lạc (序花時落, hoa tuần tự rơi rụng đúng lúc), dã điểu tranh minh (野鳥爭鳴, chim rừng tranh nhau hót)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Mười Hai Âm Lịch", "definition": "Có tên gọi khác như Lạp Nguyệt (臘月), Trừ Nguyệt (除月), Sửu Nguyệt (丑月), Nghiêm Nguyệt (嚴月), Băng Nguyệt (冰月), Dư Nguyệt (餘月), Cực Nguyệt (極月), Đồ Nguyệt (塗月), Địa Chánh Nguyệt (地正月), Nhị Dương Nguyệt (二陽月), Gia Bình Nguyệt (嘉平月), Tam Đông Nguyệt (三冬月), Mai Sơ Nguyệt (梅初月), Xuân Đãi Nguyệt (春待月), Quý Đông (季冬), Mộ Đông (暮冬), Vãn Đông (晚冬), Diểu Đông (杪冬), Cùng Đông (窮冬), Hoàng Đông (黃冬), Lạp Đông (臘冬), Tàn Đông (殘冬), Mạt Đông (末冬), Nghiêm Đông (嚴冬), Sư Tẩu (師走), Đại Lữ (大呂), Tinh Hồi Tiết (星回節), Ân Chánh (殷正), Thanh Tự (清祀), Đông Tố (冬素), Xú Nguyệt (醜月), Gia Bình (嘉平), Tuế Diểu (歲杪), Cửu Đông (九冬), Nghiêm Hàn (嚴寒), Tuế Nguyệt (歲月), Mạt Nguyệt (末月). Một số câu hay cho tháng Mười Hai như tiêu thương tiễn lạp (椒觴餞臘, chén rượu tiêu tiễn cuối năm), mai tín truyền Xuân (梅信傳春, tin cây Mai truyền mùa Xuân đến), cẩm diên thủ tuế (錦筵守歲, tiệc gấm đón năm mới), họa các nghênh Xuân (畫閣迎春, gác vẽ tranh hoa lệ đón Xuân), Mai truyền Xuân ý (梅傳春意, cành Mai truyền ý Xuân), tuyết triệu phong niên (雪兆豐年, tuyết có điềm cho biết năm mới phong phú), khúc tấu Lương Viên (曲奏梁園, tấu khúc Lương Viên), Tây sơn tuyết tễ (西山雪霽, núi Tây tuyết tan), Đông các Mai hương (東閣梅香, gác Đông thơm hoa Mai), hàn tùy lạp khứ (寒隨臘去, lạnh theo cuối năm đi), noãn trục Xuân lai (暖逐春來, hơi ấm cùng mùa Xuân đến), Mai ngạc truyền Xuân (梅萼傳春, đài hoa Mai truyền sắc Xuân), tuế trừ kim tịch (歲除今夕, năm hết đêm nay), Xuân nhập tân niên (春入新年, Xuân vào năm mới), pháo thôi tàn lạp (炮催殘臘, pháo thúc giục cuối năm còn sót), Mai báo tảo Xuân (梅報早春, Mai báo Xuân sớm), nhất niên tương tận (一年將盡, một năm sắp hết), tứ quý vân chung (四季雲終, bốn mùa chấm dứt). Một số từ dùng cho truy điệu vào tháng này như tinh hồi nguyệt triển (星回月展, sao lùi trăng hiện), phong thảm vân sầu (風慘雲愁, gió thảm mây buồn), diêm khuynh trường lệ (簷傾長淚, mái nghiêng ngấn lệ), thủy kết đôi băng (水結堆冰, nước kết băng trôi). Một số từ dùng cho tháng Mười Hai nhuận như nhuận dĩ thành tuế (潤以成歲, nhuận đã thành năm), hàn bách chu niên (寒迫周年, lạnh đuổi theo trọn năm).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Mười Một Âm Lịch", "definition": "Có tên gọi khác như Trọng Đông (仲冬), Trung Đông (中冬), Chánh Đông (正冬), Sướng Nguyệt (暢月), Sương Nguyệt (霜月), Sương Kiến Nguyệt (霜見月), Tý Nguyệt (子月), Cô Nguyệt (辜月), Gia Nguyệt (葭月), Chỉ Nguyệt (紙月), Phục Nguyệt (復月), Thiên Chánh Nguyệt (天正月), Nhất Dương Nguyệt (一陽月), Quảng Hàn Nguyệt (廣寒月), Long Tiềm Nguyệt (龍潛月), Tuyết Nguyệt (雪月), Hàn Nguyệt (寒月), Hoàng Chung (黃鐘, 黃鍾), Dương Phục (陽復), Dương Tế (陽祭), Băng Tráng (冰壯), Tam Chí (三至), Á Tuế (亞歲), Trung Hàn (中寒), Trọng Nguyệt (仲月), Phức Nguyệt (複月), Long Tiềm (龍潛), Long Đông (隆冬), Hỷ Nguyệt (喜月). Một số câu hay cho tháng Mười Một như nhật hành Bắc lục (日行北陸, mặt trời đi về đất Bắc), Xuân đáo Nam chi (春到南枝, Xuân đến trên cành Nam), thiên hàn dục tuyết (天寒欲雪, trời lạnh tuyết sắp rơi), Xuân ý tại Mai (春意在梅, ý Xuân ở cây Mai), hàn sương điểm tuyết (寒霜點雪, sương lạnh lấm chấm tuyết), đống nghiễn ha băng (凍硯呵冰, nghiên mực đóng băng phun tuyết), Mai thổ Nam chi (梅吐南枝, Mai nở cành Nam), ngân hà phiêu tuyết (銀河飄雪, sông ngân thổi tuyết), ngọc vũ phi sương (玉宇飛霜, nhà ngọc bay sương), Tam Dương trình thụy (三陽呈瑞, xuân đến bày điềm lành), Lục Bạch triệu phong (六白兆豐, Lục Bạch [tượng trưng cho Càn, tức là trời] thể hiện điềm phong phú), Nhất Dương lai phức (一陽來複, tháng 11 lại đến nữa), vạn gia chiêu hồi (萬家昭回, muôn nhà trở lại sáng sủa).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Mười Âm Lịch", "definition": "Có tên gọi khác như Dương Nguyệt (陽月), Hợi Nguyệt (亥月), Cát Nguyệt (吉月), Lương Nguyệt (良月), Khôn Nguyệt (坤月), Chánh Dương Nguyệt (正陽月), Tiểu Dương Xuân (小陽春), Thần Vô Nguyệt (神無月), Thập Nguyệt (拾月), Thời Vũ Nguyệt (時雨月), Sơ Sương Nguyệt (初霜月), Ứng Chung (應鐘, 應鍾), Sơ Đông (初冬), Mạnh Đông (孟冬), Thượng Đông (上冬), Khai Đông (開冬), Huyền Đông (玄冬), Huyền Anh (玄英), Tiểu Xuân (小春), Đại Chương (大章), Thỉ Băng (始冰), Cực Dương (極陽), Dương Chỉ (陽止), Mạnh Đông (孟冬), Nguyên Đông (元冬), Tiểu Lương (小良), Ứng Nguyệt (應月), Lập Nguyệt (立月), Tiểu Hòa Xuân (小和春), Âm Nguyệt (陰月), Lộ Nguyệt (露月), Phi Âm Nguyệt (飛陰月). Một số câu hay cho tháng Mười như Mai truyền Xuân ý (梅傳春意, Mai truyền ý Xuân), Cúc ngạo sương chi (菊傲霜枝, Cúc ngạo nghễ cành sương), hàn uy vị chấn (寒威未振, uy lực cái lạnh chưa đến nỗi), ái cảnh sơ khai (愛景初開, cảnh đẹp mới bày), đấu tiêu chỉ Bắc (鬥杓指北, chuôi sao về hướng Bắc), nhật ảnh hồi Nam (日影回南, bóng mặt trời trở về hướng Nam), nhật lâm chiết mộc (日臨折木, mặt trời đến bẻ cây), Nam chi nhật noãn (南枝日暖, cành Nam mặt trời ấm), Đông các hàn khinh (東閣寒輕, gác Đông se lạnh), hòa khí như Xuân (和氣如春, khí trời ôn hòa như mùa Xuân). Một số từ dùng cho Lập Đông (立冬) như nguyên anh khải tú (元英啟秀, hoa cỏ khởi sắc), thanh nữ ty hàn (青女司寒, cô gái tự nhiên màu xanh làm chủ cái lạnh), sương lăng Mai nhụy (霜淩梅蕊, sương thấm nhụy hoa Mai), tuyết ngạo sương chi (雪傲霜枝, tuyết cười ngạo cành sương), Dương Xuân tương Hạ (陽春將夏, tháng Mười như Hè), Xuân ý phương xa (春意方賒, ý Xuân còn xa). Một số từ dùng cho tháng Mười nhuận như Tiểu Dương dư nhuận (小陽餘閏, tháng Mười còn nhuận), Dương Nguyệt tăng trưởng (陽月增長, tháng Mười kéo dài). Một số từ dùng cho truy điệu vào tháng này như phong mộc thanh phân (風木聲分, tiếng gió cây rã rời), tuyết sơn dung lão (雪山容老, dáng núi tuyết già cỗi).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Năm Âm Lịch", "definition": "Có tên gọi khác như Trọng Hạ (仲夏), Siêu Hạ (超夏), Trung Hạ (中夏), Thỉ Nguyệt (始月), Tinh Nguyệt (星月), Hoàng Nguyệt (皇月), Nhất Dương Nguyệt (一陽月), Bồ Nguyệt (蒲月), Lan Nguyệt (蘭月), Mang Nguyệt (忙月), Ngọ Nguyệt (午月), Lựu Nguyệt (榴月), Độc Nguyệt (毒月), Ác Nguyệt (惡月), Quất Nguyệt (橘月), Nguyệt Bất Kiến Nguyệt (月不見月), Xuy Hỷ Nguyệt (吹喜月), Cao Nguyệt (皋月), Nhuy Tân (蕤賓), Đoan Dương Nguyệt (端陽月), Thử Nguyệt (暑月), Thuần Nguyệt (鶉月), Minh Điêu (鳴蜩), Hạ Ngũ (夏五), Tiện Nam Nhiễm Nguyệt (賤男染月), Tiểu Hình (小刑), Thiên Trung (天中), Mang Chủng (芒種), Khải Minh (啟明), Úc Chưng (郁蒸), Cấu Nguyệt (垢月), Nhuy Nguyệt (蕤月), Bạc Nguyệt (薄月), Đạm Nguyệt (炎月). Một số câu hay cho tháng Năm như hà kị nghênh phong (荷芰迎風, củ sen đón gió), hòe âm kết duyên (槐陰結緣, bóng hòe kết duyên), lựu hỏa thư hồng (榴火舒紅, hoa Thạch Lựu phô sắc màu hồng đỏ rực), nông tương đăng thử (農將登黍, nhà nông sắp cúng lúa mùa), nguyệt kỷ minh điêu (月紀鳴蜩, tháng ghi nhớ tiếng ve sầu rả rích), trì hà thổ lục (池荷吐綠, hoa sen dưới hồ nhả màu xanh non), liễu hỏa thư đan (柳火舒丹, hoa Liễu phô sắc màu đỏ rực), lan thang thức dục (蘭湯拭浴, Lan nóng phe phẩy tắm), bạc tửu phù thương (薄酒浮觴, rượu nhạt uống chén phạt). Một số từ dùng trong Tiết Đoan Dương (端陽節) như khiết lan tiết giới (潔蘭節屆, tiết Lan thanh khiết), huyền ngải thời tân (懸艾時新, ngải treo luôn mới). Từ dùng cho Hạ Chí như nhật thiên Đông thăng (日偏東升, mặt trời nghiêng lên từ phương Đông), nguyệt chánh Nam Khâu (月正南邱, mặt trăng chính hướng đất Nam Khâu). Một số từ dùng cho tháng Năm nhuận như nhuy tân kỷ nhuận (蕤賓紀閏, tháng Năm ghi nhuận), ngải hổ do huyền (艾虎猶懸, da lông chồn còn treo). Một số từ dùng cho truy điệu vào tháng này như trì hà lệ lộ (池荷淚露, sen nơi hồ giọt sương lệ), viện trúc bi phong (院竹悲風, hàng tre bên nhà thoảng gió buồn)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Sáu Âm Lịch", "definition": "Có tên gọi khác như Thả Nguyệt (且月), Hà Nguyệt (荷月), Thử Nguyệt (暑月), Tiêu Nguyệt (焦月), Phục Nguyệt (伏月), Quý Nguyệt (季月), Mùi Nguyệt (未月), Mộ Hạ (暮夏), Diểu Hạ (杪夏), Vãn Hạ (晚夏), Quý Hạ (季夏), Trường Hạ (長夏), Cực Thử (極暑), Tổ Thử (組暑), Nhục Thử (溽暑), Lâm Chung (林鐘), Tinh Dương (精陽), Độn Nguyệt (遁月), Lâm Chung (林鍾), Cam Chung (甘鍾), Tinh Nguyệt (精月), Đán Nguyệt (旦月), Cửu Hạ (九夏), Đản Thử (但暑), Lệ Nguyệt (荔月), Tổ Nguyệt (祖月). Một số câu hay cho tháng Năm như lục hà hương viễn (綠荷香遠, sen xanh hương ngát xa), liễu ám phong thanh (柳暗風清, liễu râm gió mát), tất suất cư bích (蟋蟀居壁, dế mèn sống nơi tường nhà), Xạ Thảo vi oánh (麝草爲瑩, cỏ Xạ Thảo trong suốt), băng bàn tiến quả (冰盤薦果, mâm băng cúng quả), hồng tảo phất hạm (紅藻拂檻, cỏ hồng phất qua song cửa), bích thọ lâm song (碧樹臨窗, cây xanh đến bên cửa sổ). Một số từ dùng cho Sơ Phục (初伏, chỉ 10 ngày đầu của mùa nóng) như huề cầm tải tửu (攜琴載酒, mang đàn cầm đi chở rượu), trầm lý phù qua (沉李浮瓜, mận chìm dưa nỗi). Một số từ dùng cho Trung Phục (中伏, chỉ 10 ngày giữa của mùa nóng) như viêm phong chánh tích (炎風正積, gió nóng tích tụ), Canh Phục phương trung (庚伏方中, ngay giữa Tam Phục). Một số từ dùng cho Mạt Phục (末伏, chỉ 10 ngày cuối của mùa nóng) như Tam Canh tại hậu (三庚在後, ngay sau Tam Phục), Mạt Phục dư viêm (末伏餘炎, hơi nóng còn lại kỳ Mạt Phục). Một số từ dùng cho truy điệu vào tháng này như thiền thanh hiệu nguyệt (蟬聲號月, tiếng ve sầu than thở với trăng), yến ngữ bi phong (燕語悲風, chim yến chuyện trò với gió buồn)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Tám Âm Lịch", "definition": "Có tên gọi khác như Trọng Thu (仲秋), Trung Thu (中秋), Thu Bán (秋半), Thu Cao (秋高), Quất Xuân (橘春), Thanh Thu (清秋), Chánh Thu (正秋), Quế Thu (桂秋), Hoạch Nguyệt (獲月), Tráng Nguyệt (壯月), Quế Nguyệt (桂月), Diệp Nguyệt (葉月), Thu Phong Nguyệt (秋風月), Dậu Nguyệt (酉月), Nguyệt Kiến Nguyệt (月見月), Hồng Nhiễm Nguyệt (紅染月), Nam Lữ (南呂), Trọng Thương (仲商), Chá Nguyệt (柘月), Nhạn Lai Nguyệt (雁來月), Trung Luật (中律), Tứ Âm Nguyệt (四陰月), Sảng Nguyệt (爽月), Đại Thanh Nguyệt (大清月), Trúc Tiểu Xuân (竹小春), Quán Nguyệt (觀月), Kết Xuân (桔春), Cử Nguyệt (舉月). Một số câu hay cho tháng Tám như châu lộ ngưng bạch (珠露凝白, sương châu đọng thành màu trắng), quế nhụy sanh hương (桂蕊生香, nhụy hoa quế ngát hương), lộ doanh tiên chưởng (露盈仙掌, sương đọng đầy bàn tay tiên), quế trán thiềm cung (桂綻蟾宮, quế khắp cung trăng), lộ châu trích lãnh (露珠滴冷, giọt sương ngọc lạnh băng), quế nguyệt phù hàn (桂月浮寒, trăng quế trôi nỗi lạnh ngắt), thiềm quang chánh mãn (蟾光正滿, ánh sáng trăng tròn đầy), nhạn hoành độ ảnh (雁橫度影, nhạn bay ngang qua còn lưu bóng), thiềm thố trừng quang (蟾兔澄光, ánh trăng sáng tỏ). Một số từ dùng cho truy điệu vào tháng này như thiền hiệu cổ mộc (蟬號古木, ve khóc cây cổ), yến biệt điêu lương (燕別雕梁, yến giã biệt xà nhà chạm trỗ)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Tư Âm Lịch", "definition": "Có tên gọi khác như Phạp Nguyệt (乏月), Hoang Nguyệt (荒月), Dương Nguyệt (陽月), Nông Nguyệt (農月), Càn Nguyệt (乾月), Tỵ Nguyệt (巳月), Úy Nguyệt (畏月), Vân Nguyệt (雲月), Hòe Nguyệt (槐月), Mạch Nguyệt (麥月), Chu Nguyệt (朱月), Dư Nguyệt (餘月), Thủ Hạ (首夏), Hạ Thủ (夏首), Mạnh Hạ (孟夏), Sơ Hạ (初夏), Duy Hạ (維夏), Thỉ Hạ (始夏), Hòe Hạ (槐夏), Đắc Điểu Vũ Nguyệt (得鳥羽月), Hoa Tàn Nguyệt (花殘月), Trọng Lữ (仲侶、仲呂), Thuần Dương (純陽), Thuần Càn (純乾), Chánh Dương Nguyệt (正陽月), Hòa Nguyệt (和月), Mạch Thu Nguyệt (麥秋月), Mạch Hầu (麥候), Mạch Tự (麥序), Lục Dương (六陽), Mai Nhục (梅溽), Mai Nguyệt (梅月), Thanh Hòa (清和), Chu Minh (朱明), Phạp Hạ (乏夏), Xuân Dư (春餘), Hòe Tự (槐序), Anh Tự (櫻序). Một số câu hay cho tháng Tư như Hòe phong mị Hạ (槐風媚夏, gió đưa cây Hòe nịnh hót mùa Hè), mạch Hạ phiên Thu (麥夏翻秋, mùa Hè lúa chuyển sang Thu), ngũ phong mạch thục (五風麥熟, năm gió làm lúa chín), tế vũ mai phì (細雨梅肥, mưa nhẹ làm cho Mai tươi tốt), Chu Minh bố lệnh (朱明布令, Chu Minh ban lệnh), Xích Đế ty quyền (赤帝司權, Xích Đế nắm quyền). Một số từ dùng cho tháng Tư nhuận như nguyệt tiêu kỷ nhuận (月蕭紀閏, trăng tiêu điều tháng năm nhuận), thử khí sơ lai (暑氣初來, khí nóng bắt đầu đến), vân đường nghênh Hạ (雲堂迎夏, nhà mây đón mùa Hè), tuyết sơn tống Xuân (雪山送春, núi tuyết tiễn Xuân đi). Một số từ dùng cho truy điệu vào tháng này như Mai hoàng sầu vũ (梅黃愁雨, Mai vàng buồn mưa), mạch thục bi phong (麥熟悲風, lúa chín sầu gió). Từ dùng cho Lập Hạ là Hạ hành triệu thỉ (夏衡肇始, mùa Hè thật sự bắt đầu), viêm đức phương tân (炎德方新, khí nóng càng mới), quỳ hoa hướng dương (葵花向陽, hoa Quỳ hướng về mặt trời), trúc diệp thùy âm (竹葉垂陰, lá tre tìm bóng râm), tân hà thiếp thủy (新荷貼水, sen mới bám vào nước), trĩ trúc thành âm (稚竹成陰, tre non thành bóng râm), lục long hành Hạ (六龍行夏, sáu rồng đi khắp mùa Hè), vạn tính thư Hạ (萬姓舒憂, muôn họ thư thả hưởng mùa Hè).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Tháng Vaisakha", "definition": "Vaisākha (S), Vesākha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháng Vesaka", "definition": "(Vaisakha – Vesaka là chữ Pali): là tháng thứ hai của lịch Ấn-độ. Lịch Ấn-độ cũng tính theo tuần trăng, chia một năm làm 12 tháng, mỗi tháng có 29 hoặc 30 ngày. 12 tháng lần lượt có tên tiếng Phạn như sau: Caitra (tháng đầu), Vaisakha (tháng thứ hai), Jyaistha (tháng thứ ba), Asadha (tháng thứ tư), Sravana (tháng thứ năm), Bhadrapada (tháng thứ sáu), Asvayuja (tháng thứ bảy), Karttika (tháng thứ tám), Margasirsa (tháng thứ chín), Pausa (tháng thứ mười), Magha (tháng thứ mười một), Phalguna (tháng thứ mười hai). Về thời tiết thì có ba mùa: mùa Nóng (Grisma), tương đương với mùa Xuân, gồm bốn tháng, bắt đầu từ ngày 16 tháng Caitra đến ngày 15 tháng Sravana; mùa Mưa (Varsakala), tương đương với mùa Hạ, gồm bốn tháng, bắt đầu từ ngày 16 tháng Sravana đến ngày 15 tháng Margasirsa; và mùa Lạnh (Hemanta), tương đương với mùa Đông, gồm bốn tháng, bắt đầu từ ngày 16 tháng Margasirsa đến ngày 15 tháng Caitra.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thánh", "definition": "Ariyan (P), Asekha (P), Aśaikṣa (S), Aśaiksha (S), Saint.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh - Chí Thánh", "definition": "Trong đạo Phật, danh từ “thánh” được dùng để tôn xưng các bậc đã chứng một quả vị nào đó trong hàng Thanh-văn, Duyên-giác hay Bồ-tát. Các tôn giả Xá Lợi Phất, Mục Kiền Liên, La Hầu La, Kiều Đàm Di, v.v... là những bậc thánh; các đức Bồ-tát Quán Thế Âm, Văn Thù, Phổ Hiền, v.v... là những bậc thánh; vua Tịnh Phạn, trưởng giả Cấp Cô Độc, v.v... là những bậc thánh. Ngoài ra, có những vị mà người ta không thể biết được là có chứng được quả vị gì hay không, nhưng cứ trông vào các hành động tràn đầy uy dũng, từ bi, trí tuệ, cứu khốn phò nguy, hi sinh vì đạo, làm lợi ích chúng sinh, sống đời phạm hạnh giải thoát..., mọi người khởi tâm khâm phục, qui ngưỡng, tôn thờ, thân cận, thì cũng tôn xưng họ là thánh. Cư sĩ Duy Ma Cật thời Phật tại thế, chư Tổ đời xưa, hòa thượng Quảng Đức đời nay, v.v... là những bậc thánh đó. Các ngài chứng đắc quả vị gì thì con mắt phàm tục không thể nào thấy được, mà chính các ngài thì đâu có ai tự nói mình có chứng đắc! Những bậc thánh như vậy trong đạo Phật, đã không do “bề trên” nào phong cho cả, mà hoàn toàn do Phật tử tôn xưng bằng lương tri con người, bằng trí tuệ và đạo tâm thanh tịnh của người Phật tử. Và trên hết các bậc thánh ở trên, đức Phật được đặc biệt tôn xưng là bậc “chí thánh” (bậc thánh tối thượng, không ai hơn).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thánh Bảo", "definition": "Shobo (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Ca", "definition": "Samhita (P), Dohā (S), gur (T), Spiritual song.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Chúa", "definition": "聖主. Tiếng tôn xưng ông vua. Đáng lẽ đọc là Thánh chủ. Truyện Lục Vân Tiên: “Mừng nay thánh chúa trị đời”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Chúng", "definition": "(聖眾): chủ yếu chỉ đức Phật, Bồ Tát (s: bodhisattva, p: bodhisatta, 菩薩), Duyên Giác (s: pratyeka-buddha, p: pacceka-buddha, 緣覺), Thanh Văn (s: śrāvaka, p: sāvaka, 聲聞), v.v. Tăng Nhất A Hàm (增壹阿含經, Taishō Vol. 2, No. 125) quyển 45 có nêu ra 6 hạng Thánh chúng, gồm: (01) Tu Đà Hoàn (s: srota-āpanna, p: sotāpanna, 須陀洹, hay Dự Lưu [預流]), (02) Tư Đà Hàm (s: sakṛd-āgāmin, p: sakad-āgāmin, 斯陀含, hay Nhất Lai [一來]), (03) A Na Hàm (s, p: anāgāmin, 阿那含, hay Bất Lai [不來]), (04) A La Hán (s: arhat, p: arahant, 阿羅漢), (05) Bích Chi Phật (s: pratyeka-buddha, 辟支佛), và (06) Phật. Trong Phật Thuyết Tôn Thắng Đại Minh Vương Kinh (佛說尊勝大明王經, Taishō Vol. 21, No. 1413) có đoạn rằng: “Quy mạng nhất thiết chư Phật, nhất thiết tôn pháp, nhất thiết Thánh chúng; hựu phục quy mạng đại bi Quán Tự Tại Bồ Tát Ma Ha Tát (歸命一切諸佛、一切尊法、一切聖眾、又復歸命大悲觀自在菩薩摩訶薩, kính lễ hết thảy chư Phật, hết thảy giáo pháp, hết thảy Thánh chúng; lại thêm kính lễ đại bi Quán Tự Tại Bồ Tát Ma Ha Tát).” Hay trong Thích Tịnh Độ Quần Nghi Luận (釋淨土群疑論, Taishō Vol. 47, No. 1960) cũng có đoạn: “Do Tịnh Độ nghiệp cảm sanh thời thục, Thánh chúng lai nghênh, quy thú Tịnh Độ, xả Ta Bà uế chất, thành Cực Lạc tịnh thân (由淨土業感生時熟、聖眾來迎、歸趣淨土、捨娑婆穢質、成極樂淨身, do đến lúc nghiệp cảm sanh về cõi Tịnh Độ đã chín, Thánh chúng đến nghinh đón, quay về Tịnh Độ, bỏ chất nhơ nhớp chốn Ta Bà, thành thân trong sạch cõi Cực Lạc).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Chỉ", "definition": "聖㫖. Lệnh vua. Ý vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Cung", "definition": "聖宮. Nơi vua ở Nhà thờ thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Cầu", "definition": "Ariya-pariyesa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Cứu Độ Phật Mẫu", "definition": "Xem Đa La Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Diệu Mẫu Đà La Ni", "definition": "Ārya-grahamatṛkadhāranī (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Diệu Mẫu Đà La Ni Kinh", "definition": "Grahāmātrikā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Dũng", "definition": "Āryaśūra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Giá", "definition": "聖架. Cái giá hình chữ thập treo xác Chúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Giáo", "definition": "Sasanakaro (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Giáo Hội", "definition": "Ārya-samaj (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Giáo Lượng", "definition": "Lấy lời lẽ của Phật, Bồ Tát trong kinh điển làm tiêu chuẩn, làm dẫn chứng để minh họa và bênh vực lập trường của mình. Khác với hiện lượng là dùng thực tế, thực tại do năm cảm quan nhận thức để chứng minh lập luận của mình, quan điểm của mình. Cũng khác với tỷ lượng, là dùng phương pháp so sánh, đối chiếu để chứng minh quan điểm của mình.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thánh Giáo có liên quan đến Truyền Pháp Quán Đính, Kết Duyên Quán Đính và Tam Muội Da Giới, gọi chung là Quán Đính Bộ.", "definition": "III.Quán Đính Bộ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thánh Giả", "definition": "Ariya-puggala (P), Ārya-pudgala (S), Sage, Enlightened one.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Giới", "definition": "Ārya-śīla (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Hiến", "definition": "(聖憲, Shōken, 1307-1392): vị học tăng của Phái Tân Nghĩa Chơn Ngôn Tông Nhật Bản, thông xưng là Căn Nham Tiên Đức (根巖先德), Gia Trì Môn Tiên Đức (加持門先德); tự là Định Lâm (定林), hiệu Hoa Hải (華海); xuất thân vùng Hòa Tuyền (和泉, Izumi, thuộc Ōsaka [大阪]). Ông theo hầu Thật Tuấn (實俊) ở Di Lặc Viện (彌勒院) của Căn Lai Tự (根來寺, Negoro-ji), rồi được Tăng Hỷ (增喜) của Trung Tánh Viện (中性院) truyền trao cho Dòng Trung Tánh Viện (中性院流). Sau ông theo học Mật Giáo với Thuận Kế (順繼), Lại Hào (賴豪); rồi tiến hành chỉnh lý lại các giảng luận xưa nay của Phái Tân Nghĩa (新義派) và hình thành học thuyết Gia Trì Môn (加持門) của Lại Du (賴瑜). Ông kế thế làm Tổ đời thứ 4 của Trung Tánh Viện, rồi làm Học Đầu (學頭) của Đại Truyền Pháp Viện (大傳法院), chuyên tâm giáo dưỡng chúng học đồ. Trước tác của ông có Đại Sớ Bách Điều Đệ Tam Trọng (大疏百條第三重) 10 quyển, Thích Luận Bách Điều Đệ Tam Trọng (釋論大疏百條第三重) 10 quyển, Hoa Nghiêm Ngũ Giáo Chương Thính Sao (華嚴五敎章聽鈔) 5 quyển, Tự Chứng Thuyết Pháp Thập Bát Đoạn (自証說法十八段), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Hiền", "definition": "聖賢. Người có tài đức vượt hẳn người thường. Thơ Nguyễn Bỉnh Khiêm: “Đạo thánh hiền xưa luống chốc mòng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Hoàng", "definition": "聖皇. Tiếng tôn xưng ông vua. Như Thánh chúa 聖主, Thánh đế 聖帝 Vị thần được một vùng thờ phượng. Đoạn trường tân thanh: “Quá lời nguyện hết thánh hoàng thổ công”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Huệ", "definition": "(聖惠, Shōkei, 1094-1137): vị Tăng của Chơn Ngôn Tông Nhật Bản, sống vào cuối thời Bình An, vị Tổ của Dòng Hoa Tạng Viện (華藏院流), húy là Thánh Huệ (聖惠), thông xưng là Hoa Tạng Viện Cung (華藏院宮), Trường Vĩ Cung (長尾宮); là Hoàng Tử thứ 5 của Bạch Hà Thiên Hoàng (白河天皇, Shirakawa Tennō, tại vị 1072-1086). Ông theo xuất gia với Khoan Trợ (寬助) ở Thành Tựu Viện (成就院); đến năm 1112 thì được thọ phép Quán Đảnh ở Quan Âm Viện (觀音院) và trở thành Nhất Thân A Xà Lê (一身阿闍梨). Ông khai sáng Hoa Tạng Viện (華藏院) ở Nhân Hòa Tự (仁和寺, Ninna-ji), truyền thừa dòng pháp của Khoan Trợ và sáng lập Dòng Hoa Tạng Viện. Vào năm 1130, ông viếng thăm anh Giác Pháp (覺法), lên Cao Dã Sơn, cùng với bàn luận với Giác Noan (覺鑁), dâng biểu xin triều đình cho xây dựng Truyền Pháp Viện (傳法院). Ông có tín ngưỡng sâu sắc về A Di Đà Phật, nên đã sáng lập Dẫn Nhiếp Viện (引攝院). Năm 1132, nhân lúc Điểu Vũ Thượng Hoàng (鳥羽上皇) lâm trọng bệnh, ông tiến hành tu Khổng Tước Kinh Pháp (孔雀經法) trong cung nội để cầu nguyện cho Thượng Hoàng lành bệnh. Đệ tử phú pháp của ông có Khoan Hiểu (寬曉)", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Hạnh", "definition": "Là một trong năm hạnh của hàng Bồ-tát. Bồ-tát tu tập ba nghiệp vô lậu giới định tuệ, đó là “thánh hạnh”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thánh Khả", "definition": "聖 可. Hiệu của Thiền tăng Đức Ngọc đời Thanh. X. Đức Ngọc.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Kinh", "definition": "聖經. Sách của bậc đại học giả làm ra Sách chép lời dạy của vị giáo chủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Kinh Học", "definition": "Hermeneutics.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Lượng", "definition": "Tức đại sư Ấn Quang (xem mục “Ấn Quang”).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thánh Miếu", "definition": "聖廟. Đền thờ đức Khổng Tử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Mô Hiền Phạm Lục", "definition": "聖模賢範錄. Tên một cuốn sách viết bằng chữ Hán của Lê Quý Đôn, học giả thời Hậu Lê, chép các gương sáng của bậc thánh hiền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Mẫu", "definition": "Sheng-mu (C), Holy Mother.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Nghiêm", "definition": "聖 嚴 (1930-?). Thiền tăng đời hiện đại, họ Trương, hiệu Huệ Không, người Nam Thông, Giang Tô, Trung Quốc. Năm 13 tuổi theo Hòa Thượng Lãng Huệ chùa Quảng Giáo cạo tóc xuất gia, 16 tuổi vào Phật học viện chùa Tĩnh An, Thượng Hải. Năm 1949 gia nhập Ngũ Tùy Quân đến Đài Loan. Mười năm sau khôi phục tăng tịch, theo Trưởng Lão Đông Sơ xuất gia. Năm sau sư thụ giới Tỳ kheo nơi chùa Hải Hội ở Cơ Long, ngay lập tức đến Mỹ Nồng, Cao Hùng cấm túc và bế quan trong thời gian 6 năm. Mùa xuân năm 1969 sư sang Nhật Bản lầy bằng Tiến sĩ tại Đại học Đại Chính (Taishò) ở Đông Kinh. Mùa đông năm 1975 đến Hoa Kỳ nhận chức Phó Hội trưởng Hội Phật Giáo Mỹ Quốc và trụ trì chùa Đại Giác, xuất bản quý san “Tạp Chí Thiền”. Năm 1978, sư trở về Đài Bắc tiếp quản Trung Hoa Phật Giáo Văn Hóa Quán, nhậm chức giáo sư Sở nghiên cứu triết học của Đại học Trung Quốc Văn Hóa, Sở trưởng sở nghiên cứu Phật Học của Viện Trung Hoa Học thuật, đồng thời tại Newyork xây dựng Trung tâm Thiền. Tác phẩm: Thiền Môn Ly Châu Tập, Thiền Môn Nghệ Ngữ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Ngôn Lượng", "definition": "Tức là tin chắc chắn lời dạy của Phật là hoàn toàn chân thật, tuyệt đối không sai lầm, nương vào lời dạy ấy làm tiêu chuẩn để nhận thức mọi nghĩa lí ở thế gian.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thánh Ngữ", "definition": "Ārya-bhāṣā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Nhân", "definition": "Ariyaka (S), Nobleman.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Nhất Ngữ Lục", "definition": "Shōichi goroku (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Nhất Phái", "definition": "Shōichi-ha (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Phàm Khoà Cữu", "definition": "聖 凡 窠 臼. Khuôn mẫu thánh phàm, chỉ cho cái thấy của người thế tục thường hay phân biệt người thánh với kẻ phàm. Nhà thiền cho rằng đây là biểu hiện của vọng tâm phân biệt. Mật Am Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Phàm Tận Sát", "definition": "聖 凡 盡 殺. Giết sạch Thánh phàm, ý nói hoàn toàn trừ sạch mọi chấp trước trên nghĩa lý đối với bậc. Thánh người phàm, cùng với những vọng tình đối lập giữa Thánh phàm. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Pháp Ấn Kinh", "definition": "Acalā-dharma-mudrā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Quan Tự", "definition": "聖 觀 寺. ở thành phố Đài Bắc, tỉnh Đài Loan, Trung Quốc, là Thiền tự tông Lâm Tế. Năm 1948 Tương Nhật Thức cải tạo và xây dựng lại phòng ốc mà thành gọi là “Thánh Quan Phật Đường”. Năm 1968 dỡ bỏ rồi xây dựng lại, đổi tên là “Thánh Quan Tự”. Thiền Sư Thịnh Vân là khai sơn trụ trì.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Quan Âm", "definition": "Ārya-valokiteśvara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Quang", "definition": "(聖光, Shōkō): tức Biện Trường (辨長, Benchō, 1162-1238): vị Tăng của Tịnh Độ Tông, sống vào khoảng đầu và giữa thời kỳ Liêm Thương, trú trì đời thứ 2 của Thanh Tịnh Hoa Viện (清淨華院), Tổ khai sơn Thiện Đạo Tự (善導寺), Tổ của Dòng Trấn Tây (鎭西流); húy là Biện Trường (辨長), thông xưng là Trấn Tây Thượng Nhân (鎭西上人), Khủng Tử Thượng Nhân (筑紫上人), Thiện Đạo Tự Thượng Nhân (善導寺上人), Nhị Tổ Thượng Nhân (二祖上人); hiệu là Thánh Quang Phòng (聖光房), Biện A (辨阿), thụy hiệu là Đại Thiệu Chánh Tông Quốc Sư (大紹正宗國師); xuất thân vùng Hương Nguyệt (香月), Trúc Tiền (筑前, Chikuzen, thuộc Fukuoka-ken [福岡縣]); con của Cổ Xuyên Đàn Chánh Tả Vệ Môn Tắc Mậu (古川彈正左衛門則茂). Ông theo thọ pháp với Thường Tịch (常寂) ở Minh Tinh Tự (明星寺) vùng Trúc Tiền, rồi học giáo học Thiên Thai trên Tỷ Duệ Sơn (比叡山, Hieizan). Năm 1193, ông bôn ba tận lực tái kiến ngôi tháp 3 tầng ở đây. Rồi đến năm 1197, ông lên kinh đô Kyoto để đặt làm tượng thờ cho ngôi tháp này, nhờ vậy ông gặp Nguyên Không (源空, Genkū, tức Pháp Nhiên), được vị này khai hóa và từ đó ông chuyển sang pháp môn Niệm Phật. Đến năm 1204, ông trở về cố hương; rồi vào năm 1228, ông chuyên tu pháp môn Biệt Thời Niệm Phật (別時念佛) ở Vãng Sanh Viện (徃生院) vùng Phì Hậu (肥後, Higo), viết cuốn Mạt Đại Niệm Phật Thọ Thủ Ấn (末代念佛授手印) và lập nên huyết mạch của Tịnh Độ Tông. Về sau, ông đi bố giáo khắp các địa phương vùng Cửu Châu (九州, Kyūshū); lấy Thiện Đạo Tự ở vùng Trúc Hậu (筑後, Chikugo) làm đạo tràng căn bản để tạo cơ sở phát triển. Trước tác của ông để lại cho hậu thế có Mạt Đại Niệm Phật Thọ Thủ Ấn 1 quyển, Tịnh Độ Tông Yếu Tập (淨土宗要集) 6 quyển, Triệt Tuyển Trạch Bổn Nguyện Niệm Phật Tập (徹選擇本願念佛集) 2 quyển, Niệm Phật Danh Nghĩa Tập (念佛名義集) 3 quyển, v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Quynh", "definition": "(聖冏, Shogei, 1341-1420): vị Tăng của Tịnh Độ Tông, sống khoảng vào giữa hai thời đại Nam Bắc Triều và Thất Đinh, vị Tổ thời Trung Hưng của Dòng Trấn Tây (鎭西流); húy là Thánh Quynh (聖冏), thông xưng là Tam Nhật Nguyệt Thượng Nhân (三日月上人); hiệu là Tây Liên Xã (西蓮社), Liễu Dự (了譽); thụy hiệu là Thánh Quynh Thiền Sư (聖冏禪師); xuất thân vùng Thường Lục (常陸, Hitachi, thuộc Ibaraki-ken [茨城縣]); con của Bạch Cát Chí Ma Thủ Nghĩa Quang (白吉志摩守義光). Ông bắt đầu xuất gia theo Liễu Thật (了實) ở Thường Phước Tự (常福寺) thuộc vùng Thường Lục, rồi học Tịnh Độ Giáo của Dòng Trấn Tây với Liên Thắng (蓮勝) cũng như Đinh Huệ (定慧); và tu học hết giáo nghĩa của các Tông khác. Sau đó, ông kế thừa trú trì Thường Phước Tự, chỉ đạo dạy dỗ học đồ, viết ra bộ Nhị Tạng Tụng Nghĩa (二藏頌義) và hệ thống hóa Tông nghĩa Tịnh Độ. Hơn nữa, ông đã làm sáng tỏ dòng huyết mạch truyền thừa từ thời đức Thích Ca trở về sau, cũng như Viên Đốn Giới từ thời Viên Nhân (圓仁) trở đi; và nêu rõ tính độc lập của Tịnh Độ Tông. Ông còn chỉnh đốn lại chế độ truyền pháp của Ngũ Trùng Tương Truyền (五重傳承); rồi đến năm 1393, lần đầu tiên ông truyền áo nghĩa cho đệ tử là Thánh Thông (聖聰). Vào năm 1415, thể theo lời thỉnh cầu của Thánh Thông, ông chuyển đến ở tại thảo am ở Tiểu Thạch Xuyên (小石川, Koishikawa), Giang Hộ (江戸, Edo). Trước tác của ông có Thích Tịnh Độ Nhị Tạng Nghĩa (釋淨土二藏義) 30 quyển, Tịnh Độ Nhị Tạng Nhị Giáo Lược Tụng (淨土二藏二敎略頌) 1 quyển, Truyền Thông Ký Nhữu Sao (傳通記糅鈔) 48 quyển, Quyết Nghi Sao Trực Điệp (決疑鈔直牒) 10 quyển, Phá Tà Hiển Chánh Nghĩa (破邪顯正義) 1 quyển, Tịnh Độ Chơn Tông Phú Pháp Truyện (淨土眞宗付法傳) 1 quyển, Hiển Tịnh Độ Truyền Giới Luận (顯淨土傳戒論) 1 quyển, Giáo Tướng Thập Bát Thông (敎相十八通) 2 quyển, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Quán Tự Tại", "definition": "Xem Thánh Quán âm Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Quán Âm Bồ Tát", "definition": "Āryavalokiteśvara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Quân", "definition": "聖君. Vị vua tài giỏi, đức độ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Quả Tự", "definition": "聖 果 寺. ở núi Phụng Hoàng, thành phố Hàng Châu, tỉnh Chiết Giang, Trung Quốc. Niên hiệu Khai Hoàng thứ 2 (582) đời Tùy sáng lập. Đời Đường Thiền Sư Vô Trước Văn Hỉ phục hưng khai pháp, ban đầu gọi “Thánh Quả Tự”. Vua Tống Cao Tông đi về phương nam từng đổi thành ngự uyển. Niên hiệu Gia Tĩnh thứ 35 (1556) đời Minh bị lửa thiêu rụi. Năm thứ 37 (1558) tăng Chính Nhân xây dựng lại.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Sư", "definition": "Gurūdeva (S), Sacred master Gurudeva (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Sư Tử", "definition": "聖 獅 子. Tên hiệu của Phật. Chân Minh Tụng trong PKNL q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Sự Tự Tánh", "definition": "Āryāvastusvabhāva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Thai", "definition": "Sheng t'ai (C), Holy emryo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Thanh Văn", "definition": "Ariya-savaka (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Thiên", "definition": "Deva-ārya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Thông", "definition": "(聖聰, Shōsō, 1366-1440): vị Tăng của Tịnh Độ Tông, sống vào khoảng giữa hai thời đại Nam Bắc Triều và Thất Đinh, Tổ khai sơn Tăng Thượng Tự (增上寺, Zōjō-ji); húy là Thánh Thông (聖聰), tục danh là Thiên Diệp Dận Minh (千葉胤明); hiệu Đại Liên Xã (大蓮社), Tây Dự (西譽); xuất thân vùng Hạ Tổng (下總, Shimōsa, thuộc Chiba-ken [千葉縣]), con của Thiên Diệp Thị Dận (千葉氏胤, Chiba Ujitane). Ban đầu, ông học Mật Giáo ở Minh Kiến Tự (明見寺, tức Thiên Diệp Tự [千葉寺]) thuộc vùng Hạ Tổng, nhưng đến năm 1385 thì được Thánh Quynh (聖冏) cảm hóa, rồi quy y theo Tịnh Độ Tông; từ đó trở đi trải qua trong vòng 9 năm, ông theo học Tông Nghĩa với Thánh Quynh ở Thường Phước Tự (常福寺). Vào năm 1393, ông khai sáng Tăng Thượng Tự ở vùng Bối Trũng (貝塚, Kaizuka), Võ Tàng (武藏, Musashi); được dòng họ Thiên Diệp cũng như tầng lớp hào tộc quy y theo rất đông, và nỗ lực bố giáo ở địa phương này. Chính ông đã phổ cập tư tưởng Ngũ Trùng Truyền Pháp của Thánh Quynh, và hết mình giáo dưỡng chúng đệ tử. Trước tác của ông có Tam Kinh Trực Đàm Yếu Chú Ký (三經直談要註記) 48 quyển, Đương Ma Mạn Đà La Sớ (當麻曼荼羅疏) 48 quyển, Triệt Tuyển Trạch Bản Mạt Khẩu Truyền Sao (徹選擇本末口傳鈔) 2 quyển, Vãng Sanh Luận Chú Ký Kiến Văn (徃生論註記見聞) 2 quyển, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Thượng", "definition": "聖上. Tiếng xưng hô vị vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Thể", "definition": "聖體. Thân mình của nhà vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Thọ Tự", "definition": "聖 壽. 1. ở khe núi Linh Không cách trung tâm huyện Tẩm Nguyên, tỉnh Sơn Tây, Trung Quốc 18km về phía tây bắc. Niên hiệu Càn Phù thứ 6 (879) đời Đường, Lý Khản con thứ 4 của vua Ý Tông vì tránh nạn Hoàng Sào khởi nghĩa mà đến nơi này. Niên hiệu Cảnh Phúc thứ 2 (893) cất chùa ẩn cư và cạo tóc làm tăng. Thụy hiệu “Tiên Sư Bồ tát”, nhân đây đặt tên chùa là “Tiên Sư Thiền viện”. Niên hiệu Đoan Củng thứ 2 (989) đời Tống trùng tu, đổi tên là “Thánh Thọ Tự”. Chùa ở dưới mỏm núi, nhân địa thế mà cất, năm tòa sân sướng có thể thông suốt nhau, lại đều có sơn môn tự thành kết cấu và cách thức, trung tâm là Đại Phật điện viện, hai bên là Tiên Sư Bồ tát viện, Tàng kinh viện, Phương trượng viện, Thiền đường viện. Trước Đại Phật điện viện là Thiên vương điện, hai bên đình viện có Phối điện tả hữu và Chung cổ lâu. Trong chùa có vài tấm bia cổ ghi chép sự phát triển biến đổi lịch sử chùa và phong cảnh núi sông. 2. ở núi Phục Long, huyện Tuy Đức, tỉnh Thiểm Tây, Trung Quốc. Niên hiệu Thái Định thứ 4 (1327) đời Nguyên, Thiên Nham Nguyên Trường vào núi Phục Long thấy chùa hoang phế đã lâu bèn muốn xây cất lại, dân làng ra sức trợ giúp chẳng bao lâu xây dựng thành chùa lớn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Thủy", "definition": "Xem Cam Lồ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Thủy Tự", "definition": "聖 水 寺. ở trong núi Vân Cư, tỉnh Chiết Giang, Trung Quốc. Khoảng niên hiệu Nguyên Hựu (1086-1093) đời Tống, Phật ấn Liễu Nguyên xây cất Vân Cư Am trong núi. Sau đó Trung Phong Minh Bản xây cất Thánh Thủy Tự ở gần đó. Niên hiệu Hồng Vũ thứ 24 (1391) đời Minh, hai chùa cùng được xây cất lại, Minh Thái Tổ ban cho tấm biển “Vân Cư Thánh Thủy Tự”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Triết", "definition": "(聖哲): chỉ đạo đức tài trí siêu nhân, cũng chỉ cho người có đạo đức tài trí; cũng dùng chỉ cho đế vương. Trong Tả Truyện (左傳), phần Văn Công Lục Niên (文公六年), có đoạn: “Cổ chi vương giả, tri mạng chi bất trường, thị dĩ tinh kiến Thánh triết (古之王者、知命之不長、是以幷建聖哲, vua ngày xưa, biết mạng không lâu dài, cho nên mới lập đạo đức tài trí).” Hay trong Đại Đường Tây Vức Ký (大唐西域記, Taishō Vol. 51, No. 2087) quyển 3, phần Kiện Đà La Quốc Ca Nị Sắc Ca Vương (健馱邏國迦膩色迦王), lại có đoạn rằng: “Vương nãi tuyên lịnh viễn cận, chiêu tập Thánh triết, ư thị tứ phương bức thấu, vạn lí tinh trì, anh hiền tất tụy (王乃宣令遠近、召集聖哲、於是四方輻湊、萬里星馳、英賢畢萃, nhà vua bèn tuyên lệnh xa gần, chiêu tập tài đức, do đó bốn phương tập trung, vạn dặm bôn ba, hiền sĩ tụ họp).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Trì Tổ", "definition": "聖 持 祖. Đời Minh, thiền tăng Phổ Trì trụ trì chùa Thánh Ân núi Đặng Úy ở Tô Châu, được người đời gọi là Thánh Trì tổ. X. Phổ Trì.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Trí", "definition": "Ariya-pañña (P), Ariyañāṇa (P), Noble knowledge.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Trí Tự Giác", "definition": "Pratyātmāryajñāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Trí Tự Tánh Sự", "definition": "Aryajñāna-svabjava-vastu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Trụ Chí", "definition": "Shengg Chou Chi (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Tài", "definition": "Là tài sản của bậc thánh nhân. Hoàn toàn khác với loại tài sản của kẻ phàm phu (như nhà cửa, tiền bạc, ruộng vườn v.v...), các thứ tài sản này có khả năng làm cho người tu hành thành tựu được Phật đạo, cho nên gọi là thánh tài. Tài sản này gồm có 7 thứ:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thánh Tào", "definition": "Aryavarman (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Tánh Tự Tánh", "definition": "Nispatti-svabhāva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Tụệ Nhãn", "definition": "Āryaprajñācakṣu (S), Ariyapaññācakkhu (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Tự Tánh", "definition": "Xem Thánh Tánh Tự Tánh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Võ Thiên Hoàng", "definition": "(聖武天皇, Shōmu Tennō, tại vị 724-749): vị Thiên Hoàng sống giữa thời Nại Lương, hoàng tử của Văn Võ Thiên Hoàng (文武天皇, Monmu Tennō, tại vị 697-707), tên thật là Thủ (首, Obito). Ông cùng với Quang Minh Hoàng Hậu (光明皇后) rất tin tưởng Phật pháp, đã xây dựng một số ngôi chùa như Quốc Phận Tự (國分寺, Kokubun-ji), Quốc Phận Ni Tự (國分尼寺, Kokubunni-ji), thiết lập Đông Đại Tự (東大寺, Tōdai-ji) và an trí tượng Đại Phật tại ngôi chùa này.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Vức", "definition": "Lokuttara (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thánh Đa La Bồ Tát", "definition": "Xem Đa La Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Đa La Trì Quan Tán", "definition": "Ārya-tārā-sragdhara-stotra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Điển A Hàm", "definition": "Xem A Hàm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Điển Ngũ Bộ", "definition": "Xem Thánh Điển.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Đăng Lục", "definition": "聖 燈 錄. Đăng Lục, 1 quyển, được biên soạn vào thế kỷ XIII (đời Trần, Việt Nam). Nội dung ghi chép về hành trạng của 5 vị vua đầu đời Trần: Thái Tông, Thánh Tông, Nhân Tông, Anh Tông và Minh Tông.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Đạo", "definition": "Āryamārga (S), Ariya-magga (P), Path of Sages .", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Đạo Môn", "definition": "(聖道門, Shōdōmon): môn (門) có nghĩa là pháp môn hay lời dạy, giáo lý, Thánh Đạo Môn có nghĩa là giáo lý dạy người tu tập chứng quả trong hiện đời này nhờ tự lực của bản thân mình. Đặc biệt là từ này dùng để chỉ cho Thiên Thai Tông và Chơn Ngôn Tông. Thánh Độ Môn (聖土門) đối với Tịnh Độ Môn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Đạt", "definition": "(聖達, Shōtatsu, ?-?): vị Tăng của Dòng Tây Sơn (西山流) thuộc Tịnh Độ Tông, sống vào khoảng giữa thời Liêm Thương, húy là Thánh Đạt (聖達). Ông theo hầu Chứng Không (証空), học về Tịnh Độ Giáo của Dòng Tây Sơn. Ông đã từng nỗ lực bố giáo ở Thái Tể Phủ thuộc vùng Trúc Tiền (筑前, Chikuzen), rồi khai sáng Tri Ân Viện (知恩院, Chion-in) ở vùng Phì Tiền (肥前, Hizen). Môn đệ của ông có Hiển Ý (顯意), Thánh Quán (聖觀); và ngay cả vị Tổ của Thời Tông là Nhất Biến (一遍, Ippen) cũng đã từng theo tu học với ông trong vòng 12 năm trường.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thánh Đản", "definition": "聖誕. Ngày sinh của bậc thần, của vị giáo chủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Đế", "definition": "Ārya-satya (S), Ariya saccani (P), Ariya-sacca (P), Noble Truth.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thánh Đế Đệ Nhất Nghĩa", "definition": "聖 諦 第 一 義. Chỉ chân lý tối cao, chân lý chí cực huyền diệu của Phật giáo, Thiền giáo. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thánh Đề Bà", "definition": "S. Aryadeva. Luận sư người gốc ở Sri Lanka, học trò Long Thọ, và là tác giả bộ Bách Luận, một trong ba bộ luận căn bản của học phái Trung Hoa, Tam Luận tông (x. Tam Luận tông).", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thánh Địa", "definition": "聖地. Vùng đất sinh trưởng của bậc giáo chủ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thánh Đức Thái Tử", "definition": "Shotoku-taishi (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháo", "definition": "慅. Lo buồn không yên Xem Tao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tháo Lý", "definition": "操 履. Hành vi, phẩm hạnh. Tiết Tục Nghệ Ngôn trong NHQL q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháo Lược", "definition": "操 略. Hành động ứng cơ tiếp vật, vận dụng cơ duyên. Tiết Thị Dục Tạng Chủ trong DTNL q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháo Thứ", "definition": "造次. Vội vàng gấp rút.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Tháo Vi", "definition": "操 爲. Cử chỉ, hành vi. Tiết Huệ Khả Thiền Sư trong TĐT q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháp", "definition": "Thūpa (P), Chorten (J), Stūpa (S), chö ten (T), Pagoda .", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháp Bà", "definition": "塔 婆. Phạn: Stūpa. Cây tháp. Ngôi tháp. Tiết Phật Nhật Phổ Chiếu Huệ Biện Thiền Sư Tháp Minh (Hữu Tự) trong PKNL q. 0 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháp Bắc Tự gồm mười một cấp, bị nạn binh lửa thời Nam Tống Hủy hoại, về sau Đại Tháp chùa Báo Ân ở huyện Ngô Giang Tô được kiến thiết lại.Tháp Bắc Tự hiện còn là tòa tháp lớn tám góc chín tầng, cao tám mươi mét, đường trực kính hơn bảy mét, tầng thứ nhất có lan can bao bọc chung quanh cho người ta cái cảm giác yên định. Bộ phận bên ngoài tháp làm bằng gỗ là được tu bổ, hoàn thành vào năm Quang Tự 26, còn bộ phận bên trong bằng gạch thì được coi là do Đại Viên kiến tạo vào đầu đời Nam Tống. Tháp Đại Đồng bằng đá và bia Ngô Vương ghi công vẽ tượng ở đàng sau tháp, đều được cho là do Trương Sĩ Thành kiến thiết khi trùng tu chùa Báo Ân khoảng năm Chí Chính (1341-1376) đời Nguyên. [X. Ngô Huyện Chí Q.36 Báo Ân Tự Điều; Báo Ân Vạn Tuế Hiền Thủ Giáo Tự Bi (Nguyên Đại diêm phục); Bắc Tự Trùng Tu Cửu Cấp Phù Đồ Kí (Vương Thế Trinh); Giang Tô Chi Tháp (Giang Tô tỉnh văn vật quản lí ủy viên hội biên); Chi Na Văn Hóa Sử Tích Giải Thuyết Q.4 (Thường Bàn Đại Định, Quan Dã Trinh); Chi Na Đích Phật Tháp (Thôn Điền Trị Lang)].", "definition": "II.Báo Ân Tự. Vị trí chùa nằm bên ngoài cửa Tụ Bảo, phía nam thành Kim Lăng, huyện Giang Ninh tỉnh Giang Tô. Hiệu là Tụ Bảo Sơn. Nguyên tên là chùa Kiến Sơ, do Đại đế Ngô Tôn Quyền đời Tam Quốc kiến thiết vào khoảng năm Xích Ô (238-251), đồng thời, xây tháp A Dục để thờ Xá Lợi Phật do sa môn Khang Tăng Hội Tặng. Là tòa chùa tháp lâu dài nhất trong suốt dòng lịch sử Giang Nam, tương truyền là một trong tám vạn bốn nghìn tháp của vua A Dục. Về sau hoang phế, từng được kiến thiết lại làm chùa Trường Can, rồi đổi tên một lần nữa là chùa Thiên Hỉ. Khoảng năm Chí Nguyên (1264-1294) đổi là chùa Nguyên Hưng Thiên Hỉ Từ Ân Tinh Trung. Năm Vĩnh Lạc thứ 10 (1412), vua Thành Tổ nhà Minh hạ lệnh xây lại, ban hiệu chùa “Đại báo ân tự”. Qua các đời, có các sư Khang Tăng Hội, Trúc Tuệ Đạt, Trúc Pháp Khoáng, Minh Triệt, Tăng Hựu và Pháp Nhãn Văn Ích hộ trì, các pháp sư Huyền Tắc, Pháp An cũng từng ở đây. [X. Kim Lăng Phạm Sái Chí Q.31; Đại Thanh Nhất Thống Chí Q.32]. III.Báo Ân Tự. Vị trí chùa năm ở góc đông bắc Thọ huyện tỉnh An Huy. Tương truyền do Đại Sư Huyền Trang vâng mệnh vua xây dựng vào khoảng năm Trinh Quán (627-649) đời vua Thái Tông nhà Đường. Nguyên tên là Sùng Giáo Thiền Viện, Đông Thiền Viện, Đông Thiền Tự, đến đầu năm Hồng Vũ nhà Minh mới đổi tên như hiện nay. Toàn diện chùa bao quát Sơn Môn, Phật Điện môn, Đại Hùng Bảo Điện, Thiền đường, khách đường v.v... Trong Đại Điện thờ các tượng được tạo qua các triều đại, trong đó, tượng khắc bằng gỗ ở đời Đường điềm tĩnh trang nghiêm, tượng chạm bằng gỗ ở đời Tống ngồi nhìn xuống mặc niệm, tượng đồng đời Minh đúc rất điêu luyện, hồn hậu, tượng mười tám La Hán đắp bằng đất trong thời Minh, Thanh, tư thái đều khác, tạo hình kì đặc, có thể nói là những tác phẩm nghệ thuật cực kì trân quí. IV. Báo Ân Tự. Vị trí chùa nằm ngoài cửa tây huyện Vĩnh Phong tỉnh Giang Tây. Do quan Trung thư thị lang là Từ An chính hóa nhà của mình để làm chùa vào khoảng năm Thiên Bảo (742-557) đời Đường, vì tên đất là trấn Báo Ân nên chùa cũng gọi là chùa Báo Ân. Đời Nguyên bỏ, đến năm Hồng Vũ thứ 2 (1369) đời Minh, hậu duệ họ Từ mới xây tháp bên phía hữu của chùa, khoảng những năm Hoàng Trị, Vạn Lịch đã hai lần được sửa lại.Cây tháp hiện nay là một kiến trúc chín tầng bốn mặt, mỗi tầng cao khoảng ba mét; có sáu góc, hai cửa, đi theo thềm đá vòng quanh, có thể đi thẳng tới tầng năm đến tầng bảy. Mặt bằng tháp hình vuông, tầng trên hết thì hình cột tròn; từ tầng thứ bảy trở xuống, mặt chính mỗi tầng đều đặt một cỗ khám, trong khám có thờ tượng Phật.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Tháp Chuông", "definition": "Bell tower.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháp Chủ", "definition": "塔 主. Vị tăng phụ trách việc quản lý, giữ gìn ngôi tháp. Lâm Tế Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháp Miếu", "definition": "Funerary tower, Memorial tower", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Tháp Nhọn", "definition": "Kūṭāgāra (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tháp Nhỏ", "definition": "Niyyūha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Tháp Sử", "definition": "Thūpavaṃsa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháp Thờ Xá Lợi", "definition": "Cetiya (P), Caitya (S), Stupa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháp Viên", "definition": "Thūparama (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Tháp Viện Tự", "definition": "塔 院 寺. ở phía nam chùa Hiển Thông, thị trấn Đài Hoài, Ngũ Đài Sơn, tỉnh Sơn Tây, Trung Quốc, là một trong năm đại thiền tự của Ngũ Đài Sơn. Nguyên là tháp viện của chùa Hiển Thông, thời Minh Tống trùng tu tháp Xá Lợi, mới lập riêng thành chùa, gọi là “Tháp Viện Tự”. Phía trước là Đại hùng bảo điện, phía sau là Tàng kinh các, Xá Lợi tháp ở giữa, xung quanh là hành lang, phía đông là Thiền viện, bố cục hoàn chỉnh. Các tượng đắp trong mỗi điện được giữ gìn hoàn hảo, trong Tàng kinh các có Chuyển Luân Tạng 12 tầng làm bằng gỗ, mỗi tầng chứa đầy tạng kinh cung cấp cho tăng chúng đọc tụng, tín đồ lễ bái. Trong chùa có Bạch tháp cao lớn khiến người chú ý được xem là tiêu chí của Ngũ Đài Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháp Viện Tự Xá Lợi Tháp", "definition": "塔 院 寺 舍 利 塔. ở phía nam chùa Hiển Thông, thị trấn Thai Hoài, huyện Ngũ Đài, tỉnh Sơn Tây, Trung Quốc, nguyên là tháp viện của chùa Hiển Thông, niên hiệu Vạn Lịch thứ 10 (1582) đời Minh sau khi xây tháp Xá Lợi này, mới lập riêng thành chùa gọi là “Tháp Viện Tự”, là một trong năm đại thiền tự của Ngũ Đài Sơn. Bố cục của chùa lấy tháp làm chủ, tháp Xá Lợi nằm ở trung tâm chùa, xung quanh có lang vũ bao quanh, phía đông có Thiền viện. Tháp theo kiểu Lạt Ma hình chiếc bát úp, nền tòa mặt bằng hình vuông, phía dưới là tòa Tu Di cao lớn, ở giữa là thân tháp hình chiếc bát úp xây gạch sơn màu trắng, nên còn gọi “Ngũ Đài Sơn Đại Bạch Tháp”. Hoa cái, ngưỡng nguyệt, bảo châu của sát đỉnh đều làm bằng đồng pha vàng, ánh vàng rực rỡ. Chung quanh eo tháp và tướng luân có treo 252 chiếc chuông nhỏ, khi gió núi thổi qua tiếng chuông kêu đinh đang, rất có phong vị một chùa cổ. Tháp cao lớn tráng lệ, hùng vĩ nghiêm túc, thân tháp trắng tinh nổi bật giữa điện vũ tường đỏ, cây xanh núi biếc, càng cảm thấy vô cùng trong sáng, được mọi người xem như là tiêu chí của Ngũ Đài Sơn. Tháp này đã có đặc trưng to lớn của tháp Lạt Ma thời kỳ đầu, lại có phong cách tú lệ của tháp Lạt Ma thời kỳ cuối, hiển bày đầy đủ tính chất quá độ, nó chiếm một địa vị trọng yếu trong lịch sử kiến trúc. Nền tòa tháp này xung quanh có hành lang gấp khúc rộng lớn, trên có nhiều ống sắt tròn viết sáu chữ chân ngôn kinh chú, để cho tín đồ khi đi hành hương nhiễu tháp sờ mó, thay vì tụng niệm kinh văn. Đây là điểm khác biệt với tháp Lạt Ma cỡ lớn ở khu vực Trung Nguyên.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Tháp Đầu", "definition": "塔 頭. Ngôi tháp, cây tháp. Chữ “đầu” (頭) đứng sau có ý biểu thị phương hướng nơi chốn. Tiết Động Sơn Hòa Thượng trong TĐT q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thát", "definition": "呾. Lắm lời Một âm là Đát. Xem Đát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thát Đát", "definition": "(韃靼, Dattan): tên của một bộ tộc ngày xưa, còn gọi là Tháp Tháp Nhĩ (塔塔爾), được tìm thấy sớm nhất trong các ký lục dưới thời nhà Đường. Sau khi Thành Cát Tư Hãn (成吉思汗) chinh phục bộ tộc Tháp Tháp Nhĩ, Thát Đát trở thành tên gọi của chung của các bộ tộc Mông Cổ. Dưới thời nhà Minh, Thát Đát là tên gọi các bộ tộc hậu duệ của Thành Cát Tư Hãn ở miền Đông; phía Đông có bộ tộc Ngột Lương Cáp (兀良哈), phía Tây tiếp giáp với bộ tộc Ngõa Lạt (瓦剌). Đức vua lớn lên gọi là Khả Hãn (可汗); có các quan Tri Viện (知院), Thừa Tướng (丞相), v.v. Trung tâm hoạt động đầu tiên của bộ tộc Thát Đát là Hòa Lâm (和林, tức là Cáp Nhĩ Hòa Lâm [哈爾和林] của nước Mông Cổ ngày nay). Vào năm thứ 8 (1410) niên hiệu Vĩnh Lạc (永樂), vua Thành Tổ (成祖, tại vị 1402~1424) thân chinh lên vùng sa mạc phía Bắc, quân thần của nhà vua bèn phân tán ra hoạt động ở các địa khu rộng lớn như Liêu Đông (遼東), Tuyên Phủ (宣府), Cam Túc (甘肅). Từ sau niên hiệu Thiên Thuận (天順, 1457-1464) nhà Minh, bộ tộc này dần dần vào địa khu Hà Sáo (河套). Dưới thời Gia Tĩnh (嘉靖, 1522-1566) nhà Minh, bộ tộc Yêm Đáp (俺答) cường thịnh, nên vào năm thứ 29 (1550) cùng niên hiệu trên, bộ tộc này đã từng vây khốn kinh đô. Tuy nhiên, thủ lãnh của họ là A Lỗ Đài (阿魯台), Yêm Đáp Hãn (俺答汗), v.v., đã từng được nhà Minh phong hiệu, và dâng cống phẩm. Ngoài ra, những người dân Thổ Nhĩ Kỳ cư trú ở một phần phía Nam nước Nga, nguyên xưa kia cũng có nguồn gốc quan hệ với người Mông Cổ; cho nên đây cũng là từ dùng để gọi dân Thổ Nhĩ Kỳ", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thâm", "definition": "愖. Thành thật. Lòng dạ đáng tin, không thay đổi. Một âm là Đam. Xem Đam.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Cung", "definition": "深宮. Nơi ở kín đáo của vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Cứu", "definition": "深究. Tìm hiểu sâu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Diệu", "definition": "Profound and wonderful", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thâm Giao", "definition": "深交. Bạn bè chơi thân với nhau. Đoạn trường tân thanh: “Một lời đã trót thâm giao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Hiểm", "definition": "深險. Sâu kín khó khăn, chỉ lòng dạ khó biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Khuê", "definition": "深閨. Căn phòng kín đáo của đàn bà con gái. Cung oán ngâm khúc: “Thâm khuê còn giấm mùi hương khuynh thành”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Khí", "definition": "(深器): biết rõ là bậc pháp khí, hiểu rõ là người xuất chúng. Như trong Tục Đăng Tồn Cảo (續燈存稿, 卍 Tục Tạng Kinh Vol. 84, No. 1585) quyển 11 có đoạn rằng: “Tây Kinh Bảo Ứng Nguyệt Nham Vĩnh Đạt Thiền Sư, Phần Châu Lưu thị tử, thọ nghiệp ư lí chi Thiên Ninh, mỗi dĩ sanh tử vi khích lệ; vãng kiến Linh Nham, Nham thâm khí chi (西京寶應月岩永達禪師、汾州劉氏子、受業於里之天寧、每以生死爲激勵、往見靈巖、巖深器之, Thiền Sư Nguyệt Nham Vĩnh Đạt ở Bảo Ứng, Tây Kinh, là con nhà họ Lưu ở Phần Châu, thọ giáo với Thiên Ninh ở quê nhà, thường lấy việc sống chết để khích lệ mình; Thiền Sư đến gặp Linh Nham, Ngài biết đây là người xuất chúng).” Hay như trong Ngũ Đăng Hội Nguyên (五燈會元, 卍 Tục Tạng Kinh Vol. 80, No. 1565) quyển 5 có đoạn viết về Thiền Sư Thanh Nguyên Hành Tư (青原行思, ?-740): “Tổ thâm khí chi, hội hạ học đồ tuy chúng, sư cư thủ yên (祖深器之、會下學徒雖眾、師居首焉, Tổ biết là bậc pháp khí, trong chúng đệ tử tuy đông, nhưng Thiền Sư vẫn là người đứng đầu).” Trong Ngũ Đăng Toàn Thư (五燈全書, 卍 Tục Tạng Kinh Vol. 81, No. 1571) quyển 20 cũng có đoạn ghi lại hành trạng của Thiền Sư Vĩnh Minh Diên Thọ (永明延壽, 904-975) như sau: “Tầm trú Thiên Thai Sơn Thiên Trụ Phong, cửu tuần tập định, hữu ô loại xích yến, sào ư y triệp trung, kị yết Thiều Quốc Sư, nhất kiến nhi thâm khí chi, mật thọ nguyên chỉ (尋往天台山天柱峰、九旬習定、有烏類斥鷃、巢於衣襵中、暨謁韶國師、一見而深器之、密授元旨, Thiền Sư tìm đến trú tại đỉnh núi Thiên Trụ, Thiên Thai Sơn, tu Thiền định trong chín tuần; có loài chim sẻ đen như quạ, làm tổ trong chéo áo Thiền Sư; sau Thiền Sư đến tham yết Thiều Quốc Sư, chỉ mới gặp mà Quốc Sư đã biết là bậc xuất chúng, bèn bí mật truyền trao cho huyền chỉ).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thâm Nghiêm", "definition": "深嚴. Kín đáo chặt chẽ. Đoạn trường tân thanh: “Thâm nghiêm kín cổng cao tường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Nhiễm", "definition": "深染. Nhuốm sâu. Ăn sâu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Nhập", "definition": "深入. Vào sâu. Ăn sâu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Sư", "definition": "深 師 (905-965). Thiền tăng đời Ngũ Đại, họ Khổng, người Hoài Tập, Quảng Đông, Trung Quốc. Sư nối pháp thiền sư Văn Yển, thuộc tông Vân Môn đời thứ 2, trụ trì Từ Vân Sơn Tự ở Liên Châu (tại huyện Liên, Quảng Đông).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thâm Thiết", "definition": "深切. Sâu xa gắn bó.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Thuý", "definition": "深邃. Sâu xa tinh tế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Thuỷ", "definition": "深水. Nước sâu. Tụng Tây hồ phú của Nguyễn Huy Lượng: “Làn thâm thuỷ muốn vái lên ngũ bái”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Thù", "definition": "深讎. Mối giận ghét sâu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Trầm", "definition": "深沈. Sâu sắc kín đáo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Tuệ Bồ Tát", "definition": "Ghambhiramati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thâm Tâm", "definition": "Ajjhāsaya (P), Adhyāśaya (S), Mental disposition, Adhyāśayati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thâm Tình", "definition": "深情. Lòng yêu thương sâu xa, mối ràng buộc thương yêu. Đoạn trường tân thanh: “Một dây vô lại buộc hai thâm tình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Tạ", "definition": "深謝. Cảm ơn sâu xa. Đoạn trường tân thanh: “Lọ là thâm tạ mới là tri âm”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm U", "definition": "深幽. Sâu và tối.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Viễn", "definition": "深遠. Sâu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâm Ý", "definition": "深意. Điều nghĩ ngợi sâu kín, không lộ ra ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân", "definition": "Kāya (S), Body.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Bình Đằng", "definition": "Kayāsamatā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Bằng", "definition": "親朋. Chỉ chung họ hàng và bè bạn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Chinh", "definition": "親征. Nói về nhà vua tự mình ra đánh trận.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Chứng", "definition": "Người chứng quả Bất-hoàn có căn tánh nhạy bén, tự thân họ chứng diệt tận định mà nhập niết bàn, gọi là “Thân-chứng”. Theo tông Thành Thật, đây là địa vị thứ 18 (trong 27 địa vị) trên tiến trình tu tập của hành giả Thanh-văn-thừa.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thân Cung", "definition": "親供. Tự mình viết ra sự thật. Đoạn trường tân thanh: “Thân cung nàng mới dâng qua một tờ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Cây", "definition": "Vaṇṭa (trung), vaṇṭaka (trung), khandha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Cây Thốt Nốt", "definition": "Tālakkhandha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Căn", "definition": "Kāyendriya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Căn - Khí Giới", "definition": "“Thân căn” tức thân thể với sáu căn, là chánh báo của chúng sinh. “Khí giới” cũng gọi là “khí thế gian”, tức quốc độ với tất cả khí vật, là y báo của chúng sinh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thân Cận", "definition": "親近. Gần gũi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Cận Xứ", "definition": "Associations proper for", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thân Danh", "definition": "身名. Sự nghiệp và tiếng tăm. Thơ Nguyễn Bỉnh Khiêm: “Mấy người trọn được chữ Thân danh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Diệu Hạnh", "definition": "Kāya-sucarita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Gia", "definition": "親家. Hai nhà có liên lạc hôn nhân với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Giáo Sư", "definition": "Còn gọi là Hòa thượng,", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Giới", "definition": "Kāyadhātu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Huyên", "definition": "(親萱): từ chỉ cho người mẹ. Huyên (萱) là loại cây cỏ sống lâu năm, Huyên Thảo (萱草) là loại Kim Châm (金針), tương truyền khi ăn vào thì làm cho người ta quên đi ưu sầu, phiền muộn; nên được gọi là Vong Ưu Thảo (忘憂草, Cỏ Quên Buồn) và thường được dùng thay thế cho người mẹ. Nơi người mẹ cư ngụ được gọi là Huyên Đường (萱堂), tức là nơi có trồng nhiều loại cỏ Huyên để giúp cho mẹ quên đi mọi ưu phiền. Cho nên “thân huyên dĩ thệ (親萱已逝)” có nghĩa là mẹ hiền đã qua đời.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thân Huân", "definition": "親熏. Vừa là họ hàng của vua, vừa lập được công lớn. Văn tế Vũ Tính và Ngô Tùng Châu của Đặng Đức Siêu: “… Xót tướng doanh sao vắng mặt thân huân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Hành", "definition": "Kāyasaṃskāra (S), Kāyasaṇkhāra (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Hành Niệm", "definition": "Kāyagatāsmṛti (S), Kāyagatāsati (P), Kāyagatāsati (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Hào", "definition": "紳豪. Người có học thức và người giàu có trong vùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Hữu", "definition": "親友. Như Thân bằng Bạn gần mình nhất.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Khẩu Ý", "definition": "Kāya-vak-citta (S), Body, words and thoughts.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Kim Cương", "definition": "“Kim cương” tức là đá kim cương, là loại khoáng vật kết tinh có 8 hoặc 12 mặt, có độ cứng tối cao trong muôn vật. Thân Kim Cương là ví dụ cho sự kiên cố của thân Phật, không gì có thể hủy hoại được.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thân Kiến", "definition": "Xem Kiến Kết.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Loan", "definition": "Shinran (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Mạng", "definition": "Jīvātman (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Mẫu", "definition": "親母. Mẹ đẻ. Mẹ ruột.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Mật", "definition": "Kāya-guhya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Nghiêm", "definition": "(親嚴, Shingon, 1151-1236): vị tăng của Chơn Ngôn Tông Nhật Bản, sống vào khoảng đầu và giữa thời Liêm Thương, trú trì đời thứ 98 của Đông Đại Tự (東大寺, Tōdai-ji), Tự Trưởng đời thứ 55 của Đông Tự (東寺, Tō-ji), húy là Thân Nghiêm (親嚴), thông xưng Đường Kiều Đại Tăng Chánh (唐橋大僧正), Tùy Tâm Viện Đại Tăng Chánh (隨心院大僧正), Việt Hậu Đại Tăng Chánh (越後大僧正), xuất thân vùng Kyoto, con của vị Trưởng Quan Kami vùng Phi Đạn (飛驒, Hida) là Trung Nguyên Thân Quang (中原親光). Ông theo hầu Chuyên Niệm (專念), học về Mật Giáo; đến năm 1181 thì thọ phép Quán Đảnh với Hiển Nghiêm (顯嚴) ở Pháp Trú Tự (法住寺). Ông đã từng tu phép cầu mưa ở Thần Tuyền Uyển (神泉苑) để cầu nguyện cho cung phi sinh sản an toàn. Vào năm 1228, ông làm Tự Trưởng, Pháp Vụ cũng như Hộ Trì Tăng của Đông Tự. Năm 1229, ông nhận tuyên chỉ của triều đình ban cho Tùy Tâm Viện (隨心院) ở vùng Tiểu Dã (小野, Ono) trở thành ngôi chùa Môn Tích. Đến năm 1235, ông làm Biệt Đương của Đông Đại Tự.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thân Nghiệp", "definition": "Kāya-karman (S), Kāya-kamma (P), Bodily action.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Nghênh", "definition": "親迎. Lễ rước dâu Chính mình ra đón. Đoạn trường tân thanh: “Từ công ra ngựa thân nghênh cửa ngoài”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Nghị", "definition": "親誼. Tình giao thiệp gần gũi với nhau. Truyện Hoa Tiên: “Khi thân nghị đạo cương thường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Niệm Xứ", "definition": "Kāyānapassana (S), Kāya-smṛsty-upasṭhāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Oan", "definition": "伸冤. Làm cho rõ điều ẩn ức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Phạt Nghiệp", "definition": "Kāya-daṇḍa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Phần", "definition": "Kāya dhātu (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Phận", "definition": "身分. Cái phần trời dành sẵn cho mình, chỉ giai cấp, địa vị của mình. Đoạn trường tân thanh: “Đành thân phận thiếp, nghĩ danh giá chàng” Chức vụ địa vị (Bạch thoại).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Phụ", "definition": "親父. Cha đẻ. Cha ruột.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Quang", "definition": "Bandhu-prabhā (S), Prabhā-mitra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Quang Tam Phần Khoa Kinh", "definition": "身光三分科經 (Phật Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thân Quyến", "definition": "親眷. Họ hàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Quyến Đã Quá Vãng", "definition": "Ñātipeta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Sinh", "definition": "親生. Người đẻ ra mình. Chỉ cha mẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Sĩ", "definition": "紳士. Người học thức, được trong vùng biết tiếng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Sơ", "definition": "親 疏. Khế hợp với thiền pháp là thân. Tách rời, không khế hợp với thiền pháp là Sơ. Tiết Vong tăng cổ túc trong NĐHN q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thân Sắt Tri", "definition": "Xem Trượng Lâm, Xem Thiện Kiến Lập Chi Đề.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Sắt Tri Lâm", "definition": "Xem Thân Sắt Tri.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Sở Duyên Duyên", "definition": "Cảnh Sở Duyên Trực Tiếp . Đối lại với cảnh sở duyên gián tiếp (xem mục “Cảnh Sở Duyên Gián Tiếp”) là cảnh sở duyên trực tiếp. Chữ “thân” nghĩa là gần gũi, không xa cách, có quan hệ trực tiếp. Chẳng hạn, khi ý thức duyên ngay với những ảnh tượng do nó biến hiện ra, trực tiếp, gần gũi, không xa cách, thì các “ảnh tượng” đó chính là “Thân Sở Duyên Duyên” (cảnh sở duyên trực tiếp) của ý thức.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thân Thiết", "definition": "親切. Như Thân mật 親密.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thiện", "definition": "親善. Gần gũi và đối xử tốt đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thuộc", "definition": "親屬. Người trong họ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thích", "definition": "親戚. Họ nội và họ ngoại. Chỉ chung họ hàng. Đoạn trường tân thanh: “Cùng trong thân thích ruột rà chẳng ai”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thắng", "definition": "Bandhuśrī (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Thế", "definition": "身世. Cuộc đời và sự nghiệp của một người. Đoạn trường tân thanh: “Đã xong thân thế còn toan nỗi nào”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thể", "definition": "身體. Chỉ chung mình mẩy chân tay của một người. Thơ Tản Đà: “Thật hồn thật phách thận thân thể”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thể Con Người", "definition": "Kalebara (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Thể Hôi Thúi", "definition": "Pūtikāya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Thể Khỏe Mạnh", "definition": "Kallasarīra (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Thể Tráng Kiện", "definition": "Kallasarīra (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Thời", "definition": "申時. Giờ thân, tức khoảng từ 15 tới 17 giờ chiều.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Thức", "definition": "Kāya-vijñāna (S), Kaya-vinñāṇa (P), Body-consciousness.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Trong Sạch", "definition": "Kāmasucarita (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Tâm Nhất Như", "definition": "身 心 一 如. Còn gọi: Sắc Tâm Bất Nhị, Tính Tướng Bất Nhị. Thân chỉ cho sắc thân, thân thể. Tâm chỉ cho tâm linh, tinh thần. Tức là nhục thể cùng tinh thần là một thể không hai, là 2 mặt của một thể, thân tức là thân của tâm, tâm tức là tâm của thân. Ngoại đạo Tiên Ni (Pàli: Senika) ở ấn Độ cổ đại, cho rằng thân là vô thường sinh diệt, duy có tâm là thường trụ bất biến, đây là đối với thân khởi đoạn kiến, đối với tâm khởi thường kiến. Bởi thân tâm cùng với thiện ác, khổ vui đều có tương quan mật thiết, không có pháp nào riêng tự tồn tại, nếu thân vô thường sinh diệt thì tâm cũng vậy; nếu tâm là thường trụ bất diệt thì thân cũng vậy; cho nên cho Thân tâm nhất như; là thật tướng của pháp giới.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thân Tâm Thoát Lạc", "definition": "(身心脫落, shinjindatsuraku): thoát lạc (脫落) nghĩa là cởi bỏ đi, nới lỏng, nghĩa là cả thân cũng như tâm đều thoát ly khỏi mọi ràng buộc, và đạt đến tận cùng cảnh giới của đại ngộ. Đạo Nguyên cho rằng pháp môn Chỉ Quản Đả Tọa (祗管打坐, shikantaza) là thân tâm thoát lạc, không phải thông qua môi giới của Tọa Thiền mà đạt đến cản giới giác ngộ, mà chính hình thức của Tọa Thiền là bóng dáng của thân tâm thoát lạc. Trong Bảo Khánh Ký (寶慶記) có đoạn rằng: “Tham Thiền giả, thân tâm thoát lạc dã; bất dụng thiêu hương lễ bái niệm Phật tu sám khán kinh, chỉ quản đả tọa nhi dĩ (參禪者、身心脫落也、不用燒香禮拜念佛修懺看經、祗管打坐而已, người tham Thiền thì [cần phải] thân tâm giải thoát, không cần phải đốt hương, lễ bái, niệm Phật, sám hối, hay đọc kinh làm gì; chỉ chuyên tâm ngồi Thiền mà thôi).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thân Tình", "definition": "親情. Lòngyêu mến dành cho cha mẹ, hoặc họ hàng, hoặc bè bạn gầngũi nhất với mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Tín", "definition": "親信. Gần gũi đáng tin. Đoạn trường tân thanh: “Khiến người thân tín rước thầy Giác Duyên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Tộc", "definition": "親族. Họ hàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Vương", "definition": "親王. Người họ hàng bên nội của vua, được vua phong tước Vương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Xứ", "definition": "Kāyayatana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thân Ái", "definition": "親愛. Gần gũi yêu mến.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thân Đau Khổ", "definition": "Kāyikadukkha (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thân Đích", "definition": "親 的. Khế hợp, ăn khớp với thiền pháp. Tiết Dục Vương Hoài liễn Thiền Sư trong NĐHN q. 15 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thân Độ Nhị Bất Tương Ly", "definition": "身土二不相離 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thân Độ Tứ Y", "definition": "身四依 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thâu", "definition": "愉. Cẩu thả Một âm là Du. Xem Du.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thâu Gom", "definition": "Saṃvarati (saṃ + var + a), saṃvarana (trung), samuccaya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Góp", "definition": "Saṅkalana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Lan Giá", "definition": "Xem Đại tội.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thâu Lan Giá Da", "definition": "Xem Đại tội.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thâu Lại", "definition": "Samantāharati (saṃ + anu + ā + hār + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Lấy", "definition": "Paṭigganhana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Ngắn", "definition": "Saṅkhipati (saṃ + khip + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Nhập", "definition": "Saṅgāha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Tâm", "definition": "偸 心. Tâm trộm cắp; trong Thiền lâm chỉ tâm hướng ngoại phân biệt. Hư Đường Lục q. 3 (Đại 47, 1011 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thâu Được", "definition": "Paṭilābha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thâu Đạo", "definition": "Adinnadanam (P), Theft.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thèm Khát", "definition": "Greed.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thèm Muốn", "definition": "Lolatā (nữ), pihālu (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thét dài một tiếng, lạnh bầu trời”. Ngô Tất Tố dịch.", "definition": "2. Ngư nhàn:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thê", "definition": "凄. Lạnh lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Hiền Sơn", "definition": "棲 賢 山. X. Tam Giác Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thê Hiền Thiền Viện Thạch Tháp", "definition": "棲 賢 禪 院 石 塔. Tháp nằm trên núi Tam Giác cách trung tâm huyện Kim Đường tỉnh Tứ Xuyên Trung Quốc 3km về phía bắc. Theo tấm bia đời Minh “Thê Hiền Sơn Đạo Tràng Thiền Viện Thạch Tháp Ký”, niên hiệu Hồng Vũ thứ 31 (1398) đời Minh, vua Thục Vương cho xây 168 ngôi tháp nhỏ ở phía sau Thiền viện Thê Hiền, họp thành một đại thạch tháp, gọi là “Vô Lượng Bảo Tháp”. Mỗi tháp có khắc 500 tượng Phật, tổng cộng 84. 000 tượng Phật. Trong tháp chứa kinh Pháp Hoa, trước tháp có ba gian nhà đá, chung quanh có tường đá bao bọc. Công trình to lớn, tinh xảo tuyệt luân, trải qua 5 năm mới hoàn thành. Đến cuối đời Minh tháp này được trùng tu lại, hiện nay vẫn còn bệ tháp, nhà đá và số ít tượng Phật, bia đá.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thê Hiền Trí Nhu", "definition": "Chi hsien Cinh jou (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thê Hà Tự", "definition": "栖 霞 寺. Nằm trên sườn phía tây Trung Phong, núi Thê Hà, đông bắc thành phố Nam Kinh, tỉnh Giang Tô, Trung Quốc. Niên hiệu Vĩnh Minh thứ 1 (483) đời Nam Tề, ẩn sĩ Minh Tăng Thiệu sửa nhà làm Thê Hà tinh xá. Đường Cao Tổ Lý Uyên đổi tên chùa là “Công Đức Tự”, còn xây cất thêm lâm cung phạm vũ 49 sở, diện mạo chùa thay đổi lớn, nổi tiếng nam bắc, cùng với Thiên Thai Quốc Thanh Tự, Trường Thanh Linh Nham Tự, Đương Dương Ngọc Tuyền Tự được gọi là “Thiên hạ tứ đại tùng lâm”, “Thiên hạ tứ tuyệt”. Đời Nam Đường Cao Việt cất Xá Lợi thạch tháp, đổi tên là “Diệu Nhân Tự”. Niên hiệu Thái Bình Hưng Quốc thứ 5 (980) đời Tống đổi tên là “Phổ Vân Tự”. Niên hiệu Cảnh Đức thứ 4 (1007) đổi tên là “Thê Hà Thiền Tự”. Niên hiệu Nguyên Hựu thứ 8 (1093) đổi tên là “Nham Nhân Sùng Báo Thiền Viện”, sau còn gọi “Hổ Huyệt Tự”. Niên hiệu Hồng Vũ thứ 25 (1392) đời Minh sắc thư “Thê Hà Tự”. Niên hiệu Hàm Phong thứ 5 (1855) đời Thanh chùa bị chiến tranh phá hủy. Niên hiệu Quang Tự thứ 34 (1908) về sau, những vị tăng trụ trì Tông Ngưỡng, Nhã Thuấn nối nhau tu sửa dần dần khôi phục như cũ. Trong chùa hiện còn Sơn môn, Thiên vương điện, Tỳ Lô điện, Tàng kinh lâu, Nhiếp thúy lâu, ngoài ra còn có Đại Phật các, Thiên Phật nham, Xá Lợi tháp, thạch tháp đời Ngũ Đại và bia đá đời Đường, có giá trị lịch sử và nghệ thuật rất cao.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thê Hà Tự Xá Lợi Tháp", "definition": "栖 霞 寺 舍 利 塔. Nằm trong khuôn viên Thê Hà Thiền Tự, núi Thê Hà, thành phố Nam Kinh, tỉnh Giang Tô, Trung Quốc, được xây vào niên hiệu Nhân Thọ thứ 1 (601) đời Tùy, sau đó bị hủy. Thời Nam Đường, Cao Việt, Lâm Nhân xây dựng lại, xây bằng đá, 5 tầng, hình bát giác, cao 15m. Phần dưới tháp là một tòa Tu Di điêu khắc tinh mỹ, trên khắc hoa sen nở xòe ba lớp nâng đỡ thân tháp. Tầng thứ nhất của tháp khá cao, từ đây trở lên bày 5 tầng mái kín, là tháp xây trau chuốt bằng đá theo kiểu mái kín, mái vươn ra rất xa, vẫn còn gìn giữ đặc điểm kiểu lâu các. Khắp thân tháp bố trí dày đặc điêu sức tinh mỹ, có thể gọi là một tác phẩm nghệ thuật điêu khắc to lớn. Nền tòa khắc các loại cá cua ếch, phần thắt lưng trên tòa Tu Di là tranh truyện Phật “Thích Ca Bát Tướng”, trên thân tháp là Kim Cang lực sĩ, tiểu Phật, những điêu sức này đều sinh động tinh tế đẹp đẽ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thê Lương", "definition": "淒涼. Buồn rầu lạnh lẽo. Cung oán ngâm khúc: “Hơi thê lương lạnh ngắt song phi huỳnh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Nhi", "definition": "妻兒. Vợ và con. Đoạn trường tân thanh: “Quan san nghìn dặm thê nhi một đoàn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Noa", "definition": "妻孥. Vợ và con nhỏ. Bản dịch Chinh phụ ngâm khúc: “Buổi tiễn đưa lòng bận thê noa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Phong", "definition": "淒風. Gió lạnh. Hát nói của Cao Bá Quát: “Thê phong lãnh nguyệt dạ hà như” (Gió buồn trăng lạnh, đêm thế nào).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Thiếp", "definition": "妻妾. Vợ lớn và vợ bé.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Thiền Tự", "definition": "棲 禪 寺. X. Thảo Đường Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thê Thảm", "definition": "淒慘. Sầu khổ lạnh lùng. Tự tình khúc của Cao Bá Nhạ: “Phút nửa khắc muôn ngàn thê thảm”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thê Tử", "definition": "妻子. Như Thê nhi 妻兒.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thêm Vào", "definition": "Odahati (ova + dah + a), pabhāveti (pa + bhū + e), saṅkalana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thêm nữa, Kinh Hoa Nghiêm và Kinh Duy Ma được gọi là Kinh Bất Khả Tư Nghị Giải Thoát, Đức Phật A Di Đà được gọi là Bất Khả Tư Nghị Quang Như Lai, Bồ Tát được gọi là Bất Khả Tư Nghị Bồ Tát, Nan Tư Nghị Bồ Tát v.v... đều thuộc những trường hợp kể trên. (xt. Tứ Bất Tư Nghị).", "definition": "II.Bất Khả Tư Nghị. Vị tăng đời Đường. Người nước Tân La ở chùa Linh Diệu, tên là Bất Khả Tư Nghị, làm đệ tử ngài Thiện Vô Úy. Vào cuối năm Khai Nguyên (713-741), sư có soạn Đại Nhật Kinh Cúng Dường Thứ Đệ Pháp Sớ 2 quyển, người thời bấy giờ gọi là Bất Tư Nghị Sớ. Còn những sự tích khác về sư không được rõ.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thênh Thang", "definition": "Brahanta (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thì", "definition": "塒. Cái bậc làm để cho gà đậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thì Giờ", "definition": "Velā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thì La", "definition": "蒔蘿. Tên một loài cây nhỏ có mùi thơm, dùng làm rau thơm, còn gọi là Tiểu hồi hương, ta thường đọc trại là Thì là.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thìa", "definition": "Kaṭacchu (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thìn", "definition": "辰. Vị thứ năm trong Thập nhị địa chi Xem Thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thình Lình", "definition": "Sahasā (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thí", "definition": "Xem Bố thí.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Ba La Mật", "definition": "Dana Paramita", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thí Chủ", "definition": "Dānapati (S), Dānadāsa (P), Dānasahāya (P), Giver, Noble giver.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Dụ", "definition": "Avadāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Dụ Sư", "definition": "Distantika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Dụ Tập", "definition": "Avadāna-kalpalata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Hạnh", "definition": "Hạnh bố thí.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Hộ", "definition": "(s: Dānapāla, 施護, khoảng thế kỷ thứ 10): vị tăng dịch kinh dưới thời nhà Tống, xuất thân Ô Chấn Nẵng Quốc (s: Udyāna, 烏塡曩國) ở miền Bắc Ấn Độ, người đời thường gọi là Hiển Giáo Đại Sư (顯 教大 師), năm sanh và mất không rõ. Vào năm thứ 5 (980) niên hiệu Thái Bình Hưng Quốc (太平興國) đời vua Thái Tông nhà Bắc Tống, ông cùng với Tam Tạng Thiên Tức Tai (天息災) nước Ca Thấp Di La (迦濕彌 羅) thuộc miền Bắc Ấn Độ sang vùng Biện Kinh (汴京, Khai Phong), dừng chân trú tại Dịch Kinh Viện (譯經院, cơ quan dịch kinh do chính phủ lập nên) của Thái Bình Hưng Quốc Tự (太平興國寺) và dốc hết toàn lực cho việc phiên dịch kinh điển. Tác phẩm cọng dịch có Đại Thừa Trang Nghiêm Bảo Vương Kinh (大乘莊嚴寳王經) 4 quyển, Cấp Cô Trưởng Giả Nữ Đắc Độ Nhân Duyên Kinh (給孤長者女得度因縁經) 3 quyển, Quảng Thích Bồ Đề Tâm Luận (廣 釋 菩 提 心 論) 4 quyển, Đại Thừa Nhị Thập Tụng Luận (大乘二十頌論) 1 quyển, Lục Thập Tụng Như Lý Luận (六十頌如 理 論) 1 quyển, Nhất Thiết Như Lai Chân Thật Nhiếp Đại Thừa Hiện Chứng Tam Muội Đại Giáo Vương Kinh (一切如來眞實攝大乘現證三昧大教王經) 30 quyển, Nhất Thiết Như Lai Kim Cang Tam Nghiệp Tối Thượng Bí Mật Đại Giáo Vương Kinh (一切如來金剛三業最上祕密大教王經) 7 quyển, Thủ Hộ Đại Thiên Quốc Độ Kinh (守護大千國土經) 3 quyển, Biến Chiếu Bát Nhã Ba La Mật Kinh (遍照般若波 羅蜜經) 1 quyển, v.v., gồm 115 bộ và 225 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thí Hữu Tứ Sự", "definition": "施有四事 (Chư Kinh Yếu Tập)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thí Lâm", "definition": "Ở Ấn Độ ngày xưa, có tục lệ không hỏa táng hay chôn cất người chết mà đặt thi thể người chết trong rừng, để cho dã thú hay chim chóc ăn thịt, rừng dùng vào việc đó gọi là rừng bố thí. Theo truyền thuyết thì tín đồ đạo thờ Thần Lửa (Hỏa giáo) thực hành lối chôn cất này.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Lợi", "definition": "施 利. Của cải do người đời quyên tặng cho tự viện, cho tăng sĩ. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thí Nghiệm", "definition": "試驗. Thử xem có đúng như vậy không.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thí Nguyện Ấn", "definition": "Varada-mudrā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Nhất Thiết Vô Úy Bồ Tát", "definition": "Xem Thí Vô Úy Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Phát", "definition": "(Cạo Tóc). Bhaṇḍukamma (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thí Quả Cảm Ngũ Bất Tử", "definition": "施果感五不死 (Phó Pháp Tạng Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thí Sinh", "definition": "試生. Người đi thi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thí Tam Thốn", "definition": "施 三 寸. Ý nói phát biểu ý kiến, giảng giải. Tham thốn: Lưỡi. Tiết Phúc Tiên Chiêu Khánh Hòa Thượng trong TĐT q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thí Thiết", "definition": "Sắp xếp, tổ chức, khởi động.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Thiết Luận Bộ", "definition": "S. Karmikah. Bộ phái Phật giáo, nhấn mạnh tầm quan trong của nếp sống đạo đức, so với kiến thức.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Thân Cho Cọp Đói", "definition": "(Chuyện tiền thân). Đây là một chuyện tiền thân của đức Phật Thích Ca Mâu Ni, trong thời kì Ngài còn tu tập hạnh Bồ-tát. Ở thời quá khứ xa xưa, có một chàng thanh niên vốn là tín đồ đạo Bà-la-môn, thông minh tài trí hơn người, từ thuở nhỏ đã nổi tiếng là thần đồng. Càng trưởng thành chàng càng nhận rõ, giáo lí Bà-la-môn còn nhiều thiếu sót, không thể giúp chàng phát triển trí tuệ cao tột, không đáng tin tưởng và hành trì một cách hoàn toàn. Bởi vậy, chàng quyết định tự tìm cho mình một con đường mới, có thể giải thoát sinh tử. Chàng bèn lìa bỏ gia đình và tài sản, cắt đứt ái dục, tìm vào chốn núi rừng sâu thẳm, sống trong không khí tịch tĩnh, quyết tâm tu tập. Một thời gian sau, các bạn hữu của chàng ngày trước, ngưỡng mộ đạo đức và trí tuệ của chàng, cũng rủ nhau tìm vào rừng xin được tu tập dưới sự hướng dẫn của chàng. Một ngày nọ, chàng dẫn một người đồ đệ cùng đi bách bộ trên con đường núi. Bỗng chàng nhìn xuống sườn núi, thấy một con cọp gầy yếu đang kêu rên, xem chừng đang đói rũ riệt. Bên cạnh nó là một con cọp con, hình như mới sinh không lâu. Cọp mẹ có vẻ như đã đến lúc không còn chịu đựng nổi cơn đói, cứ lăm lăm nhìn cọp con, miệng nhỏ dãi, gầm gừ, như muốn ăn thịt. Thấy tình cảnh vô cùng thảm thương đó, chàng động lòng từ bi, gọi người đồ đệ đến, chỉ xuống chỗ con cọp mà bảo: “Thật đáng thương cho chúng sinh! Vì cơn đói hành hạ, đến nỗi quên đi tình mẹ con. Con cọp con kia có thể sắp bị cọp mẹ ăn thịt. Bạn hãy đi tìm gấp thức ăn để giải cứu cái tình cảnh bi thương này!” Người đồ đệ đi rồi, chàng lại suy nghĩ: “Ta nay thấy khổ không cứu, thì còn đâu là tinh thần của kẻ tu đạo! Ta có thể gieo cái thân xác giả tạm này xuống dưới đó, vừa giúp cho cọp có một bữa ăn, cứu mạng sống của cả hai mẹ con, lại vừa cổ lệ người đời, phát khởi tình thương đối với các loài động vật.” Suy nghĩ như vậy rồi, chàng liền gieo mình xuống chỗ con cọp đói, bố thí xác thân để cứu mạng sống của cả hai mẹ con cọp đói.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thí Thực", "definition": "Bố thí, cúng dường thực phẩm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Thực Hoạch Ngũ Phước Báo", "definition": "施食獲五福報 (Thí Thực Hoạch Ngũ Phước Báo Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thí Tăng", "definition": "Cúng dường, bố thí cho Tăng chúng.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Vô Uý", "definition": "Abhaya dāna (S), Abhayapradāna (S), Fearlessness giving.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Vô Uý Giả", "definition": "Octroi-Courage, Donateur de Sécurité bestower of fearlessness 施無畏者 abhaya-dāna", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thí Vô Yểm", "definition": "Bố thí không biết chán. Dịch nghĩa từ Nalanda, tên một tu viện lớn gần thành Vương Xá khoảng 7 dặm về phía bắc. Huyền Trang từng lưu học ở đây nhiều năm.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thí Vô Úy", "definition": "(B.T).Bestower of Fearlessness Boddhisattva", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thí Vô Úy Bồ Tát", "definition": "Abhayaṃdāna (S), Abhayaṃdada (S), Fearlessness-Giving Bodhi-sattva.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thí Vô Úy Ấn", "definition": "Abhaya mudrā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích", "definition": "倜. Thích thảng 倜儻: Không gò bó, thảnh thơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Ca", "definition": "Sakya: Là tên một bộ tộc, có nghĩa là “có năng lực”. Bán đảo Ấn-độ thời bấy giờ chia ra rất nhiều vương quốc, mỗi vương quốc do một bộ tộc cai trị. Bộ tộc Thích-ca chiếm cứ vùng đất nằm giữa chân núi Hi-mã-lạp (Himalaya) ở phía Bắc, các vương quốc Câu-lị (Koliya) ở phía Đông, Mạt-la (Malla) ở phía Nam, và Kiều-tát-la (Kosala) ở phía Tây. Theo Truyền thuyết, tổ tiên của bộ tộc Thích-ca khởi nguồn từ vua Cam Giá (Iksvaku), ở thành Potala, xứ Ayodhya (nay là vùng Ngũ-hà - Panjab), trên lưu vực sông Ấn (Indus). Vua Cam Giá có người vợ cả, sinh được bốn hoàng tử; sau lấy vợ thứ, sinh được một hoàng tử. Bà vợ thứ muốn con mình sau làm vua, nên xúi vua Cam Giá đuổi bốn hoàng tử con của bà vợ cả ra khỏi nước. Bốn anh em phải ra đi lang thang vô định. Khi đến chân núi phía Nam của dãy Hi-mã-lạp thì họ dừng lại. Tại đây họ đã lập nên sự nghiệp hùng mạnh, làm chủ một bộ tộc, và dựng lập thành Ca-tì-la-vệ. Vua Cam Giá biết được tin này, liền vui mừng khen rằng: Đó quả là những hoàng tử “có năng lực” (tiếng Phạn là “sakya”). Từ đó, bộ tộc và vương quốc do bốn hoàng tử sáng lập được đặt tên là “Sakya” (Thích-ca). Sau đó, khi ba trong bốn anh em qua đời, người còn lại trở thành vua của vương quốc Thích-ca, kinh đô là thành Ca-tì-la-vệ. Vua Sư Tử Giáp (Simhahanu) là đời thứ tư của dòng Thích-ca (tức đời thứ năm kể từ vua Cam Giá), sinh bốn trai và một gái: đó là các hoàng tử Tịnh Phạn (Suddhodana), Bạch Phạn (Suklodana), Hộc Phạn (Dronodana), Cam Lộ Phạn (Amrto-dana) và công chúa Cam Lộ (Pamita). Tịnh Phạn được nối ngôi vua của vương quốc, và là phụ vương của Phật. Đương thời, Thích-ca là một nước nhỏ, đất đai không phì nhiêu lắm, hết phân nửa lãnh thổ về phía Bắc là vùng cao nguyên, toàn đồi núi; phân nửa còn lại ở phía Nam là vùng đồng bằng. Kinh thành Ca-tì-la-vệ nằm trong vùng đồng bằng ấy. Vương quốc này ngày nay là địa phận xứ Tilorakot ở vùng Terai, miền Nam nước Nepal, giáp ranh giới phía Bắc của nước Ấn-độ.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thích Ca Dị Danh", "definition": "Trong kinh Hoa Nghiêm, Bồ Tát Văn Thù cho biết, tại cõi Sa bà nơi Phật Thích Ca đang giáo hóa, Phật Thích Ca còn có một số danh hiệu khác như:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thích Ca Mâu Ni", "definition": "Sakya-muni . “Thích-ca” là tên bộ tộc của Phật, có nghĩa là có năng lực, cho nên dịch “năng nhân” (能仁) là không đúng, mà phải dịch là “năng” (能). “Mâu-ni” nghĩa là vắng lặng, nhân từ, bậc thánh, người hiền, ẩn sĩ, là tiếng được dùng rất phổ biến vào thời Phật tại thế, để chỉ chung cho những vị ẩn tu trong rừng sâu núi thẳm, thân miệng ý đều vắng lặng. Đa số các nhà Phật học Trung-quốc xưa đã dịch một cách chính xác: “Thích-ca” là năng, và “ mâu-ni” là tịch (寂), tịch tịnh (寂靜), tịch mặc (寂默), nhân (仁). Gộp cả lại, “Thích-ca mâu-ni” được dịch là năng tịch (能寂) hay năng nhân (能仁);  – vì chữ “mâu-ni” vừa có nghĩa là “tịch mặc” mà cũng vừa có nghĩa là “nhân”, cho nên đã có người dịch lầm “Thích-ca” là “năng nhân” và “mâu-ni” là “tịch mặc”. Lại nữa, “mâu-ni” cũng được gọi là “văn-ni” (文尼), hoặc gọi tắt là “văn”, cho nên “Thích-ca mâu-ni” cũng có khi trở thành “Thích-ca văn”. Đức Phật thuộc bộ tộc Thích-ca, khi còn là thái tử thì có tên là Tất Đạt Đa, sau khi thành đạo thì được người đời xưng hiệu là Thích Ca Mâu Ni, có nghĩa là bậc thánh của bộ tộc Thích-ca. Lại nữa, thỉ tổ của bộ tộc Thích-ca là vua Cam Giá, cũng gọi Cồ Đàm (Gautama); cho nên, Thích-ca đã được coi là một phân tộc của họ Cồ-đàm. Bởi vậy, người đương thời cũng gọi đức Phât là sa môn Cồ Đàm, hay đạo sĩ Cồ Đàm. Có sách nói, Cồ-đàm, Cam-giá, Nhật-chủng, Thích-ca và Xá-di, là năm họ của Phật; đó là một đại quí tộc thuộc giai cấp Sát-đế-lị của thời cổ Ấn-độ, thuộc giống người Aryan (từ miền Trung-Á xâm nhập và làm chủ vùng Bắc và Tây Bắc Ấn-độ  khoảng 3.000 năm trước Tây lịch).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thích Ca Như Lai", "definition": "Śākyamuni-Tathāgata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca Sư Tử", "definition": "Śākyasiṃha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca Thi Khí Phật", "definition": "Xem Kế Na Thi Khí Phật.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca Tỳ Lăng Già Ma Ni Bảo", "definition": "Sakrabhilagma-mani-ratna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca Vương", "definition": "Xem Trì Quốc Thiên Vương.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca phương chí quyển thượng (Đại 51, 950 thượng) nói: “Địa vị cao nhất của người phàm là Luân Vương; địa vị cao nhất của Thánh Nhân là Pháp Vương”. [X. Kinh Du Hành trong Trường A Hàm Q.3; Phẩm Phật Quốc Kinh Duy Ma Q.thượng; Phẩm An Lạc Hạnh Kinh Pháp Hoa Q.5].", "definition": "II.Pháp Vương.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thích Ca thị phổ (Đại 50, 84 hạ) nói: “Kiếp ba, Hán dịch là Đại thời.Một Đại thời có vô số năm, phải mượn thí dụ để diễn tả mới có thể biết được”. [X. Luận Đại Tì Bà Sa Q.135; Luận Đại Trí Độ Q.7]. (xt. Kiếp).", "definition": "II.Nhất Kiếp.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thích Ca Đa Bảo Như Lai Phật Tháp", "definition": "釋 迦 多 寶 如 來 佛 塔. ở phía trước chùa Ngũ Tổ, cách trung tâm huyện Hoàng Mai, tỉnh Hồ Bắc, Trung Quốc 12km về phía đông. Căn cứ vào bài minh ghi trên thân tháp, tháp xây vào niên hiệu Tuyên Hòa thứ 3 (1121) đời Tống. Tháp xây bằng nham thạch sa lạp, 5 tầng, hình bát giác. Phía dưới là tòa Tu Di thắt lưng cánh sen, thắt lưng hình bát giác đều có một tượng khắc Lực sĩ nâng đỡ tháp, tạo dáng phong cách vững vàng khỏe mạnh, vô cùng sinh động. Trên tòa Tu Di là thân tháp kiểu cái trống đứng, mặt nam thân tháp có tạc Phật khám, trong khám thờ tượng Phật ngồi. Bên phải khám khắc 8 chữ “Thích Ca Đa Bảo Như Lai Phật Tháp”, bên trái khắc tên họ những người quyên góp xây tháp. Trên Phật khám là mái tháp kiểu hoa núi lá chuối, mái tháp mỗi tầng đều là hình thức phỏng theo kiến trúc gỗ, nhưng đồng thời kèm theo cảm giác phong phú của kiến trúc nặng nề của đá. Tầng trên cùng là bảo cái cánh sen, trên bảo cái có chiếc bát úp và bảo châu đỉnh sát, tháp thể tuấn tú vững vàng, điêu khắc điển nhã lung linh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Ca Đề Bà", "definition": "Xem Đế Thích Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca Đề Hoàn Nhân", "definition": "Xem Đế Thích Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ca Đề Hoàn Nhân Đà La", "definition": "Xem Đế Thích Thiên.Xem Đế Thích.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Chí", "definition": "適志. Đúng với ý muốn của mình. Hát nói của Nguyễn Công Trứ: “Sách có chữ Nhân sinh thích chí”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Chúng", "definition": "釋 眾. Tăng chúng. Chương Sư Tử Tỷ kheo, Tổ thứ 24 trong CĐTĐL q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Cước", "definition": "刺 脚. Bước chân đi. Tiết Thạch Sương Khánh Chư Thiền Sư trong NĐHN q. 5 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Danh Tự Tam Muội", "definition": "Adhivacana-pravesa-samādhi (S), Adhivacana-pravesa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Duyệt Kim Cang Nữ", "definition": "Xem Kế Lị Cát La Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Dụng", "definition": "適用. Vừa hợp với sự cần dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Hợp", "definition": "適合. Vừa đúng với.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Khách", "definition": "刺客. Kẻ đem theo vật bén nhọn để đâm chết người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Khí Phật", "definition": "Sikkin (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Khẩu", "definition": "適口. Hợp miệng. Ngon miệng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Lai", "definition": "適 來. Vừa rồi, ban nãy. Minh Giác Ngữ Lục q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Luận", "definition": "Xem Đại Trí Độ Luận.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Lí", "definition": "戚里. Làng quê bên ngoại. Văn tế Trương Công Định của Nguyễn Đình Chiểu: “Nào đã đặng mấy hồi nơi thích lí”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Lượng Luận", "definition": "Pramāṇa-vaṛttika (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Môn", "definition": "釋門. Cửa Phật. Chỉ đạo Phật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Mùi Thơm", "definition": "Gandhalubdha (S), Desirous of odours.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Nghi", "definition": "適宜. Vừa hợp, đúng với điều nên làm, nên có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Nghĩa", "definition": "Arthavāda (S)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Thích Bất Hưu", "definition": "刺 刺 不 休. Hình dung miệng nói rất nhiều, huyên thiên không dừng. Bác Sơn Hòa Thượng truyện trong NLQL q. 35 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Thú", "definition": "Modati (mud + a), pamoda (nam), vidona (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thích Thảng Phân Minh", "definition": "倜 儻 分 明. Thật là rõ ràng. Tiết Tư Thọ Ni Diệu Tổng Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Thị", "definition": "釋 氏. Chỉ cho đạo Phật, Phật pháp, Phật môn. Tông Môn Võ Khố ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Thị Giáo", "definition": "釋 氏 教. Chỉ cho Phật giáo. Bài tựa Lục Tổ Đàn Kinh của Lang Giản ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Thị Kê Cổ Lược", "definition": "(釋氏稽古略, Shakushikeikoryaku): 4 quyển, do Giác Ngạn Bảo Châu (覺岸寳洲) nhà Tống biên, san hành vào năm thứ 23 (1544) niên hiệu Gia Tĩnh (嘉靖) nhà Minh. Là bộ sử truyền ký do vị Thiền tăng Giác Ngạn ở Ngô Hưng (呉興) thâu lục, đây cũng là sử thư biên niên giống như Phật Tổ Lịch Đại Thông Tải (佛祖歷代通載). Với trung tâm là cương quy của các triều đại Trung Quốc, tác phẩm này thuật rõ sự tích của vườn Thiền, bao trùm các sự thật lịch sử trong ngoài Tam Giáo. Vào năm thứ 14 (1354) niên hiệu Chí Chánh (至正), nó được tái biên, và sau đó được san hành vào các năm thứ 11 (1638) niên hiệu Sùng Trinh (崇貞), thứ 12 (1886) niên hiệu Quang Tự (光緒), thứ 3 (1663) niên hiệu Khoan Vĩnh (寬永), v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thích Thời", "definition": "適時. Hợp với lúc mình đang sống. Hợp thời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Tôn", "definition": "“Tôn” tức là Thế Tôn, tiếng mà người đời dành riêng để chỉ tôn xưng các đức Phật; “Thích” tức Thích Ca. “Thích Tôn” tức là Thích Ca Thế Tôn. Vậy, Thích Tôn là tiếng dùng để tôn xưng riêng cho đức Phật Thích Ca Mâu Ni, còn tiếng Thế Tôn thì dùng để tôn xưng chung cho cả đức Phật Thích Ca và chư Phật.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thích Tử", "definition": "Śākyaputta (S), Son of the Sakyan.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ý", "definition": "適意. Hợp với điều mình nghĩ, mình muốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Ý Hoa", "definition": "Xem Mạn Đà La Hoa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Đáng", "definition": "適當. Vừa đúng, nên làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thích Đạo Thái", "definition": "Tao T'ai (C)", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Đầu", "definition": "刺 頭. Chui đầu vào. Tiết Chư Phương Quảng Ngữ trong GTPĐL q. 25 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Đầu Nhập Giao Bồn", "definition": "刺 頭 入 膠 盆. Còn gọi: Thích não nhập giao bồn. Đâm đầu vào bồn keo. Thiền Tông mượn cụm từ này để chỉ cho việc chấp ngôn ngữ văn tự là cứu cánh Phật pháp mà không thoát ra được. Tiết Pháp Xương ỷ Ngộ Thiền Sư trong NĐHN q. 16 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thích Đế Hoàn Nhơn", "definition": "Xem Đế Thích.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Đề Hoàn Nhân", "definition": "Xem Đế Thích Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Đề Hoàn Nhân Vấn Kinh", "definition": "Xem Kinh Đế Thích Sở Vấn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Đề Hoàn Nhơn", "definition": "Shakra Devanam Indra", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thích Ở Trên Trời", "definition": "Gaganapriya (S), Fond of the sky.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thích Ứng", "definition": "Yathāruciṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thím", "definition": "(Vợ Của Chú). Cūllamātu, cūlamātā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thính", "definition": "凊. Lạnh. Mát lạnh Ta quen đọc Sảnh. Xem Sảnh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thính Giác", "definition": "Sāvaka-kicca (P), Function of hearing.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thính Giả", "definition": "聼者. Người nghe.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thính Pháp Ngũ Chủng Bất Tác Dị Ý", "definition": "聽法五種不作異意 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thính Tụng", "definition": "聼訟. Nghe kiện cáo để xét xử.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thóa", "definition": "唾. Nhổ nước miếng. Khạc nhổ Nước miếng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thóa Diện", "definition": "唾面. Nhổ vào mặt. Làm nhục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thóa Dịch", "definition": "唾液. Nước bọt (nước miếng).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thóa Mạ", "definition": "唾駡. Khạc nhổ chửi mắng, ý nói mắng nhiếc, làm nhục.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thóc", "definition": "Odana (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thói Quen", "definition": "Cāritta (trung), sīla (trung), vutti (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thô", "definition": "粗. Sơ sài. Qua loa Xấu xí, to lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thô Bạo", "definition": "粗暴. Cục cằn bặm trợn, không giữ ý tứ nhẹ nhàng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thô Bỉ", "definition": "粗鄙. Quê mùa kém cỏi Xấu xa đáng khinh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thô Cứng", "definition": "Khara (tính từ), āhuṇa (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thô Hèn", "definition": "Coarse and shoddy", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thô Kịch", "definition": "Lūkha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thô Lỗ", "definition": "Parusāvācā (S), Evil words Pharusāvācā (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thô Sơ", "definition": "Olārika (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thô Thiển", "definition": "粗淺. Vụng về nông cạn. Vụng và kém.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thô Thực Dị Bảo, Tế Tước Nan Cơ", "definition": "粗 食 易 飽 細 嚼 難 機. Tức là nhai ẩu, nuốt trộng tuy dễ no bụng nhưng lại khó tiêu; nhai kỹ ăn chậm chẳng những khó đói mà còn thưởng thức hương vị và lại bổ dưỡng. Trong Thiền Tông mượn thành ngữ này để chỉ nếu có thể tu hành miên mật thì có ngày thể ngộ, sau cùng quyết định đắc đạo. Tắc 48 trong Vô Môn Quan (Đại 48, 298 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thô Tục", "definition": "粗俗. Vụng về quê kệch Ta còn hiểu là xấu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôi", "definition": "催. Thúc giục. Ép buộc. Truyện Trê Cóc: “Lệ binh vâng trát thôi đòi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôi Hoa", "definition": "催花. Thúc giục cho hoa nở. Tụng Tây hồ phú của Nguyễn Huy Lượng: “… Trống thôi hoa rẽ khóm huân do”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôi Hạo", "definition": "(381-450): tự là Bá Uyên, quê ở đất Thanh-hà (Bắc-Ngụy), từ thuở nhỏ đã hiếu học, từng theo cha là Thôi Hoằng học hết kinh sử và bách gia chư tử, lập chí thực hiện lí tưởng chính trị của Nho gia trong việc ổn định xã hội. Ông là một nhà thư pháp nổi tiếng ở Bắc-Ngụy, lại giỏi cả thiên văn, lịch số, được vua Minh-nguyên đế (Thác-bạt Tự, tại vị 409-423) phong chức bác sĩ tế tửu. Dưới triều Thái-vũ đế ông được phong tước Đông quận công, sau đánh giặc có công, được thăng thị trung, rồi Phủ quân đại tướng quân, dần dần lên đến chức tư đồ (tể tướng). Ông đa mưu túc kế, tất cả quân quốc đại sự trong triều đình đều do ông thảo hoạch; Thái-vũ đế rất tin tưởng, việc gì cũng nghe theo lời ông. Ông cũng rất tín phụng Đạo Giáo, kết giao thân thiết với đạo sĩ Khấu Khiêm Chi; cả hai người này đều được Thái-vũ đế trọng dụng. Hai người đã ra sức chiêu dụ Thái-vũ đế thọ lễ làm tín đồ Đạo Giáo, rồi cải niên hiệu thành Thái-bình-chân-quân (440-451) để tỏ lòng trung thành với Thái Thượng Lão Quân. Thôi Hạo vốn rất ghét Phật giáo, cho nên, từ khi vua Thái-vũ đã tin theo Đạo Giáo, ông với đạo sĩ Khấu Khiêm Chi lúc nào cũng đi sát với vua để bài xích và nói xấu Phật giáo; làm cho nhà vua ban đầu vốn tin kính Phật pháp, bây giờ lại tỏ ra nghi ngờ Phật giáo. Thấy vậy, Thôi Hạo bèn thúc đẩy vua triệt để tiêu diệt Phật giáo trên toàn lãnh thổ Bắc-Ngụy. Kết quả, vào năm 444, Thái-vũ đế đã hạ chiếu tiêu diệt Phật giáo.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thôi Miên", "definition": "催眠. Cái khả năng thúc ép được người khác ngủ mê mệt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôi Thúc", "definition": "催束. Giục giã, ép buộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôi Tra", "definition": "催查. Thúc giục hạch hỏi. Đoạn trường tân thanh: “Phủ đường sai lá phiếu hồng thôi tra”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôi Xao", "definition": "推敲. Đẩy và gõ. Chỉ sự gò gẫm lựa chọn từng chữ trong việc làm thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôn", "definition": "吞. Cho vào miệng mà nuốt Chiếm lấy.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôn Công", "definition": "村 公. Ông già nhà quê. Tiết Nam Tuyền Hòa Thượng trong TĐT q. 16 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thôn Lý Nam Nữ", "definition": "村 裏 男 女. Đứa bé quê. Lời nói hàm ý xem thường. Tiết Dược Sơn Hòa Thượng trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thôn Quê", "definition": "Paccanta (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thôn Thổ Bất Đắc", "definition": "吞 吐 不 得. Còn gọi: Thôn Thổ Bất Hạ, Thôn Bất Nhập Thổ Bất Xuất. Nuốt không vào, nhổ không ra. Câu này dùng để hình dung sự rắc rối, khó chịu của tình huống, giống như trong miệng ngậm một vật mà không thể nuốt vào hoặc nhổ ra, muôn phần khó chịu. Còn tỷ dụ cho không có cách nào để ứng đáp, khó xử trí. Thiền Tông mượn từ này để chỉ cho việc không thể tiêu thụ diệu dược Phật pháp vì thiếu đạo tâm. Tắc 83, Thung Dung Lục (Đại 48, 280 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thôn Trang", "definition": "村莊. Làng xóm nhà cửa. Tự tình khúc của Cao Bá Nhạ: “Thôn trang tìm thú ân cần”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôn Tính", "definition": "吞併. Gồm nuốt, ý nói chiếm đất đai người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thôn Viện", "definition": "村 院. Chùa nhỏ ở thôn quê. Tiết Động Sơn Hòa Thượng ở TĐT q. 6 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thôn Điền Châu Quang", "definition": "(村田珠光, Murata Shukō, 1422-1502): một trà nhân nổi tiếng sống giữa hai thời đại Thất Đinh (室町, Muromachi) và Chiến Quốc (戰國, Sengoku), húy là Châu Quang, xuất thân vùng Nại Lương (奈良, Nara). Ban đầu ông là vị tăng của Xưng Danh Tự (稱名寺) vùng Nại Lương, nhưng vì ông rất say mê trong việc uống trà, nên đã bỏ chùa đi ngao du. Sau ông lên kinh đô, đến tham Thiền với Tông Thuần (宗純), khai sáng ra hình thức Trà Lễ của Thiền Viện, và hiểu được áo nghĩa của Trà Thiền Nhất Vị (Trà và Thiền cũng một vị), và tương truyền ông là người khai sáng ra Wabicha (侘茶). Ông từng giao du với những bậc thầy liên ca như Tâm Kính (心敬), Tông Kỳ (宗祇), và hình thành nên lý luận độc đáo của Wabicha (侘茶). Đệ tử ông có Tông Châu (宗珠), Thiệu Trích (紹滴), Tông Lý (宗理), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thôn Đầu", "definition": "村 頭. Người quê mùa, gã thô tục. Bài thơ “Tự tán” trong NTNL q. hạ:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thôn Ổ", "definition": "村塢. Nơi làng xóm quê mùa. Tụng Tây hồ phú của Nguyễn Huy Lượng: “Miền thôn ổ lắng chim kêu gà gáy…”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông", "definition": "侗. To lớn Vẻ khờ khạo đần độn. Xem Đồng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Biện", "definition": "通 辯 (?-1134). Thiền tăng đời Lý, thuộc dòng Vô Ngôn Thông đời thứ 8, Sư họ Ngô, quê ở Đan Phượng (nay là huyện Đan Phượng, tỉnh Hà Tây), miền Bắc Việt Nam. Vốn con dòng Phật tử, tính rất thông minh lại hiểu tột tam học. Ban đầu sư đến chùa Kiết Tường tham vấn với Thiền Sư Viên Chiếu, thầm nhận được ý chỉ. Sau, sư đến trụ tại Quốc tự trong kinh đô Thăng Long, từ đó sư lấy hiệu là Trí Không. Nhân việc Hoàng thái hậu Phù Thánh Cảm Linh Nhân đến chùa trai tăng và thưa hỏi về đạo lý, sư giải đáp thật rành rẽ nên Thái hậu rất hoan hỷ, lễ bái phong sư chức Tăng lục, ban cho y hồng và hiệu là Thông Biện Đại Sư cùng trọng thưởng rất hậu. Bởi kính trọng sư, Thái hậu thường triệu thỉnh vào cung và lễ bái phong làm Quốc sư. Lúc tuổi cao, sư về trụ chùa Phổ Minh ở Từ Liêm, mở đàn thuyết pháp. Sư dạy người tu thường lấy kinh Pháp Hoa làm dụng, nên người thời ấy gọi sư là Ngô Pháp Hoa. Ngày rằm tháng 2 năm Giáp Dần, nhằm niên hiệu Thiên Chương Bảo Tự thứ 2 (1134) đời Lý Thần Tông, sư cho hay có chút bệnh rồi thị tịch. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Biện Minh Đức Thiền Sư", "definition": "通 辨 明 德 禪 師. Hiệu của Thiền tăng Thiệu An đời Tống. X. Thiệu An.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Báo", "definition": "Pacāreti (pa + car + e), sāveti (su + e), āroceti (ā + ruc + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thông Bít", "definition": "(Đường), Passes and defiles", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thông Bệnh", "definition": "通病. Cái tật chung, cái khuyết điểm chung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Cáo", "definition": "通告. Nói cho suốt mọi người cùng biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Công", "definition": "聰 公 (860-945). Thiền tăng đời Đường, họ Đàm, tên U, hiệu Thông Công, người Tân Châu (Tân Hưng, Quảng Đông) Trung Quốc. Sư nối pháp thiền sư Thiện Hội, thuộc hệ Thanh Nguyên đời thứ 7, trụ chùa Thanh Viễn Đông Lâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Cục Tứ Cú", "definition": "通局四句 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thông Dung", "definition": "通 容 (1539-1661). Thiền tăng cuối đời Minh đầu đời Thanh, họ Hà, hiệu Phí ẩn, người Phúc Châu Trung Quốc. Thuở nhỏ thông minh lạ lùng, 14 tuổi xuất gia bác thông kinh luận. Đã từng tham kiến Vô Minh Huệ Kinh, Trạm Nhiên Viên Trừng. Đời Minh niên hiệu Thiên Khải thứ 2 (1622) tham yết Mật Vân Viên Ngộ được tâm ấn nối pháp làm truyền nhân tông Lâm Tế. Về sau lần lượt trụ Vạn Phúc Thiền Tự, viện Liên Phong núi Hoàng Bá, chùa Thiên Ninh ở Chiết Giang, chùa Siêu Quả ở Giang Tô, Phúc Nghiêm Thiền Tự, Vạn Thọ Thiền Tự, chùa Duy Ma, viện Hưng Phúc ở núi Nghiêu Phong. Những nơi sư đến đều được phục hưng lại và truyền bá pháp đạo của Viên Ngộ. Tác phẩm: Ngũ Đăng Nghiêm Thống 25 quyển, Ngũ Đăng Nghiêm Thống Giải Hoặc Biên 1 quyển, Tổ Đình Kiềm Chùy Lục 2 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Dâm", "definition": "通淫. Trai gái lén lút ăn nằm với nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Dịch", "definition": "通譯. Chuyển tiếng nói hoặc chữ nước này sang tiếng nói hoặc chữ nước khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Dụng", "definition": "通用. Dùng chung cả. Được nhiều người dùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Dự", "definition": "通 豫 (1588-1646). Thiền tăng cuối đời Minh đầu đời Thanh, họ Trần, tự Lâm Cao, người Côn Sơn (Giang Tô) Trung Quốc. Năm 20 tuổi sư theo Nghiêu Phong Trạm Xuyên xuất gia, sau khi thụ giới cụ túc sư đi tham học khắp nơi, đến Khánh Sơn tham kiến Thiên ẩn Viên Tu được tỏ ngộ, nối pháp làm truyền nhân tông Lâm Tế. Khi ra hoằng pháp, sư trụ chùa Thạch Tiểu, Chung Sơn, Kim Lăng (Nam Kinh), dời sang trụ chùa Bảo Nham, Nghiêu Phong. Niên hiệu Sùng Trinh thứ 11 (1638) dời sang chùa Trúc Lâm, Giáp Sơn, Trấn Giang (Giang Tô) trùng hưng điện vũ, hoằng dương chính pháp. Có Ngữ Lục lưu hành nơi đời.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Gia", "definition": "通家. Hai nhà qua lại với nhau, chỉ hai gia đình có con gả cho nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Gian", "definition": "通奸. Chung nhau làm việc mờ ám Như Thông dâm 通淫.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Giám", "definition": "(通鑑, Tsugan): xem Tư Trị Thông Giám (資治通鑑, Shijitsugan) (斯文): nghĩa là học vấn ấy, đạo ấy. Trong bộ Luận Ngữ, Chương Tử Hãn (子罕) có câu rằng: Thiên chi tướng táng tư văn dã, hậu tử giả bất đắc dữ ư tư văn dã (天之將喪斯文也、後死者不得與於斯文也, vị tướng trời đã chôn đi cái học vấn ấy, nên người chết sau không có được cái học vấn ấy). Như vậy từ này vốn phát xuất từ trong Luận Ngữ.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thông Giáo Thập Địa", "definition": "通教十地 (Thiên Thai Tứ Giáo Nghi)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thông Giáo Vô Sanh Tứ Đế", "definition": "通教無生四諦 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thông Giới", "definition": "Ba nhóm tịnh giới (tam tụ tịnh giới), cả xuất gia và tại gia đều thọ trì được, cho nên gọi là “thông giới”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thông Hiền", "definition": "通 賢 (1593-1667). Thiền tăng đời Thanh, họ Triệu, hiệu Phù Thạch, người Đương Hồ (Chiết Giang) Trung Quốc. Năm 18 tuổi đến núi Phổ Đà yết kiến Thiệu Tông cạo tóc, do Vân Thê Châu Hoằng truyền cho giới Sa Di. Sau đó lần lượt tham kiến các nơi, đến chùa Kim Túc yết kiến Mật Vân Viên Ngộ tham học vài năm, lại theo Viên Ngộ đến Phúc Kiến. Về sau từ biệt Viên Ngộ, sư trụ am Phổ Tịnh, lại trụ chùa Đông Tháp ở Chiết Giang ba năm. Trong lúc đó, Viên Ngộ sang trụ chùa Thiên Đồng, sư cùng theo sau đến Thiên Đồng thăm viếng Viên Ngộ một năm, tức ở Vũ Nguyên bế quan. Năm sau sư hay tin Viên Ngộ mắc bệnh, xin tham kiến lần nữa được nối pháp làm truyền nhân tông Lâm Tế. Sau lần lượt trụ các chùa Thanh Liên, Báo Ân, Quảng Huệ, Đông Tháp, Cảnh Đức, Thê Chân, Thiện Quyền, Phúc Thành. Tác phẩm: Phù Thạch Thiền Sư Ngữ Lục 10 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Hiểu", "definition": "Abhisameti (abhi + saṃ + i + a), abhisamaya (nam), vedeti (vid + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thông Huyền", "definition": "聰玄. Hiểu suốt các lẽ cao siêu. Đoạn trường tân thanh: “Phi phù trí quỷ cao tay thông huyền”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Huyền Bách Vấn", "definition": "通 玄 百 問. Còn gọi: Thông Huyền Bách Vấn Tập Sách, 1 quyển, do Thông Huyền Viên Thông hỏi, Vạn Tùng Hành Tú đáp), sau đó được xếp vào Tục Tạng Kinh tập 119, trang 335. Thiền Sư Viên Thông ở am Thông Huyền tại Tính Châu (Nay là Thượng Nhiêu, tỉnh Quảng Tây) đặt ra 100 câu hỏi để khích lệ người học và tuyên dương Tổ đạo, Vạn Tùng Hành Tú đều đáp được cả, đệ tử của sư là Lâm Tuyền Tùng Luân theo thứ tự phụ tụng. Sinh Sinh Đạo Nhân là Từ Lâm ấn hành vào niên hiệu Thuần Hựu thứ 4 (1244).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Huyễn Tịch Linh", "definition": "Tsūgen Jakurei (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thông Huệ", "definition": "聰慧. Sáng suốt mau hiểu. Như Thông minh. Đoạn trường tân thanh: “Thấy nàng thông tuệ khác thường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Huệ Thiền Sư", "definition": "通 慧 禪 師. Hiệu của Thiền tăng Kính Tuân đời Tống. X. Kính Tuân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Hành", "definition": "通行. Đi suốt được, không bị trở ngại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Kiên Phái", "definition": "Parūpana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thông Kỳ", "definition": "通 奇 (1595-1652). Thiền tăng cuối đời Minh đầu đời Thanh, họ Thái, tự Lâm Dã, người đời gọi “Lâm Dã Thông Kỳ Thiền Sư”, người Hợp Châu (Hợp Xuyên, Tứ Xuyên) Trung Quốc. Tính tình trầm tĩnh không thích ăn thịt. Thuở nhỏ theo hầu hạ Thúc phụ là Đạo Nhiên chùa Kim Chung, 17 tuổi theo Liên Phong xuất gia, 19 tuổi ra khỏi Tứ Xuyên đi nam du, ý muốn nghiên cứu giáo điển nên ở lại Đương Hồ (Chiết Giang) bế quan xem kinh giáo, bỗng bị bệnh kiết lị gần chết mới biết học kinh luận không phải là pháp cứu cánh nhân nghe bài kệ tham thiền của Thiên Đồng: “Một niệm chưa sinh tử, thử khán xem đó là gì?”, như có tỏ ngộ. Một hôm sư trợt chân xuống lầu hoát nhiên tỏ ngộ liền đến Ngô Môn yết kiến Thiên Đồng Viên Ngộ, được tâm ấn nối pháp làm truyền nhân tông Lâm Tế. Đời Minh, niên hiệu Sùng Trinh thứ 16 (1643) khi ra hoằng pháp sư trụ trì chùa Thông Huyền ở Thiên Thai, lần lượt qua các chùa Gia Hòa, Đông Tháp, Thê Chân, Thiên Đồng. Tác phẩm: Lâm Dã Hòa Thượng Ngữ Lục 8 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Lân", "definition": "通鄰. Chỗ hàng xóm qua lại với nhau được. Truyện Hoa Tiên: “Cậy bề cậu cháu định đường thông lân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Lãnh Sơn", "definition": "Hindukush (S), Tsung ling shan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thông Lĩnh", "definition": "Là dãy núi lớn nằm ở phía Tây-Nam tỉnh Tân-cương, trên cao nguyên Pamir, cao trên dưới 8.000m, là cái trục chính của các mạch núi vùng Trung-Á, chia vùng Tây-vực ra làm hai khu vực Đông và Tây. Từ xưa nó vẫn được gọi là cái nóc nhà của thế giới. Núi này, Nam tiếp giáp với Ấn-độ và núi Hi-mã-lạp, Đông tới Tân-cương, Bắc nối liền với dãy núi Thiên-sơn, Tây giáp A-phú-hãn. Theo Đại Đường Tây Vực Kí, vì thổ sản chính của núi này là cây hành, vả lại, toàn núi màu xanh biếc, cho nên được gọi tên là Thông-lĩnh. (Chữ Hán, “thông” (蔥) nghĩa là cây hành, cũng có nghĩa là xanh biếc, xanh ngắt.) Ngày xưa, sự giao thông qua lại giữa Trung-quốc và các nước vùng Tây-vực cùng Ấn-độ (trong đó có các phái đoàn chư tăng truyền giáo), đều xuyên qua Thông-lĩnh. Ngài Huyền Trang Tây hành sang Ấn-độ cũng từng đi qua con đường này.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thông Lĩnh Sơn", "definition": "Xem Thông Lĩnh Sơn.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thông Lệ", "definition": "通例. Đường lối chung vẫn được tuân theo. Truyện Trê Cóc: “Đòi tiền thông lệ bản nha tức thì”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Minh", "definition": "聰明. Đầu óc sáng suốt, mau hiểu. Đoạn trường tân thanh: “Thông minh vốn sẵn tư trời”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Minh Cảnh Giới", "definition": "聰 明 境 界. Cảnh giới thông minh. Người tham thiền chưa thể trừ mọi tri thức kiến giải, chưa thể triệt ngộ tự tính, mà đem trí thông minh thế gian làm nhận thức, kiến giải hư vọng, gọi là “Cảnh giới thông minh”. Tiết Tục Nghệ Ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Môn", "definition": "通 門 (1599-1671). Thiền tăng đời Thanh, họ Trương, hiệu Mục Vân, đời gọi là “Mục Vân Thông Môn Thiền Sư”, người Thường Thục (Giang Tô) Trung Quốc. Sư theo Động Văn chùa Hưng Phúc, Ngu Sơn xuất gia, ban đầu yết kiến Vô Dị Nguyên Lai, sau đó đến chùa Kim Túc tham kiến Mật Vân Viên Ngộ, được tâm ấn nối pháp làm truyền nhân tông Lâm Tế. Giữ chức Ký thất nhiều năm, kẻ theo học có hơn ngàn người. Khi ra hoằng pháp sư trụ Cổ Nam Thiền Viện ở Gia Hưng (Chiết Giang), lần lượt trụ các chùa Thê Chân, Mai Khê, Hưng Phúc, Cực Lạc, Hạc Lâm, tuổi già lui về ở ẩn hơn 10 năm không ở một nơi nào nhất định. Bác thông ngoại học, giỏi thi văn, sở trường thư pháp, hội họa mang ít nhiều phong cách Ngụy Tấn xa xưa. Tác phẩm: Mục Vân Hòa Thượng Ngữ Lục 20 quyển, Mục Vân Hòa Thượng Thất Hội Dư Lục 6 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Ngôn", "definition": "通言. Chuyển tiếng nước nọ sang nước kia.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Nhất Tuyến", "definition": "通 一 線. Mở ra một lối tẻ trên đường. Mật Am Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Nhất Tuyến Đạo", "definition": "通 一 線 道. Mở ra một lối tẻ trên đường, là phương tiện do thiền sư lập bày để tiếp dẫn người học. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Nhẫn", "definition": "通 忍 (1604-1648). Thiền tăng cuối đời Minh đầu đời Thanh, họ Trần, hiệu Triều Tông, người đời gọi “Triều Tông Thông Nhẫn Thiền Sư”, người Thường Châu (Giang Tô) Trung Quốc. Năm 22 tuổi sư theo Thiền Sư Độc Tri am Trường Sinh ở Tĩnh Giang (Giang Tô) cạo tóc xuất gia, được nghe thuyết “Vô sinh”, liền đến chùa Kim Túc tham kiến Mật Vân Viên Ngộ, làm thị giả cho Viên Ngộ. Đời Minh, niên hiệu Sùng Trinh thứ 4 (1631) theo Viên Ngộ đến chùa A Dục Vương, Viên Ngộ nêu lời dạy của Thiền Sư Đại Thiên được khắc lên bia chùa rồi bảo sư: “Hổ dữ trong núi vì sao không ăn thịt con của nó?”. Sư xuất mồ hôi như tắm, ngồi nằm không yên. Hai ngày sau, đang từ ngoài đi vào liêu bất chợt tỏ ngộ, bèn thưa với Viên Ngộ: “Chỉ có người nào tự nhận mới là gần gũi”. Còn trình kệ được thầy ấn khả, nối pháp làm truyền nhân tông Lâm Tế. Về sau, lần lượt trụ các chùa Kỳ Đà Lâm, Linh Hựu, Thượng Sinh, Nam Hoa, Bảo Hoa. Tác phẩm: Triều Tông Thiền Sư Ngữ Lục 10 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Phong", "definition": "通風. Cái chụp đèn, bóng đèn để thoát gió.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Phán", "definition": "通判. Viên chức làm việc tại toà tỉnh thời trước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Pháp Thiền Sư", "definition": "通 法 禪 師. Hiệu của Thiền tăng Đạo Thành đời Tống. X. Đạo Thành.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Phương", "definition": "通 方. Thông đạt, khế hợp đạo pháp. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Rõ", "definition": "Samanupassati (saṃ + anu + dis + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thông Thiền", "definition": "通 禪 (?-1228). Thiền tăng đời Lý, thuộc dòng Vô Ngôn Thông đời thứ 13, nối pháp Thiền Sư Thường Chiếu. Sư họ Đặng, quê làng ốc, An La. Sư cùng với Thần Nghi ở chùa Thắng Quang đồng thờ Thiền Sư Thường Chiếu ở chùa Lục Tổ làm thầy. Một hôm, sư vào thất thưa hỏi rằng: Làm sao hiểu rõ Phật pháp? Thường Chiếu đáp: Phật pháp không thể hiểu được. Liễu ngộ được điều đó thì mới gọi là hiểu pháp. Chư Phật đều tu hành như thế, không đắc bất cứ một pháp nào. Sư ngay câu nói này lãnh ngộ yếu chỉ. Sư trở về cố hương rưới mưa, người học tụ hội rất đông. Phàm có ai thưa hỏi, sư thảy đều dùng tâm ấn tâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Thái", "definition": "Paṇḍicca (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thông Thân Thị Thủ Nhãn", "definition": "通 身 是 手 眼. Toàn thân đều là tay, là mắt. Thiền Tông dùng từ này để biểu thị sự quên đi thế đối lập chủ khách nhằm tiến đến cảnh giới nhất như. Tắc 89, Bích Nham Lục (Đại 48, 213 hạ) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Thương", "definition": "通商. Qua lại buôn bán, không bị cản trở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Thường", "definition": "通常. Luôn có khắp nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Thạo", "definition": "Catura (tính từ), kalla (tính từ) kusalatā (nữ), dakkha (tính từ), dakkhatā (nữ), nipaka (tính từ), nipuṇa (tính từ), paṭu (tính từ), pariṇamati (pari + nam + a), pāguññtā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thông Thời Huyên", "definition": "通 時 喧. Lời thăm hỏi. Tiết Kim Phong Tùng Chỉ Thiền Sư trong NĐHN q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Thừa", "definition": "通 乘 (1593-1638). Thiền tăng đời Minh, họ Chu, tự Thạch Xa, người xứ Kim Hoa (nay thuộc tỉnh Chiết Giang) Trung Quốc. Năm 26 tuổi, nương Ngài Thiên Chân Hải Tạng xuất gia rồi sư thụ giới cụ túc ở chùa Vân Môn, tham khắp các vị Thiện tri thức. Sau đến chùa Kim Túc yết kiến Mật Vân Viên Ngộ, được tâm ấn của ngài, hầu hạ trong 7 năm và nối pháp ngài, thuộc tông Lâm Tế. Niên hiệu Sùng Trinh thứ 4 (1631), sư ra hoằng pháp trụ chùa Long Khánh, núi Đồng Quang ở Hàng Châu, rồi dời sang trụ chùa Kim Túc, khai pháp hoằng hóa, quảng độ quần mê.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Tin", "definition": "通信. Loan tin cho khắp nơi biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Tri", "definition": "通知. Cho khắp nơi cùng biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Tín", "definition": "通 信. Chỉ cho sự giải bày, trao đổi tin tức thiền cơ. Tiết Thạch Sương Sở Viên Thiền Sư trong NĐHN q. 16 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Tú", "definition": "通 琇 (1614-1675). Thiền tăng đời Thanh, họ Dương, tự Ngọc Lâm, người đời gọi là “Ngọc Lâm Quốc Sư” người Giang Âm (Giang Tô) Trung Quốc. Năm 19 tuổi sư theo Khánh Sơn Viên Tu xuất gia, thụ giới cụ túc nối pháp làm truyền nhân tông Lâm Tế. Từng trụ trì chùa Báo Ân ở Vũ Khang (Chiết Giang), sau phụng chiếu của Thanh Thế Tổ vào kinh, ở nơi cung Vạn Thiện cử dương đại pháp. Chẳng bao lâu sư trở về núi, để lại đệ tử là Hạnh Sâm hoằng pháp nơi Bắc Kinh. Niên hiệu Thuận Trị thứ 17 (1660) vua tuyển lựa tăng thụ giới Bồ Tát, đặc biệt cho sư làm Bản sư còn gia phong “Đại Giác Phổ Tế Năng Nhân Quốc Sư”. Thông Tú khi thuyết pháp nơi cung đình có soạn một thiên “Khách Vấn”, Đại học sĩ Kim Chi Tuấn phụng sắc viết lời bình chú và phụ tự rồi cho ấn hành. Tuổi già, sư xây cất chùa Thiền Nguyên ở núi Thiên Mục, Chiết Giang và thường trụ ở đó. Tác phẩm: Ngọc Lâm Tú Quốc Sư Ngữ Lục 12 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Túy", "definition": "通 醉 (1610-1695). Thiền tăng đời Thanh, họ Lý, tự Trượng Tuyết, người Nội Giang (Tứ Xuyên) Trung Quốc. Sư lễ ngài Thanh Nhiên núi Cổ Tự xuất gia, đọc kinh Pháp Hoa đến chỗ “cho đến giơ một tay hoặc cúi đầu… đều có thể thành Phật đạo” thì biết rằng hy vọng sẽ đắc đạo, sư liền đến núi Nga My tu đạo. Sau nghe đạo phong của Mật Vân Viên Ngộ mà chuyển sang tu thiền, ẩn cư núi Cổ Tự đọc các Ngữ Lục, ở nơi Vạn Phong tham yết Phá Sơn Hải Minh. Niên hiệu Sùng Trinh thứ 9 (1636) mùa thu sư đến núi Thiên Đồng tham kiến Viên Ngộ và được đại ngộ, rồi trở về Vạn Phong được ấn khả nối pháp làm truyền nhân tông Lâm Tế. Niên hiệu Thuận Trị thứ 4 (1647) đi đến Tuân Nghĩa (Quý Châu) tị nạn. Năm thứ 6 (1649) đến Long Hưng Thiền Viện ở Giang Thượng, Lạc An (Giang Tây) tụ hội thiền sư khắp nơi thuyết pháp. Niên hiệu Khang Hy (1662-1722) đến chùa Chiêu Giác ở Thành Đô, sư ra sức phục hưng lại những điện thờ bị hư hỏng trở thành kiểu cũ. Tuổi già sư lui về ở Dật Lão Quan. Sư học rộng nhớ dai, giỏi làm thơ. Đệ tử nối pháp có Bản Tương, Linh Thiền, Triệt Liễu. Tác phẩm: Ngữ Lục 12 quyển. Thanh Tùng Tập 1 quyển, Lý Trung Hành 1 quyển, Cẩm Giang Thiền Đăng 20 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Tư", "definition": "通咨. Truyền đi khắp nơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Tải", "definition": "(通載, Tsūsai): xem Phật Tổ Lịch Đại Thông Tải (佛祖歷代通載, Bussorekidaitsūsai) còn gọi là Phật Tổ Thông Tải (佛祖通載, Bussotsūsai), Thông Tải (通載, Tsūsai), 22 quyển, do Mai Ốc Niệm Thường (梅屋念常) nhà Nguyên biên tập, san hành vào năm thứ 4 (1576) niên hiệu Vạn Lịch (萬曆). Niệm Thường ở Đại Trung Tường Tự (大中祥寺), Gia Hưng (嘉興, Tỉnh Triết Giang), theo niên kỷ các đời vua từ thời 7 vị Phật ở quá khứ cho đến năm đầu (1333) niên hiệu Nguyên Thống (元統) nhà Nguyên, ghi lại dưới hình thức biên niên các sự tích của Phật Giáo cũng như truyền ký của chư vị cao tăng để hình thành nên tác phẩm lớn này. Trải qua những điển tịch nội ngoại, có dẫn chứng uyên bác, bộ này đã làm sáng tỏ các điển cứ cố sự và đính chính những dị luận. Bản này có lời tựa của Vi Tiếu Am Đạo Nhân Ngu Tập (微笑庵道人虞集) ghi năm đầu (1341) niên hiệu Chí Chánh (至正) và lời tựa của Giác Ngạn (覺岸) vào năm thứ 4 (1344) cùng niên hiệu trên.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thông Tấn Xã", "definition": "通訊社. Cơ quan loan báo tin tức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Tục", "definition": "通俗. Thói quen của một vùng, một nước Bình dân, tầm thường, chung cho mọi người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Vi", "definition": "通 微 (1594-1657). Thiền tăng cuối đời Minh đầu đời Thanh, họ Trương, tự Vạn Như, người Gia Hưng (Chiết Giang) Trung Quốc. Năm 19 tuổi sư vào chùa Hưng Thiện xuất gia thụ giới cụ túc. Ban đầu yết kiến Văn Cốc, lần lượt tham kiến các bậc danh túc. Một hôm nhân xem kinh Lăng Nghiêm dường như có tỏ ngộ, sư liền đến chùa Kim Túc tham kiến Mật Vân Viên Ngộ song không khế ngộ. Một hôm vào thành, ở bên đường thấy người chủ mắng đứa ở bất giác toàn thân sư nhảy dựng lên mà được đại ngộ. Sau nối pháp Viên Ngộ làm truyền nhân tông Lâm Tế. Niên hiệu Sùng Trinh thứ 13 (1640) sư khai pháp nơi viện Chân Như, rồi sang Tào Sơn, đến núi Long Trì, giáo hóa hơn mười năm mà tịch. Tác phẩm: Vạn Như Vi Thiền Sư Ngữ Lục 10 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Vinh", "definition": "通 榮. Thiền tăng đời Nguyễn, thuộc tông Lâm Tế, đời thứ 44. Sư quê ở Nhân Kiệt, tỉnh Hải Dương, miền Bắc Việt Nam. Thuở nhỏ sư đến Hàm Long xin cầu xuất gia, thế độ. Lớn lên, sư đến Hòa Thượng Phúc Điền thụ giới cụ túc. Sư tu hành chín chắn, đạo đức vang xa. Đệ tử rất đông, mỗi vị ở mỗi phương hoằng hóa. Kệ thị tịch:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Viên", "definition": "通 圓. Hiệu của Thiền tăng Vạn Kim, sống vào cuối đời Nguyên đầu đời Minh. X. Vạn Kim.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Vân", "definition": "通 雲 (1594-1663). Thiền tăng đời Thanh, họ Từ, tự Thạch Kỳ, người Giang Tô Trung Quốc. Thuở nhỏ sư hay bệnh, đến chùa Nam Quảng xuất gia, học cả nội ngoại điển. Nhân xem bài kệ của Trung Phong Minh Bản viết trên vách chùa Báo Quốc ở Gia Định (Thượng Hải) mà cảm ngộ, sư liền đến chùa Hiển Thánh tham kiến Trạm Nhiên Viên Trừng. Lại tham kiến Mật Vân Viên Ngộ, luôn trình kiến giải nhưng đều bị Viên Ngộ quát. Một hôm, sư vào thất chưa kịp mở miệng, Viên Ngộ quơ gậy đánh, sư liền đại triệt đại ngộ, nối pháp làm truyền nhân tông Lâm Tế. Khi ra hoằng pháp sư trụ Linh Thứu Thiền Tự hoằng dương thiền pháp. Lần lượt trụ Tịnh Cư Thiền Tự núi Cảnh Tinh, Thiên Thai; chùa Tư Thánh núi Tuyết Đậu; Phổ Nhuận Thiền Viện, Hương Sơn Thiền Tự; Mật ấn Thiền Tự núi Đầu Đà. Đời Thanh, niên hiệu Thuận Trị thứ 17 (1660) sư trở về chùa Nam Quảng. Tác phẩm: Tuyết Đậu Thạch Kỳ Thiền Sư Ngữ Lục 15 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông Vấn", "definition": "通 問 (1604-1655). Thiền tăng cuối đời Minh đầu đời Thanh, họ Du, hiệu Nhược Am, người Ngô Giang (Giang Tô) Trung Quốc. Cha già của sư sợ không con nên đến chùa Thứu Phong thiết lập đại hội Vô già một trăm ngày, Thông Vấn ứng theo sự cầu khẩn mà sinh ra. Thuở nhỏ đã mất cha mẹ, năm 16 tuổi hăng hái đọc sách, xem qua hầu hết các sách. Một hôm nhân đi qua sơn tự xem kinh Lăng Nghiêm dường như có tỏ ngộ, sư bèn đến Khánh Sơn yết kiến Thiên ẩn Viên Tu song đã lâu mà không khế ngộ. Năm 24 tuổi vì bị ép lấy vợ nên sư đêm tối theo Pháp Vũ Phật Thạch chùa Lý An, ở Nam Giản cạo tóc xuất gia, lại theo hầu Mật Vân Viên Ngộ chùa Kim Túc, nhưng không khế ngộ, sư trở lại Khánh Sơn một hôm nghe gió mạnh thổi vào vách núi mà có chỗ tỉnh ngộ, được Viên Tu ấn khả, làm truyền nhân tông Lâm Tế. Về sau trụ chùa Lý An, rồi dời sang Giáp Sơn, qua lại vùng Giang Đông sư phục hưng các chùa hoang phế, an trí đạo lữ là nhiệm vụ chủ yếu. Tuổi già trụ Khánh Sơn. Tác phẩm: Nhược Am Vấn Thiền Sư Ngữ Lục 12 quyển, Tục Tăng Tồn Cảo 20 quyển, Khánh Thất Hậu Lục 1 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thông thường chỉ cho 1 cuộc hội họp có hình thức tông giáo.", "definition": "II.Nhất Hội.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thông thường từ ngữ này được đặt ở đầu mỗi bộ kinh, là để biểu thị niềm tin sâu xa rằng những điều ghi chép trong kinh này đều là giáo pháp do chính Đức Phật nói ra. (xt. Lục Thành Tựu).", "definition": "II.Như Thị.", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thông thường, in tượng Bản Tôn của chùa lên miếng giấy để tặng cho những người đến lễ bái, hoặc in trên lá sớ cầu đảo, hoặc in lên trang đầu và trang cuối của quyển kinh. Ngoài ra, trong các bản Kinh Phật Danh xưa, dưới mỗi danh hiệu Phật đều có in 1 hình Phật nhỏ. [X. Nam Hải Kí Qui Nội Pháp Truyện Q.4; Pháp Uyển Châu Lâm Q.39].", "definition": "III.Phật Ấn (1032-1098).", "source": "Phat Quang Tu Dien - HT Quang Do"}
{"term": "Thông Điệp", "definition": "通牒. Bức thư gửi cho khắp nước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thông Đạt Vị", "definition": "Địa vị Thông-đạt. Đây là địa vị thứ ba trên quá trình tu tập của Bồ-tát thừa – cũng gọi là địa vị Kiến-đạo. Hành Giả, sau khi đã trải qua một a-tăng-kì kiếp tu tập hoàn mãn địa vị Tư-lương (hay Ba-hiền), rồi địa vị Gia-hạnh (hay Bốn-gia-hạnh), thì trí vô lậu phát sinh, thể hội thể tánh chân như bình đẳng, thấy được lí trung đạo, vượt thoát địa vị phàm phu, bước lên bậc Sơ-địa Bồ-tát – nói chính xác hơn là giai đoạn “nhập tâm” (xem mục “Nhập Tâm - Trụ Tâm - Xuất Tâm”) của Sơ-địa Bồ-tát.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thông Đồng", "definition": "通同. Chung nhau cùng làm việc gì. Ca dao: “Ai cấm chú lái thông đồng đi buôn” Ta còn hiểu là xong xuôi không vấp trở ngại gì. Thành ngữ: “Thông đồng bén giọt”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thõa Mãn", "definition": "Nicchāta (tính từ), pīṇana (trung), pīṇeti (pin + e), ramati (ram + a), ramana (trung), santappeti (saṃ + tapp + e), santuṭṭhi (nữ), suhita (tính từ), tappeti (tapp + a), titti (nữ), tosa (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thù", "definition": "殊. Khác hẳn. Riêng ra. td: Đặc thù Dứt tuyệt Rất, lắm Quá mức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Du", "definition": "茱萸. Tên một loài cây, tương tự như cây hồ tiêu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Giá", "definition": "酬 價. Cho biết giá tiền. Tiết Tín Tương Tông Hiển Thiền Sư trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thù Hận", "definition": "讐恨. Căm giận không nguôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Kim", "definition": "酬金. Số tiền đền đáp lại. Tiền công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Lao", "definition": "酬勞. Đền đáp lại công khó nhọc. Trả công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Nghịch", "definition": "Paṭiyodha (nam), paṭivirodha (nam), savera (tính từ), vera (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thù Oán", "definition": "讐怨. Như Thù hận 讐恨.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Thắng", "definition": "Xem Tăng Thượng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thù Tiếp", "definition": "酬接. Mời mọc đón rước.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Tượng Tự", "definition": "殊 像 寺. ở phía tây nam phố Dương Lâm, thị trấn Đài Hoài, Ngũ Đài Sơn, tỉnh Sơn Tây, Trung Quốc, là một trong năm đại thiền tự của Ngũ Đài Sơn. Do trong chùa thờ tượng Văn Thù nên có tên “Thù Tượng Tự”. Được xây dựng vào đời Đường, khoảng niên hiệu Diên Hựu (1314-1320) đời Nguyên xây dựng lại, sau đó bị lửa thiêu hủy. Niên hiệu Thành Hóa thứ 23 (1487) đời Minh xây cất lại. Phía trước là Sơn môn, Thiên vương điện, hai bên là Lang vũ phối điện, phía sau là Thiền đường, Phương trượng thất. Chính giữa là Văn Thù các thờ Bồ tát Văn Thù cưỡi sư tử xanh, cao 9m, sau lưng khám là “Tam Thế Phật” (Thích Ca, Dược Sư, Di Đà), hai bên treo 500 La hán, toàn bộ tượng Phật đều được người đời Minh nặn đắp, công nghệ tinh xảo, hình tượng tú mỹ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thù Tạc", "definition": "酬酢. Chỉ rót rượu mời khách, và khách mời lại.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Xướng", "definition": "酬 唱. Dùng cơ ngữ đối đáp qua lại. Bích Nham Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thù Địch", "definition": "讐敵. Kẻ căm giận và chống lại mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thù Đồ", "definition": "Từ chữ thùpa (P) hay chữ stupa (S). Thường dịch là tháp, chỉ cho đất được đắp lên, hình tròn, để kỉ niệm những sự tích lớn của đức Phật, để thờ xá lợi của Phật hay xá lợi của vị A la hán. Sau này chữ tháp được dùng chung cho lăng các vị sư đã mệnh chung, có nhiều tầng hay tháp thờ tượng Phật như tháp Thiên Mụ ở Huế, tháp chùa Bút Tháp v.v…", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thùng", "definition": "Bhājana (trung), mañjūsā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thùng Cơm", "definition": "Thālipāka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thùng Phân", "definition": "Gūthakaṭāha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thùng Rác", "definition": "Avakkārapātī (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thùng Đựng Nước", "definition": "Karaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thùy", "definition": "篅. Cái bồ, cái sọt tre, dùng để đựng lúa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thùy Hóa", "definition": "垂 化. Giáo hóa; dạy bảo. Như Tịnh Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Long Phổ", "definition": "睡 龍 溥. Thiền tăng Đạo Phổ đời Ngũ Đại ở núi Thùy Long, Tuyền Châu, người đời gọi là Thùy Long Phổ. X. Đạo Phổ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Miên", "definition": "Xem Thụy Miên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thùy Mị", "definition": "Hirimantu (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thùy Ngữ", "definition": "睡 語. Nói mớ, nói xằng. Tiết Thiên Bình Khế Ngu Thiền Sư trong NĐHN q. 14 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Ngữ Bách Tắc", "definition": "睡 語 百 則. Còn gọi: Thất Trung Bách Vấn. Sách, 1 quyển, do Trường Linh Thủ Trác soạn vào đời Tống, được xếp vào Tục Tạng Kinh tập 120, trang 318. Sách này bao gồm các Kệ tụng, Niêm cổ, Tán, Chân tán,… do Trường Linh Thủ Trác đáp các câu hỏi của người học mà viết nên. Phần sau sách phụ Trường Linh Thủ Trác Thiền Sư Ngữ Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Thu", "definition": "(垂秋): đến gần mùa Thu, tức chỉ cho sự tàn lụi, băng hoại, suy tàn, thời mạt pháp. Phật pháp thùy Thu (佛法垂秋) nghĩa là đang thời kỳ mạt pháp. Như trong Nam Tống Nguyên Minh Thiền Lâm Tăng Bảo Truyện (南宋元明禪林僧寶傳, 卍 Tục Tạng Kinh Vol. 79, No. 1562) quyển 6 có câu: “Tượng Pháp thùy Thu, danh lợi căn thâm, như tượng một thâm nê, châu trầm cự hải (像法垂秋、名利根深、如象沒深泥、珠沉巨海, thời Tượng Pháp sắp tàn, gốc danh lợi sâu nặng, như voi lún bùn sâu, hạt châu chìm biển lớn).” Hay trong Hám Sơn Lão Nhân Mộng Du Tập (憨山老人夢遊集, 卍 Tục Tạng Kinh Vol. 73, No. 1456) quyển 13 có đoạn: “Thiết niệm đạo pháp thùy Thu, chánh tông đạm bạc, lại ngô sư thừa đại bi nguyện luân, cao thụ pháp tràng, tông thuyết kiêm sướng, Chỉ Quán song vận, Tỳ Ni độc yết, Tịnh Độ chuyên môn, sử cuồng tử tri quy (切念道法垂秋、正宗澹薄、賴吾師乘大悲願輪、高豎法幢、宗說兼暢、止觀雙運、毗尼獨揭、淨土專門、使狂子知歸, thiết nghĩ đạo pháp lu mờ, chánh tông phai nhạt, nhờ Thầy ta nương bánh xe nguyện đại bi, dương cao cờ pháp, tông môn và giáo thuyết cùng tuyên xướng, Chỉ và Quán đều vận hành, Luật nghi xem trọng, Tịnh Độ chuyên môn, khiến cho người con điên biết quay về).” Hay như trong Sa Di Luật Nghi Tỳ Ni Nhật Dụng Hợp Tham (沙彌律儀毗尼日用合參, 卍 Tục Tạng Kinh Vol. 60, No. 1120) có câu: “Cao tăng dĩ Phật pháp vi kỷ nhiệm, cố văn ngọ hậu cử thoán, tri pháp vận thùy Thu, cố thế khấp nhi bi thán dã. Kim nhân thể nhược đa bệnh, dục số số thực giả, hoặc bất năng trì thử giới; cố cổ nhân xưng vãn thực vi dược thạch, thủ liệu bệnh chi ý dã (高僧以佛法爲己任、故聞午後舉爨、知法運垂秋、故涕泣而悲嘆也、今人體弱多病、欲數數食者、或不能持此戒、故古人稱晚食爲藥石、取療病之意也, vị cao tăng lấy pháp Phật làm trách nhiệm của mình, nên sau buổi trưa nghe nấu ăn, mới biết vận thế Phật pháp suy tàn, vì vậy rơi lệ mà buồn than vậy. Người đời nay thân thể suy yếu nhiều bệnh, muốn ăn nhiều lần, nên không thể giữ giới này được, vì vậy người xưa gọi buổi ăn chiều là Dược Thạch, với ý để trị bệnh vậy).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thùy Thị", "definition": "垂 示. Thiền Sư thuyết pháp cho chư tăng trong thiền hội của mình nghe. Lâm Tế Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Thủ", "definition": "垂 手. Duỗi tay. Ý nói thiền sư khải phát (khơi gợi), tiếp dẫn người học. Bài tụng “Thốt trác đồng thời” trong PDNL q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Thủ Nhập Triền", "definition": "垂 手 入 廛. Còn gọi: Thùy thủ sưu khiên. Vào chợ duỗi tay. Sau khi triệt ngộ, thiền sư không theo gương người xưa làm mẫu mực cho đời mà đi vào trong chợ búa, làm con người rất tầm thường để gần gũi, dẫn dắt người khác đến với đạo. Thập mục ngưu đồ (Vạn Tục 113) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thùy Tích", "definition": "Chữ “thùy” là rủ xuống. Trong thiền môn thường dùng chữ này để tỏ ý tôn kính đối với bậc tôn trưởng, như từ “thùy niệm” nghĩa là bậc tôn trưởng rủ lòng tưởng nghĩ đến kẻ hậu học. Chữ “tích” là dấu vết. “Thùy Tích” là một thuật ngữ Phật học, dùng để chỉ cho cái thân mà chư Phật và Bồ-tát thị hiện ra trong thế gian để hóa độ chúng sinh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thùy tri phàm thánh dữ Tây Ðông?", "definition": "Uổng công thôi hỏi sắc cùng không", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thùy Đường", "definition": "垂 堂. Dưới mái hiên của căn nhà lớn. Tiết Thị Linh Tri Hòa Am Chủ trong NĐHN q. 18 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thú", "definition": "戍. Đóng binh ở biên giới Người lính đóng ở biên giới, ta cũng gọi là Lính thú.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Bác Ca", "definition": "Svaka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thú Chủ Ngoại Đạo", "definition": "Parūpata (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thú Dã Thám U", "definition": "(狩野探幽, Kanō Tanyū, 1661-1674): nhà danh họa sống đầu thời Giang Hộ, con trai đầu của Thú Dã Hiếu Tín (狩野孝信), cháu của Vĩnh Đức (永德); tên húy là Thủ Tín (守信), sau lấy pháp hiệu là Thám U Trai (探幽齋). Ông có tài năng vẽ tranh rộng lớn, là nhà hội họa nổi tiếng của chính quyền Mạc Phủ, và đã làm cho môn phong phồn vinh nhờ tài năng của ông. Ông đã để lại khá nhiều bức tranh vẽ trên tường ở một số nơi như Thành Nhị Điều (二條城, Nijō-jō), Thành Danh Cổ Ốc (名古屋城, Nagoya-jō), phương trượng của Đại Đức Tự (大德寺, Daitoku-ji), Nam Thiền Tự (南禪寺, Nanzen-ji), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thú Nhận", "definition": "首認. Nhìn tội lỗi là của mình.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Phục", "definition": "首服. Nhận tội và xin chịu nghe theo. Đoạn trường tân thanh: “Hết lời thú phục khẩn cầu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Thê", "definition": "娶妻. Lấy vợ. Cưới vợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Thực", "definition": "首實. Khai hết sự thật mà nhận tội. Truyện Trê Cóc: “Gian ngay thú thực thưa qua cho tường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Tội", "definition": "首罪. Nhận điều lỗi lớn mình đã làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Vật", "definition": "獸物. Chỉ chung loài động vật bốn chân Tiếng dùng để chửi mắng người xấu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Vị", "definition": "趣味. Niềm vui thích khi được hưởng điều gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thú Y", "definition": "獸醫. Việc chữa bệnh cho loài vật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúc", "definition": "倏. Dáng chó chạy mau Mau lẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúc Bá", "definition": "叔伯. Chú và bác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúc Giục", "definition": "Niyojana (trung), tiyojeti (ni + yuj + e), samuttejaka (tính từ), vitudati (vi + tud + a), vitudana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thúc Hối", "definition": "Ākoṭana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thúc Hốt", "definition": "(倐忽): trong chớp nhoáng, trong thoáng chốt, chỉ thời gian biến chuyển nhanh đến nỗi không thể lường được. Như trong Quy Sơn Đại Viên Thiền Sư Cảnh Sách (潙山大圓禪師警策) của Quy Sơn Linh Hựu (潙山靈祐, 771-853) có đoạn: “Thí như xuân sương, hiểu lộ, thúc hốt tức vô, ngạn thọ, tỉnh đằng, khởi năng trường cửu (譬如春霜曉露、倐忽卽無、岸樹、井藤、豈能長久, ví như sương mùa xuân, móc buổi sáng, cây bên bờ, dây leo ở giếng, làm sao bền lâu ?).” Hay như trong Khổng Triều Bá Ca (孔廟柏歌) của Hồ Kỳ Nghị (胡其毅, ?-?) nhà Minh có câu: “Lễ nhạc sơ truyền tam bách tải, phong trần thúc hốt câu thiên cải (禮樂初傳三百載、風塵倐忽俱遷改, lễ nhạc mới truyền ba trăm năm, gió bụi thoáng chốt đều biến đổi).” Câu “lão niên thúc hốt (老年倐忽)” có nghĩa là trong thoáng chốc tuổi già lại đến", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thúc Lô Nhị Nghĩa", "definition": "束蘆 二義 (Tông Cảnh Lục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thúc Ngao Đập Rắn", "definition": "(Truyền thuyết Trung-quốc). Thúc Ngao tên là Vỉ Ngao, tự Tôn Thúc, nên người ta vẫn gọi là Tôn-thúc Ngao. Vỉ Ngao là con Vỉ Giả, làm quan tư mã dưới triều vua Trang vương, nước Sở, thời Xuân Thu (770-476 tr. TL). Khi Sở Trang vương đem quân đi đánh đất Lục-hồn, ở trong triều, quan lịnh doãn (như chức tể tướng, đứng đầu các quan trong triều đình) là Đấu Việt Tiêu làm phản, muốn cướp ngôi; bèn nổi loạn, giết quan tư mã là Vỉ Giả, rồi đem quân ra ngoài đánh nhau với Sở Trang vương. Vỉ Giả bị giết, con là Tôn-thúc Ngao (tức Vỉ Ngao) lập tức đem mẹ chạy lánh nạn, sang đất Mộng-trạch làm ruộng sống qua ngày. Một hôm, Tôn-thúc Ngao vác cày ra ruộng, thấy ở dưới ruộng có một con rắn hai đầu, giật mình kinh sợ, than rằng: “Ta nghe nói, rắn hai đầu rất độc hại, ai trông thấy tất phải chết. Vậy ta khó mà sống được!” Ông lại nghĩ thầm: Nếu để con rắn này sống, sau này lỡ có ai trông thấy, chắc chắn sẽ nguy hiểm cho người ta. Chi bằng ta hãy gánh chịu một mình mà thôi. Nghĩ vậy, ông bèn đập chết con rắn, đem chôn ở bờ ruộng. Ông về nhà khóc với mẹ, lo rằng, mình không còn sống để nuôi mẹ được. Bà mẹ nghe câu chuyện ông thuật lại thì mừng lắm, bảo rằng: “Người ta làm được điều thiện, trời đất tất phù hộ cho. Nay con sợ con rắn hai đầu di hại cho người sau mà giết chôn đi, thì đó là điều thiện rất lớn. Con sẽ không chết mà còn được phước nữa!” Bấy giờ Sở Trang vương đã giết được Đấu Việt Tiêu và bè đảng phản loạn, đang tìm người tài đức để thay vào chức lịnh doãn. Có người nhớ tới Tôn-thúc Ngao, bèn tiến cử với vua Trang vương. Nhà vua suy nghĩ, Vỉ Giả đã là bậc tài trí, thì người con chắc chắn cũng không kém gì; bèn cho sứ giả đến Mộng-trạch triệu Tôn-thúc Ngao vào triều. Bà mẹ cười bảo: “Đó là vì con giết rắn mà được phước!”. Tôn-thúc Ngao lại đem theo mẹ cùng trở về kinh thành nước Sở. Vua Trang vương nói chuyện với Tôn-thúc Ngao suốt một ngày, rất lấy làm hài lòng, liền cho làm chức lịnh doãn.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thúc Phọc", "definition": "束縛. Trói cột. Ràng buộc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúc Phụ", "definition": "叔父. Chú. Người chú. Đoạn trường tân thanh: “Đem tin thúc phụ từ đường”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúc Thủ", "definition": "束手. Bó tay mà chịu, không làm gì được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúng", "definition": "Pacchi (nữ), piṭaka (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thúy", "definition": "脆. Như chữ Thuý 脃.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúy Kiều", "definition": "翠翹. Tên nhân vật chính trong Đoạn trường tân thanh của Nguyễn Du: “Thuý Kiều là chị, em là Thuý Vân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúy Nham", "definition": "Ts'ui-yen (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thúy Nham Hân", "definition": "翠 巖 欣. Thiền tăng Tùng Hân đời Ngũ Đại ở Thúy Nham, Xử Châu (nay là Lệ Thủy, Chiết Giang), Trung Quốc, được người đời gọi là Thúy Nham Hân. X. Tùng Hân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thúy Nham Khả Châu", "definition": "Tsui yen Ke Chen (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thúy Nham Linh Nham", "definition": "Ts'ui-yen Ling-ts'an (C), Suigan Reisan (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thúy Nham Linh Tham", "definition": "(翠巖令參, Suigan Reisan, ?-?): xuất thân vùng Hồ Châu (湖州, Tỉnh Triết Giang), pháp từ của Tuyết Phong Nghĩa Tồn (雪 峰 義 存). Ông sống tại Thúy Nham Sơn (翠巖山), Minh Châu (明州, Tỉnh Triết Giang) và cử xướng Thiền phong của mình rất mạnh mẽ. Ông được ban cho Tử Y và hiệu là Vĩnh Minh Đại Sư (永明大師).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thúy Phong", "definition": "翠 峰. Hiệu của Thiền tăng Đức Sơn, đời Minh. X. Thúy Phong.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thúy Thái", "definition": "萃蔡. Tiếng quần áo loạt xoạt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thúy Vi Tự", "definition": "翠 微 寺. Chùa ở núi Chung Nam tỉnh Thiểm Tây, Trung Quốc, vốn là cung Thái Hòa do Đường Cao Tổ xây dựng vào niên hiệu Vũ Đức thứ 8 (625), sau đó bỏ hoang phế. Niên hiệu Trinh Quán thứ 21 (647) Đường Thái Tông ra lệnh phục hưng, gọi là cung Thúy Vi. Khoảng niên hiệu Nguyên Hòa (806-820), cung được đổi thành chùa, gọi là chùa Thúy Vi. Thiền Sư Vô Học, đệ tử của ngài Đan Hà Thiên Nhiên từng trụ trì nơi đây. Niên hiệu Thái Bình Hưng Quốc thứ 3 (978), chùa được đổi tên là “Vĩnh Khánh Tự”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thúy Vi Vô Học", "definition": "Tsui wei Wu hsiao (C), Suibi Mugaku (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thăm Dò", "definition": "Sammanteti (saṃ + mant + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thăng", "definition": "勝. Có thể được. Td: Bất thăng sổ (không thể đếm xuể) Xem Thắng Hết. Trọn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Bình", "definition": "昇平. Yên ổn trên toàn đất nước. Thơ Nguyễn Khuyến: “Kìa hội thăng bình tiếng pháo reo”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Bằng", "definition": "升平. Ngang vững, không lệch về bên nào.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Giáng", "definition": "升降. Lên và xuống. Chỉ sự thay đổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Hà", "definition": "升遐. Lên cao và đi xa, chỉ vua chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Kinh", "definition": "升京. Lên kinh đô, nơi vua đặt triều đình. Truyện Hoa Tiên: “Dương gia chuyển thụ thăng kinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Long", "definition": "昇龍. Tên cũ của thủ đô Hà nội ở các đời Lí, Trần, Lê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Quan", "definition": "升官. Lên bậc quan cao hơn, làm quan to hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Thiên", "definition": "升天. Lên trời. Bay lên trời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Tiến", "definition": "升進. Lên cao và tới trước, ý nói tốt đẹp hơn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Trầm", "definition": "升沈. Lên cao và chìm xuống. Chỉ sự thay đổi ở đời. Hát nói của Cao Bá Quát: “Thế sự thăng trầm quân mạc vấn” (việc đời thay đổi, anh đừng hỏi làm gì).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Trật", "definition": "升秩. Lên bực trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thăng Tòa", "definition": "陞 座. Còn gọi: Thăng Đường, Thượng Đường. Thiền Sư vào pháp đường, lên ngồi pháp tòa thuyết pháp cho đại chúng nghe. Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thăng Âm Thành", "definition": "Roruka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thăng Đường", "definition": "升堂. Lên ngồi trong dinh, nói quan bắt đầu làm việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thũng", "definition": "尰. Chân sưng to lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thūpārahapuggala", "definition": "Bốn hạng người đáng lập tháp thờ.", "source": "Kho Tang Phap Hoc - Pali - Viet - TK Giac Gioi"}
{"term": "Thơ Ca Ngợi Sông Hằng", "definition": "Gaṅgāmāhātmya (S), Poems in praise of the Ganges.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thơ Tự", "definition": "Cũng gọi là “thơ tự Phạn học tăng”, là một trong chín vị pháp sư thuộc hội đồng phiên dịch ở Trung-quốc thời xưa (xem mục “Dịch Kinh”), có nhiệm vụ nghe đọc Phạn văn, rồi theo âm tiếng Phạn mà viết thật đúng y ra chữ Hán.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thơm", "definition": "Surabhi (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thơm Ngon", "definition": "Ojavantu (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thư", "definition": "怚. Lòng dạ không được tinh tường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Cưu", "definition": "雎鳩. Tên một loài chim nhỏ, sống từng cặp. Chỉ tình vợ chồng khăng khít.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Cục", "definition": "書局. Nhà bán sách, in sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Cừ Kinh Thanh", "definition": "Chu-sha-ching-sheng (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thư Dung", "definition": "書傭. Người viết thuê.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Hiên", "definition": "書軒. Chỗ hàng ba dùng làm nơi đọc sách. Phòng học. Phòng đọc sách. Đoạn trường tân thanh: “Sánh vai về chốn thư hiên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Hàm", "definition": "書函. Bao thơ. Phong bì thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Hùng", "definition": "雌雄. Trống và mái. Chỉ sự thua được, mất còn dứt khoát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Hương", "definition": "書香. Mùi thơm của sách vở. Chỉ tiếng tăm về học vấn. Chỉ gia đình nổi tiếng về học vấn. Đoạn trường tân thanh: “Nghĩ rằng cũng mạch thư hương”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Khố", "definition": "書庫. Kho chứa sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Kiếm", "definition": "書劍. Sách và gươm, hai vật của kẻ nam nhi văn võ song toàn. Tài tử đa cùng phú của Cao Bá Quát: “Để ta đeo vòng thư kiếm, quyết xoay bạch ốc lại lâu đài”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Kí", "definition": "書記. Người giữ việc viết lách ghi chép.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Ký", "definition": "Lekhaka (nam), lekhikā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thư Lại", "definition": "書吏. Viên chức cấp dưới lo việc giấy tờ tại công sở.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Phong", "definition": "書封. Gói thư. Lá thư. Bản dịch Chinh phụ ngâm khúc: “Thấy nhàn luống tưởng thư phong”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Pháp", "definition": "書法. Phép viết chữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Phòng", "definition": "書房. Buồng học. Buồng đọc sách. Đoạn trường tân thanh: “Có khi vắng vẻ thư phòng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Phục", "definition": "舒服. Khoẻ khoắn vui vẻ trong người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Quyển", "definition": "書卷. Cuốn sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Quán", "definition": "書舘. Nhà in sách. Tiệm bán sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Sinh", "definition": "書生. Người đi học. Kẻ học trò. Tài tử đa cùng phú của Cao Bá Quát: “… Đừng thấy người bạch diện thư sinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Song", "definition": "書窻. Cửa sổ của buồng học, của phòng đọc sách. Chỉ buồng học, phòng đọc sách. Đoạn trường tân thanh: “Chàng Kim từ lại thư song”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Sướng", "definition": "舒暢. Khoan khoái thảnh thơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Thái", "definition": "Xem Khinh an.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thư Trai", "definition": "書齋. Buồng học. Phòng đọc sách. Đoạn trường tân thanh: “Thong dong nối gót thư trai cùng về”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Tín", "definition": "書信. Thư từ trao đổi tin tức.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Tịch", "definition": "書籍. Chỉ chung sách vở tài liệu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Viện", "definition": "書院. Nhà chứa sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Xã", "definition": "書社. Tiệm sách Tổ chức quy tụ những người đọc sách và viết sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Điếm", "definition": "書店. Tiệm bán sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Đạo", "definition": "Shodō (C), Way of writing.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thư Đố", "definition": "書蠧. Con mọt sách, chỉ người đọc sách nhiều mà không nắm được ý nghĩa để ứng dụng ngoài đời.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thư Đồng", "definition": "書童. Đứa trẻ hầu hạ quét dọn phòng đọc sách.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưa Kiện", "definition": "Abhiyuñjati (abhi + yuj + ñ + a), abhiyuñjana (trung), codanā (nữ), mārisa (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thương", "definition": "倉. Kho lúa Cái kho chứa Lòng thuyền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Buôn", "definition": "Vānija (nam), vānijaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thương Chính", "definition": "商政. Cơ quan nhà nước coi về việc buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Côn Châu Ngọc Tập", "definition": "滄崑珠玉集. Tên một tập thơ do Nguyễn Giản Thanh, danh sĩ đời Lê sưu tập, gồm nhiều bài thơ chữ Hán của các thi gia Việt Nam và Trung Hoa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Cảm", "definition": "傷感. Thấy đau xót trong lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Cảng", "definition": "商港. Bến sông lớn để tàu bè ra vào buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Cục", "definition": "商局. Hãng buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Gia", "definition": "商家. Người làm nghề buôn bán. Đoạn trường tân thanh: “Là nhà Ngô Việt thương gia”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Hàn", "definition": "傷寒. Bệnh sốt do thân thể bị tổn hại vì khí lạnh ở bên ngoài.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Hại", "definition": "Kṛpā (S), Pity.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thương Hải", "definition": "蒼海. Biển xanh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Lượng", "definition": "商量. Tính toán dàn xếp công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Mạc Ca", "definition": "Xem Thiểm.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thương Mại", "definition": "商賣. Buôn vào và bán ra. Chỉ việc buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Mến", "definition": "Piya (tính từ), māmaka (tính từ), sādara (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thương Na", "definition": "Sana (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thương Na Hoà Tu", "definition": "Śāṇavāsa (S), Śanaka-vāsa (S), Śānavāsin (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thương Nghiệp", "definition": "商業. Nghề buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Nghị", "definition": "商議. Bàn bạc để quyết định công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Ngắn", "definition": "Kaṇaya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thương Thuyết", "definition": "商說. Nói chuyện để dàn xếp công việc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Thuyền", "definition": "商船. Tàu chở hàng hoá. Tàu buôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Triều", "definition": "Shang Dynasty (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thương Tâm", "definition": "傷心. Đau xót trong lòng. Đoạn trường tân thanh: “Lòng đâu sẵn mối thương tâm”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Tích", "definition": "傷迹. Dấu vết của sự tổn hại trên thân thể.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Tọa Đinh", "definition": "(定 上 座, Jō Jōza, ?-?): nhân vât sống cuối thơi nhà Đương, vị tăng cua Tông Lâm Tế Trung Quốc. Cuối phân Canh Đức Truyền Đăng Luc (景 德傳 燈 錄), theo ký luc cua Lâm Tế Luc (臨濟錄) cho thây, ông thuôc pháp tư cua Lâm Tế. Con trong Bích Nham Luc (碧巖錄) thì sau khi đăc pháp, ông có vân đáp với ba nhân vât Nham Đâu Toàn Khoát (巖 頭 全 奯), Tuyết Phong Nghia Tôn (雪 峰 義 存) và Khâm Sơn Văn Thuy (欽山文邃).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thương Tổn", "definition": "傷損. Làm hại tới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Vong", "definition": "傷亡. Chết vì bị thương.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Xót", "definition": "Anukampati (anu + kamp + a), anukampana (trung), anukampā (nữ), anukampaka (tính từ), anukampī (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thương Yêu", "definition": "Rati (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thương Yết La Chủ Bồ Tát", "definition": "Śaṅkarasvāmin (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thương Điếm", "definition": "商店. Tiệm buôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thương Ước", "definition": "商約. Việc giao hẹn giữa hai hoặc nhiều quốc gia về việc buôn bán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Tọa Định", "definition": "(定上座, Jō Jōza, ?-?): nhân vật sống cuối thời nhà Đường, vị tăng của Lâm Tế Tông Trung Quốc. Cuối phần Cảnh Đức Truyền Đăng Lục (景德傳燈錄), theo ký lục của Lâm Tế Lục (臨濟錄) cho thấy, ông thuộc pháp từ của Lâm Tế. Còn trong Bích Nham Lục (碧巖錄) thì sau khi đắc pháp, ông có vấn đáp với ba nhân vật Nham Đầu Toàn Khoát (巖頭全奯), Tuyết Phong Nghĩa Tồn (雪峰義存) và Khâm Sơn Văn Thúy (欽山文邃).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thước", "definition": "爍. Nấu cho chảy ra. Sáng loáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thước Ca La", "definition": "Xem Thiết Vi.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thước Phong Lâm", "definition": "Xem Trúc Lâm Tịnh Xá.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thước Sào Hòa Thượng", "definition": "鵲 巢 和 尚. Đời Đường, thiền tăng Đạo Lâm của tông Ngưu Đầu ở trên cây tùng cao của núi Tần Vọng, kế chỗ sư ở có tổ chim thước (khách), nên sư được gọi là Thước Sào Hòa Thượng. X. Đạo Lâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thước Viên", "definition": "Veṇuvana-karandaka-nivapa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thướng", "definition": "上. Lên. Bước lên. Tiến lên. Lên cao Một âm là Thượng. Xem Thượng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường", "definition": "償. Trả lại Đền bù lại. Td: Bồi thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường - Lạc - Ngã - Tịnh", "definition": "Hành Giả khi đã thành công trong bốn pháp quán niệm này thì sẽ đạt được bốn đức của niết bàn (cũng tức là bốn đức của pháp thân Phật):", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thường Bi Bồ Tát", "definition": "Xem Thường Đề Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Bất Khinh Bồ Tát", "definition": "Sadaparibhūta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Bất Tư Nghì", "definition": "Nityam-acintyam (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Chiếu", "definition": "常 照. 1. Thiền tăng đời Lý (?-1203), thuộc dòng Vô Ngôn Thông, đời thứ 12, nối pháp Thiền Sư Quảng Nghiêm. Sư họ Phạm, quê làng Phù Ninh (thuộc huyện Từ Sơn, tỉnh Hà Bắc ngày nay). Triều Lý Cao Tông, sư làm quan Lệnh đô tào ở cung Quảng Từ. Sau sư từ quan theo pháp xuất thế với Thiền Sư Quảng Nghiêm ở chùa Tịnh Quả và được tâm ấn nơi ngài. Sau đó, sư tìm đến phường Ông Mạc, trụ trì một ngôi chùa cổ, mở mang giáo hóa môn đồ. Cuối cùng, sư dời về chùa Lục Tổ ở làng Dịch Bảng, phủ Thiên Đức. Tăng chúng tìm đến tu học càng ngày càng đông. Kệ thị tịch:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Châu Thiên Ninh Tự", "definition": "常 州 天 寧 寺. ở trong thành phố Thường Châu, tỉnh Giang Tô, Trung Quốc. Xây vào khoảng niên hiệu Thiên Phục (901-904) đời Đường, ban đầu tên “Quảng Phúc Tự”, sau đổi tên là “Sùng Ninh Tự”. Niên hiệu Chính Hòa thứ 1 (1111) đời Tống đổi tên “Thiên Ninh Tự”. Đời Thanh có Thiền Sư Đại Hiểu trụ chùa này, pháp duyên đại thịnh, người theo học có hơn vạn, tập hợp tham thiền, hòa nhã nghiêm túc, đứng hàng đầu vào thời ấy. Từ đây về sau chùa này truyền ngọn đèn pháp tông Lâm Tế, cùng với chùa Kim Sơn, chùa Cao Mân được gọi là ba đại thiền lâm ở Giang Tô. Nguyên có 8 ngôi điện, 25 ngôi đường lâu, quần thể kiến trúc lớn nhỏ có 500 cột nhà, chiếm diện tích hơn 130 ha. Hiện còn điện vũ chủ yếu có Đại hùng bảo điện, Kim Cang điện, Phổ Hiền điện, Văn Thù điện, Quán Âm điện, La hán điện đều là kiến trúc đời Thanh. Trong Đại hùng bảo điện có chiếc cột gỗ to cao khoảng 30m. Trong La hán điện có 500 tượng La hán khắc bằng đá, hình thái rất giống, sinh động như sống. Chùa này kiến trúc hùng vĩ, điện vũ nguy nga, Phật tượng đầy đủ, pháp hội cực thịnh. Vốn có tên gọi “Đông Nam Đệ Nhất Tùng Lâm”. Tự Chí viết rằng: “Sự hưng thịnh của pháp hội nổi tiếng khắp nơi, trang nghiêm tuyệt diệu đứng hàng bậc nhất vùng Đông Nam”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Còn", "definition": "Niccaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thường Diệt", "definition": "Ever-Extinguished", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thường Dùng", "definition": "Vutti (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thường Giác", "definition": "常 覺 (896-971). Thiền tăng đời Ngũ Đại, họ Lý, người xứ Trần Lưu (nay là huyện Khai Phong, tỉnh Hà Nam) Trung Quốc. Ban đầu sư đến yết kiến Thiền Sư Hoằng Chương, tông Tào Động ở chùa Quy Tông tại Lô Sơn, nghe pháp sư có tỉnh ngộ liền xin xuất gia. Niên hiệu Càn Hóa thứ hai (912) sư được cạo tóc, và năm kế thụ giới ở chùa Đông Lâm. Sư ở ngoài cửa Lệ Cảnh thành Lạc Dương 2 năm, lệnh quân là Trương Sinh dành riêng một căn nhà cho sư yên tu, đến niên hiệu Thiên Thành thứ 3 (928) nơi đây trở thành Viện lớn, được ban bảng hiệu “Phổ Tịnh”. Do thời cuộc hổn loạn, sư chẳng chú trọng đến việc khai pháp. Triều đình nhiều lần ban hiệu cho, nhưng sư đều chẳng nhận.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Giản", "definition": "常 簡 (1015-1070). Thiền tăng đời Tống, họ Từ, tự Thuần Đức, người Vĩnh Gia (Ôn Châu, Chiết Giang) Trung Quốc. Sư nối pháp thiền sư Thiên Thai Long Nhất, thuộc tông Pháp Nhãn đời thứ 5, trụ trì thiền viện Diên Thọ, núi Bạch Vân, Thiều Châu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Hiểu", "definition": "(常曉, Jōgyō, ?-866): vị tăng của Chơn Ngôn Tông Nhật Bản, sống vào đầu thời Bình An, húy là Thường Hiểu, thông xưng là Tiểu Lật Thê Luật Sư (小栗栖律師), Nhập Đường Căn Bản Đại Sư (入唐根本大師). Ban đầu ông theo Phong An (豐安) ở Nguyên Hưng Tự (元興寺, Gankō-ji) học về Tam Luận, đến năm 815 thì thọ giới, rồi sau đó thọ phép Quán Đảnh với Không Hải (空海, Kūkai). Vào năm 829, ông làm Đạo Sư cho Ngự Trai Hội, rồi năm 838 thì sang nhà Đường cầu pháp với tư cách là Lưu Học Tăng học về Tam Luận, rồi được Linh Tiên (靈仙), vị tăng sang nhà Đường trước ông, phó chúc lại các di phẩm tại Hoài Nam (淮南). Sau ông thọ phép Quán Đảnh với Văn Tế ở Thê Linh Tự (栖靈寺), Dương Châu (揚州), theo học Tam Luận với Nguyên Chiếu (元照) ở Hoa Lâm Tự (華林寺), và đến năm 839 thì trở về nước. Năm sau, ông cho an trí tượng Thái Nguyên Soái Minh Vương (太元帥明王) tại Pháp Lâm Tự (法琳寺), vùng Vũ Trị (宇治, Uji), rồi được sắc chỉ cho phép lập Tu Pháp Viện (修法院) để trấn hộ quốc gia, và cùng năm đó thì tiến hành pháp tu Thái Nguyên Soái tại Thường Ninh Điện (常寧殿) trong cung nội. Trước tác của ông để lại có Tôn Thắng Phật Đảnh Thứ Đệ (尊勝佛頂次第), Nhập Đường Căn Bổn Đại Sư Ký (入唐根本大師記), Tấn Quan Thỉnh Lai Lục (進官請來錄), A Tra Bà Câu Thứ Đệ (阿吒婆倶次第) 1 quyển", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thường Hành Giả", "definition": "Xem Trí Tràng Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Hành Tam Muội", "definition": "Là pháp tam muội được y cứ vào Kinh Bát Chu Tam Muội mà tu tập, cho nên cũng gọi là Bát chu tam muội, là một trong 4 loại tam muội do tông Thiên Thai chế lập (Thường Tọa Tam Muội, Thường Hành Tam Muội, Bán Hành Bán Tọa Tam Muội, và Phi hành phi tọa tam muội). Hành trì pháp tam muội này, hành giả lấy 90 ngày làm một hạn kì, ở trong đạo tràng, chuyên đi nhiễu Phật liên tục, không gián đoạn. Trong khi thân đi nhiễu thì miệng xưng niệm danh hiệu Phật A Di Đà, tâm cũng nghĩ nhớ tới Phật A Di Đà; từng bước, từng tiếng, chỉ có đức Phật A Di Đà mà thôi. Cứ tinh cần hành trì như thế, không giải đãi, thì có thể nương vào uy lực của Phật, vào sức tam muội, và sức công đức của chính hành giả, mà ở trong định được thấy chư Phật mười phương hiển hiện trước mặt.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thường Hưng", "definition": "常 興. Thiền tăng đời Đường, tham vấn Mã Tổ Đạo Nhất đắc pháp. Sư trụ Lặc Đàm, Hồng Châu (nay là huyện Nam Xương, tỉnh Giang Tây). Một hôm, có vị tăng hỏi: Thế nào là khách dưới cửa Tào Khê? Sư đáp: Chim én từ phương nam đến. Tăng nói: Học nhân chẳng hiểu. Sư bảo: Nuôi lông cánh chờ gió Thu.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Không Tánh", "definition": "(Pháp) , Constantly fixed nature, have no", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thường Kinh", "definition": "常經. Cách đối xử luôn phải theo. Truyện Hoa Tiên: “Tưởng rằng trong đạo thường kinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Kiến", "definition": "Śāśvatadṛṣṭi (S), Sassata-diṭṭhi (P), Nityadṛṣṭi (S), Sasvatadṛṣṭi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Lưu", "definition": "常 流. Hạng bình thường, người bình thường. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Lạc Ngã Tịnh", "definition": "Bốn đức của Chân tâm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thường Lập Thắng Phan", "definition": "Anavanamita-vaidjayanta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Lệ", "definition": "常例. Lề lối vẫn theo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Nghiệp", "definition": "Āciṇṇa-kamma (P), Bahula kamma (P), Habitual karma.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Nhuận", "definition": "常 潤 (1510-1585).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Nhân", "definition": "常人. Người giống như những người khác, không có gì đặc biệt, tức người thường. Truyện Hoa Tiên: “Thấy chàng ẩn trạng khác với thường nhân”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Nhật", "definition": "常日. Hàng ngày. Ngày thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Phục", "definition": "常服. Quần áo mặc hàng ngày.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Quang Bản Viên", "definition": "常 光 本 圓. Phật tính xưa nay đầy đủ trọn vẹn mà mọi người đều có. Thường quang: ở đây chỉ cho Phật tính, linh trí. Tiết Nghệ ngôn trong NHQL q. 29 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Quang Hiện Tiền", "definition": "常 光 現 前. Ánh sáng của Phật tính hiển lộ ở trước mắt, ý nói nhận thức rõ tự tính. Thường quang: Dụ chỉ tự tính, Phật tính. Kiến (見) tức là hiện (現). Minh Giác Ngữ Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Quán", "definition": "常 觀. Thiền tăng đời Đường, thờ Thiền Sư Bách Trượng Hoài Hải làm thầy, theo học và đắc pháp nơi Ngài. Về sau khi ra hoằng pháp sư ở núi Ngũ Phong, Thụy Châu (nay là huyện Cao An, tỉnh Giang Tây).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Sát", "definition": "常 察 (?-961). Thiền tăng đời Ngũ Đại. Sư thờ Thiền Sư Cửu Phong Đạo Kiền và đắc pháp nơi ngài. Sư ở viện Đồng An, Phụng Thê tại Hồng Châu (nay là huyện Nam Xương tỉnh Giang Tây).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Thông", "definition": "常 通. X. Hằng Thông", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Thường", "definition": "常常. Luôn luôn Trung bình, không có gì trội hơn. Đoạn trường tân thanh: “Gia tư nghĩ cũng thường thường bậc trung”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Thức", "definition": "常識. Sự hiểu biết chung, lúc nào cũng cần có.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Tinh Tấn", "definition": "Constant Exertion", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thường Tinh Tấn Bồ Tát", "definition": "Nityodhyukta (S), Nityodhyukta-bodhisattva (S), Viriyarabdhika (S), Satasamitabhiyukta (S), Joshojin (J), Joshojin-Bosatsu (J), Bosatsu (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Trung", "definition": "常 忠 (1514-1588). Thiền tăng đời Minh, họ Thường hiệu Uẩn Không, người Kiến Xương (Nam Thành, Giang Tây) Trung Quốc. Thuở nhỏ theo Lý học, từng giảng học thuyết Trí lương tri của Vương Dương Minh. Năm 20 tuổi trọ ở Nam Kinh. Một hôm đi dạo Hạc Lâm gặp Cổ Khê, đàm đạo rất khế hợp. Cổ Khê chỉ dạy Phật pháp, Thường Trung rất cảm động liền theo Ngài xuất gia. Vâng lời thầy, sư đi khắp nơi tham các bậc Thiện tri thức. Niên hiệu Gia Tĩnh thứ 43 (1564) đến Tung Sơn tham kiến Tiểu Sơn Tông Thư, không khế ngộ liền từ giã Tông Thư đi du phương khắp nơi, sau đó dường như đối với lời nói của Tông Thư có tỉnh ngộ nên trở lại Tung Sơn, nối pháp làm truyền nhân tông Tào Động. Lúc Tông Thư đến trụ am Tông Cảnh ở Bắc Kinh, sư theo hầu 3 năm, lãnh trọn huyền chỉ. Từ giã trở về Kiến Xương, ẩn cư núi Tùng Cô. Một hôm đi dạo đến Lẫm Sơn, Tân Thành, Hãn Giang Sư thích phong cảnh nơi đây bèn kết am ở lại 20 năm không tiếp người, chỉ riêng kết bạn phương ngoại với La Nhữ Phương và Đặng Nguyên Tích, cùng nhau đàm luận về học thuyết tính mệnh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Trụ", "definition": "Nitya-sthita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Trụ Niết Bàn", "definition": "Pratiṣṭhita-nirvāṇa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Trực", "definition": "常直. Luôn luôn, không lúc nào thiếu vắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Tình", "definition": "常情. Lòng dạ chung của mọi người. Đoạn trường tân thanh: “Ghen tuông thì cũng người ta thường tình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Tùy Ma", "definition": "Xem Chướng Ngại Thần.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Túy Thiên", "definition": "Sadamatta (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thường Tịch Quang Độ", "definition": "Tức là thế giới chân như, nơi an trú của chư Phật. Thế Giới này không sinh diệt biến đổi (thường), không có phiền não quấy nhiễu (tịch), chỉ thuần là ánh sáng trí tuệ (quang).", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thường Tọa Tam Muội", "definition": "Là một trong 4 loại tam muội do tông Thiên Thai chế lập (Thường Tọa Tam Muội, Thường Hành Tam Muội, Bán Hành Bán Tọa Tam Muội, và Phi hành phi tọa tam muội). Pháp tam muội này được y cứ vào Kinh Văn Thù Thuyết Bát Nhã và Kinh Văn Thù Vấn Bát Nhã mà tu tập. Hành Giả lấy 90 ngày làm một hạn kì, ngồi một mình trong tịnh thất, thân hình ngay thẳng, bỏ hết tạp niệm, tâm duyên vào pháp giới, quán chiếu tất cả các pháp đều là Phật pháp, cũng chuyên tâm xưng niệm danh hiệu của một đức Phật nào đó do mình tự chọn. Trong suốt hạn kì, tinh tấn chuyên cần hành trì như thế, không giải đãi, không gián đoạn, thì có thể phá trừ nghiệp chướng, thật tướng của vạn pháp phát hiện. Vì chuyên tu chỉ một hạnh NGỒI, cho nên pháp tam muội này cũng được gọi là Nhất hạnh tam muội.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thường Tồn", "definition": "Nicca (tính từ), niccakālaṃ (trạng từ), niccaṃ (trạng từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thường Tổng", "definition": "常 總 (1025-1091). Thiền tăng đời Tống, họ Thí, tự Chiếu Giác, người Kiếm Châu (Kiếm Các, Tứ Xuyên) Trung Quốc. Năm 11 tuổi sư theo Văn Triệu chùa Bảo Vân xuất gia, y chỉ Khế Tư thụ giới cụ túc. Sau đó theo Hoàng Long Huệ Nam tham cứu 20 năm, nối pháp chấn hưng tông phong Lâm Tế, nổi tiếng khắp tùng lâm. Huệ Nam tịch, sư trụ trì chùa Lặc Đàm đồ chúng kính ngưỡng tán dương gọi sư là “Mã Tổ tái lai”. Niên hiệu Nguyên Phong thứ 3 (1080) phụng sắc sửa đổi Đông Lâm Luật Tự ở Lô Sơn trở thành Thiền lâm, Thường Tổng phụng mệnh trụ tích thuyết pháp, từng giao du với Tô Thức. Năm thứ 5 (1082) vua Thần Tông ban sắc cho sư trụ trì Thiền viện Trí Hải chùa Tướng Quốc, sư từ chối không nhận, vua bèn ban tử y và hiệu “Quảng Huệ Thiền Sư”. Niên hiệu Nguyên Hựu thứ 3 (1088) ban hiệu “Chiếu Giác Thiền Sư”. Đệ tử nối pháp có hơn 10 người như ấn Kiền, Hạnh Anh, Khả Tiên v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường Xuyên", "definition": "常川. Như Thường trực 常直.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường hay đến thăm nhà”.", "definition": "2. Lời gọi chung một nhóm tăng nhân và tín đồ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thường tịch quang", "definition": "(常寂光): từ gọi tắt của Thường Tịch Quang Độ (常寂光土), là cõi Tịnh Độ nơi pháp thân của chư Phật Như Lai an trú, một trong 4 quốc độ của giáo thuyết Thiên Thai Tông, còn gọi là Tịch Quang Tịnh Độ (寂光淨土), Tịch Quang Quốc (寂光國), Tịch Quang Độ (寂光土), Tịch Quang (寂光). Thế giới an trú của chư Phật là bản tánh chân như, không biến hóa, sanh diệt (tức thường [常]), không bị phiền não nhiễu loạn (tức tịch [寂]) và có ánh sáng trí tuệ (tức quang [光]), cho nên có tên gọi là Thường Tịch Quang Độ. Đây là quốc độ chư Phật tự chứng bí tạng tối cùng cực, lấy pháp thân, giải thoát và bát nhã làm thể, đầy đủ 4 đức Thường (常), Lạc (樂), Ngã (我) và Tịnh (淨). Trong Quán Phổ Hiền Bồ Tát Hành Pháp Kinh (觀普賢菩薩行法經, Taishō 9, 393) có đoạn rằng: “Thích Ca Mâu Ni Phật danh Tỳ Lô Giá Na Biến Nhất Thiết Xứ, kỳ Phật trú xứ danh Thường Tịch Quang, Thường Ba La Mật sở nhiếp thành xứ, Ngã Ba La Mật sở an lập xứ, Tịch Ba La Mật diệt hữu tướng xứ, Lạc Ba La Mật bất trú thân tâm tướng xứ (釋迦牟尼佛名毘盧遮那遍一切處、其佛住處名常寂光、常波羅蜜所攝成處、我波羅蜜所安立處、淨波羅蜜滅有相處、樂波羅蜜不住身心相處, đức Phật Thích Ca Mâu Ni Phật có tên là Tỳ Lô Giá Na Biến Nhất Thiết Xứ [Tỳ Lô Giá Na Biến Hết Thảy Các Nơi], trú xứ của Phật ấy tên là Thường Tịch Quang, nghĩa là nơi được nhiếp thành của Thường Ba La Mật, nơi được an lập của Ngã Ba La Mật, nơi diệt hết các tướng có của Tịch Ba La Mật và nơi không trú vào tướng thân tâm của Lạc Ba La Mật)”. Hơn nữa, quốc độ này được phân thành Phần Chứng (分證) và Cứu Cánh (究竟) với 3 phẩm thượng, trung, hạ. Theo lời dạy trong quyển 1 của Duy Ma Kinh Lược Sớ (維摩經略疏) cho biết rằng cõi của Diệu Giác Pháp Thân (妙覺法身) cư trú là Thượng Phẩm Tịch Quang Độ (上品寂光土), cõi của Nhất Sanh Đẳng Giác (一生等覺) là Trung Phẩm Tịch Quang Độ (寂光土), cõi của Viên Giáo (圓敎) từ sơ trú trở lên là Hạ Phẩm Tịch Quang Độ (寂光土). Ngoài ra, vị tăng nhà Bắc Tống là Tứ Minh Tri Lễ (四明知禮) lấy hai cõi Thật Báo (實報) và Tịch Quang (寂光) phối hợp thành Thỉ Giác (始覺) và Bản Giác (本覺), để xướng ra thuyết “Tịch Quang Hữu Tướng (寂光有相, Tịch Quang Có Tướng)”; ngược lại vị tăng Tịnh Giác (淨覺) lại tuyên xướng thuyết “Tịch Quang Vô Tướng (寂光無相, Tịch Quang Không Tướng).” Trong Phật Thuyết A Di Đà Kinh Yếu Giải (佛說阿彌陀經要解) của Đại Sư Ngẫu Ích Trí Húc (蕅益智旭, 1599-1655) nhà Thanh có đoạn rằng: “Phục thứ, chỉ thử nguyện trang nghiêm nhất thanh A Di Đà Phật, chuyển Kiếp Trược vi Thanh Tịnh Hải Hội, chuyển Kiến Trược vi Vô Lượng Quang, chuyển Phiền Não Trược vi Thường Tịch Quang, chuyển Chúng Sanh Trược vi Liên Hoa hóa sanh, chuyển Mạng Trược vi Vô Lượng Thọ; cố nhất thanh A Di Đà Phật, tức Thích Ca Bổn Sư ư Ngũ Trược ác thế, sở đắc chi A Nậu Đa La Tam Miệu Tam Bồ Đề pháp (復次、只此信願莊嚴一聲阿彌陀佛、轉劫濁爲清淨海會、轉見濁爲無量光、轉煩惱濁爲常寂光、轉眾生濁爲蓮華化生、轉命濁爲無量壽、故一聲阿彌陀佛、卽釋迦本師於五濁惡世、所得之阿耨多羅三藐三菩提法, lại nữa, chỉ lấy nguyện này trang nghiêm một tiếng niệm A Di Đà Phật, chuyển Kiếp Trược thành Hải Hội Thanh Tịnh, chuyển Kiến Trược thành Vô Lượng Quang, chuyển Phiền Não Trược thành Thường Tịch Quang, chuyển Chúng Sanh Trược thành hoa sen hóa sanh, chuyển Mạng Trược thành Vô Lượng Thọ; cho nên một tiếng niệm A Di Đà Phật là pháp A Nậu Đa La Tam Miệu Tam Bồ Đề do đức Bổn Sư Thích Ca chứng đắc ở đời ác có Năm Trược).” Hay như trong Linh Phong Ngẫu Ích Đại Sư Tông Luận (靈峰蕅益大師宗論) quyển 6, phần Cảnh Tâm Cư Sĩ Trì Địa Tạng Bổn Nguyện Kinh Kiêm Khuyến Nhân Tự (警心居士持地藏本願經兼勸人序) có câu: “Nhất niệm mê Thường Tịch Quang Độ tiện thành A Tỳ Địa Ngục, nhất niệm ngộ A Tỳ Địa Ngục tiện thị Thường Tịch Quang Độ (一念迷常寂光土便成阿鼻地獄、一念悟阿鼻地獄便是常寂光土, một niệm mê bèn thành Địa Ngục A Tỳ, một niệm ngộ tức là Thường Tịch Quang Độ).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thường Đàm", "definition": "常談. Nói đến luôn luôn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thường Đẳng Tứ Cú", "definition": "常等四句 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thường Đề Bồ Tát", "definition": "Sadaprarudita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thưởng", "definition": "慯. Lo nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Ca La", "definition": "Xem Bát Bộ Lực Sĩ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thưởng Hoa", "definition": "賞花. Ngắm hoa đẹp. Xem thí dụ chữ Thưởng賞.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Kim", "definition": "賞金. Số tiền đem cho để khen người có công.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Lãm", "definition": "賞覽. Ngắm nghía để tìm sự thích thú.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Ngoạn", "definition": "賞玩. Xem ngắm vui chơi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Nguyệt", "definition": "賞月. Ngắm trăng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Phạt", "definition": "賞罰. Khen ngợi kẻ có công và trừng trị kẻ lầm lỗi. Truyện Nhị Độ Mai: “Một tay thưởng phạt hai bề công minh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Thức", "definition": "賞識. Xem, dùng cho biết cái hay, cái đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Tâm", "definition": "賞心. Lòng dạ vui thích. Hát nói của Cao Bá Quát: “Gồm đủ cả tháng cảnh lương thời thưởng tâm lạc sự”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thưởng Xuân", "definition": "賞春. Ngắm cảnh đẹp của mùa xuân.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thược", "definition": "汋. Tiếng nước bắn tung lên, vọt lên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng", "definition": "丄. Một cách viết của chữ Thượng 上.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Chi", "definition": "上肢. Chỉ chung hai tay của người.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Chí", "definition": "上 志 (1668-1732). Thiền tăng đời Thanh, họ An, tự Văn Trúc, hiệu Nhẫn Am, người xứ Gia Hòa, Chiết Giang, Trung Quốc. Nối pháp Thiền Sư Đế Huy Lộ, đời thứ 38 hệ Nam Nhạc. Trước trụ chùa Thiên Ninh, Gia Hòa; sau trụ chùa Vân Lâm, Hàng Châu. Tác phẩm: Nhẫn Am Tập.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Chủ Bồ Tát", "definition": "Sarthavaha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Căn", "definition": "上 根. Căn khí thượng đẳng. Khai thị thiền nhân Đổng Văn Thừa trong HSLNMDT q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Căn Lợi Trí", "definition": "上 根 利 智. Người có căn khí thượng đẳng và trí huệ kiệt xuất. Tiết “Tục Nghệ Ngôn” trong NHQL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Cấp", "definition": "上級. Bậc trên. Người trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Cổ", "definition": "上古. Rất lâu đời. Đời thật xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Du", "definition": "上游. Vùng trên cao. Chỉ vùng rừng núi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Giới", "definition": "Mahādevaloka (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Hoàng", "definition": "上皇. Vị vua cha đã nhường ngôi cho con.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Huyền", "definition": "上弦. Chỉ ngày 8 hoặc 9 trong tháng âm lịch, lúc mặt trăng chưa tròn, còn cong như vành cung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Hình", "definition": "上刑. Sự trừng phạt rất nặng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Hóa", "definition": "Uttama-nirmāna (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Hương", "definition": "上香. Đốt nhang dâng thần thánh.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Hưởng", "definition": "尚享. Mong về mà nhận lấy. Tiếng thường dùng để kết thúc bài văn tế ngày xưa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Hạ", "definition": "上下. Trên và dưới Người trên và người dưới Lên và xuống.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Hạng", "definition": "上項. Bậc trên. Thứ tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Hạnh", "definition": "Superior Practices", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thượng Hạnh Bồ Tát", "definition": "Visistacaritra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Hạnh Ý Bồ Tát", "definition": "Bodhisattva Superior Practices Intent", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thượng Hải", "definition": "上海. Tên một thương cảng lớn của Trung Hoa, nơi sản xuất loại gấm cực đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Học", "definition": "上學. Tới trường. Đi học.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Khách", "definition": "上客. Người cao quý tới nhà mình. Khách quý.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Kinh", "definition": "上京. Lên kinh đô.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Kỷ", "definition": "尚 己 (1630-1711). Thiền tăng đời Minh, họ Dư, tự Vô Ngã, người xứ Đoan Châu (Triệu Khánh, Quảng Đông) Trung Quốc. Nối pháp Thiền Sư Kim Nhiễm ở Quảng Châu, đời thứ 36 hệ Thanh Nguyên. Trụ am Đàn Độ. Tác phẩm: Vô Ngã Tập (Thi Tập).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Lam Viện", "definition": "上 藍 院. ở đường Dân Đức, thành phố Nam Xương, tỉnh Giang Tây, Trung Quốc. Được xây dựng vào khoảng niên hiệu Thiên Giám (502-519) đời Lương Nam Triều, ban đầu tên “Thượng Lam Tự”, sau đổi tên là “Đại Phật Tự”. Khoảng niên hiệu Khai Nguyên (713-741) đời Đường đổi tên là “Khai Nguyên Tự”. Niên hiệu Vạn Lịch thứ 4 (769) Thiền Sư nổi tiếng Mã Tổ Đạo Nhất trụ chùa này tiếp hóa học nhân, các thiền khách tụ hội, chùa trở thành đạo tràng nổi tiếng hoằng dương thiền phong của Mã Tổ Đạo Nhất. Khoảng niên hiệu Đại Trung (847-860) đổi tên là “Thượng Lam Viện”. Khoảng niên hiệu Hàm Bình (998-1003) đời Tống đổi tên là “Thừa Thiên Tự”. Khoảng niên hiệu Chính Hòa (1111-1118) đổi tên là “Năng Nhân Tự”. Khoảng niên hiệu Cảnh Thái (1450-1456) đời Minh đổi tên là “Hựu Thanh Tự”. Năm 1929 đổi tên là “Hựu Dân Tự”. Kiến trúc hiện cón là do đời Thanh trùng tu. Trong chùa thờ tượng Phật lớn bằng đồng, cao 18 thước Tàu, nặng 36000 cân. Còn có đại đồng chung đúc vào niên hiệu Càn Đức thứ 5 (967) đời Nam Đường, cao 7 thước Tàu, nặng 10064 cân, treo trên lâu các hình vuông bằng đá hoa cương xây vào năm 1929 phía bên phải chùa.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Lý Thiên", "definition": "尚 理 篇. Sách, 1 quyển, do Cảnh Long soạn vào đời Minh. Vào niên hiệu Chính Thống thứ 5 (1440), đạo sĩ Liêu Thượng Thành ở miếu Ngũ Thánh phủ ứng Thiên có vẽ 1 bức tranh thiền sư Hoàng Long đang lễ bái thưa hỏi Lữ Động Tân với tựa đề là “Thần hóa đồ” và phụ phần giải thích rằng thiền sư Hoàng Long rất hâm mộ đạo pháp của Lữ Động Tân. Cảnh Long soạn “Thượng Lý Thiên” nhằm bác bỏ ngụy thuyết ấy, mục đích để nó không làm lầm mọi người.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Lưu", "definition": "上流. Dòng sông ở phía trên, gần nguồn sông Vùng đất hai bên bờ sông, chỗ gần nguồn sông Chỉ hạng người cao quý trong sạch (cũng như nước ở gần nguồn sông, không nhơ bẩn).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Lộ", "definition": "上路. Lên đường. Bắt đầu ra đi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Mã", "definition": "上馬. Nhảy lên ngựa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Môn Thượng Hộ", "definition": "上 門 上 戶. Chỉ cho tăng hành cước tham phỏng thiền sư các nơi. Tiết Chiêu Khánh Đạo Khuông Thiền Sư trong NĐHN q. 8 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Nghi Châu", "definition": "Uttaramantrina (S), Uhara-Mantrina (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Nguyên", "definition": "上元. Tiếng chỉ ngày rằm tháng giêng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Ngọ", "definition": "上午. Buổi sáng (thời gian ở trên buổi trưa).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Nhân", "definition": "Puruṣar-sabha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Phương Kim Cang Võng Bồ Tát", "definition": "Xem Kim Cang Võng Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Phẩm", "definition": "上品. Thứ tốt. Hàng tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Quan", "definition": "上官. Vị quan trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Quốc", "definition": "上國. Tiếng nước nhỏ gọi nước lớn Tiếng tôn xưng nước lớn, đang cai trị nước nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Quỹ Bồ Tát", "definition": "Xem Tối Thánh Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Sam Cảnh Thắng", "definition": "(上杉景勝, Uesugi Kagekatsu, 1555-1623): còn gọi là Trường Vĩ Cảnh Thắng (長尾景勝, Nagao Kagekatsu), vị Võ Tướng sống dưới thời đại An Thổ Đào Sơn (安土桃山), con của Trường Vĩ Chính Cảnh (長尾政景), con nuôi của Thượng Sam Khiêm Tín (上杉謙信). Sau khi Khiêm Tín qua đời, ông làm việc cho tướng quân Phong Thần Tú Cát (豐臣秀吉, Toyotomi Hideyoshi, 1537-1598), được liệt vào hàng ngũ của Ngũ Đại Lão (五大老).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thượng Sách", "definition": "上策. Cái mưu kế, cách thức hay hơn cả.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Sĩ", "definition": "上 士. Người căn khí thượng đẳng. “Chứng Đạo Ca” của Vĩnh Gia Huyền Giác Đại Sư trong CĐTĐL q. 30 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Sớ", "definition": "上疏. Dâng tờ giấy ghi lời tâu lên vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Sỹ", "definition": "Cg, Đại sỹ: Bồ Tát. Bộ Luận Du Già phân biệt như sau: không làm lợi cho mình, không làm lợi cho người đó là hạ sỹ, làm lợi cho mình nhưng không làm lợi cho người khác, đó là trung sỹ. Còn thượng sỹ hay đại sỹ (Bồ Tát) thì vừa lợi mình vừa lợi người, cả hai mặt tự lợi, tha lợi đều làm tròn. Trần Quốc Tảng, đời Trần (con Trần Liễu) sau khi cáo quan về nhà chuyên nghiên cứu Thiền học, sáng tác nhiều bài thơ Thiền, lấy đạo danh là Tuệ Trung Thượng Sĩ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thượng Thi La Bộ", "definition": "Xem Bắc Sơn Trụ Bộ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Thiền Đường", "definition": "上 禪 堂. ở phía dưới điện Nhục Thân, ngọn Thiền Quang, núi Cửu Hoa, tỉnh An Huy, Trung Quốc. Nguyên tên là “Cảnh Đức Đường”, niên hiệu Khanh Hy thứ 6 (1667) đời Thanh, đệ tử của Quốc sư Ngọc Lâm là Tông Diễn sau khi mở rộng kiến thiết đổi tên là “Thượng Thiền Đường”. Khoảng niên hiêu Hàm Phong (1851-1861) chùa bị chiến tranh phá hủy. Đầu những năm Đồng Trị (1862-1874) xây dựng lại. Kết cấu tinh diệu, ngoằn ngoèo lung linh, mây rừng tôn vẻ đẹp cho nhau, suối đá vây quanh, bố cục tinh xảo. Người xưa khi đi du ngoạn Thượng Thiền Đường, khen nó có ba cái nhất: “Hương khói Cửu Hoa đứng đầu thiên hạ chỉ có Thượng Thiền Đường là thịnh nhất; phong cảnh chỉ có Thượng Thiền Đường là đẹp nhất; điện vũ chỉ có Thượng Thiền Đường là xinh nhất”. Những năm 60 của thế kỷ 20 bởi tăng nhân không cẩn thận để lửa thiêu cháy phần lớn lầu gác. Điện vũ hiện còn không nhiều, trong Đại hùng bảo điện thờ tượng đắp Thích Ca, Quán Âm, Địa Tạng. Vi Đà điện có rường hoa xà chạm, phía sau là khách đường, thiền phòng, tịnh thất. Xung quanh chùa đẹp đẽ tĩnh mịch, ben cạnh có suối Kim Sa. Bên suối có cây Kim Tiền, tương truyền là do tiền mua rượu của Lý Bạch hóa thành, là một trong ba báu của Cửu Hoa Sơn.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Thư", "definition": "尚書. Vị quan đứng đầu một bộ trong triều, tương đương với Tổng trưởng, Bộ trưởng ngày nay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Thượng Chi Chỉ", "definition": "上 上 之 旨. Yếu chỉ thượng thượng, tức yếu chỉ của Thiền Tông. Bài tựa của Tỳ kheo Huệ Nguyên trong Trúc Lâm Tổ Sư Tuệ Trung Thượng Sĩ Ngữ Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Thượng Căn Cơ", "definition": "上 上 根 機. Người có căn khí thượng đẳng. Tiết Bắc Viện Thông Thiền Sư trong NĐHN q. 13 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Thượng Cơ", "definition": "上 上 機. 1. Bậc căn cơ thượng đẳng. Thung Dung Am Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Thượng Lợi Căn", "definition": "上 上 利 根. Người có căn khí thượng đẳng, kiệt xuất. Thư đáp Trung thừa Trịnh Côn Nham trong HSLNMDT q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Thẩm", "definition": "上審. Xét xử ớ cấp cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Thọ", "definition": "上壽. Tuổi già rất cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Thủ", "definition": "Là người ở địa vị tối cao trong đại chúng. Từ này đã được dùng phổ biến từ thời đức Phật còn tại thế, để chỉ cho các vị đệ tử xuất sắc nhất (về trí tuệ, khả năng, cũng như đức hạnh) của đức Phật, được cả tăng đoàn cùng Phật tử đồng kính ngưỡng, tôn xưng, như các tôn giả Xá Lợi Phất, Mục Kiền Liên, Đại Ca Diếp, A Na Luật, v.v... Ngày nay, từ “thượng thủ” thường được dùng chỉ để xưng cho vị cao tăng đứng đầu một giáo hội, tương đương với các từ “tăng thống”, “pháp chủ”.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thượng Thủ Bồ Tát", "definition": "Xem Kim Cang Tát Đỏa.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Thủ Đệ Tử", "definition": "上 首 弟 子. Thủ tọa, đệ tử lớn. Tổ thứ 14, Long Thọ tôn giả trong CĐTĐL q. 2 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Thừa", "definition": "Cũng đọc thặng là cỗ xe, ví với giáo pháp của Phật chuyên chở chúng sinh từ bến mê đến ngộ, từ đau khổ đến giải thoát. Thượng thừa là tên gọi khác của Đại thừa (cỗ xe lớn), cao cấp không phải chỉ chuyên chở một người hay một số ít người (Tiểu thừa), mà chuyên chở rất [tr.699] nhiều người, thậm chí toàn thể chúng sinh từ chỗ mê lầm và đau khổ đến nơi giác ngộ và giải thoát. Do đó, có các hợp từ Thượng thừa hay vô thượng thừa, tối thượng thừa.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thượng Truyện", "definition": "Hsiang-chuan (C), Commentary on the Images.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Trí", "definition": "Adhipaññā (nữ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thượng Trận", "definition": "上陣. Ra đánh giặc. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành: “… Mà những người từng thượng trận ngày xưa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Trực Biên", "definition": "(尚直編, Shōjikiben): 2 quyển, trước tác của Không Cốc Cảnh Long (空谷景隆) nhà Minh, san hành vào năm thứ 5 (1440) niên hiệu Chánh Thống (正統). Không Cốc Cảnh Long―pháp từ của Sư Tử Lâm Thiên Như Duy Tắc (師子林天如惟則), pháp hệ của Trung Phong Minh Bổn (中峰明本)―phản bác thuyết bài xích Phật Giáo của Nho Giáo nhà Tống và Chu Tử và khẳng định rõ rằng đạo của chư vị thánh nhân của 3 tôn giáo Nho, Phật, Đạo là kết hợp trời đất với đức, ánh sáng với trời trăng, tất cả đều là tư lương để chứng đạo nguyên sơ.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thượng Tuần", "definition": "上旬. Khoảng thời gian mười ngày đầu tháng âm lịch.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Túc", "definition": "Xem Đâu Suất Thiên Cung.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Tướng", "definition": "上將. Vị quan võ cấp cao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Tầng", "definition": "上層. tầng trên. Lớp trên.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Tọa", "definition": "Thera (P), Sthavira (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Tọa Bộ", "definition": "S.: Arya-thavira-nikaya - P.: Theravada. Giáo hội Phật giáo, sau khi đã thật sự phân rẽ thành hai bộ phái căn bản là Thượng Tọa Bộ và Đại Chúng Bộ (xem mục “Đại Chúng Bộ” và mục “Tình Hình Phân Phái Ở Buổi Sơ Kì”), Thượng Tọa Bộ đã rời nước Ma-kiệt-đà và dời sang nước Ca-thấp-di-la lập căn cứ hành đạo, rồi phát triển rộng ra khắp vùng Tây-Bắc Ấn-độ. Họ vẫn giữ đường lối bảo thủ, nhưng lâu ngày rồi cũng chịu ảnh hưởng của Đại Chúng Bộ, nên đường lối bảo thủ cũng bị thay đổi ít nhiều, và cũng đưa đến tình trạng phân hóa như Đại Chúng Bộ. Về giáo nghĩa, trước hết, Thượng Tọa Bộ cho rằng A-la-hán tức là Phật; bởi vậy, A-la-hán là mục tiêu cuối cùng, còn Bồ-tát thừa thì bị họ khinh thị. Thứ đến, bộ phái này nói rằng, không phải tất cả các lời Phật dạy đều là chuyển pháp luân và đều có lợi ích, mà chỉ có Tám Thánh Đạo mới là chánh pháp luân; bởi vậy, họ chỉ thừa nhận Ba Tạng đã được kết tập lần đầu tiên, mà không thừa nhận bất cứ kinh điển nào khác. Thứ nữa, họ chủ trương các pháp quá khứ và vị lai đều không có thật thể, chỉ có pháp hiện tại là thật có. Trong Ba Tạng thì họ coi Kinh là chủ yếu, nhưng lại lấy Giới Luật làm nơi y chỉ, và bảo thủ những kinh luật đã có sẵn, không thay đổi chút nào. Đến đầu thế kỉ thứ 3 Phật Lịch, trong tăng đoàn Thượng Tọa Bộ, có tôn giả Ca Đa Diễn Ni Tử (Katyayaniputra) là người đầu tiên xiển dương Luận Tạng, chủ trương tất cả các pháp (hữu vi và vô vi) đều có thật thể, đã lập ra một bộ phái riêng có tên là Thuyết Nhất Thiết Hữu Bộ. Rất đông tăng chúng đã theo bộ phái mới, những vị còn lại của Thượng Tọa Bộ bèn dời vào Tuyết-sơn lập cơ sở mới, đổi tên bộ phái thành Tuyết Sơn Bộ. Đó là lần phân phái thứ nhất của Thượng Tọa Bộ. Từ đó đến đầu thế kỉ thứ tư, trải qua sáu lần phân phái nữa, có đến 9 bộ phái nhỏ nữa được thành lập (lần lượt gồm có: Độc Tử, Pháp Thượng, Hiền Trụ, Chánh Lượng, Mật Lâm Sơn, Hóa Địa, Pháp Tạng, Ẩm Quang, và Kinh Lượng Bộ). Như vậy, Từ đầu thế kỉ thứ 3 PL đến đầu thế kỉ thứ 4 PL, Thượng Tọa Bộ đã trải qua 7 lần phân rẽ, thành 10 bộ phái nhỏ, kể luôn bộ phái gốc đã đổi tên thành Tuyết Sơn Bộ, tổng cộng tất cả là 11 bộ phái. Đặc biệt, vào giữa thế kỉ thứ 3 PL, dưới triều đại vua A Dục, tôn giả Ma Thẩn Đà đã đem giáo lí Thượng Tọa Bộ truyền sang nước Tích-lan (xem mục “Núi Chế Đa”), làm cho xứ này trở thành trung tâm của Phật giáo Nam-truyền Thượng Tọa Bộ mãi đến ngày nay.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thượng Tố", "definition": "上訴. Thưa lên toà trên, trong trường hợp không vừa vì cách xử xét của toà dưới.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Tộ", "definition": "(尚祚, Shōso, ?-1245): vị học tăng của Chơn Ngôn Tông Nhật Bản, sống vào khoảng giữa thời Liêm Thương, húy là Thượng Tộ (尚祚), tự là Giác Thể (覺体), Giác Thiền (覺禪). Ông vào nhập môn tu học với Giác Hải (覺海) trên Cao Dã Sơn, chuyên tâm nghiên tầm cực ý của Mật Giáo, cùng với Đạo Phạm (道範) ở Chánh Trí Viện (正智院) tiến hành nghiên cứu. Về sau, ông khai sáng Tâm Nam Viện (心南院) để dẫn dắt đàn hậu tấn. Ông không những chỉ nghiên cứu về Mật Giáo, mà còn an trí tượng A Di Đà Phật, và tìm hiểu về Tịnh Độ Giáo. Ông được xem là một trong 8 nhân vật kiệt xuất của Cao Dã Sơn.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thượng Uyên", "definition": "上 淵 (1627-1679). Còn gọi: Hải Uyên. Thiền tăng đời Thanh, họ Tào, hiệu Ba Đình, người xứ Tân Hà, Ký Châu (nay thuộc tỉnh Hà Bắc) Trung Quốc. Năm 16 tuổi sư đến Tam Phong, Hải Ngu (nay là huyện Thường Thục, tỉnh Giang Tô), vào làm đệ tử của ngài Tung ẩn, dường như tham học đến năm 19 tuổi thì được ngộ. Ít lâu sau, sư đến Linh Phong hoằng pháp, hết sức chấn chỉnh quy củ tùng lâm.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Uyển", "definition": "上苑. Vườn của nhà vua. Vườn trong cung vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Võ", "definition": "尚武. Ham chuộng sức mạnh Ta còn hiểu là tinh thần cao cả, trọng sức mạnh mà không dùng sức mạnh vào điều trái quấy thấp hèn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Y", "definition": "Xem Uất Đà La Tăng.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng Yết Na", "definition": "Xem Cốt Tỏa Thiên.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thượng sĩ ngữ lục là quyển sách tập trung các sáng tác của Tuệ Trung. Sách này có ba phần: phần đầu là những bài giảng và công án do ngài Pháp Loa ghi lại và vua Trần Nhân Tông khảo đính; phần thứ nhì gồm nhiều bài thơ đủ loại; phần cuối là bài Thượng sĩ hành trạng do vua Trần Nhân Tông viết. Sau đây là mấy bài thơ của Thượng sĩ.", "definition": "Khuyên thế tiến đạo", "source": "Tu Dien Phat Hoc - Quang Tri Chanh Vuong Chuoc"}
{"term": "Thượng Đường", "definition": "(上堂, Jōdō): đến Tăng Đường (僧堂) để ăn cơm cháo. Trong Chương Thạch Thê Hòa Thượng (石梯和尚章) của Hội Yếu (會要) 5 có đoạn rằng: “Sư kiến thị giả thác bát thượng đường, nãi hô vân: 'thị giả', giả ứng 'nặc'; sư vân: 'thậm xứ khứ ?', vân: 'thượng đường trai khứ' (師見侍者托鉢上堂、乃呼云、侍者、者應諾、師云、甚處去、云上堂齋去, Thầy thấy vị thị giả mang bình bát lên nhà ăn, bèn gọi rằng: 'này thị giả !' Người thị giả đáp: 'dạ'; thầy hỏi: 'đi đâu vậy ?' Đáp: 'lên nhà ăn cơm')”. Bên cạnh đó, từ này còn có nghĩa là lên Pháp Đường (法堂) để thuyết pháp. Ngày xưa, nghi thức này được tiến hành hằng ngày hai thời sáng và tối; nhưng sau này nó được tiến hành vào buổi sáng với thời gian quy định với các tên gọi như Tứ Tiết Thượng Đường (四節上堂), Ngũ Tham Thượng Đường (五參上堂), v.v. Từ này còn được gọi là Triêu Tham (朝參), Đại Tham (大參), Phổ Thuyết (普說) và Thăng Tòa (陞座). Trong phần Bách Trượng Quy Thằng Tụng (百丈規繩頌) của Thiền Uyển Thanh Quy (禪苑清規) 10 có đoạn rằng: “Kỳ hạp viện đại chúng, triêu tham tịch tụ, trưởng lão thượng đường thăng tòa, chủ sự đồ chúng nhạn lập trắc linh (其闔院大眾、朝參夕聚、長老上堂陞座、主事徒眾鴈立側聆, đại chúng trong toàn viện ấy đều buổi sáng tham vấn, buổi tối tập trung, vị trưởng lão lên tòa thuyết pháp, tất cả đồ chúng đứng ngay ngắn một bên lắng nghe).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thượng Đầu Quan", "definition": "上 頭 關. Cửa ải thiền huyền diệu hướng thượng, cửa ải thiền ngộ. Tiết Khai Thiện Đạo Khiêm Thiền Sư trong NĐHN q. 20 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thượng Đẳng", "definition": "上等. Hạng trên. Hạng tốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Đế", "definition": "上帝. Vị vua trên trời Tiếng chỉ đấng thiêng liêng của tôn giáo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thượng Đỉnh", "definition": "Upariṭṭha (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thượng Đức", "definition": "上徳. Người có nết lớn, cao hơn hết, chỉ ông vua. Văn tế trận vong tướng sĩ của Nguyễn Văn Thành: “… Vâng thượng đức hồi loan tháng trước…”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạc", "definition": "碩. To lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạc Nho", "definition": "碩儒. Bậc học giả danh tiếng lớn lao.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạc Sĩ", "definition": "碩士. Danh vị đại học, dành cho người thi đậu bậc giáo dục cao cấp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch", "definition": "石. Đá Hòn đá. Tảng đá Tên một bộ chữ Hán.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Anh", "definition": "石英. Tên một loại khoáng chất trong suốt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Cao", "definition": "石膏. Tên thứ loại khoáng chất màu trắng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Cung", "definition": "Shih kung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Cảm Đang", "definition": "石 敢 當. Phiến đá được dựng ở cửa ngỏ, trên có khắc 3 chữ “Thạch cảm đang”, dùng để ếm trừ điều xui xẻo, theo tục lệ ngày xưa. Thiền Tông mượn từ này để chỉ cho tự tính. Tín Tâm Minh Tịch Nghĩa Giải ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Củng Huệ Tạng", "definition": "Sakkyō ezō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Củng Hòa Thượng", "definition": "石 巩 和 尚. Thiền tăng Huệ Tạng, sống vào đời Đường, ở núi Thạch Củng, người đời gọi là “Thạch Củng Hòa Thượng”. X. Huệ Tạng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Hỏa", "definition": "石 火. Chỉ ánh lửa do cọ đá phát ra. Dụ cho sự sinh diệt mau chóng. Vạn Thiện Đồng Quy Tập, q. hạ (Đại 48, 986 trung) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Khanh", "definition": "Shih fan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Khê Tâm Nguyệt", "definition": "(石溪心月, Shitsukei Shingetsu, ?-1254): vị tăng của Phái Dương Kì và Tùng Nguyên thuộc Lâm Tế Tông Trung Quốc, hiệu là Thạch Khê (石溪), xuất thân Mi Sơn (眉山, Tỉnh Tứ Xuyên), họ là Vương (王). Ông xuất gia và kế thừa dòng pháp của Yểm Thất Thiện Khai (掩室善開). Sau đó, ông khai đường thuyết pháp tại Báo Ân Thiền Tự (報恩禪寺), Phủ Kiến Khang (建康府, Tỉnh Giang Tô). Ông đã sống qua một số nơi như Năng Nhân Thiền Tự (能仁禪寺) ở Phủ Kiến Khang, Thái Bình Hưng Quốc Thiền Tự (太平興國禪寺) ở Tương Sơn (蔣山), Vân Nham Thiền Tự (雲巖禪寺) ở Hổ Kheo Sơn (虎丘山) thuộc Phủ Bình Giang (平江府, Tỉnh Giang Tô), Linh Ẩn Tự (靈隱寺) ở Phủ Lâm An (臨安府, Tỉnh Triết Giang), Vạn Thọ Tự (萬壽寺) ở Kính Sơn (徑山). Trong khoảng thời gian này, ông viết lời trước ngữ cho Bát Phương Châu Ngọc Tập (八方珠玉集). Ông được gọi là Phật Mẫu Thiền Sư (佛母禪師). Vị thị giả của ông là Trú Hiển (住顯) biên tập bộ Thạch Khê Hòa Thượng Ngữ Lục (石溪和尚語錄) 3 quyển. Ông thị tịch vào năm thứ 2 (1254) niên hiệu Bảo Hựu (寶祐).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Khí", "definition": "石器. Đồ dùng làm bằng đá thời thượng cổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Liêm", "definition": "石 廉 (1620-1698). Thiền tăng đời Lê trung hưng, thuộc tông Tào Động, đời thứ 29, nối pháp Thiền Sư Giác Lãng. Sư họ Từ hiệu Đại Xán, Hán Ông, quê ở tỉnh Giang Tây Trung Quốc, là người truyền tông Tào Động vào miền Trung Việt Nam. Sư có tài, học vấn uyên bác, các thứ thiên văn địa dư, toán số, cho đến viết, vẽ đều rất tinh xảo, lại sở trường về thơ phú. Cuối đời Minh, nhà Mãn Thanh làm chủ Trung Quốc, sư không chịu ra làm quan, từ biệt mẹ già, cắt tóc đi tu, rồi vân du khắp nơi. Hòa Thượng Nguyên Thiều được lệnh chúa Nguyễn về Quảng Đông thỉnh các bậc cao tăng, nghe tiếng sư nên đến am Trường Thọ mời thỉnh. Sư khởi hành sang Việt Nam ngày 15 tháng giêng năm ất Hợi, đến ngày 28 tháng giêng sư đến Thuận Hóa và ngày mùng một tháng hai ra mắt chúa Nguyễn. Chúa Nguyễn mời sư ở chùa Thiên Mụ để dạy đệ tử và thường vời vào cung thưa hỏi đạo lý. Ngoài ra những thân hào nhân sĩ trong nước, hoặc trực tiếp hỏi đạo lý, hoặc gián tiếp đưa thơ hỏi đạo và văn chương khá nhiều. Sư ở lại Việt Nam hai năm rồi trở lại Trung Quốc. Tông Tào Động do sư truyền vào Việt Nam, về phái xuất gia không thấy nói đến người thừa kế, về phái tại gia thì thấy ghi chúa Nguyễn Phúc Chu tự nhận là đồ đệ nối dòng Tào Động thứ 30 (lời khắc trên chuông tại chùa Thiên Mụ). Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Lựu", "definition": "石榴. Tên một loài cây mùa hè nở hoa đỏ, quả chín nhiều hột, ăn được. Ta cũng gọi là cây Lựu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Môn Hiến Uẩn", "definition": "(石 門 献 蘊, Sekimon Kenon, ?-?): nhân vật sống dưới thời Ngũ Đại, vị tăng của Tào Động Tông, pháp từ của Thanh Lâm Sư Kiền (青林師虔), người Kinh Triệu (京兆, thuộc Tỉnh Thiểm Tây), được gọi là Đại Ca Hòa Thượng (大哥和 尚). Ban đầu ông sống ở Lan Nhã (蘭若) thuộc Nam Nhạc (南岳), sau chuyển đến Đàm Châu (潭州), Tỉnh Hồ Nam (湖南省). Ông được vua nước Sở tiếp đãi rất trọng hậu, khai sáng Thạch Môn Tự (石門寺) ở Nhượng Châu (襄州, thuộc Tỉnh Hồ Bắc).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Môn Thông", "definition": "Shih men Tsung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Môn Uẩn Thông", "definition": "(石門蘊聰, Sekimon Unsō, 965-1032): vị tăng của Lâm Tế Tông Trung Quốc, xuất thân vùng Nam Hải (南海, Tỉnh Quảng Đông), họ là Trương (張). Sau khi xuất gia, ông đến tham yết Bách Trượng Đạo Thường (百丈道常), và cuối cùng được đại ngộ dưới trướng của Thủ Sơn Tỉnh Niệm (首 山省 念). Ngoài ra ông còn đến tham vấn Động Sơn Thủ Sơ (洞 山 守 初) ở Nhượng Châu (襄 州, Tỉnh Hồ Bắc), Đại Dương Sơn Cảnh Diên (大陽山警延) ở Dĩnh Châu (郢州, Tỉnh Hồ Bắc), cũng như Trí Môn Sư Giới (智門師戒) ở Tùy Châu (隨州, Tỉnh Hồ Bắc), và vào năm thứ 3 (1006) niên hiệu Cảnh Đức (景德), ông đến trú tại Thạch Môn Sơn (石門山) vùng Nhượng Châu. Đến năm thứ 4 (1020) niên hiệu Thiên Hy (天禧), ông chuyển đến Thái Bình Hưng Quốc Thiền Tự (太平興國禪寺) ở Cốc Ẩn Sơn (谷隠山). Đồ chúng tập trung đến tham học với ông lên đến cả ngàn người. Ông đã từng kết thâm giao với Hàn Lâm Dương Văn Ức (翰林楊文億), Trung Sơn Lưu Quân (中山劉筠), v.v. Vào ngày mồng 8 tháng 3 năm thứ 10 niên hiệu Thiên Thánh (天聖), ông thị tịch, hưởng thọ 68 tuổi và được ban cho thụy hiệu là Từ Chiếu Thiền Sư (慈照禪師). Ngữ lục của ông có Thạch Môn Sơn Từ Chiếu Thiền Sư Phụng Nham Tập (石門山慈照禪 師鳳巖集), 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Môn Văn Tự Thiền", "definition": "(石門文字禪, Sekimonmojizen): 30 quyển, trước tác của Giác Phạm Huệ Hồng (覺範慧洪) nhà Tống, Giác Từ (覺慈) biên tập, san hành vào năm thứ 25 (1597) niên hiệu Vạn Lịch (萬曆). Là tập thơ văn của Huệ Hồng―người có thiên tài về văn chương, tác phẩm này rất phong phú với các loại cổ thi, hài luật, ngũ ngôn luật thi, thất ngôn luật thi, ngũ ngôn tuyệt cú, lục ngôn tuyệt cú, thất ngôn tuyệt cú, kệ, tán, từ, phú, đề, bạt, sớ, thư, văn bia tháp, hành trạng, truyền ký, văn tế, v.v. Sau khi san hành với lời tựa của Đạt Quán (達觀), bộ này được nhập vào trong Minh Bản Tục Tạng Kinh (明本續藏經) và trùng san vào năm thứ 20 (1681) niên hiệu Khang Hy (康熙).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Mật", "definition": "Phāṇita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Nông Thi Văn Tập", "definition": "石農詩文集. Tên một tập thơ và văn bằng chữ Hán của Nguyễn Tư Giản.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Nông Tùng Thoại", "definition": "石農叢話. Tên một tác phẩm bằng chữ Hán của Nguyễn Tư Giản, danh sĩ đời Thiệu Trị.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Nữ", "definition": "Vandhya (S), Vanjha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Nữ Nhi", "definition": "Xem Bàn Đại Tử.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Phật Tự", "definition": "石 佛 寺. Còn gọi: Linh Thứu Thiền Viện. ở Dương Sơn, thị trấn Hạ Phương Kiều, cách thành phố Thiệu Hưng, tỉnh Chiết Giang, Trung Quốc 20km về phía tây bắc. Khoảng niên hiệu Khai Hoàng (581-600) đời Tùy, thợ đá tại núi này lựa chọn đá để xây cất thành Thiệu Hưng, đã để lại khối đá đặc biệt trên vách dốc đứng. Trên khối đá cao vài chục trượng, chu vi hơn mười trượng tạc thành một tượng Phật Di Lặc cao hơn 4 trượng. Tương truyền khi khắc xong, trên không trung chim đại bàng bay đến, tăng nhân cho là điềm lành bèn tựa vào núi mà xây cất “Linh Thứu Thiền Viện” dùng điện vũ che chở Phật đá. Hiện vẫn còn vài gian phòng ốc. Trên vách núi nhiều danh nhân đề vịnh thơ, danh tướng đời Nam Tống Hàn Thế Trung viết hai chữ “Phi Dược” (bay vọt) rất là cứng cáp. Trong chùa đường nhỏ quanh co uốn lượn, cảnh tiên u nhã. Ngoài chùa hồ nước bao quanh, tiểu sơn la liệt. Xung quanh chùa ánh sáng mặt hồ và sắc núi soi chiếu nhau rực rỡ. Nhìn từ ngoài xa trông giống như một bồn cảnh thiên nhiên của cảnh quan lạ thường cho nên có lời ca ngợi “Thạch sát cánh kiêm thạch sơn ủng, Phật điện xảo trúc tự thần công”(Chùa đá lại được núi đá giúp, điện Phật xây khéo tợ thợ thần).", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Sương Khánh Chư", "definition": "Shih-shuang Ch'ing-chu (C), Sekisō-keishō (J).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Sương Sơn", "definition": "石 霜 山. Còn gọi: Sương Hoa Sơn. Núi thuộc huyện Lưu Dương, tỉnh Hồ Nam, Trung Quốc, nằm cách trung tâm huyện 46km về phía tây nam. Phía bắc của núi là động Dương Sơn. Trên núi có chùa Sùng Thắng, đời Đường có thiền sư Khánh Chư Phổ Hội ở trên núi đến 20 năm. Đời Tống có thiền sư Sở Viên cũng ở núi này hoằng dương tông Lâm Tế; về sau được an táng tại đây. Các vị như: Huệ Viên, Huệ Nam, Phương Hội cũng xiển dương tông phong nơi đây. Đầu niên hiệu Thiệu Hưng (1131-1162) chùa bị nạn binh lửa, về sau được trùng tu, đổi tên là Thạch Sương Tự.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Sương Sở Duyên", "definition": "Shih-shuang Ch'u-yuan (C), Shishuang Chuyuan (C), Sekiso Soen (J), Ch'i-ming (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Sương Sở Viên", "definition": "(石霜楚圓, Sekisō Soen, 986-1039): tức Từ Minh Sở Viên (慈明楚圓), vị tổ đời thứ bảy của Lâm Tế Tông Trung Quốc, người vùng Toàn Châu (全州, thuộc Tỉnh Quảng Tây), họ là Lý (李). Hồi nhỏ ông là thư sinh, đến năm lên 22 tuổi ông xuất gia tại Ẩn Tỉnh Tự (隱靜寺), Tương Sơn (湘山, thuộc Tỉnh Giang Tây ngày nay), rồi đến tham vấn với Thiện Chiêu (善昭) ở Phần Dương (汾陽) và kế thừa dòng pháp của vị nầy. Ngoài ra, ông còn đến tham yết với Đường Minh Tung (唐明嵩) nữa. Lần đầu tiên ông hóa đạo tại Nam Nguyên Sơn Quảng Lợi Thiền Viện (南源山廣利禪院), ở Viên Châu (袁州, thuộc Tỉnh Giang Tây ngày nay), rồi chuyển đến trú tại các chùa thuộc vùng Đàm Châu (潭州) như Thạch Sương Sơn Sùng Thắng Thiền Viện (石霜山崇勝禪院), Nam Nhạc Sơn Phước Nghiêm Thiền Viện (南岳山福嚴禪院), Hưng Hóa Thiền Viện (興化禪院). Đến năm thứ hai (1039) niên hiệu Bảo Nguyên (寳元), ông viên tịch, hưởng thọ 54 tuổi. Môn nhân của ông là Hoàng Long Huệ Nam (黃龍慧南) biên tập cuốn Từ Minh Thiền Sư Ngữ Lục (慈明禪師語錄) 1 quyển, ngoài ra còn có Từ Minh Thiền Sư Ngữ Yếu (慈明禪師語要) 1 quyển. Dòng pháp từ của ông có Hoàng Long Huệ Nam (黃龍慧南) và Dương Kì Phương Hội (楊岐方會) là hai nhân vật kiệt xuất nhất; sau nầy hai người đã phân thành 2 dòng phái khác là Dương Kì (楊岐) và Hoàng Long (黃龍).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Sương Sở Viên Thiền Sư Ngữ Lục", "definition": "石 霜 楚 圓 禪 師 語 錄. Còn gọi: Từ Minh Thiền Sư Ngũ Hội Trụ Trì Ngữ Lục, Từ Minh Hòa Thượng Ngữ Lục. Ngữ Lục, 1 quyển, do Thạch Sương Sở Viên soạn vào đời Tống, Hoàng Long Huệ Nam trùng biên, được xếp vào Tục Tạng Kinh tập 120, trang 161. Nội dung biên tập những lời thị chúng, Thượng đường và Cơ duyên, Khám biện, Kệ tụng v. v.. của thiền sư Sở Viên lúc ở những nơi như:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Sương Tánh Không", "definition": "Shih shuang Hsing k'ung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Sương Tự", "definition": "石 霜 寺. Nằm dưới núi Sương Hoa, làng Kim Cang, huyện Lưu Dương, tỉnh Hồ Nam, Trung Quốc. Khoảng niên hiệu Đại Trung (847-860) đời Đường Thiền Sư Đại Thiện sáng lập Sùng Thắng Viện ở nơi đây, khoảng niên hiệu Hàm Thông (860-874) Khánh Chư kế nhiệm trụ trì. Đời Tống, Huệ Viên, Huệ Nam, Phương Hội ở nơi này đại dương tông phong. Đầu niên hiệu Thiệu Hưng (1131-1162) chùa bị chiến tranh phá hủy, sau đó trùng tu, đổi tên Thiền tự. Bên chùa sông núi tạo nên cảm giác hứng thú, kiến trúc dù qua bao cuộc bể dâu, nhưng vẫn cao lớn nguy nga, Đại Phật điện cao 90 thước Tàu, tượng Phật cao 70 thước Tàu. Trong chùa nguyên có Quan Thánh điện, Tổ đường, Trai đường, Thiền đường, Giới đường, Phương trượng, Chu trì, Ngọc trì lâu, Hoa các lâu, Tàng kinh điện, Văn Thù đường, Di hốt đường. Hiện chỉ còn Đại Phật điện đường, Trai đường, Giới đường, Phương trượng và không ít bia đá còn gìn giữ hoàn hảo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Thán", "definition": "石炭. Than đá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Thượng Tài Hoa", "definition": "石 上 栽 花. Trồng hoa trên đá. Tỷ dụ thiền cơ kiên cố miên mật, không chút lơi lỏng, hoặc dụ cho ngộ tâm thanh tịnh không thể nhiễm ô. Tiết Dược Sơn Hòa Thượng trong TĐT q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Thất Hành Giả", "definition": "石 室 行 者. Thiền tăng Thiện Đạo, sống vào đời Đường, sau khi tham yết Thạch Đầu Hy Thiên và đắc pháp, gặp nạn Võ Tông hủy diệt Phật pháp, sư làm Hành giả (cư sĩ) ở trong chỗ xay lúa giã gạo. Tuy sư giã gạo nơi liêu công quả song không quên cử dương Phật Pháp, nên trong thiền lâm gọi sư là “Thạch Thất Hành Giả” hoặc “Thạch Thất Đạo”. X. Thiện Đạo.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Tín", "definition": "石信. Tên một thứ khoáng chất cực độc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Tượng", "definition": "石像. Hình người tạc bằng đá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Vũ Minh Phương", "definition": "(石雨明方, Sekiu Myōhō, 1593-1648): vị tăng của Tào Động Tông Trung Quốc, tự là Thạch Vũ (石雨), sinh ngày 29 tháng giêng năm thứ 21 (1593) niên hiệu Vạn Lịch (萬曆) nhà Minh, xuất thân Võ Đường (武塘), Phủ Gia Hưng (嘉興府, Tỉnh Triết Giang), họ là Trần (陳). Ông đến tham học và xuất gia với Tây Trúc Tông (西築宗). Vào năm thứ 43 (1615) niên hiệu Vạn Lịch, ông đến tham yết Trạm Nhiên Viên Trừng (湛然圓澄) ở Thạch Phật Tự (石佛寺), Gia Hưng (嘉興). Tu hành khắc khổ trong vòng 7 năm, cuối cùng ông kế thừa dòng pháp của vị này. Đến năm thứ 5 (1632) niên hiệu Sùng Trinh (崇禎), ông làm trú trì Thiên Hoa Tự (天華寺) ở Phủ Thiệu Hưng (紹興府, Tỉnh Triết Giang) và sau đó từng sống qua các chùa khác như Vân Môn Thánh Hiển Tự (雲門聖顯寺), Bảo Thọ Sơn Quang Hiếu Tự (寶壽山光孝寺) ở Hàng Châu (杭州, Tỉnh Triết Giang), Di Sơn Tây Thiền Tự (怡山西禪寺), Tuyết Phong Tự (雪峰寺) ở Phúc Châu (福州, Tỉnh Phúc Kiến), Linh Sơn Tự (靈山寺) ở Đinh Châu (汀州, Tỉnh Phúc Kiến), Phổ Minh Tự (普明寺) ở Phủ Kiến Ninh (建寧府, Tỉnh Phúc Kiến), Linh Phong Tự (靈峰寺) ở Khảo Đình (考亭), Long Môn Sơn Ngộ Không Tự (龍門山悟空寺) ở Hàng Châu, Đông Tháp Quảng Phước Tự (東塔廣福寺) ở Phủ Gia Hưng (嘉興府, Tỉnh Triết Giang), Cao Đình Sơn Phật Nhật Tự (皐亭山佛日寺) ở Hàng Châu, Tượng Điền Tự (象田寺) và Lan Ngạc Sơn Tự (蘭萼山寺) ở Phủ Thiệu Hưng (紹興府). Vào ngày mồng 8 tháng giêng năm thứ 5 (1648) niên hiệu Thuận Trị (順治), ông thị tịch, hưởng thọ 56 tuổi đời và 35 hạ lạp. Môn nhân là Viễn Môn Tịnh Trú (遠門淨住) biên tập bộ Thạch Vũ Thiền Sư Pháp Đàn (石雨禪師法檀) 20 quyển và soạn bản Hành Trạng (行狀).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Vũ Minh Phương Thiền Sư", "definition": "石 雨 明 方 禪 師. Thiền tăng Minh Phương, sống vào cuối đời Minh đầu đời Thanh, người đời gọi là “Thạch Vũ Minh Phương Thiền Sư”. X. Minh Phương.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Vũ Thiền Sư Pháp Đàn", "definition": "石 雨 禪 師 法 檀. Còn gọi: Thạch Vũ Pháp Đàn. Sách, 20 quyển, do Thạch Vũ Minh Phương soạn vào đời Minh, Viễn Môn Tịnh Trụ biên, được ấn hành vào niên hiệu Thuận Trị thứ 6 (1649) đời Thanh. Nội dung bao gồm Ngữ Lục của Minh Phương từ lúc ban đầu ở chùa Phật Nhật phủ Hàng Châu trải qua 13 ngôi đạo tràng ở 6 phủ, tính chung có 15 hội, và các phần: Phổ thuyết, Thị chúng, Cơ duyên, Tụng cổ, Tán, Pháp ngữ, Thi kệ, Tự, Ký, Minh, Bạt, Sớ, Thư vấn, Phật sự, Tế văn, Tạp trước, Hành trạng v. v…", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thạch Điền Pháp Huân", "definition": "Shih tien Fa hsun (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thạch Đầu", "definition": "石頭. Viên đá. Hòn đá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Đầu Hi Thiên", "definition": "(700-790): cũng gọi là đại sư Vô Tế. Ngài họ Trần, quê huyện Cao-yếu, tỉnh Quảng-đông, bẩm sinh đã thông minh. Dân làng vì sợ quỉ thần, thường giết trâu nấu rượu cúng tế. Ngài thấy việc ấy rất là tệ hại, bèn phá hủy miếu thờ quỉ thần. Ngài kính lễ Lục-tổ Tuệ Năng và thiền sư Thanh Nguyên Hành Tư làm thầy, sau được Thanh Nguyên Hành Tư ấn khả. Năm 742 ngài vào núi Hành-sơn, kết am trên một tảng đá lớn, chuyên tu thiền quán, hiển dương tông phong, người đời xưng là Thạch Đầu hòa thượng. Thời bấy giờ, ở vùng Giang-tây thì ngài Mã Tổ được coi là chủ yếu, còn ở vùng Hồ-nam thì ngài Thạch Đầu được coi là chủ yếu; người học bốn phương đều qui tụ về hai đạo tràng của hai vị thiền sư này. Ngài tịch lúc được 91 tuổi đời.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thạch Đầu Hy Thiên", "definition": "(石頭希遷, Sekitō Kisen, 700-790): vị Thiền tăng sống dưới thời nhà Đường, còn được gọi là Vô Tế Đại Sư (無際大師), người vùng Cao Yếu (高要), Đoan Châu (端 州, Cao Yếu, Quảng Đông), họ Trần (陳). Ông bản tánh rất thông minh, lanh lợi, nhân thấy người dân trong làng thường giết bò tế quỷ thần, nhiều lần như vậy, ông bèn phá đền thờ thần rồi dẫn bò về nhà. Ban đầu ông theo hầu hạ Huệ Năng (慧 能), rồi sau khi thầy mình qua đời, ông chuyển sang làm đệ tử của Thanh Nguyên Hành Tư (青原行思) ở Cát Châu (吉州, Tỉnh Giang Tây), và cuối cùng kế thừa dòng pháp của vị nầy. Vào năm đầu niên hiệu Thiên Bảo (天寳, 742-755), ông sống tại Nam Tự (南寺), Hành Sơn, làm am tranh trên tảng đá ở phía Đông chùa mà ngồi Thiền, nên được người đời gọi là Hòa Thượng Thạch Đầu (石頭). Đương thời ở Giang Tây (江西), Mã Tổ là chủ, còn ở Hồ Nam (湖南) Thạch Đầu là chủ, học đồ ở bốn phương đều tập trung về pháp tịch của 2 vị nầy. Tuy nhiên, giống như Thiên Hoàng Đạo Ngộ (天皇道悟), Đơn Hà Thiên Nhiên (丹霞天然) cũng đã từng tu hành dưới trướng của Mã Tổ, rồi Ngũ Duệ Linh Mặc (五 洩靈 黙) mà sau nầy được xem như là đệ tử của Mã Tổ, cũng có đến tham yết Thạch Đầu, sự qua lại giữa môn hạ của hai nhân vật nầy rất thường xuyên, và ta cũng thấy rằng họ có cùng một tư tưởng như nhau. Vào tháng 12 năm thứ 6 niên hiệu Trinh Nguyên (貞 元) nhà Đường, ông thị tịch, hưởng thọ 91 tuổi. Trước tác của ông có Tham Đồng Khế (參同契), Thảo Am Ca (草庵歌).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thạch Đắng", "definition": "石磴. Bậc đá. Hát nói của Dương Khuê: “Lúc vào động ngắm sơn quynh thạch đắng”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thạch Ốc Thanh Hòng", "definition": "Shih wu Ching hung (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thả", "definition": "𠀃. Như chữ Thả 且.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thả Bình Bồng", "definition": "Anvāhiṇḍati (anu + a + hid + m + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thả Chuyết", "definition": "且 拙. Hiệu của thiền tăng Tịnh Nột đời Thanh. X. Tịnh Nột.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thả Cá Phóng Sinh, Bệnh Mụt Nhọt Được Chữa Lành", "definition": "(Truyền thuyết Trung-quốc). Lí Cảnh Văn tin thuyết thần tiên, thường chưng nấu đơn sa để ăn. Ông tính nhân từ, thường đến các thuyền đánh cá để mua cá sống, rồi thả xuống nước. Vì ăn đơn sa lâu ngày, nhiệt tích tụ thành bệnh, nhọt độc mọc trên lưng, đau nhức vô cùng, đến nỗi hôn mê. Trong cơn mê, ông thấy như có một đàn cá nhổ nước miếng trên mụt nhọt. Tỉnh dậy, ông cảm thấy chỗ mụt nhọt trở nên mát mẻ, rồi khỏi bệnh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thả Hỷ Một Giao Thiệp", "definition": "且 喜 沒 交 涉. Thả hỷ hoặc Hạnh hỷ: Thật tức cười. Một giao thiệp: Không dính dáng. Tắc 5, Bích Nham Lục (Vạn Tục 148, 134 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thả Lỏng", "definition": "Cajati (caj + a), nissajati (ni + saj + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thả Ra", "definition": "Moceti (muc + e), mokkhati (mokkh + a), mokkha (nam), muñcati (muc + ṃ + a), niyyāma (trung), pamuñcati (pa + muc + ṃ + a), pamokkha (nam), pamoceti (pa + muc + e), ossajati (ova + saj + a) ossajana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thả Trí", "definition": "且 置. Còn gọi: Thả chỉ, Thả tùng. Hãy gác lại. Đặt ở cuối phân câu trước trong câu phức, biểu thị trừ bỏ nội dung của một khoản nào đó không trở thành chủ đề của câu chính, phân câu sau (câu chủ) giống như câu nghi vấn. Tiết Đại Từ Hoàn Trung Thiền Sư trong NĐHN q. 4 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thải", "definition": "汰. Bỏ đi. Loại ra, không dùng tới nữa. Đoạn trường tân thanh: “Tuồng gì hoa thải hương thừa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thải Chủ", "definition": "貸主. Người cho vay nợ. Chủ nợ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thải Hồi", "definition": "汰囘. Loại ra và cho về, không dùng nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thải Ra", "definition": "Ūhadati (u + had + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thảm", "definition": "忐. Bồn chồn thiết tha.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Chùi Chân", "definition": "Kilañja (nam), dhotapādaka, pādapuñchanī (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thảm Hoạ", "definition": "慘禍. Tai vạ lớn, gây nhiều đau khổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Khốc", "definition": "慘酷. Đau buồn to lớn mạnh mẽ Tàn ác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Kịch", "definition": "慘劇. Vở tuồng buồn rầu Việc đau buồn xảy ra.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Len", "definition": "Goṇaka (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thảm Não", "definition": "慘惱. Đau đớn buồn khổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Sát", "definition": "慘殺. Giết hại một cách độc ác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Sầu", "definition": "慘愁. Buồn khổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Thiết", "definition": "慘切. Đau đớn như cắt ruột. Đoạn trường tân thanh: “Sinh càng thảm thiết bồi hồi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Thê", "definition": "慘悽. Đau khổ buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Thương", "definition": "慘愴. Buồn khổ đau xót.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Trạng", "definition": "慘狀. Tình cảnh buồn khổ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảm Đạm", "definition": "慘淡. Tối tăm buồn rầu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thản", "definition": "儃. Nhàn hạ. Chậm rãi Xem Thiền.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thản Lí", "definition": "坦里. Con đường bằng phẳng. Chỉ đường đời êm ả. Hát nói của Nguyễn Công Trứ: “Đường thản lí cát nhân chi đã vội”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thản Nhiên", "definition": "Tan jan (C).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thản Phục", "definition": "(坦腹): để lộ bụng ra thấy rốn, nằm phơi bụng. Trong Thế Thuyết Tân Ngữ (世說新語), phần Nhã Lượng (雅量) của Lưu Nghĩa Khánh (劉義慶, 403-444) nhà Tống thời Nam Triều có đoạn: “Khích Thái Phó tại kinh khẩu, khiển môn sinh dữ Vương Thừa Tướng thư, cầu nữ tế. Thừa Tướng ngữ Khích Tín: 'Quân vãng đông sương, nhậm ý tuyển chi.' Môn sinh quy bạch Khích viết: 'Vương gia chư lang giai khả hỷ.' Văn lai mích tế, hàm tự căng trì, duy hữu nhất lang tại đông sàng thượng thản phục ngọa, như bất văn. Khích công vân: 'Chánh thử hảo.' Phỏng chi, nãi thị dật thiểu, nhân giá nữ dữ yên (郄太傅在京口、遣門生與王丞相書、求女壻。丞相語郄信：君徃東廂、任意選之。門生歸白郄曰：王家諸郎亦皆可嘉。聞來覓壻、咸自矜持、唯有一郎在東牀上坦腹臥、如不聞。郄公雲：正此好、訪之、乃是逸少、因嫁女與焉, khi Khích Thái Phó đang ở kinh đô, sai môn sinh đem thư đến cho Vương Thừa Tướng cầu kén rễ. Thừa Tướng bảo Khích Tín rằng: 'Ngươi cứ qua bên nhà đông, tùy ý chọn lựa.' Môn sinh trở về thưa lại với Khích Thái Phó rằng: 'Các chàng trai của vương gia đều có thể vui mừng thuận theo.' Nghe vậy, ông bèn đến xem mặt chàng rễ, ai ai cũng háo hức chờ đợi, duy chỉ có một chàng nằm phơi bụng thản nhiên trên giường phía đông, như thể chẳng nghe thấy gì cả. Khích Thái Phó bảo: 'Quả đúng người này rồi !' Hỏi ra mới biết chàng ta là người sống ít ham muốn, do đó ông gả con gái cho anh ta).” Từ đó, xuất hiện từ “đông sàng thản phục (東牀坦腹)” hay “thản phục đông sàng (坦腹東牀)”, được dùng dể chỉ cho người chồng của con gái mình, tức chú rễ. Như trong Tùy Đường Diễn Nghĩa (隋唐演義) hồi thứ 6 của Trử Nhân Hoạch (褚人獲, ?-?) nhà Thanh, có đoạn rằng: “Ngã thị Lý phủ trung tiểu thư đích bảo mẫu, nhân lão da, phu nhân yếu sính công tử đông sàng thản phục, đản ngã gia tiểu thư … thệ nguyện giá nhất cá thiện võ năng văn, túc trí đa mưu đích kỳ nam tử (我是李府中小姐的保母、因老爺、夫人要聘公子東牀坦腹、但我家小姐…誓願嫁一個善武能文、足智多謀的奇男子, tôi là bảo mẫu của tiểu thư trong phủ họ Lý; nhân lão gia và phu nhân cần kén chàng rễ công tử, nhưng tiểu thư nhà tôi … lại thề nguyện lấy một chàng trai đặc biệt khéo võ nghệ, giỏi văn chương, túc trí đa mưu).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thảng", "definition": "傖. Thảng thốt: 傖倅 Vội vã gấp rút, không suy nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảng Hoặc", "definition": "倘或. Giả dụ có thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo", "definition": "愺. Thảo lão 愺恅: Lòng dạ rối loạn Yên tĩnh không tiếng động.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Am", "definition": "草庵. Lều cỏ. Ngôi nhà tranh nhỏ bé. Đoạn trường tân thanh: “Thảo am đó cũng gần kề chẳng xa”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Diệu Pháp Hành", "definition": "Saddhammacara (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thảo Dã", "definition": "草野. Cánh đồng cỏ. Chỉ nơi quê mùa. Vẻ quê mùa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Luận", "definition": "討論. Bàn bạc xem xét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Lý Hán", "definition": "草 裏 漢. Người lạc lối vì cỏ rậm. Thiền Tông dùng từ này để chỉ cho đồ cố chấp. Phần Giáp chú của tắc 36, Bích Nham Lục q. 4 (Đại 48, 174 trung) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thảo Lư", "definition": "草盧. Lều cỏ, nhà tranh. Đoạn trường tân thanh: “Dọn thuyền mới rước nàng về thảo lư”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Muội", "definition": "草昧. Rậm rạp tối tăm. Cũng chỉ tình hình đen tối. Chiến Tụng Tây hồ phú của Phạm Thái: “Cơn thảo muội những gặp điều biến cải”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Mộc", "definition": "草木. Cỏ và cây. Chỉ chung cây cối. Tụng Tây hồ phú của Nguyễn Huy Lượng: “… Thảo mộc thảy ca ông Thang vũ”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Trát", "definition": "草札. Viết giấy lệnh đòi lên phủ quan. Truyện Trê Cóc: “Truyền cho thảo trát vô đòi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Y Mộc Thực", "definition": "草 衣 木 食. Kết cỏ lá làm áo, hái trái rừng làm thức ăn, chỉ cho sinh hoạt thô sơ của tăng nhân ở ẩn trong rừng núi sâu kín. Đoạn Tế Tâm Yếu ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thảo Yển Phong Hành", "definition": "草 偃 風 行. Gió thổi cỏ rạp, chỉ cho hành vi hoặc sự kiện tiến hành thuận lợi, phát triển tự nhiên. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thảo Đường", "definition": "草堂. Nhà cỏ, nhà tranh. Chỉ nơi ở ẩn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Đường Thi Tập", "definition": "草堂詩集. Tên một tập thơ bằng chữ Hán của Phạm Quý Thích, danh sĩ thời Nguyễn sơ. Phạm Quý Thích có hiệu là Thảo Đường Cư sĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thảo Đường Tự", "definition": "草 堂 寺. Chùa ở làng Thảo Đường, thị trấn Tần, huyện Hộ, tỉnh Thiểm Tây, Trung Quốc, nằm cách trung tâm thị trấn 15km về phía nam. Vốn là nền cũ “Tiêu Dao Viên” của nhà Hậu Tần vào thời Nam Bắc Triều, là chỗ dịch kinh của cao tăng Cưu Ma La Thập, nước Quy Tư, Tây Vức. Đời Đường xây dựng thành chùa Thê Thiền, về sau đổi tên là chùa Thảo Đường, Thiền Sư Tông Mật từng ở chùa này. Các điện đường phần lớn bị hư hỏng, chỉ còn đại điện và lang vũ (nhà nhỏ ở hai bên) được xây dựng trong đời Dân Quốc là tồn tại đến nay. Góc tây bắc chùa có 1 cái giếng xưa tương truyền thuở xưa trong giếng có cái nón bằng sương mù (Yên vụ) hiện ra. “Thảo Đường Yên Vụ” là 1 trong 8 cảnh ở Quan Trung.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thảy", "definition": "Nikkaddahaṭi (ni + kaḍḍh + a), attharati (ā + thar + a), attharaṇa (trung), khipati (khip + a), khipa (nam), khipana (trung), nipāteti (ni + pat + e)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thảy Ra", "definition": "Samuggirati (saṃ + u + gir + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thảy Vào", "definition": "Pakkhipati (pa + khip + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thảy Xuống", "definition": "Avakkhipati (ava + khip + a), avakkhippana (trung), nipātana (trung), pakirati (pa + kir + a), okkhipati (ova + khip + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thả… Thủ", "definition": "且 取. Hãy… đi! Biểu thị ngữ khí mệnh lệnh. Vân Môn Quảng Lục, q. trung ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấm", "definition": "沁. Tên sông ở Trung Hoa tức Thấm thuỷ, cũng gọi là Thấm hà, thuộc tỉnh Sơn Tây.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấm Vào", "definition": "Paṭivijjhati (paṭi + vidh + ya), pariyuṭṭhāti (pari + u + ṭhā + a), pharaṇa (trung), pharati (phar + a), vipphāra (nam), nibbetha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấn", "definition": "殯. Chết ở quê người, còn quàn tạm, chưa đem về quê nhà. Đoạn trường tân thanh: “Bơ vơ lữ thấn tha hương đề huề”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấp", "definition": "咠. Ghé miệng vào tai người khác mà nói nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấp Bà Phái", "definition": "Saiva (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thấp Bà Thiên", "definition": "Xem Hạnh phúc.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thấp Bệnh", "definition": "溼病. Thứ bệnh do nhiễm hơi ẩm mà thành.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấp Hèn", "definition": "Adhama (tính từ), hīna (tính từ), lāmaka (tính từ), nihīna (tính từ), nikiṭṭha (tính từ), ninnatā (nữ), oma (tính từ), omaka (tính từ), oraka (tính từ), gārayha (tính từ), jamma (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấp Khí", "definition": "溼氣. Hơi ẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấp Nhiệt", "definition": "溼熱. Ẩm và nóng, nói về khí hậu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấp Nhất", "definition": "Orima (tính từ), pacchima (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấp Sanh", "definition": "Saṅsedaja (P), Saṃsvedaja (S), Saṅsedaja (P), Jalaja (S), Birth from moisture, Moisture- or water-born.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thấp Thỏi", "definition": "Hīna (tính từ)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấp Địa", "definition": "溼地. Vùng đất ẩm ướt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấp Độ", "definition": "溼度. Mức hơi ẩm trong không khí. Độ ẩm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất", "definition": "七. Số bảy (7).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Biện", "definition": "七辯 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Báu", "definition": "Gồm: Kim, Ngân, Lưu Ly, Pha Lê, Xà Cừ, Mã Não, San Hô.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Bại", "definition": "失敗. Hỏng việc. Thua lỗ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Bảo", "definition": "七寶 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Bất Khả Tỵ", "definition": "Thất bất khả tỵ là bảy điều chẳng tránh được, hoặc bảy sự việc chẳng tránh được (tỵ tức là tránh né) bao gồm như sau:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Bất Thối Pháp", "definition": "Bảy Phép Bất Thối. “Các vị khất sĩ! Như Lai sẽ chỉ dạy cho các vị bảy phương pháp để giữ gìn cho chánh pháp và giáo đoàn không bị suy thoái. Các vị hãy lắng nghe.", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Thất Bồ Đề Phần", "definition": "Sapta-bodhyaṅgani (S), Seven factors of enlightenment, Sattabojjhaṅga (P), Saptabuddhividhya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Chi", "definition": "七支 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chi Luận Pháp", "definition": "Sapta-bhangi-naya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Chu Hành Từ", "definition": "七周行慈 (Thiên Thai Tứ Giáo Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chân Như", "definition": "七真如 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chí", "definition": "失志. Không thoả lòng mong muốn. Hát nói của Nguyễn Công Trứ: “Khi đắc chí lại có khi thất chí”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Chính", "definition": "七政. Bảy thiên thể trên trời, gồm Nhật, Nguyệt và 5 vì sao Kim, Mộc, Thuỷ, Hoả, Thổ. Tụng Tây hồ phú của Nguyễn Huy Lượng: “Trên cửu đạo lại tày ngôi thất chính…”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Chúng", "definition": "七眾 (Nhân Vương Hộ Pháp Kinh và Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chơn Như", "definition": "Thất chơn như là bảy món chơn như bao gồm như sau:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Biện", "definition": "Thất chủng biện là bảy món biện luận Bồ Tát có bảy món tài biện luận bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Bất Tịnh", "definition": "七種不淨 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Bố Thí", "definition": "Thất chủng bố thí là bảy cách bố thí, bao gồm như sau: Bố thí cho người khách từ xa mới đến. Bố thí cho người sắp đi xa Bố thí cho người bệnh Bố thí cho người nuôi bệnh Bố thí vườn tược cho kẻ nghèo… Bố thí đồ ăn thường ngày Tùy lúc bố thí", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Lập Đề", "definition": "七種立題 (Thiên Thai Trí Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Lễ Phật", "definition": "種禮佛 ( Pháp Uyển Châu Lâm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Mạn", "definition": "七種慢 (Lăng Nghiêm Kinh và Luận Tỳ Bà Sa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Ngã Mạn", "definition": "Thất chủng ngã mạn là bảy hình thức kiêu mạn của chúng phàm si, bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Ngữ", "definition": "Thất chủng ngữ là bảy cách giảng nói, thuyết pháp mà Đức Phật đã dùng:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Nhân", "definition": "七種人 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Nhị Đế", "definition": "Thất chủng nhị đế là bảy loại định nghĩa về nhị đế có phần khác nhau về chân đế (nghĩa lý căn bản về chân đế) tục đế, nghĩa là căn bản làm phương tiện giảng nói của các tông phái Phật giáo, bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Quả", "definition": "Thất chủng quả là bảy thứ kết quả, bảy thứ quả báu, quả sanh ra là do nơi nhân. Trong Kinh Niết Bàn quyển 36 có chép rằng trong thế gian tất cả có thất chủng quả bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Sanh Tử", "definition": "七種生死 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Sám Hối Tâm", "definition": "七種懺悔心 (Từ Bi Thủy Sám)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Tam Muội", "definition": "Xem Thất Giác Phần Tam Muội.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Chủng Thọ Thai", "definition": "七種壽胎 (Thiện Kiến Tỳ Bà Sa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Tánh", "definition": "Thất chủng tánh là bảy loại tánh chất của tự thân các pháp gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Tánh Tự Tánh", "definition": "七種性自性 (Nhập Lăng Già Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Tịnh", "definition": "Thất chủng tịnh là bảy tướng thanh tịnh của Bồ Tát Sơ Địa, nguyện cầu về Tịnh Độ, bao gồm như sau:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Vô Thường", "definition": "Thất chủng vô thường là bảy món vô thường Kinh Lăng Già nói rằng tất cả luận thuyết ngoại đạo chủ trương có bảy vô thường và chúng không phải là Phật pháp bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Vô Thượng", "definition": "七種無上 (Bồ Tát Địa Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Xả", "definition": "Thất chủng xả là bảy món xả bỏ Tâm tánh bình đẳng không đem lòng nhớ mong, tịnh không giữ lấy, không mắc lấy. Đối với chúng sanh xả bỏ, rời bỏ tất cả sự ngăn ngại về người thân, hoặc kẻ thù oán. Xả bỏ tất cả các sự lầm lỗi, do tâm tham, sân, si, gây tạo. Thấy thân mạng thoát ra thì không còn lo nghĩ, tức là phóng xả vậy. Chứng được lý chơn không bình đẳng, rời khỏi các tướng. Tự mình bỏ các sự vui sướng của mình đem thí cho người khác. Việc gì có lợi ích cho chúng sanh thì để cho họ hưởng, mình đừng trông mong. Người tu đạo phải buông bỏ tất cả những vật chất bên ngoài, cả đến những tâm niệm điên đảo vọng động bên trong tâm thức, có như vậy mới tiến tu đạo nghiệp, mới có thể an vui giải thoát. Đức Thích Ca Mâu Ni tu hạnh xả này qua bao kiếp mới thành đạo Bồ Đề. Trong tiền thân của Ngài, từng xả bỏ thân mạng để cứu giúp chúng sanh. Kế đó Ngài đang làm Bồ Tát nơi cung trời Đâu Suất, Ngài xả bỏ các sự vui sướng nơi Thiên cung mà giáng sanh cứu thế. Lại trong khi làm Đông Cung Thái Tử sắp lên ngôi vua, Ngài xả bỏ tất cả đền đài cung viện, châu báu, vợ đẹp, con xinh, một mình ra đi mặc áo thô xấu ngồi trên núi tuyết mà tu khổ hạnh, cuối cùng Ngài thể nhập Đại Đạo, giác ngộ được quả vị Vô Thượng Bồ Tát, mọi phiền não hoặc nghiệp dứt sạch.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Chủng Đệ Nhất Nghĩa Cảnh Giới", "definition": "七種第一義境 界 (Nhập Lăng Già Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Định Danh", "definition": "七種定名 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Chủng Đức", "definition": "Là bảy món đức tánh của Phật tánh Như Lai. Trong Niết Bàn Kinh quyển 34 có dạy rằng cái Phật tánh của Phật Như Lai có bảy đức: Thường, lạc, ngã, tịnh, chơn, thật, thiện:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Cá Điều Chế Giới", "definition": "(七箇條制誡, Shichikajōseikai): Bảy Điều Răn Dạy của Pháp Nhiên Phòng Nguyên Không (法然房源空) đối với chúng đệ tử; còn gọi là Thất Cá Điều Khởi Thỉnh Văn (七箇條起請文). Kể từ khi Nguyên Không tuyên xướng nghĩa của Tịnh Độ Tông vào năm 1175 (An Nguyên [安元] nguyên niên) cho đến khi trước tác cuốn Tuyển Trạch Bổn Nguyện Niệm Phật Tập (選擇本願念佛集) vào năm 1198 (Kiến Cửu [建久] thứ 9), ông bắt đầu chính thức công bố xướng đạo; trong vòng 10 năm trường, môn hạ ông tạp lẫn những hạng vô trí bất thiện, bao gồm cả chư tăng của giáo đoàn Phật Giáo cũ; cho nên chân ý của Nguyên Không bị truyền thừa sai lạc khá nhiều; cuối cùng phải chịu hậu quả bị phê phán mãnh liệt từ phía Phật Giáo Nam Đô Bắc Lãnh. Vào tháng 10 năm 1204 (Nguyên Cửu [元久] nguyên niên), đồ chúng của Tỷ Duệ Sơn (比叡山, Hieizan) tố cáo lên Tọa Chủ Chơn Tánh (眞性), yêu cầu đình chỉ nhóm Chuyên Tu Niệm Phật. Trước tình huống đó, vào ngày mồng 7 tháng 11, đối với chúng môn đồ lấy hiệu là Niệm Phật Thượng Nhân (念佛上人), Nguyên Không đưa ra 7 điều răn dạy. Nếu ai phản lại những điều này, họ không phải là môn nhân, là quyến thuộc của ma, cấm không được vãng lai thảo am ở vùng Cát Thủy (吉水, Yoshimizu). Ngày hôm ấy, Nguyên Không và đệ tử có 80 người, đến ngày mồng 8 có 61 người, rồi đến ngày mồng 9 có thêm 49 người nữa, tổng cọng là 190 người cùng nhau ký tên vào cuối bản Thất Cá Điều Chế Giới này, và thệ nguyện bảo vệ những điều răn dạy của tôn sư. Nguyên bản hiện được bảo tồn tại Nhị Tôn Viện (二尊院), Kyoto. Có bản đề năm 1824 (Văn Chính [文政] thứ 7). Bản này được thâu lục vào Tịnh Độ Tông Toàn Thư (淨土宗全書) 9, phần Tông Điển Bộ 3 của Quốc Dịch Đại Tạng Kinh (國譯大藏經), Nhật Bản Cổ Điển Toàn Tập (日本古典全集), Pháp Nhiên Thượng Nhân Toàn Tập (法然上人全集) 6, Nhật Bản Tư Tưởng Đại Hệ (日本思想大系) 10.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thất Cách", "definition": "失格. Không đúng như điều đã ấn định Vụng về, sai lầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Câu Chi Phật", "definition": "Sapta-koṭi-buddha-matṛ (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Cú Nghĩa Luận", "definition": "Sapta-padarthi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Cưu Sào", "definition": "(室鳩巢, Muro Kyūsō, 1658-1734): Nho gia của phái Chu Tử Học, sống vào khoảng giữa thời Giang Hộ; tên là Trực Thanh (直清); tự Sư Lễ (師禮); thông xưng là Tân Trợ (新助); biệt hiệu Thương Lãng (滄浪); xuất thân Giang Hộ. Ban đầu, ông phục vụ cho Tiền Điền Cương Kỷ (前田綱紀, Maeda Tsunanori), Phiên chủ Phiên Gia Hạ (加賀藩, Kaga-han), rồi vâng mệnh vị này, ông lên kinh đô Kyoto học với Mộc Hạ Thuận Am (木下順庵). Vào năm 1711 (Chánh Đức [正德] nguyên niên), nhờ Tân Tỉnh Bạch Thạch (新井白石) suy cử, ông làm Nho quan cho chính quyền Mạc Phủ. Sau đó, ông làm chức quan Thị Giảng (侍講) cho Tướng Quân Đức Xuyên Cương Cát (德川綱吉, Tokugawa Tsunayoshi) và viết cuốn Lục Dụ Diễn Nghĩa Đại Ý (六諭衍義大意). Trong thời kỳ Phái Cổ Học bộc phát mạnh mẽ, ông đã tận lực giữ gìn Chu Tử Học và trước sau vẫn với tư cách là nhà Chu Tử Học nghiêm cẩn. Trước tác của ông có Tuấn Đài Tạp Thoại (駿台雜話), Xích Tuệ Mỹ Nhân Lục (赤穗美人錄), Hiến Khả Lục (獻可錄), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thất Cảnh Giới", "definition": "Thất cảnh giới còn gọi là Thất chủng đệ nhất nghĩa cảnh giới, là bảy cảnh giới nhất như của chư Phật và Bồ Tát đã chứng đắc đến tột cùng cứu cánh, bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Cấp Phù Đồ Tháp", "definition": "七 級 浮 圖 塔. Là tháp 7 tầng chùa Cực Lạc, thành phố Cáp Nhĩ Tân, tỉnh Hắc Long Giang, Trung Quốc, nên còn gọi “Thất cấp phù đồ tháp”. X. “Cực Lạc Tự Tháp”.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Cấu", "definition": "七垢 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Danh", "definition": "Ayasa (nam) (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thất Diệp Quật", "definition": "Sapta-parnaguha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Diệt Tránh", "definition": "Sapta-dhikarana-śamathā (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Diệt Tránh Giới", "definition": "Sapta-dhikkāraśamathā (P), Adhikāraśamathā (S, P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Diệt Tránh Pháp", "definition": "Bảy Phép Hòa Giải. “Diệt tránh” nghĩa là dập tắt sự tranh cãi, xung đột. Trong đời sống tập thể, nhiều khi có những ý kiến bất đồng về một vấn đề, khiến đưa tới xích mích, tranh cãi, làm mất đi cái không khí hòa hợp giữa đại chúng. Sự tranh cãi thường xảy ra khi hai hoặc nhiều người, trong lúc học tập chung, đã có những kiến giải khác nhau về cùng một vấn đề, hoặc không đồng ý với nhau về việc thực thi một biện pháp, một kế hoạch, và nhất là khi phải phán quyết hành vi của một vị nào đó là có tội hay vô tội, hoặc tội nặng hay tội nhẹ, hoặc người phạm tội không chịu nhận tội v. v... Để tránh xảy ra những trường hợp làm mất hòa khí như vậy, đại chúng thường áp dụng bảy biện pháp dập tắt sự tranh cãi (Thất Diệt Tránh Pháp) nhằm đem lại không khí hòa hợp cho tập thể. Tuy bảy biện pháp này thuộc về giới luật tì kheo và tì kheo ni, nhưng vì sự ích lợi rộng rãi và thiết thực, chúng có thể được đem áp dụng trong bất cứ một tăng thân tu học nào. Bảy biện pháp đó là:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Thất Gia", "definition": "室家. Nhà cửa Chỉ việc lập gia đình. Cũng nói là Gia thất. Truyện Lục Vân Tiên: “Cùng con gái lão xum vầy thất gia”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Già Tội", "definition": "Cũng gọi là Thất nghịch tội. 七遮罪 ( Phạm Võng Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Giác Chi", "definition": "Xem Thất Bồ Đề Phần.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Giác Chi - Thất Giác Ý - Thất Giác Phần - Thất Bồ Đề Phần", "definition": "Bảy Yếu Tố Giác Ngộ. Đây là bảy yếu tố tạo nên quả vị giác ngộ. Theo kinh Niết Bàn, bảy yếu tố này gồm có:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Thất Giác Phần", "definition": "七覺分 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Giác Phần Tam Muội", "definition": "Sapta-bodhyaṅga-samādhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Hiếu", "definition": "失孝. Không làm được hết lòng đối với cha mẹ. Truyện Lục Vân Tiên: “Cam bề thất hiếu đắng cay phận mình”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Hoa Bát Liệt", "definition": "七 花 八 裂. Còn gọi: Thất Điên Bát Đảo, Thất Chi Bát Tiết, Thất Linh Bát Lạc, Thất Ao Bát Đột.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Hải", "definition": "七海 (Pháp Tập Danh Số Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Học", "definition": "失學. Không được đi học từ lúc còn nhỏ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Hữu", "definition": "七有 (Trường A Hàm Thập Báo Pháp Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Không", "definition": "七空 (Nhập Lăng Già Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Kim Sơn", "definition": "七金山 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Kinh", "definition": "失驚. Rất sợ hãi, mất cả hồn vía. Đoạn trường tân thanh: “Thất kinh, nàng chửa biết là làm sao”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Kiến", "definition": "七見 (Hoa Nghiêm Khổng Mục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất La Phiệt Thành", "definition": "Xem Xá vệ.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Luật", "definition": "失律. Không giữ đúng cách thức làm thơ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Ly Phật Thệ", "definition": "S. Srivijaya. Vương quốc Phật giáo hùng mạnh, tồn tại ở Indonesia, cụ thể là ở đảo Sumatra (Palembang), từ thế kỷ thứ VII. Vào thời gian này, theo một tài liệu của du tăng Trung Hoa nổi tiếng Nghĩa Tịnh, các đảo quốc ở vùng Nam Hải, đều theo Phật giáo. Riêng ở Srivijaya đã có tập trung hơn 1.000 tăng sĩ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Lưu", "definition": "七流 (Hoa Nghiêm Khổng Mục)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Lạc", "definition": "失落. Mất mát rơi rụng, không tìm lại được.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Lập Đề", "definition": "Thất lập đề là bảy cách đặt tên. Đề tựa bộ Kinh, theo Tông Thiên Thai cho rằng tất cả các tên Kinh được cấu thành từ ba yếu tố tên người (nhơn), tên pháp (pháp), tên dẫn dụ (dụ) từ đó phân biệt ra bảy cách đặt tên:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Lậu", "definition": "七漏", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thất Lễ", "definition": "失禮. Đánh mất sự đối xử tốt đẹp với người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Lộc", "definition": "失祿. Mất các thứ trời cho, tức là chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Lỵ La", "definition": "Xem Xá Lợi.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Mạn", "definition": "Sept arrogances 七慢", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thất Nghiệp", "definition": "失業. Mất việc làm. Không có việc làm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Nghịch", "definition": "Sept fautes capitales 七逆", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thất Nghịch Tội", "definition": "Thất nghịch tội là bảy tội bội nghịch, bảy tội ác tâm, còn gọi là thất già tội, nghĩa là bảy tội ngăn bít bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Ngôn", "definition": "七言. Lối thơ mỗi câu có 7 chữ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Nhật Luân Xuất", "definition": "七日輪出 (Pháp Uyển Châu Lâm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Niêm", "definition": "失粘. Làm văn làm thơ mà sai về bằng trắc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Niệm", "definition": "Musita-smṛtita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Nạn", "definition": "七難 (Quán Âm Huyền Nghĩa Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Phu", "definition": "匹夫. Người đàn ông thấp kém. Truyện Lục Vân Tiên: “Uổng trang thục nữ sánh cùng thất phu”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Pháp Bất Khả Tị", "definition": "七法不可避 (Pháp Uyển Châu Lâm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Pháp Lạc", "definition": "Thất pháp lạc bảy pháp an lạc, làm cho tu sĩ bạn đồng tu, sanh tâm yêu mến:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Pháp Tài - Thất Thánh Tài", "definition": "Bảy Pháp Tài. “Pháp tài” là sự giàu có về tâm linh (khác với sự giàu có về vật chất), là của cải, vốn liếng tinh thần mà hành giả luôn luôn dùng làm hành trang trên suốt con đường tu học và phụng sự chúng sinh, cho đến khi đạt được quả vị giác ngộ. Có bảy thứ pháp tài:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Thất Phương Tiện Hay Thất Hiền", "definition": "七方便 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Phương Tiện Vị", "definition": "Địa vị Bảy phương tiện. Bảy phương-tiện tức bảy bậc Hiền thuộc tiến trình tu tập của hành giả tiểu thừa. Tất cả chúng sinh muốn đoạn trừ phiền não để giải thoát khỏi ba cõi, chứng nhập niết bàn, cần phải lấy bảy pháp môn làm phương tiện tu tập, đó là: ngũ đình tâm quán, biệt tướng niệm trú, tổng tướng niệm trú, noãn, đảnh, nhẫn, và thế đệ nhất. Tu tập bảy pháp môn phương tiện này sẽ đạt được địa vị gọi là Bảy-phương-tiện (Thất-phương-tiện vị), cũng gọi là địa vị Bảy-hiền (Thất-hiền vị), hay địa vị Bảy-gia-hạnh (Thất-gia-hạnh vị). Như vậy, địa vị này chỉ là gộp chung hai địa vị Ba-hiền (xem mục “Địa Vị Hiền”) và Bốn-thiện-căn (xem mục “Địa Vị Thiện Căn”); hay nói cách khác, tu tập viên mãn hai địa vị Ba-hiền và Bốn-thiện-căn, tức là đã hoàn tất địa vị Bảy-phương-tiện, thoát khỏi địa vị phàm phu, tiến lên địa vị thánh.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thất Phật", "definition": "七 佛 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Phật - Quá Khứ Thất Phật", "definition": "Bảy Đức Phật Đời Quá Khứ. 7 Đức Phật đời quá khứ gồm có Đức Phật Thích Ca Mâu Ni và 6 Đức Phật từng thị hiện trong thế gian trước đó: Phật Tì Bà Thi, Phật Thi Khí, Phật Tì Xá Phù, Phật Câu Lưu Tôn, Phật Câu Na Hàm Mâu Ni, và Phật Ca Diếp. Mỗi Đức Phật đều truyền lại một bài kệ, trong đó, bài kệ của Đức Phật Ca Diếp là được thông dụng nhất; Kinh Tăng Nhất A Hàm (Hán văn) ghi lại bài kệ ấy như sau:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Thất Phật Chân Thật Luận", "definition": "Tattva-saptati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Phật Phạn Tán", "definition": "Xem Thất Phật Tán Bái Già Bà Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Phật Tán Bái Già Bà Kinh", "definition": "Sapta-jinastava (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Sanh Tự", "definition": "(室生寺, Murō-ji): ngôi chùa trung tâm của Phái Thất Sanh Tự (室生寺派) thuộc Chơn Ngôn Tông, hiệu là Thất Sanh Sơn Tất Địa Viện (室生山悉地院), hiện tọa lạc tại Murō-mura (室生村), Uda-gun (宇陀郡), Nara-ken (奈良縣). Năm 681 (niên hiệu Thiên Võ [天武] thứ 10), thể theo ý nguyện của Thiên Võ Thiên Hoàng (天武天皇, Temmu Tennō), tương truyền Dịch Tiểu Giác (役小角, En-no-Ozunu) sáng lập ra chùa này. Trong khoảng thời gian niên hiệu Bảo Quy (寳龜, 770-780), Hiền Cảnh (賢璟, Kenkyō, 705-793) của Hưng Phước Tự (興福寺, Kōfuku-ji) quản lý chùa và đệ tử của ông là Tu Viên (修圓, Shūen, 771-835) kiến lập các ngôi đường tháp vào khoảng thời gian niên hiệu Thiên Trường (天長, 824-834). Vào năm 824 (niên hiệu Thiên Trường thứ 1), Không Hải (空海, Kūkai) đến chùa này, dâng cúng bảo châu Ma Ni và biến nơi đây thành đạo tràng của Chơn Ngôn Mật Giáo. Sao đó, Kiên Tuệ (堅慧, Kene) đến trú trì, làm cho chùa trở nên hưng thạnh, và chùa đã trãi qua một thời gian khá dài phụ thuộc vào sự quản lý của Hưng Phước Tự. Dưới thời đại Liêm Thương (鎌倉, Kamakura), các vị Luật tăng của Đường Chiêu Đề Tự (唐招提寺, Tōshōdai-ji) cũng như Tây Đại Tự (西大寺, Saidai-ji) đã từng đến trú trì ở đây. Đến thời đại Giang Hộ (江戸, Edo), vào năm 1694 (niên hiệu Nguyên Lộc [元祿] thứ 7), Hộ Trì Viện Long Quang (隆光, Ryūkō, 1649-1724) đến làm trú trì, cho nên chùa trở thành đạo tràng của Phái Phong Sơn (豐山) thuộc Chơn Ngôn Tông, và nhờ sự hiến cúng tịnh tài của Quế Xương Viện (桂昌院, mẹ của Tướng Quân Đức Xuyên Cương Cát [德川綱吉, Tokugawa Tsunayoshi]), các đường vũ của chùa được tu sửa lại hoàn chỉnh. Vào thời Cận Đại, Phái Phong Sơn tách riêng ra khỏi chùa và nơi đây trở thành ngôi chùa trung tâm của Phái Thất Sanh Tự. Khuôn viên chùa rất u nhã, người nữ bị cấm không được đến tham bái. Chùa chưa từng bị hỏa tai hay binh hỏa, cho nên các ngôi đường tháp vẫn còn giữ lại nét ngày xưa. Kim Đường (金堂) là kiến trúc được dựng vào đầu thời Bình An (平安, Heian), bên trong ở giữa thờ tượng đứng Thích Ca Như Lai, bên phải nhìn vào có tượng Dược Sư Như Lai và Địa Tạng Bồ Tát, bên trái có tượng Văn Thù Bồ Tát Và Thập Nhất Diện Quan Âm; tất cả đều những kiệt tác đầu thời Bình An. Ngoài ra, còn có tượng Thập Nhị Thần Tướng, thuộc thời đại Liêm Thương. Ngũ Trùng Tháp được kiến lập từ khoảng cuối thời đại Nại Lương (奈良, Nara) cho đến đầu thời Bình An. Chánh Điện là Quán Đảnh Đường (灌頂堂), tôn trí tượng Như Ý Luân Quan Âm (cuối thời Bình An). Ngự Ảnh Đường (御影堂) là Đại Sư Đường (大師堂), được kiến tạo dưới thời Liêm Thương. Bên cạnh đó, còn có Di Lặc Đường (彌勒堂), Hộ Ma Đường (護摩堂), Nhà Kho, v.v. Bảo vật của chùa có các tượng Phật trong Kim Đường, tượng ngồi Thích Ca Như Lai (đầu thời Bình An), tượng đứng Di Lặc Bồ Tát (thời đại Nại Lương), những pháp cụ Mật Giáo, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thất Sách", "definition": "失策. Sai lầm trong việc sắp đặt mưu kế.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Sư", "definition": "七 師. Đời Đường, thiền tăng Mễ Hòa Thượng còn được gọi là Thất sư. X. Mễ Hòa Thượng.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Sắc", "definition": "失色. Mất vẻ mặt bình thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Tai Nạn", "definition": "七災難 (Nhân Vương Hộ Quốc Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Thanh", "definition": "失聲. lạc giọng, tắt tiếng, vì kêu la lớn quá.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Thành Tựu", "definition": "Thất thành tựu là bảy điều thành tựu cao quí nhất, không gì hơn của các Đức Phật bao gồm như sau:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Thánh", "definition": "Thất thánh còn gọi là Thất trượng phu, Thất sĩ phu, Thất Thánh nhơn, Thất giả là chỉ cho bảy bậc Thánh thuộc hàng kiến đạo, từ giai vị tu đạo đến giai vị vô học đạo, trích theo nội dung Luận Câu Xá thì Thất Thánh gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Thánh Tài", "definition": "Seven riches.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Tháp Tự", "definition": "七 塔 寺. ở phố Bách Trượng, thành phố Ninh Ba, tỉnh Chiết Giang, Trung Quốc, bởi trước chùa có xây 7 tòa bảo tháp mà có tên, là một trong bốn đại tùng lâm ở Chiết Đông. Chùa được xây vào niên hiệu Đại Trung thứ 12 (858) đời Đường, đương thời do Quan tể Phần Ninh là Nhậm Cảnh Cầu bỏ nhà làm chùa, gọi là “Đông Tân Thiền Viện”, thỉnh Thiền Sư Tâm Cảnh chùa Thiên Đồng trụ trì. Niên hiệu Đại Trung Tường Phù thứ 1 (1008) đời Tống lại đổi tên là “Sùng Thọ Tự”. Vào đời Tống vùng Ninh Ba trên biển buôn bán phát đạt, Phật giáo thịnh hành, chùa nhờ gần thành nên hương khói ngày càng thịnh. Niên hiệu Hồng Vũ thứ 20 (1387) đời Minh, bởi trên biển không yên ổn, Dương Hòa mới đem tăng chúng chùa Phổ Đà và tượng Phật Quán Âm đến chùa này, thờ tượng Quán Âm nơi Đại hùng bảo điện, và đổi tên chùa là “Bổ Đà Tự” cũng gọi “Tiểu Phổ Đà”, “Nam Hải Phổ Đà”. Niên hiệu Khang Hy thứ 21 (1682) đời Thanh, ở trước chùa xây 7 tòa bảo tháp bèn đặt tên là “Thất Tháp Tự”. Niên hiệu Quang Tự thứ 16 (1890) do Từ Viễn Trường Chí trụ trì, sửa sang chùa chiền, thiền tăng tụ hội. Năm thứ 20 (1894) ban tấm biển “Thất Tháp Báo Ân Tự”. Năm Dân Quốc trở đi, truyền giới giảng kinh, kiến thiết Tàng kinh lâu, lập Phật học viện, đại chấn tông phong Lâm Tế. Tự viện hiện giữ gìn hoàn hảo, có Thiên vương điện, Đại hùng bảo điện, Đại thánh điện, Ngọc Phật điện, Phương trượng viện. Trong chùa còn có tháp Thiền Sư Tâm Cảnh xây vào niên hiệu Hàm Thông thứ 14 (873) đời Đường, hai chiếc chuông đồng đời Tống, 500 họa tượng La hán đời Thanh.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Thân", "definition": "失身. Để mất thân mình, chỉ người con gái đánh mất sự trong sáng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Thông Bát Đạt", "definition": "七 通 八 達. Mô tả cách ngộ triệt để rõ ràng, Vận dụng thông suốt không chướng ngại. Tiết Lặc Đàm Thiện Thanh Thiền Sư trong NĐHN q. 7 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Thù Thắng", "definition": "Thất thù thắng là bảy chỗ thù thắng trong cơ thể con người bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Thường", "definition": "失常. Mất sự đều đặn hàng ngày.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Thường Trụ Quả", "definition": "七常住果 (Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Thập Không Tính Luận", "definition": "Śūnyatāsapati (S), Śūnyatāsapativṛtti (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Thắng Giả Tán", "definition": "Xem Thất Phật Tán Bái Già Bà Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Thế", "definition": "失勢. Mất chỗ nương tựa, không còn ở địa vị cũ. Thơ Nguyễn Bỉnh Khiêm: “Thất thế hương lư ngoảnh mặt đi”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Thố", "definition": "失措. Bối rối lúng túng, khiến hành động sai lầm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Thủ", "definition": "失守. Để mất, không giữ được nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Thức Trụ", "definition": "七識住 (A Tỳ Đàm Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Tiết", "definition": "失節. Không giữ được sự ngay thẳng thuỷ chung.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Tri", "definition": "Cũng gọi là Đại Thừa thất trượng phu 七知 (Niết Bàn Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Trung Bách Vấn", "definition": "室 中 百 問. X. Thùy Ngữ Bách Tắc.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Truyền", "definition": "失傳. Không còn lưu lại đời sau nữa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Trân", "definition": "(七珍): hay Thất Bảo (七寶), tức là 7 loại trân bảo quý giá của thế gian. Các kinh điển giải thích về 7 loại trân bảo này có khác nhau, như A Di Đà Kinh (阿彌陀經), Đại Trí Độ Luận (大智度論) quyển 10, v.v., giải thích Thất Bảo là:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thất Trùng Hàng Thọ", "definition": "(七重行樹): bảy lớp hàng cây, từ xuất hiện trong A Di Đà Kinh (阿彌陀經). Con số 7 ở đây chỉ cho các phương Đông, Tây, Nam, Bắc, trên, dưới và ở giữa; thể hiện ý nghĩa viên mãn. Theo Đại Sư Ngẫu Ích Trí Húc (蕅益智旭, 1599-1655) nhà Minh giải thích trong A Di Đà Kinh Yếu Giải (阿彌陀經要解, 1 quyển, Taishō No. 1762), là “Thất trùng biểu thất khoa đạo phẩm (七重表七科道品, bảy lớp biểu thị cho bảy khoa đạo phẩm).” Như vậy, Thất Khoa Đạo Phẩm ở đây là 37 Phẩm Trợ Đạo, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thất Trảm Sớ", "definition": "七斬疏. Tên tờ tâu vua của Chu Văn An, danh sĩ đời Trần, xin chém bảy người quyền thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Trần", "definition": "Trong Phật giáo có nói lục trần, chứ chẳng nói thất trần, tức lục trần thêm trần thứ bảy kêu là thất trần, vậy thất trần là tiếng chỉ việc vô lý, chuyện chẳng có thể xảy ra như qui mao ( lông rùa ), thố giác ( sừng thỏ ) vậy.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Trục", "definition": "(七軸): bảy quyển, như trong bài kệ xưng tán Pháp Hoa Kinh có câu: “Lục vạn dư ngôn thất trục trang, vô biên diệu nghĩa quảng hàm tàng (六萬餘言七軸裝、無邊妙義廣含藏, hơn sáu vạn lời thành bảy quyển, vô biên nghĩa mầu rộng hàm tàng).” Hay trong Cổ Lâm Thanh Mậu Thiền Sư Thập Di Kệ Tụng (古林清茂禪師拾遺偈頌, CBETA No. 1413) quyển Hạ cũng có câu: “Thất trục Liên Kinh lục vạn ngôn, Linh Sơn nhất hội thượng y nhiên, hoàng kim tự hữu hoàng kim giá, bảo sở phân minh tại mục tiền (七軸蓮經六萬言、靈山一會尚依然、黃金自有黃金價、寶所分明在目前, bảy quyển Liên Kinh sáu vạn lời, Linh Sơn nhất hội vẫn muôn đời, vàng ròng vốn có vàng ròng giá, chỗ báu rõ ràng trước mắt mình).”", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thất Tài", "definition": "七財 (Thập Tụng Luật và Vị Tằng Hữu Nhân Duyên Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Tán", "definition": "失散. Tan vỡ mất mát.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Tình", "definition": "Seven sentiments.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Tình Lục Dục", "definition": "七情六欲", "source": "Phat Hoc - Chua Van Hanh - Phap"}
{"term": "Thất Tín", "definition": "失信. Sai hẹn, đánh mất lòng tin của người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Tông", "definition": "Shichi-shū (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Tùy Miên", "definition": "Còn gọi là Thất Sử .七隨眠 (A Tỳ Đạt Ma Tỳ Bà Sa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Tịch", "definition": "七夕. Đêm mồng 7 tháng 7 âm lịch, tương truyền là đêm Ngưu lang Chức nữ gặp nhau.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Tịnh Hoa", "definition": "七淨華 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Tổ", "definition": "Seven patriarches, tarab dun (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Tụ", "definition": "七聚 (Phiên Dịch Danh Nghĩa)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Viên Mãn", "definition": "Thất viên mãn là bảy uy đức tròn đầy của pháp thân Phật nên còn gọi là thất chủng uy đức, thất chủng uy đức bao gồm:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Vô Tận", "definition": "Saptaksara (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Vọng", "definition": "Xem Gian truân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Xuyên Bát Huyệt", "definition": "七 穿 八 穴. Còn gọi: Thất Huyệt Bát Xuyên, Thất Tung Bát Hoành, Thất Xuất Bát Một, Thất Thông Bát Đạt. Đại triệt đại ngộ. Tắc 6, Bích Nham Lục (Tục 117,135 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Xuất Bát Một", "definition": "七 出 八 沒. Mô tả cách ngộ triệt để, vận dụng không bị chướng ngại. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thất Xứ Trừng Tâm", "definition": "七處徵心 (Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Ý", "definition": "失意. Không được vừa lòng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Điên Đảo", "definition": "Bảy Cái Thấy Điên Đảo. “Điên đảo”, nói tắt là “đảo”, có nghĩa là đảo lộn sự thật, trái ngược với sự thật. Người phàm phu vì không có trí tuệ nên đối với mọi sự lí ở đời, luôn luôn có 7 tư tưởng điên đảo như sau:", "source": "Phap So Can Ban - Cs Hanh Co"}
{"term": "Thất Đại", "definition": "七大 (Lăng Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thất Đại Sư", "definition": "Seven Masters.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thất Đạo", "definition": "Thú là cõi, đạo là đường thác sanh. Thông thường sách Phật nói: Sáu cõi (lục đạo hay lục thú) trong đó chúng sanh luân hồi sanh tử cho đến khi đoạn hết nghiệp, giải thoát và Niết Bàn, sáu cõi đó là: 1. Thiên: Trời", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Đức", "definition": "失徳. Làm mất điều tốt đẹp được hưởng về sau Trái với nết tốt. Xấu xa.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thất Đức Tánh", "definition": "Thất đức tánh là bảy món đức tánh của người tịnh giới cụ túc bao gồm: Chẳng hòa hiệp với nữ nhơn (phạm tội xác thịt) Chẳng diễu cợt cười giỡn với nữ nhơn Chẳng lóng nghe những tiếng đụng chạm đồ trang sức, cùng chẳng nghe những tiếng nói trong phòng đàn bà. Chẳng vui thích khi thấy người nam theo sát người nữ, hoặc người nữ theo sát người nam. Chẳng có ý muốn sanh lên cảnh Tiên mà vui hưởng ngũ dục lạc. Chẳng vì giới, giới Ba la mật, quả Bồ Đề Niết Bàn của Thinh Văn và A La Hán mà trì tịnh giới. Ví tối thượng đề nhất nghĩa, tức chỉ vì lẽ thành Phật nên hộ trì cấm giới vậy (Niết Bàn Kinh quyển 31) Đối với bậc Tịnh giới cụ túc, là bậc giới hạnh trong sạch được trọn vẹn, không phạm một điều nào trong giới cụ túc, dầu bằng thân, bằng miệng hay bằng ý tưởng. Người tịnh giới cụ túc lại nghĩa là: Giữ đại dâm giới một cách trọn vẹn hoàn toàn, chẳng những không giao thiệp với người khác phái, cho đến tâm tưởng không móng một sự vui gì trong ngũ dục, chính vì Tịnh giới như thế nên hành giả có đủ bảy đức tánh trên mà trong Kinh Niết Bàn nói rõ.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thất Ước", "definition": "失約. Sai hẹn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấu", "definition": "嗽. Ho (bệnh về hô hấp bất thường).", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấu Hiểu", "definition": "Abhisameti (abhi + saṃ + i + a), abhisamaya (nam), vijānāti (vi + jā + nā), vijānana (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấu Ly Vi", "definition": "透 離 微. Thoát khỏi hai phần đối lập ly (thể) và vi (dụng), cũng chính là kết hợp thể và dụng làm một. Như Tịnh Ngữ Lục q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấu Qua", "definition": "Nibbetha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấu Quan", "definition": "透 關. Vượt qua cửa ải thiền ngộ. Như Tịnh Ngữ Lục q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấu Quan Nhãn", "definition": "透 關 眼. Tầm nhìn xuyên thấu cửa ải thiền cơ, chỉ pháp nhã. Thị Tâm Nguyên Tụ Duy Na trong DTNL q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấu Rõ", "definition": "Bujjati (budh + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấu Tam Quan", "definition": "透 三 關. Vượt qua ba cảnh giới tham thiền từ thấp lên cao.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấu Thoát", "definition": "透 脫. 1. Siêu thoát. Uyển Lăng Lục ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấu Triệt", "definition": "Prativedha (S), Attainment Paṭivedha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thấu Tổ Sư Quan", "definition": "透 祖 師 關. Vượt qua cửa ải thiền cơ của Tổ sư, chỉ cho việc khế hợp, lãnh ngộ thiền pháp của Tổ sư. Pháp Diễn Ngữ Lục q. thượng ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thấu Đáo", "definition": "透到. Tới được Biết tới nơi tới chốn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thấy", "definition": "Samanupassati (saṃ + anu + dis + e), passati (dis + a), paṭidissati (dis + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấy Như Thật", "definition": "Yathābhūtaṁnanadarśana (S), Knowing or seeing as they are.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thấy Rõ", "definition": "Atipassati (ati + dis + a)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thấy Tánh", "definition": "Tức là thấy tất cả chúng sinh vốn có đầy đủ Phật tánh; tánh đó tức là Phật, cho nên gọi là “Phật tánh”. Người thấy được Phật tánh nơi chính mình thì ngay tức khắc cùng với chư Phật không khác; nhà thiền gọi đó là “thấy tánh thành Phật”. (Xem thêm mục “Kiến Tánh”.)", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thấy Được", "definition": "Sandissati (saṃ + dis + ya), padissati (pa + dis + ya)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầm", "definition": "忱. Thành thật.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần", "definition": "Shen (C), Spirit, Tiglī (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Biến", "definition": "Vikurvana (S), Iddhi (P), Wondrous gift, Ṛddhi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Biến Gia Trì", "definition": "Vikrinitadhista (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Bí", "definition": "神秘. Thiêng liêng khó hiểu.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Chiếu", "definition": "神 照 (776-838). Thiền tăng đời Đường, họ Trương, người Thanh Thành Thục Châu (huyện Quán, Tứ Xuyên) Trung Quốc. Sư nối pháp thiền sư Trí Như ở chùa Thánh Thiện tại Đông Đô, thuộc tông Hà Trạch đời thứ 4, trụ trì chùa Phụng Quốc ở Đông Đô. Hiệu: Văn Từ Thiền Sư. Tác phẩm: Thần Chiếu Đại Sư Quảng Lục.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Chiếu Đại Sư", "definition": "神 照 大 師. Hiệu của Thiền tăng Pháp Chân sống vào đời Đường. X. Pháp Chân.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Châu", "definition": "Deha (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Chủ", "definition": "神主. Bài vị viết tên người chết để thờ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Công", "definition": "神工. Việc làm của thần, người không làm nổi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Cơ", "definition": "(神機): có hai nghĩa chính.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Diệu", "definition": "神妙. Tài giỏi khéo léo vượt hẳn người thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Duệ", "definition": "(神叡, Shinei, ?-737): vị tăng của Pháp Tướng Tông Nhật Bản, sống dưới thời Nại Lương, húy Thần Duệ (神叡), thông xưng là Phương Dã Tăng Đô (芳野僧都), xuất thân nhà Đường (Trung Quốc, ?). Ông theo hầu Nghĩa Uyên (義淵, Gien) ở Long Cái Tự (龍蓋寺) vùng Đại Hòa (大和, Yamato), thông hiểu cả Pháp Tướng, Duy Thức và Tam Luận. Vào năm 693, ông theo sứ sang Tân La (新羅, Shiragi, Triều Tiên). Sau khi trở về nước, ông trú tại Nguyên Hưng Tự (元興寺, Gankō-ji), đến năm 717 thì làm Luật Sư, danh tiếng vang khắp cùng với Đạo Từ (道慈, Dōji) ở Đại An Tự (大安寺, Daian-ji). Năm 729, ông được thăng chức Thiếu Tăng Đô, và tương truyền ông có sự cảm ứng của Hư Không Tạng Bồ Tát tại Hiện Quang Tự (現光寺, Genkō-ji) vùng Cát Dã (吉野, Yoshino). Ông được kính ngưỡng như là một trong 6 vị tổ của Pháp Tướng Tông Nhật Bản.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Dân", "definition": "臣民. Người bề tôi và mọi người trong nước, tức quan và dân Chỉ chung mọi người trong nước có vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Dược", "definition": "神藥. Thuốc cực hay, trị dứt bệnh mau chóng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Giao", "definition": "神交. Dùng phần vô hình thiêng liêng của con người mình mà tiếp xúc trao đổi ý nghĩ với người khác.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Giáo", "definition": "Xem Thần Đạo.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Hôn", "definition": "晨昏. Sángvà chiều Chỉ bổn phận con cái đối với cha mẹ, nói tắt của Thần tỉnh hôn định, hoặc Thần hôn định tỉnh (sớm chiều thăm hỏi sức khoẻ của cha mẹ). Đoạn trường tân thanh: “Nghe chim như nhắc tấm lòng thần hôn”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Hạ", "definition": "臣下. Kẻ bề tôi ở dưới. Tiếng vị quan tự xưng trước vua.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Hải Lộ", "definition": "Xem A Tu Vân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Học", "definition": "Theology.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Hộ Thủ", "definition": "Prajpati (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Hộ Tự", "definition": "(神護寺, Jingo-ji): ngôi chùa của Chơn Ngôn Tông Cao Dã Sơn, hiện tọa lạc tại Sakyō-ku (左京區), Kyōto-shi (京都市). Tiền thân của chùa này là Cao Hùng Sơn Tự (高雄山寺, Takaosan-ji), do dòng họ Hòa Khí (和氣, Waki) sáng lập nên vào khoảng năm 784 khi Trường Cương Kinh (長岡京) dời đô. Trước và sau khi Tối Trừng (最澄, Saichō) sang nhà Đường cầu pháp, Hòa Khí Quảng Thế (和氣廣世) đã từng cung thỉnh ông đến chùa này để thuyết giảng Kinh Pháp Hoa cũng như mở Đàn Quán Đảnh. Vào năm 806 (niên hiệu Đại Đồng [大同] nguyên niên), sau khi trở về nước, Không Hải (空海, Kūkai) cũng tiến hành lễ Quán Đảnh của hai bộ Thai Tạng tại chùa này; sự việc Tối Trừng và đệ tử ông đăng đàn thọ pháp Quán Đảnh được ghi lại trong cuốn Quán Đảnh Lịch Danh (灌頂歷名) do chính tay Không Hải viết. Đến năm 824 (niên hiệu Thiên Trường [天長] nguyên niên), Hòa Khí Thanh Ma Lữ (和氣清麻呂, Waki-no-Kiyomaro, 733-799) dời Thần Nguyện Tự (神願寺) đến Cao Hùng Sơn Tự, lấy tên là Thần Hộ Quốc Tộ Chơn Ngôn Tự (神護國祚眞言寺, Jingokokusoshingon-ji, gọi tắt là Thần Hộ Tự), trở thành ngôi chùa được cấp ngạch của triều đình và là đạo tràng trấn hộ quốc gia. Tượng thờ chính, Dược Sư Như Lai, ở Kim Đường rất nghiêm nghị, là tượng Phật có đặc trưng của nền văn hóa đầu thời Bình An (平安, Heian). Trong hai lần chùa bị hỏa hoạn vào năm 994 (niên hiệu Chánh Lịch [正曆] thứ 5) và 1149 (niên hiệu Cửu An [久安] thứ 5), may thay tượng Phật vẫn còn nguyên vẹn; nhưng cảnh quan của chùa thì bị suy tàn. Vào mùa Thu năm 1168 (niên hiệu Nhân An thứ 3), đau xót trước trước cảnh điêu tàn của chùa khi đến viếng thăm, Văn Giác (文覺, Bunkaku) có dâng lời thỉnh cầu Hậu Bạch Hà Viện (後白河院) hỗ trợ phục hưng chùa, nhưng thất bại. Đến năm 1182 (niên hiệu Thừa An [承安] thứ 3), được sự trợ duyên của Tướng Quân Nguyên Lại Triều (源賴朝, Minamoto-no-Yoritomo), mục đích phục hưng chùa được hoàn thành. Quần thể kiến trúc hiện tồn có Đại Sư Đường (大師堂, còn gọi là Nạp Lương Phòng [納涼房]) được tái kiến dưới Thời Đại Đào Sơn (桃山時代, Momoyama-jidai); Tỳ Sa Môn Đường (毘沙門堂), Ngũ Đại Đường (五大堂), Minh Vương Đường (明王堂), Lầu Chuông, Kim Đường (金堂), Tháp Đa Bảo (多寳塔). Quốc bảo của chùa có các tượng Nguyên Lại Triều, Bình Trùng Thạnh (平重盛, Taira-no-Shigemori), Đằng Nguyên Quang Năng (藤原光能, Fujiwara-no-Mitsuyoshi), Thích Ca Như Lai, Dược Sư Như Lai, Ngũ Đại Hư Không Bồ Tát (五大虛空菩薩), đồ hình Lưỡng Giới Mạn Trà La (兩界曼茶羅, còn gọi là Cao Hùng Mạn Trà La [高雄曼茶羅]), danh sách Quán Đảnh (thủ bút của Không Hải), Tứ Thập Ngũ Cá Điều Khởi Thỉnh Văn (四十五箇條起請文) của Văn Giác, Phạn Chung, v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Hội", "definition": "(668-760): là một trong những vị đệ tử lớn của Lục Tổ Tuệ Năng. Ngài họ Cao, quê ở huyện Tương-dương, tỉnh Hồ-bắc. Thuở nhỏ học Nho, Đạo, thông suốt Ngũ Kinh, Lão Trang và các sách sử, nhưng rồi bỏ hết, vào chùa xin xuất gia, đọc tụng kinh điển cũng dễ dàng như đọc sách Nho, Lão. Năm 13 tuổi, ngài đến xin tham yết Lục Tổ Tuệ Năng, trở thành người đệ tử nhỏ tuổi nhất, nhưng đắc pháp ngang hàng với các vị lớn tuổi khác. Khi Lục Tổ thông báo ngày giờ nhập tịch sắp đến, trong chúng ai cũng xúc động khóc thương, chỉ có Thần Hội là bất động, nên Tổ nói: “Thì ra chỉ có Thần Hội, người nhỏ nhất mà được cái tâm vui buồn bất động…” Sau khi đức Lục Tổ thị tịch (năm 713), ngài đi tham phỏng bốn phương. Năm 720, ngài phụng sắc vua, về trú trì chùa Long-hưng ở Nam-dương, xiển dương thiền pháp. Trong thời gian 20 năm sau khi Lục Tổ viên tịch, dòng thiền Tào Khê có vẻ như chìm lắng; trong khi đó, dòng thiền Thần Tú thì vẫn thịnh hành ở hai kinh đô Lạc-dương và Trường-an. Thấy thế, vào năm 732, ngài đến Lạc-dương thiết lập đại hội Vô-già, cực lực hiển dương tông phong của Lục Tổ, xác lập hệ thống thiền Nam-tông Tuệ Năng là dòng truyền thừa chính thống, phân rõ Nam - Bắc, đốn - tiệm, làm cho dòng thiền Nam-tông từ đó ngày càng lớn mạnh, đặt được địa vị vững vàng ở phương Bắc, còn dòng thiền Bắc-tông thì bị suy yếu dần. Trong thời gian An Lộc Sơn nổi loạn (755-757), ngài lập đàn tràng gây quĩ ủng hộ quân lính triều đình. Sau khi dẹp yên giặc loạn, vua Đường Túc-tông (756-762) thỉnh ngài nhập cung để cúng dường. Nhà vua cũng lập thiền viện ở chùa Hà-trạch (trong kinh thành Lạc-dương), mời ngài trú trì để giáo hóa đồ chúng. Tại đây ngài tiếp tục phát dương thiền phong của Lục Tổ Tuệ Năng, sáng lập tông Hà Trạch, được người đời gọi là Hà Trạch đại sư. Ngài thị tịch năm 760, thế thọ 93 tuổi, thụy hiệu là Chân Tông đại sư. Năm 796, vua Đường Đức-tông (780-805) triệu tập các thiền sư khắp nước để xác lập tông chỉ thiền môn, và lập thiền sư Thần Hội làm vị tổ thứ bảy của Thiền Tông Trung-quốc, nhưng vị trí ấy của ngài đã không được đời sau thừa nhận; rốt cuộc, Thiền Tông Trung-quốc chỉ có 6 vị tổ mà thôi. Tông Hà Trạch của ngài kéo dài khoảng 150 năm thì trầm một.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thần Hội Hòa Thượng Di Tập", "definition": "會 和 尚 遺 集. Gọi đủ: Hồ Thích Hiệu Đôn Hoàng Đường Tả Bản Thần Hội Hòa Thượng Di Tập. Sách, 4 quyển, do học giả cận đại là Hồ Thích biên, được Thư viện Á Đông tại Thượng Hải ấn hành vào năm 1930. Hồ Thích sưu tập trong văn hiến Đôn Hoàng các tư liệu về Thần Hội và thêm phần đối chiếu hiệu đính với các sách khác như: Cảnh Đức Truyền Đăng Lục, Tống Cao Tăng Truyện. Riêng có 4 bài bạt, 1 thiên Thần Hội Truyện, phụ lục 1 quyển (tức là 3 bài Thần Hội Ngữ Lục trong Cảnh Đức Truyền Đăng Lục quyển 28). Còn phụ phần trình bày và phân tích về tư tưởng, dấu vết hoạt động, tác phẩm của Thần Hội.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Kim Cương", "definition": "Vajra god.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Kinh", "definition": "神京. Nơi vua đóng đô. Bản dịch Chinh phụ ngâm khúc: “Tiếng khải ca trở lại thần kinh”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Kì", "definition": "神奇. Thiêng liêng lạ lùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Kì Quan", "definition": "(神祇官, Jinkikan, Kamuzukasa, Kamizukasa): (01) Tên gọi một cơ quan quốc gia được thiết lập theo Luật Lịnh Chế thời cổ đại. Từ Thần Kì (神祇) ở đây, Thần (神) tức là Thiên Thần (天神); Kì (祇) là Địa Kì (地祇); cho nên theo Luật Lịnh Chế thời xưa thì Thần Kì Quan là vị quan chuyên trách việc cúng tế Thiên Thần và Địa Kì, quản lý chung các đền thờ Thần Xã trên toàn quốc. Vị này có địa vị trên các chức quan, thậm chí trên cả Thái Chính Quan (太政官), người lo việc hành chính. Tứ Đẳng Quan (四等官) gồm Bá (伯), Phó (副, Đại Phó [大副] và Thiếu Phó [少副]), Hữu (佑, Đại Hữu [大佑] và Thiếu Hữu [少佑]) và Sử (史, Đại Sử [大史] và Thiếu Sử [少史]). Tuy nhiên, trên thực tế thì chức Thần Kì Quan nằm dưới Thái Chính Quan. (02) Tên gọi một cơ quan quốc gia được thiết lập vào đầu thời Minh Trị (明治, Meiji, 1868-1911). Vào tháng 4 năm 1868 (Khánh Ứng [慶應] 4) nhuận, thể theo Chính Thể Thư (政体書), Thần Kì Quan được chính thức thiết lập; là cơ quan chưởng quản các sự việc liên quan đến tế tự, Thần Kì, chúc từ, v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Linh", "definition": "神靈. Thiêng liêng mầu nhiệm Vị thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Linh Học", "definition": "Spiritism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Lộc", "definition": "神 祿. 1. Thiền tăng đời Ngũ Đại, nối pháp Thiền Sư Huyền Sa Sư Bị. Khi ra hoằng pháp sư trụ viện Vĩnh Hưng tại núi Liên Hoa, Phúc Châu, thiền tăng bốn phương tụ về. Mân Vương từng mời sư khai đường thuyết pháp. 2. Thiền tăng đời Tống (872-976), người xứ Phúc Châu. Sư thờ Thiền Sư Thụy Nham Sư Ngạn làm thầy, lâu ngày sư xin làm thị giả để báo đáp ân đức của Ngài. Sau khi thầy tịch, sư khai sơn lập viện Thụy Phong ở Ôn Châu (nay thuộc Chiết Giang), người học đến nương tựa, đạo đức vang xa.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Lực", "definition": "Ṛddhibala (S), Ṛddhi (S), Iddhi (P), Adhitiṣṭhati (S), Iddhibala (P), Bindhu (S), tiglī (T).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Minh", "definition": "神明. Thiêng liêng sáng suốt. Vị thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Miếu", "definition": "神廟. Đền thờ thần.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Mộng", "definition": "神夢. Giấc mơ do vị thần báo cho biết. Đoạn trường tân thanh: “Vả trong thần mộng mấy lời”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Nghi", "definition": "神 宜 (?-1216). Thiền tăng đời Lý, thuộc dòng Vô Ngôn Thông đời thứ 13, nối pháp Thiền Sư Thường Chiếu. Sư họ Quách, quê ở Ngoại Trại (nay thuộc tỉnh Hà Tây), miền Bắc Việt Nam. Sau khi Thường Chiếu tịch, sư về trụ trì chùa Thắng Quang làng Thị Trung, Kim Bài. Nơi đây, sư diễn hóa tông thừa, đồ chúng theo học rất đông. Đến ngày 18 tháng 2 năm Bính Tý, nhằm niên hiệu Kiến Gia thứ 6 (1216) đời Lý Huệ Tông, sư gọi đệ tử là ẩn Không đến, lấy Chiếu Đối Bản và Nam Tông Tự Pháp Đồ của Thường Chiếu trao cho rồi dặn: “Hiện nay loạn lạc, người khéo giữ bản đồ này, cẩn thận đừng để cho binh lửa làm hoại, ắt là Tổ phong của ta không mất vậy”. Nói xong, sư tịch. Theo: Thiền Sư Việt Nam của HT. Thanh Từ.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Ngã", "definition": "Puruṣa (S), Purisa (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Ngôn", "definition": "Atharva-veda (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Nông", "definition": "神農. Vị vua thời tối cổ, dạy dân làm ruộng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Phục", "definition": "臣服. Xin theo làm bề tôi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Quan", "definition": "(神官, Shinkan): với tư cách là quan lại của quốc gia, đây là người phụng sự cho vị Thần nào đó, hay người phụng chức ở các nơi tế tự Thần. Hiện tại, ở Nhật không còn hiện hữu chức Thần Quan nẫy nữa. Trong các thư tịch xưa liên qua đến Thần Đạo của Nhật Bản, đây là từ thỉnh thoảng có thấy vài nơi, dùng để chỉ cho Thần Chức (神職, người chuyên lo việc tế tự của Thần Xã), và hiện tại vẫn được dùng trong ngôn ngữ thường ngày. Vào đầu thời Minh Trị (明治, Meiji, 1868-1911), khi chức Thần Kì Quan (神祇官) được tái thiết lập, tất cả Thần Chức đều trở thành quan lại. Sau trận bại chiến của Nhật trong cuộc Chiến Tranh Đại Đông Á, chức Thần Quan đã bị phế bỏ.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Quang", "definition": "(神光): có mấy nghĩa khác nhau.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Quang Tự", "definition": "神 光 寺. Còn gọi: Chùa Keo. Chùa ở làng Dũng Nghĩa, huyện Giao Thủy, tỉnh Thái Bình, Việt Nam. Chùa khởi dựng vào đầu thế kỷ XVII, đã qua nhiều lần xây dựng lại, đợt trùng tu lớn nhất quyết định hình thức của chùa Keo lại ở vào thời kỳ gần một thế kỷ sau (năm 1707). Sử chép rằng, đã có một ngôi chùa Keo cổ sơ, ra đời từ thời Lý Thánh Tông ở ven sông Hồng. Khuôn viên chùa rất rộng, diện tích tới 5,7ha, chỗ đặt các công trình chính dọc 300m, ngang l25m. Có đến 15 thành phần công năng tạo thành quần thể kiến trúc: cột cờ, sân lát đá, tam quan ngoài, ao trước chùa, tam quan trong, sân đất, chùa Hộ, chùa Phật, sân gạch, tòa Giá Roi, tòa Thiêu Hương, tòa Phục Quốc, tòa Thượng Điện, gác chuông, nhà Tổ, ngoài ra là hai dãy hành lang chạy dài hai bên từ chùa Hộ trở vào. Chùa hiện nay còn 107 gian (gác chuông tính một gian), trước đây có 154 gian. Trình độ tổ chức không gian ở đây “phức tạp một cách trật tự” theo kiểu “Tiền Phật hậu Tổ: khu chùa phía trước và khu đền thờ Thiền Sư Không Lộ phía sau tách khỏi nhau. Các đơn thể kiến trúc, những thành phần, chi tiết và hình thức của chúng, cách dùng gỗ lim, nghệ thuật điêu khắc, màu sắc… rất độc đáo. Đặc biệt gác chuông chùa Keo là một kiệt phẩm kiến trúc mỹ thuật vô giá, một công trình kết cấu gỗ 3 tầng, cao 12m, vừa gây được ấn tượng đồ sộ, vừa có nhịp điệu và chi tiết hài hòa: trong cái nguy nga vẫn có phần đầm ấm, trong cái cốt cách vươn lên vẫn có cái phong thái khoan thai trầm lắng rất Việt Nam. Theo: VHVNTH 1989-1995.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Sinh Phốc - Thiệt Sinh Mao", "definition": "生 醭 舌 生 毛. Môi miệng lên meo, cái lưỡi sinh mốc. Từ hình dung tình trạng tịnh khẩu rất lâu. Tiết Khai thị Duy Na trong Duy Tắc Ngữ Lục q. 3 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Sát", "definition": "(神煞): hay Thần Sát Tinh (神煞星), là tên gọi những ngôi sao chiếu mạng quyết định việc tốt xấu của con người. Một số sao Thần Sát thường dùng như:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Sắc", "definition": "神色. Tinh thần và vẻ mặt.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Tham Mộ Thỉnh", "definition": "晨 參暮 請. Sớm thưa chiều hỏi. Vào lúc sáng sớm hoặc khi chạng vạng, chư tăng vào phương trượng của Hòa Thượng để tham bái, thỉnh ích. Là luật lệ hằng ngày trong tự viện. Bích Nham Lục q. 1 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Thanh", "definition": "(神 清, Shinsei, ?-820): vị tăng sống dưới thời nhà Đường, người vùng Xương Minh (昌明, thuộc Chương Minh, Tứ Xuyên), họ Chương (章), tự Linh Dữu (靈庾). Lúc nhỏ ông học Nho điển, nghe nhiều, nhớ kỹ, rất rành về thi văn, sau lớn lên xuất gia ở Khai Nguyên Tự (開元寺) vùng Miên Châu (緜州, thuộc Miên Dương, Tứ Xuyên), chuyên tâm nghiên cứu kinh luận. Về sau ông vào làm việc trong Đại Nội, rất được đãi ngộ. Đến cuối đời ông từ chức trở về núi ẩn tu, sống tại Huệ Nghĩa Tự (慧 義 寺) vùng Tử Châu (梓 州, thuộc Tam Đài, Tứ Xuyên), chuyên tâm giảng diễn và trước tác. Đến năm thứ 15 niên hiệu Nguyên Hòa (元和), ông thị tịch, không rõ hưởng thọ bao nhiêu tuổi. Trước tác của ông có hơn 10 loại như Pháp Hoa Huyền Tiên (法華玄箋), Thích Thị Niên Chí (釋氏年誌), Bắc Sơn Tham Huyền Ngữ Lục (北山參玄語錄), v.v.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Thiên Giới", "definition": "Dyans (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Thoại", "definition": "神話. Chuyện hoang đường, nói về thần tiên và ma quỷ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Thánh", "definition": "神聖. Chỉ chung các bậc cực tài giỏi, còn sống hay đã chết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Thông", "definition": "Là sức tác dụng siêu nhân gian, vô ngại tự tại, không thể nghĩ bàn, do tu tập thiền định mà đạt được. Thông thường, thần thông có năm tác dụng:", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thần Thông Biến Hiện", "definition": "Xem Như Ý Túc Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Thông Biến Hóa", "definition": "Ṛddi (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Thông Du Hí", "definition": "Sport transcendental power", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thần Thông Du Hí Tam Muội", "definition": "Samadhi of the Sport of Transcendental Powers", "source": "Tu Dien Anh Viet  - Vu Huu De"}
{"term": "Thần Thông Du Hý Kinh", "definition": "Xem Phổ Diệu Kinh.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Thông Du Ký Tam Muội", "definition": "Ṛddhivikridita (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Thông Lực", "definition": "Sappatihariyam (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Thông Thị Hiện", "definition": "Xem Như Ý Túc Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Tiên", "definition": "神仙. Hai loại người ở thế giới khác, trên thế giới loài người. Hát nói của Dương Khuê: “Chẳng Bồng lai Nhược thuỷ cũng thần tiên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Toán", "definition": "神算. Tính toán cực giỏi Đoán việc cực hay.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Trí Huệ Học Vấn", "definition": "Ganesa (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Trí Học", "definition": "Theosophy.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Tài", "definition": "Siri (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Tán", "definition": "神 贊. Thiền tăng đời Đường, người Phúc Châu Trung Quốc. Ban đầu sư xuất gia học đạo tại chùa Đại Trung Phúc Châu, về sau hành cước gặp Bách Trượng Hoài Hải khai ngộ. Trở về chùa Đại Trung vì Bản sư thuyết pháp, Bản sư ngay dưới lời nói của sư liền cảm ngộ. Tuổi già trụ Cổ Linh giáo hóa đồ chúng. Một hôm, trong tiếng chuông báo cạo tóc tắm gội sư an nhiên thị tịch.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Tình", "definition": "神情. Cực tài giỏi khéo léo.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Tình Ái", "definition": "Aviggaha (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thần Tú", "definition": "(605-706). Ngài họ Lí, người ở huyện Khai-phong, tỉnh Hà-nam. Ngài có thân hình cao lớn, mày rậm mắt sáng, uy đức nguy nguy. Thuở nhỏ đã đọc khắp kinh sử, nổi tiếng là bác học đa văn, nhưng sớm cạo tóc xuất gia, tìm thầy học đạo. Về sau ngài tìm đến chùa Đông-sơn ở núi Song-phong (huyện Hoàng-mai, tỉnh Hồ-bắc), xin tham yết Ngũ Tổ Hoằng Nhẫn, được Tổ tin cẩn, cử làm thầy giáo thọ, trở thành người đệ tử số một của Tổ, cho nên thường được gọi là thượng tọa Thần Tú. Sau khi Ngũ Tổ truyền y bát cho Lục Tổ Tuệ Năng và bảo đi về phương Nam hoằng hóa, thì ngài Thần Tú vẫn ở tại chùa Đông-sơn để hầu cận Ngũ Tổ. Sau khi tổ Hoằng Nhẫn viên tịch (năm 675), ngài dời sang núi Đương-dương (huyện Giang-lăng, tỉnh Hồ-bắc) để truyền pháp, tăng chúng cảm phục cao đức của ngài, qui tụ về tham học đông đúc. Ảnh hưởng của ngài tỏa trùm khắp vùng Trường-an, Lạc-dương; nữ hoàng Võ Tắc Thiên (684-705) nghe danh đức, liền thỉnh ngài vào đạo tràng cung nội để kính lễ, lại ban sắc xây chùa Độ-môn ở núi Đương-dương để nêu rõ đức phong của ngài. Ngài từng tâu xin Võ hậu cung thỉnh ngài Tuệ Năng vào cung, và chính ngài cũng viết thư cung thỉnh, nhưng Lục Tổ cố từ, lấy cớ bị bệnh, xin được ở yên xứ Lĩnh-nam để hoằng hóa; từ đó mà có tên gọi “Nam Năng Bắc Tú”. Vua Đường Trung-tông tức vị, cũng kính lễ ngài. Ngài viên tịch năm 706, thế thọ 102 tuổi, thụy hiệu là Đại Thông thiền sư. Đó là lần đầu tiên trong thiền môn được vua ban thụy hiệu. Ngài Thần Tú xiển dương thiền pháp, chú trọng thuyết “tiệm ngộ”, trong khi đó, ngài Tuệ Năng chú trọng thuyết “đốn ngộ”; cho nên trong thiền sử Trung-quốc đã có tên gọi “Nam Đốn Bắc Tiệm”. Vì pháp hệ của ngài thịnh hành ở phương Bắc, nên ngài được xưng là Thiền tổ Bắc-tông; nhưng dòng thiền của ngài chỉ thịnh hành được vài đời thì bị suy vi, rồi mai một.", "source": "Trich Luc Tu Ngu Phat Hoc - Cs Hanh Co"}
{"term": "Thần Túc", "definition": "Xem Như Ý Túc.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Túc Biến Hóa Thị Hiện", "definition": "Xem Như Ý Túc Thị Hiện.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Túc Thông", "definition": "Iddhividhā (P), Ṛddhi-sākśākṛya (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Tăng", "definition": "(神僧): những cao tăng có hành trạng thần bí, kỳ đặc, không thể luận bàn, không thể tư duy được. Trong bộ Đại Chánh Tân Tu Đại Tạng Kinh (大正新脩大藏經) có thâu lục bộ Thần Tăng Truyện (神僧傳, Taishō No. 2064), 9 quyển với 208 vị Thần Tăng, bắt đầu từ nhân vật đầu tiên là Ma Đằng (摩騰) cho đến người cuối cùng là Đảm Ba (膽巴).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Tượng", "definition": "神像. Bức hình, bức tượng của vị thần được dân chúng thờ phụng Chỉ nhân vật tiếng tăm được mọi người tôn sùng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Tịch Tham Khấu", "definition": "晨 夕 參 扣. Sớm chiều gõ cửa phương trượng để cầu xin chỉ dạy. Tắc 96, Bích Nham Lục (Đại 48, 219 thượng) ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Tốc", "definition": "神速. Cực mau lẹ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Tử", "definition": "臣子. Bề tôi và con. Cũng chỉ bổn phận thờ vua và thờ cha mẹ. Truyện Nhị Độ Mai: “Đạo làm thần tử dám hầu tự chuyên”.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thần Tử Vinh Tôn", "definition": "(神子榮尊, Shinshi Esion, 1195-1272): vị tăng của Lâm Tế Tông Nhật Bản, hiệu là Thần Tử (神子), có thuyết cho rằng ông có húy là Khẩu Quang (口光), tự là Vinh Tôn (榮尊), họ là Bình (平). Ông xuất thân ở vùng Trúc Hậu (筑後, Chikugo, thuộc Fukuoka-ken [福岡縣]), con của Bình Liêm Lại (平廉賴). Năm lên 7 tuổi, ông theo hầu đệ tử của Vinh Tây là Nguyên Lâm (元淋, tức Nghiêm Lâm [嚴林]), rồi xuống tóc xuất gia và học giáo quán của Mật Giáo, sau đó ông đến hầu hạ người đệ tử nối dòng của Vinh Tây là Vinh Triêu (榮朝, Eichō) ở Trường Lạc Tự (長樂寺, Chōraku-ji) thuộc vùng Thượng Dã (上野, Ueno, thuộc Gunma-ken [群馬顯]). Vào năm đầu (1225) niên hiệu Gia Trinh (嘉禎), ông cùng với Thánh Nhất Quốc Sư Viên Nhĩ (聖一國師圓爾) lên thuyền sang nhà Tống cầu pháp, đến tham vấn chư lão túc ở khắp nơi, rồi làm môn hạ của Vô Chuẩn Sư Phạm (無準師範) ở Kính Sơn (徑山) mà tham cứu Thiền chỉ, và ba năm sau thì ông trở về nước. Vào năm đầu (1240) niên hiệu Nhân Trị, ông sáng lập ra Vạn Thọ Tự (萬壽寺, Manju-ji) và hoằng dương Thiền phong của mình. Chính tự bản thân ông đã từng đi du hóa khắp các nơi, rồi khai sáng ra các chùa như Triêu Nhật Tự (朝日寺), Báo Ân Tự (報恩寺), Diệu Lạc Tự (妙樂寺), v.v. Đến cuối đời thì ông lên Kinh Đô Kyoto và quy y cho Nhị Điều Tướng Quốc (二條相國). Đến ngày 28 tháng 12 năm thứ 9 niên hiệu Văn Vĩnh (文永) thì ông viên tịch, hưởng thọ 78 tuổi.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Vẫn", "definition": "唇 吻. Lời nói đầu miệng. Tiết Kim Sơn Đàm Dĩnh Thiền Sư trong NĐHN q. 12 ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Vật Đồng Thể Luận", "definition": "Spinozism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Xã", "definition": "(神社, Jinja): cơ quan tế tự được thiết lập trên cơ sở tín ngưỡng của Thần Đạo; thường làm bằng gỗ. Cơ sở này khác với lễ bái đường, nơi thuyết pháp, truyền đạo của Giáo Hội Thiên Chúa Giáo và các tự viện Phật Giáo. Về nguồn gốc, Thần Xã vốn là tế đàn gọi là Thần Li (神籬, Himorogi), được thiết lập tạm thời vào những lúc tế cúng, tiến hành ở các vùng đất cấm địa (tục gọi là Thần Thể Sơn [神体山])—Bàn Tọa (磐座, Iwakura), nơi trú ngụ của chư vị Thần. Nguyên lai, Thần Xã cũng giống như Ngự Nhạc (御嶽, Utaki) ở Xung Thằng (沖繩, Okinawa). Đối với các đền thờ Thần Xã kế tục từ thời Cổ Đại đến nay, vẫn có Thần Xã không có điện thờ chính. Đó là các đền thờ kiến lập Bái Điện (拜殿) ngay trước nơi Bàn Tọa, vùng đất cấm túc, núi rừng hay hoang đảo; tỷ dụ như trường hợp Đại Thần Thần Xã (大神神社), Thạch Thượng Thần Cung (石上神宮), Tông Tượng Đại Xã (宗像大社), v.v.; hay nơi hoàn toàn không có điện thờ như Phi Lang Thần Xã (飛瀧神社). Tín ngưỡng cho rằng Thần thường ngự nơi điện thờ vốn hình thành từ khi kiến thiết Xã Điện (社殿, điện thờ của Thần Xã). Trong quá trình kiến thiết, cũng có ảnh hưởng của các tự viện Phật Giáo. Những ngôi đền thờ Thần Xã cổ xưa thì do một nhân duyên nào đó, người ta thiết lập nên Xã Điện ở nơi gần với ngự thần thể; tỷ dụ như Việt Mộc Nham Thần Xã (越木岩神社). Mặt khác, trường hợp khi cần phải có ngôi đền thờ Thần Xã mới, khi thôn làng hình thành, người ta tạo dựng ngôi đền ở nơi thích hợp để tôn thờ các Phân Linh (分靈), Thị Thần (氏神). Cho nên, cũng có nhiều phương pháp chọn lựa vị trí để tôn tạo Thần Xã. Tỷ dụ, theo nhân duyên mà chọn lựa, như trường hợp nơi phát xuất đầu tiên của một dòng tộc, như Thái Tể Phủ (太宰府, Dazaifu), nơi đầu nguồn của dòng họ Quản (菅); hay chọn nơi thanh tịnh (kỵ ô uế), như vùng đất xây dựng Minh Trị Thần Cung (明治神宮); hoặc chọn nơi tham bái dễ dàng, thuận tiện, như trường hợp Nhị Hoang Sơn Thần Xã (二荒山神社) vốn tọa lạc trên đỉnh núi, nhưng lại có Xã Điện ở nơi khác để tiện tham bái hơn. Tùy theo từng vị trí, Xã Điện có thể ở trên biển, đỉnh núi, hay thậm chí vào thời hiện đại này, ngay trên nóc tòa nhà cao tầng vẫn có. Với nghĩa rộng, tại tư gia vẫn có thiết Thần Bằng (神棚), hình thức đền thờ thu nhỏ. Về kiến trúc, hầu hết các đền thờ Thần Xã đều có quần thể kiến trúc chung nhất, gồm: Điểu Cư (鳥居, Torii, cổng chính màu đỏ dẫn vào đền thờ), Tham Đạo (參道, Sandau, Sandō), Đăng Lung (燈籠, Tōrō, đèn lồng bằng đá), Bạch Khuyển (狛犬, Komainu), Thủ Thủy Xá (手水舍, Teuzuya, nơi rửa tay trước khi vào tham bái), Bái Điện (拜殿, Haiden, thường an trí trước điện thờ chính), Tệ Điện (幣殿, Heiden, nơi có đặt thùng đựng tiền cúng dường công đức, gọi là Tái Tiền Sương [賽錢箱], có trường hợp được nhất thể hóa với Bái Điện và Bổn Điện), Bổn Điện (本殿, điện thờ chính, nơi Thần trấn tọa), Thần Lạc Điện (神樂殿, Kaguraden), Vũ Điện (舞殿, Mahidono, Midono), Hội Mã Điện (繪馬殿, Emaden), Sự Vụ Sở (事務所, Jimusho, văn phòng làm việc điều hành), Nạp Trát Sở (納札所, Nōsatsusho, nơi thâu nạp các thẻ bài cầu nguyện hay thẻ bùa cũ), v.v", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Y Dược", "definition": "Xem A Tu Vân.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Yến", "definition": "神 晏 (?-943). Thiền tăng đời Ngũ Đại, họ Lý, người Đại Lương (Khai Phong, Hà Nam) Trung Quốc. Thuở nhỏ sư học Nho giáo, thông minh mẫn tiệp. Năm 16 tuổi sư xuất gia, hâm mộ pháp thiền. Sau yết kiến Tuyết Phong Nghĩa Tồn, hỏi đáp vừa ý, cơ duyên khế hợp, rõ ràng liễu ngộ và được truyền tâm ấn. Mân chúa Vương Thẩm Tri thường hỏi pháp yếu, xây cất chùa Dũng Tuyền ở Cổ Sơn, thỉnh sư đến ở cử dương tông chỉ. Thần Yến ở đây hơn 30 năm đồ chúng tụ hội thường hơn ngàn người. Đời Hậu Tấn, niên hiệu Thiên Phúc thứ 8 (943) sư thị tịch, thọ hơn 70 tuổi. Vua ban hiệu “Hưng Thánh Quốc Sư”. Tác phẩm: Cổ Sơn Tiên Hưng Thánh Quốc Sư Hòa Thượng Pháp Đường Huyền Yếu Quảng Tập 1 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần thông tịnh diệu dụng, vận thủy cập ban sài!", "definition": "Hằng ngày không việc khác", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thần Đạo", "definition": "Shintō (J), Shintoism.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thần Đầu Quỷ Diện", "definition": "神 頭 鬼 面. Hành vi ngông cuồng, ngôn hạnh kỳ lạ ít thấy. Vô Môn Quan ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thần Đỉnh Hồng Nhân", "definition": "(神鼎洪[鴻]諲, Shintei Kōin, ?-?): vị tăng của Lâm Tế Tông Trung Quốc, sống dưới thời nhà Tống, xuất thân Tương Thủy (襄水, Tỉnh Hồ Bắc), họ là Ung (扈). Sau khi xuất gia, ông đến tham học với Thủ Sơn Tỉnh Niệm (首山省念) và kế thừa dòng pháp của vị này. Về sau, ông đến trú tại Thần Đỉnh Sơn (神鼎山) ở Đàm Châu (潭州, Tỉnh Hồ Nam). Ông có để lại tác phẩm Thần Đỉnh Sơn Đệ Nhất Đại Nhân Thiền Sư Ngữ Lục (神鼎山第一代諲禪師語錄) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thần Đồng", "definition": "神童. Đứa trẻ nhỏ cực giỏi, không học mà biết.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thầy", "definition": "Acaryā (S), Śastā (S), Guru (S), Ajarn (Thai), Ajahn (Thai), Acariya (P), lo pon (T), sensei (J), Master.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thầy Bói", "definition": "Ikkhaṇika (nam), ikkhaṇikā (nữ), nemiṭtika (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy Giáo", "definition": "Ajjhāyaka (nam), garu (nam), sikkhāpaka (3), sikkhāpanaka (3), ācariya (nam), ācera (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy Thuốc", "definition": "Bhisakka (nam), rogahārī (nam), tikicchaka (nam), vejja (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy Tu", "definition": "Muni (nam), pabbajita (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy Tu Cao Hạ", "definition": "Vassagga (trung)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy Tế Độ", "definition": "Upajjha (nam), upajjhāya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy Tổ", "definition": "Adhipa (nam), adhipati (nam), garu (nam), guru (nam), nāyaka (nam), pācariya (nam), satthu (nam), sāmī (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thầy xưa mấy lượt hóa Thầy nay”.", "definition": "2. Thiền tăng đời Đường (741-835), họ Mai, người xứ Cối Kê, Việt Châu (nay thuộc  huyện  Thiệu  Hưng,  tỉnh  Chiết Giang) Trung Quốc, nối pháp Mã Tổ Đạo Nhất. 3. Thiền tăng đời Đường (752-820), họ Dương, người xứ Quế Dương (nay thuộc tỉnh Hồ Nam) Trung Quốc, nối pháp Mã Tổ Đạo Nhất. 4. Thiền tăng đời Tống (1089-1151), họ Diệp, người đời thường gọi “Tuyết Đường”, người xứ Kiền Châu (nay thuộc tỉnh Giang Tây) Trung Quốc, nối pháp Thiền Sư Phật Nhãn Thanh Viễn, tông Lâm Tế, phái Dương Kỳ. Tác phẩm: Tuyết Đường Hạnh Hòa Thượng Ngữ Lục, 1 quyển, Tuyết Đường Hạnh Hòa Thượng Thập Di Lục, 1 quyển.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thầy Đầu Tiên", "definition": "Pubbācāriya (nam)", "source": "Tu Dien Viet - Pali - Sa Di Dinh Phuc"}
{"term": "Thẩm", "definition": "侵. Vẻ mặt buồn so Một âm là Xâm. Xem Xâm.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Mĩ", "definition": "審美. Xem xét cái đẹp.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Phán", "definition": "審判. Xét xử Viên chức xét xử các vụ án.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Sát", "definition": "審察. Xem xét kĩ lưỡng.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Tra", "definition": "審查. Hỏi han xem xét.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Tường", "definition": "(審祥, Shinjō, ?-?): vị tăng của Hoa Nghiêm Tông Nhật Bản, sống dưới thời đại Nại Lương. Ông sang nhà Đường cầu pháp, theo học Hoa Nghiêm Tông với Pháp Tạng (法藏), đến trong khoảng thời gian niên hiệu Thiên Bình (天平, 729-749) thì trở về nước và trú tại Đại An Tự (大安寺, Daian-ji). Năm 740, thể theo lời cung thỉnh của Lương Biện (良辨, Rōben) ở Kim Chung Tự (金鐘寺, Konshō-ji), ông làm Giảng Sư đầu tiên giảng về Hoa Nghiêm Kinh (華嚴經) và tạo cơ sở tư tưởng để đúc tượng Đại Phật Lô Xá Na (盧舍那) ở Đông Đại Tự (東大寺, Tōdai-ji). Ông có khá nhiều kinh luận, tàng thư của ông được gọi là Thẩm Tường Sư Kinh (審祥師經) và thỉnh thoảng có người đến thỉnh kinh. Trước tác của ông có Hoa Nghiêm Khởi Tín Quán Hành Pháp Môn (華嚴起信觀行法門) 1 quyển.", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thẩm Vấn", "definition": "審問. Như Thẩm tra 審查.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Âm", "definition": "審音. Xem xét hay dở khi nghe nhạc.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩm Định", "definition": "審定. Xem xét và dứt khoát về việc gì.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thẩn", "definition": "矧. Chân răng Huống hồ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thậm", "definition": "椹. Quả cây dâu Loại nấm mọc trên cây lớn.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thậm Chí", "definition": "甚至. Quá quắt đến nỗi.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thậm Khả Bố Úy Bồ Tát", "definition": "Xem Kim Cang Nha Bồ Tát.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thậm Xét Nghĩa Lý", "definition": "Artha-darśimant (S), Having insight into meanings, Attha-dassimant (P).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thậm Để", "definition": "甚 底. Cái gì? Cái chi? Bài thơ Ngôn Pháp Hoa trong Như Tịnh Ngữ Lục, q. hạ ghi:", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thận", "definition": "慎. Giữ gìn, không dám coi thường Coi làm trọng Suy nghĩ.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thận Am", "definition": "慎 庵. Thiền tăng đời Minh, họ Lý, người xứ Hải Xương (nay là huyện Hải Ninh, tỉnh Chiết Giang) Trung Quốc. Thuở bé sư theo Ngọc Hành Cơ Công ở chùa Linh ẩn học đạo, kinh sách hễ qua mắt là sư đều đọc thuộc. Lớn lên sư theo vị Trụ trì chùa Linh ẩn là Toàn Am Lý Công cạo tóc thụ giới cụ túc, và đắc pháp nơi Bích Am Lân Công. Khoảng niên hiệu Cảnh Thái (1450-1456), sư ra hoằng pháp trụ chùa Hiển Ninh ở Hàng Châu. Khoảng niên hiệu Thiên Thuận, sư trụ trì chùa Linh ẩn, chấn chỉnh quy củ thiền môn, loại bỏ những điều hư tệ lập ra quy chế mới, bồi dưỡng kẻ hậu học nên người học đạo đều tôn trọng sư. Sư mất vào năm 73 tuổi.", "source": "Tu Dien Thien Tong Han Viet - Han Man - Thong Thien"}
{"term": "Thận Na Thất Đát La", "definition": "Xem Tối Thắng Tử.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thận Ngôn", "definition": "慎言. Dè dặt, giữ gìn lời nói.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thận Trọng", "definition": "慎重. Dè dặt giữ gìn, coi công việc làm nặng, không dám coi thường.", "source": "Tu Dien Han Viet - Nguyen Quoc Hung"}
{"term": "Thập", "definition": "Daśa- (S), Ten Evil Deeds, Ten dark evil acts, Ten faults, Ten Evil Acts, Ten Sins.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thập Ba La Mật", "definition": "十波羅密 (Hoa Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Biến Xứ", "definition": "Daśa-kṛtsnayatanani (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thập Biến Xứ Định", "definition": "十徧處定 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bát Bất Cộng Pháp", "definition": "十八不共法 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bát Chi", "definition": "十八支 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bát Giới", "definition": "十八界 (Pháp Giới Thứ Đệ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bát Học Nhân", "definition": "十八學人 (Thiên Thai Tứ Giáo Nghi Tập Chú)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bát Không", "definition": "十八空 (Đại Trí Độ Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bát Không Luận", "definition": "Aṣṭadasākasa śāstra (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thập Bát Nguyện", "definition": "Eighteenth vow.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thập Bát Nê Lê", "definition": "(十八泥犁): xem Thập Bát Địa Ngục (十八地獄) (十八地獄): còn gọi là Thập Bát Tằng Địa Ngục (十八層地獄), Thập Bát Trùng Địa Ngục (十八重地獄), Thập Bát Nê Lê (十八泥犁). Theo truyền thuyết dân gian Trung Quốc, vua Diêm La (閻羅) là đứng đầu các địa ngục, 18 vị thuộc hạ Phán Quan Theo chủ quản 18 tầng địa ngục. Sau khi truyền vào nước này, Phật Giáo đã lấy tư tưởng này để dùng và giải thích về các tầng địa ngục. Mười Tám Tầng Địa Ngục trong Thập Bát Nê Lê Kinh (十八泥犁地獄) do An Thế Cao (安世高) nhà Đông Hán dịch, lấy sự dài ngắn, tội hình, đẳng cấp, sự nhẹ nặng trong thời gian thọ tội để bài liệt thành. Mỗi địa ngục so với địa ngục trước tăng thêm nỗi khổ lên 20 lần, tăng tuổi thọ thêm 1 lần. Mười Tám Tầng Địa Ngục này có âm dịch Phạn văn như: Quang Tựu Cư (光就居), Cư Hư Thối Lược (居虛倅略), Tang Cư Đô (桑居都), Lâu (樓), Phòng Tốt (房卒), Thảo Ô Ti Thứ (草烏卑次), Đô Lô Nan Đán (都盧難旦), Bất Lô Bán Hô (不盧半呼), Ô Cánh Đô (烏竟都), Nê Lô Đô (泥盧都), Ô Lược (烏略), Ô Mãn (烏滿), Ô Tạ (烏藉), Ô Hô (烏呼), Tu Kiện Cư (須健居), Mạt Đô Can Trực Hô (末都干直呼), Khu Thông Đồ (區通途), Trần Mạc (陳莫). Chữ “tầng (層)” trong Mười Tám Tầng Địa Ngục không phải chỉ cho phương trên dưới về mặt không gian, mà đối với thời gian cũng như hình pháp vốn bất đồng, cho nên nó có ý nghĩa về mặt thời gian nhiều hơn. Tầng địa ngục thứ nhất lấy tuổi thọ con người 3750 năm là 1 ngày, 30 ngày là 1 tháng, 12 tháng là 1 năm, tội quỷ chịu hình phạt ở chốn địa ngục này đến 1 vạn năm (tức 135 ức năm trên cõi người). Thời gian thọ hình phạt ở các tầng địa ngục sau thì lấy thời gian thọ hình ở đia ngục trước tăng lên gấp hai lần. Thuyết về Mười Tám Tầng Địa Ngục vốn phát xuất từ Bà La Môn Giáo của Ấn Độ ngày xưa và về sau có những thay đổi khác. Quán Phật Tam Muội Hải Kinh (觀佛三昧海經) quyển 5 có nêu rõ 18 loại địa ngục (s: naraka, niraya, p: niraya, 地獄) nhỏ như A Tỳ Địa Ngục (阿鼻地獄), 18 Địa Ngục Lạnh (十八寒地獄, Thập Bát Hàn Địa Ngục), 18 Địa Ngục Tối Tăm (十八黑闇地獄, Thập Bát Hắc Ám Địa Ngục), 18 Địa Ngục Nóng Ít (十八小熱地獄, Thập Bát Tiểu Nhiệt Địa Ngục), 18 Địa Ngục Vòng Tròn Đao (十八刀輪地獄, Thập Bát Đao Luân Địa Ngục), 18 Địa Ngục Vòng Tròn Kiếm (十八劍輪地獄, Thập Bát Kiếm Luân Địa Ngục), 18 Địa Ngục Xe Lửa (十八火車地獄, Thập Bát Hỏa Xa Địa Ngục), 18 Địa Ngục Phân Sôi (十八沸屎地獄, Thập Bát Phí Thỉ Địa Ngục), 18 Địa Ngục Vạc Nước Sôi (十八鑊湯地獄, Thập Bát Hoạch Thang Địa Ngục), 18 Địa Ngục Sông Tro (十八灰河地獄, Thập Bát Hôi Hà Địa Ngục), 18 Địa Ngục Đá Nhọn (十八尖石地獄, Thập Bát Tiêm Thạch Địa Ngục), 18 Địa Ngục Hang Thép (十八鐵窟地獄, Thập Bát Thiết Quật Địa Ngục), 18 Địa Ngục Uống Nước Đồng (十八飲銅地獄, Thập Bát ẩm Đồng Địa Ngục), v.v. Trong Lương Thư (梁書) có kể câu chuyện Lưu Tát Hà (劉薩河) người Hồ do bị bệnh nặng mà chết, nhưng 10 ngày sau thì sống lại và ông tự cho rằng đã đi qua 18 tầng địa ngục. Như vậy, đến thời nhà Lương, tín ngưỡng về 18 tầng địa ngục đã rất thịnh hành và lưu truyền trong dân gian Trung Quốc. Ngoài ra, tên gọi của 18 tầng địa ngục này có khác nhau tùy theo các thư tịch kinh điển. Theo Gián Địa Ngục Kinh (間地獄經), 18 tầng địa ngục là Nê Lê Địa Ngục (泥犁地獄), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Phí Sa Địa Ngục (沸沙地獄, Địa Ngục Cát Sôi), Phí Thỉ Địa Ngục (沸屎地獄, Địa Ngục Phân Sôi), Hắc Thân Địa Ngục (黑身地獄, Địa Ngục Thân Đen), Hỏa Xa Địa Ngục (火車地獄, Địa Ngục Xe Lửa), Hoạch Thang Địa Ngục (鑊湯地獄, Địa Ngục Vạc Nước Sôi), Thiết Sàng Địa Ngục (鐵床地獄, Địa Ngục Giưòng Sắt), Cái Sơn Địa Ngục (蓋山地獄, Địa Ngục Vung Núi), Hàn Băng Địa Ngục (寒冰地獄, Địa Ngục Băng Lạnh), Bác Bì Địa Ngục (剝河地獄, Địa Ngục Lột Da), Súc Sanh Địa Ngục (畜生地獄, Địa Ngục Súc Sanh), Đao Binh Địa Ngục (刀兵地獄, Địa Ngục Đao Binh), Thiết Ma Địa Ngục (鐵磨地獄, Địa Ngục Mài Sắt), Băng Địa Ngục (冰地獄, Địa Ngục Băng), Thiết Sách Địa Ngục (鐵册地獄, Địa Ngục Sách Sắt), Thư Trùng Địa Ngục (蛆蟲地獄, Địa Ngục Con Giòi), Dương Đồng Địa Ngục (烊銅地獄, Địa Ngục Nấu Đồng). Trong Thủy Lục Toàn Đồ (水陸全圖) có Bạt Thiệt Địa Ngục (拔舌地獄, Địa Ngục Kéo Lưỡi), Tiễn Đao Địa Ngục (剪刀地獄, Địa Ngục Dao Cắt), Thiết Thọ Địa Ngục (鐵樹地獄, Địa Ngục Cây Sắt), Nghiệt Kính Địa Ngục (孽鏡地獄, Địa Ngục Kính Yêu), Chưng Lung Địa Ngục (蒸籠地獄, Địa Ngục Lồng Hơi Nóng), Đồng Trụ Địa Ngục (銅柱地獄, Địa Ngục Trụ Đồng), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Băng Sơn Địa Ngục (冰山地獄, Địa Ngục Núi Băng), Du Oa Địa Ngục (油鍋地獄, Địa Ngục Nồi Dầu), Ngưu Kháng Địa Ngục (牛坑地獄, Địa Ngục Hầm Trâu), Thạch Áp Địa Ngục (壓石地獄, Địa Ngục Đá Đè), Thung Cữu Địa Ngục (舂臼地獄, Địa Ngục Cối Xay), Huyết Trì Địa Ngục (血池地獄, Địa Ngục Hồ Máu), Uổng Tử Địa Ngục (枉死地獄, Địa Ngục Chết Uổng), Trách Hình Địa Ngục (磔刑地獄, Địa Ngục Phanh Thây), Hỏa Sơn Địa Ngục (火山地獄, Địa Ngục Núi Lửa), Thạch Ma Địa Ngục (石磨地獄, Địa Ngục Mài Đá), và Đao Cứ Địa Ngục (刀鋸地獄, Địa Ngục Cưa Dao). Tại thành của Phong Đô Quỷ (酆都鬼), hai bên đại điện của Thiên Tử có chia thành Đông Địa Ngục và Tây Địa Ngục. Đông Địa Ngục gồm Ma Thôi Địa Ngục (磨推地獄, Địa Ngục Mài Kéo), Oạt Tâm Địa Ngục (挖心地獄, Địa Ngục Móc Tim), Hỏa Lạc Địa Ngục (火烙地獄, Địa Ngục Áp Lửa), Hàn Thủy Địa Ngục (寒水地獄, Địa Ngục Nước Lạnh), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Xa Liệt Địa Ngục (車裂地獄, Địa Ngục Xe Nghiền), Thư Trùng Địa Ngục (蛆蟲地獄, Địa Ngục Con Giòi), Bác Bì Địa Ngục (剝皮地獄, Địa Ngục Lột Da). Tây Địa Ngục có Đối Thung Địa Ngục (碓舂地獄, Địa Ngục Cối Xay), Cứ Giải Địa Ngục (鋸解地獄, Địa Ngục Cưa Xẻ), Du Oa Địa Ngục (油鍋地獄, Địa Ngục Nồi Dầu), Bạt Thiệt Địa Ngục (拔舌地獄, Địa Ngục Kéo Lưỡi), Bổ Kinh Địa Ngục (補經地獄, Địa Ngục Vá Dây), Chuyển Luân Địa Ngục (轉輪地獄, Địa Ngục Chuyển Luân), Súc Sanh Địa Ngục (畜生地獄, Địa Ngục Súc Sanh) và Hoạch Thang Địa Ngục (鑊湯地獄, Địa Ngục Vạc Nước Sôi).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thập Bát Tằng Địa Ngục", "definition": "(十八層地獄): xem Thập Bát Địa Ngục(十八地獄) (十八地獄): còn gọi là Thập Bát Tằng Địa Ngục (十八層地獄), Thập Bát Trùng Địa Ngục (十八重地獄), Thập Bát Nê Lê (十八泥犁). Theo truyền thuyết dân gian Trung Quốc, vua Diêm La (閻羅) là đứng đầu các địa ngục, 18 vị thuộc hạ Phán Quan Theo chủ quản 18 tầng địa ngục. Sau khi truyền vào nước này, Phật Giáo đã lấy tư tưởng này để dùng và giải thích về các tầng địa ngục. Mười Tám Tầng Địa Ngục trong Thập Bát Nê Lê Kinh (十八泥犁地獄) do An Thế Cao (安世高) nhà Đông Hán dịch, lấy sự dài ngắn, tội hình, đẳng cấp, sự nhẹ nặng trong thời gian thọ tội để bài liệt thành. Mỗi địa ngục so với địa ngục trước tăng thêm nỗi khổ lên 20 lần, tăng tuổi thọ thêm 1 lần. Mười Tám Tầng Địa Ngục này có âm dịch Phạn văn như: Quang Tựu Cư (光就居), Cư Hư Thối Lược (居虛倅略), Tang Cư Đô (桑居都), Lâu (樓), Phòng Tốt (房卒), Thảo Ô Ti Thứ (草烏卑次), Đô Lô Nan Đán (都盧難旦), Bất Lô Bán Hô (不盧半呼), Ô Cánh Đô (烏竟都), Nê Lô Đô (泥盧都), Ô Lược (烏略), Ô Mãn (烏滿), Ô Tạ (烏藉), Ô Hô (烏呼), Tu Kiện Cư (須健居), Mạt Đô Can Trực Hô (末都干直呼), Khu Thông Đồ (區通途), Trần Mạc (陳莫). Chữ “tầng (層)” trong Mười Tám Tầng Địa Ngục không phải chỉ cho phương trên dưới về mặt không gian, mà đối với thời gian cũng như hình pháp vốn bất đồng, cho nên nó có ý nghĩa về mặt thời gian nhiều hơn. Tầng địa ngục thứ nhất lấy tuổi thọ con người 3750 năm là 1 ngày, 30 ngày là 1 tháng, 12 tháng là 1 năm, tội quỷ chịu hình phạt ở chốn địa ngục này đến 1 vạn năm (tức 135 ức năm trên cõi người). Thời gian thọ hình phạt ở các tầng địa ngục sau thì lấy thời gian thọ hình ở đia ngục trước tăng lên gấp hai lần. Thuyết về Mười Tám Tầng Địa Ngục vốn phát xuất từ Bà La Môn Giáo của Ấn Độ ngày xưa và về sau có những thay đổi khác. Quán Phật Tam Muội Hải Kinh (觀佛三昧海經) quyển 5 có nêu rõ 18 loại địa ngục (s: naraka, niraya, p: niraya, 地獄) nhỏ như A Tỳ Địa Ngục (阿鼻地獄), 18 Địa Ngục Lạnh (十八寒地獄, Thập Bát Hàn Địa Ngục), 18 Địa Ngục Tối Tăm (十八黑闇地獄, Thập Bát Hắc Ám Địa Ngục), 18 Địa Ngục Nóng Ít (十八小熱地獄, Thập Bát Tiểu Nhiệt Địa Ngục), 18 Địa Ngục Vòng Tròn Đao (十八刀輪地獄, Thập Bát Đao Luân Địa Ngục), 18 Địa Ngục Vòng Tròn Kiếm (十八劍輪地獄, Thập Bát Kiếm Luân Địa Ngục), 18 Địa Ngục Xe Lửa (十八火車地獄, Thập Bát Hỏa Xa Địa Ngục), 18 Địa Ngục Phân Sôi (十八沸屎地獄, Thập Bát Phí Thỉ Địa Ngục), 18 Địa Ngục Vạc Nước Sôi (十八鑊湯地獄, Thập Bát Hoạch Thang Địa Ngục), 18 Địa Ngục Sông Tro (十八灰河地獄, Thập Bát Hôi Hà Địa Ngục), 18 Địa Ngục Đá Nhọn (十八尖石地獄, Thập Bát Tiêm Thạch Địa Ngục), 18 Địa Ngục Hang Thép (十八鐵窟地獄, Thập Bát Thiết Quật Địa Ngục), 18 Địa Ngục Uống Nước Đồng (十八飲銅地獄, Thập Bát ẩm Đồng Địa Ngục), v.v. Trong Lương Thư (梁書) có kể câu chuyện Lưu Tát Hà (劉薩河) người Hồ do bị bệnh nặng mà chết, nhưng 10 ngày sau thì sống lại và ông tự cho rằng đã đi qua 18 tầng địa ngục. Như vậy, đến thời nhà Lương, tín ngưỡng về 18 tầng địa ngục đã rất thịnh hành và lưu truyền trong dân gian Trung Quốc. Ngoài ra, tên gọi của 18 tầng địa ngục này có khác nhau tùy theo các thư tịch kinh điển. Theo Gián Địa Ngục Kinh (間地獄經), 18 tầng địa ngục là Nê Lê Địa Ngục (泥犁地獄), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Phí Sa Địa Ngục (沸沙地獄, Địa Ngục Cát Sôi), Phí Thỉ Địa Ngục (沸屎地獄, Địa Ngục Phân Sôi), Hắc Thân Địa Ngục (黑身地獄, Địa Ngục Thân Đen), Hỏa Xa Địa Ngục (火車地獄, Địa Ngục Xe Lửa), Hoạch Thang Địa Ngục (鑊湯地獄, Địa Ngục Vạc Nước Sôi), Thiết Sàng Địa Ngục (鐵床地獄, Địa Ngục Giưòng Sắt), Cái Sơn Địa Ngục (蓋山地獄, Địa Ngục Vung Núi), Hàn Băng Địa Ngục (寒冰地獄, Địa Ngục Băng Lạnh), Bác Bì Địa Ngục (剝河地獄, Địa Ngục Lột Da), Súc Sanh Địa Ngục (畜生地獄, Địa Ngục Súc Sanh), Đao Binh Địa Ngục (刀兵地獄, Địa Ngục Đao Binh), Thiết Ma Địa Ngục (鐵磨地獄, Địa Ngục Mài Sắt), Băng Địa Ngục (冰地獄, Địa Ngục Băng), Thiết Sách Địa Ngục (鐵册地獄, Địa Ngục Sách Sắt), Thư Trùng Địa Ngục (蛆蟲地獄, Địa Ngục Con Giòi), Dương Đồng Địa Ngục (烊銅地獄, Địa Ngục Nấu Đồng). Trong Thủy Lục Toàn Đồ (水陸全圖) có Bạt Thiệt Địa Ngục (拔舌地獄, Địa Ngục Kéo Lưỡi), Tiễn Đao Địa Ngục (剪刀地獄, Địa Ngục Dao Cắt), Thiết Thọ Địa Ngục (鐵樹地獄, Địa Ngục Cây Sắt), Nghiệt Kính Địa Ngục (孽鏡地獄, Địa Ngục Kính Yêu), Chưng Lung Địa Ngục (蒸籠地獄, Địa Ngục Lồng Hơi Nóng), Đồng Trụ Địa Ngục (銅柱地獄, Địa Ngục Trụ Đồng), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Băng Sơn Địa Ngục (冰山地獄, Địa Ngục Núi Băng), Du Oa Địa Ngục (油鍋地獄, Địa Ngục Nồi Dầu), Ngưu Kháng Địa Ngục (牛坑地獄, Địa Ngục Hầm Trâu), Thạch Áp Địa Ngục (壓石地獄, Địa Ngục Đá Đè), Thung Cữu Địa Ngục (舂臼地獄, Địa Ngục Cối Xay), Huyết Trì Địa Ngục (血池地獄, Địa Ngục Hồ Máu), Uổng Tử Địa Ngục (枉死地獄, Địa Ngục Chết Uổng), Trách Hình Địa Ngục (磔刑地獄, Địa Ngục Phanh Thây), Hỏa Sơn Địa Ngục (火山地獄, Địa Ngục Núi Lửa), Thạch Ma Địa Ngục (石磨地獄, Địa Ngục Mài Đá), và Đao Cứ Địa Ngục (刀鋸地獄, Địa Ngục Cưa Dao). Tại thành của Phong Đô Quỷ (酆都鬼), hai bên đại điện của Thiên Tử có chia thành Đông Địa Ngục và Tây Địa Ngục. Đông Địa Ngục gồm Ma Thôi Địa Ngục (磨推地獄, Địa Ngục Mài Kéo), Oạt Tâm Địa Ngục (挖心地獄, Địa Ngục Móc Tim), Hỏa Lạc Địa Ngục (火烙地獄, Địa Ngục Áp Lửa), Hàn Thủy Địa Ngục (寒水地獄, Địa Ngục Nước Lạnh), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Xa Liệt Địa Ngục (車裂地獄, Địa Ngục Xe Nghiền), Thư Trùng Địa Ngục (蛆蟲地獄, Địa Ngục Con Giòi), Bác Bì Địa Ngục (剝皮地獄, Địa Ngục Lột Da). Tây Địa Ngục có Đối Thung Địa Ngục (碓舂地獄, Địa Ngục Cối Xay), Cứ Giải Địa Ngục (鋸解地獄, Địa Ngục Cưa Xẻ), Du Oa Địa Ngục (油鍋地獄, Địa Ngục Nồi Dầu), Bạt Thiệt Địa Ngục (拔舌地獄, Địa Ngục Kéo Lưỡi), Bổ Kinh Địa Ngục (補經地獄, Địa Ngục Vá Dây), Chuyển Luân Địa Ngục (轉輪地獄, Địa Ngục Chuyển Luân), Súc Sanh Địa Ngục (畜生地獄, Địa Ngục Súc Sanh) và Hoạch Thang Địa Ngục (鑊湯地獄, Địa Ngục Vạc Nước Sôi).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thập Bát Vấn", "definition": "Thập bát vấn là 18 loại câu hỏi. Thiền sư Thiên Chiến ở Phần Dương, Thái Tử Viện đưa ra 18 trạng thái đặt câu hỏi người tham thiền học đạo. Đây đại để là những dạng câu hỏi mà người làm Thầy trước khi giáo hóa người học có hỏi về đạo thì mới có thể giải đáp giáo hóa cho họ đúng lúc đúng với căn cơ từng người, nếu không thì cả Thầy lẫn trò sẽ chẳng thu được hiệu quả, 18 dạng hỏi đó là:", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thập Bát Địa Ngục", "definition": "(十八地獄): còn gọi là Thập Bát Tằng Địa Ngục (十八層地獄), Thập Bát Trùng Địa Ngục (十八重地獄), Thập Bát Nê Lê (十八泥犁). Theo truyền thuyết dân gian Trung Quốc, vua Diêm La (閻羅) là đứng đầu các địa ngục, 18 vị thuộc hạ Phán Quan Theo chủ quản 18 tầng địa ngục. Sau khi truyền vào nước này, Phật Giáo đã lấy tư tưởng này để dùng và giải thích về các tầng địa ngục. Mười Tám Tầng Địa Ngục trong Thập Bát Nê Lê Kinh (十八泥犁地獄) do An Thế Cao (安世高) nhà Đông Hán dịch, lấy sự dài ngắn, tội hình, đẳng cấp, sự nhẹ nặng trong thời gian thọ tội để bài liệt thành. Mỗi địa ngục so với địa ngục trước tăng thêm nỗi khổ lên 20 lần, tăng tuổi thọ thêm 1 lần. Mười Tám Tầng Địa Ngục này có âm dịch Phạn văn như: Quang Tựu Cư (光就居), Cư Hư Thối Lược (居虛倅略), Tang Cư Đô (桑居都), Lâu (樓), Phòng Tốt (房卒), Thảo Ô Ti Thứ (草烏卑次), Đô Lô Nan Đán (都盧難旦), Bất Lô Bán Hô (不盧半呼), Ô Cánh Đô (烏竟都), Nê Lô Đô (泥盧都), Ô Lược (烏略), Ô Mãn (烏滿), Ô Tạ (烏藉), Ô Hô (烏呼), Tu Kiện Cư (須健居), Mạt Đô Can Trực Hô (末都干直呼), Khu Thông Đồ (區通途), Trần Mạc (陳莫). Chữ “tầng (層)” trong Mười Tám Tầng Địa Ngục không phải chỉ cho phương trên dưới về mặt không gian, mà đối với thời gian cũng như hình pháp vốn bất đồng, cho nên nó có ý nghĩa về mặt thời gian nhiều hơn. Tầng địa ngục thứ nhất lấy tuổi thọ con người 3750 năm là 1 ngày, 30 ngày là 1 tháng, 12 tháng là 1 năm, tội quỷ chịu hình phạt ở chốn địa ngục này đến 1 vạn năm (tức 135 ức năm trên cõi người). Thời gian thọ hình phạt ở các tầng địa ngục sau thì lấy thời gian thọ hình ở đia ngục trước tăng lên gấp hai lần. Thuyết về Mười Tám Tầng Địa Ngục vốn phát xuất từ Bà La Môn Giáo của Ấn Độ ngày xưa và về sau có những thay đổi khác. Quán Phật Tam Muội Hải Kinh (觀佛三昧海經) quyển 5 có nêu rõ 18 loại địa ngục (s: naraka, niraya, p: niraya, 地獄) nhỏ như A Tỳ Địa Ngục (阿鼻地獄), 18 Địa Ngục Lạnh (十八寒地獄, Thập Bát Hàn Địa Ngục), 18 Địa Ngục Tối Tăm (十八黑闇地獄, Thập Bát Hắc Ám Địa Ngục), 18 Địa Ngục Nóng Ít (十八小熱地獄, Thập Bát Tiểu Nhiệt Địa Ngục), 18 Địa Ngục Vòng Tròn Đao (十八刀輪地獄, Thập Bát Đao Luân Địa Ngục), 18 Địa Ngục Vòng Tròn Kiếm (十八劍輪地獄, Thập Bát Kiếm Luân Địa Ngục), 18 Địa Ngục Xe Lửa (十八火車地獄, Thập Bát Hỏa Xa Địa Ngục), 18 Địa Ngục Phân Sôi (十八沸屎地獄, Thập Bát Phí Thỉ Địa Ngục), 18 Địa Ngục Vạc Nước Sôi (十八鑊湯地獄, Thập Bát Hoạch Thang Địa Ngục), 18 Địa Ngục Sông Tro (十八灰河地獄, Thập Bát Hôi Hà Địa Ngục), 18 Địa Ngục Đá Nhọn (十八尖石地獄, Thập Bát Tiêm Thạch Địa Ngục), 18 Địa Ngục Hang Thép (十八鐵窟地獄, Thập Bát Thiết Quật Địa Ngục), 18 Địa Ngục Uống Nước Đồng (十八飲銅地獄, Thập Bát ẩm Đồng Địa Ngục), v.v. Trong Lương Thư (梁書) có kể câu chuyện Lưu Tát Hà (劉薩河) người Hồ do bị bệnh nặng mà chết, nhưng 10 ngày sau thì sống lại và ông tự cho rằng đã đi qua 18 tầng địa ngục. Như vậy, đến thời nhà Lương, tín ngưỡng về 18 tầng địa ngục đã rất thịnh hành và lưu truyền trong dân gian Trung Quốc. Ngoài ra, tên gọi của 18 tầng địa ngục này có khác nhau tùy theo các thư tịch kinh điển. Theo Gián Địa Ngục Kinh (間地獄經), 18 tầng địa ngục là Nê Lê Địa Ngục (泥犁地獄), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Phí Sa Địa Ngục (沸沙地獄, Địa Ngục Cát Sôi), Phí Thỉ Địa Ngục (沸屎地獄, Địa Ngục Phân Sôi), Hắc Thân Địa Ngục (黑身地獄, Địa Ngục Thân Đen), Hỏa Xa Địa Ngục (火車地獄, Địa Ngục Xe Lửa), Hoạch Thang Địa Ngục (鑊湯地獄, Địa Ngục Vạc Nước Sôi), Thiết Sàng Địa Ngục (鐵床地獄, Địa Ngục Giưòng Sắt), Cái Sơn Địa Ngục (蓋山地獄, Địa Ngục Vung Núi), Hàn Băng Địa Ngục (寒冰地獄, Địa Ngục Băng Lạnh), Bác Bì Địa Ngục (剝河地獄, Địa Ngục Lột Da), Súc Sanh Địa Ngục (畜生地獄, Địa Ngục Súc Sanh), Đao Binh Địa Ngục (刀兵地獄, Địa Ngục Đao Binh), Thiết Ma Địa Ngục (鐵磨地獄, Địa Ngục Mài Sắt), Băng Địa Ngục (冰地獄, Địa Ngục Băng), Thiết Sách Địa Ngục (鐵册地獄, Địa Ngục Sách Sắt), Thư Trùng Địa Ngục (蛆蟲地獄, Địa Ngục Con Giòi), Dương Đồng Địa Ngục (烊銅地獄, Địa Ngục Nấu Đồng). Trong Thủy Lục Toàn Đồ (水陸全圖) có Bạt Thiệt Địa Ngục (拔舌地獄, Địa Ngục Kéo Lưỡi), Tiễn Đao Địa Ngục (剪刀地獄, Địa Ngục Dao Cắt), Thiết Thọ Địa Ngục (鐵樹地獄, Địa Ngục Cây Sắt), Nghiệt Kính Địa Ngục (孽鏡地獄, Địa Ngục Kính Yêu), Chưng Lung Địa Ngục (蒸籠地獄, Địa Ngục Lồng Hơi Nóng), Đồng Trụ Địa Ngục (銅柱地獄, Địa Ngục Trụ Đồng), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Băng Sơn Địa Ngục (冰山地獄, Địa Ngục Núi Băng), Du Oa Địa Ngục (油鍋地獄, Địa Ngục Nồi Dầu), Ngưu Kháng Địa Ngục (牛坑地獄, Địa Ngục Hầm Trâu), Thạch Áp Địa Ngục (壓石地獄, Địa Ngục Đá Đè), Thung Cữu Địa Ngục (舂臼地獄, Địa Ngục Cối Xay), Huyết Trì Địa Ngục (血池地獄, Địa Ngục Hồ Máu), Uổng Tử Địa Ngục (枉死地獄, Địa Ngục Chết Uổng), Trách Hình Địa Ngục (磔刑地獄, Địa Ngục Phanh Thây), Hỏa Sơn Địa Ngục (火山地獄, Địa Ngục Núi Lửa), Thạch Ma Địa Ngục (石磨地獄, Địa Ngục Mài Đá), và Đao Cứ Địa Ngục (刀鋸地獄, Địa Ngục Cưa Dao). Tại thành của Phong Đô Quỷ (酆都鬼), hai bên đại điện của Thiên Tử có chia thành Đông Địa Ngục và Tây Địa Ngục. Đông Địa Ngục gồm Ma Thôi Địa Ngục (磨推地獄, Địa Ngục Mài Kéo), Oạt Tâm Địa Ngục (挖心地獄, Địa Ngục Móc Tim), Hỏa Lạc Địa Ngục (火烙地獄, Địa Ngục Áp Lửa), Hàn Thủy Địa Ngục (寒水地獄, Địa Ngục Nước Lạnh), Đao Sơn Địa Ngục (刀山地獄, Địa Ngục Núi Đao), Xa Liệt Địa Ngục (車裂地獄, Địa Ngục Xe Nghiền), Thư Trùng Địa Ngục (蛆蟲地獄, Địa Ngục Con Giòi), Bác Bì Địa Ngục (剝皮地獄, Địa Ngục Lột Da). Tây Địa Ngục có Đối Thung Địa Ngục (碓舂地獄, Địa Ngục Cối Xay), Cứ Giải Địa Ngục (鋸解地獄, Địa Ngục Cưa Xẻ), Du Oa Địa Ngục (油鍋地獄, Địa Ngục Nồi Dầu), Bạt Thiệt Địa Ngục (拔舌地獄, Địa Ngục Kéo Lưỡi), Bổ Kinh Địa Ngục (補經地獄, Địa Ngục Vá Dây), Chuyển Luân Địa Ngục (轉輪地獄, Địa Ngục Chuyển Luân), Súc Sanh Địa Ngục (畜生地獄, Địa Ngục Súc Sanh) và Hoạch Thang Địa Ngục (鑊湯地獄, Địa Ngục Vạc Nước Sôi).", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thập Bất Nhị Môn", "definition": "十不二門 (Pháp Hoa Huyền Nghĩa Thích Thiêm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bất Năng Trưởng Nghiệp", "definition": "十不能長業 (Du Già Sư Địa Luận)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Bất Thiện Nghiệp", "definition": "Daśakuśala-karma-pathani (S), Ten unwholesome karmas.", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thập Bất Thiện Nghiệp Đạo", "definition": "(十不善業道): xem Thập Ác (十惡) (s: daśākuśala-karma-pathāni, 十惡): còn gọi là Thập Ác Nghiệp Đạo (十惡業道), Thập Bất Thiện Nghiệp Đạo (十不善業道), Thập Bất Thiện Căn Bổn Nghiệp Đạo (十不善根本業道), Thập Hắc Nghiệp Đạo (十黑業道); là 10 hành vi ác, không tốt của ba nghiệp thân, miệng và ý; gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thập Bất Tịnh", "definition": "Daśa-aśubha (S).", "source": "Tu Dien Da Ngon Ngu - Cs Minh Thong"}
{"term": "Thập Can", "definition": "(十干): Mười Can, còn gọi là Thiên Can (天干), là 10 yếu tố được giải thích theo thứ tự cách đọc âm của tiếng Nhật, Trung Quốc, Triều Tiên, thuộc Ngũ Hành (五行), Ngũ Phương (五方), âm dương, gồm:", "source": "Phat Hoc Tinh Tuyen - TK Thich Nguyen Tam"}
{"term": "Thập Chủng Bất Tư Nghì Pháp", "definition": "十種不思議法 (Bồ Tát Tạng Chánh Pháp Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Chủng Bổ Đặc Già La", "definition": "十種補特伽羅 (Địa Tạng Thập Luận Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Chủng Công Đức Thọ Trì", "definition": "Đức Phật Thích Ca có giảng rằng: nếu ai thọ trì danh hiệu của một Đức Phật, thì ngay lúc ở đời có được mười thứ công đức như sau: Ngày đêm thường được chư thiên, các vị đại lực thần tưởng và quyến thuộc thường ẩn mình ủng hộ cho. Thường được 25 vị đại Bồ Tát như ngài Quán Thế Âm, cùng tất cả các vị Bồ Tát theo hộ trì. Thường được chư Phật ngày đêm hộ niệm cho Đức Phật A Di Đà thường phóng hào quang tiếp thọ. Tất cả những ác quỉ dù cho Dạ xoa hay La sát đều chẳng hại được, tất cả những thứ rắn độc, rồng độc, thuốc độc đều chẳng hại được. Khỏi chết bởi những nạn: lửa, nước, quán tặc, cung tên, súng đạn, lao ngục, hoạnh tử. Trước đã tạo tội nay đều tiêu hết, nếu có cuộc tra xét giết người, cũng được giải thoát khỏi bị bắt và chấp đối Đêm ngủ thấy việc chánh trực, hoặc thấy sắc thân thắng diệu của Đức Phật A Di Đà. Lòng thường hoan hỷ nhan sắc tươi sáng, khí lực mạnh mẽ, làm việc gì cũng được lợi lành. Thường được tất cả mọi người trong thế gian cung kính cúng dường, lễ bái cũng như kính Phật. Đến khi mạng chung không lo sợ, lòng chánh niệm hiền tiền liền thấy Phật A Di Đà và chư Bồ Tát Thánh chúng đem đài kim cang tiếp nhẫn cho được vãng sanh Tây Phương Tịnh Độ, từ đó trở về sau mãi mãi được hưởng sự vui thắng dịu.", "source": "Tu Dien Phat Hoc Tong Hop - Viet  - Anh - Cs Minh Thong - Mic Phuong"}
{"term": "Thập Chủng Giáo Thể", "definition": "十種教體 (Hoa Nghiêm Kinh Sớ)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Chủng Hạnh Nguyện", "definition": "十種行願 (Phẩm Hạnh Nguyện trong Kinh Hoa Nghiêm)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Chủng Hạnh Quán Nhất Thiết Pháp", "definition": "十種行觀一切法 (Hoa Nghiêm Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
{"term": "Thập Chủng Hữu Y Hành Luân", "definition": "十種有依行輪 (Địa Tạng Thập Luân Kinh)", "source": "Tam Tang Phap So - Cs Le Hong Son"}
