{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(pip *)",
      "Bash(Get-*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(du *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git cat-file*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git read-tree *)",
      "Bash(git update-index *)",
      "Bash(git push *)",
      "Bash(python * --apply*)",
      "Bash(python * --revert*)",
      "Bash(python * --reset*)",
      "Bash(python *ai_batch_transliterate*)",
      "Bash(npm run deploy*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item -Recurse*)",
      "Bash(sqlite3 * DROP *)",
      "Bash(sqlite3 * DELETE *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./config/**)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Edit(./.env*)",
      "Write(./.env*)"
    ]
  }
}
